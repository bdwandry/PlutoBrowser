  80:Source/ui/selftest_home_page.c ****     sel = 1; count = 3;
  81:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_LEFT, &sel, count);
  82:Source/ui/selftest_home_page.c ****     ck("N.left_odd_stays", sel == 1);
