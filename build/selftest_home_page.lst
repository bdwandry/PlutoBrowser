  28:src/ui/selftest_home_page.c **** 
  29:src/ui/selftest_home_page.c **** static void case_grid_nav(void) {
  30:src/ui/selftest_home_page.c ****     int sel, count;
  31:src/ui/selftest_home_page.c **** 
  32:src/ui/selftest_home_page.c ****     /* settings -> first card only when cards exist */
  33:src/ui/selftest_home_page.c ****     sel = 0; count = 3;
  34:src/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_DOWN, &sel, count);
  35:src/ui/selftest_home_page.c ****     ck("N.down_settings_to_first", sel == 1);
  36:src/ui/selftest_home_page.c ****     sel = 0; count = 0;
  37:src/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_DOWN, &sel, count);
  38:src/ui/selftest_home_page.c ****     ck("N.down_settings_no_cards", sel == 0);
  39:src/ui/selftest_home_page.c **** 
  40:src/ui/selftest_home_page.c ****     /* down: full row below -> +2; else +1; else stay */
  41:src/ui/selftest_home_page.c ****     sel = 1; count = 4;
  42:src/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_DOWN, &sel, count);
  43:src/ui/selftest_home_page.c ****     ck("N.down_plus2", sel == 3);
  44:src/ui/selftest_home_page.c ****     sel = 2; count = 3;
  45:src/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_DOWN, &sel, count);
  46:src/ui/selftest_home_page.c ****     ck("N.down_plus1_odd_row", sel == 3);
  47:src/ui/selftest_home_page.c ****     sel = 2; count = 2;
  48:src/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_DOWN, &sel, count);
  49:src/ui/selftest_home_page.c ****     ck("N.down_at_last_stays", sel == 2);
  50:src/ui/selftest_home_page.c **** 
  51:src/ui/selftest_home_page.c ****     /* up: first row -> settings; else -2 */
  52:src/ui/selftest_home_page.c ****     sel = 1; count = 3;
  53:src/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_UP, &sel, count);
  54:src/ui/selftest_home_page.c ****     ck("N.up_first_row_settings", sel == 0);
  55:src/ui/selftest_home_page.c ****     sel = 2; count = 5;
  56:src/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_UP, &sel, count);
  57:src/ui/selftest_home_page.c ****     ck("N.up_second_row_settings", sel == 0);
  58:src/ui/selftest_home_page.c ****     sel = 3; count = 5;
  59:src/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_UP, &sel, count);
  60:src/ui/selftest_home_page.c ****     ck("N.up_minus2", sel == 1);
  61:src/ui/selftest_home_page.c ****     sel = 0; count = 4;
  62:src/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_UP, &sel, count);
  63:src/ui/selftest_home_page.c ****     ck("N.up_at_top_stays", sel == 0);
  64:src/ui/selftest_home_page.c **** 
  65:src/ui/selftest_home_page.c ****     /* right: odd index moves, even stays */
  66:src/ui/selftest_home_page.c ****     sel = 1; count = 2;
  67:src/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_RIGHT, &sel, count);
  68:src/ui/selftest_home_page.c ****     ck("N.right_odd_moves", sel == 2);
  69:src/ui/selftest_home_page.c ****     sel = 2; count = 4;
  70:src/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_RIGHT, &sel, count);
  71:src/ui/selftest_home_page.c ****     ck("N.right_even_stays", sel == 2);
  72:src/ui/selftest_home_page.c ****     sel = 3; count = 3;
  73:src/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_RIGHT, &sel, count);
  74:src/ui/selftest_home_page.c ****     ck("N.right_last_stays", sel == 3);
  75:src/ui/selftest_home_page.c **** 
  76:src/ui/selftest_home_page.c ****     /* left: even index moves, odd stays */
  77:src/ui/selftest_home_page.c ****     sel = 2; count = 3;
  78:src/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_LEFT, &sel, count);
  79:src/ui/selftest_home_page.c ****     ck("N.left_even_moves", sel == 1);
