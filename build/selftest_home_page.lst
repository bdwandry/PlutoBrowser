  85:Source/ui/selftest_home_page.c **** /* ── auto-scroll bands ───────────────────────�
  86:Source/ui/selftest_home_page.c **** 
  87:Source/ui/selftest_home_page.c **** static void case_autoscroll(void) {
  88:Source/ui/selftest_home_page.c ****     /* settings selection always targets the top */
  89:Source/ui/selftest_home_page.c ****     ck("S.settings_top",
  90:Source/ui/selftest_home_page.c ****        hp_autoscroll_target(0, 5, 123.0) == 0.0);
  91:Source/ui/selftest_home_page.c **** 
  92:Source/ui/selftest_home_page.c ****     /* empty page keeps target untouched */
  93:Source/ui/selftest_home_page.c ****     ck("S.empty_untouched",
  94:Source/ui/selftest_home_page.c ****        hp_autoscroll_target(2, 0, 77.0) == 77.0);
  95:Source/ui/selftest_home_page.c **** 
  96:Source/ui/selftest_home_page.c ****     /* row 0 (absY=184) inside the visible band: unchanged */
  97:Source/ui/selftest_home_page.c ****     ck("S.row0_in_band",
  98:Source/ui/selftest_home_page.c ****        hp_autoscroll_target(1, 8, 100.0) == 100.0);
  99:Source/ui/selftest_home_page.c **** 
 100:Source/ui/selftest_home_page.c ****     /* deep row pushes target so absY sits SCREEN_HEIGHT-40 from top */
 101:Source/ui/selftest_home_page.c ****     /* sel=7 -> row 3 -> absY=184+162=346; dispY=346>200 ->
 102:Source/ui/selftest_home_page.c ****        target=346-200=146 */
 103:Source/ui/selftest_home_page.c ****     ck("S.deep_row_pulls_up",
 104:Source/ui/selftest_home_page.c ****        fabs(hp_autoscroll_target(7, 8, 0.0) - 146.0) < 1e-9);
 105:Source/ui/selftest_home_page.c **** 
 106:Source/ui/selftest_home_page.c ****     /* scrolled too far: clamp to max(0, absY - CONTENT_Y - 10) */
 107:Source/ui/selftest_home_page.c ****     /* target=400 -> dispY=-54<34 -> max(0,346-34)=312 */
 108:Source/ui/selftest_home_page.c ****     ck("S.too_far_clamps",
 109:Source/ui/selftest_home_page.c ****        fabs(hp_autoscroll_target(7, 8, 400.0) - 312.0) < 1e-9);
 110:Source/ui/selftest_home_page.c **** }
