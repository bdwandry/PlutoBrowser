  29:Source/ui/selftest_home_page.c **** static void case_grid_nav(void) {
  30:Source/ui/selftest_home_page.c ****     int sel, count;
  31:Source/ui/selftest_home_page.c **** 
  32:Source/ui/selftest_home_page.c ****     /* settings -> first card only when cards exist */
  33:Source/ui/selftest_home_page.c ****     sel = 0; count = 3;
  34:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_DOWN, &sel, count);
  35:Source/ui/selftest_home_page.c ****     ck("N.down_settings_to_first", sel == 1);
  36:Source/ui/selftest_home_page.c ****     sel = 0; count = 0;
  37:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_DOWN, &sel, count);
  38:Source/ui/selftest_home_page.c ****     ck("N.down_settings_no_cards", sel == 0);
  39:Source/ui/selftest_home_page.c **** 
  40:Source/ui/selftest_home_page.c ****     /* down: full row below -> +2; else +1; else stay */
  41:Source/ui/selftest_home_page.c ****     sel = 1; count = 4;
  42:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_DOWN, &sel, count);
  43:Source/ui/selftest_home_page.c ****     ck("N.down_plus2", sel == 3);
  44:Source/ui/selftest_home_page.c ****     sel = 2; count = 3;
  45:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_DOWN, &sel, count);
  46:Source/ui/selftest_home_page.c ****     ck("N.down_plus1_odd_row", sel == 3);
  47:Source/ui/selftest_home_page.c ****     sel = 2; count = 2;
  48:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_DOWN, &sel, count);
  49:Source/ui/selftest_home_page.c ****     ck("N.down_at_last_stays", sel == 2);
  50:Source/ui/selftest_home_page.c **** 
  51:Source/ui/selftest_home_page.c ****     /* up: first row -> settings; else -2 */
  52:Source/ui/selftest_home_page.c ****     sel = 1; count = 3;
  53:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_UP, &sel, count);
  54:Source/ui/selftest_home_page.c ****     ck("N.up_first_row_settings", sel == 0);
  55:Source/ui/selftest_home_page.c ****     sel = 2; count = 5;
  56:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_UP, &sel, count);
  57:Source/ui/selftest_home_page.c ****     ck("N.up_second_row_settings", sel == 0);
  58:Source/ui/selftest_home_page.c ****     sel = 3; count = 5;
  59:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_UP, &sel, count);
  60:Source/ui/selftest_home_page.c ****     ck("N.up_minus2", sel == 1);
  61:Source/ui/selftest_home_page.c ****     sel = 0; count = 4;
  62:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_UP, &sel, count);
  63:Source/ui/selftest_home_page.c ****     ck("N.up_at_top_stays", sel == 0);
  64:Source/ui/selftest_home_page.c **** 
  65:Source/ui/selftest_home_page.c ****     /* right: odd index moves, even stays */
  66:Source/ui/selftest_home_page.c ****     sel = 1; count = 2;
  67:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_RIGHT, &sel, count);
  68:Source/ui/selftest_home_page.c ****     ck("N.right_odd_moves", sel == 2);
  69:Source/ui/selftest_home_page.c ****     sel = 2; count = 4;
  70:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_RIGHT, &sel, count);
  71:Source/ui/selftest_home_page.c ****     ck("N.right_even_stays", sel == 2);
  72:Source/ui/selftest_home_page.c ****     sel = 3; count = 3;
  73:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_RIGHT, &sel, count);
  74:Source/ui/selftest_home_page.c ****     ck("N.right_last_stays", sel == 3);
  75:Source/ui/selftest_home_page.c **** 
  76:Source/ui/selftest_home_page.c ****     /* left: even index moves, odd stays */
  77:Source/ui/selftest_home_page.c ****     sel = 2; count = 3;
  78:Source/ui/selftest_home_page.c ****     hp_grid_nav(HP_BTN_LEFT, &sel, count);
  79:Source/ui/selftest_home_page.c ****     ck("N.left_even_moves", sel == 1);
