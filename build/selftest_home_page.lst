 112:Source/ui/selftest_home_page.c **** /* ── marquee oscillation ───────────────────────
 113:Source/ui/selftest_home_page.c **** 
 114:Source/ui/selftest_home_page.c **** static void case_marquee(void) {
 115:Source/ui/selftest_home_page.c ****     const double tw = 200.0, maxW = 100.0; /* range=100, travel=2s */
 116:Source/ui/selftest_home_page.c ****     double off;
 117:Source/ui/selftest_home_page.c **** 
 118:Source/ui/selftest_home_page.c ****     ck("M.fits_no_scroll", hp_marquee_offset(9.9, 80.0, 100.0) == 0.0);
 119:Source/ui/selftest_home_page.c **** 
 120:Source/ui/selftest_home_page.c ****     off = hp_marquee_offset(0.5, tw, maxW); /* dwell hold start */
 121:Source/ui/selftest_home_page.c ****     ck("M.dwell_start", off == 0.0);
 122:Source/ui/selftest_home_page.c **** 
 123:Source/ui/selftest_home_page.c ****     off = hp_marquee_offset(1.5, tw, maxW); /* (1.5-1)*50 */
 124:Source/ui/selftest_home_page.c ****     ck("M.travel_out", fabs(off - 25.0) < 1e-9);
 125:Source/ui/selftest_home_page.c **** 
 126:Source/ui/selftest_home_page.c ****     off = hp_marquee_offset(3.5, tw, maxW); /* second dwell at range */
 127:Source/ui/selftest_home_page.c ****     ck("M.dwell_end", off == 100.0);
 128:Source/ui/selftest_home_page.c **** 
 129:Source/ui/selftest_home_page.c ****     off = hp_marquee_offset(4.5, tw, maxW); /* return leg: 100-25 */
 130:Source/ui/selftest_home_page.c ****     ck("M.travel_back", fabs(off - 75.0) < 1e-9);
 131:Source/ui/selftest_home_page.c **** 
 132:Source/ui/selftest_home_page.c ****     off = hp_marquee_offset(6.5, tw, maxW); /* cycle wraps to dwell */
 133:Source/ui/selftest_home_page.c ****     ck("M.cycle_wrap", off == 0.0);
 134:Source/ui/selftest_home_page.c **** }
