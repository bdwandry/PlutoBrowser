  85:src/ui/selftest_home_page.c **** /* ── auto-scroll bands ───────────────────────�
  86:src/ui/selftest_home_page.c **** 
  87:src/ui/selftest_home_page.c **** static void case_autoscroll(void) {
  88:src/ui/selftest_home_page.c ****     /* settings selection always targets the top */
  89:src/ui/selftest_home_page.c ****     ck("S.settings_top",
  90:src/ui/selftest_home_page.c ****        hp_autoscroll_target(0, 5, 123.0) == 0.0);
  91:src/ui/selftest_home_page.c **** 
  92:src/ui/selftest_home_page.c ****     /* empty page keeps target untouched */
  93:src/ui/selftest_home_page.c ****     ck("S.empty_untouched",
  94:src/ui/selftest_home_page.c ****        hp_autoscroll_target(2, 0, 77.0) == 77.0);
  95:src/ui/selftest_home_page.c **** 
  96:src/ui/selftest_home_page.c ****     /* row 0 (absY=184) inside the visible band: unchanged */
  97:src/ui/selftest_home_page.c ****     ck("S.row0_in_band",
  98:src/ui/selftest_home_page.c ****        hp_autoscroll_target(1, 8, 100.0) == 100.0);
  99:src/ui/selftest_home_page.c **** 
 100:src/ui/selftest_home_page.c ****     /* deep row pushes target so absY sits SCREEN_HEIGHT-40 from top */
 101:src/ui/selftest_home_page.c ****     /* sel=7 -> row 3 -> absY=184+162=346; dispY=346>200 ->
 102:src/ui/selftest_home_page.c ****        target=346-200=146 */
 103:src/ui/selftest_home_page.c ****     ck("S.deep_row_pulls_up",
 104:src/ui/selftest_home_page.c ****        fabs(hp_autoscroll_target(7, 8, 0.0) - 146.0) < 1e-9);
 105:src/ui/selftest_home_page.c **** 
 106:src/ui/selftest_home_page.c ****     /* scrolled too far: clamp to max(0, absY - CONTENT_Y - 10) */
 107:src/ui/selftest_home_page.c ****     /* target=400 -> dispY=-54<34 -> max(0,346-34)=312 */
 108:src/ui/selftest_home_page.c ****     ck("S.too_far_clamps",
 109:src/ui/selftest_home_page.c ****        fabs(hp_autoscroll_target(7, 8, 400.0) - 312.0) < 1e-9);
 110:src/ui/selftest_home_page.c **** }
