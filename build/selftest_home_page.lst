 112:src/ui/selftest_home_page.c **** /* ── marquee oscillation ───────────────────────
 113:src/ui/selftest_home_page.c **** 
 114:src/ui/selftest_home_page.c **** static void case_marquee(void) {
 115:src/ui/selftest_home_page.c ****     const double tw = 200.0, maxW = 100.0; /* range=100, travel=2s */
 116:src/ui/selftest_home_page.c ****     double off;
 117:src/ui/selftest_home_page.c **** 
 118:src/ui/selftest_home_page.c ****     ck("M.fits_no_scroll", hp_marquee_offset(9.9, 80.0, 100.0) == 0.0);
 119:src/ui/selftest_home_page.c **** 
 120:src/ui/selftest_home_page.c ****     off = hp_marquee_offset(0.5, tw, maxW); /* dwell hold start */
 121:src/ui/selftest_home_page.c ****     ck("M.dwell_start", off == 0.0);
 122:src/ui/selftest_home_page.c **** 
 123:src/ui/selftest_home_page.c ****     off = hp_marquee_offset(1.5, tw, maxW); /* (1.5-1)*50 */
 124:src/ui/selftest_home_page.c ****     ck("M.travel_out", fabs(off - 25.0) < 1e-9);
 125:src/ui/selftest_home_page.c **** 
 126:src/ui/selftest_home_page.c ****     off = hp_marquee_offset(3.5, tw, maxW); /* second dwell at range */
 127:src/ui/selftest_home_page.c ****     ck("M.dwell_end", off == 100.0);
 128:src/ui/selftest_home_page.c **** 
 129:src/ui/selftest_home_page.c ****     off = hp_marquee_offset(4.5, tw, maxW); /* return leg: 100-25 */
 130:src/ui/selftest_home_page.c ****     ck("M.travel_back", fabs(off - 75.0) < 1e-9);
 131:src/ui/selftest_home_page.c **** 
 132:src/ui/selftest_home_page.c ****     off = hp_marquee_offset(6.5, tw, maxW); /* cycle wraps to dwell */
 133:src/ui/selftest_home_page.c ****     ck("M.cycle_wrap", off == 0.0);
 134:src/ui/selftest_home_page.c **** }
