 514:src/util/json.c **** JsonValue* json_parse(const char* text, size_t len, char err[128])
 515:src/util/json.c **** {
 516:src/util/json.c ****     JParser jp;
 517:src/util/json.c ****     JsonValue* v;
 518:src/util/json.c **** 
 519:src/util/json.c ****     if (text == NULL) {
 520:src/util/json.c ****         if (err) snprintf(err, 128, "null input");
 521:src/util/json.c ****         return NULL;
 522:src/util/json.c ****     }
 523:src/util/json.c ****     jp.p = text;
 524:src/util/json.c ****     jp.end = text + len;
 525:src/util/json.c ****     jp.start = text;
 526:src/util/json.c ****     jp.err[0] = '\0';
 527:src/util/json.c ****     jp.depth = 0;
 528:src/util/json.c **** 
 529:src/util/json.c ****     v = j_parse_value(&jp);
 530:src/util/json.c ****     if (v != NULL) {
 531:src/util/json.c ****         jskip_ws(&jp);
 532:src/util/json.c ****         if (jp.p != jp.end) {
 533:src/util/json.c ****             jerr(&jp, "trailing data after value");
 534:src/util/json.c ****             json_free(v);
 535:src/util/json.c ****             v = NULL;
 536:src/util/json.c ****         }
 537:src/util/json.c ****     }
 538:src/util/json.c ****     if (err != NULL) {
 539:src/util/json.c ****         snprintf(err, 128, "%s", jp.err);
 540:src/util/json.c ****     }
 541:src/util/json.c ****     return v;
 542:src/util/json.c **** }
