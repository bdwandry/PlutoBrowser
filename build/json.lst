 166:Source/util/json.c **** /* Parses an escape sequence (the backslash is already consumed). */
 167:Source/util/json.c **** static int parse_escape(Parser *ps, StrBuf *sb)
 168:Source/util/json.c **** {
 169:Source/util/json.c ****     if (ps->p >= ps->end)
 170:Source/util/json.c ****     {
 171:Source/util/json.c ****         return 0;
 172:Source/util/json.c ****     }
 173:Source/util/json.c ****     char c = *ps->p++;
 174:Source/util/json.c ****     switch (c)
 175:Source/util/json.c ****     {
 176:Source/util/json.c ****     case '"':
 177:Source/util/json.c ****         return sb_put(sb, "\"", 1);
 178:Source/util/json.c ****     case '\\':
 179:Source/util/json.c ****         return sb_put(sb, "\\", 1);
 180:Source/util/json.c ****     case '/':
 181:Source/util/json.c ****         return sb_put(sb, "/", 1);
 182:Source/util/json.c ****     case 'b':
 183:Source/util/json.c ****         return sb_put(sb, "\b", 1);
 184:Source/util/json.c ****     case 'f':
 185:Source/util/json.c ****         return sb_put(sb, "\f", 1);
 186:Source/util/json.c ****     case 'n':
 187:Source/util/json.c ****         return sb_put(sb, "\n", 1);
 188:Source/util/json.c ****     case 'r':
 189:Source/util/json.c ****         return sb_put(sb, "\r", 1);
 190:Source/util/json.c ****     case 't':
 191:Source/util/json.c ****         return sb_put(sb, "\t", 1);
 192:Source/util/json.c ****     case 'u':
 193:Source/util/json.c ****     {
 194:Source/util/json.c ****         unsigned cp;
 195:Source/util/json.c ****         if (!read_hex4(ps, &cp))
 196:Source/util/json.c ****         {
 197:Source/util/json.c ****             return 0;
 198:Source/util/json.c ****         }
 199:Source/util/json.c ****         /* Surrogate pair handling (RFC 8259 §7.2). */
 200:Source/util/json.c ****         if (cp >= 0xD800 && cp <= 0xDBFF)
 201:Source/util/json.c ****         {
 202:Source/util/json.c ****             if (ps->end - ps->p < 2 || ps->p[0] != '\\' || ps->p[1] != 'u')
 203:Source/util/json.c ****             {
 204:Source/util/json.c ****                 return 0;
 205:Source/util/json.c ****             }
 206:Source/util/json.c ****             ps->p += 2;
 207:Source/util/json.c ****             unsigned lo;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccTmDQuN.s 			page 13


 208:Source/util/json.c ****             if (!read_hex4(ps, &lo) || lo < 0xDC00 || lo > 0xDFFF)
 209:Source/util/json.c ****             {
 210:Source/util/json.c ****                 return 0;
 211:Source/util/json.c ****             }
 212:Source/util/json.c ****             cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
 213:Source/util/json.c ****         }
 214:Source/util/json.c ****         else if (cp >= 0xDC00 && cp <= 0xDFFF)
 215:Source/util/json.c ****         {
 216:Source/util/json.c ****             return 0; /* lone low surrogate */
 217:Source/util/json.c ****         }
 218:Source/util/json.c ****         return sb_put_utf8(sb, cp);
 219:Source/util/json.c ****     }
 220:Source/util/json.c ****     default:
 221:Source/util/json.c ****         return 0;
 222:Source/util/json.c ****     }
