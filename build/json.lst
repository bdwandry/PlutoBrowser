 259:src/util/json.c ****     JsonValue* v;
 260:src/util/json.c **** 
 261:src/util/json.c ****     // Sign, digits, fraction, and exponent chars are all collected verbatim
 262:src/util/json.c ****     // so strtod sees the full token.
 263:src/util/json.c ****     while (jp->p < jp->end &&
 264:src/util/json.c ****            ((*jp->p >= '0' && *jp->p <= '9') || *jp->p == '.' ||
 265:src/util/json.c ****             *jp->p == 'e' || *jp->p == 'E' || *jp->p == '+' || *jp->p == '-')) {
 266:src/util/json.c ****         if (n + 1 < sizeof(buf)) {
 267:src/util/json.c ****             buf[n++] = *jp->p;
 268:src/util/json.c ****         } else {
 269:src/util/json.c ****             jerr(jp, "number too long");
 270:src/util/json.c ****             return NULL;
 271:src/util/json.c ****         }
 272:src/util/json.c ****         jp->p++;
 273:src/util/json.c ****     }
 274:src/util/json.c ****     if (n == 0) {
 275:src/util/json.c ****         jerr(jp, "bad number");
 276:src/util/json.c ****         return NULL;
 277:src/util/json.c ****     }
 278:src/util/json.c ****     buf[n] = '\0';
 279:src/util/json.c ****     d = strtod(buf, &endp);
 280:src/util/json.c ****     if (endp == buf) {
 281:src/util/json.c ****         jp->p = start;
 282:src/util/json.c ****         jerr(jp, "bad number");
 283:src/util/json.c ****         return NULL;
 284:src/util/json.c ****     }
 285:src/util/json.c ****     v = json_new_number(d);
 286:src/util/json.c ****     if (v == NULL) {
 287:src/util/json.c ****         jerr(jp, "out of memory");
 288:src/util/json.c ****     }
 289:src/util/json.c ****     return v;
 290:src/util/json.c **** }
