 176:src/util/json.c ****         if (c == '"') {
 177:src/util/json.c ****             jp->p++;
 178:src/util/json.c ****             *outLen = sb.len;
 179:src/util/json.c ****             return sb_detach(&sb);
 180:src/util/json.c ****         }
 181:src/util/json.c ****         if (c == '\\') {
 182:src/util/json.c ****             jp->p++;
 183:src/util/json.c ****             if (jp->p >= jp->end) {
 184:src/util/json.c ****                 jerr(jp, "truncated escape");
 185:src/util/json.c ****                 break;
 186:src/util/json.c ****             }
 187:src/util/json.c ****             {
