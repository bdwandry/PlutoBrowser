 102:Source/util/json.c **** /* Appends the UTF-8 encoding of cp to buf. */
 103:Source/util/json.c **** static size_t utf8_encode(unsigned cp, char *buf)
 104:Source/util/json.c **** {
 105:Source/util/json.c ****     if (cp < 0x80)
 106:Source/util/json.c ****     {
 107:Source/util/json.c ****         buf[0] = (char)cp;
 108:Source/util/json.c ****         return 1;
 109:Source/util/json.c ****     }
 110:Source/util/json.c ****     if (cp < 0x800)
 111:Source/util/json.c ****     {
 112:Source/util/json.c ****         buf[0] = (char)(0xC0 | (cp >> 6));
 113:Source/util/json.c ****         buf[1] = (char)(0x80 | (cp & 0x3F));
 114:Source/util/json.c ****         return 2;
 115:Source/util/json.c ****     }
 116:Source/util/json.c ****     if (cp < 0x10000)
 117:Source/util/json.c ****     {
 118:Source/util/json.c ****         buf[0] = (char)(0xE0 | (cp >> 12));
 119:Source/util/json.c ****         buf[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
 120:Source/util/json.c ****         buf[2] = (char)(0x80 | (cp & 0x3F));
 121:Source/util/json.c ****         return 3;
 122:Source/util/json.c ****     }
 123:Source/util/json.c ****     buf[0] = (char)(0xF0 | (cp >> 18));
 124:Source/util/json.c ****     buf[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
 125:Source/util/json.c ****     buf[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
 126:Source/util/json.c ****     buf[3] = (char)(0x80 | (cp & 0x3F));
 127:Source/util/json.c ****     return 4;
 128:Source/util/json.c **** }
