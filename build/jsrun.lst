 218:Source/js/jsrun.c **** /* Read values from stack */
 219:Source/js/jsrun.c **** 
 220:Source/js/jsrun.c **** static js_Value *stackidx(js_State *J, int idx)
 221:Source/js/jsrun.c **** {
 222:Source/js/jsrun.c **** 	static js_Value undefined = { { {0}, JS_TUNDEFINED } };
 223:Source/js/jsrun.c **** 	idx = idx < 0 ? TOP + idx : BOT + idx;
 224:Source/js/jsrun.c **** 	if (idx < 0 || idx >= TOP)
 225:Source/js/jsrun.c **** 		return &undefined;
 226:Source/js/jsrun.c **** 	return STACK + idx;
 227:Source/js/jsrun.c **** }
 228:Source/js/jsrun.c **** 
 229:Source/js/jsrun.c **** js_Value *js_tovalue(js_State *J, int idx)
