 509:Source/js/jsrun.c **** int js_isarrayindex(js_State *J, const char *p, int *idx)
 510:Source/js/jsrun.c **** {
 511:Source/js/jsrun.c **** 	int n = 0;
 512:Source/js/jsrun.c **** 
 513:Source/js/jsrun.c **** 	/* check for empty string */
 514:Source/js/jsrun.c **** 	if (p[0] == 0)
 515:Source/js/jsrun.c **** 		return 0;
 516:Source/js/jsrun.c **** 
 517:Source/js/jsrun.c **** 	/* check for '0' and integers with leading zero */
 518:Source/js/jsrun.c **** 	if (p[0] == '0')
 519:Source/js/jsrun.c **** 		return (p[1] == 0) ? *idx = 0, 1 : 0;
 520:Source/js/jsrun.c **** 
 521:Source/js/jsrun.c **** 	while (*p) {
 522:Source/js/jsrun.c **** 		int c = *p++;
 523:Source/js/jsrun.c **** 		if (c >= '0' && c <= '9') {
 524:Source/js/jsrun.c **** 			if (n >= INT_MAX / 10)
 525:Source/js/jsrun.c **** 				return 0;
 526:Source/js/jsrun.c **** 			n = n * 10 + (c - '0');
 527:Source/js/jsrun.c **** 		} else {
 528:Source/js/jsrun.c **** 			return 0;
 529:Source/js/jsrun.c **** 		}
 530:Source/js/jsrun.c **** 	}
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccInNsZE.s 			page 12


 531:Source/js/jsrun.c **** 	return *idx = n, 1;
 532:Source/js/jsrun.c **** }
