  36:Source/render/decoders/tga.c **** /* Read the next pixel from the stream (RLE-aware). Returns pointer to the
  37:Source/render/decoders/tga.c ****  * pixel bytes or NULL at end of data. */
  38:Source/render/decoders/tga.c **** static const uint8_t *tga_next_pixel(TgaCtx *c)
  39:Source/render/decoders/tga.c **** {
  40:Source/render/decoders/tga.c ****     int bytes = c->bpp / 8;
  41:Source/render/decoders/tga.c ****     if (c->rle)
  42:Source/render/decoders/tga.c ****     {
  43:Source/render/decoders/tga.c ****         if (c->runRemain == 0)
  44:Source/render/decoders/tga.c ****         {
  45:Source/render/decoders/tga.c ****             if (c->rp >= c->pixLen) return NULL;
  46:Source/render/decoders/tga.c ****             int hdr = c->pix[c->rp++];
  47:Source/render/decoders/tga.c ****             c->blockIsRle = (hdr & 0x80) != 0;
  48:Source/render/decoders/tga.c ****             c->runRemain = (hdr & 0x7F) + 1;
  49:Source/render/decoders/tga.c ****             if (c->blockIsRle)
  50:Source/render/decoders/tga.c ****             {
  51:Source/render/decoders/tga.c ****                 if (c->rp + (size_t)bytes > c->pixLen) return NULL;
  52:Source/render/decoders/tga.c ****                 memcpy(c->rlePix, c->pix + c->rp, (size_t)bytes);
  53:Source/render/decoders/tga.c ****                 c->rp += (size_t)bytes;
  54:Source/render/decoders/tga.c ****             }
  55:Source/render/decoders/tga.c ****         }
  56:Source/render/decoders/tga.c ****         c->runRemain--;
  57:Source/render/decoders/tga.c ****         if (c->blockIsRle) return c->rlePix;
  58:Source/render/decoders/tga.c ****         if (c->rp + (size_t)bytes > c->pixLen) return NULL;
  59:Source/render/decoders/tga.c ****         const uint8_t *p = c->pix + c->rp;
  60:Source/render/decoders/tga.c ****         c->rp += (size_t)bytes;
  61:Source/render/decoders/tga.c ****         return p;
  62:Source/render/decoders/tga.c ****     }
  63:Source/render/decoders/tga.c ****     if (c->rp + (size_t)bytes > c->pixLen) return NULL;
  64:Source/render/decoders/tga.c ****     const uint8_t *p = c->pix + c->rp;
  65:Source/render/decoders/tga.c ****     c->rp += (size_t)bytes;
  66:Source/render/decoders/tga.c ****     return p;
  67:Source/render/decoders/tga.c **** }
  68:Source/render/decoders/tga.c **** 
  69:Source/render/decoders/tga.c **** static uint8_t tga_gray(TgaCtx *c, const uint8_t *p)
  70:Source/render/decoders/tga.c **** {
  71:Source/render/decoders/tga.c ****     if (c->bpp == 8)
  72:Source/render/decoders/tga.c ****     {
  73:Source/render/decoders/tga.c ****         if (c->hasCmap && c->cmap && c->cmapLen)
  74:Source/render/decoders/tga.c ****         {
  75:Source/render/decoders/tga.c ****             int bytes = c->cmapBpp / 8;
  76:Source/render/decoders/tga.c ****             size_t e = (size_t)(c->cmapStart + p[0]) * (size_t)bytes;
  77:Source/render/decoders/tga.c ****             if (e + 2 < c->cmapLen)
  78:Source/render/decoders/tga.c ****             {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccT1jsoI.s 			page 4


  79:Source/render/decoders/tga.c ****                 return (uint8_t)dither_rgb_to_gray(c->cmap[e + 2],
  80:Source/render/decoders/tga.c ****                                                    c->cmap[e + 1], c->cmap[e]);
  81:Source/render/decoders/tga.c ****             }
  82:Source/render/decoders/tga.c ****             return 0;
  83:Source/render/decoders/tga.c ****         }
  84:Source/render/decoders/tga.c ****         return p[0];
  85:Source/render/decoders/tga.c ****     }
  86:Source/render/decoders/tga.c ****     if (c->bpp == 24 || c->bpp == 32)
  87:Source/render/decoders/tga.c ****     {
  88:Source/render/decoders/tga.c ****         return (uint8_t)dither_rgb_to_gray(p[2], p[1], p[0]);
  89:Source/render/decoders/tga.c ****     }
  90:Source/render/decoders/tga.c ****     if (c->bpp == 16)
  91:Source/render/decoders/tga.c ****     {
  92:Source/render/decoders/tga.c ****         unsigned v = (unsigned)p[0] | ((unsigned)p[1] << 8);
  93:Source/render/decoders/tga.c ****         int r = (v >> 10) & 0x1F, g = (v >> 5) & 0x1F, b = v & 0x1F;
  94:Source/render/decoders/tga.c ****         return (uint8_t)dither_rgb_to_gray(r << 3, g << 3, b << 3);
  95:Source/render/decoders/tga.c ****     }
  96:Source/render/decoders/tga.c ****     return 0;
  97:Source/render/decoders/tga.c **** }
