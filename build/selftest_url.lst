 157:src/core/selftest_url.c **** static void test_encode_decode(void)
 158:src/core/selftest_url.c **** {
 159:src/core/selftest_url.c ****     struct {
 160:src/core/selftest_url.c ****         const char* name;
 161:src/core/selftest_url.c ****         const char* in;
 162:src/core/selftest_url.c ****         const char* want;
 163:src/core/selftest_url.c ****     } enc[] = {
 164:src/core/selftest_url.c ****         {"enc.plain", "hello world", "hello+world"},
 165:src/core/selftest_url.c ****         {"enc.specials", "&a=b/c?", "%26a%3Db%2Fc%3F"},
 166:src/core/selftest_url.c ****         {"enc.unreserved_kept", "a-b_c.d~e", "a-b_c.d~e"},
 167:src/core/selftest_url.c ****         {"enc.plus_encoded", "a+b", "a%2Bb"},
 168:src/core/selftest_url.c ****         {"enc.utf8", "caf\xC3\xA9", "caf%C3%A9"},
 169:src/core/selftest_url.c ****         {"enc.percent_literal", "%50", "%2550"},
 170:src/core/selftest_url.c ****         {"enc.newline_crlf", "a\nb", "a%0D%0Ab"},
 171:src/core/selftest_url.c ****         {"enc.empty", "", ""},
 172:src/core/selftest_url.c ****     };
 173:src/core/selftest_url.c ****     size_t i;
 174:src/core/selftest_url.c ****     for (i = 0; i < sizeof(enc) / sizeof(enc[0]); i++) {
 175:src/core/selftest_url.c ****         StrBuf sb;
 176:src/core/selftest_url.c ****         sb_init(&sb);
 177:src/core/selftest_url.c ****         url_encode(enc[i].in, &sb);
 178:src/core/selftest_url.c ****         {
 179:src/core/selftest_url.c ****             const char* got = sb.data ? sb.data : "";
 180:src/core/selftest_url.c ****             if (strcmp(got, enc[i].want) != 0) {
 181:src/core/selftest_url.c ****                 PLUTO_ERROR("[P03]   encode('%s')='%s' want '%s'",
 182:src/core/selftest_url.c ****                             enc[i].in, got, enc[i].want);
 183:src/core/selftest_url.c ****             }
 184:src/core/selftest_url.c ****             st_check(strcmp(got, enc[i].want) == 0, enc[i].name);
 185:src/core/selftest_url.c ****         }
 186:src/core/selftest_url.c ****         sb_free(&sb);
 187:src/core/selftest_url.c ****     }
 188:src/core/selftest_url.c **** 
 189:src/core/selftest_url.c ****     {
 190:src/core/selftest_url.c ****         struct {
 191:src/core/selftest_url.c ****             const char* name;
 192:src/core/selftest_url.c ****             const char* in;
 193:src/core/selftest_url.c ****             const char* want;
 194:src/core/selftest_url.c ****         } dec[] = {
 195:src/core/selftest_url.c ****             {"dec.plus_space", "a+b", "a b"},
 196:src/core/selftest_url.c ****             {"dec.pct_utf8", "%C3%A9", "\x01"}, // want overridden below
 197:src/core/selftest_url.c ****             {"dec.mixed", "a%20b+c", "a b c"},
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccHmjQla.s 			page 35


 198:src/core/selftest_url.c ****             {"dec.invalid_pct_kept", "%zz", "%zz"},
 199:src/core/selftest_url.c ****             {"dec.truncated_pct_kept", "100%", "100%"},
 200:src/core/selftest_url.c ****             {"dec.empty", "", ""},
 201:src/core/selftest_url.c ****         };
 202:src/core/selftest_url.c ****         (void)0;
 203:src/core/selftest_url.c ****         for (i = 0; i < sizeof(dec) / sizeof(dec[0]); i++) {
 204:src/core/selftest_url.c ****             StrBuf sb;
 205:src/core/selftest_url.c ****             const char* want = dec[i].want;
 206:src/core/selftest_url.c ****             if (i == 1) {
 207:src/core/selftest_url.c ****                 want = "\xC3\xA9"; // raw UTF-8 bytes for é
 208:src/core/selftest_url.c ****             }
 209:src/core/selftest_url.c ****             sb_init(&sb);
 210:src/core/selftest_url.c ****             url_decode(dec[i].in, &sb);
 211:src/core/selftest_url.c ****             {
 212:src/core/selftest_url.c ****                 const char* got = sb.data ? sb.data : "";
 213:src/core/selftest_url.c ****                 if (strcmp(got, want) != 0) {
 214:src/core/selftest_url.c ****                     PLUTO_ERROR("[P03]   decode('%s') len=%d want len=%d",
 215:src/core/selftest_url.c ****                                 dec[i].in, (int)sb.len, (int)strlen(want));
 216:src/core/selftest_url.c ****                 }
 217:src/core/selftest_url.c ****                 st_check(strcmp(got, want) == 0, dec[i].name);
 218:src/core/selftest_url.c ****             }
 219:src/core/selftest_url.c ****             sb_free(&sb);
 220:src/core/selftest_url.c ****         }
 221:src/core/selftest_url.c ****     }
 222:src/core/selftest_url.c **** 
 223:src/core/selftest_url.c ****     // round-trip: decode(encode(x)) restores original bytes. Note: inputs
 224:src/core/selftest_url.c ****     // containing literal '+' do NOT round-trip in the Lua original either
 225:src/core/selftest_url.c ****     // (decode maps every '+' to space before %XX handling).
 226:src/core/selftest_url.c ****     {
 227:src/core/selftest_url.c ****         const char* src = "a b&c=d/e?f~g-h_i.j";
 228:src/core/selftest_url.c ****         StrBuf e, d;
 229:src/core/selftest_url.c ****         sb_init(&e);
 230:src/core/selftest_url.c ****         sb_init(&d);
 231:src/core/selftest_url.c ****         url_encode(src, &e);
 232:src/core/selftest_url.c ****         url_decode(e.data ? e.data : "", &d);
 233:src/core/selftest_url.c ****         st_check(d.len == strlen(src) &&
 234:src/core/selftest_url.c ****                  memcmp(d.data ? d.data : "", src, d.len) == 0,
 235:src/core/selftest_url.c ****                  "url.roundtrip");
 236:src/core/selftest_url.c ****         sb_free(&e);
 237:src/core/selftest_url.c ****         sb_free(&d);
 238:src/core/selftest_url.c ****     }
 239:src/core/selftest_url.c **** }
