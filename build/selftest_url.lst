 241:src/core/selftest_url.c **** // ------------------------------------------------------------ isSearchQuery ----
 242:src/core/selftest_url.c **** 
 243:src/core/selftest_url.c **** static void test_is_search_query(void)
 244:src/core/selftest_url.c **** {
 245:src/core/selftest_url.c ****     struct {
 246:src/core/selftest_url.c ****         const char* in;   // NULL sentinel supported
 247:src/core/selftest_url.c ****         int         want;
 248:src/core/selftest_url.c ****         const char* name;
 249:src/core/selftest_url.c ****     } cases[] = {
 250:src/core/selftest_url.c ****         {NULL, 0, "isq.null_false"},
 251:src/core/selftest_url.c ****         {"", 0, "isq.empty_false"},
 252:src/core/selftest_url.c ****         {"hello world", 1, "isq.spaces_query"},
 253:src/core/selftest_url.c ****         {"example.com", 0, "isq.dot_url"},
 254:src/core/selftest_url.c ****         {"example", 1, "isq.bare_word_query"},
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccHmjQla.s 			page 36


 255:src/core/selftest_url.c ****         {".hidden", 1, "isq.leading_dot_query"},
 256:src/core/selftest_url.c ****         {"trailing.", 1, "isq.trailing_dot_query"},
 257:src/core/selftest_url.c ****         {"192.168.1.1", 0, "isq.ip_url"},
 258:src/core/selftest_url.c ****         {"localhost", 0, "isq.localhost_url"},
 259:src/core/selftest_url.c ****         {"localhost.dev", 0, "isq.localhost_suffix_url"},
 260:src/core/selftest_url.c ****         {"https://x.com", 0, "isq.https_url"},
 261:src/core/selftest_url.c ****         {"about:blank", 0, "isq.about_url"},
 262:src/core/selftest_url.c ****         {"file:///tmp/x", 0, "isq.file_url"},
 263:src/core/selftest_url.c ****         {"   ", 1, "isq.spaces_only_is_query"},
 264:src/core/selftest_url.c ****         {"HTTP://X.COM", 0, "isq.upper_scheme_via_dot_rule"},
 265:src/core/selftest_url.c ****         {"  example.org  ", 0, "isq.trimmed_before_dot_rule"},
 266:src/core/selftest_url.c ****     };
 267:src/core/selftest_url.c ****     size_t i;
 268:src/core/selftest_url.c ****     for (i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
 269:src/core/selftest_url.c ****         int got = url_is_search_query(cases[i].in);
 270:src/core/selftest_url.c ****         if (got != cases[i].want) {
 271:src/core/selftest_url.c ****             PLUTO_ERROR("[P03]   isSearchQuery('%s')=%d want %d",
 272:src/core/selftest_url.c ****                         cases[i].in ? cases[i].in : "(null)", got,
 273:src/core/selftest_url.c ****                         cases[i].want);
 274:src/core/selftest_url.c ****         }
 275:src/core/selftest_url.c ****         st_check(got == cases[i].want, cases[i].name);
 276:src/core/selftest_url.c ****     }
 277:src/core/selftest_url.c **** }
