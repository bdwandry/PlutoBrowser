 502:Source/render/decoders/webp_container.c **** static int webp_composite(int gray, int a)
 503:Source/render/decoders/webp_container.c **** {
 504:Source/render/decoders/webp_container.c ****     if (a >= 255) return gray;
 505:Source/render/decoders/webp_container.c ****     if (a <= 0) return 255;
 506:Source/render/decoders/webp_container.c ****     return (gray * a + 255 * (255 - a)) / 255;
 507:Source/render/decoders/webp_container.c **** }
