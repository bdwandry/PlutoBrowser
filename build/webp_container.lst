 524:Source/render/decoders/webp_container.c **** /* Convert an ARGB buffer to dithered LCDBitmap exactly like
 525:Source/render/decoders/webp_container.c ****  * WebPDecoder.decode's scale+dither tail. */
 526:Source/render/decoders/webp_container.c **** static LCDBitmap *webp_argb_to_bitmap(const uint32_t *pix, int w, int h,
 527:Source/render/decoders/webp_container.c ****                                       int maxW, int maxH)
 528:Source/render/decoders/webp_container.c **** {
 529:Source/render/decoders/webp_container.c ****     ScaleAccum *acc = scale_accum_new(w, h, maxW, maxH);
 530:Source/render/decoders/webp_container.c ****     int boxW = 0, boxH = 0, targetW = 0, targetH = 0;
 531:Source/render/decoders/webp_container.c ****     scale_box_sizes(w, h, maxW, maxH, &boxW, &boxH, &targetW, &targetH);
 532:Source/render/decoders/webp_container.c ****     if (!acc) return NULL;
 533:Source/render/decoders/webp_container.c **** 
 534:Source/render/decoders/webp_container.c ****     uint8_t *grayRow = (uint8_t *)PLUTO_MALLOC((size_t)(w ? w : 1));
