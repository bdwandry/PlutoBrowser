 253:Source/render/decoders/webp_container.c **** uint32_t webp_blend_pixel_non_premult(uint32_t src, uint32_t dst)
 254:Source/render/decoders/webp_container.c **** {
 255:Source/render/decoders/webp_container.c ****     uint32_t srcA = (src >> 24) & 0xFF;
 256:Source/render/decoders/webp_container.c ****     if (srcA == 0) return dst;
 257:Source/render/decoders/webp_container.c ****     uint32_t dstA = (dst >> 24) & 0xFF;
 258:Source/render/decoders/webp_container.c ****     uint32_t dstFactorA = (dstA * (256 - srcA)) >> 8;
 259:Source/render/decoders/webp_container.c ****     uint32_t blendA = srcA + dstFactorA;
 260:Source/render/decoders/webp_container.c ****     /* Lua: scale = floor(16777216 / blendA); chan = floor(v * scale / 16777216).
 261:Source/render/decoders/webp_container.c ****      * floor(v*scale/16777216) == floor(v * floor(2^24/blendA) / 2^24): the
 262:Source/render/decoders/webp_container.c ****      * double division then floor is exact for these magnitudes, and the
 263:Source/render/decoders/webp_container.c ****      * product v*scale fits 64 bits, so integer math reproduces it exactly. */
 264:Source/render/decoders/webp_container.c ****     uint32_t scale = (uint32_t)(16777216u / blendA);
 265:Source/render/decoders/webp_container.c **** #define WEBP_CHAN(shift)                                                       \
 266:Source/render/decoders/webp_container.c ****     ((((src >> shift) & 0xFF) * srcA + ((dst >> shift) & 0xFF) * dstFactorA)   \
 267:Source/render/decoders/webp_container.c ****      * (uint64_t)scale / 16777216u)
 268:Source/render/decoders/webp_container.c ****     return ((uint32_t)WEBP_CHAN(16) << 16) | ((uint32_t)WEBP_CHAN(8) << 8)
 269:Source/render/decoders/webp_container.c ****            | (uint32_t)WEBP_CHAN(0) | (blendA << 24);
 270:Source/render/decoders/webp_container.c **** #undef WEBP_CHAN
 271:Source/render/decoders/webp_container.c **** }
