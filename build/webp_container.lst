 538:Source/render/decoders/webp_container.c ****         return NULL;
 539:Source/render/decoders/webp_container.c ****     }
 540:Source/render/decoders/webp_container.c ****     for (int y = 0; y < h; y++)
 541:Source/render/decoders/webp_container.c ****     {
 542:Source/render/decoders/webp_container.c ****         /* Tasks.yieldCheck() call site (task layer owns the frame budget) */
 543:Source/render/decoders/webp_container.c ****         int base = y * w;
 544:Source/render/decoders/webp_container.c ****         for (int x = 0; x < w; x++)
 545:Source/render/decoders/webp_container.c ****         {
 546:Source/render/decoders/webp_container.c ****             uint32_t argb = pix[base + x];
 547:Source/render/decoders/webp_container.c ****             int r = (int)((argb >> 16) & 0xFF);
 548:Source/render/decoders/webp_container.c ****             int g = (int)((argb >> 8) & 0xFF);
 549:Source/render/decoders/webp_container.c ****             int b = (int)(argb & 0xFF);
 550:Source/render/decoders/webp_container.c ****             int gv = dither_rgb_to_gray(r, g, b);
 551:Source/render/decoders/webp_container.c ****             grayRow[x] = (uint8_t)webp_composite(gv, (int)((argb >> 24) & 0xFF));
 552:Source/render/decoders/webp_container.c ****         }
 553:Source/render/decoders/webp_container.c ****         scale_accum_add_row(acc, grayRow);
 554:Source/render/decoders/webp_container.c ****     }
 555:Source/render/decoders/webp_container.c ****     int outCount = 0, outWidth = 0;
 556:Source/render/decoders/webp_container.c ****     uint8_t **rows = scale_accum_finish(acc, &outCount, &outWidth);
 557:Source/render/decoders/webp_container.c ****     LCDBitmap *img = NULL;
 558:Source/render/decoders/webp_container.c ****     if (rows && outCount > 0)
 559:Source/render/decoders/webp_container.c ****     {
 560:Source/render/decoders/webp_container.c ****         WebPGrayCtx gc;
 561:Source/render/decoders/webp_container.c ****         gc.pix = NULL;
 562:Source/render/decoders/webp_container.c ****         gc.w = outWidth;
 563:Source/render/decoders/webp_container.c ****         gc.rows = (const uint8_t *const *)rows;
 564:Source/render/decoders/webp_container.c ****         img = dither_to_bitmap(targetW, targetH, webp_out_pixel, &gc);
 565:Source/render/decoders/webp_container.c ****     }
 566:Source/render/decoders/webp_container.c ****     PLUTO_FREE(grayRow);
 567:Source/render/decoders/webp_container.c ****     scale_accum_free(acc);
