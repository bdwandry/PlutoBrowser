 120:src/html/tokenizer.c **** static char* htt_collapse_ws(const char* s, size_t n) {
 121:src/html/tokenizer.c ****     char* out = pluto_malloc(n + 1);
 122:src/html/tokenizer.c ****     if (out == NULL) return NULL;
 123:src/html/tokenizer.c ****     size_t o = 0, i = 0;
 124:src/html/tokenizer.c ****     while (i < n) {
 125:src/html/tokenizer.c ****         if (isspace((unsigned char)s[i])) {
 126:src/html/tokenizer.c ****             out[o++] = ' ';
 127:src/html/tokenizer.c ****             while (i < n && isspace((unsigned char)s[i])) i++;
 128:src/html/tokenizer.c ****         } else {
 129:src/html/tokenizer.c ****             out[o++] = s[i++];
 130:src/html/tokenizer.c ****         }
 131:src/html/tokenizer.c ****     }
 132:src/html/tokenizer.c ****     out[o] = '\0';
 133:src/html/tokenizer.c ****     return out;
 134:src/html/tokenizer.c **** }
