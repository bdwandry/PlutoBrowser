 469:Source/html/tokenizer.c **** /* Collapse runs of whitespace to single spaces (Lua gsub("%s+"," ")). */
 470:Source/html/tokenizer.c **** static void collapse_ws(const char *src, size_t len, char *dst, size_t dstCap)
 471:Source/html/tokenizer.c **** {
 472:Source/html/tokenizer.c ****     size_t o = 0;
 473:Source/html/tokenizer.c ****     int lastSpace = 0;
 474:Source/html/tokenizer.c ****     for (size_t i = 0; i < len && o + 1 < dstCap; i++)
 475:Source/html/tokenizer.c ****     {
 476:Source/html/tokenizer.c ****         char c = src[i];
 477:Source/html/tokenizer.c ****         if (isspace((unsigned char)c))
 478:Source/html/tokenizer.c ****         {
 479:Source/html/tokenizer.c ****             if (!lastSpace && o > 0)
 480:Source/html/tokenizer.c ****             {
 481:Source/html/tokenizer.c ****                 dst[o++] = ' ';
 482:Source/html/tokenizer.c ****             }
 483:Source/html/tokenizer.c ****             lastSpace = 1;
 484:Source/html/tokenizer.c ****         }
 485:Source/html/tokenizer.c ****         else
 486:Source/html/tokenizer.c ****         {
 487:Source/html/tokenizer.c ****             dst[o++] = c;
 488:Source/html/tokenizer.c ****             lastSpace = 0;
 489:Source/html/tokenizer.c ****         }
 490:Source/html/tokenizer.c ****     }
 491:Source/html/tokenizer.c ****     while (o > 0 && dst[o - 1] == ' ')
 492:Source/html/tokenizer.c ****     {
 493:Source/html/tokenizer.c ****         o--; /* trim trailing */
 494:Source/html/tokenizer.c ****     }
 495:Source/html/tokenizer.c ****     dst[o] = '\0';
 496:Source/html/tokenizer.c **** }
