 268:Source/html/tokenizer.c ****             }
 269:Source/html/tokenizer.c ****         } else {
 270:Source/html/tokenizer.c ****             int isClosing = rinN > 0 && rinP[0] == '/';
 271:Source/html/tokenizer.c ****             const char* bodyP = isClosing ? rinP + 1 : rinP;
