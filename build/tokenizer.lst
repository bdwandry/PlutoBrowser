 198:Source/html/tokenizer.c ****     if (!k)
 199:Source/html/tokenizer.c ****     {
 200:Source/html/tokenizer.c ****         return -1;
 201:Source/html/tokenizer.c ****     }
 202:Source/html/tokenizer.c ****     char *raw = (char *)PLUTO_MALLOC(vlen + 1);
 203:Source/html/tokenizer.c ****     if (!raw)
 204:Source/html/tokenizer.c ****     {
 205:Source/html/tokenizer.c ****         return -1;
 206:Source/html/tokenizer.c ****     }
 207:Source/html/tokenizer.c ****     memcpy(raw, val, vlen);
 208:Source/html/tokenizer.c ****     raw[vlen] = '\0';
 209:Source/html/tokenizer.c ****     char *dec = entities_decode(raw);
 210:Source/html/tokenizer.c ****     PLUTO_FREE(raw);
 211:Source/html/tokenizer.c ****     if (!dec)
 212:Source/html/tokenizer.c ****     {
 213:Source/html/tokenizer.c ****         return -1;
 214:Source/html/tokenizer.c ****     }
 215:Source/html/tokenizer.c ****     char *v = arena_dup(arena, dec, strlen(dec));
 216:Source/html/tokenizer.c ****     pluto_free(dec);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccKIrz6f.s 			page 10


 217:Source/html/tokenizer.c ****     if (!v)
 218:Source/html/tokenizer.c ****     {
 219:Source/html/tokenizer.c ****         return -1;
 220:Source/html/tokenizer.c ****     }
 221:Source/html/tokenizer.c ****     return attr_push(tok, k, v);
 222:Source/html/tokenizer.c **** }
