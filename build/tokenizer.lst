 177:Source/html/tokenizer.c **** static int attr_has_key(const Token *tok, const char *key)
 178:Source/html/tokenizer.c **** {
 179:Source/html/tokenizer.c ****     for (int a = 0; a < tok->attrCount; a++)
 180:Source/html/tokenizer.c ****     {
 181:Source/html/tokenizer.c ****         if (strcmp(tok->attrs[a].key, key) == 0)
 182:Source/html/tokenizer.c ****         {
 183:Source/html/tokenizer.c ****             return 1;
 184:Source/html/tokenizer.c ****         }
 185:Source/html/tokenizer.c ****     }
 186:Source/html/tokenizer.c ****     return 0;
 187:Source/html/tokenizer.c **** }
