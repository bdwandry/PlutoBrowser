 165:Source/html/tokenizer.c **** static int attr_push(Token *t, char *key, char *value)
 166:Source/html/tokenizer.c **** {
 167:Source/html/tokenizer.c ****     if (attr_ensure_cap(t) != 0)
 168:Source/html/tokenizer.c ****     {
 169:Source/html/tokenizer.c ****         return -1;
 170:Source/html/tokenizer.c ****     }
 171:Source/html/tokenizer.c ****     t->attrs[t->attrCount].key = key;
 172:Source/html/tokenizer.c ****     t->attrs[t->attrCount].value = value;
 173:Source/html/tokenizer.c ****     t->attrCount++;
 174:Source/html/tokenizer.c ****     return 0;
 175:Source/html/tokenizer.c **** }
