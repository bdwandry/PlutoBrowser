 224:Source/html/tokenizer.c **** /* ── findTagEnd: closing '>' of a tag, skipping quoted values ──────────�
 225:Source/html/tokenizer.c **** static const char *find_tag_end(const char *p)
 226:Source/html/tokenizer.c **** {
 227:Source/html/tokenizer.c ****     while (*p)
 228:Source/html/tokenizer.c ****     {
 229:Source/html/tokenizer.c ****         while (*p && *p != '>' && *p != '"' && *p != '\'')
 230:Source/html/tokenizer.c ****         {
 231:Source/html/tokenizer.c ****             p++;
 232:Source/html/tokenizer.c ****         }
 233:Source/html/tokenizer.c ****         if (!*p)
 234:Source/html/tokenizer.c ****         {
 235:Source/html/tokenizer.c ****             return NULL;
 236:Source/html/tokenizer.c ****         }
 237:Source/html/tokenizer.c ****         if (*p == '>')
 238:Source/html/tokenizer.c ****         {
 239:Source/html/tokenizer.c ****             return p;
 240:Source/html/tokenizer.c ****         }
 241:Source/html/tokenizer.c ****         char q = *p; /* inside a quoted value: skip to the matching quote */
 242:Source/html/tokenizer.c ****         p++;
 243:Source/html/tokenizer.c ****         while (*p && *p != q)
 244:Source/html/tokenizer.c ****         {
 245:Source/html/tokenizer.c ****             p++;
 246:Source/html/tokenizer.c ****         }
 247:Source/html/tokenizer.c ****         if (!*p)
 248:Source/html/tokenizer.c ****         {
 249:Source/html/tokenizer.c ****             return NULL;
 250:Source/html/tokenizer.c ****         }
 251:Source/html/tokenizer.c ****         p++;
 252:Source/html/tokenizer.c ****     }
 253:Source/html/tokenizer.c ****     return NULL;
 254:Source/html/tokenizer.c **** }
