 417:Source/html/tokenizer.c **** /* Trim [b,e) like Lua gsub("^%s*(.-)%s*$","%1"). */
 418:Source/html/tokenizer.c **** static void trim_span(const char **b, const char **e)
 419:Source/html/tokenizer.c **** {
 420:Source/html/tokenizer.c ****     while (*b < *e && isspace((unsigned char)**b))
