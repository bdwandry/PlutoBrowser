 120:Source/html/tokenizer.c **** static char* htt_collapse_ws(const char* s, size_t n) {
 121:Source/html/tokenizer.c ****     char* out = pluto_malloc(n + 1);
 122:Source/html/tokenizer.c ****     if (out == NULL) return NULL;
 123:Source/html/tokenizer.c ****     size_t o = 0, i = 0;
 124:Source/html/tokenizer.c ****     while (i < n) {
 125:Source/html/tokenizer.c ****         if (isspace((unsigned char)s[i])) {
 126:Source/html/tokenizer.c ****             out[o++] = ' ';
 127:Source/html/tokenizer.c ****             while (i < n && isspace((unsigned char)s[i])) i++;
 128:Source/html/tokenizer.c ****         } else {
 129:Source/html/tokenizer.c ****             out[o++] = s[i++];
 130:Source/html/tokenizer.c ****         }
 131:Source/html/tokenizer.c ****     }
 132:Source/html/tokenizer.c ****     out[o] = '\0';
 133:Source/html/tokenizer.c ****     return out;
 134:Source/html/tokenizer.c **** }
