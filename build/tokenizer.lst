 256:Source/html/tokenizer.c **** /* Bounded substring search. */
 257:Source/html/tokenizer.c **** static const char *find_from(const char *hay, const char *hayEnd,
 258:Source/html/tokenizer.c ****                              const char *needle, size_t needleLen)
 259:Source/html/tokenizer.c **** {
 260:Source/html/tokenizer.c ****     if (needleLen == 0 || hayEnd - hay < (ptrdiff_t)needleLen)
 261:Source/html/tokenizer.c ****     {
 262:Source/html/tokenizer.c ****         return NULL;
 263:Source/html/tokenizer.c ****     }
 264:Source/html/tokenizer.c ****     for (const char *p = hay; p + (ptrdiff_t)needleLen <= hayEnd; p++)
 265:Source/html/tokenizer.c ****     {
 266:Source/html/tokenizer.c ****         if (*p == needle[0] && memcmp(p, needle, needleLen) == 0)
 267:Source/html/tokenizer.c ****         {
 268:Source/html/tokenizer.c ****             return p;
 269:Source/html/tokenizer.c ****         }
 270:Source/html/tokenizer.c ****     }
 271:Source/html/tokenizer.c ****     return NULL;
 272:Source/html/tokenizer.c **** }
