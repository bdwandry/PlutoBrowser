 346:Source/html/tokenizer.c ****                 if (!k || attr_push(tok, k, (char *)PLUTO_TOK_ATTR_TRUE) != 0)
 347:Source/html/tokenizer.c ****                 {
 348:Source/html/tokenizer.c ****                     return -1;
 349:Source/html/tokenizer.c ****                 }
 350:Source/html/tokenizer.c ****             }
 351:Source/html/tokenizer.c ****             i = ke;
 352:Source/html/tokenizer.c ****             continue;
 353:Source/html/tokenizer.c ****         }
 354:Source/html/tokenizer.c **** 
 355:Source/html/tokenizer.c ****         /* Lua: vs = find(attrStr, "%S", ke + 1) — starts right after the key,
 356:Source/html/tokenizer.c ****          * so with a spaced '=' this lands ON '=' (empty value quirk). */
 357:Source/html/tokenizer.c ****         const char *vs = ke + 1;
 358:Source/html/tokenizer.c ****         while (vs < n && isspace((unsigned char)*vs))
 359:Source/html/tokenizer.c ****         {
 360:Source/html/tokenizer.c ****             vs++;
 361:Source/html/tokenizer.c ****         }
