 111:src/html/tokenizer.c **** static const char* htt_find_ci(const char* s, size_t n, size_t from,
 112:src/html/tokenizer.c ****                                const char* lit, size_t litLen) {
 113:src/html/tokenizer.c ****     if (litLen == 0 || n < litLen) return NULL;
 114:src/html/tokenizer.c ****     for (size_t i = from; i + litLen <= n; i++) {
 115:src/html/tokenizer.c ****         if (strncasecmp(s + i, lit, litLen) == 0) return s + i;
 116:src/html/tokenizer.c ****     }
 117:src/html/tokenizer.c ****     return NULL;
 118:src/html/tokenizer.c **** }
