  92:src/html/tokenizer.c **** static long htt_find_tag_end(const char* s, size_t n, size_t startIdx) {
  93:src/html/tokenizer.c ****     size_t i = startIdx;
  94:src/html/tokenizer.c ****     while (i < n) {
  95:src/html/tokenizer.c ****         const char* m = memchr(s + i, '>', n - i);
  96:src/html/tokenizer.c ****         const char* dq = memchr(s + i, '"', n - i);
  97:src/html/tokenizer.c ****         const char* sq = memchr(s + i, '\'', n - i);
  98:src/html/tokenizer.c ****         const char* hit = m;
  99:src/html/tokenizer.c ****         if (hit == NULL || (dq != NULL && dq < hit)) hit = dq;
 100:src/html/tokenizer.c ****         if (hit == NULL || (sq != NULL && sq < hit)) hit = sq;
 101:src/html/tokenizer.c ****         if (hit == NULL) return -1;
 102:src/html/tokenizer.c ****         char b = *hit;
 103:src/html/tokenizer.c ****         if (b == '>') return (long)(hit - s);
 104:src/html/tokenizer.c ****         const char* close = memchr(hit + 1, b, n - (size_t)(hit - s) - 1);
 105:src/html/tokenizer.c ****         if (close == NULL) return -1;
 106:src/html/tokenizer.c ****         i = (size_t)(close - s) + 1;
 107:src/html/tokenizer.c ****     }
 108:src/html/tokenizer.c ****     return -1;
 109:src/html/tokenizer.c **** }
