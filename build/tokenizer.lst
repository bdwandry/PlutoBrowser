  92:Source/html/tokenizer.c **** static long htt_find_tag_end(const char* s, size_t n, size_t startIdx) {
  93:Source/html/tokenizer.c ****     size_t i = startIdx;
  94:Source/html/tokenizer.c ****     while (i < n) {
  95:Source/html/tokenizer.c ****         const char* m = memchr(s + i, '>', n - i);
  96:Source/html/tokenizer.c ****         const char* dq = memchr(s + i, '"', n - i);
  97:Source/html/tokenizer.c ****         const char* sq = memchr(s + i, '\'', n - i);
  98:Source/html/tokenizer.c ****         const char* hit = m;
  99:Source/html/tokenizer.c ****         if (hit == NULL || (dq != NULL && dq < hit)) hit = dq;
 100:Source/html/tokenizer.c ****         if (hit == NULL || (sq != NULL && sq < hit)) hit = sq;
 101:Source/html/tokenizer.c ****         if (hit == NULL) return -1;
 102:Source/html/tokenizer.c ****         char b = *hit;
 103:Source/html/tokenizer.c ****         if (b == '>') return (long)(hit - s);
 104:Source/html/tokenizer.c ****         const char* close = memchr(hit + 1, b, n - (size_t)(hit - s) - 1);
 105:Source/html/tokenizer.c ****         if (close == NULL) return -1;
 106:Source/html/tokenizer.c ****         i = (size_t)(close - s) + 1;
 107:Source/html/tokenizer.c ****     }
 108:Source/html/tokenizer.c ****     return -1;
 109:Source/html/tokenizer.c **** }
