 189:Source/html/tokenizer.c **** /* Store an attribute (entity-decoded) if the key is not already present. */
 190:Source/html/tokenizer.c **** static int store_attr(Token *tok, Arena *arena, const char *key,
 191:Source/html/tokenizer.c ****                       const char *val, size_t vlen)
 192:Source/html/tokenizer.c **** {
 193:Source/html/tokenizer.c ****     if (attr_has_key(tok, key))
 194:Source/html/tokenizer.c ****     {
 195:Source/html/tokenizer.c ****         return 0; /* first-wins parity (Lua: attrs[lk] == nil guard) */
 196:Source/html/tokenizer.c ****     }
