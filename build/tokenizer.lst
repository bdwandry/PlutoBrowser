  44:Source/html/tokenizer.c **** /* ── String arena: chunk list (same design as dom.c) ─────────────�
  45:Source/html/tokenizer.c ****  * Pointers handed out by arena_dup must stay valid for the result's lifetime
  46:Source/html/tokenizer.c ****  * even as more strings are added — so chunks are allocated once and never
  47:Source/html/tokenizer.c ****  * moved/reallocated. A chunk that fills up is retired; a new one is appended. */
  48:Source/html/tokenizer.c **** typedef struct ArenaChunk
  49:Source/html/tokenizer.c **** {
  50:Source/html/tokenizer.c ****     struct ArenaChunk *next;
  51:Source/html/tokenizer.c ****     size_t used;
  52:Source/html/tokenizer.c ****     size_t cap;
  53:Source/html/tokenizer.c ****     char data[]; /* flexible array member */
  54:Source/html/tokenizer.c **** } ArenaChunk;
  55:Source/html/tokenizer.c **** 
  56:Source/html/tokenizer.c **** typedef struct
  57:Source/html/tokenizer.c **** {
  58:Source/html/tokenizer.c ****     ArenaChunk *head;
  59:Source/html/tokenizer.c ****     ArenaChunk *tail;
  60:Source/html/tokenizer.c **** } Arena;
  61:Source/html/tokenizer.c **** 
  62:Source/html/tokenizer.c **** #define ARENA_CHUNK_MIN 8192
  63:Source/html/tokenizer.c **** 
  64:Source/html/tokenizer.c **** static int arena_reserve(Arena *a, size_t extra)
  65:Source/html/tokenizer.c **** {
  66:Source/html/tokenizer.c ****     if (a->tail && a->tail->cap - a->tail->used >= extra + 1)
  67:Source/html/tokenizer.c ****     {
  68:Source/html/tokenizer.c ****         return 0;
  69:Source/html/tokenizer.c ****     }
  70:Source/html/tokenizer.c ****     size_t cap = ARENA_CHUNK_MIN;
  71:Source/html/tokenizer.c ****     if (extra + 1 > cap)
  72:Source/html/tokenizer.c ****     {
  73:Source/html/tokenizer.c ****         cap = extra + 1; /* oversized string gets its own right-sized chunk */
  74:Source/html/tokenizer.c ****     }
  75:Source/html/tokenizer.c ****     ArenaChunk *c = (ArenaChunk *)PLUTO_MALLOC(sizeof(ArenaChunk) + cap);
  76:Source/html/tokenizer.c ****     if (!c)
  77:Source/html/tokenizer.c ****     {
  78:Source/html/tokenizer.c ****         return -1;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccKIrz6f.s 			page 4


  79:Source/html/tokenizer.c ****     }
  80:Source/html/tokenizer.c ****     c->next = NULL;
  81:Source/html/tokenizer.c ****     c->used = 0;
  82:Source/html/tokenizer.c ****     c->cap = cap;
  83:Source/html/tokenizer.c ****     if (a->tail)
  84:Source/html/tokenizer.c ****     {
  85:Source/html/tokenizer.c ****         a->tail->next = c;
  86:Source/html/tokenizer.c ****     }
  87:Source/html/tokenizer.c ****     else
  88:Source/html/tokenizer.c ****     {
  89:Source/html/tokenizer.c ****         a->head = c;
  90:Source/html/tokenizer.c ****     }
  91:Source/html/tokenizer.c ****     a->tail = c;
  92:Source/html/tokenizer.c ****     return 0;
  93:Source/html/tokenizer.c **** }
  94:Source/html/tokenizer.c **** 
  95:Source/html/tokenizer.c **** /* Copy `n` bytes + NUL into the arena; returns pointer or NULL on failure. */
  96:Source/html/tokenizer.c **** static char *arena_dup(Arena *a, const char *s, size_t n)
  97:Source/html/tokenizer.c **** {
  98:Source/html/tokenizer.c ****     if (arena_reserve(a, n) != 0)
  99:Source/html/tokenizer.c ****     {
 100:Source/html/tokenizer.c ****         return NULL;
 101:Source/html/tokenizer.c ****     }
 102:Source/html/tokenizer.c ****     char *out = a->tail->data + a->tail->used;
 103:Source/html/tokenizer.c ****     memcpy(out, s, n);
 104:Source/html/tokenizer.c ****     out[n] = '\0';
 105:Source/html/tokenizer.c ****     a->tail->used += n + 1;
 106:Source/html/tokenizer.c ****     return out;
 107:Source/html/tokenizer.c **** }
