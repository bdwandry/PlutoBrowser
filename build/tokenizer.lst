 291:Source/html/tokenizer.c **** static int parse_attributes(const char *p0, const char *n0, Token *tok, Arena *arena)
 292:Source/html/tokenizer.c **** {
 293:Source/html/tokenizer.c ****     const char *i = p0;
 294:Source/html/tokenizer.c ****     const char *n = n0;
 295:Source/html/tokenizer.c ****     while (i < n)
 296:Source/html/tokenizer.c ****     {
 297:Source/html/tokenizer.c ****         /* find next non-space (%S) */
 298:Source/html/tokenizer.c ****         while (i < n && isspace((unsigned char)*i))
 299:Source/html/tokenizer.c ****         {
 300:Source/html/tokenizer.c ****             i++;
 301:Source/html/tokenizer.c ****         }
 302:Source/html/tokenizer.c ****         if (i >= n)
 303:Source/html/tokenizer.c ****         {
 304:Source/html/tokenizer.c ****             break;
 305:Source/html/tokenizer.c ****         }
 306:Source/html/tokenizer.c ****         const char *s = i;
 307:Source/html/tokenizer.c **** 
 308:Source/html/tokenizer.c ****         /* key end: first char not in [%w%-_:] */
 309:Source/html/tokenizer.c ****         const char *ke = s;
 310:Source/html/tokenizer.c ****         while (ke < n && (isalnum((unsigned char)*ke) || *ke == '-' || *ke == '_' || *ke == ':'))
 311:Source/html/tokenizer.c ****         {
 312:Source/html/tokenizer.c ****             ke++;
 313:Source/html/tokenizer.c ****         }
 314:Source/html/tokenizer.c ****         if (ke == s)
 315:Source/html/tokenizer.c ****         {
 316:Source/html/tokenizer.c ****             i = s + 1;
 317:Source/html/tokenizer.c ****             continue;
 318:Source/html/tokenizer.c ****         }
 319:Source/html/tokenizer.c **** 
 320:Source/html/tokenizer.c ****         size_t klen = (size_t)(ke - s);
 321:Source/html/tokenizer.c ****         char lowerKey[64];
 322:Source/html/tokenizer.c ****         if (klen >= sizeof(lowerKey))
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccKIrz6f.s 			page 23


 323:Source/html/tokenizer.c ****         {
 324:Source/html/tokenizer.c ****             klen = sizeof(lowerKey) - 1;
 325:Source/html/tokenizer.c ****         }
 326:Source/html/tokenizer.c ****         for (size_t c = 0; c < klen; c++)
 327:Source/html/tokenizer.c ****         {
 328:Source/html/tokenizer.c ****             lowerKey[c] = (char)tolower((unsigned char)s[c]);
 329:Source/html/tokenizer.c ****         }
 330:Source/html/tokenizer.c ****         lowerKey[klen] = '\0';
 331:Source/html/tokenizer.c **** 
 332:Source/html/tokenizer.c ****         /* Lua: string.find(attrStr, "^%s*=", ke) — whitespace BEFORE '=' only */
 333:Source/html/tokenizer.c ****         const char *e = ke;
