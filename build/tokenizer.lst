 132:Source/html/tokenizer.c **** /* Attr storage: arrays grow by doubling; attr capacity is derived from
 133:Source/html/tokenizer.c ****  * attrCount (attr counts per tag are tiny; correctness over speed). */
 134:Source/html/tokenizer.c **** static int attr_ensure_cap(Token *t)
 135:Source/html/tokenizer.c **** {
 136:Source/html/tokenizer.c ****     int cap = 4;
 137:Source/html/tokenizer.c ****     while (cap < t->attrCount + 1)
 138:Source/html/tokenizer.c ****     {
 139:Source/html/tokenizer.c ****         cap *= 2;
 140:Source/html/tokenizer.c ****     }
 141:Source/html/tokenizer.c ****     if (t->attrs && cap <= 4 && t->attrCount < 4)
 142:Source/html/tokenizer.c ****     {
 143:Source/html/tokenizer.c ****         return 0; /* initial block already large enough */
 144:Source/html/tokenizer.c ****     }
 145:Source/html/tokenizer.c ****     if (t->attrCount == 0)
 146:Source/html/tokenizer.c ****     {
 147:Source/html/tokenizer.c ****         if (!t->attrs)
 148:Source/html/tokenizer.c ****         {
 149:Source/html/tokenizer.c ****             t->attrs = (TokenAttr *)PLUTO_MALLOC((size_t)cap * sizeof(TokenAttr));
 150:Source/html/tokenizer.c ****             return t->attrs ? 0 : -1;
 151:Source/html/tokenizer.c ****         }
 152:Source/html/tokenizer.c ****         return 0;
 153:Source/html/tokenizer.c ****     }
 154:Source/html/tokenizer.c ****     TokenAttr *na = (TokenAttr *)PLUTO_MALLOC((size_t)cap * sizeof(TokenAttr));
 155:Source/html/tokenizer.c ****     if (!na)
 156:Source/html/tokenizer.c ****     {
 157:Source/html/tokenizer.c ****         return -1;
 158:Source/html/tokenizer.c ****     }
 159:Source/html/tokenizer.c ****     memcpy(na, t->attrs, (size_t)t->attrCount * sizeof(TokenAttr));
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccKIrz6f.s 			page 9


 160:Source/html/tokenizer.c ****     PLUTO_FREE(t->attrs);
 161:Source/html/tokenizer.c ****     t->attrs = na;
 162:Source/html/tokenizer.c ****     return 0;
 163:Source/html/tokenizer.c **** }
