  78:src/render/selftest_style.c ****                                                        NULL),
  79:src/render/selftest_style.c ****                                  "Hello World");
  80:src/render/selftest_style.c ****         int wH1 =
  81:src/render/selftest_style.c ****             style_get_text_width(style_get_heading_font(1, NULL, NULL),
  82:src/render/selftest_style.c ****                                  "Hello World");
  83:src/render/selftest_style.c ****         ck("W.real_fonts_positive",
  84:src/render/selftest_style.c ****            wBody > 0 && wCode > 0 && wSmall > 0 && wH1 > 0);
  85:src/render/selftest_style.c ****         PLUTO_LOG("[P13] sample 'Hello World' widths: body=%d mono=%d "
  86:src/render/selftest_style.c ****                   "small=%d h1=%d", wBody, wCode, wSmall, wH1);
  87:src/render/selftest_style.c ****     }
