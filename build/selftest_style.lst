  63:Source/render/selftest_style.c **** 
  64:Source/render/selftest_style.c ****     /* host harness (no Playdate API): Lua's last resort of 8 px per char */
  65:Source/render/selftest_style.c ****     int estimating = style_get_text_width(NULL, "Hello") == 40;
  66:Source/render/selftest_style.c ****     if (estimating) {
