  62:src/render/selftest_style.c **** 
  63:src/render/selftest_style.c ****     /* host harness (no Playdate API): Lua's last resort of 8 px per char */
  64:src/render/selftest_style.c ****     int estimating = style_get_text_width(NULL, "Hello") == 40;
  65:src/render/selftest_style.c ****     if (estimating) {
  66:src/render/selftest_style.c ****         ck("W.estimate_8px_per_char",
  67:src/render/selftest_style.c ****            style_get_text_width(NULL, "Hello") == 40 &&
  68:src/render/selftest_style.c ****            style_get_text_width(NULL, "A") == 8 &&
  69:src/render/selftest_style.c ****            style_get_text_width(NULL, "two words") == 72);
  70:src/render/selftest_style.c ****     } else {
  71:src/render/selftest_style.c ****         /* device/sim: real fonts loaded -- sanity only */
  72:src/render/selftest_style.c ****         int wBody = style_get_text_width(NULL, "Hello World");
  73:src/render/selftest_style.c ****         int wCode =
  74:src/render/selftest_style.c ****             style_get_text_width(style_get_body_font(0, 1, NULL),
  75:src/render/selftest_style.c ****                                  "Hello World");
  76:src/render/selftest_style.c ****         int wSmall =
