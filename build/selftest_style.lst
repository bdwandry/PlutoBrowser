  79:Source/render/selftest_style.c ****                                                        NULL),
  80:Source/render/selftest_style.c ****                                  "Hello World");
  81:Source/render/selftest_style.c ****         int wH1 =
  82:Source/render/selftest_style.c ****             style_get_text_width(style_get_heading_font(1, NULL, NULL),
  83:Source/render/selftest_style.c ****                                  "Hello World");
  84:Source/render/selftest_style.c ****         ck("W.real_fonts_positive",
  85:Source/render/selftest_style.c ****            wBody > 0 && wCode > 0 && wSmall > 0 && wH1 > 0);
  86:Source/render/selftest_style.c ****         PLUTO_LOG("[P13] sample 'Hello World' widths: body=%d mono=%d "
  87:Source/render/selftest_style.c ****                   "small=%d h1=%d", wBody, wCode, wSmall, wH1);
  88:Source/render/selftest_style.c ****     }
