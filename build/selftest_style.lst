  13:Source/render/selftest_style.c **** /* ── heading / body / inline mapping (environment-independent) ────────── 
  14:Source/render/selftest_style.c **** 
  15:Source/render/selftest_style.c **** static void case_mapping(void) {
  16:Source/render/selftest_style.c ****     /* Lua Style.getHeadingFont -> font, lineH(24/18/16), marginB(6/5/4) */
  17:Source/render/selftest_style.c ****     struct { int level, lh, mb; } H[] = {
  18:Source/render/selftest_style.c ****         {1, 24, 6}, {2, 18, 5}, {3, 16, 4},
  19:Source/render/selftest_style.c ****         {4, 16, 4}, {5, 16, 4}, {6, 16, 4},
  20:Source/render/selftest_style.c ****         {0, 16, 4}, {7, 16, 4}, {-3, 16, 4}
  21:Source/render/selftest_style.c ****     };
  22:Source/render/selftest_style.c ****     int ok = 1;
  23:Source/render/selftest_style.c ****     for (size_t i = 0; i < sizeof(H) / sizeof(H[0]); i++) {
  24:Source/render/selftest_style.c ****         int lh = -1, mb = -1;
  25:Source/render/selftest_style.c ****         style_get_heading_font(H[i].level, &lh, &mb);
  26:Source/render/selftest_style.c ****         if (lh != H[i].lh || mb != H[i].mb) ok = 0;
  27:Source/render/selftest_style.c ****     }
  28:Source/render/selftest_style.c ****     ck("H.heading_map", ok);
  29:Source/render/selftest_style.c **** 
  30:Source/render/selftest_style.c ****     int sz;
  31:Source/render/selftest_style.c ****     style_get_body_font(0, 0, &sz);
  32:Source/render/selftest_style.c ****     ck("H.body_plain_16", sz == 16);
