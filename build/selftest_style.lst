  68:Source/render/selftest_style.c ****            style_get_text_width(NULL, "Hello") == 40 &&
  69:Source/render/selftest_style.c ****            style_get_text_width(NULL, "A") == 8 &&
  70:Source/render/selftest_style.c ****            style_get_text_width(NULL, "two words") == 72);
  71:Source/render/selftest_style.c ****     } else {
  72:Source/render/selftest_style.c ****         /* device/sim: real fonts loaded -- sanity only */
  73:Source/render/selftest_style.c ****         int wBody = style_get_text_width(NULL, "Hello World");
  74:Source/render/selftest_style.c ****         int wCode =
  75:Source/render/selftest_style.c ****             style_get_text_width(style_get_body_font(0, 1, NULL),
  76:Source/render/selftest_style.c ****                                  "Hello World");
  77:Source/render/selftest_style.c ****         int wSmall =
