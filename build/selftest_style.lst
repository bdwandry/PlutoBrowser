  13:src/render/selftest_style.c **** /* ── heading / body / inline mapping (environment-independent) ────────── 
  14:src/render/selftest_style.c **** 
  15:src/render/selftest_style.c **** static void case_mapping(void) {
  16:src/render/selftest_style.c ****     struct { int level, size, lh; } H[] = {
  17:src/render/selftest_style.c ****         {1, 24, 6}, {2, 18, 5}, {3, 16, 4},
  18:src/render/selftest_style.c ****         {4, 16, 4}, {5, 16, 4}, {6, 16, 4},
  19:src/render/selftest_style.c ****         {0, 16, 4}, {7, 16, 4}, {-3, 16, 4}
  20:src/render/selftest_style.c ****     };
  21:src/render/selftest_style.c ****     int ok = 1;
  22:src/render/selftest_style.c ****     for (size_t i = 0; i < sizeof(H) / sizeof(H[0]); i++) {
  23:src/render/selftest_style.c ****         int sz = -1, lh = -1;
  24:src/render/selftest_style.c ****         style_get_heading_font(H[i].level, &sz, &lh);
  25:src/render/selftest_style.c ****         if (sz != H[i].size || lh != H[i].lh) ok = 0;
  26:src/render/selftest_style.c ****     }
  27:src/render/selftest_style.c ****     ck("H.heading_map", ok);
  28:src/render/selftest_style.c **** 
  29:src/render/selftest_style.c ****     int sz;
  30:src/render/selftest_style.c ****     style_get_body_font(0, 0, &sz);
  31:src/render/selftest_style.c ****     ck("H.body_plain_16", sz == 16);
  32:src/render/selftest_style.c ****     style_get_body_font(1, 0, &sz);
