   1:src/ui/address_bar.c **** // address_bar.c — P29: C port of CometBrowser Source/ui/address_bar.lua.
   2:src/ui/address_bar.c **** //
   3:src/ui/address_bar.c **** // Address bar controller: armed pill -> system-style on-screen keyboard
   4:src/ui/address_bar.c **** // (vendored Raphcal C port) -> submit decision (search query vs URL).
   5:src/ui/address_bar.c **** //
   6:src/ui/address_bar.c **** // Lua parity notes:
   7:src/ui/address_bar.c **** //   - open() prefills currentUrl unless it matches ^about:
   8:src/ui/address_bar.c **** //   - launchKeyboard() refuses while B is held so B+Left/Right work first,
   9:src/ui/address_bar.c **** //     and only once per open
  10:src/ui/address_bar.c **** //   - keyboardWillHide(submitted): trim whitespace; empty or cancelled just
  11:src/ui/address_bar.c **** //     closes (skipInputFrames=2); otherwise search-query vs URL.parse
  12:src/ui/address_bar.c **** //     normalized feeds onSubmitCallback
  13:src/ui/address_bar.c **** //   - cancel(): hides keyboard, clears callbacks
  14:src/ui/address_bar.c **** //   - drawOverlay(): two layouts (armed pill vs keyboard-side box with a
  15:src/ui/address_bar.c **** //     vertically-wrapped mono text)
  16:src/ui/address_bar.c **** 
