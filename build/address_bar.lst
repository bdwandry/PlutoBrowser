   1:Source/ui/address_bar.c **** // address_bar.c — P29: C port of CometBrowser Source/ui/address_bar.lua.
   2:Source/ui/address_bar.c **** //
   3:Source/ui/address_bar.c **** // Address bar controller: armed pill -> system-style on-screen keyboard
   4:Source/ui/address_bar.c **** // (vendored Raphcal C port) -> submit decision (search query vs URL).
   5:Source/ui/address_bar.c **** //
   6:Source/ui/address_bar.c **** // Lua parity notes:
   7:Source/ui/address_bar.c **** //   - open() prefills currentUrl unless it matches ^about:
   8:Source/ui/address_bar.c **** //   - launchKeyboard() refuses while B is held so B+Left/Right work first,
   9:Source/ui/address_bar.c **** //     and only once per open
  10:Source/ui/address_bar.c **** //   - keyboardWillHide(submitted): trim whitespace; empty or cancelled just
  11:Source/ui/address_bar.c **** //     closes (skipInputFrames=2); otherwise search-query vs URL.parse
  12:Source/ui/address_bar.c **** //     normalized feeds onSubmitCallback
  13:Source/ui/address_bar.c **** //   - cancel(): hides keyboard, clears callbacks
  14:Source/ui/address_bar.c **** //   - drawOverlay(): two layouts (armed pill vs keyboard-side box with a
  15:Source/ui/address_bar.c **** //     vertically-wrapped mono text)
