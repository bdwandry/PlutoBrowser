  61:Source/ui/address_bar.c ****               c == '\v' || c == '\f')) {
  62:Source/ui/address_bar.c ****             break;
  63:Source/ui/address_bar.c ****         }
  64:Source/ui/address_bar.c ****         end--;
  65:Source/ui/address_bar.c ****     }
  66:Source/ui/address_bar.c **** 
  67:Source/ui/address_bar.c ****     size_t len = (size_t)(end - p);
