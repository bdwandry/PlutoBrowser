 126:Source/js/jsgc.c **** static void jsG_markstack(js_State *J, int mark)
 127:Source/js/jsgc.c **** {
 128:Source/js/jsgc.c **** 	js_Value *v = J->stack;
 129:Source/js/jsgc.c **** 	int n = J->top;
 130:Source/js/jsgc.c **** 	while (n--) {
 131:Source/js/jsgc.c **** 		if (v->t.type == JS_TMEMSTR && v->u.memstr->gcmark != mark)
 132:Source/js/jsgc.c **** 			v->u.memstr->gcmark = mark;
 133:Source/js/jsgc.c **** 		if (v->t.type == JS_TOBJECT && v->u.object->gcmark != mark)
 134:Source/js/jsgc.c **** 			jsG_markobject(J, mark, v->u.object);
 135:Source/js/jsgc.c **** 		++v;
 136:Source/js/jsgc.c **** 	}
 137:Source/js/jsgc.c **** }
