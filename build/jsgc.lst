  43:Source/js/jsgc.c **** 			js_free(J, obj->u.s.string);
  44:Source/js/jsgc.c **** 	}
  45:Source/js/jsgc.c **** 	if (obj->type == JS_CARRAY && obj->u.a.simple)
  46:Source/js/jsgc.c **** 		js_free(J, obj->u.a.array);
