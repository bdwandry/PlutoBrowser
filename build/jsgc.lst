  48:Source/js/jsgc.c **** 		jsG_freeiterator(J, obj->u.iter.head);
  49:Source/js/jsgc.c **** 	if (obj->type == JS_CUSERDATA && obj->u.user.finalize)
  50:Source/js/jsgc.c **** 		obj->u.user.finalize(J, obj->u.user.data);
  51:Source/js/jsgc.c **** 	if (obj->type == JS_CCFUNCTION && obj->u.c.finalize)
  52:Source/js/jsgc.c **** 		obj->u.c.finalize(J, obj->u.c.data);
  53:Source/js/jsgc.c **** 	js_free(J, obj);
  54:Source/js/jsgc.c **** }
