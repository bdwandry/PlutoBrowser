 129:Source/render/selftest_layout.c **** /* ── C/D: paragraph flow + wrap ────────────────────�
 130:Source/render/selftest_layout.c **** 
 131:Source/render/selftest_layout.c **** static void case_paragraph(void) {
 132:Source/render/selftest_layout.c ****     DocDocument d;
 133:Source/render/selftest_layout.c ****     doc_init_empty(&d);
 134:Source/render/selftest_layout.c ****     DocBlock* p = doc_add(&d, DB_PARAGRAPH);
 135:Source/render/selftest_layout.c ****     blk_add_inline(p, "Hello");
 136:Source/render/selftest_layout.c **** 
 137:Source/render/selftest_layout.c ****     layout_build(&d);
 138:Source/render/selftest_layout.c ****     ck("C.para_count1", layout_item_count() == 1);
 139:Source/render/selftest_layout.c ****     const LItem* t = layout_item_at(0);
 140:Source/render/selftest_layout.c ****     ck("C.para_type_text", t && t->type == LIT_TEXT);
 141:Source/render/selftest_layout.c ****     ck("C.para_x_marginX", t && t->x == MARGIN_X);
 142:Source/render/selftest_layout.c ****     ck("C.para_y_startY",  t && t->y == START_Y);
 143:Source/render/selftest_layout.c ****     ck("C.para_h16",       t && t->h == 16);
 144:Source/render/selftest_layout.c ****     ck("C.para_href_null", t && t->href == NULL);
 145:Source/render/selftest_layout.c ****     /* endY=48 -> currentY=58 -> total=max(78,216)=216 */
 146:Source/render/selftest_layout.c ****     ck("C.para_height_floor",
 147:Source/render/selftest_layout.c ****        layout_total_height() == (double)PLUTO_CONTENT_HEIGHT);
 148:Source/render/selftest_layout.c **** 
 149:Source/render/selftest_layout.c ****     /* rebuild idempotence (frees previous items cleanly) */
 150:Source/render/selftest_layout.c ****     int before = layout_item_count();
