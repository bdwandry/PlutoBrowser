  76:Source/render/selftest_layout.c **** /* ── A: pure helpers ────────────────────────�
  77:Source/render/selftest_layout.c **** 
  78:Source/render/selftest_layout.c **** static void case_helpers(void) {
  79:Source/render/selftest_layout.c ****     char* m;
  80:Source/render/selftest_layout.c **** 
  81:Source/render/selftest_layout.c ****     m = layout_ordered_marker(2026, "i");
  82:Source/render/selftest_layout.c ****     ck("A.roman_2026", m && !strcmp(m, "mmxxvi")); free(m);
  83:Source/render/selftest_layout.c ****     m = layout_ordered_marker(9, "I");
  84:Source/render/selftest_layout.c ****     ck("A.roman_upper", m && !strcmp(m, "IX")); free(m);
  85:Source/render/selftest_layout.c ****     m = layout_ordered_marker(0, "i");
  86:Source/render/selftest_layout.c ****     ck("A.roman_zero_passthrough", m && !strcmp(m, "0")); free(m);
  87:Source/render/selftest_layout.c ****     m = layout_ordered_marker(4000, "i");
  88:Source/render/selftest_layout.c ****     ck("A.roman_4000_passthrough", m && !strcmp(m, "4000")); free(m);
  89:Source/render/selftest_layout.c **** 
  90:Source/render/selftest_layout.c ****     m = layout_ordered_marker(1, "a");
  91:Source/render/selftest_layout.c ****     ck("A.alpha_1a", m && !strcmp(m, "a")); free(m);
  92:Source/render/selftest_layout.c ****     m = layout_ordered_marker(26, "a");
  93:Source/render/selftest_layout.c ****     ck("A.alpha_26z", m && !strcmp(m, "z")); free(m);
  94:Source/render/selftest_layout.c ****     m = layout_ordered_marker(27, "a");
  95:Source/render/selftest_layout.c ****     ck("A.alpha_27aa", m && !strcmp(m, "aa")); free(m);
  96:Source/render/selftest_layout.c ****     m = layout_ordered_marker(3, "A");
  97:Source/render/selftest_layout.c ****     ck("A.alpha_upper_C", m && !strcmp(m, "C")); free(m);
  98:Source/render/selftest_layout.c **** 
  99:Source/render/selftest_layout.c ****     m = layout_ordered_marker(7, NULL);
 100:Source/render/selftest_layout.c ****     ck("A.default_numeric", m && !strcmp(m, "7")); free(m);
 101:Source/render/selftest_layout.c **** 
 102:Source/render/selftest_layout.c ****     char* e = layout_expand_tab_columns("\tX");
 103:Source/render/selftest_layout.c ****     ck("A.tab_col0", e && !strncmp(e, "        X", 9)); free(e);
 104:Source/render/selftest_layout.c ****     e = layout_expand_tab_columns("ab\tZ");
 105:Source/render/selftest_layout.c ****     ck("A.tab_col2_pad6", e && strlen(e) == 9 && e[8] == 'Z' &&
