 129:src/render/selftest_layout.c **** /* ── C/D: paragraph flow + wrap ────────────────────�
 130:src/render/selftest_layout.c **** 
 131:src/render/selftest_layout.c **** static void case_paragraph(void) {
 132:src/render/selftest_layout.c ****     DocDocument d;
 133:src/render/selftest_layout.c ****     doc_init_empty(&d);
 134:src/render/selftest_layout.c ****     DocBlock* p = doc_add(&d, DB_PARAGRAPH);
 135:src/render/selftest_layout.c ****     blk_add_inline(p, "Hello");
 136:src/render/selftest_layout.c **** 
 137:src/render/selftest_layout.c ****     layout_build(&d);
 138:src/render/selftest_layout.c ****     ck("C.para_count1", layout_item_count() == 1);
 139:src/render/selftest_layout.c ****     const LItem* t = layout_item_at(0);
 140:src/render/selftest_layout.c ****     ck("C.para_type_text", t && t->type == LIT_TEXT);
 141:src/render/selftest_layout.c ****     ck("C.para_x_marginX", t && t->x == MARGIN_X);
 142:src/render/selftest_layout.c ****     ck("C.para_y_startY",  t && t->y == START_Y);
 143:src/render/selftest_layout.c ****     ck("C.para_h16",       t && t->h == 16);
 144:src/render/selftest_layout.c ****     ck("C.para_href_null", t && t->href == NULL);
 145:src/render/selftest_layout.c ****     /* endY=48 -> currentY=58 -> total=max(78,216)=216 */
 146:src/render/selftest_layout.c ****     ck("C.para_height_floor",
 147:src/render/selftest_layout.c ****        layout_total_height() == (double)PLUTO_CONTENT_HEIGHT);
 148:src/render/selftest_layout.c **** 
 149:src/render/selftest_layout.c ****     /* rebuild idempotence (frees previous items cleanly) */
