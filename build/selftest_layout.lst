   1:Source/render/selftest_layout.c **** // selftest_layout.c — [P26B] selftests for the Layout port.
   2:Source/render/selftest_layout.c **** //
   3:Source/render/selftest_layout.c **** // Geometry expectations are derived from the REAL Source/render/layout.lua
   4:Source/render/selftest_layout.c **** // arithmetic (start y = CONTENT_Y+8, marginX = CONTENT_MARGIN+2, maxWidth =
   5:Source/render/selftest_layout.c **** // CONTENT_TEXT_WIDTH-4, per-block advances) and from the pure helpers
   6:Source/render/selftest_layout.c **** // (roman/alpha/tab expansion), mirroring the oracle style of earlier
   7:Source/render/selftest_layout.c **** // phases. Font-independent invariants are asserted so results hold on any
   8:Source/render/selftest_layout.c **** // font set; wrapping behavior is exercised via the mono/body fallbacks.
   9:Source/render/selftest_layout.c **** // Results land in pluto.log.
