 165:src/render/selftest_layout.c ****     layout_build(&w);
 166:src/render/selftest_layout.c ****     int n = layout_item_count();
 167:src/render/selftest_layout.c ****     ck("D.wrap_multiple_lines", n >= 3);
 168:src/render/selftest_layout.c ****     /* items are per-word: group into rows by y, verify each row starts at
 169:src/render/selftest_layout.c ****      * marginX and rows step down by lineH (16) */
 170:src/render/selftest_layout.c ****     int rows = 0, prevY = -1000, okRows = 1, okStep = 1;
 171:src/render/selftest_layout.c ****     for (int i = 0; i < n; i++) {
 172:src/render/selftest_layout.c ****         const LItem* it = layout_item_at(i);
 173:src/render/selftest_layout.c ****         if (!it || it->type != LIT_TEXT) continue;
 174:src/render/selftest_layout.c ****         if (it->y != prevY) {
 175:src/render/selftest_layout.c ****             if (rows > 0 && it->y - prevY != 16) okStep = 0;
 176:src/render/selftest_layout.c ****             prevY = it->y;
 177:src/render/selftest_layout.c ****             rows++;
 178:src/render/selftest_layout.c ****             if (it->x != MARGIN_X) okRows = 0;   /* first word on a row */
 179:src/render/selftest_layout.c ****         }
 180:src/render/selftest_layout.c ****     }
 181:src/render/selftest_layout.c ****     ck("D.rows_ge3", rows >= 3);
 182:src/render/selftest_layout.c ****     ck("D.wrap_same_x", okRows);
 183:src/render/selftest_layout.c ****     ck("D.wrap_line_step16", okStep);
 184:src/render/selftest_layout.c ****     doc_free_local(&w);
