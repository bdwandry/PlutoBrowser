 123:Source/render/selftest_layout.c ****     ck("B.null_doc_safe",
 124:Source/render/selftest_layout.c ****        layout_total_height() == (double)PLUTO_CONTENT_HEIGHT &&
 125:Source/render/selftest_layout.c ****        layout_item_count() == 0);
 126:Source/render/selftest_layout.c ****     doc_free_local(&d);
 127:Source/render/selftest_layout.c **** }
