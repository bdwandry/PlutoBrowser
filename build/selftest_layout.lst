  34:src/render/selftest_layout.c **** static DocBlock* doc_add(DocDocument* d, int type) {
  35:src/render/selftest_layout.c ****     if (d->nBlocks == d->capBlocks) {
  36:src/render/selftest_layout.c ****         d->capBlocks = d->capBlocks ? d->capBlocks * 2 : 8;
  37:src/render/selftest_layout.c ****         d->blocks = (DocBlock*)realloc(d->blocks,
  38:src/render/selftest_layout.c ****                                        sizeof(DocBlock) * d->capBlocks);
  39:src/render/selftest_layout.c ****     }
  40:src/render/selftest_layout.c ****     DocBlock* b = &d->blocks[d->nBlocks++];
  41:src/render/selftest_layout.c ****     memset(b, 0, sizeof(*b));
  42:src/render/selftest_layout.c ****     b->type       = type;
  43:src/render/selftest_layout.c ****     b->maxlength  = -1;
  44:src/render/selftest_layout.c ****     b->fieldWidth = -1;
  45:src/render/selftest_layout.c ****     b->fieldRows  = -1;
  46:src/render/selftest_layout.c ****     return b;
  47:src/render/selftest_layout.c **** }
  48:src/render/selftest_layout.c **** 
