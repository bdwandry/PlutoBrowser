  50:src/render/selftest_layout.c ****     if (b->nInlines == b->capInlines) {
  51:src/render/selftest_layout.c ****         b->capInlines = b->capInlines ? b->capInlines * 2 : 4;
  52:src/render/selftest_layout.c ****         b->inlines = (DocInline*)realloc(b->inlines,
  53:src/render/selftest_layout.c ****                                      sizeof(DocInline) * b->capInlines);
  54:src/render/selftest_layout.c ****     }
  55:src/render/selftest_layout.c ****     DocInline* in = &b->inlines[b->nInlines++];
  56:src/render/selftest_layout.c ****     memset(in, 0, sizeof(*in));
  57:src/render/selftest_layout.c ****     in->type        = DIT_TEXT;
