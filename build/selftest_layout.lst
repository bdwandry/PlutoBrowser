  92:src/render/selftest_layout.c ****     m = layout_ordered_marker(26, "a");
  93:src/render/selftest_layout.c ****     ck("A.alpha_26z", m && !strcmp(m, "z")); free(m);
  94:src/render/selftest_layout.c ****     m = layout_ordered_marker(27, "a");
  95:src/render/selftest_layout.c ****     ck("A.alpha_27aa", m && !strcmp(m, "aa")); free(m);
  96:src/render/selftest_layout.c ****     m = layout_ordered_marker(3, "A");
  97:src/render/selftest_layout.c ****     ck("A.alpha_upper_C", m && !strcmp(m, "C")); free(m);
