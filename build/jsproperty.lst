  60:Source/js/jsproperty.c **** static js_Property *skew(js_Property *node)
  61:Source/js/jsproperty.c **** {
  62:Source/js/jsproperty.c **** 	if (node->left->level == node->level) {
  63:Source/js/jsproperty.c **** 		js_Property *temp = node;
  64:Source/js/jsproperty.c **** 		node = node->left;
  65:Source/js/jsproperty.c **** 		temp->left = node->right;
  66:Source/js/jsproperty.c **** 		node->right = temp;
  67:Source/js/jsproperty.c **** 	}
  68:Source/js/jsproperty.c **** 	return node;
  69:Source/js/jsproperty.c **** }
  70:Source/js/jsproperty.c **** 
  71:Source/js/jsproperty.c **** static js_Property *split(js_Property *node)
  72:Source/js/jsproperty.c **** {
  73:Source/js/jsproperty.c **** 	if (node->right->right->level == node->level) {
  74:Source/js/jsproperty.c **** 		js_Property *temp = node;
  75:Source/js/jsproperty.c **** 		node = node->right;
  76:Source/js/jsproperty.c **** 		temp->right = node->left;
  77:Source/js/jsproperty.c **** 		node->left = temp;
  78:Source/js/jsproperty.c **** 		++node->level;
  79:Source/js/jsproperty.c **** 	}
  80:Source/js/jsproperty.c **** 	return node;
  81:Source/js/jsproperty.c **** }
