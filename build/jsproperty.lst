 221:Source/js/jsproperty.c **** js_Property *jsV_setproperty(js_State *J, js_Object *obj, const char *name)
 222:Source/js/jsproperty.c **** {
 223:Source/js/jsproperty.c **** 	js_Property *result;
 224:Source/js/jsproperty.c **** 
 225:Source/js/jsproperty.c **** 	if (!obj->extensible) {
 226:Source/js/jsproperty.c **** 		result = lookup(obj->properties, name);
 227:Source/js/jsproperty.c **** 		if (J->strict && !result)
