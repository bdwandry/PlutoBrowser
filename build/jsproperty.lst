 210:Source/js/jsproperty.c **** static js_Property *jsV_getenumproperty(js_State *J, js_Object *obj, const char *name)
 211:Source/js/jsproperty.c **** {
 212:Source/js/jsproperty.c **** 	do {
 213:Source/js/jsproperty.c **** 		js_Property *ref = lookup(obj->properties, name);
 214:Source/js/jsproperty.c **** 		if (ref && !(ref->atts & JS_DONTENUM))
 215:Source/js/jsproperty.c **** 			return ref;
 216:Source/js/jsproperty.c **** 		obj = obj->prototype;
 217:Source/js/jsproperty.c **** 	} while (obj);
 218:Source/js/jsproperty.c **** 	return NULL;
 219:Source/js/jsproperty.c **** }
