 228:Source/js/jsproperty.c **** 			js_typeerror(J, "object is non-extensible");
 229:Source/js/jsproperty.c **** 		return result;
 230:Source/js/jsproperty.c **** 	}
 231:Source/js/jsproperty.c **** 
 232:Source/js/jsproperty.c **** 	obj->properties = insert(J, obj, obj->properties, name, &result);
 233:Source/js/jsproperty.c **** 
 234:Source/js/jsproperty.c **** 	return result;
 235:Source/js/jsproperty.c **** }
