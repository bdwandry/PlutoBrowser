  29:Source/js/jsproperty.c **** static js_Property *newproperty(js_State *J, js_Object *obj, const char *name)
  30:Source/js/jsproperty.c **** {
  31:Source/js/jsproperty.c **** 	int n = strlen(name) + 1;
  32:Source/js/jsproperty.c **** 	js_Property *node = js_malloc(J, offsetof(js_Property, name) + n);
  33:Source/js/jsproperty.c **** 	node->left = node->right = &sentinel;
  34:Source/js/jsproperty.c **** 	node->level = 1;
  35:Source/js/jsproperty.c **** 	node->atts = 0;
  36:Source/js/jsproperty.c **** 	node->value.t.type = JS_TUNDEFINED;
  37:Source/js/jsproperty.c **** 	node->value.u.number = 0;
  38:Source/js/jsproperty.c **** 	node->getter = NULL;
  39:Source/js/jsproperty.c **** 	node->setter = NULL;
  40:Source/js/jsproperty.c **** 	memcpy(node->name, name, n);
  41:Source/js/jsproperty.c **** 	++obj->count;
  42:Source/js/jsproperty.c **** 	++J->gccounter;
  43:Source/js/jsproperty.c **** 	return node;
  44:Source/js/jsproperty.c **** }
