 242:Source/js/jsproperty.c **** /* Flatten hierarchy of enumerable properties into an iterator object */
 243:Source/js/jsproperty.c **** 
 244:Source/js/jsproperty.c **** static js_Iterator *itnewnode(js_State *J, const char *name, js_Iterator *next) {
 245:Source/js/jsproperty.c **** 	int n = strlen(name) + 1;
 246:Source/js/jsproperty.c **** 	js_Iterator *node = js_malloc(J, offsetof(js_Iterator, name) + n);
 247:Source/js/jsproperty.c **** 	node->next = next;
 248:Source/js/jsproperty.c **** 	memcpy(node->name, name, n);
 249:Source/js/jsproperty.c **** 	return node;
 250:Source/js/jsproperty.c **** }
