 186:Source/js/jsproperty.c **** js_Property *jsV_getpropertyx(js_State *J, js_Object *obj, const char *name, int *own)
 187:Source/js/jsproperty.c **** {
 188:Source/js/jsproperty.c **** 	*own = 1;
 189:Source/js/jsproperty.c **** 	do {
 190:Source/js/jsproperty.c **** 		js_Property *ref = lookup(obj->properties, name);
