 392:Source/js/regexp.c **** static int lex(struct cstate *g)
 393:Source/js/regexp.c **** {
 394:Source/js/regexp.c **** 	int quoted = nextrune(g);
 395:Source/js/regexp.c **** 	if (quoted) {
 396:Source/js/regexp.c **** 		switch (g->yychar) {
 397:Source/js/regexp.c **** 		case 'b': return L_WORD;
 398:Source/js/regexp.c **** 		case 'B': return L_NWORD;
 399:Source/js/regexp.c **** 		case 'd': newcclass(g); addranges_d(g); return L_CCLASS;
 400:Source/js/regexp.c **** 		case 's': newcclass(g); addranges_s(g); return L_CCLASS;
 401:Source/js/regexp.c **** 		case 'w': newcclass(g); addranges_w(g); return L_CCLASS;
 402:Source/js/regexp.c **** 		case 'D': newcclass(g); addranges_d(g); return L_NCCLASS;
 403:Source/js/regexp.c **** 		case 'S': newcclass(g); addranges_s(g); return L_NCCLASS;
 404:Source/js/regexp.c **** 		case 'W': newcclass(g); addranges_w(g); return L_NCCLASS;
 405:Source/js/regexp.c **** 		case '0': g->yychar = 0; return L_CHAR;
 406:Source/js/regexp.c **** 		}
 407:Source/js/regexp.c **** 		if (g->yychar >= '0' && g->yychar <= '9') {
 408:Source/js/regexp.c **** 			g->yychar -= '0';
 409:Source/js/regexp.c **** 			if (*g->source >= '0' && *g->source <= '9')
 410:Source/js/regexp.c **** 				g->yychar = g->yychar * 10 + *g->source++ - '0';
