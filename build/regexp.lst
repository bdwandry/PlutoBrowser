 612:Source/js/regexp.c **** static Renode *parsecat(struct cstate *g)
 613:Source/js/regexp.c **** {
 614:Source/js/regexp.c **** 	Renode *cat, *head, **tail;
 615:Source/js/regexp.c **** 	if (g->lookahead != EOF && g->lookahead != '|' && g->lookahead != ')') {
 616:Source/js/regexp.c **** 		/* Build a right-leaning tree by splicing in new 'cat' at the tail. */
 617:Source/js/regexp.c **** 		head = parserep(g);
 618:Source/js/regexp.c **** 		tail = &head;
 619:Source/js/regexp.c **** 		while (g->lookahead != EOF && g->lookahead != '|' && g->lookahead != ')') {
 620:Source/js/regexp.c **** 			cat = newnode(g, P_CAT);
 621:Source/js/regexp.c **** 			cat->x = *tail;
 622:Source/js/regexp.c **** 			cat->y = parserep(g);
 623:Source/js/regexp.c **** 			*tail = cat;
 624:Source/js/regexp.c **** 			tail = &cat->y;
 625:Source/js/regexp.c **** 		}
 626:Source/js/regexp.c **** 		return head;
 627:Source/js/regexp.c **** 	}
 628:Source/js/regexp.c **** 	return NULL;
 629:Source/js/regexp.c **** }
