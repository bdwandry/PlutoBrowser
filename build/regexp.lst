 853:Source/js/regexp.c **** static void dumpcclass(Reclass *cc) {
 854:Source/js/regexp.c **** 	Rune *p;
 855:Source/js/regexp.c **** 	for (p = cc->spans; p < cc->end; p += 2) {
 856:Source/js/regexp.c **** 		if (p[0] > 32 && p[0] < 127)
 857:Source/js/regexp.c **** 			printf(" %c", p[0]);
 858:Source/js/regexp.c **** 		else
 859:Source/js/regexp.c **** 			printf(" \\x%02x", p[0]);
 860:Source/js/regexp.c **** 		if (p[1] > 32 && p[1] < 127)
 861:Source/js/regexp.c **** 			printf("-%c", p[1]);
 862:Source/js/regexp.c **** 		else
 863:Source/js/regexp.c **** 			printf("-\\x%02x", p[1]);
 864:Source/js/regexp.c **** 	}
 865:Source/js/regexp.c **** 	putchar('\n');
 866:Source/js/regexp.c **** }
