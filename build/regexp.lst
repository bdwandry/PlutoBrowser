 636:Source/js/regexp.c **** 		x = alt;
 637:Source/js/regexp.c **** 		alt = newnode(g, P_ALT);
 638:Source/js/regexp.c **** 		alt->x = x;
 639:Source/js/regexp.c **** 		alt->y = parsecat(g);
 640:Source/js/regexp.c **** 	}
 641:Source/js/regexp.c **** 	return alt;
 642:Source/js/regexp.c **** }
