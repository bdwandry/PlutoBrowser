 412:Source/js/regexp.c **** 		}
 413:Source/js/regexp.c **** 		return L_CHAR;
 414:Source/js/regexp.c **** 	}
 415:Source/js/regexp.c **** 
 416:Source/js/regexp.c **** 	switch (g->yychar) {
 417:Source/js/regexp.c **** 	case EOF:
 418:Source/js/regexp.c **** 	case '$': case ')': case '*': case '+':
 419:Source/js/regexp.c **** 	case '.': case '?': case '^': case '|':
 420:Source/js/regexp.c **** 		return g->yychar;
 421:Source/js/regexp.c **** 	}
