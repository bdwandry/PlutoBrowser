  23:src/render/decoders/png.c **** static uint32_t read_u32be(const uint8_t* s) {
  24:src/render/decoders/png.c ****     return ((uint32_t)s[0] << 24) | ((uint32_t)s[1] << 16) |
  25:src/render/decoders/png.c ****            ((uint32_t)s[2] << 8) | (uint32_t)s[3];
  26:src/render/decoders/png.c **** }
