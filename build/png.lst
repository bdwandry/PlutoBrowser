  28:src/render/decoders/png.c **** static int paeth_predictor(int a, int b, int c) {
  29:src/render/decoders/png.c ****     int p = a + b - c;
  30:src/render/decoders/png.c ****     int pa = p > a ? p - a : a - p;
  31:src/render/decoders/png.c ****     int pb = p > b ? p - b : b - p;
  32:src/render/decoders/png.c ****     int pc = p > c ? p - c : c - p;
  33:src/render/decoders/png.c ****     if (pa <= pb && pa <= pc) return a;
  34:src/render/decoders/png.c ****     if (pb <= pc) return b;
  35:src/render/decoders/png.c ****     return c;
  36:src/render/decoders/png.c **** }
  37:src/render/decoders/png.c **** 
  38:src/render/decoders/png.c **** /* Composite an 8-bit gray value over white given alpha 0..255 */
  39:src/render/decoders/png.c **** static int composite(int gray, int a) {
  40:src/render/decoders/png.c ****     if (a >= 255) return gray;
  41:src/render/decoders/png.c ****     if (a <= 0) return 255;
  42:src/render/decoders/png.c ****     return (int)floor((double)(gray * a + 255 * (255 - a)) / 255.0 + 0.5);
  43:src/render/decoders/png.c **** }
