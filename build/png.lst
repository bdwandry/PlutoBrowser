  28:Source/render/decoders/png.c **** /* Lua paethPredictor (verbatim tie-break order). */
  29:Source/render/decoders/png.c **** static int paeth_predictor(int a, int b, int c)
  30:Source/render/decoders/png.c **** {
  31:Source/render/decoders/png.c ****     int p = a + b - c;
  32:Source/render/decoders/png.c ****     int pa = p - a;
  33:Source/render/decoders/png.c ****     if (pa < 0) pa = -pa;
  34:Source/render/decoders/png.c ****     int pb = p - b;
  35:Source/render/decoders/png.c ****     if (pb < 0) pb = -pb;
  36:Source/render/decoders/png.c ****     int pc = p - c;
  37:Source/render/decoders/png.c ****     if (pc < 0) pc = -pc;
  38:Source/render/decoders/png.c ****     if (pa <= pb && pa <= pc) return a;
  39:Source/render/decoders/png.c ****     if (pb <= pc) return b;
  40:Source/render/decoders/png.c ****     return c;
  41:Source/render/decoders/png.c **** }
  42:Source/render/decoders/png.c **** 
  43:Source/render/decoders/png.c **** /* Lua composite: exact floor((gray*a + 255*(255-a))/255 + 0.5). */
  44:Source/render/decoders/png.c **** static uint8_t png_composite(int gray, int a)
  45:Source/render/decoders/png.c **** {
  46:Source/render/decoders/png.c ****     if (a >= 255) return (uint8_t)gray;
  47:Source/render/decoders/png.c ****     if (a <= 0) return 255;
  48:Source/render/decoders/png.c ****     return (uint8_t)((gray * a + 255 * (255 - a)) / 255);
  49:Source/render/decoders/png.c **** }
