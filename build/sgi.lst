  32:Source/render/decoders/sgi.c **** 
  33:Source/render/decoders/sgi.c **** static LCDBitmap *sgi_finish(uint8_t *rows, int w, int h);
  34:Source/render/decoders/sgi.c **** 
  35:Source/render/decoders/sgi.c **** static size_t sgi_expand_row(const uint8_t *src, size_t srcLen, uint8_t *out,
  36:Source/render/decoders/sgi.c ****                              int w)
  37:Source/render/decoders/sgi.c **** {
  38:Source/render/decoders/sgi.c ****     /* SGI RLE (per ffmpeg's sgidec.c / the IRIX spec): BYTE-oriented.
  39:Source/render/decoders/sgi.c ****      * Read a byte; count = byte & 0x7f. count == 0 ends the row.
  40:Source/render/decoders/sgi.c ****      * byte & 0x80 set: `count` literal bytes follow. Clear: the next byte
  41:Source/render/decoders/sgi.c ****      * is repeated `count` times. */
  42:Source/render/decoders/sgi.c ****     size_t ip = 0, op = 0;
  43:Source/render/decoders/sgi.c ****     while (ip < srcLen && op < (size_t)w)
  44:Source/render/decoders/sgi.c ****     {
  45:Source/render/decoders/sgi.c ****         uint8_t b = src[ip++];
  46:Source/render/decoders/sgi.c ****         int count = b & 0x7f;
  47:Source/render/decoders/sgi.c ****         if (count == 0) break; /* end of row */
  48:Source/render/decoders/sgi.c ****         if (b & 0x80)
  49:Source/render/decoders/sgi.c ****         {
  50:Source/render/decoders/sgi.c ****             size_t n = (size_t)count;
  51:Source/render/decoders/sgi.c ****             if (ip + n > srcLen) n = srcLen - ip;
  52:Source/render/decoders/sgi.c ****             if (op + n > (size_t)w) n = (size_t)w - op;
  53:Source/render/decoders/sgi.c ****             memcpy(out + op, src + ip, n);
  54:Source/render/decoders/sgi.c ****             ip += n;
  55:Source/render/decoders/sgi.c ****             op += n;
  56:Source/render/decoders/sgi.c ****         }
  57:Source/render/decoders/sgi.c ****         else
  58:Source/render/decoders/sgi.c ****         {
  59:Source/render/decoders/sgi.c ****             if (ip >= srcLen) break;
  60:Source/render/decoders/sgi.c ****             uint8_t v = src[ip++];
  61:Source/render/decoders/sgi.c ****             size_t n = (size_t)count;
  62:Source/render/decoders/sgi.c ****             if (op + n > (size_t)w) n = (size_t)w - op;
  63:Source/render/decoders/sgi.c ****             memset(out + op, v, n);
  64:Source/render/decoders/sgi.c ****             op += n;
  65:Source/render/decoders/sgi.c ****         }
  66:Source/render/decoders/sgi.c ****     }
  67:Source/render/decoders/sgi.c ****     return op;
  68:Source/render/decoders/sgi.c **** }
  69:Source/render/decoders/sgi.c **** 
  70:Source/render/decoders/sgi.c **** LCDBitmap *sgi_decode(const uint8_t *data, size_t len)
  71:Source/render/decoders/sgi.c **** {
  72:Source/render/decoders/sgi.c ****     if (!data || len < 512) return NULL;
  73:Source/render/decoders/sgi.c ****     uint32_t magic = ((uint32_t)data[0] << 8) | data[1];
  74:Source/render/decoders/sgi.c ****     if (magic != 0x01DA) return NULL;
  75:Source/render/decoders/sgi.c ****     int storage = data[2]; /* 0 verbatim, 1 RLE */
  76:Source/render/decoders/sgi.c ****     int bpc = data[3];     /* bytes per channel-pixel: 1 (or 2 unsupported) */
  77:Source/render/decoders/sgi.c ****     if (bpc != 1) return NULL;
  78:Source/render/decoders/sgi.c ****     /* SGI header: magic(0-2) storage(2) bpc(3) dims(4-6) x(6-8) y(8-10) z(10-12) */
  79:Source/render/decoders/sgi.c ****     int dim = ((int)data[4] << 8) | data[5];
  80:Source/render/decoders/sgi.c ****     int w = ((int)data[6] << 8) | data[7];
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccdqHpdr.s 			page 6


  81:Source/render/decoders/sgi.c ****     int h = ((int)data[8] << 8) | data[9];
  82:Source/render/decoders/sgi.c ****     int z = ((int)data[10] << 8) | data[11];
  83:Source/render/decoders/sgi.c ****     if (w <= 0 || h <= 0 || w > 4096 || h > 4096) return NULL;
  84:Source/render/decoders/sgi.c ****     int channels = dim == 1 ? 1 : (dim == 2 ? z : z);
  85:Source/render/decoders/sgi.c ****     if (channels < 1 || channels > 4) return NULL;
  86:Source/render/decoders/sgi.c **** 
