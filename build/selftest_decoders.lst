  57:src/render/decoders/selftest_decoders.c ****                 dither_is_black(b, x, y)) { ok = 0; break; }
  58:src/render/decoders/selftest_decoders.c ****         }
  59:src/render/decoders/selftest_decoders.c ****     ck("B.threshold_boundary_strict", ok);  /* gray==t -> white */
