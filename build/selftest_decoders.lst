  69:src/render/decoders/selftest_decoders.c ****         for (int x = 0; x < 4; x++)
  70:src/render/decoders/selftest_decoders.c ****             if (dither_is_black(255, x, y)) allWhite = 0;
  71:src/render/decoders/selftest_decoders.c ****     ck("B.white_all_white", allWhite);
  72:src/render/decoders/selftest_decoders.c **** }
