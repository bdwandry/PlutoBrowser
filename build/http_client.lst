 254:Source/core/http_client.c **** /* Build a minimal HTTP/1.1 GET request (reference buildRequest). */
 255:Source/core/http_client.c **** static void build_request(StrBuf *out)
 256:Source/core/http_client.c **** {
 257:Source/core/http_client.c ****     strbuf_reset(out);
 258:Source/core/http_client.c ****     strbuf_appendf(out, "GET %s HTTP/1.1\r\n", g_parsed->fullPath);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccfsx8xP.s 			page 14


 259:Source/core/http_client.c ****     if (g_parsed->port != 80 && g_parsed->port != 443)
 260:Source/core/http_client.c ****     {
 261:Source/core/http_client.c ****         strbuf_appendf(out, "Host: %s:%d\r\n", g_parsed->host, g_parsed->port);
 262:Source/core/http_client.c ****     }
 263:Source/core/http_client.c ****     else
 264:Source/core/http_client.c ****     {
 265:Source/core/http_client.c ****         strbuf_appendf(out, "Host: %s\r\n", g_parsed->host);
 266:Source/core/http_client.c ****     }
 267:Source/core/http_client.c ****     strbuf_appendf(out, "User-Agent: CometBrowser/1.0 (Playdate)\r\n");
 268:Source/core/http_client.c ****     strbuf_appendf(out, "Accept: text/html,text/plain;q=0.8\r\n");
 269:Source/core/http_client.c ****     strbuf_appendf(out, "Accept-Language: en-US,en;q=0.9\r\n");
 270:Source/core/http_client.c ****     char cookie[768];
 271:Source/core/http_client.c ****     cookie_jar_get_header(g_parsed->host, g_parsed->path, g_parsed->isSsl,
 272:Source/core/http_client.c ****                           cookie, sizeof(cookie));
 273:Source/core/http_client.c ****     if (cookie[0] != '\0')
 274:Source/core/http_client.c ****     {
 275:Source/core/http_client.c ****         strbuf_appendf(out, "Cookie: %s\r\n", cookie);
 276:Source/core/http_client.c ****     }
 277:Source/core/http_client.c ****     strbuf_appendf(out, "Connection: close\r\n\r\n");
 278:Source/core/http_client.c **** }
