 963:Source/core/http_client.c **** static int http_connect_now(void)
 964:Source/core/http_client.c **** {
 965:Source/core/http_client.c ****     PLUTO_LOG("[HC] HTTP API: connecting to %s:%d ssl=%d",
 966:Source/core/http_client.c ****               s_parsed.host, s_parsed.port, s_parsed.isSsl);
 967:Source/core/http_client.c ****     // Allocate s_headers so store_header() can populate it during callbacks.
 968:Source/core/http_client.c ****     if (!s_headers) s_headers = sm_create(16);
 969:Source/core/http_client.c ****     HTTPConnection* conn = s_http->newConnection(s_parsed.host, s_parsed.port,
 970:Source/core/http_client.c ****                                                  s_parsed.isSsl != 0);
 971:Source/core/http_client.c ****     if (!conn) {
 972:Source/core/http_client.c ****         PLUTO_LOG("[HC] HTTP API: newConnection failed");
 973:Source/core/http_client.c ****         return 0;
 974:Source/core/http_client.c ****     }
 975:Source/core/http_client.c ****     s_http_conn = conn;
 976:Source/core/http_client.c ****     s_http->setConnectTimeout(conn, HC_CONNECT_TIMEOUT_MS);
 977:Source/core/http_client.c ****     s_http->setReadTimeout(conn, HC_READ_TIMEOUT_MS);
 978:Source/core/http_client.c ****     s_http->setReadBufferSize(conn, HC_SOCKET_BUFFER_BYTES);
 979:Source/core/http_client.c ****     s_http->setHeaderReceivedCallback(conn, http_header_received_cb);
 980:Source/core/http_client.c ****     s_http->setHeadersReadCallback(conn, http_headers_read_cb);
 981:Source/core/http_client.c ****     s_http->setRequestCompleteCallback(conn, http_request_complete_cb);
 982:Source/core/http_client.c ****     s_http->setConnectionClosedCallback(conn, http_connection_closed_cb);
 983:Source/core/http_client.c ****     // Build the headers string for the HTTP API.
 984:Source/core/http_client.c ****     // Note: http->get() adds Host automatically from the connection's server/port.
 985:Source/core/http_client.c ****     StrBuf headers;
 986:Source/core/http_client.c ****     sb_init(&headers);
 987:Source/core/http_client.c ****     sb_append_str(&headers, "User-Agent: CometBrowser/1.0 (Playdate)\r\n");
