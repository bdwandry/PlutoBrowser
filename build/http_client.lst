 219:Source/core/http_client.c **** static void store_header(const char* key, size_t keyLen, const char* val,
 220:Source/core/http_client.c ****                          size_t valLen)
 221:Source/core/http_client.c **** {
 222:Source/core/http_client.c ****     char lower[128];
 223:Source/core/http_client.c ****     if (keyLen >= sizeof(lower)) keyLen = sizeof(lower) - 1;
 224:Source/core/http_client.c ****     for (size_t i = 0; i < keyLen; i++)
 225:Source/core/http_client.c ****         lower[i] = (char)tolower((unsigned char)key[i]);
 226:Source/core/http_client.c ****     lower[keyLen] = '\0';
 227:Source/core/http_client.c **** 
 228:Source/core/http_client.c ****     char* v = (char*)pluto_malloc(valLen + 1);
 229:Source/core/http_client.c ****     if (!v) return;
 230:Source/core/http_client.c ****     memcpy(v, val, valLen);
 231:Source/core/http_client.c ****     v[valLen] = '\0';
 232:Source/core/http_client.c **** 
 233:Source/core/http_client.c ****     if (strcmp(lower, "set-cookie") == 0) {
 234:Source/core/http_client.c ****         if (s_nSetCookies < HC_MAX_SET_COOKIES) {
 235:Source/core/http_client.c ****             s_setCookies[s_nSetCookies++] = v;
 236:Source/core/http_client.c ****             return;
 237:Source/core/http_client.c ****         }
 238:Source/core/http_client.c ****     } else if (s_nHdrVals < HC_MAX_HDRS && s_headers) {
 239:Source/core/http_client.c ****         sm_put(s_headers, lower, v); // map keeps latest value per key
 240:Source/core/http_client.c ****         s_hdrVals[s_nHdrVals++] = v; // we free every stored value ourselves
 241:Source/core/http_client.c ****         return;
 242:Source/core/http_client.c ****     }
 243:Source/core/http_client.c ****     pluto_free(v);
 244:Source/core/http_client.c **** }
