 808:Source/core/http_client.c ****     }
 809:Source/core/http_client.c **** 
 810:Source/core/http_client.c ****     // Detect a complete body (TCP backend only — HTTP API uses request_complete_cb)
 811:Source/core/http_client.c ****     if (s_state == HC_READING && s_hasBodyStart &&
 812:Source/core/http_client.c ****         s_backend == HC_BACKEND_TCP) {
 813:Source/core/http_client.c ****         long bodyBytes = (long)s_buf.len - (long)s_bodyStart;
 814:Source/core/http_client.c ****         if (s_chunked) {
 815:Source/core/http_client.c ****             StrBuf* dec =
 816:Source/core/http_client.c ****                 decode_chunked(s_buf.data + s_bodyStart,
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccqN2dXL.s 			page 30


 817:Source/core/http_client.c ****                                s_buf.len - s_bodyStart);
 818:Source/core/http_client.c ****             if (dec) {
 819:Source/core/http_client.c ****                 sb_free(dec);
 820:Source/core/http_client.c ****                 pluto_free(dec);
 821:Source/core/http_client.c ****                 s_state = HC_DONE;
 822:Source/core/http_client.c ****             }
 823:Source/core/http_client.c ****         } else if (s_contentLength >= 0 && bodyBytes >= s_contentLength) {
 824:Source/core/http_client.c ****             s_state = HC_DONE;
 825:Source/core/http_client.c ****         }
 826:Source/core/http_client.c ****         if (s_buf.len >= HC_MAX_RESPONSE_SIZE) s_state = HC_DONE;
 827:Source/core/http_client.c ****     }
 828:Source/core/http_client.c **** 
 829:Source/core/http_client.c ****     // Server closed the connection
 830:Source/core/http_client.c ****     if (s_state == HC_READING && s_connClosed) {
 831:Source/core/http_client.c ****         // Drain any remaining data from the HTTP API before declaring done.
 832:Source/core/http_client.c ****         // The SDK may fire request_complete/connection_closed before our pump
 833:Source/core/http_client.c ****         // has read everything.
 834:Source/core/http_client.c ****         if (s_backend == HC_BACKEND_HTTP && s_http_conn) {
 835:Source/core/http_client.c ****             static char drainTmp[HC_READ_CHUNK];
 836:Source/core/http_client.c ****             size_t avail;
 837:Source/core/http_client.c ****             while ((avail = s_http->getBytesAvailable(s_http_conn)) > 0) {
 838:Source/core/http_client.c ****                 size_t want = avail < HC_READ_CHUNK ? avail : HC_READ_CHUNK;
 839:Source/core/http_client.c ****                 int n = s_http->read(s_http_conn, drainTmp, (int)want);
 840:Source/core/http_client.c ****                 if (n > 0) {
 841:Source/core/http_client.c ****                     if (s_buf.len < HC_MAX_RESPONSE_SIZE)
 842:Source/core/http_client.c ****                         sb_append(&s_buf, drainTmp, (size_t)n);
 843:Source/core/http_client.c ****                 } else {
 844:Source/core/http_client.c ****                     break;
 845:Source/core/http_client.c ****                 }
 846:Source/core/http_client.c ****             }
 847:Source/core/http_client.c ****         }
 848:Source/core/http_client.c ****         PLUTO_LOG("[HC] connClosed: bufLen=%zu state=%d backend=%d",
 849:Source/core/http_client.c ****                   s_buf.len, s_state, s_backend);
 850:Source/core/http_client.c ****         if (s_buf.len == 0) {
 851:Source/core/http_client.c ****             set_error("Connection closed before any data was received.");
 852:Source/core/http_client.c ****             s_state = HC_ERROR;
 853:Source/core/http_client.c ****         } else {
 854:Source/core/http_client.c ****             s_state = HC_DONE;
 855:Source/core/http_client.c ****         }
 856:Source/core/http_client.c ****     }
 857:Source/core/http_client.c **** 
 858:Source/core/http_client.c ****     // Handle completed request
 859:Source/core/http_client.c ****     if (s_state == HC_DONE) {
 860:Source/core/http_client.c ****         deliver_done();
 861:Source/core/http_client.c ****         return;
 862:Source/core/http_client.c ****     }
 863:Source/core/http_client.c ****     if (s_state == HC_ERROR) {
 864:Source/core/http_client.c ****         PlutoHttpCallbacks cb = s_cbs;
 865:Source/core/http_client.c ****         char msg[HC_ERR_MAX];
 866:Source/core/http_client.c ****         snprintf(msg, sizeof(msg), "%s",
 867:Source/core/http_client.c ****                  s_error[0] ? s_error : "Connection failed.");
 868:Source/core/http_client.c ****         reset();
 869:Source/core/http_client.c ****         if (cb.onError) cb.onError(cb.ud, msg);
 870:Source/core/http_client.c ****         return;
 871:Source/core/http_client.c ****     }
 872:Source/core/http_client.c **** }
