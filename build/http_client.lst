 294:Source/core/http_client.c **** 
 295:Source/core/http_client.c **** static void parse_headers(size_t hEnd)
 296:Source/core/http_client.c **** {
 297:Source/core/http_client.c ****     size_t headLen = hEnd; // bytes up to (not including) the first \r
 298:Source/core/http_client.c ****     s_bodyStart = hEnd + 4;
 299:Source/core/http_client.c ****     s_hasBodyStart = 1;
 300:Source/core/http_client.c **** 
 301:Source/core/http_client.c ****     clear_headers();
 302:Source/core/http_client.c ****     s_headers = sm_create(16);
 303:Source/core/http_client.c **** 
 304:Source/core/http_client.c ****     // Status line: first [^\r\n] run, pattern "HTTP/%d+.%d+ (%d+)".
 305:Source/core/http_client.c ****     size_t slEnd = headLen;
 306:Source/core/http_client.c ****     for (size_t i = 0; i < headLen; i++)
 307:Source/core/http_client.c ****         if (s_buf.data[i] == '\r' || s_buf.data[i] == '\n') { slEnd = i; break; }
 308:Source/core/http_client.c ****     if (slEnd > 5 && strncmp(s_buf.data, "HTTP/", 5) == 0) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccKeS4lK.s 			page 8


 309:Source/core/http_client.c ****         size_t i = 5;
 310:Source/core/http_client.c ****         while (i < slEnd && isdigit((unsigned char)s_buf.data[i])) i++;
 311:Source/core/http_client.c ****         if (i < slEnd && s_buf.data[i] == '.') {
 312:Source/core/http_client.c ****             i++;
 313:Source/core/http_client.c ****             while (i < slEnd && isdigit((unsigned char)s_buf.data[i])) i++;
 314:Source/core/http_client.c ****             if (i < slEnd && s_buf.data[i] == ' ') {
 315:Source/core/http_client.c ****                 i++;
 316:Source/core/http_client.c ****                 long st = 0;
 317:Source/core/http_client.c ****                 size_t digits = 0;
 318:Source/core/http_client.c ****                 while (i < slEnd && isdigit((unsigned char)s_buf.data[i])) {
 319:Source/core/http_client.c ****                     st = st * 10 + (s_buf.data[i] - '0');
 320:Source/core/http_client.c ****                     i++;
 321:Source/core/http_client.c ****                     digits++;
 322:Source/core/http_client.c ****                     if (digits > 10) break;
 323:Source/core/http_client.c ****                 }
 324:Source/core/http_client.c ****                 if (digits > 0) s_status = (int)st;
 325:Source/core/http_client.c ****             }
 326:Source/core/http_client.c ****         }
 327:Source/core/http_client.c ****     }
 328:Source/core/http_client.c **** 
 329:Source/core/http_client.c ****     // Header lines: split on '\n', virtual terminator at headLen (mirrors
 330:Source/core/http_client.c ****     // gmatch(headPart .. "\n", "([^\n]+)\n")). Key capture is everything
 331:Source/core/http_client.c ****     // after leading whitespace up to ':' INCLUDING trailing spaces (greedy
 332:Source/core/http_client.c ****     // [^:]+); value trims both ends.
 333:Source/core/http_client.c ****     size_t segStart = 0;
 334:Source/core/http_client.c ****     for (size_t i = 0; i <= headLen; i++) {
 335:Source/core/http_client.c ****         int atEnd = (i == headLen);
 336:Source/core/http_client.c ****         if (!atEnd && s_buf.data[i] != '\n') continue;
 337:Source/core/http_client.c ****         size_t s = segStart, e = i;
 338:Source/core/http_client.c ****         segStart = i + 1;
 339:Source/core/http_client.c ****         if (e <= s) continue; // ([^\n]+) requires >= 1 char
 340:Source/core/http_client.c ****         while (s < e && isspace((unsigned char)s_buf.data[s])) s++; // ^%s*
 341:Source/core/http_client.c ****         const char* colon =
 342:Source/core/http_client.c ****             (const char*)memchr(s_buf.data + s, ':', e - s);
 343:Source/core/http_client.c ****         if (!colon) continue;
 344:Source/core/http_client.c ****         size_t colonOff = (size_t)(colon - s_buf.data);
 345:Source/core/http_client.c ****         if (colonOff == s) continue; // ([^:]+) needs >= 1 char
 346:Source/core/http_client.c ****         size_t v = colonOff + 1;
 347:Source/core/http_client.c ****         while (v < e && isspace((unsigned char)s_buf.data[v])) v++;  // :%s*
 348:Source/core/http_client.c ****         size_t ve = e;
 349:Source/core/http_client.c ****         while (ve > v && isspace((unsigned char)s_buf.data[ve - 1])) ve--;
 350:Source/core/http_client.c ****         store_header(s_buf.data + s, colonOff - s, s_buf.data + v, ve - v);
 351:Source/core/http_client.c ****     }
 352:Source/core/http_client.c **** 
 353:Source/core/http_client.c ****     if (s_parsed.host[0] != '\0' && s_nSetCookies > 0)
 354:Source/core/http_client.c ****         cj_process_set_cookies(s_parsed.host,
 355:Source/core/http_client.c ****                                (const char* const*)s_setCookies,
