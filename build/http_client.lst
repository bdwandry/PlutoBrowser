 586:Source/core/http_client.c ****         g_state = HS_ERROR;
 587:Source/core/http_client.c ****         return;
 588:Source/core/http_client.c ****     }
 589:Source/core/http_client.c ****     /* Connection opens on the NEXT http_update tick, never inside this SDK
 590:Source/core/http_client.c ****      * callback — matching the reference's tick-deferral pattern. */
