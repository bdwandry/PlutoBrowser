 142:Source/core/http_client.c **** // Lua tonumber(trimmed, 16): full-string hex parse, optional leading '-'.
 143:Source/core/http_client.c **** // "5x", "", "0x10" fail; " ff " -> 255; "-4" -> -4.
 144:Source/core/http_client.c **** static int luatonum16(const char* str, size_t len, long* out)
 145:Source/core/http_client.c **** {
 146:Source/core/http_client.c ****     size_t i = 0;
 147:Source/core/http_client.c ****     while (i < len && isspace((unsigned char)str[i])) i++;
 148:Source/core/http_client.c ****     int neg = 0;
 149:Source/core/http_client.c ****     if (i < len && (str[i] == '+' || str[i] == '-')) {
 150:Source/core/http_client.c ****         neg = (str[i] == '-');
 151:Source/core/http_client.c ****         i++;
 152:Source/core/http_client.c ****     }
 153:Source/core/http_client.c ****     if (i >= len) return 0;
 154:Source/core/http_client.c ****     long v = 0;
 155:Source/core/http_client.c ****     for (; i < len; i++) {
 156:Source/core/http_client.c ****         unsigned char c = (unsigned char)str[i];
 157:Source/core/http_client.c ****         int d;
 158:Source/core/http_client.c ****         if (c >= '0' && c <= '9') d = c - '0';
 159:Source/core/http_client.c ****         else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
 160:Source/core/http_client.c ****         else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
 161:Source/core/http_client.c ****         else return 0;
 162:Source/core/http_client.c ****         v = v * 16 + d;
 163:Source/core/http_client.c ****     }
 164:Source/core/http_client.c ****     *out = neg ? -v : v;
 165:Source/core/http_client.c ****     return 1;
 166:Source/core/http_client.c **** }
