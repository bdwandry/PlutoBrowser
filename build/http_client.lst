 310:Source/core/http_client.c ****     // Status line: first [^\r\n] run, pattern "HTTP/%d+.%d+ (%d+)".
 311:Source/core/http_client.c ****     size_t slEnd = headLen;
 312:Source/core/http_client.c ****     for (size_t i = 0; i < headLen; i++)
 313:Source/core/http_client.c ****         if (s_buf.data[i] == '\r' || s_buf.data[i] == '\n') { slEnd = i; break; }
 314:Source/core/http_client.c ****     if (slEnd > 5 && strncmp(s_buf.data, "HTTP/", 5) == 0) {
 315:Source/core/http_client.c ****         size_t i = 5;
 316:Source/core/http_client.c ****         while (i < slEnd && isdigit((unsigned char)s_buf.data[i])) i++;
 317:Source/core/http_client.c ****         if (i < slEnd && s_buf.data[i] == '.') {
 318:Source/core/http_client.c ****             i++;
 319:Source/core/http_client.c ****             while (i < slEnd && isdigit((unsigned char)s_buf.data[i])) i++;
 320:Source/core/http_client.c ****             if (i < slEnd && s_buf.data[i] == ' ') {
 321:Source/core/http_client.c ****                 i++;
 322:Source/core/http_client.c ****                 long st = 0;
 323:Source/core/http_client.c ****                 size_t digits = 0;
 324:Source/core/http_client.c ****                 while (i < slEnd && isdigit((unsigned char)s_buf.data[i])) {
 325:Source/core/http_client.c ****                     st = st * 10 + (s_buf.data[i] - '0');
 326:Source/core/http_client.c ****                     i++;
 327:Source/core/http_client.c ****                     digits++;
 328:Source/core/http_client.c ****                     if (digits > 10) break;
 329:Source/core/http_client.c ****                 }
 330:Source/core/http_client.c ****                 if (digits > 0) s_status = (int)st;
 331:Source/core/http_client.c ****             }
 332:Source/core/http_client.c ****         }
 333:Source/core/http_client.c ****     }
 334:Source/core/http_client.c **** 
 335:Source/core/http_client.c ****     // Header lines: split on '\n', virtual terminator at headLen (mirrors
 336:Source/core/http_client.c ****     // gmatch(headPart .. "\n", "([^\n]+)\n")). Key capture is everything
 337:Source/core/http_client.c ****     // after leading whitespace up to ':' INCLUDING trailing spaces (greedy
 338:Source/core/http_client.c ****     // [^:]+); value trims both ends.
 339:Source/core/http_client.c ****     size_t segStart = 0;
 340:Source/core/http_client.c ****     for (size_t i = 0; i <= headLen; i++) {
 341:Source/core/http_client.c ****         int atEnd = (i == headLen);
 342:Source/core/http_client.c ****         if (!atEnd && s_buf.data[i] != '\n') continue;
 343:Source/core/http_client.c ****         size_t s = segStart, e = i;
 344:Source/core/http_client.c ****         segStart = i + 1;
 345:Source/core/http_client.c ****         if (e <= s) continue; // ([^\n]+) requires >= 1 char
 346:Source/core/http_client.c ****         while (s < e && isspace((unsigned char)s_buf.data[s])) s++; // ^%s*
 347:Source/core/http_client.c ****         const char* colon =
 348:Source/core/http_client.c ****             (const char*)memchr(s_buf.data + s, ':', e - s);
 349:Source/core/http_client.c ****         if (!colon) continue;
 350:Source/core/http_client.c ****         size_t colonOff = (size_t)(colon - s_buf.data);
 351:Source/core/http_client.c ****         if (colonOff == s) continue; // ([^:]+) needs >= 1 char
 352:Source/core/http_client.c ****         size_t v = colonOff + 1;
 353:Source/core/http_client.c ****         while (v < e && isspace((unsigned char)s_buf.data[v])) v++;  // :%s*
 354:Source/core/http_client.c ****         size_t ve = e;
 355:Source/core/http_client.c ****         while (ve > v && isspace((unsigned char)s_buf.data[ve - 1])) ve--;
 356:Source/core/http_client.c ****         store_header(s_buf.data + s, colonOff - s, s_buf.data + v, ve - v);
 357:Source/core/http_client.c ****     }
 358:Source/core/http_client.c **** 
