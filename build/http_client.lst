 310:src/core/http_client.c ****         while (i < slEnd && isdigit((unsigned char)s_buf.data[i])) i++;
 311:src/core/http_client.c ****         if (i < slEnd && s_buf.data[i] == '.') {
 312:src/core/http_client.c ****             i++;
 313:src/core/http_client.c ****             while (i < slEnd && isdigit((unsigned char)s_buf.data[i])) i++;
 314:src/core/http_client.c ****             if (i < slEnd && s_buf.data[i] == ' ') {
 315:src/core/http_client.c ****                 i++;
 316:src/core/http_client.c ****                 long st = 0;
 317:src/core/http_client.c ****                 size_t digits = 0;
 318:src/core/http_client.c ****                 while (i < slEnd && isdigit((unsigned char)s_buf.data[i])) {
 319:src/core/http_client.c ****                     st = st * 10 + (s_buf.data[i] - '0');
 320:src/core/http_client.c ****                     i++;
 321:src/core/http_client.c ****                     digits++;
 322:src/core/http_client.c ****                     if (digits > 10) break;
 323:src/core/http_client.c ****                 }
 324:src/core/http_client.c ****                 if (digits > 0) s_status = (int)st;
 325:src/core/http_client.c ****             }
 326:src/core/http_client.c ****         }
 327:src/core/http_client.c ****     }
 328:src/core/http_client.c **** 
 329:src/core/http_client.c ****     // Header lines: split on '\n', virtual terminator at headLen (mirrors
 330:src/core/http_client.c ****     // gmatch(headPart .. "\n", "([^\n]+)\n")). Key capture is everything
 331:src/core/http_client.c ****     // after leading whitespace up to ':' INCLUDING trailing spaces (greedy
 332:src/core/http_client.c ****     // [^:]+); value trims both ends.
 333:src/core/http_client.c ****     size_t segStart = 0;
 334:src/core/http_client.c ****     for (size_t i = 0; i <= headLen; i++) {
 335:src/core/http_client.c ****         int atEnd = (i == headLen);
 336:src/core/http_client.c ****         if (!atEnd && s_buf.data[i] != '\n') continue;
 337:src/core/http_client.c ****         size_t s = segStart, e = i;
 338:src/core/http_client.c ****         segStart = i + 1;
 339:src/core/http_client.c ****         if (e <= s) continue; // ([^\n]+) requires >= 1 char
 340:src/core/http_client.c ****         while (s < e && isspace((unsigned char)s_buf.data[s])) s++; // ^%s*
 341:src/core/http_client.c ****         const char* colon =
 342:src/core/http_client.c ****             (const char*)memchr(s_buf.data + s, ':', e - s);
 343:src/core/http_client.c ****         if (!colon) continue;
 344:src/core/http_client.c ****         size_t colonOff = (size_t)(colon - s_buf.data);
 345:src/core/http_client.c ****         if (colonOff == s) continue; // ([^:]+) needs >= 1 char
 346:src/core/http_client.c ****         size_t v = colonOff + 1;
 347:src/core/http_client.c ****         while (v < e && isspace((unsigned char)s_buf.data[v])) v++;  // :%s*
 348:src/core/http_client.c ****         size_t ve = e;
 349:src/core/http_client.c ****         while (ve > v && isspace((unsigned char)s_buf.data[ve - 1])) ve--;
 350:src/core/http_client.c ****         store_header(s_buf.data + s, colonOff - s, s_buf.data + v, ve - v);
 351:src/core/http_client.c ****     }
 352:src/core/http_client.c **** 
 353:src/core/http_client.c ****     if (s_parsed.host[0] != '\0' && s_nSetCookies > 0)
 354:src/core/http_client.c ****         cj_process_set_cookies(s_parsed.host,
 355:src/core/http_client.c ****                                (const char* const*)s_setCookies,
