 647:Source/core/http_client.c **** void hc_update(void)
 648:Source/core/http_client.c **** {
 649:Source/core/http_client.c ****     // A deferred redirect (from a prior tick) opens the next connection now,
 650:Source/core/http_client.c ****     // well after the previous connection was fully closed by us.
 651:Source/core/http_client.c ****     if (s_hasPendingRedirect) {
 652:Source/core/http_client.c ****         char u[HC_URL_MAX];
 653:Source/core/http_client.c ****         memcpy(u, s_pendingUrl, sizeof(u));
 654:Source/core/http_client.c ****         PlutoHttpCallbacks cb = s_pendingCbs;
 655:Source/core/http_client.c ****         s_hasPendingRedirect = 0;
 656:Source/core/http_client.c ****         s_pendingCbs = HC_NO_CBS;
 657:Source/core/http_client.c ****         do_get(u, &cb);
 658:Source/core/http_client.c ****         return;
 659:Source/core/http_client.c ****     }
 660:Source/core/http_client.c **** 
 661:Source/core/http_client.c ****     if (s_state == HC_IDLE) return;
 662:Source/core/http_client.c **** 
 663:Source/core/http_client.c ****     // about-page timer (playdate.timer.performAfterDelay(20) parity).
 664:Source/core/http_client.c ****     // Faithful ordering: progress -> success -> reset (a get() issued from
 665:Source/core/http_client.c ****     // inside onSuccess is clobbered by this trailing reset, like in Lua).
 666:Source/core/http_client.c ****     if (s_aboutPending && hc_now() >= s_aboutDueMs) {
 667:Source/core/http_client.c ****         PlutoHttpCallbacks cb = s_cbs;
 668:Source/core/http_client.c ****         const HcInternalPage* page = s_aboutPage;
 669:Source/core/http_client.c ****         char url[HC_URL_MAX];
 670:Source/core/http_client.c ****         memcpy(url, s_url, sizeof(url));
 671:Source/core/http_client.c ****         if (cb.onProgress) cb.onProgress(cb.ud, 100, 100);
 672:Source/core/http_client.c ****         if (cb.onSuccess) {
 673:Source/core/http_client.c ****             StrMap* m = sm_create(4);
 674:Source/core/http_client.c ****             char* v = pluto_strdup("text/html");
 675:Source/core/http_client.c ****             if (m && v) {
 676:Source/core/http_client.c ****                 sm_put(m, "content-type", v);
 677:Source/core/http_client.c ****                 cb.onSuccess(cb.ud, 200, m, page->html, page->htmlLen, url);
 678:Source/core/http_client.c ****             }
 679:Source/core/http_client.c ****             pluto_free(v);
 680:Source/core/http_client.c ****             sm_destroy(m);
 681:Source/core/http_client.c ****         }
 682:Source/core/http_client.c ****         reset();
 683:Source/core/http_client.c ****         return;
 684:Source/core/http_client.c ****     }
