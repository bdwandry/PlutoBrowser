1055:Source/core/http_client.c **** static void hc_open_cb(TCPConnection* conn, PDNetErr err, void* ud)
1056:Source/core/http_client.c **** {
1057:Source/core/http_client.c ****     (void)ud;
1058:Source/core/http_client.c ****     unsigned myId = (unsigned)(uintptr_t)s_tcp->getUserdata(conn);
1059:Source/core/http_client.c ****     if (myId != s_reqId || conn != s_conn) {
1060:Source/core/http_client.c ****         // Cancelled or superseded while still connecting; open has resolved,
1061:Source/core/http_client.c ****         // so closing here is safe (see close_tcp comment).
1062:Source/core/http_client.c ****         s_tcp->close(conn);
1063:Source/core/http_client.c ****         return;
1064:Source/core/http_client.c ****     }
1065:Source/core/http_client.c ****     if (err != NET_OK) {
1066:Source/core/http_client.c ****         s_openFailed = 1;
1067:Source/core/http_client.c ****         set_error("Connection failed: %s", neterr_name(err));
1068:Source/core/http_client.c ****         s_state = HC_ERROR;
1069:Source/core/http_client.c ****         return;
1070:Source/core/http_client.c ****     }
1071:Source/core/http_client.c ****     s_connOpen = 1;
1072:Source/core/http_client.c **** }
1073:Source/core/http_client.c **** 
1074:Source/core/http_client.c **** static void hc_closed_cb(TCPConnection* conn, PDNetErr err)
1075:Source/core/http_client.c **** {
1076:Source/core/http_client.c ****     (void)err;
1077:Source/core/http_client.c ****     unsigned myId = (unsigned)(uintptr_t)s_tcp->getUserdata(conn);
1078:Source/core/http_client.c ****     if (myId == s_reqId && conn == s_conn) s_connClosed = 1;
1079:Source/core/http_client.c **** }
