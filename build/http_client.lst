 162:src/core/http_client.c **** static const char* neterr_name(PDNetErr err)
 163:src/core/http_client.c **** {
 164:src/core/http_client.c ****     switch (err) {
 165:src/core/http_client.c ****     case NET_OK: return "ok";
 166:src/core/http_client.c ****     case NET_NO_DEVICE: return "NET_NO_DEVICE";
 167:src/core/http_client.c ****     case NET_BUSY: return "NET_BUSY";
 168:src/core/http_client.c ****     case NET_WRITE_ERROR: return "NET_WRITE_ERROR";
 169:src/core/http_client.c ****     case NET_WRITE_BUSY: return "NET_WRITE_BUSY";
 170:src/core/http_client.c ****     case NET_WRITE_TIMEOUT: return "NET_WRITE_TIMEOUT";
 171:src/core/http_client.c ****     case NET_READ_ERROR: return "NET_READ_ERROR";
 172:src/core/http_client.c ****     case NET_READ_BUSY: return "NET_READ_BUSY";
 173:src/core/http_client.c ****     case NET_READ_TIMEOUT: return "NET_READ_TIMEOUT";
 174:src/core/http_client.c ****     case NET_READ_OVERFLOW: return "NET_READ_OVERFLOW";
 175:src/core/http_client.c ****     case NET_FRAME_ERROR: return "NET_FRAME_ERROR";
 176:src/core/http_client.c ****     case NET_BAD_RESPONSE: return "NET_BAD_RESPONSE";
 177:src/core/http_client.c ****     case NET_ERROR_RESPONSE: return "NET_ERROR_RESPONSE";
 178:src/core/http_client.c ****     case NET_RESET_TIMEOUT: return "NET_RESET_TIMEOUT";
 179:src/core/http_client.c ****     case NET_BUFFER_TOO_SMALL: return "NET_BUFFER_TOO_SMALL";
 180:src/core/http_client.c ****     case NET_UNEXPECTED_RESPONSE: return "NET_UNEXPECTED_RESPONSE";
 181:src/core/http_client.c ****     case NET_NOT_CONNECTED_TO_AP: return "NET_NOT_CONNECTED_TO_AP";
 182:src/core/http_client.c ****     case NET_NOT_IMPLEMENTED: return "NET_NOT_IMPLEMENTED";
 183:src/core/http_client.c ****     case NET_CONNECTION_CLOSED: return "NET_CONNECTION_CLOSED";
 184:src/core/http_client.c ****     default: return "NET_UNKNOWN";
 185:src/core/http_client.c ****     }
 186:src/core/http_client.c **** }
