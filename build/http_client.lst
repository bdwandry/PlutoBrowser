 672:Source/core/http_client.c ****         size_t avail = s_tcp->getBytesAvailable(s_conn);
 673:Source/core/http_client.c ****         if (avail > 0) {
 674:Source/core/http_client.c ****             size_t want = avail < HC_READ_CHUNK ? avail : HC_READ_CHUNK;
 675:Source/core/http_client.c ****             int n = s_tcp->read(s_conn, pumpTmp, want);
