 262:Source/core/http_client.c **** // ── Chunked decoding ────────────────────────
 263:Source/core/http_client.c **** 
 264:Source/core/http_client.c **** // Returns a heap StrBuf with the decoded body, or NULL while incomplete /
 265:Source/core/http_client.c **** // malformed (caller keeps buffering, exactly like the Lua version).
 266:Source/core/http_client.c **** static StrBuf* decode_chunked(const char* str, size_t len)
 267:Source/core/http_client.c **** {
 268:Source/core/http_client.c ****     StrBuf* out = (StrBuf*)pluto_malloc(sizeof(StrBuf));
 269:Source/core/http_client.c ****     if (!out) return NULL;
 270:Source/core/http_client.c ****     sb_init(out);
 271:Source/core/http_client.c ****     size_t pos = 0;
 272:Source/core/http_client.c ****     for (;;) {
 273:Source/core/http_client.c ****         const char* le = memfind(str + pos, len - pos, "\r\n", 2);
 274:Source/core/http_client.c ****         if (!le) goto fail;
 275:Source/core/http_client.c ****         size_t lineEnd = (size_t)(le - str);
 276:Source/core/http_client.c ****         size_t sizeEnd = lineEnd;
 277:Source/core/http_client.c ****         for (size_t i = pos; i < lineEnd; i++)
 278:Source/core/http_client.c ****             if (str[i] == ';') { sizeEnd = i; break; }
 279:Source/core/http_client.c ****         long size = 0;
 280:Source/core/http_client.c ****         if (!luatonum16(str + pos, sizeEnd - pos, &size)) goto fail;
 281:Source/core/http_client.c ****         pos = lineEnd + 2;
 282:Source/core/http_client.c ****         if (size == 0) return out;
 283:Source/core/http_client.c ****         if ((long)len < (long)pos + size + 2) goto fail;
 284:Source/core/http_client.c ****         if (!sb_append(out, str + pos, (size_t)size)) goto fail;
 285:Source/core/http_client.c ****         pos += (size_t)size + 2;
 286:Source/core/http_client.c ****     }
 287:Source/core/http_client.c **** fail:
 288:Source/core/http_client.c ****     sb_free(out);
 289:Source/core/http_client.c ****     pluto_free(out);
 290:Source/core/http_client.c ****     return NULL;
 291:Source/core/http_client.c **** }
