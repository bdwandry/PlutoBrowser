 355:Source/core/http_client.c **** /* Case-insensitive header lookup over the saved set. */
 356:Source/core/http_client.c **** static const char *saved_header(const char *key)
 357:Source/core/http_client.c **** {
 358:Source/core/http_client.c ****     for (int i = 0; i < g_savedHeaderCount; i++)
 359:Source/core/http_client.c ****     {
 360:Source/core/http_client.c ****         if (strcasecmp(g_savedHeaders[i][0], key) == 0)
 361:Source/core/http_client.c ****         {
 362:Source/core/http_client.c ****             return g_savedHeaders[i][1];
 363:Source/core/http_client.c ****         }
 364:Source/core/http_client.c ****     }
 365:Source/core/http_client.c ****     return NULL;
 366:Source/core/http_client.c **** }
