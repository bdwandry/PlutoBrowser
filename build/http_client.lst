 168:Source/core/http_client.c **** static const char* neterr_name(PDNetErr err)
 169:Source/core/http_client.c **** {
 170:Source/core/http_client.c ****     switch (err) {
 171:Source/core/http_client.c ****     case NET_OK: return "ok";
 172:Source/core/http_client.c ****     case NET_NO_DEVICE: return "NET_NO_DEVICE";
 173:Source/core/http_client.c ****     case NET_BUSY: return "NET_BUSY";
 174:Source/core/http_client.c ****     case NET_WRITE_ERROR: return "NET_WRITE_ERROR";
 175:Source/core/http_client.c ****     case NET_WRITE_BUSY: return "NET_WRITE_BUSY";
 176:Source/core/http_client.c ****     case NET_WRITE_TIMEOUT: return "NET_WRITE_TIMEOUT";
 177:Source/core/http_client.c ****     case NET_READ_ERROR: return "NET_READ_ERROR";
 178:Source/core/http_client.c ****     case NET_READ_BUSY: return "NET_READ_BUSY";
 179:Source/core/http_client.c ****     case NET_READ_TIMEOUT: return "NET_READ_TIMEOUT";
 180:Source/core/http_client.c ****     case NET_READ_OVERFLOW: return "NET_READ_OVERFLOW";
 181:Source/core/http_client.c ****     case NET_FRAME_ERROR: return "NET_FRAME_ERROR";
 182:Source/core/http_client.c ****     case NET_BAD_RESPONSE: return "NET_BAD_RESPONSE";
 183:Source/core/http_client.c ****     case NET_ERROR_RESPONSE: return "NET_ERROR_RESPONSE";
 184:Source/core/http_client.c ****     case NET_RESET_TIMEOUT: return "NET_RESET_TIMEOUT";
 185:Source/core/http_client.c ****     case NET_BUFFER_TOO_SMALL: return "NET_BUFFER_TOO_SMALL";
