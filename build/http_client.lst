 387:Source/core/http_client.c **** static void close_tcp(void)
 388:Source/core/http_client.c **** {
 389:Source/core/http_client.c ****     if (!s_conn) return;
 390:Source/core/http_client.c ****     TCPConnection* conn = s_conn;
 391:Source/core/http_client.c ****     s_conn = NULL;
 392:Source/core/http_client.c ****     // Only close once open has resolved; a still-connecting socket is closed
 393:Source/core/http_client.c ****     // by its own open callback when it notices it is stale (WX sim crash).
 394:Source/core/http_client.c ****     if (s_connOpen || s_openFailed) s_tcp->close(conn);
 395:Source/core/http_client.c **** }
