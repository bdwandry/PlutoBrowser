 823:Source/core/http_client.c ****     // Detect a complete body (TCP backend only — HTTP API uses request_complete_cb)
 824:Source/core/http_client.c ****     if (s_state == HC_READING && s_hasBodyStart &&
 825:Source/core/http_client.c ****         s_backend == HC_BACKEND_TCP) {
 826:Source/core/http_client.c ****         long bodyBytes = (long)s_buf.len - (long)s_bodyStart;
 827:Source/core/http_client.c ****         if (s_chunked) {
 828:Source/core/http_client.c ****             StrBuf* dec =
 829:Source/core/http_client.c ****                 decode_chunked(s_buf.data + s_bodyStart,
 830:Source/core/http_client.c ****                                s_buf.len - s_bodyStart);
 831:Source/core/http_client.c ****             if (dec) {
 832:Source/core/http_client.c ****                 sb_free(dec);
 833:Source/core/http_client.c ****                 pluto_free(dec);
 834:Source/core/http_client.c ****                 s_state = HC_DONE;
 835:Source/core/http_client.c ****             }
 836:Source/core/http_client.c ****         } else if (s_contentLength >= 0 && bodyBytes >= s_contentLength) {
 837:Source/core/http_client.c ****             s_state = HC_DONE;
 838:Source/core/http_client.c ****         }
 839:Source/core/http_client.c ****         if (s_buf.len >= HC_MAX_RESPONSE_SIZE) s_state = HC_DONE;
 840:Source/core/http_client.c ****     }
 841:Source/core/http_client.c **** 
 842:Source/core/http_client.c ****     // Server closed the connection
 843:Source/core/http_client.c ****     if (s_state == HC_READING && s_connClosed) {
 844:Source/core/http_client.c ****         // Drain any remaining data from the HTTP API before declaring done.
 845:Source/core/http_client.c ****         // The SDK may fire request_complete/connection_closed before our pump
 846:Source/core/http_client.c ****         // has read everything.
 847:Source/core/http_client.c ****         if (s_backend == HC_BACKEND_HTTP && s_http_conn) {
 848:Source/core/http_client.c ****             static char drainTmp[HC_READ_CHUNK];
 849:Source/core/http_client.c ****             size_t avail;
 850:Source/core/http_client.c ****             while ((avail = s_http->getBytesAvailable(s_http_conn)) > 0) {
 851:Source/core/http_client.c ****                 size_t want = avail < HC_READ_CHUNK ? avail : HC_READ_CHUNK;
 852:Source/core/http_client.c ****                 int n = s_http->read(s_http_conn, drainTmp, (int)want);
 853:Source/core/http_client.c ****                 if (n > 0) {
