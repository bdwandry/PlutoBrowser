 387:src/core/http_client.c **** static void close_tcp(void)
 388:src/core/http_client.c **** {
 389:src/core/http_client.c ****     if (!s_conn) return;
 390:src/core/http_client.c ****     TCPConnection* conn = s_conn;
 391:src/core/http_client.c ****     s_conn = NULL;
 392:src/core/http_client.c ****     // Only close once open has resolved; a still-connecting socket is closed
 393:src/core/http_client.c ****     // by its own open callback when it notices it is stale (WX sim crash).
 394:src/core/http_client.c ****     if (s_connOpen || s_openFailed) s_tcp->close(conn);
 395:src/core/http_client.c **** }
