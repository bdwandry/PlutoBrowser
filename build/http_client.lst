 120:Source/core/http_client.c **** static const char* memfind(const char* hay, size_t hayLen, const char* needle,
 121:Source/core/http_client.c ****                            size_t nLen)
 122:Source/core/http_client.c **** {
 123:Source/core/http_client.c ****     if (nLen == 0) return hay;
 124:Source/core/http_client.c ****     if (hay == NULL || hayLen < nLen) return NULL;
 125:Source/core/http_client.c ****     for (size_t i = 0; i + nLen <= hayLen; i++)
 126:Source/core/http_client.c ****         if (hay[i] == needle[0] && memcmp(hay + i, needle, nLen) == 0)
 127:Source/core/http_client.c ****             return hay + i;
 128:Source/core/http_client.c ****     return NULL;
 129:Source/core/http_client.c **** }
