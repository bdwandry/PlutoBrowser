 858:Source/core/http_client.c ****                 }
 859:Source/core/http_client.c ****             }
 860:Source/core/http_client.c ****         }
 861:Source/core/http_client.c ****         PLUTO_LOG("[HC] connClosed: bufLen=%zu state=%d backend=%d",
 862:Source/core/http_client.c ****                   s_buf.len, s_state, s_backend);
 863:Source/core/http_client.c ****         if (s_buf.len == 0) {
 864:Source/core/http_client.c ****             set_error("Connection closed before any data was received.");
 865:Source/core/http_client.c ****             s_state = HC_ERROR;
 866:Source/core/http_client.c ****         } else {
 867:Source/core/http_client.c ****             s_state = HC_DONE;
 868:Source/core/http_client.c ****         }
 869:Source/core/http_client.c ****     }
 870:Source/core/http_client.c **** 
 871:Source/core/http_client.c ****     // Handle completed request
