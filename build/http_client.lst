1102:Source/core/http_client.c ****     s_hasPendingRedirect = 0;
1103:Source/core/http_client.c ****     s_pendingCbs = HC_NO_CBS;
1104:Source/core/http_client.c ****     s_redirectDepth = 0;
1105:Source/core/http_client.c ****     return do_get(urlStr, cbs);
