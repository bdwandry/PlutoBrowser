1034:Source/core/http_client.c **** static void http_access_cb(bool allowed, void* userdata)
1035:Source/core/http_client.c **** {
1036:Source/core/http_client.c ****     (void)userdata;
1037:Source/core/http_client.c ****     if (!s_accessWaiting) return;
1038:Source/core/http_client.c ****     s_accessWaiting = 0;
1039:Source/core/http_client.c ****     if (s_reqId != s_accessReqId) return;
