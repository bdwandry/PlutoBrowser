 645:Source/core/http_client.c ****             s_state = HC_ERROR;
 646:Source/core/http_client.c ****         }
 647:Source/core/http_client.c ****     }
 648:Source/core/http_client.c **** 
 649:Source/core/http_client.c ****     // Send the HTTP request once the connection is open. Written from a later
 650:Source/core/http_client.c ****     // update frame (not inside the SDK open callback) so TLS settles first.
 651:Source/core/http_client.c ****     if (s_state == HC_CONNECTING && s_connOpen && s_conn) {
