 573:Source/core/http_client.c **** static void access_cb(bool allowed, void *ud)
 574:Source/core/http_client.c **** {
 575:Source/core/http_client.c ****     (void)ud;
 576:Source/core/http_client.c ****     if (!allowed)
 577:Source/core/http_client.c ****     {
 578:Source/core/http_client.c ****         /* Only meaningful if this reply still belongs to the live request.
 579:Source/core/http_client.c ****          * A reply for a cancelled/reset request must not clobber fresh
 580:Source/core/http_client.c ****          * state: reset_state() bumped g_requestId before reuse. */
