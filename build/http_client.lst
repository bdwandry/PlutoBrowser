 707:Source/core/http_client.c ****     // Send the HTTP request once the connection is open. Written from a later
 708:Source/core/http_client.c ****     // update frame (not inside the SDK open callback) so TLS settles first.
 709:Source/core/http_client.c ****     // Only for TCP backend — the HTTP API handles request formatting/sending.
 710:Source/core/http_client.c ****     if (s_state == HC_CONNECTING && s_connOpen && s_conn &&
 711:Source/core/http_client.c ****         s_backend == HC_BACKEND_TCP) {
 712:Source/core/http_client.c ****         StrBuf req;
 713:Source/core/http_client.c ****         sb_init(&req);
 714:Source/core/http_client.c ****         build_request(&s_parsed, &req);
 715:Source/core/http_client.c ****         int sent = s_tcp->write(s_conn, req.data, req.len);
 716:Source/core/http_client.c ****         sb_free(&req);
