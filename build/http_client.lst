 630:Source/core/http_client.c ****     size_t nVals = s_nHdrVals;
 631:Source/core/http_client.c ****     memcpy(vals, s_hdrVals, nVals * sizeof(char*));
 632:Source/core/http_client.c ****     s_nHdrVals = 0;
 633:Source/core/http_client.c **** 
 634:Source/core/http_client.c ****     reset();
 635:Source/core/http_client.c **** 
 636:Source/core/http_client.c ****     if (cb.onSuccess)
 637:Source/core/http_client.c ****         cb.onSuccess(cb.ud, st, map, body.data ? body.data : "", body.len,
 638:Source/core/http_client.c ****                      url);
 639:Source/core/http_client.c **** 
 640:Source/core/http_client.c ****     for (size_t i = 0; i < nVals; i++) pluto_free(vals[i]);
 641:Source/core/http_client.c ****     sm_destroy(map);
 642:Source/core/http_client.c ****     sb_free(&body);
 643:Source/core/http_client.c **** }
