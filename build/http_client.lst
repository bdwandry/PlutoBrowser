 668:Source/core/http_client.c ****     // Pump incoming data. The staging buffer is static: the SDK update loop
 669:Source/core/http_client.c ****     // is single-threaded and 32 KiB would blow the 60 KiB app stack.
 670:Source/core/http_client.c ****     if (s_state == HC_READING && s_conn && s_connOpen) {
