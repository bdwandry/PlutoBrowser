 313:Source/core/http_client.c ****     s_headers = sm_create(16);
 314:Source/core/http_client.c **** 
 315:Source/core/http_client.c ****     // Status line: first [^\r\n] run, pattern "HTTP/%d+.%d+ (%d+)".
 316:Source/core/http_client.c ****     size_t slEnd = headLen;
 317:Source/core/http_client.c ****     for (size_t i = 0; i < headLen; i++)
 318:Source/core/http_client.c ****         if (s_buf.data[i] == '\r' || s_buf.data[i] == '\n') { slEnd = i; break; }
 319:Source/core/http_client.c ****     if (slEnd > 5 && strncmp(s_buf.data, "HTTP/", 5) == 0) {
 320:Source/core/http_client.c ****         size_t i = 5;
 321:Source/core/http_client.c ****         while (i < slEnd && isdigit((unsigned char)s_buf.data[i])) i++;
 322:Source/core/http_client.c ****         if (i < slEnd && s_buf.data[i] == '.') {
 323:Source/core/http_client.c ****             i++;
 324:Source/core/http_client.c ****             while (i < slEnd && isdigit((unsigned char)s_buf.data[i])) i++;
 325:Source/core/http_client.c ****             if (i < slEnd && s_buf.data[i] == ' ') {
 326:Source/core/http_client.c ****                 i++;
 327:Source/core/http_client.c ****                 long st = 0;
 328:Source/core/http_client.c ****                 size_t digits = 0;
 329:Source/core/http_client.c ****                 while (i < slEnd && isdigit((unsigned char)s_buf.data[i])) {
 330:Source/core/http_client.c ****                     st = st * 10 + (s_buf.data[i] - '0');
 331:Source/core/http_client.c ****                     i++;
 332:Source/core/http_client.c ****                     digits++;
 333:Source/core/http_client.c ****                     if (digits > 10) break;
 334:Source/core/http_client.c ****                 }
 335:Source/core/http_client.c ****                 if (digits > 0) s_status = (int)st;
 336:Source/core/http_client.c ****             }
 337:Source/core/http_client.c ****         }
 338:Source/core/http_client.c ****     }
 339:Source/core/http_client.c **** 
 340:Source/core/http_client.c ****     // Header lines: split on '\n', virtual terminator at headLen (mirrors
 341:Source/core/http_client.c ****     // gmatch(headPart .. "\n", "([^\n]+)\n")). Key capture is everything
 342:Source/core/http_client.c ****     // after leading whitespace up to ':' INCLUDING trailing spaces (greedy
 343:Source/core/http_client.c ****     // [^:]+); value trims both ends.
 344:Source/core/http_client.c ****     size_t segStart = 0;
 345:Source/core/http_client.c ****     for (size_t i = 0; i <= headLen; i++) {
 346:Source/core/http_client.c ****         int atEnd = (i == headLen);
 347:Source/core/http_client.c ****         if (!atEnd && s_buf.data[i] != '\n') continue;
 348:Source/core/http_client.c ****         size_t s = segStart, e = i;
 349:Source/core/http_client.c ****         segStart = i + 1;
 350:Source/core/http_client.c ****         if (e <= s) continue; // ([^\n]+) requires >= 1 char
 351:Source/core/http_client.c ****         while (s < e && isspace((unsigned char)s_buf.data[s])) s++; // ^%s*
 352:Source/core/http_client.c ****         const char* colon =
 353:Source/core/http_client.c ****             (const char*)memchr(s_buf.data + s, ':', e - s);
 354:Source/core/http_client.c ****         if (!colon) continue;
 355:Source/core/http_client.c ****         size_t colonOff = (size_t)(colon - s_buf.data);
 356:Source/core/http_client.c ****         if (colonOff == s) continue; // ([^:]+) needs >= 1 char
 357:Source/core/http_client.c ****         size_t v = colonOff + 1;
 358:Source/core/http_client.c ****         while (v < e && isspace((unsigned char)s_buf.data[v])) v++;  // :%s*
 359:Source/core/http_client.c ****         size_t ve = e;
 360:Source/core/http_client.c ****         while (ve > v && isspace((unsigned char)s_buf.data[ve - 1])) ve--;
 361:Source/core/http_client.c ****         store_header(s_buf.data + s, colonOff - s, s_buf.data + v, ve - v);
 362:Source/core/http_client.c ****     }
 363:Source/core/http_client.c **** 
