 584:Source/core/http_client.c ****         }
 585:Source/core/http_client.c ****         snprintf(g_error, sizeof(g_error), "Network access denied.");
 586:Source/core/http_client.c ****         g_state = HS_ERROR;
 587:Source/core/http_client.c ****         return;
 588:Source/core/http_client.c ****     }
