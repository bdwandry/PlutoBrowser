   1:Source/core/http_client.c **** // http_client.c — raw TCP HTTP/HTTPS client (C port of core/http_client.lua).
   2:Source/core/http_client.c **** //
   3:Source/core/http_client.c **** // One request at a time over pd->network->tcp, with the Lua original's state
   4:Source/core/http_client.c **** // machine reproduced block-for-block inside hc_update() (same order, same
   5:Source/core/http_client.c **** // early returns, same quirks — see http_client.h for the annotated list).
   6:Source/core/http_client.c **** //
   7:Source/core/http_client.c **** // C-only additions the Lua SDK wrapper hid:
   8:Source/core/http_client.c **** //  - network access gating via tcp->requestAccess + a session grant cache
   9:Source/core/http_client.c **** //    keyed by host (kAccessAsk waits for the callback before connecting);
  10:Source/core/http_client.c **** //  - millisecond timeouts (Lua used seconds: 10 s -> 10000 ms);
  11:Source/core/http_client.c **** //  - stale-callback identification by connection pointer + generation id
  12:Source/core/http_client.c **** //    stored through setUserdata (the closed-callback carries no userdata);
  13:Source/core/http_client.c **** //  - write/read failures surface PDNetErr names where the Lua wrapper fed
  14:Source/core/http_client.c **** //    arbitrary error strings ("Send failed: NET_WRITE_ERROR").
  15:Source/core/http_client.c **** //
  16:Source/core/http_client.c **** // Testability: hc_set_tcp_for_tests()/hc_set_clock_fn() swap the vtable and
  17:Source/core/http_client.c **** // clock so selftest_http.c can replay the oracle scenarios offline.
