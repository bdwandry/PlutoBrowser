 660:Source/core/http_client.c ****             set_error("Send failed: ?");
 661:Source/core/http_client.c ****             s_state = HC_ERROR;
 662:Source/core/http_client.c ****         } else {
 663:Source/core/http_client.c ****             set_error("Send failed: %s", neterr_name((PDNetErr)sent));
 664:Source/core/http_client.c ****             s_state = HC_ERROR;
 665:Source/core/http_client.c ****         }
 666:Source/core/http_client.c ****     }
