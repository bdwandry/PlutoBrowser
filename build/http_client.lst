 120:src/core/http_client.c **** // Lua plain tonumber(str): full-string decimal parse (whitespace allowed),
 121:src/core/http_client.c **** // optional sign, >= 1 digit. "12abc" fails.
 122:src/core/http_client.c **** static int luatonum10(const char* str, long* out)
 123:src/core/http_client.c **** {
 124:src/core/http_client.c ****     if (!str) return 0;
 125:src/core/http_client.c ****     const char* p = str;
 126:src/core/http_client.c ****     while (*p && isspace((unsigned char)*p)) p++;
 127:src/core/http_client.c ****     char* end = NULL;
 128:src/core/http_client.c ****     long v = strtol(p, &end, 10);
 129:src/core/http_client.c ****     if (end == p) return 0;
 130:src/core/http_client.c ****     while (*end && isspace((unsigned char)*end)) end++;
 131:src/core/http_client.c ****     if (*end != '\0') return 0;
 132:src/core/http_client.c ****     *out = v;
 133:src/core/http_client.c ****     return 1;
 134:src/core/http_client.c **** }
 135:src/core/http_client.c **** 
 136:src/core/http_client.c **** // Lua tonumber(trimmed, 16): full-string hex parse, optional leading '-'.
 137:src/core/http_client.c **** // "5x", "", "0x10" fail; " ff " -> 255; "-4" -> -4.
 138:src/core/http_client.c **** static int luatonum16(const char* str, size_t len, long* out)
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccnBJ4sQ.s 			page 5


 139:src/core/http_client.c **** {
 140:src/core/http_client.c ****     size_t i = 0;
 141:src/core/http_client.c ****     while (i < len && isspace((unsigned char)str[i])) i++;
 142:src/core/http_client.c ****     int neg = 0;
 143:src/core/http_client.c ****     if (i < len && (str[i] == '+' || str[i] == '-')) {
 144:src/core/http_client.c ****         neg = (str[i] == '-');
 145:src/core/http_client.c ****         i++;
 146:src/core/http_client.c ****     }
 147:src/core/http_client.c ****     if (i >= len) return 0;
 148:src/core/http_client.c ****     long v = 0;
 149:src/core/http_client.c ****     for (; i < len; i++) {
 150:src/core/http_client.c ****         unsigned char c = (unsigned char)str[i];
 151:src/core/http_client.c ****         int d;
 152:src/core/http_client.c ****         if (c >= '0' && c <= '9') d = c - '0';
 153:src/core/http_client.c ****         else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
 154:src/core/http_client.c ****         else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
 155:src/core/http_client.c ****         else return 0;
 156:src/core/http_client.c ****         v = v * 16 + d;
 157:src/core/http_client.c ****     }
 158:src/core/http_client.c ****     *out = neg ? -v : v;
 159:src/core/http_client.c ****     return 1;
 160:src/core/http_client.c **** }
