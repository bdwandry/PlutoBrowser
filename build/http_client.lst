 532:Source/core/http_client.c **** static void tcp_closed_cb(TCPConnection *conn, PDNetErr err)
 533:Source/core/http_client.c **** {
 534:Source/core/http_client.c ****     (void)conn;
 535:Source/core/http_client.c ****     (void)err;
