 199:Source/core/http_client.c **** /* ── Helpers ───────────────────────────
 200:Source/core/http_client.c **** 
 201:Source/core/http_client.c **** /* Lua closeTcp: only close once the open has resolved; a still-connecting
 202:Source/core/http_client.c ****  * socket is left to its open callback, which detects staleness via requestId
 203:Source/core/http_client.c ****  * and closes itself (closing-while-connecting crashed the WX Simulator). */
 204:Source/core/http_client.c **** static void close_tcp(void)
 205:Source/core/http_client.c **** {
 206:Source/core/http_client.c ****     if (g_tcp)
 207:Source/core/http_client.c ****     {
 208:Source/core/http_client.c ****         TCPConnection *t = g_tcp;
 209:Source/core/http_client.c ****         g_tcp = NULL;
 210:Source/core/http_client.c ****         if (g_connOpen || g_openFailed)
 211:Source/core/http_client.c ****         {
 212:Source/core/http_client.c ****             /* Open RESOLVED (success or failure): safe to close. Keep the
 213:Source/core/http_client.c ****              * object pooled — never release a TLS connection the SDK may
 214:Source/core/http_client.c ****              * still have event-loop state for (hazard 2). */
 215:Source/core/http_client.c ****             g_pd->network->tcp->close(t);
 216:Source/core/http_client.c ****         }
 217:Source/core/http_client.c ****         else
 218:Source/core/http_client.c ****         {
 219:Source/core/http_client.c ****             /* Still connecting: touching it here crashed the WX Simulator.
 220:Source/core/http_client.c ****              * Hand it to the orphan slot — its (stale) open callback will
 221:Source/core/http_client.c ****              * close AND release it when the async open settles (hazard 1). */
 222:Source/core/http_client.c ****             g_orphanTcp = t;
 223:Source/core/http_client.c ****             if (g_pooledTcp == t)
 224:Source/core/http_client.c ****             {
 225:Source/core/http_client.c ****                 g_pooledTcp = NULL; /* pool entry now owned by the orphan */
 226:Source/core/http_client.c ****             }
 227:Source/core/http_client.c ****         }
 228:Source/core/http_client.c ****     }
 229:Source/core/http_client.c **** }
