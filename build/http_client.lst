1096:Source/core/http_client.c **** int hc_get(const char* urlStr, const PlutoHttpCallbacks* cbs)
1097:Source/core/http_client.c **** {
1098:Source/core/http_client.c ****     // Cancel any previous request cleanly.
1099:Source/core/http_client.c ****     hc_cancel();
1100:Source/core/http_client.c ****     // A fresh top-level request starts a new redirect chain and must not be
