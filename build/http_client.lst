 294:src/core/http_client.c **** 
 295:src/core/http_client.c **** static void parse_headers(size_t hEnd)
 296:src/core/http_client.c **** {
 297:src/core/http_client.c ****     size_t headLen = hEnd; // bytes up to (not including) the first \r
 298:src/core/http_client.c ****     s_bodyStart = hEnd + 4;
 299:src/core/http_client.c ****     s_hasBodyStart = 1;
 300:src/core/http_client.c **** 
 301:src/core/http_client.c ****     clear_headers();
 302:src/core/http_client.c ****     s_headers = sm_create(16);
 303:src/core/http_client.c **** 
 304:src/core/http_client.c ****     // Status line: first [^\r\n] run, pattern "HTTP/%d+.%d+ (%d+)".
 305:src/core/http_client.c ****     size_t slEnd = headLen;
 306:src/core/http_client.c ****     for (size_t i = 0; i < headLen; i++)
 307:src/core/http_client.c ****         if (s_buf.data[i] == '\r' || s_buf.data[i] == '\n') { slEnd = i; break; }
 308:src/core/http_client.c ****     if (slEnd > 5 && strncmp(s_buf.data, "HTTP/", 5) == 0) {
 309:src/core/http_client.c ****         size_t i = 5;
