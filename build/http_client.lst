 596:Source/core/http_client.c **** void hc_update(void)
 597:Source/core/http_client.c **** {
 598:Source/core/http_client.c ****     // A deferred redirect (from a prior tick) opens the next connection now,
 599:Source/core/http_client.c ****     // well after the previous connection was fully closed by us.
 600:Source/core/http_client.c ****     if (s_hasPendingRedirect) {
