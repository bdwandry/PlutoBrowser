 532:Source/core/http_client.c **** static void tcp_closed_cb(TCPConnection *conn, PDNetErr err)
 533:Source/core/http_client.c **** {
 534:Source/core/http_client.c ****     (void)conn;
 535:Source/core/http_client.c ****     (void)err;
 536:Source/core/http_client.c ****     /* Stale events from a previous connection are ignored via generation id. */
 537:Source/core/http_client.c ****     if (g_tcp == conn && g_state != HS_IDLE)
 538:Source/core/http_client.c ****     {
 539:Source/core/http_client.c ****         g_connClosed = 1;
 540:Source/core/http_client.c ****     }
 541:Source/core/http_client.c **** }
