 596:Source/core/http_client.c **** 
 597:Source/core/http_client.c **** // requestState == "done": slice the body, attempt chunked decode, hand
 598:Source/core/http_client.c **** // everything to onSuccess after reset() (Lua order preserved).
 599:Source/core/http_client.c **** static void deliver_done(void)
 600:Source/core/http_client.c **** {
 601:Source/core/http_client.c ****     PlutoHttpCallbacks cb = s_cbs;
 602:Source/core/http_client.c ****     int st = s_status;
 603:Source/core/http_client.c ****     char url[HC_URL_MAX];
 604:Source/core/http_client.c ****     memcpy(url, s_url, sizeof(url));
 605:Source/core/http_client.c **** 
 606:Source/core/http_client.c ****     StrBuf body;
 607:Source/core/http_client.c ****     sb_init(&body);
 608:Source/core/http_client.c ****     if (s_backend == HC_BACKEND_HTTP) {
 609:Source/core/http_client.c ****         // HTTP API delivers body directly in deliver_done via request_complete_cb.
 610:Source/core/http_client.c ****         // Body is already fully received and stored in s_buf by the time we get here.
 611:Source/core/http_client.c ****         if (s_buf.len > 0) sb_append(&body, s_buf.data, s_buf.len);
 612:Source/core/http_client.c ****     } else {
 613:Source/core/http_client.c ****         // TCP backend: slice the body from the raw response buffer.
 614:Source/core/http_client.c ****         size_t off = s_hasBodyStart ? s_bodyStart : 0;
 615:Source/core/http_client.c ****         if (s_buf.len > off) sb_append(&body, s_buf.data + off, s_buf.len - off);
 616:Source/core/http_client.c ****         if (s_chunked) {
 617:Source/core/http_client.c ****             StrBuf* dec = decode_chunked(body.data, body.len);
 618:Source/core/http_client.c ****             if (dec) {
 619:Source/core/http_client.c ****                 sb_free(&body);
 620:Source/core/http_client.c ****                 body = *dec;
 621:Source/core/http_client.c ****                 pluto_free(dec);
 622:Source/core/http_client.c ****             }
 623:Source/core/http_client.c ****         }
 624:Source/core/http_client.c ****     }
 625:Source/core/http_client.c **** 
 626:Source/core/http_client.c ****     // Take header ownership away so reset() cannot free what we deliver.
 627:Source/core/http_client.c ****     StrMap* map = s_headers;
 628:Source/core/http_client.c ****     s_headers = NULL;
