 120:Source/core/http_client.c **** // Lua plain tonumber(str): full-string decimal parse (whitespace allowed),
 121:Source/core/http_client.c **** // optional sign, >= 1 digit. "12abc" fails.
 122:Source/core/http_client.c **** static int luatonum10(const char* str, long* out)
 123:Source/core/http_client.c **** {
 124:Source/core/http_client.c ****     if (!str) return 0;
 125:Source/core/http_client.c ****     const char* p = str;
 126:Source/core/http_client.c ****     while (*p && isspace((unsigned char)*p)) p++;
 127:Source/core/http_client.c ****     char* end = NULL;
 128:Source/core/http_client.c ****     long v = strtol(p, &end, 10);
 129:Source/core/http_client.c ****     if (end == p) return 0;
 130:Source/core/http_client.c ****     while (*end && isspace((unsigned char)*end)) end++;
 131:Source/core/http_client.c ****     if (*end != '\0') return 0;
 132:Source/core/http_client.c ****     *out = v;
 133:Source/core/http_client.c ****     return 1;
 134:Source/core/http_client.c **** }
 135:Source/core/http_client.c **** 
 136:Source/core/http_client.c **** // Lua tonumber(trimmed, 16): full-string hex parse, optional leading '-'.
 137:Source/core/http_client.c **** // "5x", "", "0x10" fail; " ff " -> 255; "-4" -> -4.
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccKeS4lK.s 			page 5


 138:Source/core/http_client.c **** static int luatonum16(const char* str, size_t len, long* out)
 139:Source/core/http_client.c **** {
 140:Source/core/http_client.c ****     size_t i = 0;
 141:Source/core/http_client.c ****     while (i < len && isspace((unsigned char)str[i])) i++;
 142:Source/core/http_client.c ****     int neg = 0;
 143:Source/core/http_client.c ****     if (i < len && (str[i] == '+' || str[i] == '-')) {
 144:Source/core/http_client.c ****         neg = (str[i] == '-');
 145:Source/core/http_client.c ****         i++;
 146:Source/core/http_client.c ****     }
 147:Source/core/http_client.c ****     if (i >= len) return 0;
 148:Source/core/http_client.c ****     long v = 0;
 149:Source/core/http_client.c ****     for (; i < len; i++) {
 150:Source/core/http_client.c ****         unsigned char c = (unsigned char)str[i];
 151:Source/core/http_client.c ****         int d;
 152:Source/core/http_client.c ****         if (c >= '0' && c <= '9') d = c - '0';
 153:Source/core/http_client.c ****         else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
 154:Source/core/http_client.c ****         else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
 155:Source/core/http_client.c ****         else return 0;
 156:Source/core/http_client.c ****         v = v * 16 + d;
 157:Source/core/http_client.c ****     }
 158:Source/core/http_client.c ****     *out = neg ? -v : v;
 159:Source/core/http_client.c ****     return 1;
 160:Source/core/http_client.c **** }
