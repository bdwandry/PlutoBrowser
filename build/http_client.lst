1000:Source/core/http_client.c ****     sb_append_str(&headers, "\r\n");
1001:Source/core/http_client.c ****     PDNetErr err = s_http->get(conn, s_parsed.fullPath,
1002:Source/core/http_client.c ****                                headers.data, headers.len);
