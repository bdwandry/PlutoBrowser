 126:Source/core/http_client.c **** // Lua plain tonumber(str): full-string decimal parse (whitespace allowed),
 127:Source/core/http_client.c **** // optional sign, >= 1 digit. "12abc" fails.
 128:Source/core/http_client.c **** static int luatonum10(const char* str, long* out)
 129:Source/core/http_client.c **** {
 130:Source/core/http_client.c ****     if (!str) return 0;
 131:Source/core/http_client.c ****     const char* p = str;
 132:Source/core/http_client.c ****     while (*p && isspace((unsigned char)*p)) p++;
 133:Source/core/http_client.c ****     char* end = NULL;
 134:Source/core/http_client.c ****     long v = strtol(p, &end, 10);
 135:Source/core/http_client.c ****     if (end == p) return 0;
 136:Source/core/http_client.c ****     while (*end && isspace((unsigned char)*end)) end++;
 137:Source/core/http_client.c ****     if (*end != '\0') return 0;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccqN2dXL.s 			page 5


 138:Source/core/http_client.c ****     *out = v;
 139:Source/core/http_client.c ****     return 1;
 140:Source/core/http_client.c **** }
