 950:Source/core/http_client.c **** static void http_request_complete_cb(HTTPConnection* conn)
 951:Source/core/http_client.c **** {
 952:Source/core/http_client.c ****     if (conn != s_http_conn) return;
 953:Source/core/http_client.c ****     PDNetErr err = s_http->getError(conn);
 954:Source/core/http_client.c ****     PLUTO_LOG("[HC] HTTP request complete, err=%d (%s)", err, neterr_name(err));
 955:Source/core/http_client.c ****     // Re-check status here in case headers_read fired before status was ready.
 956:Source/core/http_client.c ****     int st = s_http->getResponseStatus(conn);
 957:Source/core/http_client.c ****     if (st > 0) s_status = st;
 958:Source/core/http_client.c ****     PLUTO_LOG("[HC] HTTP final status=%d", s_status);
 959:Source/core/http_client.c ****     if (err != NET_OK) {
 960:Source/core/http_client.c ****         set_error("HTTP API request failed: %s", neterr_name(err));
 961:Source/core/http_client.c ****         s_state = HC_ERROR;
 962:Source/core/http_client.c ****         return;
 963:Source/core/http_client.c ****     }
 964:Source/core/http_client.c ****     s_connClosed = 1;
 965:Source/core/http_client.c **** }
 966:Source/core/http_client.c **** 
 967:Source/core/http_client.c **** static void http_connection_closed_cb(HTTPConnection* conn)
 968:Source/core/http_client.c **** {
 969:Source/core/http_client.c ****     if (conn != s_http_conn) return;
 970:Source/core/http_client.c ****     PLUTO_LOG("[HC] HTTP connection closed");
 971:Source/core/http_client.c ****     s_connClosed = 1;
 972:Source/core/http_client.c **** }
