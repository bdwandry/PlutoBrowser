 208:src/core/http_client.c **** static void store_header(const char* key, size_t keyLen, const char* val,
 209:src/core/http_client.c ****                          size_t valLen)
 210:src/core/http_client.c **** {
 211:src/core/http_client.c ****     char lower[128];
