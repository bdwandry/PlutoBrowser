 887:Source/core/http_client.c **** // ── HTTP API callbacks ───────────────────────�
 888:Source/core/http_client.c **** // The native HTTP API fires these callbacks asynchronously. The HTTP API
 889:Source/core/http_client.c **** // handles TLS negotiation, HTTP request formatting, and status/header parsing
 890:Source/core/http_client.c **** // internally — we just receive the parsed results.
 891:Source/core/http_client.c **** 
 892:Source/core/http_client.c **** static void http_header_received_cb(HTTPConnection* conn, const char* key,
 893:Source/core/http_client.c ****                                     const char* value)
 894:Source/core/http_client.c **** {
 895:Source/core/http_client.c ****     if (conn != s_http_conn) return;
 896:Source/core/http_client.c ****     if (key && key[0]) {
 897:Source/core/http_client.c ****         PLUTO_LOG("[HC] HTTP header: %s = %s", key, value ? value : "(null)");
 898:Source/core/http_client.c ****         store_header(key, strlen(key), value,
 899:Source/core/http_client.c ****                      value ? strlen(value) : 0);
 900:Source/core/http_client.c ****     }
 901:Source/core/http_client.c **** }
 902:Source/core/http_client.c **** 
 903:Source/core/http_client.c **** static void http_headers_read_cb(HTTPConnection* conn)
 904:Source/core/http_client.c **** {
 905:Source/core/http_client.c ****     if (conn != s_http_conn) return;
 906:Source/core/http_client.c ****     s_status = s_http->getResponseStatus(conn);
 907:Source/core/http_client.c ****     PLUTO_LOG("[HC] HTTP headers read, status=%d", s_status);
 908:Source/core/http_client.c ****     // Extract content-length for progress tracking.
 909:Source/core/http_client.c ****     const char* cl = s_headers ? (const char*)sm_get(s_headers, "content-length") : NULL;
 910:Source/core/http_client.c ****     if (cl) {
 911:Source/core/http_client.c ****         long v = strtol(cl, NULL, 10);
 912:Source/core/http_client.c ****         if (v > 0) s_contentLength = v;
 913:Source/core/http_client.c ****     }
 914:Source/core/http_client.c ****     // For HTTP backend, detect redirects in-band here (TCP does it in hc_update).
 915:Source/core/http_client.c ****     // On the simulator, getResponseStatus() may return 0; if we have a Location
 916:Source/core/http_client.c ****     // header, that's strong evidence of a redirect even without the status code.
 917:Source/core/http_client.c ****     int is_redirect = (s_status >= 300 && s_status < 400);
 918:Source/core/http_client.c ****     if (!is_redirect && s_status == 0) {
 919:Source/core/http_client.c ****         const char* loc_check = s_headers
 920:Source/core/http_client.c ****                                     ? (const char*)sm_get(s_headers, "location")
 921:Source/core/http_client.c ****                                     : NULL;
 922:Source/core/http_client.c ****         if (loc_check && loc_check[0]) is_redirect = 1;
 923:Source/core/http_client.c ****     }
 924:Source/core/http_client.c ****     if (is_redirect) {
 925:Source/core/http_client.c ****         const char* loc = s_headers
 926:Source/core/http_client.c ****                               ? (const char*)sm_get(s_headers, "location")
 927:Source/core/http_client.c ****                               : NULL;
 928:Source/core/http_client.c ****         if (loc && loc[0]) {
 929:Source/core/http_client.c ****             s_redirectDepth++;
 930:Source/core/http_client.c ****             if (s_redirectDepth <= HC_MAX_REDIRECTS) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc0iLB6y.s 			page 32


 931:Source/core/http_client.c ****                 StrBuf abs;
 932:Source/core/http_client.c ****                 sb_init(&abs);
 933:Source/core/http_client.c ****                 url_resolve(s_url, loc, &abs);
 934:Source/core/http_client.c ****                 snprintf(s_pendingUrl, sizeof(s_pendingUrl), "%s",
 935:Source/core/http_client.c ****                          abs.data ? abs.data : "");
 936:Source/core/http_client.c ****                 sb_free(&abs);
 937:Source/core/http_client.c ****                 s_pendingCbs = s_cbs;
 938:Source/core/http_client.c ****                 s_hasPendingRedirect = 1;
 939:Source/core/http_client.c ****             } else {
 940:Source/core/http_client.c ****                 set_error("Too many redirects to %s", s_url);
 941:Source/core/http_client.c ****                 s_state = HC_ERROR;
 942:Source/core/http_client.c ****             }
 943:Source/core/http_client.c ****             PLUTO_LOG("[HC] HTTP redirect to %s (status=%d)", s_pendingUrl, s_status);
 944:Source/core/http_client.c ****             reset();
 945:Source/core/http_client.c ****             return;
 946:Source/core/http_client.c ****         }
 947:Source/core/http_client.c ****     }
 948:Source/core/http_client.c **** }
