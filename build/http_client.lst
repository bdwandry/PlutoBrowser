 622:Source/core/http_client.c ****         // HTTP API delivers body directly in deliver_done via request_complete_cb.
 623:Source/core/http_client.c ****         // Body is already fully received and stored in s_buf by the time we get here.
 624:Source/core/http_client.c ****         if (s_buf.len > 0) sb_append(&body, s_buf.data, s_buf.len);
 625:Source/core/http_client.c ****     } else {
