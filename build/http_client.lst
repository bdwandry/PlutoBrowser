 404:Source/core/http_client.c ****         statusLine[llen] = '\0';
 405:Source/core/http_client.c ****         const char *sp = strstr(statusLine, " ");
 406:Source/core/http_client.c ****         if (sp)
 407:Source/core/http_client.c ****         {
 408:Source/core/http_client.c ****             /* Lua: tonumber(match("HTTP/%d+%.%d+ (%d+)")) — the HTTP/x.y
 409:Source/core/http_client.c ****              * prefix is REQUIRED; anything else keeps the 200 default. */
 410:Source/core/http_client.c ****             int vmaj = 0, vmin = 0, st = 0;
