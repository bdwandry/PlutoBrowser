 280:Source/core/http_client.c **** /* Decode a chunked-encoded body. Returns a malloc'd string while the chunk
 281:Source/core/http_client.c ****  * stream is complete, NULL while still incomplete (caller keeps buffering). */
 282:Source/core/http_client.c **** static char *decode_chunked(const char *str, size_t len, size_t *outLen)
 283:Source/core/http_client.c **** {
 284:Source/core/http_client.c ****     StrBuf body;
 285:Source/core/http_client.c ****     if (strbuf_init(&body) != 0)
 286:Source/core/http_client.c ****     {
 287:Source/core/http_client.c ****         return NULL;
 288:Source/core/http_client.c ****     }
 289:Source/core/http_client.c ****     if (outLen)
 290:Source/core/http_client.c ****     {
 291:Source/core/http_client.c ****         *outLen = 0;
 292:Source/core/http_client.c ****     }
 293:Source/core/http_client.c ****     size_t pos = 0;
 294:Source/core/http_client.c ****     for (;;)
 295:Source/core/http_client.c ****     {
 296:Source/core/http_client.c ****         const char *crlf = NULL;
 297:Source/core/http_client.c ****         for (size_t i = pos; i + 1 < len; i++)
 298:Source/core/http_client.c ****         {
 299:Source/core/http_client.c ****             if (str[i] == '\r' && str[i + 1] == '\n')
 300:Source/core/http_client.c ****             {
 301:Source/core/http_client.c ****                 crlf = &str[i];
 302:Source/core/http_client.c ****                 break;
 303:Source/core/http_client.c ****             }
 304:Source/core/http_client.c ****         }
 305:Source/core/http_client.c ****         if (!crlf)
 306:Source/core/http_client.c ****         {
 307:Source/core/http_client.c ****             strbuf_free(&body);
 308:Source/core/http_client.c ****             return NULL; /* incomplete size line */
 309:Source/core/http_client.c ****         }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc6Mf7GV.s 			page 15


 310:Source/core/http_client.c ****         char sizeStr[32];
 311:Source/core/http_client.c ****         size_t n = (size_t)(crlf - &str[pos]);
 312:Source/core/http_client.c ****         if (n >= sizeof(sizeStr))
 313:Source/core/http_client.c ****         {
 314:Source/core/http_client.c ****             n = sizeof(sizeStr) - 1;
 315:Source/core/http_client.c ****         }
 316:Source/core/http_client.c ****         memcpy(sizeStr, &str[pos], n);
 317:Source/core/http_client.c ****         sizeStr[n] = '\0';
 318:Source/core/http_client.c ****         char *semi = strchr(sizeStr, ';');
 319:Source/core/http_client.c ****         if (semi)
 320:Source/core/http_client.c ****         {
 321:Source/core/http_client.c ****             *semi = '\0';
 322:Source/core/http_client.c ****         }
 323:Source/core/http_client.c ****         /* Lua ^%s*(.-)%s*$ trim */
 324:Source/core/http_client.c ****         char *s = sizeStr;
 325:Source/core/http_client.c ****         while (*s == ' ' || *s == '\t') s++;
 326:Source/core/http_client.c ****         char *e = s + strlen(s);
 327:Source/core/http_client.c ****         while (e > s && (e[-1] == ' ' || e[-1] == '\t')) e--;
 328:Source/core/http_client.c ****         *e = '\0';
 329:Source/core/http_client.c **** 
 330:Source/core/http_client.c ****         long size = strtol(s, NULL, 16);
 331:Source/core/http_client.c ****         if (size < 0)
 332:Source/core/http_client.c ****         {
 333:Source/core/http_client.c ****             strbuf_free(&body);
 334:Source/core/http_client.c ****             return NULL;
 335:Source/core/http_client.c ****         }
 336:Source/core/http_client.c ****         pos = (size_t)(crlf - str) + 2;
 337:Source/core/http_client.c ****         if (size == 0)
 338:Source/core/http_client.c ****         {
 339:Source/core/http_client.c ****             if (outLen)
 340:Source/core/http_client.c ****             {
 341:Source/core/http_client.c ****                 *outLen = body.len;
 342:Source/core/http_client.c ****             }
 343:Source/core/http_client.c ****             return strbuf_detach(&body);
 344:Source/core/http_client.c ****         }
 345:Source/core/http_client.c ****         if (len < pos + (size_t)size + 2)
 346:Source/core/http_client.c ****         {
 347:Source/core/http_client.c ****             strbuf_free(&body);
 348:Source/core/http_client.c ****             return NULL; /* incomplete chunk */
 349:Source/core/http_client.c ****         }
 350:Source/core/http_client.c ****         strbuf_append_n(&body, &str[pos], (size_t)size);
 351:Source/core/http_client.c ****         pos += (size_t)size + 2;
 352:Source/core/http_client.c ****     }
 353:Source/core/http_client.c **** }
