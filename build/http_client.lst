 787:Source/core/http_client.c ****                 s_redirectDepth++;
 788:Source/core/http_client.c ****                 if (s_redirectDepth <= HC_MAX_REDIRECTS) {
 789:Source/core/http_client.c ****                     StrBuf abs;
