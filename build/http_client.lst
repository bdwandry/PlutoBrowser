 686:Source/core/http_client.c ****     unsigned now = hc_now();
 687:Source/core/http_client.c **** 
 688:Source/core/http_client.c ****     // For HTTP backend: headers_read_cb fires when status/headers arrive,
 689:Source/core/http_client.c ****     // meaning the connection is established and data is flowing.
 690:Source/core/http_client.c ****     if (s_state == HC_CONNECTING && s_backend == HC_BACKEND_HTTP &&
