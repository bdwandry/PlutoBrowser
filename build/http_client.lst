 368:Source/core/http_client.c **** /* Parse the status line and headers once "\r\n\r\n" has arrived.
 369:Source/core/http_client.c ****  * Fills the SAVED header table (the done path consumes it after reset). */
 370:Source/core/http_client.c **** static int parse_headers_saved(void)
 371:Source/core/http_client.c **** {
 372:Source/core/http_client.c ****     const char *buf = g_buf.data;
 373:Source/core/http_client.c ****     size_t blen = g_buf.len;
 374:Source/core/http_client.c ****     const char *hEnd = NULL;
 375:Source/core/http_client.c ****     for (size_t i = 0; i + 3 < blen; i++)
 376:Source/core/http_client.c ****     {
 377:Source/core/http_client.c ****         if (buf[i] == '\r' && buf[i + 1] == '\n' &&
 378:Source/core/http_client.c ****             buf[i + 2] == '\r' && buf[i + 3] == '\n')
 379:Source/core/http_client.c ****         {
 380:Source/core/http_client.c ****             hEnd = &buf[i];
 381:Source/core/http_client.c ****             break;
 382:Source/core/http_client.c ****         }
 383:Source/core/http_client.c ****     }
 384:Source/core/http_client.c ****     if (!hEnd)
 385:Source/core/http_client.c ****     {
 386:Source/core/http_client.c ****         return 0;
 387:Source/core/http_client.c ****     }
 388:Source/core/http_client.c **** 
 389:Source/core/http_client.c ****     g_savedHeaderCount = 0;
 390:Source/core/http_client.c ****     g_isChunked = 0;
 391:Source/core/http_client.c ****     g_contentLength = -1;
 392:Source/core/http_client.c ****     g_status = 200;
 393:Source/core/http_client.c **** 
 394:Source/core/http_client.c ****     /* Status line: first line. Lua: tonumber(match("HTTP/%d+%.%d+ (%d+)")) */
 395:Source/core/http_client.c ****     {
 396:Source/core/http_client.c ****         const char *lineEnd = memchr(buf, '\n', (size_t)(hEnd - buf));
 397:Source/core/http_client.c ****         size_t llen = lineEnd ? (size_t)(lineEnd - buf) : (size_t)(hEnd - buf);
 398:Source/core/http_client.c ****         char statusLine[128];
 399:Source/core/http_client.c ****         if (llen >= sizeof(statusLine))
 400:Source/core/http_client.c ****         {
 401:Source/core/http_client.c ****             llen = sizeof(statusLine) - 1;
 402:Source/core/http_client.c ****         }
 403:Source/core/http_client.c ****         memcpy(statusLine, buf, llen);
 404:Source/core/http_client.c ****         statusLine[llen] = '\0';
 405:Source/core/http_client.c ****         const char *sp = strstr(statusLine, " ");
 406:Source/core/http_client.c ****         if (sp)
 407:Source/core/http_client.c ****         {
 408:Source/core/http_client.c ****             /* Lua: tonumber(match("HTTP/%d+%.%d+ (%d+)")) — the HTTP/x.y
 409:Source/core/http_client.c ****              * prefix is REQUIRED; anything else keeps the 200 default. */
 410:Source/core/http_client.c ****             int vmaj = 0, vmin = 0, st = 0;
 411:Source/core/http_client.c ****             if (sscanf(statusLine, "HTTP/%d.%d %d", &vmaj, &vmin, &st) == 3 && st > 0)
 412:Source/core/http_client.c ****             {
 413:Source/core/http_client.c ****                 g_status = st;
 414:Source/core/http_client.c ****             }
 415:Source/core/http_client.c ****             (void)sp;
 416:Source/core/http_client.c ****         }
 417:Source/core/http_client.c ****     }
 418:Source/core/http_client.c **** 
 419:Source/core/http_client.c ****     /* Collect set-cookie values (need the host at call time).
 420:Source/core/http_client.c ****      * BSS, not stack — 16×512B would sit under parse_headers_saved's caller
 421:Source/core/http_client.c ****      * every frame a header parse runs (P22 stack rule). */
 422:Source/core/http_client.c ****     char (*setCookies)[512] = g_setCookies;
 423:Source/core/http_client.c ****     int setCookieCount = 0;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc6Mf7GV.s 			page 17


 424:Source/core/http_client.c **** 
 425:Source/core/http_client.c ****     const char *firstNl = (const char *)memchr(buf, '\n', blen);
 426:Source/core/http_client.c ****     size_t lineStart = firstNl ? (size_t)(firstNl - buf) + 1 : 0;
 427:Source/core/http_client.c ****     while (lineStart < (size_t)(hEnd - buf) &&
 428:Source/core/http_client.c ****            g_savedHeaderCount < 62 && setCookieCount < 16)
 429:Source/core/http_client.c ****     {
 430:Source/core/http_client.c ****         size_t lineEnd = lineStart;
 431:Source/core/http_client.c ****         while (lineEnd < (size_t)(hEnd - buf) && buf[lineEnd] != '\n')
 432:Source/core/http_client.c ****         {
 433:Source/core/http_client.c ****             lineEnd++;
 434:Source/core/http_client.c ****         }
 435:Source/core/http_client.c ****         size_t llen = lineEnd - lineStart;
 436:Source/core/http_client.c ****         if (llen > 0 && buf[lineStart + llen - 1] == '\r')
 437:Source/core/http_client.c ****         {
 438:Source/core/http_client.c ****             llen--;
 439:Source/core/http_client.c ****         }
 440:Source/core/http_client.c ****         if (llen == 0 || llen >= sizeof(g_hdrLine))
 441:Source/core/http_client.c ****         {
 442:Source/core/http_client.c ****             lineStart = lineEnd + 1;
 443:Source/core/http_client.c ****             continue;
 444:Source/core/http_client.c ****         }
 445:Source/core/http_client.c ****         memcpy(g_hdrLine, &buf[lineStart], llen);
 446:Source/core/http_client.c ****         g_hdrLine[llen] = '\0';
 447:Source/core/http_client.c **** 
 448:Source/core/http_client.c ****         /* Lua ^%s*([^:]+)%s*:%s*(.-)%s*$ */
 449:Source/core/http_client.c ****         char *colon = strchr(g_hdrLine, ':');
 450:Source/core/http_client.c ****         if (colon)
 451:Source/core/http_client.c ****         {
 452:Source/core/http_client.c ****             *colon = '\0';
 453:Source/core/http_client.c ****             char *k = g_hdrLine;
 454:Source/core/http_client.c ****             while (*k == ' ' || *k == '\t') k++;
 455:Source/core/http_client.c ****             char *kend = k + strlen(k);
 456:Source/core/http_client.c ****             while (kend > k && (kend[-1] == ' ' || kend[-1] == '\t')) kend--;
 457:Source/core/http_client.c ****             *kend = '\0';
 458:Source/core/http_client.c ****             char *v = colon + 1;
 459:Source/core/http_client.c ****             while (*v == ' ' || *v == '\t') v++;
 460:Source/core/http_client.c ****             char *vend = v + strlen(v);
 461:Source/core/http_client.c ****             while (vend > v && (vend[-1] == ' ' || vend[-1] == '\t')) vend--;
 462:Source/core/http_client.c ****             *vend = '\0';
 463:Source/core/http_client.c **** 
 464:Source/core/http_client.c ****             if (k[0] != '\0' && v[0] != '\0')
 465:Source/core/http_client.c ****             {
 466:Source/core/http_client.c ****                 if (strcasecmp(k, "set-cookie") == 0)
 467:Source/core/http_client.c ****                 {
 468:Source/core/http_client.c ****                     strncpy(setCookies[setCookieCount], v, 511);
 469:Source/core/http_client.c ****                     setCookies[setCookieCount][511] = '\0';
 470:Source/core/http_client.c ****                     setCookieCount++;
 471:Source/core/http_client.c ****                 }
 472:Source/core/http_client.c ****                 else if (g_savedHeaderCount < 62)
 473:Source/core/http_client.c ****                 {
 474:Source/core/http_client.c ****                     size_t klen = strlen(k);
 475:Source/core/http_client.c ****                     if (klen > 255)
 476:Source/core/http_client.c ****                     {
 477:Source/core/http_client.c ****                         klen = 255;
 478:Source/core/http_client.c ****                     }
 479:Source/core/http_client.c ****                     memcpy(g_savedHeaders[g_savedHeaderCount][0], k, klen);
 480:Source/core/http_client.c ****                     g_savedHeaders[g_savedHeaderCount][0][klen] = '\0';
