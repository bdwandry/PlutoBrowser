 109:Source/core/http_client.c **** static const char* memfind(const char* hay, size_t hayLen, const char* needle,
 110:Source/core/http_client.c ****                            size_t nLen)
 111:Source/core/http_client.c **** {
 112:Source/core/http_client.c ****     if (nLen == 0) return hay;
 113:Source/core/http_client.c ****     if (hay == NULL || hayLen < nLen) return NULL;
 114:Source/core/http_client.c ****     for (size_t i = 0; i + nLen <= hayLen; i++)
 115:Source/core/http_client.c ****         if (hay[i] == needle[0] && memcmp(hay + i, needle, nLen) == 0)
 116:Source/core/http_client.c ****             return hay + i;
 117:Source/core/http_client.c ****     return NULL;
 118:Source/core/http_client.c **** }
