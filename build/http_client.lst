 874:Source/core/http_client.c **** // ── HTTP API callbacks ───────────────────────�
 875:Source/core/http_client.c **** // The native HTTP API fires these callbacks asynchronously. The HTTP API
 876:Source/core/http_client.c **** // handles TLS negotiation, HTTP request formatting, and status/header parsing
 877:Source/core/http_client.c **** // internally — we just receive the parsed results.
 878:Source/core/http_client.c **** 
 879:Source/core/http_client.c **** static void http_header_received_cb(HTTPConnection* conn, const char* key,
 880:Source/core/http_client.c ****                                     const char* value)
 881:Source/core/http_client.c **** {
 882:Source/core/http_client.c ****     if (conn != s_http_conn) return;
 883:Source/core/http_client.c ****     if (key && key[0]) {
 884:Source/core/http_client.c ****         PLUTO_LOG("[HC] HTTP header: %s = %s", key, value ? value : "(null)");
 885:Source/core/http_client.c ****         store_header(key, strlen(key), value,
 886:Source/core/http_client.c ****                      value ? strlen(value) : 0);
 887:Source/core/http_client.c ****     }
 888:Source/core/http_client.c **** }
 889:Source/core/http_client.c **** 
 890:Source/core/http_client.c **** static void http_headers_read_cb(HTTPConnection* conn)
 891:Source/core/http_client.c **** {
 892:Source/core/http_client.c ****     if (conn != s_http_conn) return;
 893:Source/core/http_client.c ****     s_status = s_http->getResponseStatus(conn);
 894:Source/core/http_client.c ****     PLUTO_LOG("[HC] HTTP headers read, status=%d", s_status);
 895:Source/core/http_client.c ****     // Extract content-length for progress tracking.
 896:Source/core/http_client.c ****     const char* cl = s_headers ? (const char*)sm_get(s_headers, "content-length") : NULL;
 897:Source/core/http_client.c ****     if (cl) {
 898:Source/core/http_client.c ****         long v = strtol(cl, NULL, 10);
 899:Source/core/http_client.c ****         if (v > 0) s_contentLength = v;
 900:Source/core/http_client.c ****     }
 901:Source/core/http_client.c ****     // For HTTP backend, detect redirects in-band here (TCP does it in hc_update).
 902:Source/core/http_client.c ****     // On the simulator, getResponseStatus() may return 0; if we have a Location
 903:Source/core/http_client.c ****     // header, that's strong evidence of a redirect even without the status code.
 904:Source/core/http_client.c ****     int is_redirect = (s_status >= 300 && s_status < 400);
 905:Source/core/http_client.c ****     if (!is_redirect && s_status == 0) {
 906:Source/core/http_client.c ****         const char* loc_check = s_headers
 907:Source/core/http_client.c ****                                     ? (const char*)sm_get(s_headers, "location")
 908:Source/core/http_client.c ****                                     : NULL;
 909:Source/core/http_client.c ****         if (loc_check && loc_check[0]) is_redirect = 1;
 910:Source/core/http_client.c ****     }
 911:Source/core/http_client.c ****     if (is_redirect) {
 912:Source/core/http_client.c ****         const char* loc = s_headers
 913:Source/core/http_client.c ****                               ? (const char*)sm_get(s_headers, "location")
 914:Source/core/http_client.c ****                               : NULL;
 915:Source/core/http_client.c ****         if (loc && loc[0]) {
 916:Source/core/http_client.c ****             s_redirectDepth++;
 917:Source/core/http_client.c ****             if (s_redirectDepth <= HC_MAX_REDIRECTS) {
 918:Source/core/http_client.c ****                 StrBuf abs;
 919:Source/core/http_client.c ****                 sb_init(&abs);
 920:Source/core/http_client.c ****                 url_resolve(s_url, loc, &abs);
 921:Source/core/http_client.c ****                 snprintf(s_pendingUrl, sizeof(s_pendingUrl), "%s",
 922:Source/core/http_client.c ****                          abs.data ? abs.data : "");
 923:Source/core/http_client.c ****                 sb_free(&abs);
 924:Source/core/http_client.c ****                 s_pendingCbs = s_cbs;
 925:Source/core/http_client.c ****                 s_hasPendingRedirect = 1;
 926:Source/core/http_client.c ****             } else {
 927:Source/core/http_client.c ****                 set_error("Too many redirects to %s", s_url);
 928:Source/core/http_client.c ****                 s_state = HC_ERROR;
 929:Source/core/http_client.c ****             }
 930:Source/core/http_client.c ****             PLUTO_LOG("[HC] HTTP redirect to %s (status=%d)", s_pendingUrl, s_status);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccqN2dXL.s 			page 32


 931:Source/core/http_client.c ****             reset();
 932:Source/core/http_client.c ****             return;
 933:Source/core/http_client.c ****         }
 934:Source/core/http_client.c ****     }
 935:Source/core/http_client.c **** }
 936:Source/core/http_client.c **** 
 937:Source/core/http_client.c **** static void http_request_complete_cb(HTTPConnection* conn)
 938:Source/core/http_client.c **** {
 939:Source/core/http_client.c ****     if (conn != s_http_conn) return;
 940:Source/core/http_client.c ****     PDNetErr err = s_http->getError(conn);
 941:Source/core/http_client.c ****     PLUTO_LOG("[HC] HTTP request complete, err=%d (%s)", err, neterr_name(err));
 942:Source/core/http_client.c ****     // Re-check status here in case headers_read fired before status was ready.
 943:Source/core/http_client.c ****     int st = s_http->getResponseStatus(conn);
 944:Source/core/http_client.c ****     if (st > 0) s_status = st;
 945:Source/core/http_client.c ****     PLUTO_LOG("[HC] HTTP final status=%d", s_status);
 946:Source/core/http_client.c ****     if (err != NET_OK) {
 947:Source/core/http_client.c ****         set_error("HTTP API request failed: %s", neterr_name(err));
 948:Source/core/http_client.c ****         s_state = HC_ERROR;
 949:Source/core/http_client.c ****         return;
 950:Source/core/http_client.c ****     }
 951:Source/core/http_client.c ****     s_connClosed = 1;
 952:Source/core/http_client.c **** }
 953:Source/core/http_client.c **** 
 954:Source/core/http_client.c **** static void http_connection_closed_cb(HTTPConnection* conn)
 955:Source/core/http_client.c **** {
 956:Source/core/http_client.c ****     if (conn != s_http_conn) return;
 957:Source/core/http_client.c ****     PLUTO_LOG("[HC] HTTP connection closed");
 958:Source/core/http_client.c ****     s_connClosed = 1;
 959:Source/core/http_client.c **** }
