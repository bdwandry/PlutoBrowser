 744:Source/core/http_client.c ****                         cur = (long)s_buf.len - (long)s_bodyStart;
 745:Source/core/http_client.c ****                         if (cur < 0) cur = 0;
 746:Source/core/http_client.c ****                         if (tot > 0 && cur > tot) cur = tot;
 747:Source/core/http_client.c ****                     }
 748:Source/core/http_client.c ****                     if (s_cbs.onProgress)
 749:Source/core/http_client.c ****                         s_cbs.onProgress(s_cbs.ud, (int)cur, (int)tot);
 750:Source/core/http_client.c ****                 }
 751:Source/core/http_client.c ****             }
 752:Source/core/http_client.c ****         } else if (s_backend == HC_BACKEND_HTTP && s_http_conn) {
 753:Source/core/http_client.c ****             // Drain all buffered data in a loop: the SDK may buffer more
 754:Source/core/http_client.c ****             // data between frames or fire request_complete before all data
 755:Source/core/http_client.c ****             // is read.
 756:Source/core/http_client.c ****             size_t avail;
 757:Source/core/http_client.c ****             int n;
 758:Source/core/http_client.c ****             do {
 759:Source/core/http_client.c ****                 avail = s_http->getBytesAvailable(s_http_conn);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccqN2dXL.s 			page 29


 760:Source/core/http_client.c ****                 if (avail == 0) break;
 761:Source/core/http_client.c ****                 size_t want = avail < HC_READ_CHUNK ? avail : HC_READ_CHUNK;
 762:Source/core/http_client.c ****                 n = s_http->read(s_http_conn, pumpTmp, (int)want);
 763:Source/core/http_client.c ****                 if (n <= 0) break;
 764:Source/core/http_client.c ****                 if (s_buf.len < HC_MAX_RESPONSE_SIZE)
 765:Source/core/http_client.c ****                     sb_append(&s_buf, pumpTmp, (size_t)n);
 766:Source/core/http_client.c ****                 long tot = s_contentLength >= 0 ? s_contentLength : 0;
 767:Source/core/http_client.c ****                 long cur = (long)s_buf.len;
 768:Source/core/http_client.c ****                 if (tot > 0 && cur > tot) cur = tot;
 769:Source/core/http_client.c ****                 if (s_cbs.onProgress)
 770:Source/core/http_client.c ****                     s_cbs.onProgress(s_cbs.ud, (int)cur, (int)tot);
 771:Source/core/http_client.c ****             } while (1);
