 551:Source/core/http_client.c **** // ── Delivery ──────────────────────────�
 552:Source/core/http_client.c **** 
 553:Source/core/http_client.c **** // requestState == "done": slice the body, attempt chunked decode, hand
 554:Source/core/http_client.c **** // everything to onSuccess after reset() (Lua order preserved).
 555:Source/core/http_client.c **** static void deliver_done(void)
 556:Source/core/http_client.c **** {
 557:Source/core/http_client.c ****     PlutoHttpCallbacks cb = s_cbs;
 558:Source/core/http_client.c ****     int st = s_status;
 559:Source/core/http_client.c ****     char url[HC_URL_MAX];
 560:Source/core/http_client.c ****     memcpy(url, s_url, sizeof(url));
 561:Source/core/http_client.c **** 
 562:Source/core/http_client.c ****     StrBuf body;
 563:Source/core/http_client.c ****     sb_init(&body);
 564:Source/core/http_client.c ****     size_t off = s_hasBodyStart ? s_bodyStart : 0;
 565:Source/core/http_client.c ****     if (s_buf.len > off) sb_append(&body, s_buf.data + off, s_buf.len - off);
 566:Source/core/http_client.c ****     if (s_chunked) {
 567:Source/core/http_client.c ****         StrBuf* dec = decode_chunked(body.data, body.len);
 568:Source/core/http_client.c ****         if (dec) {
 569:Source/core/http_client.c ****             sb_free(&body);
 570:Source/core/http_client.c ****             body = *dec;
 571:Source/core/http_client.c ****             pluto_free(dec);
 572:Source/core/http_client.c ****         }
 573:Source/core/http_client.c ****     }
 574:Source/core/http_client.c **** 
 575:Source/core/http_client.c ****     // Take header ownership away so reset() cannot free what we deliver.
 576:Source/core/http_client.c ****     StrMap* map = s_headers;
 577:Source/core/http_client.c ****     s_headers = NULL;
 578:Source/core/http_client.c ****     char* vals[HC_MAX_HDRS];
 579:Source/core/http_client.c ****     size_t nVals = s_nHdrVals;
 580:Source/core/http_client.c ****     memcpy(vals, s_hdrVals, nVals * sizeof(char*));
 581:Source/core/http_client.c ****     s_nHdrVals = 0;
 582:Source/core/http_client.c **** 
 583:Source/core/http_client.c ****     reset();
 584:Source/core/http_client.c **** 
 585:Source/core/http_client.c ****     if (cb.onSuccess)
 586:Source/core/http_client.c ****         cb.onSuccess(cb.ud, st, map, body.data ? body.data : "", body.len,
 587:Source/core/http_client.c ****                      url);
 588:Source/core/http_client.c **** 
 589:Source/core/http_client.c ****     for (size_t i = 0; i < nVals; i++) pluto_free(vals[i]);
 590:Source/core/http_client.c ****     sm_destroy(map);
 591:Source/core/http_client.c ****     sb_free(&body);
 592:Source/core/http_client.c **** }
