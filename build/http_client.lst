 115:Source/core/http_client.c **** static const char* memfind(const char* hay, size_t hayLen, const char* needle,
 116:Source/core/http_client.c ****                            size_t nLen)
 117:Source/core/http_client.c **** {
 118:Source/core/http_client.c ****     if (nLen == 0) return hay;
 119:Source/core/http_client.c ****     if (hay == NULL || hayLen < nLen) return NULL;
 120:Source/core/http_client.c ****     for (size_t i = 0; i + nLen <= hayLen; i++)
 121:Source/core/http_client.c ****         if (hay[i] == needle[0] && memcmp(hay + i, needle, nLen) == 0)
 122:Source/core/http_client.c ****             return hay + i;
 123:Source/core/http_client.c ****     return NULL;
 124:Source/core/http_client.c **** }
