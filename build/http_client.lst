 109:src/core/http_client.c **** static const char* memfind(const char* hay, size_t hayLen, const char* needle,
 110:src/core/http_client.c ****                            size_t nLen)
 111:src/core/http_client.c **** {
 112:src/core/http_client.c ****     if (nLen == 0) return hay;
 113:src/core/http_client.c ****     if (hay == NULL || hayLen < nLen) return NULL;
 114:src/core/http_client.c ****     for (size_t i = 0; i + nLen <= hayLen; i++)
 115:src/core/http_client.c ****         if (hay[i] == needle[0] && memcmp(hay + i, needle, nLen) == 0)
 116:src/core/http_client.c ****             return hay + i;
 117:src/core/http_client.c ****     return NULL;
 118:src/core/http_client.c **** }
