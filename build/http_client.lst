 236:Source/core/http_client.c **** 
 237:Source/core/http_client.c **** static void build_request(const PlutoUrl* parsed, StrBuf* out)
 238:Source/core/http_client.c **** {
 239:Source/core/http_client.c ****     sb_printf(out, "GET %s HTTP/1.1\r\n", parsed->fullPath);
 240:Source/core/http_client.c ****     // Lua rule verbatim (port 0 is truthy there): any port other than
 241:Source/core/http_client.c ****     // 80/443 is shown — including the parse("") -> blank:0 quirk.
 242:Source/core/http_client.c ****     if (parsed->port != 80 && parsed->port != 443)
 243:Source/core/http_client.c ****         sb_printf(out, "Host: %s:%d\r\n", parsed->host, parsed->port);
 244:Source/core/http_client.c ****     else
 245:Source/core/http_client.c ****         sb_printf(out, "Host: %s\r\n", parsed->host);
 246:Source/core/http_client.c ****     sb_append_str(out, "User-Agent: CometBrowser/1.0 (Playdate)\r\n");
 247:Source/core/http_client.c ****     sb_append_str(out, "Accept: text/html,text/plain;q=0.8\r\n");
 248:Source/core/http_client.c ****     sb_append_str(out, "Accept-Language: en-US,en;q=0.9\r\n");
 249:Source/core/http_client.c ****     StrBuf cookie;
 250:Source/core/http_client.c ****     sb_init(&cookie);
 251:Source/core/http_client.c ****     cj_get_header(parsed->host, parsed->path, parsed->isSsl, &cookie);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccKeS4lK.s 			page 7


 252:Source/core/http_client.c ****     if (cookie.len > 0) {
 253:Source/core/http_client.c ****         sb_append_str(out, "Cookie: ");
 254:Source/core/http_client.c ****         sb_append(out, cookie.data, cookie.len);
 255:Source/core/http_client.c ****         sb_append_str(out, "\r\n");
 256:Source/core/http_client.c ****     }
 257:Source/core/http_client.c ****     sb_free(&cookie);
 258:Source/core/http_client.c ****     sb_append_str(out, "Connection: close\r\n");
 259:Source/core/http_client.c ****     sb_append_str(out, "\r\n");
 260:Source/core/http_client.c **** }
