 728:Source/core/http_client.c ****     // Pump incoming data. The staging buffer is static: the SDK update loop
 729:Source/core/http_client.c ****     // is single-threaded and 32 KiB would blow the 60 KiB app stack.
 730:Source/core/http_client.c ****     // For TCP: read manually from socket. For HTTP: read from HTTP API.
 731:Source/core/http_client.c ****     if (s_state == HC_READING) {
 732:Source/core/http_client.c ****         static char pumpTmp[HC_READ_CHUNK];
 733:Source/core/http_client.c ****         if (s_backend == HC_BACKEND_TCP && s_conn && s_connOpen) {
 734:Source/core/http_client.c ****             size_t avail = s_tcp->getBytesAvailable(s_conn);
 735:Source/core/http_client.c ****             if (avail > 0) {
 736:Source/core/http_client.c ****                 size_t want = avail < HC_READ_CHUNK ? avail : HC_READ_CHUNK;
 737:Source/core/http_client.c ****                 int n = s_tcp->read(s_conn, pumpTmp, want);
 738:Source/core/http_client.c ****                 if (n > 0) {
 739:Source/core/http_client.c ****                     if (s_buf.len < HC_MAX_RESPONSE_SIZE)
 740:Source/core/http_client.c ****                         sb_append(&s_buf, pumpTmp, (size_t)n);
