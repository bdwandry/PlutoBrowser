 541:Source/core/http_client.c ****     // ── Network availability ─────────────────────�
 542:Source/core/http_client.c ****     // Need at least TCP or HTTP API available. For HTTP/HTTPS URLs, prefer
 543:Source/core/http_client.c ****     // the HTTP API; for other protocols, TCP is required.
 544:Source/core/http_client.c ****     int has_tcp = s_pd->network && s_pd->network->tcp && s_tcp;
