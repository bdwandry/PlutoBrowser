 775:Source/core/http_client.c **** /* Open the TCP connection (runs on the frame after start/access-allowed —
 776:Source/core/http_client.c ****  * never inside the SDK access callback, matching the reference's tick
 777:Source/core/http_client.c ****  * deferral pattern). */
 778:Source/core/http_client.c **** static void open_connection(void)
 779:Source/core/http_client.c **** {
 780:Source/core/http_client.c ****     int pooled = g_pooledTcp && g_pooledPort == g_parsed->port &&
