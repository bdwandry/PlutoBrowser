 792:Source/core/http_client.c ****                     snprintf(s_pendingUrl, sizeof(s_pendingUrl), "%s",
 793:Source/core/http_client.c ****                              abs.data ? abs.data : "");
 794:Source/core/http_client.c ****                     sb_free(&abs);
 795:Source/core/http_client.c ****                     s_pendingCbs = s_cbs;
 796:Source/core/http_client.c ****                     s_hasPendingRedirect = 1;
 797:Source/core/http_client.c ****                 } else {
