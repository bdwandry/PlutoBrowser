 778:Source/core/http_client.c ****         // Cancelled or superseded while still connecting; open has resolved,
 779:Source/core/http_client.c ****         // so closing here is safe (see close_tcp comment).
 780:Source/core/http_client.c ****         s_tcp->close(conn);
 781:Source/core/http_client.c ****         return;
