 208:Source/core/http_client.c **** static void store_header(const char* key, size_t keyLen, const char* val,
 209:Source/core/http_client.c ****                          size_t valLen)
 210:Source/core/http_client.c **** {
 211:Source/core/http_client.c ****     char lower[128];
 212:Source/core/http_client.c ****     if (keyLen >= sizeof(lower)) keyLen = sizeof(lower) - 1;
