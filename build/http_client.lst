  67:Source/core/http_client.c **** 
  68:Source/core/http_client.c **** /* ── Connection lifecycle (SDK TCP/TLS crash workarounds) ────────────
  69:Source/core/http_client.c ****  * Two documented-by-experiment SDK hazards shape this design:
  70:Source/core/http_client.c ****  *   (1) Releasing a connection while its async DNS/connect is still in flight
  71:Source/core/http_client.c ****  *       segfaults the SDK event loop (P33 pool build: the DNS-failed t:80
  72:Source/core/http_client.c ****  *       connection was released in a later host-switch → SEGV).
  73:Source/core/http_client.c ****  *   (2) Closing+releasing a COMPLETED TLS connection and setting up a new TLS
  74:Source/core/http_client.c ****  *       connection shortly after traps the SDK (P33b probe, P33 svg fetch).
  75:Source/core/http_client.c ****  * The TCP docs bless reuse: close() "The connection may be used again for
  76:Source/core/http_client.c ****  * another request". Therefore:
  77:Source/core/http_client.c ****  *   - g_pooledTcp: the most recent connection whose open RESOLVED (success or
  78:Source/core/http_client.c ****  *     open-callback failure). Reused via close()+open() for the same host —
  79:Source/core/http_client.c ****  *     skipping the TLS handshake for same-host image fetches entirely.
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccfsx8xP.s 			page 4


  80:Source/core/http_client.c ****  *   - g_orphanTcp: a still-connecting connection handed off at cancel/reset.
  81:Source/core/http_client.c ****  *     Its (stale) open callback closes and releases it — never us.
  82:Source/core/http_client.c ****  *   - g_graveTcp: a pooled connection dropped on host switch — closed now,
  83:Source/core/http_client.c ****  *     RELEASED only after GRAVE_FRAMES frames (http_update tick), long after
  84:Source/core/http_client.c ****  *     the SDK's event loop has drained any pending state for it. */
  85:Source/core/http_client.c **** static TCPConnection *g_pooledTcp = NULL;
  86:Source/core/http_client.c **** static char g_pooledHost[256];
  87:Source/core/http_client.c **** static int g_pooledPort = 0;
  88:Source/core/http_client.c **** static int g_pooledSsl = 0;
  89:Source/core/http_client.c **** static TCPConnection *g_orphanTcp = NULL;  /* open callback owns close+release */
  90:Source/core/http_client.c **** static TCPConnection *g_graveTcp = NULL;   /* closed; release after the delay */
  91:Source/core/http_client.c **** static int g_graveTimer = 0;
  92:Source/core/http_client.c **** #define GRAVE_FRAMES 120  /* ~4s at 30fps */
  93:Source/core/http_client.c **** 
  94:Source/core/http_client.c **** /* Saved response for the done path (reset() clears live state before the
  95:Source/core/http_client.c ****  * user callback fires — Lua saved locals for the same reason). */
