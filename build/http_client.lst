1045:Source/core/http_client.c ****         PlutoHttpCallbacks cb = s_cbs;
1046:Source/core/http_client.c ****         char msg[HC_ERR_MAX];
1047:Source/core/http_client.c ****         snprintf(msg, sizeof(msg), "Networking not available.");
1048:Source/core/http_client.c ****         reset();
1049:Source/core/http_client.c ****         if (cb.onError) cb.onError(cb.ud, msg);
1050:Source/core/http_client.c ****     }
1051:Source/core/http_client.c **** }
