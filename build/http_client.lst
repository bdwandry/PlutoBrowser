 714:Source/core/http_client.c ****                 } else {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccKeS4lK.s 			page 41


 715:Source/core/http_client.c ****                     set_error("Too many redirects to %s", s_url);
