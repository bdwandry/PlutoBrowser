 693:Source/core/http_client.c ****     }
 694:Source/core/http_client.c **** 
 695:Source/core/http_client.c ****     // Timeout watchdog
 696:Source/core/http_client.c ****     if ((s_state == HC_CONNECTING || s_state == HC_READING) &&
 697:Source/core/http_client.c ****         now - s_startMs > HC_REQUEST_TIMEOUT_MS) {
 698:Source/core/http_client.c ****         if (s_buf.len > 512) {
 699:Source/core/http_client.c ****             // Got some data — treat as done rather than fail silently
 700:Source/core/http_client.c ****             s_state = HC_DONE;
