 609:Source/core/http_client.c **** 
 610:Source/core/http_client.c ****     if (s_state == HC_IDLE) return;
 611:Source/core/http_client.c **** 
 612:Source/core/http_client.c ****     // about-page timer (playdate.timer.performAfterDelay(20) parity).
 613:Source/core/http_client.c ****     // Faithful ordering: progress -> success -> reset (a get() issued from
 614:Source/core/http_client.c ****     // inside onSuccess is clobbered by this trailing reset, like in Lua).
 615:Source/core/http_client.c ****     if (s_aboutPending && hc_now() >= s_aboutDueMs) {
