 543:Source/core/http_client.c **** static void tcp_open_cb(TCPConnection *conn, PDNetErr err, void *ud)
 544:Source/core/http_client.c **** {
 545:Source/core/http_client.c ****     unsigned int myId = (unsigned int)(uintptr_t)ud;
 546:Source/core/http_client.c ****     if (myId != g_requestId)
 547:Source/core/http_client.c ****     {
 548:Source/core/http_client.c ****         /* Stale open (cancelled/superseded while connecting): the async open
 549:Source/core/http_client.c ****          * has settled NOW, so closing+releasing is finally safe. This is the
 550:Source/core/http_client.c ****          * orphan handoff from close_tcp — plus a defensive pool check. */
 551:Source/core/http_client.c ****         g_pd->network->tcp->close(conn);
 552:Source/core/http_client.c ****         g_pd->network->tcp->release(conn);
 553:Source/core/http_client.c ****         if (g_orphanTcp == conn)
 554:Source/core/http_client.c ****         {
 555:Source/core/http_client.c ****             g_orphanTcp = NULL;
 556:Source/core/http_client.c ****         }
 557:Source/core/http_client.c ****         if (g_pooledTcp == conn)
 558:Source/core/http_client.c ****         {
 559:Source/core/http_client.c ****             g_pooledTcp = NULL;
 560:Source/core/http_client.c ****         }
 561:Source/core/http_client.c ****         return;
 562:Source/core/http_client.c ****     }
 563:Source/core/http_client.c ****     if (err != NET_OK)
 564:Source/core/http_client.c ****     {
 565:Source/core/http_client.c ****         g_openFailed = 1;
 566:Source/core/http_client.c ****         snprintf(g_error, sizeof(g_error), "Connection failed: %d", (int)err);
 567:Source/core/http_client.c ****         g_state = HS_ERROR;
 568:Source/core/http_client.c ****         return;
 569:Source/core/http_client.c ****     }
 570:Source/core/http_client.c ****     g_connOpen = 1;
 571:Source/core/http_client.c **** }
