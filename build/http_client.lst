   1:Source/core/http_client.c **** // http_client.c — Multi-protocol HTTP/HTTPS client for PlutoBrowser.
   2:Source/core/http_client.c **** //
   3:Source/core/http_client.c **** // Supports two networking backends:
   4:Source/core/http_client.c **** //  1. Native HTTP API (pd->network->http): preferred for HTTP/HTTPS. Handles
   5:Source/core/http_client.c **** //     TLS, HTTP request formatting, and status/header parsing internally.
   6:Source/core/http_client.c **** //  2. Raw TCP API (pd->network->tcp): fallback for HTTP/HTTPS if the HTTP API
   7:Source/core/http_client.c **** //     is unavailable or fails. Also used for non-HTTP TCP connections.
   8:Source/core/http_client.c **** //
   9:Source/core/http_client.c **** // Protocol selection: HTTP/HTTPS URLs attempt the native HTTP API first. If
  10:Source/core/http_client.c **** // the HTTP API is unavailable or the connection fails, falls back to raw TCP.
  11:Source/core/http_client.c **** // The browser receives responses through the same PlutoHttpCallbacks interface
  12:Source/core/http_client.c **** // regardless of which backend succeeded — the protocol is an implementation
  13:Source/core/http_client.c **** // detail of content retrieval.
  14:Source/core/http_client.c **** //
  15:Source/core/http_client.c **** // Testability: hc_set_http_for_tests()/hc_set_tcp_for_tests()/hc_set_clock_fn()
  16:Source/core/http_client.c **** // swap the vtables and clock so selftest_http.c can replay the oracle
  17:Source/core/http_client.c **** // scenarios offline.
  18:Source/core/http_client.c **** 
