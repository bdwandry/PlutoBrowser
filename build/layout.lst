 161:Source/render/layout.c ****     g_onDemandConsumed = 0;
 162:Source/render/layout.c ****     /* Free the whole word-arena chunk list. */
 163:Source/render/layout.c ****     WordChunk *c = g_wordChunks;
 164:Source/render/layout.c ****     while (c)
 165:Source/render/layout.c ****     {
