 118:Source/render/layout.c **** static const char* normalize_align(const char* a) {
 119:Source/render/layout.c ****     if (!a) return NULL;
 120:Source/render/layout.c ****     if (!strcmp(a, "center")) return "center";
 121:Source/render/layout.c ****     if (!strcmp(a, "right"))  return "right";
 122:Source/render/layout.c ****     if (!strcmp(a, "left"))   return "left";
 123:Source/render/layout.c ****     return NULL;   /* document stores pre-lowered statics */
 124:Source/render/layout.c **** }
