 495:Source/render/layout.c **** 
 496:Source/render/layout.c **** static void od_requested_add(const char* src) {
 497:Source/render/layout.c ****     if (layout_on_demand_requested(src)) return;
 498:Source/render/layout.c ****     if (s_nReq == s_capReq) {
 499:Source/render/layout.c ****         s_capReq = s_capReq ? s_capReq * 2 : 8;
 500:Source/render/layout.c ****         s_odRequested = (char**)pluto_realloc(s_odRequested,
 501:Source/render/layout.c ****                                         sizeof(char*) * (size_t)s_capReq);
 502:Source/render/layout.c ****     }
 503:Source/render/layout.c ****     s_odRequested[s_nReq++] = pluto_strdup(src);
 504:Source/render/layout.c **** }
 505:Source/render/layout.c **** 
 506:Source/render/layout.c **** int layout_on_demand_requested(const char* src) {
 507:Source/render/layout.c ****     if (!src) return 0;
 508:Source/render/layout.c ****     for (int i = 0; i < s_nReq; i++)
 509:Source/render/layout.c ****         if (s_odRequested[i] && !strcmp(s_odRequested[i], src)) return 1;
 510:Source/render/layout.c ****     return 0;
 511:Source/render/layout.c **** }
 512:Source/render/layout.c **** 
 513:Source/render/layout.c **** static void od_requested_remove(const char* src) {
 514:Source/render/layout.c ****     for (int i = 0; i < s_nReq; i++) {
 515:Source/render/layout.c ****         if (s_odRequested[i] && !strcmp(s_odRequested[i], src)) {
 516:Source/render/layout.c ****             pluto_free(s_odRequested[i]);
 517:Source/render/layout.c ****             s_odRequested[i] = s_odRequested[--s_nReq];
 518:Source/render/layout.c ****             return;
 519:Source/render/layout.c ****         }
 520:Source/render/layout.c ****     }
 521:Source/render/layout.c **** }
