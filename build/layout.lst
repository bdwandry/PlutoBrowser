1642:Source/render/layout.c ****     }
1643:Source/render/layout.c **** }
1644:Source/render/layout.c **** 
1645:Source/render/layout.c **** static void od_unrequest(const char *src)
1646:Source/render/layout.c **** {
1647:Source/render/layout.c ****     for (int i = 0; i < g_odRequestedCount; i++)
1648:Source/render/layout.c ****     {
1649:Source/render/layout.c ****         if (strcmp(g_odRequested[i], src) == 0)
1650:Source/render/layout.c ****         {
1651:Source/render/layout.c ****             for (int j = i + 1; j < g_odRequestedCount; j++)
1652:Source/render/layout.c ****             {
1653:Source/render/layout.c ****                 memcpy(g_odRequested[j - 1], g_odRequested[j], 512);
1654:Source/render/layout.c ****             }
1655:Source/render/layout.c ****             g_odRequestedCount--;
1656:Source/render/layout.c ****             return;
1657:Source/render/layout.c ****         }
1658:Source/render/layout.c ****     }
1659:Source/render/layout.c **** }
