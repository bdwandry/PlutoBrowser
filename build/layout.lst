 240:src/render/layout.c **** static void brk_push_word(BrkLine* ln, BrkWord w) {
 241:src/render/layout.c ****     if (ln->nWords == ln->capWords) {
 242:src/render/layout.c ****         ln->capWords = ln->capWords ? ln->capWords * 2 : 8;
 243:src/render/layout.c ****         ln->words = (BrkWord*)pluto_realloc(ln->words,
 244:src/render/layout.c ****                                      sizeof(BrkWord) * (size_t)ln->capWords);
 245:src/render/layout.c ****     }
 246:src/render/layout.c ****     ln->words[ln->nWords++] = w;
 247:src/render/layout.c **** }
 248:src/render/layout.c **** 
 249:src/render/layout.c **** static void brk_push_line(BrkLines* ls, BrkLine* cur) {
 250:src/render/layout.c ****     if (cur->nWords == 0) return;
 251:src/render/layout.c ****     if (ls->nLines == ls->capLines) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccF3LIbn.s 			page 7


 252:src/render/layout.c ****         ls->capLines = ls->capLines ? ls->capLines * 2 : 8;
 253:src/render/layout.c ****         ls->lines = (BrkLine*)pluto_realloc(ls->lines,
 254:src/render/layout.c ****                                     sizeof(BrkLine) * (size_t)ls->capLines);
 255:src/render/layout.c ****     }
 256:src/render/layout.c ****     ls->lines[ls->nLines++] = *cur;
 257:src/render/layout.c ****     cur->words = NULL; cur->nWords = 0; cur->capWords = 0; cur->width = 0;
 258:src/render/layout.c **** }
