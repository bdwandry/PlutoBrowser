 465:src/render/layout.c **** /* convenience wrapper matching the common Lua call shape */
 466:src/render/layout.c **** static int flow_paragraph(const DocBlock* b, int startX, int maxW, int startY,
 467:src/render/layout.c ****                           int invert, int forceBold, int forceBoldFont) {
 468:src/render/layout.c ****     BrkLines ls;
 469:src/render/layout.c ****     int lineH = 16;
 470:src/render/layout.c ****     brk_break(b->inlines, b->nInlines, maxW,
 471:src/render/layout.c ****               forceBoldFont ? style_get_body_font(1, 0, NULL) : NULL,
 472:src/render/layout.c ****               forceBoldFont, 0, &ls, &lineH);
 473:src/render/layout.c ****     int endY = emit_flow(&ls, lineH, startX, maxW,
 474:src/render/layout.c ****                          normalize_align(b->align), startY, invert, forceBold);
 475:src/render/layout.c ****     brk_free(&ls);
 476:src/render/layout.c ****     return endY;
 477:src/render/layout.c **** }
