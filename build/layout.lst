 356:Source/render/layout.c **** /* ── Tab helpers ─────────────────────────�
 357:Source/render/layout.c **** 
 358:Source/render/layout.c **** #define TAB_COLUMNS 8
 359:Source/render/layout.c **** 
 360:Source/render/layout.c **** static int tab_advance(LCDFont *font, int runningWidth)
 361:Source/render/layout.c **** {
 362:Source/render/layout.c ****     int spaceW = measure(font, " ");
 363:Source/render/layout.c ****     if (spaceW <= 0)
 364:Source/render/layout.c ****     {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cce5xlFO.s 			page 9


 365:Source/render/layout.c ****         spaceW = 8;
 366:Source/render/layout.c ****     }
 367:Source/render/layout.c ****     int tabPx = TAB_COLUMNS * spaceW;
 368:Source/render/layout.c ****     int toTab = tabPx - (runningWidth % tabPx);
 369:Source/render/layout.c ****     if (toTab <= 0)
 370:Source/render/layout.c ****     {
 371:Source/render/layout.c ****         toTab = tabPx;
 372:Source/render/layout.c ****     }
 373:Source/render/layout.c ****     return toTab;
 374:Source/render/layout.c **** }
