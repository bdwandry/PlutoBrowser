 359:Source/render/layout.c **** static int floordiv2(int a) {           /* math.floor(a / 2) for any sign */
 360:Source/render/layout.c ****     int q = a / 2;
 361:Source/render/layout.c ****     if (a % 2 != 0 && a < 0) q--;
 362:Source/render/layout.c ****     return q;
 363:Source/render/layout.c **** }
