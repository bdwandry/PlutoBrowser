 146:Source/render/layout.c ****             g_items[i]->ownedValue = NULL;
 147:Source/render/layout.c ****         }
 148:Source/render/layout.c ****         free(g_items[i]);
 149:Source/render/layout.c ****     }
 150:Source/render/layout.c ****     free(g_items);
 151:Source/render/layout.c ****     g_items = NULL;
 152:Source/render/layout.c ****     g_itemCount = 0;
 153:Source/render/layout.c ****     g_itemCap = 0;
 154:Source/render/layout.c ****     g_totalHeight = 0;
 155:Source/render/layout.c ****     g_selectedInput = NULL;
