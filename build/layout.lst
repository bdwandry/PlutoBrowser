1695:Source/render/layout.c **** /* Lua fillCircleAtPoint(cx, cy, r): inclusive disk of diameter 2r+1 →
1696:Source/render/layout.c ****  * C fillEllipse bounding box (x, y, 2r+1, 2r+1). */
1697:Source/render/layout.c **** static void fill_circle_at(int cx, int cy, int r, LCDColor color)
1698:Source/render/layout.c **** {
1699:Source/render/layout.c ****     g_pd->graphics->fillEllipse(cx - r, cy - r, r * 2 + 1, r * 2 + 1,
1700:Source/render/layout.c ****                                 0.f, 360.f, color);
1701:Source/render/layout.c **** }
1702:Source/render/layout.c **** 
1703:Source/render/layout.c **** static void draw_pixel(int x, int y, LCDColor color)
1704:Source/render/layout.c **** {
1705:Source/render/layout.c ****     g_pd->graphics->fillRect(x, y, 1, 1, color);
1706:Source/render/layout.c **** }
1707:Source/render/layout.c **** 
1708:Source/render/layout.c **** static void draw_placeholder_card(int x, int y, int w, int h)
1709:Source/render/layout.c **** {
1710:Source/render/layout.c ****     g_pd->graphics->fillRoundRect(x, y, w, h, 4, kColorWhite);
1711:Source/render/layout.c ****     g_pd->graphics->drawRoundRect(x, y, w, h, 4, 1, kColorBlack);
1712:Source/render/layout.c ****     for (int hx = x + 4; hx <= x + w - 4; hx += 10)
1713:Source/render/layout.c ****     {
1714:Source/render/layout.c ****         g_pd->graphics->drawLine(hx, y + 3, hx, y + h - 3, 1, kColorBlack);
1715:Source/render/layout.c ****     }
1716:Source/render/layout.c ****     int iconX = x + w / 2 - 8;
1717:Source/render/layout.c ****     int iconY = y + h / 2 - 6;
1718:Source/render/layout.c ****     g_pd->graphics->drawRoundRect(iconX, iconY, 16, 11, 2, 1, kColorBlack);
1719:Source/render/layout.c ****     fill_circle_at(iconX + 8, iconY + 5, 3, kColorBlack);
1720:Source/render/layout.c ****     draw_pixel(iconX + 13, iconY + 1, kColorBlack);
1721:Source/render/layout.c **** }
