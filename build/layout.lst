1254:src/render/layout.c **** static void table_box_paint(const LItem* it, int scrollY) {
1255:src/render/layout.c ****     int drawY = it->y - scrollY;
1256:src/render/layout.c ****     if (!(drawY + it->h >= PLUTO_CONTENT_Y && drawY <= PLUTO_SCREEN_HEIGHT))
1257:src/render/layout.c ****         return;
1258:src/render/layout.c **** 
1259:src/render/layout.c ****     if (it->border) {   /* Lua: border ~= false */
1260:src/render/layout.c ****         s_pd->graphics->fillRoundRect(it->x, drawY, it->w, it->h, 3,
1261:src/render/layout.c ****                                       kColorWhite);
1262:src/render/layout.c ****         s_pd->graphics->drawRoundRect(it->x, drawY, it->w, it->h, 3, 1,
1263:src/render/layout.c ****                                       kColorBlack);
1264:src/render/layout.c ****     }
1265:src/render/layout.c **** 
1266:src/render/layout.c ****     int colCount = 1;
1267:src/render/layout.c ****     for (size_t r = 0; r < it->nRows; r++) {
1268:src/render/layout.c ****         const DocTableRow* row = &it->rows[r];
1269:src/render/layout.c ****         int n = 0;
1270:src/render/layout.c ****         for (size_t c = 0; c < row->nCells; c++)
1271:src/render/layout.c ****             n += row->cells[c].colspan >= 1 ? row->cells[c].colspan : 1;
1272:src/render/layout.c ****         if (n > colCount) colCount = n;
1273:src/render/layout.c ****     }
1274:src/render/layout.c ****     double colW = ((double)(it->w - 16)) /
1275:src/render/layout.c ****                   (double)(colCount > 1 ? colCount : 1);
1276:src/render/layout.c **** 
1277:src/render/layout.c ****     int capH = 0;
1278:src/render/layout.c ****     if (it->caption && it->caption[0]) capH = 16;
1279:src/render/layout.c ****     if (capH > 0) {
1280:src/render/layout.c ****         PlutoFont* f = style_get_body_font(1, 0, NULL);
1281:src/render/layout.c ****         char cap[96];
1282:src/render/layout.c ****         snprintf(cap, sizeof(cap), "%s", it->caption);
1283:src/render/layout.c ****         size_t cl = strlen(cap);
1284:src/render/layout.c ****         if (cl > 30) { cap[28]='.'; cap[29]='.'; cap[30]='\0'; }
1285:src/render/layout.c ****         dtf(f, cap, it->x + 8, drawY + 2);
1286:src/render/layout.c ****     }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccF3LIbn.s 			page 282


1287:src/render/layout.c **** 
1288:src/render/layout.c ****     int rowY = drawY + 4 + capH;
