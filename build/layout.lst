 365:Source/render/layout.c **** /* growable link-rect text accumulator ("a b c" across merged words) */
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccLIqTMw.s 			page 9


 366:Source/render/layout.c **** static char* mr_text_append(char** buf, size_t* len, size_t* cap,
 367:Source/render/layout.c ****                             const char* word, int wlen) {
 368:Source/render/layout.c ****     size_t add = (size_t)wlen + 1 /*space*/;
 369:Source/render/layout.c ****     if (*len + add + 1 > *cap) {
 370:Source/render/layout.c ****         *cap = (*len + add + 1) * 2;
 371:Source/render/layout.c ****         *buf = (char*)pluto_realloc(*buf, *cap);
 372:Source/render/layout.c ****     }
 373:Source/render/layout.c ****     if (*len > 0) (*buf)[(*len)++] = ' ';
 374:Source/render/layout.c ****     memcpy(*buf + *len, word, (size_t)wlen);
 375:Source/render/layout.c ****     *len += (size_t)wlen;
 376:Source/render/layout.c ****     (*buf)[*len] = '\0';
 377:Source/render/layout.c ****     return *buf;
 378:Source/render/layout.c **** }
 379:Source/render/layout.c **** 
 380:Source/render/layout.c **** /* appends positioned items for already-broken lines; returns endY */
 381:Source/render/layout.c **** static int emit_flow(BrkLines* ls, int lineH, int startX, int maxW,
 382:Source/render/layout.c ****                      const char* align, int startY, int invert, int forceBold) {
 383:Source/render/layout.c ****     int y = startY;
 384:Source/render/layout.c ****     for (int li = 0; li < ls->nLines; li++) {
 385:Source/render/layout.c ****         const BrkLine* ln = &ls->lines[li];
 386:Source/render/layout.c ****         int textW = 0;
 387:Source/render/layout.c ****         for (int wi = 0; wi < ln->nWords; wi++) textW += ln->words[wi].w;
 388:Source/render/layout.c ****         int x = startX;
 389:Source/render/layout.c ****         if (align && !strcmp(align, "center"))
 390:Source/render/layout.c ****             x = startX + floordiv2(maxW - textW);
 391:Source/render/layout.c ****         else if (align && !strcmp(align, "right"))
 392:Source/render/layout.c ****             x = startX + (maxW - textW > 0 ? maxW - textW : 0);
 393:Source/render/layout.c **** 
 394:Source/render/layout.c ****         /* pending link rect (merged across same-href words) */
 395:Source/render/layout.c ****         int haveMr = 0, mrX = 0, mrW = 0, mrInert = 0;
 396:Source/render/layout.c ****         long mrAnchor = -1;
 397:Source/render/layout.c ****         const char* mrHref = NULL;
 398:Source/render/layout.c ****         char* mrText = NULL;
 399:Source/render/layout.c ****         size_t mrLen = 0, mrCap = 0;
 400:Source/render/layout.c **** 
 401:Source/render/layout.c ****         for (int wi = 0; wi < ln->nWords; wi++) {
 402:Source/render/layout.c ****             const BrkWord* wd = &ln->words[wi];
 403:Source/render/layout.c ****             const DocInline* inl = wd->inl;
 404:Source/render/layout.c ****             int dy = inl->sub ? 3 : (inl->sup ? -4 : 0);
 405:Source/render/layout.c **** 
 406:Source/render/layout.c ****             LItem* it = new_item(LIT_TEXT);
 407:Source/render/layout.c ****             it->text        = pluto_strndup(wd->start, (size_t)wd->len);
 408:Source/render/layout.c ****             it->font        = wd->font;
 409:Source/render/layout.c ****             it->x           = x;
 410:Source/render/layout.c ****             it->y           = y + dy;
 411:Source/render/layout.c ****             it->w           = wd->w;
 412:Source/render/layout.c ****             it->h           = lineH;
 413:Source/render/layout.c ****             it->bold        = inl->bold;
 414:Source/render/layout.c ****             it->italic      = inl->italic;
 415:Source/render/layout.c ****             it->underline   = inl->underline;
 416:Source/render/layout.c ****             it->code        = inl->code;
 417:Source/render/layout.c ****             it->smallFlag   = inl->small;
 418:Source/render/layout.c ****             it->bigFlag     = inl->big;
 419:Source/render/layout.c ****             it->mark        = inl->mark;
 420:Source/render/layout.c ****             it->strike      = inl->strike;
 421:Source/render/layout.c ****             it->invert      = (unsigned char)(invert ? 1 : 0);
 422:Source/render/layout.c ****             it->href        = inl->href ? pluto_strdup(inl->href) : NULL;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccLIqTMw.s 			page 10


 423:Source/render/layout.c ****             it->anchorIndex = inl->anchorIndex;
 424:Source/render/layout.c ****             if (forceBold) it->bold = 1;
 425:Source/render/layout.c **** 
 426:Source/render/layout.c ****             if (inl->href && haveMr && mrHref == inl->href &&
 427:Source/render/layout.c ****                 mrAnchor == inl->anchorIndex) {
 428:Source/render/layout.c ****                 /* same link continues: extend over the inter-word gap */
 429:Source/render/layout.c ****                 mrW = (x + wd->w) - mrX;
 430:Source/render/layout.c ****                 mr_text_append(&mrText, &mrLen, &mrCap, wd->start, wd->len);
 431:Source/render/layout.c ****             } else if (inl->href) {
 432:Source/render/layout.c ****                 if (haveMr)
 433:Source/render/layout.c ****                     lm_add_link_rect(mrHref, mrText ? mrText : "",
 434:Source/render/layout.c ****                         (LmRect){ .x = mrX, .y = y, .w = mrW, .h = lineH,
 435:Source/render/layout.c ****                                   .inert = mrInert }, mrAnchor);
 436:Source/render/layout.c ****                 pluto_free(mrText);
 437:Source/render/layout.c ****                 mrText = NULL; mrLen = 0; mrCap = 0;
 438:Source/render/layout.c ****                 haveMr  = 1;
 439:Source/render/layout.c ****                 mrX     = x;
 440:Source/render/layout.c ****                 mrW     = wd->w;
 441:Source/render/layout.c ****                 mrHref  = inl->href;
 442:Source/render/layout.c ****                 mrAnchor= inl->anchorIndex;
 443:Source/render/layout.c ****                 mrText  = mr_text_append(&mrText, &mrLen, &mrCap,
 444:Source/render/layout.c ****                                          wd->start, wd->len);
 445:Source/render/layout.c ****                 mrInert = inl->inert ? 1 : 0;
 446:Source/render/layout.c ****             } else if (haveMr) {
 447:Source/render/layout.c ****                 lm_add_link_rect(mrHref, mrText ? mrText : "",
 448:Source/render/layout.c ****                     (LmRect){ .x = mrX, .y = y, .w = mrW, .h = lineH,
 449:Source/render/layout.c ****                               .inert = mrInert }, mrAnchor);
 450:Source/render/layout.c ****                 pluto_free(mrText);
 451:Source/render/layout.c ****                 mrText = NULL; mrLen = 0; mrCap = 0;
 452:Source/render/layout.c ****                 haveMr = 0;
 453:Source/render/layout.c ****             }
 454:Source/render/layout.c ****             x += wd->advance;
 455:Source/render/layout.c ****         }
 456:Source/render/layout.c ****         if (haveMr)
 457:Source/render/layout.c ****             lm_add_link_rect(mrHref, mrText ? mrText : "",
 458:Source/render/layout.c ****                 (LmRect){ .x = mrX, .y = y, .w = mrW, .h = lineH,
 459:Source/render/layout.c ****                           .inert = mrInert }, mrAnchor);
 460:Source/render/layout.c ****         pluto_free(mrText);
 461:Source/render/layout.c ****         y += lineH;
 462:Source/render/layout.c ****     }
 463:Source/render/layout.c ****     return y;
 464:Source/render/layout.c **** }
