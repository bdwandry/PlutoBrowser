2615:Source/render/layout.c ****                  currentHoveredSrc);
2616:Source/render/layout.c ****         g_hasHoveredImage = 1;
2617:Source/render/layout.c ****         return;
2618:Source/render/layout.c ****     }
2619:Source/render/layout.c ****     if (g_hasHoveredImage && (!currentHoveredSrc ||
2620:Source/render/layout.c ****                               strcmp(g_hoveredImageSrc, currentHoveredSrc) != 0))
2621:Source/render/layout.c ****     {
