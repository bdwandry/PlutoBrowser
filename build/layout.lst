2628:Source/render/layout.c **** /* ── Bare-image hit test (#12c) ────────────────────�
2629:Source/render/layout.c ****  * Returns the LRI_IMAGE item under the given page coordinates, or NULL.
2630:Source/render/layout.c ****  * Used by the HTML-mode click handler so unlinked <img> elements (google.com
2631:Source/render/layout.c ****  * logo) can open the on-demand overlay too. */
2632:Source/render/layout.c **** const LayoutItem *layout_image_at(int pageX, int pageY)
2633:Source/render/layout.c **** {
2634:Source/render/layout.c ****     int n = g_itemCount;
2635:Source/render/layout.c ****     for (int i = n - 1; i >= 0; i--) /* topmost (last drawn) wins */
2636:Source/render/layout.c ****     {
2637:Source/render/layout.c ****         LayoutItem *it = g_items[i];
2638:Source/render/layout.c ****         if (!it || it->type != LRI_IMAGE || !it->src || !it->src[0])
2639:Source/render/layout.c ****         {
2640:Source/render/layout.c ****             continue;
2641:Source/render/layout.c ****         }
2642:Source/render/layout.c ****         if (pageX >= it->x && pageX < it->x + it->w &&
2643:Source/render/layout.c ****             pageY >= it->y && pageY < it->y + it->h)
2644:Source/render/layout.c ****         {
2645:Source/render/layout.c ****             return it;
2646:Source/render/layout.c ****         }
2647:Source/render/layout.c ****     }
2648:Source/render/layout.c ****     return NULL;
2649:Source/render/layout.c **** }
