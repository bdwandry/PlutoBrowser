2553:Source/render/layout.c **** /* ── Eviction ──────────────────────────�
2554:Source/render/layout.c **** 
2555:Source/render/layout.c **** void layout_evict_offscreen(int scrollY)
2556:Source/render/layout.c **** {
2557:Source/render/layout.c ****     if (image_mode() != IMAGE_MODE_VIEWPORT)
2558:Source/render/layout.c ****     {
2559:Source/render/layout.c ****         return;
2560:Source/render/layout.c ****     }
2561:Source/render/layout.c ****     int viewTop = scrollY - 200;
2562:Source/render/layout.c ****     int viewBottom = scrollY + CONTENT_HEIGHT + 200;
2563:Source/render/layout.c ****     for (int i = 0; i < g_itemCount; i++)
2564:Source/render/layout.c ****     {
2565:Source/render/layout.c ****         const LayoutItem *item = g_items[i];
2566:Source/render/layout.c ****         if (item->type == LRI_IMAGE && item->src)
2567:Source/render/layout.c ****         {
2568:Source/render/layout.c ****             if (item->y + item->h < viewTop || item->y > viewBottom)
2569:Source/render/layout.c ****             {
2570:Source/render/layout.c ****                 imgdec_evict(item->src);
2571:Source/render/layout.c ****             }
2572:Source/render/layout.c ****         }
2573:Source/render/layout.c ****     }
2574:Source/render/layout.c **** }
2575:Source/render/layout.c **** 
2576:Source/render/layout.c **** void layout_evict_hovered_image(const char *currentHoveredSrc)
2577:Source/render/layout.c **** {
2578:Source/render/layout.c ****     if (image_mode() != IMAGE_MODE_HOVER)
2579:Source/render/layout.c ****     {
2580:Source/render/layout.c ****         return;
2581:Source/render/layout.c ****     }
2582:Source/render/layout.c ****     /* Track the CURRENT hover even on first entry (Lua stores
2583:Source/render/layout.c ****      * Layout.hoveredImageSrc every frame; without this the C port never
2584:Source/render/layout.c ****      * marked the hovered image, so the evict branch below could never fire
2585:Source/render/layout.c ****      * and mouse-off unloads never happened). */
2586:Source/render/layout.c ****     if (currentHoveredSrc && currentHoveredSrc[0])
2587:Source/render/layout.c ****     {
2588:Source/render/layout.c ****         snprintf(g_hoveredImageSrc, sizeof(g_hoveredImageSrc), "%s",
2589:Source/render/layout.c ****                  currentHoveredSrc);
2590:Source/render/layout.c ****         g_hasHoveredImage = 1;
2591:Source/render/layout.c ****         return;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccH8dkZG.s 			page 104


2592:Source/render/layout.c ****     }
2593:Source/render/layout.c ****     if (g_hasHoveredImage && (!currentHoveredSrc ||
2594:Source/render/layout.c ****                               strcmp(g_hoveredImageSrc, currentHoveredSrc) != 0))
2595:Source/render/layout.c ****     {
2596:Source/render/layout.c ****         imgdec_evict(g_hoveredImageSrc);
2597:Source/render/layout.c ****         g_hasHoveredImage = 0;
2598:Source/render/layout.c ****         g_hoveredImageSrc[0] = '\0';
2599:Source/render/layout.c ****     }
2600:Source/render/layout.c **** }
