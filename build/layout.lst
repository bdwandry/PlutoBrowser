 195:Source/render/layout.c **** char* layout_expand_tab_columns(const char* line) {
 196:Source/render/layout.c ****     if (!line || !strchr(line, '\t')) return pluto_strdup(line ? line : "");
 197:Source/render/layout.c ****     size_t need = strlen(line) * TAB_COLUMNS + 1;
 198:Source/render/layout.c ****     char* out = (char*)pluto_malloc(need);
 199:Source/render/layout.c ****     size_t k = 0;
 200:Source/render/layout.c ****     int col = 0;
 201:Source/render/layout.c ****     for (const char* p = line; *p; p++) {
 202:Source/render/layout.c ****         if (*p == '\t') {
 203:Source/render/layout.c ****             int pad = TAB_COLUMNS - (col % TAB_COLUMNS);
 204:Source/render/layout.c ****             for (int i = 0; i < pad; i++) out[k++] = ' ';
 205:Source/render/layout.c ****             col += pad;
 206:Source/render/layout.c ****         } else {
 207:Source/render/layout.c ****             out[k++] = *p;
 208:Source/render/layout.c ****             col++;
 209:Source/render/layout.c ****         }
 210:Source/render/layout.c ****     }
 211:Source/render/layout.c ****     out[k] = '\0';
 212:Source/render/layout.c ****     return out;
 213:Source/render/layout.c **** }
