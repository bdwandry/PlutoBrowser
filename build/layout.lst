 266:src/render/layout.c **** /* scratch buffer so word slices can be measured as C strings without a
 267:src/render/layout.c ****  * malloc per word */
 268:src/render/layout.c **** static char* s_meas = NULL;
 269:src/render/layout.c **** static size_t s_measCap = 0;
 270:src/render/layout.c **** 
 271:src/render/layout.c **** static const char* meas_slice(const char* start, int len) {
 272:src/render/layout.c ****     if ((size_t)len + 1 > s_measCap) {
 273:src/render/layout.c ****         s_measCap = (size_t)len + 32;
 274:src/render/layout.c ****         s_meas = (char*)pluto_realloc(s_meas, s_measCap);
 275:src/render/layout.c ****     }
 276:src/render/layout.c ****     memcpy(s_meas, start, (size_t)len);
 277:src/render/layout.c ****     s_meas[len] = '\0';
 278:src/render/layout.c ****     return s_meas;
 279:src/render/layout.c **** }
