 282:Source/render/layout.c **** static void brk_break(const DocInline* inlines, size_t nInlines, int maxW,
 283:Source/render/layout.c ****                       PlutoFont* forcedFont, int forcedBold, int forcedLH,
 284:Source/render/layout.c ****                       BrkLines* out, int* outLineH) {
 285:Source/render/layout.c ****     memset(out, 0, sizeof(*out));
 286:Source/render/layout.c ****     BrkLine cur;
 287:Source/render/layout.c ****     memset(&cur, 0, sizeof(cur));
 288:Source/render/layout.c ****     int firstWord = 1;
 289:Source/render/layout.c ****     int lineH = forcedFont ? (forcedLH > 0 ? forcedLH : 16) : 16;
 290:Source/render/layout.c **** 
 291:Source/render/layout.c ****     for (size_t ii = 0; ii < nInlines; ii++) {
 292:Source/render/layout.c ****         const DocInline* inl = &inlines[ii];
 293:Source/render/layout.c ****         if (inl->type == DIT_BR) {
 294:Source/render/layout.c ****             brk_push_line(out, &cur);
 295:Source/render/layout.c ****             firstWord = 1;
 296:Source/render/layout.c ****             continue;
 297:Source/render/layout.c ****         }
 298:Source/render/layout.c ****         PlutoFont* font;
 299:Source/render/layout.c ****         int lh;
 300:Source/render/layout.c ****         if (forcedFont) {
 301:Source/render/layout.c ****             font = forcedFont;
 302:Source/render/layout.c ****             lh   = forcedLH > 0 ? forcedLH : 16;
 303:Source/render/layout.c ****         } else if (forcedBold) {
 304:Source/render/layout.c ****             font = style_get_body_font(1, 0, NULL);
 305:Source/render/layout.c ****             lh   = 16;
 306:Source/render/layout.c ****         } else {
 307:Source/render/layout.c ****             font = style_get_inline_font(inl->bold, inl->code, inl->small,
 308:Source/render/layout.c ****                                          inl->sub, inl->sup, inl->big, NULL);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccLIqTMw.s 			page 8


 309:Source/render/layout.c ****             lh   = 16;
 310:Source/render/layout.c ****         }
 311:Source/render/layout.c ****         if (lh > lineH) lineH = lh;
 312:Source/render/layout.c **** 
 313:Source/render/layout.c ****         const char* text = inl->text ? inl->text : "";
 314:Source/render/layout.c ****         int n = (int)strlen(text);
 315:Source/render/layout.c ****         int spaceW = style_get_text_width(font, " ");
 316:Source/render/layout.c ****         if (spaceW <= 0) spaceW = 8;
 317:Source/render/layout.c **** 
 318:Source/render/layout.c ****         int pos = 0;
 319:Source/render/layout.c ****         while (pos < n) {
 320:Source/render/layout.c ****             while (pos < n && is_space(text[pos])) pos++;
 321:Source/render/layout.c ****             if (pos >= n) break;
 322:Source/render/layout.c **** 
 323:Source/render/layout.c ****             int ws = pos;
 324:Source/render/layout.c ****             while (pos < n && !is_space(text[pos])) pos++;
 325:Source/render/layout.c ****             int wwlen = pos - ws;
 326:Source/render/layout.c ****             int ww = style_get_text_width(font, meas_slice(text + ws, wwlen));
 327:Source/render/layout.c **** 
 328:Source/render/layout.c ****             /* whitespace run following this word */
 329:Source/render/layout.c ****             int gap = 0;
 330:Source/render/layout.c ****             int we = pos;
 331:Source/render/layout.c ****             while (we < n && is_space(text[we])) we++;
 332:Source/render/layout.c ****             if (we > pos) {
 333:Source/render/layout.c ****                 int hasTab = 0;
 334:Source/render/layout.c ****                 for (int t = pos; t < we; t++)
 335:Source/render/layout.c ****                     if (text[t] == '\t') { hasTab = 1; break; }
 336:Source/render/layout.c ****                 gap = hasTab ? tab_advance(font, cur.width + ww) : spaceW;
 337:Source/render/layout.c ****             }
 338:Source/render/layout.c **** 
 339:Source/render/layout.c ****             int aw = ww + gap;
 340:Source/render/layout.c ****             if (cur.width + aw > maxW && !firstWord) {
 341:Source/render/layout.c ****                 brk_push_line(out, &cur);
 342:Source/render/layout.c ****                 firstWord = 1;
 343:Source/render/layout.c ****                 aw = ww;
 344:Source/render/layout.c ****                 gap = 0;
 345:Source/render/layout.c ****             }
 346:Source/render/layout.c ****             BrkWord w = { text + ws, wwlen, font, ww, ww + gap, inl };
 347:Source/render/layout.c ****             brk_push_word(&cur, w);
 348:Source/render/layout.c ****             cur.width += aw;
 349:Source/render/layout.c ****             firstWord = 0;
 350:Source/render/layout.c ****             pos = we;
 351:Source/render/layout.c ****         }
 352:Source/render/layout.c ****     }
 353:Source/render/layout.c ****     brk_push_line(out, &cur);
 354:Source/render/layout.c ****     if (outLineH) *outLineH = lineH;
 355:Source/render/layout.c **** }
