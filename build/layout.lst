 214:src/render/layout.c **** static int is_space(char c) {
 215:src/render/layout.c ****     return c == ' ' || c == '\t' || c == '\n' || c == '\r' ||
 216:src/render/layout.c ****            c == '\f' || c == '\v';
 217:src/render/layout.c **** }
