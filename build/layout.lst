1175:src/render/layout.c **** 
1176:src/render/layout.c **** static void dt(const char* text, int x, int y) {
1177:src/render/layout.c ****     s_pd->graphics->drawText(text, (size_t)strlen(text), kASCIIEncoding,
1178:src/render/layout.c ****                              x, y);
1179:src/render/layout.c **** }
1180:src/render/layout.c **** 
1181:src/render/layout.c **** static void dtf(PlutoFont* f, const char* text, int x, int y) {
1182:src/render/layout.c ****     s_pd->graphics->setFont(f);
1183:src/render/layout.c ****     dt(text, x, y);
1184:src/render/layout.c **** }
1185:src/render/layout.c **** 
1186:src/render/layout.c **** /* growable scratch so composed cell texts can be built without mallocs */
1187:src/render/layout.c **** static char* s_scratch = NULL;
1188:src/render/layout.c **** static size_t s_scratchCap = 0;
1189:src/render/layout.c **** 
1190:src/render/layout.c **** static char* scratch_reserve(size_t n) {
1191:src/render/layout.c ****     if (n + 1 > s_scratchCap) {
1192:src/render/layout.c ****         s_scratchCap = n + 128;
1193:src/render/layout.c ****         s_scratch = (char*)pluto_realloc(s_scratch, s_scratchCap);
1194:src/render/layout.c ****     }
1195:src/render/layout.c ****     return s_scratch;
1196:src/render/layout.c **** }
1197:src/render/layout.c **** 
1198:src/render/layout.c **** /* collapse whitespace runs to single spaces, trim ends (Lua gsub pair) */
1199:src/render/layout.c **** static const char* squash_text(const char* s) {
1200:src/render/layout.c ****     if (!s) return "";
1201:src/render/layout.c ****     size_t n = strlen(s);
1202:src/render/layout.c ****     char* out = scratch_reserve(n);
1203:src/render/layout.c ****     size_t k = 0;
1204:src/render/layout.c ****     int inWs = 0;
1205:src/render/layout.c ****     for (const char* p = s; *p; p++) {
1206:src/render/layout.c ****         if (is_space(*p)) { inWs = 1; continue; }
1207:src/render/layout.c ****         if (inWs && k > 0) out[k++] = ' ';
1208:src/render/layout.c ****         inWs = 0;
1209:src/render/layout.c ****         out[k++] = *p;
1210:src/render/layout.c ****     }
1211:src/render/layout.c ****     while (k > 0 && out[k - 1] == ' ') k--;
1212:src/render/layout.c ****     out[k] = '\0';
1213:src/render/layout.c ****     return out;
1214:src/render/layout.c **** }
