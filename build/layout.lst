 260:Source/render/layout.c **** void layout_to_roman(int n, char *out, size_t cap)
 261:Source/render/layout.c **** {
 262:Source/render/layout.c ****     /* Lua: if not n or n <= 0 or n > 3999 then return tostring(n or 1) */
 263:Source/render/layout.c ****     if (n <= 0 || n > 3999)
 264:Source/render/layout.c ****     {
 265:Source/render/layout.c ****         /* Lua tostring(n or 1): 0 is truthy → "0"; nil (not applicable here)
 266:Source/render/layout.c ****          * would give "1"; negative n passes through. */
 267:Source/render/layout.c ****         snprintf(out, cap, "%d", n);
 268:Source/render/layout.c ****         return;
 269:Source/render/layout.c ****     }
 270:Source/render/layout.c ****     static const int vals[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
 271:Source/render/layout.c ****     static const char *syms[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL",
 272:Source/render/layout.c ****                                  "X", "IX", "V", "IV", "I"};
 273:Source/render/layout.c ****     size_t o = 0;
 274:Source/render/layout.c ****     out[0] = '\0';
 275:Source/render/layout.c ****     char tmp[32];
 276:Source/render/layout.c ****     for (int i = 0; i < 13 && n > 0; i++)
 277:Source/render/layout.c ****     {
 278:Source/render/layout.c ****         while (n >= vals[i])
 279:Source/render/layout.c ****         {
 280:Source/render/layout.c ****             size_t sl = strlen(syms[i]);
 281:Source/render/layout.c ****             memcpy(tmp + o, syms[i], sl);
 282:Source/render/layout.c ****             o += sl;
 283:Source/render/layout.c ****             n -= vals[i];
 284:Source/render/layout.c ****         }
 285:Source/render/layout.c ****     }
 286:Source/render/layout.c ****     tmp[o] = '\0';
 287:Source/render/layout.c ****     snprintf(out, cap, "%s", tmp);
 288:Source/render/layout.c **** }
 289:Source/render/layout.c **** 
 290:Source/render/layout.c **** void layout_to_alpha(int n, char *out, size_t cap)
 291:Source/render/layout.c **** {
 292:Source/render/layout.c ****     char tmp[40];
 293:Source/render/layout.c ****     size_t o = 0;
 294:Source/render/layout.c ****     while (n > 0)
 295:Source/render/layout.c ****     {
 296:Source/render/layout.c ****         int rem = (n - 1) % 26;
 297:Source/render/layout.c ****         if (o < sizeof(tmp))
 298:Source/render/layout.c ****         {
 299:Source/render/layout.c ****             tmp[o++] = (char)('a' + rem);
 300:Source/render/layout.c ****         }
 301:Source/render/layout.c ****         n = (n - 1) / 26;
 302:Source/render/layout.c ****     }
 303:Source/render/layout.c ****     for (size_t i = 0; i < o / 2; i++)
 304:Source/render/layout.c ****     {
 305:Source/render/layout.c ****         char t = tmp[i];
 306:Source/render/layout.c ****         tmp[i] = tmp[o - 1 - i];
 307:Source/render/layout.c ****         tmp[o - 1 - i] = t;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cce5xlFO.s 			page 8


 308:Source/render/layout.c ****     }
 309:Source/render/layout.c ****     tmp[o] = '\0';
 310:Source/render/layout.c ****     if (o == 0)
 311:Source/render/layout.c ****     {
 312:Source/render/layout.c ****         snprintf(out, cap, "1"); /* Lua: out ~= "" and out or "1" */
 313:Source/render/layout.c ****         return;
 314:Source/render/layout.c ****     }
 315:Source/render/layout.c ****     snprintf(out, cap, "%s", tmp);
 316:Source/render/layout.c **** }
 317:Source/render/layout.c **** 
 318:Source/render/layout.c **** void layout_ordered_marker(int number, char markerType, char *out, size_t cap)
 319:Source/render/layout.c **** {
 320:Source/render/layout.c ****     char buf[40];
 321:Source/render/layout.c ****     if (!markerType)
 322:Source/render/layout.c ****     {
 323:Source/render/layout.c ****         markerType = '1';
 324:Source/render/layout.c ****     }
 325:Source/render/layout.c ****     if (markerType == 'a')
 326:Source/render/layout.c ****     {
 327:Source/render/layout.c ****         layout_to_alpha(number, buf, sizeof(buf));
 328:Source/render/layout.c ****     }
 329:Source/render/layout.c ****     else if (markerType == 'A')
 330:Source/render/layout.c ****     {
 331:Source/render/layout.c ****         layout_to_alpha(number, buf, sizeof(buf));
 332:Source/render/layout.c ****         for (char *p = buf; *p; p++)
 333:Source/render/layout.c ****         {
 334:Source/render/layout.c ****             *p = (char)toupper((unsigned char)*p);
 335:Source/render/layout.c ****         }
 336:Source/render/layout.c ****     }
 337:Source/render/layout.c ****     else if (markerType == 'i')
 338:Source/render/layout.c ****     {
 339:Source/render/layout.c ****         layout_to_roman(number, buf, sizeof(buf));
 340:Source/render/layout.c ****     }
 341:Source/render/layout.c ****     else if (markerType == 'I')
 342:Source/render/layout.c ****     {
 343:Source/render/layout.c ****         layout_to_roman(number, buf, sizeof(buf));
 344:Source/render/layout.c ****         for (char *p = buf; *p; p++)
 345:Source/render/layout.c ****         {
 346:Source/render/layout.c ****             *p = (char)toupper((unsigned char)*p);
 347:Source/render/layout.c ****         }
 348:Source/render/layout.c ****     }
 349:Source/render/layout.c ****     else
 350:Source/render/layout.c ****     {
 351:Source/render/layout.c ****         snprintf(buf, sizeof(buf), "%d", number == 0 ? 1 : number);
 352:Source/render/layout.c ****     }
 353:Source/render/layout.c ****     snprintf(out, cap, "%s", buf);
 354:Source/render/layout.c **** }
