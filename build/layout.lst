 199:Source/render/layout.c **** /* ── Lua string.sub (1-based, negative from end) ───────────────
 200:Source/render/layout.c **** 
 201:Source/render/layout.c **** static void lua_sub(const char *s, int i, int j, char *out, size_t cap)
 202:Source/render/layout.c **** {
 203:Source/render/layout.c ****     if (!s || !out || cap == 0)
 204:Source/render/layout.c ****     {
 205:Source/render/layout.c ****         return;
 206:Source/render/layout.c ****     }
 207:Source/render/layout.c ****     size_t n = strlen(s);
 208:Source/render/layout.c ****     if (i < 0)
 209:Source/render/layout.c ****     {
 210:Source/render/layout.c ****         i = (int)n + i + 1;
 211:Source/render/layout.c ****     }
 212:Source/render/layout.c ****     if (j < 0)
 213:Source/render/layout.c ****     {
 214:Source/render/layout.c ****         j = (int)n + j + 1;
 215:Source/render/layout.c ****     }
 216:Source/render/layout.c ****     if (i < 1)
 217:Source/render/layout.c ****     {
 218:Source/render/layout.c ****         i = 1;
 219:Source/render/layout.c ****     }
 220:Source/render/layout.c ****     if (j > (int)n)
 221:Source/render/layout.c ****     {
 222:Source/render/layout.c ****         j = (int)n;
 223:Source/render/layout.c ****     }
 224:Source/render/layout.c ****     if (i > j)
 225:Source/render/layout.c ****     {
 226:Source/render/layout.c ****         out[0] = '\0';
 227:Source/render/layout.c ****         return;
 228:Source/render/layout.c ****     }
 229:Source/render/layout.c ****     size_t len = (size_t)(j - i + 1);
 230:Source/render/layout.c ****     if (len >= cap)
 231:Source/render/layout.c ****     {
 232:Source/render/layout.c ****         len = cap - 1;
 233:Source/render/layout.c ****     }
 234:Source/render/layout.c ****     memcpy(out, s + (i - 1), len);
 235:Source/render/layout.c ****     out[len] = '\0';
 236:Source/render/layout.c **** }
