 537:src/render/layout.c **** const char* layout_od_src(void)  { return s_odSrc; }
 538:src/render/layout.c **** const char* layout_od_href(void) { return s_odHref; }
 539:src/render/layout.c **** const char* layout_od_alt(void)  { return s_odAlt; }
