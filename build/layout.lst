1620:Source/render/layout.c **** /* ════════════════════════════════
1621:Source/render/layout.c ****  * Part 2: state accessors, Layout.draw, eviction, on-demand overlay.
1622:Source/render/layout.c ****  * ════════════════════════════════
1623:Source/render/layout.c **** 
1624:Source/render/layout.c **** int layout_get_total_height(void) { return g_totalHeight; }
1625:Source/render/layout.c **** int layout_get_item_count(void) { return g_itemCount; }
1626:Source/render/layout.c **** 
1627:Source/render/layout.c **** const LayoutItem *layout_item_at(int index)
1628:Source/render/layout.c **** {
1629:Source/render/layout.c ****     if (index < 0 || index >= g_itemCount)
1630:Source/render/layout.c ****     {
1631:Source/render/layout.c ****         return NULL;
1632:Source/render/layout.c ****     }
1633:Source/render/layout.c ****     return g_items[index];
1634:Source/render/layout.c **** }
1635:Source/render/layout.c **** 
1636:Source/render/layout.c **** const LayoutItem *layout_get_selected_input(void) { return g_selectedInput; }
1637:Source/render/layout.c **** void layout_set_selected_input(const LayoutItem *item)
1638:Source/render/layout.c **** {
1639:Source/render/layout.c ****     g_selectedInput = (LayoutItem *)item;
1640:Source/render/layout.c **** }
1641:Source/render/layout.c **** 
1642:Source/render/layout.c **** /* ── layout_set_input_value ──────────────────────
1643:Source/render/layout.c **** /* Port of the Lua reference's activeInputField.value = entered: in Lua the
1644:Source/render/layout.c ****  * render item IS the block, so a single assignment made typed text visible to
1645:Source/render/layout.c ****  * the renderer and the submit path. In C the LayoutItem and DocBlock are
1646:Source/render/layout.c ****  * separate, so the item keeps its own owned copy of the value. The item's
1647:Source/render/layout.c ****  * value pointer is replaced (old owned copy freed); block->value stays
1648:Source/render/layout.c ****  * untouched — form submission reads through form_item_value() which prefers
1649:Source/render/layout.c ****  * the live item value. */
1650:Source/render/layout.c **** void layout_set_input_value(const LayoutItem *item, const char *text)
1651:Source/render/layout.c **** {
1652:Source/render/layout.c ****     if (!item)
1653:Source/render/layout.c ****     {
1654:Source/render/layout.c ****         return;
1655:Source/render/layout.c ****     }
1656:Source/render/layout.c ****     LayoutItem *it = (LayoutItem *)item;
1657:Source/render/layout.c ****     char *owned = text ? strdup(text) : NULL;
1658:Source/render/layout.c ****     if (it->ownedValue)
1659:Source/render/layout.c ****     {
1660:Source/render/layout.c ****         free(it->ownedValue);
1661:Source/render/layout.c ****     }
1662:Source/render/layout.c ****     it->ownedValue = owned;
1663:Source/render/layout.c ****     it->value = owned ? owned : "";
1664:Source/render/layout.c **** }
1665:Source/render/layout.c **** int layout_get_on_demand_consumed(void) { return g_onDemandConsumed; }
1666:Source/render/layout.c **** void layout_clear_on_demand_consumed(void) { g_onDemandConsumed = 0; }
1667:Source/render/layout.c **** const char *layout_get_hovered_image_src(void)
1668:Source/render/layout.c **** {
1669:Source/render/layout.c ****     return g_hasHoveredImage ? g_hoveredImageSrc : NULL;
1670:Source/render/layout.c **** }
1671:Source/render/layout.c **** 
1672:Source/render/layout.c **** static int od_requested(const char *src)
1673:Source/render/layout.c **** {
1674:Source/render/layout.c ****     if (!src)
1675:Source/render/layout.c ****     {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccYPBTYH.s 			page 32


1676:Source/render/layout.c ****         return 0;
1677:Source/render/layout.c ****     }
1678:Source/render/layout.c ****     for (int i = 0; i < g_odRequestedCount; i++)
1679:Source/render/layout.c ****     {
1680:Source/render/layout.c ****         if (strcmp(g_odRequested[i], src) == 0)
1681:Source/render/layout.c ****         {
1682:Source/render/layout.c ****             return 1;
1683:Source/render/layout.c ****         }
1684:Source/render/layout.c ****     }
1685:Source/render/layout.c ****     return 0;
1686:Source/render/layout.c **** }
1687:Source/render/layout.c **** 
1688:Source/render/layout.c **** static void od_request(const char *src)
1689:Source/render/layout.c **** {
1690:Source/render/layout.c ****     if (!src || od_requested(src))
1691:Source/render/layout.c ****     {
1692:Source/render/layout.c ****         return;
1693:Source/render/layout.c ****     }
1694:Source/render/layout.c ****     if (g_odRequestedCount < ONDEMAND_MAP_MAX)
1695:Source/render/layout.c ****     {
1696:Source/render/layout.c ****         snprintf(g_odRequested[g_odRequestedCount++], 512, "%s", src);
1697:Source/render/layout.c ****     }
1698:Source/render/layout.c **** }
1699:Source/render/layout.c **** 
1700:Source/render/layout.c **** static void od_unrequest(const char *src)
1701:Source/render/layout.c **** {
1702:Source/render/layout.c ****     for (int i = 0; i < g_odRequestedCount; i++)
1703:Source/render/layout.c ****     {
1704:Source/render/layout.c ****         if (strcmp(g_odRequested[i], src) == 0)
1705:Source/render/layout.c ****         {
1706:Source/render/layout.c ****             for (int j = i + 1; j < g_odRequestedCount; j++)
1707:Source/render/layout.c ****             {
1708:Source/render/layout.c ****                 memcpy(g_odRequested[j - 1], g_odRequested[j], 512);
1709:Source/render/layout.c ****             }
1710:Source/render/layout.c ****             g_odRequestedCount--;
1711:Source/render/layout.c ****             return;
1712:Source/render/layout.c ****         }
1713:Source/render/layout.c ****     }
1714:Source/render/layout.c **** }
1715:Source/render/layout.c **** 
1716:Source/render/layout.c **** static int image_mode(void)
1717:Source/render/layout.c **** {
1718:Source/render/layout.c ****     const char *s = storage_setting_str("imageMode");
