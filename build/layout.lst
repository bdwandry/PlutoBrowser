1725:Source/render/layout.c ****  * C fillEllipse bounding box (x, y, 2r+1, 2r+1). */
1726:Source/render/layout.c **** static void fill_circle_at(int cx, int cy, int r, LCDColor color)
1727:Source/render/layout.c **** {
1728:Source/render/layout.c ****     g_pd->graphics->fillEllipse(cx - r, cy - r, r * 2 + 1, r * 2 + 1,
1729:Source/render/layout.c ****                                 0.f, 360.f, color);
1730:Source/render/layout.c **** }
