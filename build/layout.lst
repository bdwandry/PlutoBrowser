 541:src/render/layout.c **** int  layout_on_demand_consumed(void)         { return s_odConsumed; }
 542:src/render/layout.c **** void layout_clear_on_demand_consumed(void)   { s_odConsumed = 0; }
 543:src/render/layout.c **** 
 544:src/render/layout.c **** PlutoOdAction layout_handle_on_demand_input(unsigned int pressed) {
 545:src/render/layout.c ****     if (!s_odSrc && !s_odHref && !s_odAlt) return OD_NONE;
 546:src/render/layout.c **** 
 547:src/render/layout.c ****     if (pressed & PLUTO_KBUTTON_A) {
 548:src/render/layout.c ****         char* src = s_odSrc;
 549:src/render/layout.c ****         s_odSrc = NULL;
 550:src/render/layout.c ****         s_odConsumed = 1;
 551:src/render/layout.c ****         if (src) {
 552:src/render/layout.c ****             if (id_is_decoded(src)) {
 553:src/render/layout.c ****                 id_evict(src);
 554:src/render/layout.c ****                 od_requested_remove(src);
 555:src/render/layout.c ****                 pluto_free(src);
 556:src/render/layout.c ****                 return OD_UNLOAD;
 557:src/render/layout.c ****             }
 558:src/render/layout.c ****             od_requested_add(src);
 559:src/render/layout.c ****             id_enqueue(src);
 560:src/render/layout.c ****             pluto_free(src);
 561:src/render/layout.c ****             return OD_VIEW;
 562:src/render/layout.c ****         }
