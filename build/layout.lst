 381:Source/render/layout.c **** void layout_expand_tab_columns(const char *line, char *out, size_t cap)
 382:Source/render/layout.c **** {
 383:Source/render/layout.c ****     if (!line)
 384:Source/render/layout.c ****     {
 385:Source/render/layout.c ****         if (cap)
 386:Source/render/layout.c ****         {
 387:Source/render/layout.c ****             out[0] = '\0';
 388:Source/render/layout.c ****         }
 389:Source/render/layout.c ****         return;
 390:Source/render/layout.c ****     }
 391:Source/render/layout.c ****     if (!strchr(line, '\t'))
 392:Source/render/layout.c ****     {
 393:Source/render/layout.c ****         snprintf(out, cap, "%s", line);
 394:Source/render/layout.c ****         return;
 395:Source/render/layout.c ****     }
 396:Source/render/layout.c ****     size_t o = 0;
 397:Source/render/layout.c ****     int col = 0;
 398:Source/render/layout.c ****     for (const char *p = line; *p; p++)
 399:Source/render/layout.c ****     {
 400:Source/render/layout.c ****         if (*p == '\t')
 401:Source/render/layout.c ****         {
 402:Source/render/layout.c ****             int pad = TAB_COLUMNS - (col % TAB_COLUMNS);
 403:Source/render/layout.c ****             for (int i = 0; i < pad && o + 1 < cap; i++)
 404:Source/render/layout.c ****             {
 405:Source/render/layout.c ****                 out[o++] = ' ';
 406:Source/render/layout.c ****             }
 407:Source/render/layout.c ****             col += pad;
 408:Source/render/layout.c ****         }
 409:Source/render/layout.c ****         else
 410:Source/render/layout.c ****         {
 411:Source/render/layout.c ****             if (o + 1 < cap)
 412:Source/render/layout.c ****             {
 413:Source/render/layout.c ****                 out[o++] = *p;
 414:Source/render/layout.c ****             }
 415:Source/render/layout.c ****             col++;
 416:Source/render/layout.c ****         }
 417:Source/render/layout.c ****     }
 418:Source/render/layout.c ****     out[o] = '\0';
 419:Source/render/layout.c **** }
