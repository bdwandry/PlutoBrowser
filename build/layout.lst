 544:Source/render/layout.c **** 
 545:Source/render/layout.c **** PlutoOdAction layout_handle_on_demand_input(unsigned int pressed) {
 546:Source/render/layout.c ****     if (!s_odSrc && !s_odHref && !s_odAlt) return OD_NONE;
 547:Source/render/layout.c **** 
 548:Source/render/layout.c ****     if (pressed & PLUTO_KBUTTON_A) {
 549:Source/render/layout.c ****         char* src = s_odSrc;
 550:Source/render/layout.c ****         s_odSrc = NULL;
 551:Source/render/layout.c ****         s_odConsumed = 1;
 552:Source/render/layout.c ****         if (src) {
 553:Source/render/layout.c ****             if (id_is_decoded(src)) {
 554:Source/render/layout.c ****                 id_evict(src);
 555:Source/render/layout.c ****                 od_requested_remove(src);
 556:Source/render/layout.c ****                 pluto_free(src);
 557:Source/render/layout.c ****                 return OD_UNLOAD;
 558:Source/render/layout.c ****             }
 559:Source/render/layout.c ****             od_requested_add(src);
 560:Source/render/layout.c ****             id_enqueue(src);
 561:Source/render/layout.c ****             pluto_free(src);
