 365:Source/render/layout.c **** static int tab_advance(LCDFont *font, int runningWidth)
 366:Source/render/layout.c **** {
 367:Source/render/layout.c ****     int spaceW = measure(font, " ");
 368:Source/render/layout.c ****     if (spaceW <= 0)
 369:Source/render/layout.c ****     {
 370:Source/render/layout.c ****         spaceW = 8;
 371:Source/render/layout.c ****     }
 372:Source/render/layout.c ****     int tabPx = TAB_COLUMNS * spaceW;
 373:Source/render/layout.c ****     int toTab = tabPx - (runningWidth % tabPx);
 374:Source/render/layout.c ****     if (toTab <= 0)
 375:Source/render/layout.c ****     {
 376:Source/render/layout.c ****         toTab = tabPx;
 377:Source/render/layout.c ****     }
 378:Source/render/layout.c ****     return toTab;
 379:Source/render/layout.c **** }
