1216:src/render/layout.c **** static void draw_bitmap_fit(struct LCDBitmap* bmp, int x, int drawY,
1217:src/render/layout.c ****                             int w, int h) {
1218:src/render/layout.c ****     int iw = 0, ih = 0, rb = 0;
1219:src/render/layout.c ****     uint8_t* mask = NULL;
1220:src/render/layout.c ****     uint8_t* dat = NULL;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccF3LIbn.s 			page 24


1221:src/render/layout.c ****     s_pd->graphics->getBitmapData(bmp, &iw, &ih, &rb, &mask, &dat);
1222:src/render/layout.c ****     if (iw > 0 && ih > 0) {
1223:src/render/layout.c ****         float scx = (float)w / (float)iw;
1224:src/render/layout.c ****         float scy = (float)h / (float)ih;
1225:src/render/layout.c ****         float scale = scx < scy ? scx : scy;
1226:src/render/layout.c ****         int dw = (int)floorf((float)iw * scale);
1227:src/render/layout.c ****         int dh = (int)floorf((float)ih * scale);
1228:src/render/layout.c ****         int dx = x + floordiv2(w - dw);
1229:src/render/layout.c ****         int dy = drawY + floordiv2(h - dh);
1230:src/render/layout.c ****         s_pd->graphics->drawScaledBitmap(bmp, dx, dy, scale, scale);
1231:src/render/layout.c ****     } else {
1232:src/render/layout.c ****         s_pd->graphics->drawBitmap(bmp, x, drawY, kBitmapUnflipped);
1233:src/render/layout.c ****     }
1234:src/render/layout.c **** }
