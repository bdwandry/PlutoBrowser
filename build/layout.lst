 126:Source/render/layout.c **** static void to_roman(int n, char* out, size_t cap) {
 127:Source/render/layout.c ****     static const struct { int v; const char* s; } map[] = {
 128:Source/render/layout.c ****         {1000,"M"},{900,"CM"},{500,"D"},{400,"CD"},{100,"C"},{90,"XC"},
 129:Source/render/layout.c ****         {50,"L"},{40,"XL"},{10,"X"},{9,"IX"},{5,"V"},{4,"IV"},{1,"I"}
 130:Source/render/layout.c ****     };
 131:Source/render/layout.c ****     if (n <= 0 || n > 3999) {
 132:Source/render/layout.c ****         snprintf(out, cap, "%d", n);   /* Lua tostring(n): prints as-is */
 133:Source/render/layout.c ****         return;
 134:Source/render/layout.c ****     }
 135:Source/render/layout.c ****     size_t k = 0;
 136:Source/render/layout.c ****     for (size_t i = 0; i < sizeof(map)/sizeof(map[0]) && k < cap - 1; i++) {
 137:Source/render/layout.c ****         while (n >= map[i].v && k < cap - 1) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccLIqTMw.s 			page 5


 138:Source/render/layout.c ****             size_t l = strlen(map[i].s);
 139:Source/render/layout.c ****             if (k + l >= cap) return;
 140:Source/render/layout.c ****             memcpy(out + k, map[i].s, l);
 141:Source/render/layout.c ****             k += l;
 142:Source/render/layout.c ****             n -= map[i].v;
 143:Source/render/layout.c ****         }
 144:Source/render/layout.c ****     }
 145:Source/render/layout.c ****     out[k] = '\0';
 146:Source/render/layout.c **** }
 147:Source/render/layout.c **** 
 148:Source/render/layout.c **** static void to_alpha(int n, char* out, size_t cap) {
 149:Source/render/layout.c ****     char tmp[40];
 150:Source/render/layout.c ****     size_t k = 0;
 151:Source/render/layout.c ****     while (n > 0 && k < sizeof(tmp)) {
 152:Source/render/layout.c ****         int rem = (n - 1) % 26;
 153:Source/render/layout.c ****         tmp[k++] = (char)('a' + rem);
 154:Source/render/layout.c ****         n = (n - 1) / 26;
 155:Source/render/layout.c ****     }
 156:Source/render/layout.c ****     if (k == 0 || k >= cap) { snprintf(out, cap, "1"); return; }
 157:Source/render/layout.c ****     for (size_t i = 0; i < k; i++) out[i] = tmp[k - 1 - i];
 158:Source/render/layout.c ****     out[k] = '\0';
 159:Source/render/layout.c **** }
