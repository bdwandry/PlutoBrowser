2581:Source/render/layout.c **** void layout_evict_offscreen(int scrollY)
2582:Source/render/layout.c **** {
2583:Source/render/layout.c ****     if (image_mode() != IMAGE_MODE_VIEWPORT)
2584:Source/render/layout.c ****     {
2585:Source/render/layout.c ****         return;
2586:Source/render/layout.c ****     }
2587:Source/render/layout.c ****     int viewTop = scrollY - 200;
2588:Source/render/layout.c ****     int viewBottom = scrollY + CONTENT_HEIGHT + 200;
2589:Source/render/layout.c ****     for (int i = 0; i < g_itemCount; i++)
2590:Source/render/layout.c ****     {
2591:Source/render/layout.c ****         const LayoutItem *item = g_items[i];
2592:Source/render/layout.c ****         if (item->type == LRI_IMAGE && item->src)
2593:Source/render/layout.c ****         {
2594:Source/render/layout.c ****             if (item->y + item->h < viewTop || item->y > viewBottom)
2595:Source/render/layout.c ****             {
2596:Source/render/layout.c ****                 imgdec_evict(item->src);
2597:Source/render/layout.c ****             }
2598:Source/render/layout.c ****         }
2599:Source/render/layout.c ****     }
2600:Source/render/layout.c **** }
2601:Source/render/layout.c **** 
