 118:Source/render/layout.c **** /* Build error parity: the reference's table branch raises on percent widths
 119:Source/render/layout.c ****  * (tonumber(string.gsub(w,"%%","")) passes gsub's replacement COUNT as
 120:Source/render/layout.c ****  * tonumber's base → "base out of range" error). CometBrowser's callers wrap
 121:Source/render/layout.c ****  * Layout.build in pcall and turn the error into a "Layout Error" page, so a
 122:Source/render/layout.c ****  * percent-width table must abort the build, not silently lay out. */
 123:Source/render/layout.c **** static int g_buildError = 0;
