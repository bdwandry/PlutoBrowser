 466:Source/render/layout.c **** /* convenience wrapper matching the common Lua call shape */
 467:Source/render/layout.c **** static int flow_paragraph(const DocBlock* b, int startX, int maxW, int startY,
 468:Source/render/layout.c ****                           int invert, int forceBold, int forceBoldFont) {
 469:Source/render/layout.c ****     BrkLines ls;
 470:Source/render/layout.c ****     int lineH = 16;
 471:Source/render/layout.c ****     brk_break(b->inlines, b->nInlines, maxW,
 472:Source/render/layout.c ****               forceBoldFont ? style_get_body_font(1, 0, NULL) : NULL,
 473:Source/render/layout.c ****               forceBoldFont, 0, &ls, &lineH);
 474:Source/render/layout.c ****     int endY = emit_flow(&ls, lineH, startX, maxW,
 475:Source/render/layout.c ****                          normalize_align(b->align), startY, invert, forceBold);
 476:Source/render/layout.c ****     brk_free(&ls);
 477:Source/render/layout.c ****     return endY;
 478:Source/render/layout.c **** }
