1255:Source/render/layout.c **** static void table_box_paint(const LItem* it, int scrollY) {
1256:Source/render/layout.c ****     int drawY = it->y - scrollY;
1257:Source/render/layout.c ****     if (!(drawY + it->h >= PLUTO_CONTENT_Y && drawY <= PLUTO_SCREEN_HEIGHT))
1258:Source/render/layout.c ****         return;
1259:Source/render/layout.c **** 
1260:Source/render/layout.c ****     if (it->border) {   /* Lua: border ~= false */
1261:Source/render/layout.c ****         s_pd->graphics->fillRoundRect(it->x, drawY, it->w, it->h, 3,
1262:Source/render/layout.c ****                                       kColorWhite);
1263:Source/render/layout.c ****         s_pd->graphics->drawRoundRect(it->x, drawY, it->w, it->h, 3, 1,
1264:Source/render/layout.c ****                                       kColorBlack);
1265:Source/render/layout.c ****     }
