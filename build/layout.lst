 489:src/render/layout.c **** void od_requested_clear(void) {
 490:src/render/layout.c ****     for (int i = 0; i < s_nReq; i++) pluto_free(s_odRequested[i]);
 491:src/render/layout.c ****     pluto_free(s_odRequested);
 492:src/render/layout.c ****     s_odRequested = NULL; s_nReq = 0; s_capReq = 0;
 493:src/render/layout.c **** }
 494:src/render/layout.c **** 
 495:src/render/layout.c **** static void od_requested_add(const char* src) {
 496:src/render/layout.c ****     if (layout_on_demand_requested(src)) return;
 497:src/render/layout.c ****     if (s_nReq == s_capReq) {
 498:src/render/layout.c ****         s_capReq = s_capReq ? s_capReq * 2 : 8;
 499:src/render/layout.c ****         s_odRequested = (char**)pluto_realloc(s_odRequested,
 500:src/render/layout.c ****                                         sizeof(char*) * (size_t)s_capReq);
 501:src/render/layout.c ****     }
 502:src/render/layout.c ****     s_odRequested[s_nReq++] = pluto_strdup(src);
 503:src/render/layout.c **** }
 504:src/render/layout.c **** 
 505:src/render/layout.c **** int layout_on_demand_requested(const char* src) {
 506:src/render/layout.c ****     if (!src) return 0;
 507:src/render/layout.c ****     for (int i = 0; i < s_nReq; i++)
 508:src/render/layout.c ****         if (s_odRequested[i] && !strcmp(s_odRequested[i], src)) return 1;
 509:src/render/layout.c ****     return 0;
 510:src/render/layout.c **** }
 511:src/render/layout.c **** 
 512:src/render/layout.c **** static void od_requested_remove(const char* src) {
 513:src/render/layout.c ****     for (int i = 0; i < s_nReq; i++) {
 514:src/render/layout.c ****         if (s_odRequested[i] && !strcmp(s_odRequested[i], src)) {
 515:src/render/layout.c ****             pluto_free(s_odRequested[i]);
 516:src/render/layout.c ****             s_odRequested[i] = s_odRequested[--s_nReq];
 517:src/render/layout.c ****             return;
 518:src/render/layout.c ****         }
 519:src/render/layout.c ****     }
 520:src/render/layout.c **** }
