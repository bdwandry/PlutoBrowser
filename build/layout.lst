 522:src/render/layout.c **** int layout_has_on_demand_overlay(void) { return s_odSrc != NULL; }
 523:src/render/layout.c **** 
 524:src/render/layout.c **** void layout_show_on_demand_overlay(const char* src, const char* href,
 525:src/render/layout.c ****                                    const char* alt) {
 526:src/render/layout.c ****     pluto_free(s_odSrc); pluto_free(s_odHref); pluto_free(s_odAlt);
 527:src/render/layout.c ****     s_odSrc  = (src  && src[0])  ? pluto_strdup(src)  : NULL;
 528:src/render/layout.c ****     s_odHref = (href && href[0]) ? pluto_strdup(href) : NULL;
 529:src/render/layout.c ****     s_odAlt  = alt ? pluto_strdup(alt) : pluto_strdup("Image");
 530:src/render/layout.c **** }
 531:src/render/layout.c **** 
 532:src/render/layout.c **** void layout_clear_on_demand_overlay(void) {
 533:src/render/layout.c ****     pluto_free(s_odSrc); pluto_free(s_odHref); pluto_free(s_odAlt);
 534:src/render/layout.c ****     s_odSrc = s_odHref = s_odAlt = NULL;
 535:src/render/layout.c **** }
