 185:Source/render/layout.c **** /* pixel advance needed to reach the next TAB_COLUMNS stop from runningWidth */
 186:Source/render/layout.c **** static int tab_advance(PlutoFont* font, int runningWidth) {
 187:Source/render/layout.c ****     int spaceW = style_get_text_width(font, " ");
 188:Source/render/layout.c ****     if (spaceW <= 0) spaceW = 8;
 189:Source/render/layout.c ****     int tabPx = TAB_COLUMNS * spaceW;
 190:Source/render/layout.c ****     int toTab = tabPx - (runningWidth % tabPx);
 191:Source/render/layout.c ****     if (toTab <= 0) toTab = tabPx;
 192:Source/render/layout.c ****     return toTab;
 193:Source/render/layout.c **** }
