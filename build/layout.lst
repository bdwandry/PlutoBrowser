 281:src/render/layout.c **** static void brk_break(const DocInline* inlines, size_t nInlines, int maxW,
 282:src/render/layout.c ****                       PlutoFont* forcedFont, int forcedBold, int forcedLH,
 283:src/render/layout.c ****                       BrkLines* out, int* outLineH) {
 284:src/render/layout.c ****     memset(out, 0, sizeof(*out));
 285:src/render/layout.c ****     BrkLine cur;
 286:src/render/layout.c ****     memset(&cur, 0, sizeof(cur));
 287:src/render/layout.c ****     int firstWord = 1;
 288:src/render/layout.c ****     int lineH = forcedFont ? (forcedLH > 0 ? forcedLH : 16) : 16;
 289:src/render/layout.c **** 
 290:src/render/layout.c ****     for (size_t ii = 0; ii < nInlines; ii++) {
 291:src/render/layout.c ****         const DocInline* inl = &inlines[ii];
 292:src/render/layout.c ****         if (inl->type == DIT_BR) {
 293:src/render/layout.c ****             brk_push_line(out, &cur);
 294:src/render/layout.c ****             firstWord = 1;
 295:src/render/layout.c ****             continue;
 296:src/render/layout.c ****         }
 297:src/render/layout.c ****         PlutoFont* font;
 298:src/render/layout.c ****         int lh;
 299:src/render/layout.c ****         if (forcedFont) {
 300:src/render/layout.c ****             font = forcedFont;
 301:src/render/layout.c ****             lh   = forcedLH > 0 ? forcedLH : 16;
 302:src/render/layout.c ****         } else if (forcedBold) {
 303:src/render/layout.c ****             font = style_get_body_font(1, 0, NULL);
 304:src/render/layout.c ****             lh   = 16;
 305:src/render/layout.c ****         } else {
 306:src/render/layout.c ****             font = style_get_inline_font(inl->bold, inl->code, inl->small,
 307:src/render/layout.c ****                                          inl->sub, inl->sup, inl->big, NULL);
 308:src/render/layout.c ****             lh   = 16;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccF3LIbn.s 			page 8


 309:src/render/layout.c ****         }
 310:src/render/layout.c ****         if (lh > lineH) lineH = lh;
 311:src/render/layout.c **** 
 312:src/render/layout.c ****         const char* text = inl->text ? inl->text : "";
 313:src/render/layout.c ****         int n = (int)strlen(text);
 314:src/render/layout.c ****         int spaceW = style_get_text_width(font, " ");
 315:src/render/layout.c ****         if (spaceW <= 0) spaceW = 8;
 316:src/render/layout.c **** 
 317:src/render/layout.c ****         int pos = 0;
 318:src/render/layout.c ****         while (pos < n) {
 319:src/render/layout.c ****             while (pos < n && is_space(text[pos])) pos++;
 320:src/render/layout.c ****             if (pos >= n) break;
 321:src/render/layout.c **** 
 322:src/render/layout.c ****             int ws = pos;
 323:src/render/layout.c ****             while (pos < n && !is_space(text[pos])) pos++;
 324:src/render/layout.c ****             int wwlen = pos - ws;
 325:src/render/layout.c ****             int ww = style_get_text_width(font, meas_slice(text + ws, wwlen));
 326:src/render/layout.c **** 
 327:src/render/layout.c ****             /* whitespace run following this word */
 328:src/render/layout.c ****             int gap = 0;
 329:src/render/layout.c ****             int we = pos;
 330:src/render/layout.c ****             while (we < n && is_space(text[we])) we++;
 331:src/render/layout.c ****             if (we > pos) {
 332:src/render/layout.c ****                 int hasTab = 0;
 333:src/render/layout.c ****                 for (int t = pos; t < we; t++)
 334:src/render/layout.c ****                     if (text[t] == '\t') { hasTab = 1; break; }
 335:src/render/layout.c ****                 gap = hasTab ? tab_advance(font, cur.width + ww) : spaceW;
 336:src/render/layout.c ****             }
 337:src/render/layout.c **** 
 338:src/render/layout.c ****             int aw = ww + gap;
 339:src/render/layout.c ****             if (cur.width + aw > maxW && !firstWord) {
 340:src/render/layout.c ****                 brk_push_line(out, &cur);
 341:src/render/layout.c ****                 firstWord = 1;
 342:src/render/layout.c ****                 aw = ww;
 343:src/render/layout.c ****                 gap = 0;
 344:src/render/layout.c ****             }
 345:src/render/layout.c ****             BrkWord w = { text + ws, wwlen, font, ww, ww + gap, inl };
 346:src/render/layout.c ****             brk_push_word(&cur, w);
 347:src/render/layout.c ****             cur.width += aw;
 348:src/render/layout.c ****             firstWord = 0;
 349:src/render/layout.c ****             pos = we;
 350:src/render/layout.c ****         }
 351:src/render/layout.c ****     }
 352:src/render/layout.c ****     brk_push_line(out, &cur);
 353:src/render/layout.c ****     if (outLineH) *outLineH = lineH;
 354:src/render/layout.c **** }
