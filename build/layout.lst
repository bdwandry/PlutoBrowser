 340:Source/render/layout.c ****         }
 341:Source/render/layout.c ****     }
 342:Source/render/layout.c ****     else if (markerType == 'i')
 343:Source/render/layout.c ****     {
 344:Source/render/layout.c ****         layout_to_roman(number, buf, sizeof(buf));
 345:Source/render/layout.c ****     }
 346:Source/render/layout.c ****     else if (markerType == 'I')
 347:Source/render/layout.c ****     {
 348:Source/render/layout.c ****         layout_to_roman(number, buf, sizeof(buf));
 349:Source/render/layout.c ****         for (char *p = buf; *p; p++)
 350:Source/render/layout.c ****         {
 351:Source/render/layout.c ****             *p = (char)toupper((unsigned char)*p);
 352:Source/render/layout.c ****         }
 353:Source/render/layout.c ****     }
 354:Source/render/layout.c ****     else
 355:Source/render/layout.c ****     {
 356:Source/render/layout.c ****         snprintf(buf, sizeof(buf), "%d", number == 0 ? 1 : number);
 357:Source/render/layout.c ****     }
 358:Source/render/layout.c ****     snprintf(out, cap, "%s", buf);
 359:Source/render/layout.c **** }
