1184:Source/render/layout.c ****     dt(text, x, y);
1185:Source/render/layout.c **** }
1186:Source/render/layout.c **** 
1187:Source/render/layout.c **** /* growable scratch so composed cell texts can be built without mallocs */
1188:Source/render/layout.c **** static char* s_scratch = NULL;
1189:Source/render/layout.c **** static size_t s_scratchCap = 0;
1190:Source/render/layout.c **** 
1191:Source/render/layout.c **** static char* scratch_reserve(size_t n) {
1192:Source/render/layout.c ****     if (n + 1 > s_scratchCap) {
1193:Source/render/layout.c ****         s_scratchCap = n + 128;
1194:Source/render/layout.c ****         s_scratch = (char*)pluto_realloc(s_scratch, s_scratchCap);
1195:Source/render/layout.c ****     }
1196:Source/render/layout.c ****     return s_scratch;
1197:Source/render/layout.c **** }
1198:Source/render/layout.c **** 
1199:Source/render/layout.c **** /* collapse whitespace runs to single spaces, trim ends (Lua gsub pair) */
1200:Source/render/layout.c **** static const char* squash_text(const char* s) {
1201:Source/render/layout.c ****     if (!s) return "";
1202:Source/render/layout.c ****     size_t n = strlen(s);
1203:Source/render/layout.c ****     char* out = scratch_reserve(n);
1204:Source/render/layout.c ****     size_t k = 0;
1205:Source/render/layout.c ****     int inWs = 0;
