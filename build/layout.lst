2605:Source/render/layout.c ****     {
2606:Source/render/layout.c ****         return;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccYPBTYH.s 			page 104


2607:Source/render/layout.c ****     }
2608:Source/render/layout.c ****     /* Track the CURRENT hover even on first entry (Lua stores
2609:Source/render/layout.c ****      * Layout.hoveredImageSrc every frame; without this the C port never
2610:Source/render/layout.c ****      * marked the hovered image, so the evict branch below could never fire
2611:Source/render/layout.c ****      * and mouse-off unloads never happened). */
2612:Source/render/layout.c ****     if (currentHoveredSrc && currentHoveredSrc[0])
2613:Source/render/layout.c ****     {
