 117:src/render/layout.c **** static const char* normalize_align(const char* a) {
 118:src/render/layout.c ****     if (!a) return NULL;
 119:src/render/layout.c ****     if (!strcmp(a, "center")) return "center";
 120:src/render/layout.c ****     if (!strcmp(a, "right"))  return "right";
 121:src/render/layout.c ****     if (!strcmp(a, "left"))   return "left";
 122:src/render/layout.c ****     return NULL;   /* document stores pre-lowered statics */
 123:src/render/layout.c **** }
 124:src/render/layout.c **** 
 125:src/render/layout.c **** static void to_roman(int n, char* out, size_t cap) {
 126:src/render/layout.c ****     static const struct { int v; const char* s; } map[] = {
 127:src/render/layout.c ****         {1000,"M"},{900,"CM"},{500,"D"},{400,"CD"},{100,"C"},{90,"XC"},
 128:src/render/layout.c ****         {50,"L"},{40,"XL"},{10,"X"},{9,"IX"},{5,"V"},{4,"IV"},{1,"I"}
 129:src/render/layout.c ****     };
 130:src/render/layout.c ****     if (n <= 0 || n > 3999) {
 131:src/render/layout.c ****         snprintf(out, cap, "%d", n);   /* Lua tostring(n): prints as-is */
 132:src/render/layout.c ****         return;
 133:src/render/layout.c ****     }
 134:src/render/layout.c ****     size_t k = 0;
 135:src/render/layout.c ****     for (size_t i = 0; i < sizeof(map)/sizeof(map[0]) && k < cap - 1; i++) {
 136:src/render/layout.c ****         while (n >= map[i].v && k < cap - 1) {
 137:src/render/layout.c ****             size_t l = strlen(map[i].s);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccF3LIbn.s 			page 5


 138:src/render/layout.c ****             if (k + l >= cap) return;
 139:src/render/layout.c ****             memcpy(out + k, map[i].s, l);
 140:src/render/layout.c ****             k += l;
 141:src/render/layout.c ****             n -= map[i].v;
 142:src/render/layout.c ****         }
 143:src/render/layout.c ****     }
 144:src/render/layout.c ****     out[k] = '\0';
 145:src/render/layout.c **** }
 146:src/render/layout.c **** 
 147:src/render/layout.c **** static void to_alpha(int n, char* out, size_t cap) {
 148:src/render/layout.c ****     char tmp[40];
 149:src/render/layout.c ****     size_t k = 0;
 150:src/render/layout.c ****     while (n > 0 && k < sizeof(tmp)) {
 151:src/render/layout.c ****         int rem = (n - 1) % 26;
 152:src/render/layout.c ****         tmp[k++] = (char)('a' + rem);
 153:src/render/layout.c ****         n = (n - 1) / 26;
 154:src/render/layout.c ****     }
 155:src/render/layout.c ****     if (k == 0 || k >= cap) { snprintf(out, cap, "1"); return; }
 156:src/render/layout.c ****     for (size_t i = 0; i < k; i++) out[i] = tmp[k - 1 - i];
 157:src/render/layout.c ****     out[k] = '\0';
 158:src/render/layout.c **** }
 159:src/render/layout.c **** 
 160:src/render/layout.c **** char* layout_ordered_marker(int number, const char* markerType) {
 161:src/render/layout.c ****     char buf[48];
 162:src/render/layout.c ****     /* callers resolve `number or 1` before this point (Lua parity) */
 163:src/render/layout.c ****     if (!markerType || !markerType[0] || !strcmp(markerType, "1")) {
 164:src/render/layout.c ****         snprintf(buf, sizeof(buf), "%d", number);
 165:src/render/layout.c ****         return pluto_strdup(buf);
 166:src/render/layout.c ****     }
 167:src/render/layout.c ****     if (!strcmp(markerType, "a")) { to_alpha(number, buf, sizeof(buf)); return pluto_strdup(buf); }
 168:src/render/layout.c ****     if (!strcmp(markerType, "A")) {
 169:src/render/layout.c ****         to_alpha(number, buf, sizeof(buf));
 170:src/render/layout.c ****         for (char* p = buf; *p; p++) if (*p >= 'a' && *p <= 'z') *p = (char)(*p - 32);
 171:src/render/layout.c ****         return pluto_strdup(buf);
 172:src/render/layout.c ****     }
 173:src/render/layout.c ****     if (!strcmp(markerType, "i") || !strcmp(markerType, "I")) {
 174:src/render/layout.c ****         to_roman(number, buf, sizeof(buf));
 175:src/render/layout.c ****         if (markerType[0] == 'i')
 176:src/render/layout.c ****             for (char* p = buf; *p; p++)
 177:src/render/layout.c ****                 if (*p >= 'A' && *p <= 'Z') *p = (char)(*p + 32);
 178:src/render/layout.c ****         return pluto_strdup(buf);
 179:src/render/layout.c ****     }
 180:src/render/layout.c ****     snprintf(buf, sizeof(buf), "%d", number);
 181:src/render/layout.c ****     return pluto_strdup(buf);
 182:src/render/layout.c **** }
 183:src/render/layout.c **** 
 184:src/render/layout.c **** /* pixel advance needed to reach the next TAB_COLUMNS stop from runningWidth */
 185:src/render/layout.c **** static int tab_advance(PlutoFont* font, int runningWidth) {
 186:src/render/layout.c ****     int spaceW = style_get_text_width(font, " ");
 187:src/render/layout.c ****     if (spaceW <= 0) spaceW = 8;
 188:src/render/layout.c ****     int tabPx = TAB_COLUMNS * spaceW;
 189:src/render/layout.c ****     int toTab = tabPx - (runningWidth % tabPx);
 190:src/render/layout.c ****     if (toTab <= 0) toTab = tabPx;
 191:src/render/layout.c ****     return toTab;
 192:src/render/layout.c **** }
 193:src/render/layout.c **** 
 194:src/render/layout.c **** char* layout_expand_tab_columns(const char* line) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccF3LIbn.s 			page 6


 195:src/render/layout.c ****     if (!line || !strchr(line, '\t')) return pluto_strdup(line ? line : "");
 196:src/render/layout.c ****     size_t need = strlen(line) * TAB_COLUMNS + 1;
 197:src/render/layout.c ****     char* out = (char*)pluto_malloc(need);
 198:src/render/layout.c ****     size_t k = 0;
 199:src/render/layout.c ****     int col = 0;
 200:src/render/layout.c ****     for (const char* p = line; *p; p++) {
 201:src/render/layout.c ****         if (*p == '\t') {
 202:src/render/layout.c ****             int pad = TAB_COLUMNS - (col % TAB_COLUMNS);
 203:src/render/layout.c ****             for (int i = 0; i < pad; i++) out[k++] = ' ';
 204:src/render/layout.c ****             col += pad;
 205:src/render/layout.c ****         } else {
 206:src/render/layout.c ****             out[k++] = *p;
 207:src/render/layout.c ****             col++;
 208:src/render/layout.c ****         }
 209:src/render/layout.c ****     }
 210:src/render/layout.c ****     out[k] = '\0';
 211:src/render/layout.c ****     return out;
 212:src/render/layout.c **** }
