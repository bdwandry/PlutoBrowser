1736:Source/render/layout.c **** 
1737:Source/render/layout.c **** static void draw_placeholder_card(int x, int y, int w, int h)
1738:Source/render/layout.c **** {
1739:Source/render/layout.c ****     g_pd->graphics->fillRoundRect(x, y, w, h, 4, kColorWhite);
1740:Source/render/layout.c ****     g_pd->graphics->drawRoundRect(x, y, w, h, 4, 1, kColorBlack);
1741:Source/render/layout.c ****     for (int hx = x + 4; hx <= x + w - 4; hx += 10)
1742:Source/render/layout.c ****     {
1743:Source/render/layout.c ****         g_pd->graphics->drawLine(hx, y + 3, hx, y + h - 3, 1, kColorBlack);
1744:Source/render/layout.c ****     }
1745:Source/render/layout.c ****     int iconX = x + w / 2 - 8;
1746:Source/render/layout.c ****     int iconY = y + h / 2 - 6;
1747:Source/render/layout.c ****     g_pd->graphics->drawRoundRect(iconX, iconY, 16, 11, 2, 1, kColorBlack);
1748:Source/render/layout.c ****     fill_circle_at(iconX + 8, iconY + 5, 3, kColorBlack);
1749:Source/render/layout.c ****     draw_pixel(iconX + 13, iconY + 1, kColorBlack);
1750:Source/render/layout.c **** }
