 291:Source/render/layout.c **** void layout_to_roman(int n, char *out, size_t cap)
 292:Source/render/layout.c **** {
 293:Source/render/layout.c ****     /* Lua: if not n or n <= 0 or n > 3999 then return tostring(n or 1) */
 294:Source/render/layout.c ****     if (n <= 0 || n > 3999)
 295:Source/render/layout.c ****     {
 296:Source/render/layout.c ****         /* Lua tostring(n or 1): 0 is truthy → "0"; nil (not applicable here)
 297:Source/render/layout.c ****          * would give "1"; negative n passes through. */
 298:Source/render/layout.c ****         snprintf(out, cap, "%d", n);
 299:Source/render/layout.c ****         return;
 300:Source/render/layout.c ****     }
 301:Source/render/layout.c ****     static const int vals[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
 302:Source/render/layout.c ****     static const char *syms[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL",
 303:Source/render/layout.c ****                                  "X", "IX", "V", "IV", "I"};
 304:Source/render/layout.c ****     size_t o = 0;
 305:Source/render/layout.c ****     out[0] = '\0';
 306:Source/render/layout.c ****     char tmp[32];
 307:Source/render/layout.c ****     for (int i = 0; i < 13 && n > 0; i++)
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccYPBTYH.s 			page 8


 308:Source/render/layout.c ****     {
 309:Source/render/layout.c ****         while (n >= vals[i])
 310:Source/render/layout.c ****         {
 311:Source/render/layout.c ****             size_t sl = strlen(syms[i]);
 312:Source/render/layout.c ****             memcpy(tmp + o, syms[i], sl);
 313:Source/render/layout.c ****             o += sl;
 314:Source/render/layout.c ****             n -= vals[i];
 315:Source/render/layout.c ****         }
 316:Source/render/layout.c ****     }
 317:Source/render/layout.c ****     tmp[o] = '\0';
 318:Source/render/layout.c ****     snprintf(out, cap, "%s", tmp);
 319:Source/render/layout.c **** }
 320:Source/render/layout.c **** 
 321:Source/render/layout.c **** void layout_to_alpha(int n, char *out, size_t cap)
 322:Source/render/layout.c **** {
 323:Source/render/layout.c ****     char tmp[40];
 324:Source/render/layout.c ****     size_t o = 0;
 325:Source/render/layout.c ****     while (n > 0)
 326:Source/render/layout.c ****     {
 327:Source/render/layout.c ****         int rem = (n - 1) % 26;
 328:Source/render/layout.c ****         if (o < sizeof(tmp))
 329:Source/render/layout.c ****         {
 330:Source/render/layout.c ****             tmp[o++] = (char)('a' + rem);
 331:Source/render/layout.c ****         }
 332:Source/render/layout.c ****         n = (n - 1) / 26;
 333:Source/render/layout.c ****     }
 334:Source/render/layout.c ****     for (size_t i = 0; i < o / 2; i++)
 335:Source/render/layout.c ****     {
 336:Source/render/layout.c ****         char t = tmp[i];
 337:Source/render/layout.c ****         tmp[i] = tmp[o - 1 - i];
 338:Source/render/layout.c ****         tmp[o - 1 - i] = t;
 339:Source/render/layout.c ****     }
 340:Source/render/layout.c ****     tmp[o] = '\0';
 341:Source/render/layout.c ****     if (o == 0)
 342:Source/render/layout.c ****     {
 343:Source/render/layout.c ****         snprintf(out, cap, "1"); /* Lua: out ~= "" and out or "1" */
 344:Source/render/layout.c ****         return;
 345:Source/render/layout.c ****     }
 346:Source/render/layout.c ****     snprintf(out, cap, "%s", tmp);
 347:Source/render/layout.c **** }
