ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccLIqTMw.s 			page 24


1221:Source/render/layout.c ****     uint8_t* dat = NULL;
1222:Source/render/layout.c ****     s_pd->graphics->getBitmapData(bmp, &iw, &ih, &rb, &mask, &dat);
1223:Source/render/layout.c ****     if (iw > 0 && ih > 0) {
1224:Source/render/layout.c ****         float scx = (float)w / (float)iw;
1225:Source/render/layout.c ****         float scy = (float)h / (float)ih;
1226:Source/render/layout.c ****         float scale = scx < scy ? scx : scy;
1227:Source/render/layout.c ****         int dw = (int)floorf((float)iw * scale);
1228:Source/render/layout.c ****         int dh = (int)floorf((float)ih * scale);
1229:Source/render/layout.c ****         int dx = x + floordiv2(w - dw);
1230:Source/render/layout.c ****         int dy = drawY + floordiv2(h - dh);
1231:Source/render/layout.c ****         s_pd->graphics->drawScaledBitmap(bmp, dx, dy, scale, scale);
1232:Source/render/layout.c ****     } else {
1233:Source/render/layout.c ****         s_pd->graphics->drawBitmap(bmp, x, drawY, kBitmapUnflipped);
1234:Source/render/layout.c ****     }
1235:Source/render/layout.c **** }
