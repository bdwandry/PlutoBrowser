  69:Source/render/layout.c **** /* word-text arena: breakLines words live here until layout_clear().
  70:Source/render/layout.c ****  *
  71:Source/render/layout.c ****  * Implemented as a CHUNK LIST, not one growing buffer: LayoutItems borrow
  72:Source/render/layout.c ****  * word pointers for the lifetime of the layout, so the storage must NEVER
  73:Source/render/layout.c ****  * move. The previous single-buffer arena called realloc() on growth, which
  74:Source/render/layout.c ****  * invalidated every word pointer emitted before the growth — first-ever
  75:Source/render/layout.c ****  * layout built from an empty arena always grew (4096 → …) and the earliest
  76:Source/render/layout.c ****  * words rendered as garbage/underlines until the next full layout (whose
  77:Source/render/layout.c ****  * arena already had capacity) redrew them correctly. Chunked allocation
  78:Source/render/layout.c ****  * gives stable pointers for the whole build. */
  79:Source/render/layout.c **** typedef struct WordChunk
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccYPBTYH.s 			page 4


  80:Source/render/layout.c **** {
  81:Source/render/layout.c ****     struct WordChunk *next;
  82:Source/render/layout.c ****     size_t used;
  83:Source/render/layout.c ****     size_t cap;
  84:Source/render/layout.c ****     char data[]; /* flexible array member */
  85:Source/render/layout.c **** } WordChunk;
  86:Source/render/layout.c **** 
  87:Source/render/layout.c **** #define WORD_CHUNK_SIZE 16384
  88:Source/render/layout.c **** static WordChunk *g_wordChunks = NULL;
  89:Source/render/layout.c **** 
  90:Source/render/layout.c **** static const char *arena_word(const char *s)
  91:Source/render/layout.c **** {
  92:Source/render/layout.c ****     size_t n = strlen(s) + 1;
  93:Source/render/layout.c ****     if (n > WORD_CHUNK_SIZE)
  94:Source/render/layout.c ****     {
  95:Source/render/layout.c ****         return s; /* single word larger than a chunk: caller-owned fallback */
  96:Source/render/layout.c ****     }
  97:Source/render/layout.c ****     WordChunk *c = g_wordChunks;
  98:Source/render/layout.c ****     if (!c || c->used + n > c->cap)
  99:Source/render/layout.c ****     {
 100:Source/render/layout.c ****         c = (WordChunk *)malloc(sizeof(WordChunk) + WORD_CHUNK_SIZE);
 101:Source/render/layout.c ****         if (!c)
 102:Source/render/layout.c ****         {
 103:Source/render/layout.c ****             return s; /* fall back to caller-owned storage */
 104:Source/render/layout.c ****         }
 105:Source/render/layout.c ****         c->used = 0;
 106:Source/render/layout.c ****         c->cap = WORD_CHUNK_SIZE;
 107:Source/render/layout.c ****         c->next = g_wordChunks;
 108:Source/render/layout.c ****         g_wordChunks = c;
 109:Source/render/layout.c ****     }
 110:Source/render/layout.c ****     char *dst = c->data + c->used;
 111:Source/render/layout.c ****     memcpy(dst, s, n);
 112:Source/render/layout.c ****     c->used += n;
 113:Source/render/layout.c ****     return dst;
 114:Source/render/layout.c **** }
