1646:Source/render/layout.c **** static int od_requested(const char *src)
1647:Source/render/layout.c **** {
1648:Source/render/layout.c ****     if (!src)
1649:Source/render/layout.c ****     {
1650:Source/render/layout.c ****         return 0;
1651:Source/render/layout.c ****     }
1652:Source/render/layout.c ****     for (int i = 0; i < g_odRequestedCount; i++)
1653:Source/render/layout.c ****     {
1654:Source/render/layout.c ****         if (strcmp(g_odRequested[i], src) == 0)
1655:Source/render/layout.c ****         {
1656:Source/render/layout.c ****             return 1;
1657:Source/render/layout.c ****         }
1658:Source/render/layout.c ****     }
1659:Source/render/layout.c ****     return 0;
1660:Source/render/layout.c **** }
1661:Source/render/layout.c **** 
1662:Source/render/layout.c **** static void od_request(const char *src)
1663:Source/render/layout.c **** {
1664:Source/render/layout.c ****     if (!src || od_requested(src))
1665:Source/render/layout.c ****     {
1666:Source/render/layout.c ****         return;
1667:Source/render/layout.c ****     }
1668:Source/render/layout.c ****     if (g_odRequestedCount < ONDEMAND_MAP_MAX)
1669:Source/render/layout.c ****     {
1670:Source/render/layout.c ****         snprintf(g_odRequested[g_odRequestedCount++], 512, "%s", src);
1671:Source/render/layout.c ****     }
1672:Source/render/layout.c **** }
1673:Source/render/layout.c **** 
1674:Source/render/layout.c **** static void od_unrequest(const char *src)
1675:Source/render/layout.c **** {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccH8dkZG.s 			page 32


1676:Source/render/layout.c ****     for (int i = 0; i < g_odRequestedCount; i++)
1677:Source/render/layout.c ****     {
1678:Source/render/layout.c ****         if (strcmp(g_odRequested[i], src) == 0)
1679:Source/render/layout.c ****         {
1680:Source/render/layout.c ****             for (int j = i + 1; j < g_odRequestedCount; j++)
1681:Source/render/layout.c ****             {
1682:Source/render/layout.c ****                 memcpy(g_odRequested[j - 1], g_odRequested[j], 512);
1683:Source/render/layout.c ****             }
1684:Source/render/layout.c ****             g_odRequestedCount--;
1685:Source/render/layout.c ****             return;
1686:Source/render/layout.c ****         }
1687:Source/render/layout.c ****     }
1688:Source/render/layout.c **** }
