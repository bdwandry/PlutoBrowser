1616:Source/render/layout.c **** /* ── layout_set_input_value ──────────────────────
1617:Source/render/layout.c **** /* Port of the Lua reference's activeInputField.value = entered: in Lua the
1618:Source/render/layout.c ****  * render item IS the block, so a single assignment made typed text visible to
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccH8dkZG.s 			page 31


1619:Source/render/layout.c ****  * the renderer and the submit path. In C the LayoutItem and DocBlock are
1620:Source/render/layout.c ****  * separate, so the item keeps its own owned copy of the value. The item's
1621:Source/render/layout.c ****  * value pointer is replaced (old owned copy freed); block->value stays
1622:Source/render/layout.c ****  * untouched — form submission reads through form_item_value() which prefers
1623:Source/render/layout.c ****  * the live item value. */
1624:Source/render/layout.c **** void layout_set_input_value(const LayoutItem *item, const char *text)
1625:Source/render/layout.c **** {
1626:Source/render/layout.c ****     if (!item)
1627:Source/render/layout.c ****     {
1628:Source/render/layout.c ****         return;
1629:Source/render/layout.c ****     }
1630:Source/render/layout.c ****     LayoutItem *it = (LayoutItem *)item;
1631:Source/render/layout.c ****     char *owned = text ? strdup(text) : NULL;
1632:Source/render/layout.c ****     if (it->ownedValue)
1633:Source/render/layout.c ****     {
1634:Source/render/layout.c ****         free(it->ownedValue);
1635:Source/render/layout.c ****     }
1636:Source/render/layout.c ****     it->ownedValue = owned;
1637:Source/render/layout.c ****     it->value = owned ? owned : "";
1638:Source/render/layout.c **** }
1639:Source/render/layout.c **** int layout_get_on_demand_consumed(void) { return g_onDemandConsumed; }
1640:Source/render/layout.c **** void layout_clear_on_demand_consumed(void) { g_onDemandConsumed = 0; }
