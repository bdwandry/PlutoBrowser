 356:src/render/layout.c **** /* ── emitFlow ──────────────────────────�
 357:src/render/layout.c **** 
 358:src/render/layout.c **** static int floordiv2(int a) {           /* math.floor(a / 2) for any sign */
 359:src/render/layout.c ****     int q = a / 2;
 360:src/render/layout.c ****     if (a % 2 != 0 && a < 0) q--;
 361:src/render/layout.c ****     return q;
 362:src/render/layout.c **** }
 363:src/render/layout.c **** 
 364:src/render/layout.c **** /* growable link-rect text accumulator ("a b c" across merged words) */
 365:src/render/layout.c **** static char* mr_text_append(char** buf, size_t* len, size_t* cap,
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccF3LIbn.s 			page 9


 366:src/render/layout.c ****                             const char* word, int wlen) {
 367:src/render/layout.c ****     size_t add = (size_t)wlen + 1 /*space*/;
 368:src/render/layout.c ****     if (*len + add + 1 > *cap) {
 369:src/render/layout.c ****         *cap = (*len + add + 1) * 2;
 370:src/render/layout.c ****         *buf = (char*)pluto_realloc(*buf, *cap);
 371:src/render/layout.c ****     }
 372:src/render/layout.c ****     if (*len > 0) (*buf)[(*len)++] = ' ';
 373:src/render/layout.c ****     memcpy(*buf + *len, word, (size_t)wlen);
 374:src/render/layout.c ****     *len += (size_t)wlen;
 375:src/render/layout.c ****     (*buf)[*len] = '\0';
 376:src/render/layout.c ****     return *buf;
 377:src/render/layout.c **** }
 378:src/render/layout.c **** 
 379:src/render/layout.c **** /* appends positioned items for already-broken lines; returns endY */
 380:src/render/layout.c **** static int emit_flow(BrkLines* ls, int lineH, int startX, int maxW,
 381:src/render/layout.c ****                      const char* align, int startY, int invert, int forceBold) {
 382:src/render/layout.c ****     int y = startY;
 383:src/render/layout.c ****     for (int li = 0; li < ls->nLines; li++) {
 384:src/render/layout.c ****         const BrkLine* ln = &ls->lines[li];
 385:src/render/layout.c ****         int textW = 0;
 386:src/render/layout.c ****         for (int wi = 0; wi < ln->nWords; wi++) textW += ln->words[wi].w;
 387:src/render/layout.c ****         int x = startX;
 388:src/render/layout.c ****         if (align && !strcmp(align, "center"))
 389:src/render/layout.c ****             x = startX + floordiv2(maxW - textW);
 390:src/render/layout.c ****         else if (align && !strcmp(align, "right"))
 391:src/render/layout.c ****             x = startX + (maxW - textW > 0 ? maxW - textW : 0);
 392:src/render/layout.c **** 
 393:src/render/layout.c ****         /* pending link rect (merged across same-href words) */
 394:src/render/layout.c ****         int haveMr = 0, mrX = 0, mrW = 0, mrInert = 0;
 395:src/render/layout.c ****         long mrAnchor = -1;
 396:src/render/layout.c ****         const char* mrHref = NULL;
 397:src/render/layout.c ****         char* mrText = NULL;
 398:src/render/layout.c ****         size_t mrLen = 0, mrCap = 0;
 399:src/render/layout.c **** 
 400:src/render/layout.c ****         for (int wi = 0; wi < ln->nWords; wi++) {
 401:src/render/layout.c ****             const BrkWord* wd = &ln->words[wi];
 402:src/render/layout.c ****             const DocInline* inl = wd->inl;
 403:src/render/layout.c ****             int dy = inl->sub ? 3 : (inl->sup ? -4 : 0);
 404:src/render/layout.c **** 
 405:src/render/layout.c ****             LItem* it = new_item(LIT_TEXT);
 406:src/render/layout.c ****             it->text        = pluto_strndup(wd->start, (size_t)wd->len);
 407:src/render/layout.c ****             it->font        = wd->font;
 408:src/render/layout.c ****             it->x           = x;
 409:src/render/layout.c ****             it->y           = y + dy;
 410:src/render/layout.c ****             it->w           = wd->w;
 411:src/render/layout.c ****             it->h           = lineH;
 412:src/render/layout.c ****             it->bold        = inl->bold;
 413:src/render/layout.c ****             it->italic      = inl->italic;
 414:src/render/layout.c ****             it->underline   = inl->underline;
 415:src/render/layout.c ****             it->code        = inl->code;
 416:src/render/layout.c ****             it->smallFlag   = inl->small;
 417:src/render/layout.c ****             it->bigFlag     = inl->big;
 418:src/render/layout.c ****             it->mark        = inl->mark;
 419:src/render/layout.c ****             it->strike      = inl->strike;
 420:src/render/layout.c ****             it->invert      = (unsigned char)(invert ? 1 : 0);
 421:src/render/layout.c ****             it->href        = inl->href ? pluto_strdup(inl->href) : NULL;
 422:src/render/layout.c ****             it->anchorIndex = inl->anchorIndex;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccF3LIbn.s 			page 10


 423:src/render/layout.c ****             if (forceBold) it->bold = 1;
 424:src/render/layout.c **** 
 425:src/render/layout.c ****             if (inl->href && haveMr && mrHref == inl->href &&
 426:src/render/layout.c ****                 mrAnchor == inl->anchorIndex) {
 427:src/render/layout.c ****                 /* same link continues: extend over the inter-word gap */
 428:src/render/layout.c ****                 mrW = (x + wd->w) - mrX;
 429:src/render/layout.c ****                 mr_text_append(&mrText, &mrLen, &mrCap, wd->start, wd->len);
 430:src/render/layout.c ****             } else if (inl->href) {
 431:src/render/layout.c ****                 if (haveMr)
 432:src/render/layout.c ****                     lm_add_link_rect(mrHref, mrText ? mrText : "",
 433:src/render/layout.c ****                         (LmRect){ .x = mrX, .y = y, .w = mrW, .h = lineH,
 434:src/render/layout.c ****                                   .inert = mrInert }, mrAnchor);
 435:src/render/layout.c ****                 pluto_free(mrText);
 436:src/render/layout.c ****                 mrText = NULL; mrLen = 0; mrCap = 0;
 437:src/render/layout.c ****                 haveMr  = 1;
 438:src/render/layout.c ****                 mrX     = x;
 439:src/render/layout.c ****                 mrW     = wd->w;
 440:src/render/layout.c ****                 mrHref  = inl->href;
 441:src/render/layout.c ****                 mrAnchor= inl->anchorIndex;
 442:src/render/layout.c ****                 mrText  = mr_text_append(&mrText, &mrLen, &mrCap,
 443:src/render/layout.c ****                                          wd->start, wd->len);
 444:src/render/layout.c ****                 mrInert = inl->inert ? 1 : 0;
 445:src/render/layout.c ****             } else if (haveMr) {
 446:src/render/layout.c ****                 lm_add_link_rect(mrHref, mrText ? mrText : "",
 447:src/render/layout.c ****                     (LmRect){ .x = mrX, .y = y, .w = mrW, .h = lineH,
 448:src/render/layout.c ****                               .inert = mrInert }, mrAnchor);
 449:src/render/layout.c ****                 pluto_free(mrText);
 450:src/render/layout.c ****                 mrText = NULL; mrLen = 0; mrCap = 0;
 451:src/render/layout.c ****                 haveMr = 0;
 452:src/render/layout.c ****             }
 453:src/render/layout.c ****             x += wd->advance;
 454:src/render/layout.c ****         }
 455:src/render/layout.c ****         if (haveMr)
 456:src/render/layout.c ****             lm_add_link_rect(mrHref, mrText ? mrText : "",
 457:src/render/layout.c ****                 (LmRect){ .x = mrX, .y = y, .w = mrW, .h = lineH,
 458:src/render/layout.c ****                           .inert = mrInert }, mrAnchor);
 459:src/render/layout.c ****         pluto_free(mrText);
 460:src/render/layout.c ****         y += lineH;
 461:src/render/layout.c ****     }
 462:src/render/layout.c ****     return y;
 463:src/render/layout.c **** }
