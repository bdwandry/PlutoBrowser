2671:Source/render/layout.c **** static const char *font_role_name(LCDFont *f)
2672:Source/render/layout.c **** {
2673:Source/render/layout.c ****     if (f == style_font(PLUTO_FONT_BODY)) return "BODY";
2674:Source/render/layout.c ****     if (f == style_font(PLUTO_FONT_BODY_BOLD)) return "BOLD";
2675:Source/render/layout.c ****     if (f == style_font(PLUTO_FONT_MONO)) return "MONO";
2676:Source/render/layout.c ****     if (f == style_font(PLUTO_FONT_SMALL)) return "SMALL";
2677:Source/render/layout.c ****     if (f == style_font(PLUTO_FONT_HEADING1)) return "H1";
2678:Source/render/layout.c ****     if (f == style_font(PLUTO_FONT_HEADING2)) return "H2";
2679:Source/render/layout.c ****     if (f == style_font(PLUTO_FONT_HEADING3)) return "H3";
2680:Source/render/layout.c ****     return "BODY";
2681:Source/render/layout.c **** }
