 376:Source/render/layout.c **** void layout_expand_tab_columns(const char *line, char *out, size_t cap)
 377:Source/render/layout.c **** {
 378:Source/render/layout.c ****     if (!line)
 379:Source/render/layout.c ****     {
 380:Source/render/layout.c ****         if (cap)
 381:Source/render/layout.c ****         {
 382:Source/render/layout.c ****             out[0] = '\0';
 383:Source/render/layout.c ****         }
 384:Source/render/layout.c ****         return;
 385:Source/render/layout.c ****     }
 386:Source/render/layout.c ****     if (!strchr(line, '\t'))
 387:Source/render/layout.c ****     {
 388:Source/render/layout.c ****         snprintf(out, cap, "%s", line);
 389:Source/render/layout.c ****         return;
 390:Source/render/layout.c ****     }
 391:Source/render/layout.c ****     size_t o = 0;
 392:Source/render/layout.c ****     int col = 0;
 393:Source/render/layout.c ****     for (const char *p = line; *p; p++)
 394:Source/render/layout.c ****     {
 395:Source/render/layout.c ****         if (*p == '\t')
 396:Source/render/layout.c ****         {
 397:Source/render/layout.c ****             int pad = TAB_COLUMNS - (col % TAB_COLUMNS);
 398:Source/render/layout.c ****             for (int i = 0; i < pad && o + 1 < cap; i++)
 399:Source/render/layout.c ****             {
 400:Source/render/layout.c ****                 out[o++] = ' ';
 401:Source/render/layout.c ****             }
 402:Source/render/layout.c ****             col += pad;
 403:Source/render/layout.c ****         }
 404:Source/render/layout.c ****         else
 405:Source/render/layout.c ****         {
 406:Source/render/layout.c ****             if (o + 1 < cap)
 407:Source/render/layout.c ****             {
 408:Source/render/layout.c ****                 out[o++] = *p;
 409:Source/render/layout.c ****             }
 410:Source/render/layout.c ****             col++;
 411:Source/render/layout.c ****         }
 412:Source/render/layout.c ****     }
 413:Source/render/layout.c ****     out[o] = '\0';
 414:Source/render/layout.c **** }
