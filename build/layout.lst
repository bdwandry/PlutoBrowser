2602:Source/render/layout.c **** /* ── Bare-image hit test (#12c) ────────────────────�
2603:Source/render/layout.c ****  * Returns the LRI_IMAGE item under the given page coordinates, or NULL.
2604:Source/render/layout.c ****  * Used by the HTML-mode click handler so unlinked <img> elements (google.com
2605:Source/render/layout.c ****  * logo) can open the on-demand overlay too. */
2606:Source/render/layout.c **** const LayoutItem *layout_image_at(int pageX, int pageY)
2607:Source/render/layout.c **** {
2608:Source/render/layout.c ****     int n = g_itemCount;
2609:Source/render/layout.c ****     for (int i = n - 1; i >= 0; i--) /* topmost (last drawn) wins */
2610:Source/render/layout.c ****     {
2611:Source/render/layout.c ****         LayoutItem *it = g_items[i];
2612:Source/render/layout.c ****         if (!it || it->type != LRI_IMAGE || !it->src || !it->src[0])
2613:Source/render/layout.c ****         {
2614:Source/render/layout.c ****             continue;
2615:Source/render/layout.c ****         }
2616:Source/render/layout.c ****         if (pageX >= it->x && pageX < it->x + it->w &&
2617:Source/render/layout.c ****             pageY >= it->y && pageY < it->y + it->h)
2618:Source/render/layout.c ****         {
2619:Source/render/layout.c ****             return it;
2620:Source/render/layout.c ****         }
2621:Source/render/layout.c ****     }
2622:Source/render/layout.c ****     return NULL;
2623:Source/render/layout.c **** }
