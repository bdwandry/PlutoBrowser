 267:Source/render/layout.c **** /* scratch buffer so word slices can be measured as C strings without a
 268:Source/render/layout.c ****  * malloc per word */
 269:Source/render/layout.c **** static char* s_meas = NULL;
 270:Source/render/layout.c **** static size_t s_measCap = 0;
 271:Source/render/layout.c **** 
 272:Source/render/layout.c **** static const char* meas_slice(const char* start, int len) {
 273:Source/render/layout.c ****     if ((size_t)len + 1 > s_measCap) {
 274:Source/render/layout.c ****         s_measCap = (size_t)len + 32;
 275:Source/render/layout.c ****         s_meas = (char*)pluto_realloc(s_meas, s_measCap);
 276:Source/render/layout.c ****     }
 277:Source/render/layout.c ****     memcpy(s_meas, start, (size_t)len);
 278:Source/render/layout.c ****     s_meas[len] = '\0';
 279:Source/render/layout.c ****     return s_meas;
 280:Source/render/layout.c **** }
