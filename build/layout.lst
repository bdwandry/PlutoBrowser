1750:Source/render/layout.c **** /* Lua fillCircleAtPoint(cx, cy, r): inclusive disk of diameter 2r+1 →
1751:Source/render/layout.c ****  * C fillEllipse bounding box (x, y, 2r+1, 2r+1). */
1752:Source/render/layout.c **** static void fill_circle_at(int cx, int cy, int r, LCDColor color)
1753:Source/render/layout.c **** {
1754:Source/render/layout.c ****     g_pd->graphics->fillEllipse(cx - r, cy - r, r * 2 + 1, r * 2 + 1,
1755:Source/render/layout.c ****                                 0.f, 360.f, color);
1756:Source/render/layout.c **** }
1757:Source/render/layout.c **** 
1758:Source/render/layout.c **** static void draw_pixel(int x, int y, LCDColor color)
1759:Source/render/layout.c **** {
1760:Source/render/layout.c ****     g_pd->graphics->fillRect(x, y, 1, 1, color);
1761:Source/render/layout.c **** }
1762:Source/render/layout.c **** 
1763:Source/render/layout.c **** static void draw_placeholder_card(int x, int y, int w, int h)
1764:Source/render/layout.c **** {
1765:Source/render/layout.c ****     g_pd->graphics->fillRoundRect(x, y, w, h, 4, kColorWhite);
1766:Source/render/layout.c ****     g_pd->graphics->drawRoundRect(x, y, w, h, 4, 1, kColorBlack);
1767:Source/render/layout.c ****     for (int hx = x + 4; hx <= x + w - 4; hx += 10)
1768:Source/render/layout.c ****     {
1769:Source/render/layout.c ****         g_pd->graphics->drawLine(hx, y + 3, hx, y + h - 3, 1, kColorBlack);
1770:Source/render/layout.c ****     }
1771:Source/render/layout.c ****     int iconX = x + w / 2 - 8;
1772:Source/render/layout.c ****     int iconY = y + h / 2 - 6;
1773:Source/render/layout.c ****     g_pd->graphics->drawRoundRect(iconX, iconY, 16, 11, 2, 1, kColorBlack);
1774:Source/render/layout.c ****     fill_circle_at(iconX + 8, iconY + 5, 3, kColorBlack);
1775:Source/render/layout.c ****     draw_pixel(iconX + 13, iconY + 1, kColorBlack);
1776:Source/render/layout.c **** }
