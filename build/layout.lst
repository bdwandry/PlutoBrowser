 265:Source/render/layout.c **** void layout_to_roman(int n, char *out, size_t cap)
 266:Source/render/layout.c **** {
 267:Source/render/layout.c ****     /* Lua: if not n or n <= 0 or n > 3999 then return tostring(n or 1) */
 268:Source/render/layout.c ****     if (n <= 0 || n > 3999)
 269:Source/render/layout.c ****     {
 270:Source/render/layout.c ****         /* Lua tostring(n or 1): 0 is truthy → "0"; nil (not applicable here)
 271:Source/render/layout.c ****          * would give "1"; negative n passes through. */
 272:Source/render/layout.c ****         snprintf(out, cap, "%d", n);
 273:Source/render/layout.c ****         return;
 274:Source/render/layout.c ****     }
 275:Source/render/layout.c ****     static const int vals[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
 276:Source/render/layout.c ****     static const char *syms[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL",
 277:Source/render/layout.c ****                                  "X", "IX", "V", "IV", "I"};
 278:Source/render/layout.c ****     size_t o = 0;
 279:Source/render/layout.c ****     out[0] = '\0';
 280:Source/render/layout.c ****     char tmp[32];
 281:Source/render/layout.c ****     for (int i = 0; i < 13 && n > 0; i++)
 282:Source/render/layout.c ****     {
 283:Source/render/layout.c ****         while (n >= vals[i])
 284:Source/render/layout.c ****         {
 285:Source/render/layout.c ****             size_t sl = strlen(syms[i]);
 286:Source/render/layout.c ****             memcpy(tmp + o, syms[i], sl);
 287:Source/render/layout.c ****             o += sl;
 288:Source/render/layout.c ****             n -= vals[i];
 289:Source/render/layout.c ****         }
 290:Source/render/layout.c ****     }
 291:Source/render/layout.c ****     tmp[o] = '\0';
 292:Source/render/layout.c ****     snprintf(out, cap, "%s", tmp);
 293:Source/render/layout.c **** }
 294:Source/render/layout.c **** 
 295:Source/render/layout.c **** void layout_to_alpha(int n, char *out, size_t cap)
 296:Source/render/layout.c **** {
 297:Source/render/layout.c ****     char tmp[40];
 298:Source/render/layout.c ****     size_t o = 0;
 299:Source/render/layout.c ****     while (n > 0)
 300:Source/render/layout.c ****     {
 301:Source/render/layout.c ****         int rem = (n - 1) % 26;
 302:Source/render/layout.c ****         if (o < sizeof(tmp))
 303:Source/render/layout.c ****         {
 304:Source/render/layout.c ****             tmp[o++] = (char)('a' + rem);
 305:Source/render/layout.c ****         }
 306:Source/render/layout.c ****         n = (n - 1) / 26;
 307:Source/render/layout.c ****     }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccqLvxGM.s 			page 8


 308:Source/render/layout.c ****     for (size_t i = 0; i < o / 2; i++)
 309:Source/render/layout.c ****     {
 310:Source/render/layout.c ****         char t = tmp[i];
 311:Source/render/layout.c ****         tmp[i] = tmp[o - 1 - i];
 312:Source/render/layout.c ****         tmp[o - 1 - i] = t;
 313:Source/render/layout.c ****     }
 314:Source/render/layout.c ****     tmp[o] = '\0';
 315:Source/render/layout.c ****     if (o == 0)
 316:Source/render/layout.c ****     {
 317:Source/render/layout.c ****         snprintf(out, cap, "1"); /* Lua: out ~= "" and out or "1" */
 318:Source/render/layout.c ****         return;
 319:Source/render/layout.c ****     }
 320:Source/render/layout.c ****     snprintf(out, cap, "%s", tmp);
 321:Source/render/layout.c **** }
