 252:Source/render/layout.c ****     if (ls->nLines == ls->capLines) {
 253:Source/render/layout.c ****         ls->capLines = ls->capLines ? ls->capLines * 2 : 8;
 254:Source/render/layout.c ****         ls->lines = (BrkLine*)pluto_realloc(ls->lines,
 255:Source/render/layout.c ****                                     sizeof(BrkLine) * (size_t)ls->capLines);
 256:Source/render/layout.c ****     }
