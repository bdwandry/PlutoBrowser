 161:Source/render/layout.c **** char* layout_ordered_marker(int number, const char* markerType) {
 162:Source/render/layout.c ****     char buf[48];
 163:Source/render/layout.c ****     /* callers resolve `number or 1` before this point (Lua parity) */
 164:Source/render/layout.c ****     if (!markerType || !markerType[0] || !strcmp(markerType, "1")) {
 165:Source/render/layout.c ****         snprintf(buf, sizeof(buf), "%d", number);
 166:Source/render/layout.c ****         return pluto_strdup(buf);
 167:Source/render/layout.c ****     }
 168:Source/render/layout.c ****     if (!strcmp(markerType, "a")) { to_alpha(number, buf, sizeof(buf)); return pluto_strdup(buf); }
 169:Source/render/layout.c ****     if (!strcmp(markerType, "A")) {
 170:Source/render/layout.c ****         to_alpha(number, buf, sizeof(buf));
 171:Source/render/layout.c ****         for (char* p = buf; *p; p++) if (*p >= 'a' && *p <= 'z') *p = (char)(*p - 32);
 172:Source/render/layout.c ****         return pluto_strdup(buf);
 173:Source/render/layout.c ****     }
 174:Source/render/layout.c ****     if (!strcmp(markerType, "i") || !strcmp(markerType, "I")) {
 175:Source/render/layout.c ****         to_roman(number, buf, sizeof(buf));
 176:Source/render/layout.c ****         if (markerType[0] == 'i')
 177:Source/render/layout.c ****             for (char* p = buf; *p; p++)
 178:Source/render/layout.c ****                 if (*p >= 'A' && *p <= 'Z') *p = (char)(*p + 32);
 179:Source/render/layout.c ****         return pluto_strdup(buf);
 180:Source/render/layout.c ****     }
 181:Source/render/layout.c ****     snprintf(buf, sizeof(buf), "%d", number);
 182:Source/render/layout.c ****     return pluto_strdup(buf);
 183:Source/render/layout.c **** }
