 323:Source/render/layout.c **** void layout_ordered_marker(int number, char markerType, char *out, size_t cap)
 324:Source/render/layout.c **** {
 325:Source/render/layout.c ****     char buf[40];
 326:Source/render/layout.c ****     if (!markerType)
 327:Source/render/layout.c ****     {
 328:Source/render/layout.c ****         markerType = '1';
 329:Source/render/layout.c ****     }
 330:Source/render/layout.c ****     if (markerType == 'a')
