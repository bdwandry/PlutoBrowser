  30:Source/html/selftest_tokenizer.c **** 
  31:Source/html/selftest_tokenizer.c **** static const char* attr_str(const HttToken* t, const char* key) {
  32:Source/html/selftest_tokenizer.c ****     void* v = sm_get(t->attrs, key);
  33:Source/html/selftest_tokenizer.c ****     return (v == NULL || v == HT_ATTR_TRUE) ? NULL : (const char*)v;
  34:Source/html/selftest_tokenizer.c **** }
  35:Source/html/selftest_tokenizer.c **** 
  36:Source/html/selftest_tokenizer.c **** static int attr_bool(const HttToken* t, const char* key) {
  37:Source/html/selftest_tokenizer.c ****     return sm_get(t->attrs, key) == HT_ATTR_TRUE;
  38:Source/html/selftest_tokenizer.c **** }
  39:Source/html/selftest_tokenizer.c **** 
  40:Source/html/selftest_tokenizer.c **** #define T(tks, i) (&(tks)->items[i])
  41:Source/html/selftest_tokenizer.c **** 
  42:Source/html/selftest_tokenizer.c **** static void case_basic(void) {
  43:Source/html/selftest_tokenizer.c ****     HttTokens* t = htt_tokenize("hello world", 11);
  44:Source/html/selftest_tokenizer.c ****     ck("A.nonnull", t != NULL);
  45:Source/html/selftest_tokenizer.c ****     if (!t) return;
  46:Source/html/selftest_tokenizer.c ****     cks("A.title_default", t->pageTitle, "Web Page");
  47:Source/html/selftest_tokenizer.c ****     ck("A.count_1", t->count == 1);
  48:Source/html/selftest_tokenizer.c ****     ck("A.text", tok_is_text(T(t, 0), "hello world"));
