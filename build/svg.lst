  31:Source/render/decoders/svg.c **** static void cv_plot(Canvas* cv, int x, int y) {
  32:Source/render/decoders/svg.c ****     if (!cv || x < 0 || y < 0 || x >= cv->w || y >= cv->h) return;
  33:Source/render/decoders/svg.c ****     cv->rows[y][x] = 0;
