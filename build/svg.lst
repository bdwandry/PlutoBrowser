 250:Source/render/decoders/svg.c ****             }
 251:Source/render/decoders/svg.c ****             size_t vs = colon + 1, ve = segEnd;
 252:Source/render/decoders/svg.c ****             while (vs < ve && (style[vs] == ' ' || style[vs] == '\t'))
 253:Source/render/decoders/svg.c ****             {
 254:Source/render/decoders/svg.c ****                 vs++;
 255:Source/render/decoders/svg.c ****             }
 256:Source/render/decoders/svg.c ****             while (ve > vs && (style[ve - 1] == ' ' || style[ve - 1] == '\t'))
 257:Source/render/decoders/svg.c ****             {
 258:Source/render/decoders/svg.c ****                 ve--;
 259:Source/render/decoders/svg.c ****             }
