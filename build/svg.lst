  82:Source/render/decoders/svg.c **** /* Midpoint circle around (cx,cy); octmask selects plotted octants. */
  83:Source/render/decoders/svg.c **** static void cv_circle(Canvas* cv, int cx, int cy, int r, unsigned octmask) {
  84:Source/render/decoders/svg.c ****     int x, y;
  85:Source/render/decoders/svg.c ****     long long err;
  86:Source/render/decoders/svg.c ****     if (r <= 0) { cv_plot(cv, cx, cy); return; }
  87:Source/render/decoders/svg.c ****     x = r; y = 0;
  88:Source/render/decoders/svg.c ****     err = 1 - r;
  89:Source/render/decoders/svg.c ****     while (x >= y) {
  90:Source/render/decoders/svg.c ****         if (octmask & 0x01u) cv_plot(cv, cx + x, cy + y);
  91:Source/render/decoders/svg.c ****         if (octmask & 0x02u) cv_plot(cv, cx + y, cy + x);
  92:Source/render/decoders/svg.c ****         if (octmask & 0x04u) cv_plot(cv, cx - y, cy + x);
  93:Source/render/decoders/svg.c ****         if (octmask & 0x08u) cv_plot(cv, cx - x, cy + y);
  94:Source/render/decoders/svg.c ****         if (octmask & 0x10u) cv_plot(cv, cx - x, cy - y);
  95:Source/render/decoders/svg.c ****         if (octmask & 0x20u) cv_plot(cv, cx - y, cy - x);
  96:Source/render/decoders/svg.c ****         if (octmask & 0x40u) cv_plot(cv, cx + y, cy - x);
  97:Source/render/decoders/svg.c ****         if (octmask & 0x80u) cv_plot(cv, cx + x, cy - y);
  98:Source/render/decoders/svg.c ****         y++;
  99:Source/render/decoders/svg.c ****         if (err < 0) {
 100:Source/render/decoders/svg.c ****             err += 2 * y + 1;
 101:Source/render/decoders/svg.c ****         } else {
 102:Source/render/decoders/svg.c ****             x--;
 103:Source/render/decoders/svg.c ****             err += 2 * (y - x) + 1;
 104:Source/render/decoders/svg.c ****         }
 105:Source/render/decoders/svg.c ****     }
 106:Source/render/decoders/svg.c **** }
