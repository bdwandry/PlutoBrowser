 430:Source/render/decoders/svg.c ****         size_t si = (size_t)(s - body);
 431:Source/render/decoders/svg.c ****         const char *e = memchr(s, '>', len - si);
 432:Source/render/decoders/svg.c ****         if (!e)
 433:Source/render/decoders/svg.c ****         {
