 127:Source/render/decoders/svg.c **** /* Midpoint ellipse inside bounding box (bbx,bby,bbw,bbh), pure integer. */
 128:Source/render/decoders/svg.c **** static void canvas_ellipse(Canvas* cv, int bbx, int bby, int bbw, int bbh) {
 129:Source/render/decoders/svg.c ****     int rx, ry, cx, cy, i;
 130:Source/render/decoders/svg.c ****     long long Rx2, Ry2, x, y, f;
 131:Source/render/decoders/svg.c ****     if (bbw <= 0 || bbh <= 0) return;
 132:Source/render/decoders/svg.c ****     rx = bbw / 2; ry = bbh / 2;
 133:Source/render/decoders/svg.c ****     cx = bbx + rx; cy = bby + ry;
 134:Source/render/decoders/svg.c ****     if (rx <= 0 && ry <= 0) { cv_plot(cv, cx, cy); return; }
 135:Source/render/decoders/svg.c ****     if (rx <= 0) { for (i = cy - ry; i <= cy + ry; i++) cv_plot(cv, cx, i); return; }
 136:Source/render/decoders/svg.c ****     if (ry <= 0) { for (i = cx - rx; i <= cx + rx; i++) cv_plot(cv, i, cy); return; }
