 218:Source/render/decoders/svg.c **** /* Lua: parseStyle — "([^;:]+)%s*:%s*([^;]+)", key trimmed+lowered, val
 219:Source/render/decoders/svg.c ****  * trimmed; LAST duplicate wins (table assignment). */
 220:Source/render/decoders/svg.c **** static void svg_parse_style(const char *style, size_t len, SvgAttrs *out)
 221:Source/render/decoders/svg.c **** {
