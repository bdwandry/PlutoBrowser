   1:Source/render/decoders/svg.c **** // svg.c — C port of Source/render/decoders/svg.lua (SVGDecoder).
   2:Source/render/decoders/svg.c **** //
   3:Source/render/decoders/svg.c **** // Renders the web-icon subset of SVG into a 1-bit gray grid (255 white
   4:Source/render/decoders/svg.c **** // canvas, 0 ink) using a small deterministic software rasterizer:
   5:Source/render/decoders/svg.c **** // Bresenham lines, rect outlines, rounded rects (edges + quadrant arcs from
   6:Source/render/decoders/svg.c **** // the midpoint circle), midpoint circles/ellipses. Tag scanning, <use>
   7:Source/render/decoders/svg.c **** // resolution, style merging, hidden-subtree skipping and path flattening
   8:Source/render/decoders/svg.c **** // mirror svg.lua exactly, including its quirks (e.g. "clipPath" never
   9:Source/render/decoders/svg.c **** // matching after lowercasing, A-commands drawn as straight chords).
