  36:Source/render/decoders/svg.c **** /* Bresenham; plots both endpoints; any octant. */
  37:Source/render/decoders/svg.c **** static void cv_line(Canvas* cv, int x0, int y0, int x1, int y1) {
  38:Source/render/decoders/svg.c ****     int dx = x1 > x0 ? x1 - x0 : x0 - x1;
  39:Source/render/decoders/svg.c ****     int dy = y0 > y1 ? y0 - y1 : y1 - y0;
  40:Source/render/decoders/svg.c ****     int sx = x0 < x1 ? 1 : -1;
  41:Source/render/decoders/svg.c ****     int sy = y0 < y1 ? 1 : -1;
  42:Source/render/decoders/svg.c ****     int err = dx - dy;
  43:Source/render/decoders/svg.c ****     for (;;) {
  44:Source/render/decoders/svg.c ****         int e2;
  45:Source/render/decoders/svg.c ****         cv_plot(cv, x0, y0);
  46:Source/render/decoders/svg.c ****         if (x0 == x1 && y0 == y1) break;
  47:Source/render/decoders/svg.c ****         e2 = 2 * err;
  48:Source/render/decoders/svg.c ****         if (e2 > -dy) { err -= dy; x0 += sx; }
  49:Source/render/decoders/svg.c ****         if (e2 < dx)  { err += dx; y0 += sy; }
  50:Source/render/decoders/svg.c ****     }
  51:Source/render/decoders/svg.c **** }
  52:Source/render/decoders/svg.c **** 
  53:Source/render/decoders/svg.c **** static void cv_rect(Canvas* cv, int x, int y, int w, int h) {
  54:Source/render/decoders/svg.c ****     int i;
  55:Source/render/decoders/svg.c ****     if (w <= 0 || h <= 0) return;
  56:Source/render/decoders/svg.c ****     for (i = 0; i < w; i++) {
  57:Source/render/decoders/svg.c ****         cv_plot(cv, x + i, y);
  58:Source/render/decoders/svg.c ****         cv_plot(cv, x + i, y + h - 1);
  59:Source/render/decoders/svg.c ****     }
  60:Source/render/decoders/svg.c ****     for (i = 0; i < h; i++) {
  61:Source/render/decoders/svg.c ****         cv_plot(cv, x, y + i);
  62:Source/render/decoders/svg.c ****         cv_plot(cv, x + w - 1, y + i);
  63:Source/render/decoders/svg.c ****     }
  64:Source/render/decoders/svg.c **** }
  65:Source/render/decoders/svg.c **** 
  66:Source/render/decoders/svg.c **** static void cv_hline(Canvas* cv, int x0, int x1, int y) {
  67:Source/render/decoders/svg.c ****     int i, lo = x0 < x1 ? x0 : x1, hi = x0 < x1 ? x1 : x0;
  68:Source/render/decoders/svg.c ****     for (i = lo; i <= hi; i++) cv_plot(cv, i, y);
  69:Source/render/decoders/svg.c **** }
  70:Source/render/decoders/svg.c **** 
  71:Source/render/decoders/svg.c **** static void cv_vline(Canvas* cv, int x, int y0, int y1) {
  72:Source/render/decoders/svg.c ****     int i, lo = y0 < y1 ? y0 : y1, hi = y0 < y1 ? y1 : y0;
  73:Source/render/decoders/svg.c ****     for (i = lo; i <= hi; i++) cv_plot(cv, x, i);
  74:Source/render/decoders/svg.c **** }
