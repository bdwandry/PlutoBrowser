 108:Source/render/decoders/svg.c **** static void cv_round_rect(Canvas* cv, int x, int y, int w, int h, int r) {
 109:Source/render/decoders/svg.c ****     int x2, y2;
 110:Source/render/decoders/svg.c ****     if (w <= 0 || h <= 0) return;
 111:Source/render/decoders/svg.c ****     if (r < 0) r = 0;
 112:Source/render/decoders/svg.c ****     if (r > w / 2) r = w / 2;
 113:Source/render/decoders/svg.c ****     if (r > h / 2) r = h / 2;
 114:Source/render/decoders/svg.c ****     if (r == 0) { cv_rect(cv, x, y, w, h); return; }
 115:Source/render/decoders/svg.c ****     x2 = x + w - 1;
 116:Source/render/decoders/svg.c ****     y2 = y + h - 1;
 117:Source/render/decoders/svg.c ****     cv_hline(cv, x + r, x2 - r, y);
 118:Source/render/decoders/svg.c ****     cv_hline(cv, x + r, x2 - r, y2);
 119:Source/render/decoders/svg.c ****     cv_vline(cv, x, y + r, y2 - r);
 120:Source/render/decoders/svg.c ****     cv_vline(cv, x2, y + r, y2 - r);
 121:Source/render/decoders/svg.c ****     cv_circle(cv, x + r, y + r, r, OCT_TL);
 122:Source/render/decoders/svg.c ****     cv_circle(cv, x2 - r, y + r, r, OCT_TR);
 123:Source/render/decoders/svg.c ****     cv_circle(cv, x + r, y2 - r, r, OCT_BL);
 124:Source/render/decoders/svg.c ****     cv_circle(cv, x2 - r, y2 - r, r, OCT_BR);
 125:Source/render/decoders/svg.c **** }
