 235:src/core/selftest_browser.c ****     (void)ud;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccZzFz2y.s 			page 21


 236:src/core/selftest_browser.c ****     if (qHead < nQ) { CURRENT = Q[qHead++]; *out = CURRENT; }
 237:src/core/selftest_browser.c ****     else {
 238:src/core/selftest_browser.c ****         memset(out, 0, sizeof(*out));
 239:src/core/selftest_browser.c ****         CLOCK_NOW += 16;
