 354:Source/core/selftest_browser.c **** 
 355:Source/core/selftest_browser.c **** /* ── test groups ─────────────────────────�
 356:Source/core/selftest_browser.c **** 
 357:Source/core/selftest_browser.c **** static void t_navigation_flow(void) {
 358:Source/core/selftest_browser.c ****     reset_all();
 359:Source/core/selftest_browser.c **** 
 360:Source/core/selftest_browser.c ****     /* boot lands on home with an empty history */
 361:Source/core/selftest_browser.c ****     br_boot();
 362:Source/core/selftest_browser.c ****     st_check(br_state() == PLUTO_STATE_HOME, "A.boot_home");
 363:Source/core/selftest_browser.c ****     check_str("A.boot_title", br_page_title(), "CometBrowser");
 364:Source/core/selftest_browser.c ****     st_check(br_history_count() == 0, "A.boot_history_empty");
 365:Source/core/selftest_browser.c **** 
 366:Source/core/selftest_browser.c ****     /* about:home special case: no HTTP, start-page title, pushed */
 367:Source/core/selftest_browser.c ****     br_navigate_to("about:home");
 368:Source/core/selftest_browser.c ****     pump(2);
 369:Source/core/selftest_browser.c ****     st_check(br_state() == PLUTO_STATE_HOME, "B.about_home_state");
 370:Source/core/selftest_browser.c ****     check_str("B.about_home_title", br_page_title(),
 371:Source/core/selftest_browser.c ****               "CometBrowser Start Page");
 372:Source/core/selftest_browser.c ****     st_check(br_history_count() == 1 &&
 373:Source/core/selftest_browser.c ****              !strcmp(br_history_at(0), "about:home"),
 374:Source/core/selftest_browser.c ****              "B.about_home_pushed");
 375:Source/core/selftest_browser.c **** 
 376:Source/core/selftest_browser.c ****     /* bare host gets https:// prepended and fetches */
 377:Source/core/selftest_browser.c ****     Route ra[] = { { "/b.html", PAGE_B, 0, NULL },
 378:Source/core/selftest_browser.c ****                    { "/", PAGE_A, 0, NULL } };   /* exact "/" must be LAST */
 379:Source/core/selftest_browser.c ****     set_routes(ra, 2);
 380:Source/core/selftest_browser.c ****     br_navigate_to("example.com");
 381:Source/core/selftest_browser.c ****     pump_until_page(30);
 382:Source/core/selftest_browser.c ****     st_check(br_state() == PLUTO_STATE_PAGE, "C.page_reached");
 383:Source/core/selftest_browser.c ****     check_str("C.prepended_host", g_lastHost, "example.com");
 384:Source/core/selftest_browser.c ****     check_str("C.requested_path", g_lastTarget, "/");
 385:Source/core/selftest_browser.c ****     check_str("C.normalized",
 386:Source/core/selftest_browser.c ****               br_current_normalized(), "https://example.com/");
 387:Source/core/selftest_browser.c ****     check_str("C.doc_title", br_page_title(), "Page A");
 388:Source/core/selftest_browser.c ****     st_check(br_history_count() == 2 &&
 389:Source/core/selftest_browser.c ****              !strcmp(br_history_at(1), "https://example.com"),
 390:Source/core/selftest_browser.c ****              "C.history_pushed");
 391:Source/core/selftest_browser.c **** 
 392:Source/core/selftest_browser.c ****     /* search-query detection rewrites to duckduckgo */
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc9msa51.s 			page 68


 393:Source/core/selftest_browser.c ****     br_navigate_to("playdate wiki");
 394:Source/core/selftest_browser.c ****     pump_until_page(30);
 395:Source/core/selftest_browser.c ****     st_check(strstr(g_lastTarget, "/html/?q=playdate") != NULL,
 396:Source/core/selftest_browser.c ****              "D.search_query_prefix");
 397:Source/core/selftest_browser.c ****     st_check(strstr(g_lastTarget, "wiki") != NULL, "D.search_query_term");
 398:Source/core/selftest_browser.c ****     check_str("D.search_host", g_lastHost, "html.duckduckgo.com");
 399:Source/core/selftest_browser.c **** 
 400:Source/core/selftest_browser.c ****     /* relative link follow via selection + A (d-pad walk is READER-mode
 401:Source/core/selftest_browser.c ****      * behavior in CometBrowser, so switch modes like a user would) */
 402:Source/core/selftest_browser.c ****     storage_settings()->mode = PLUTO_MODE_READER;
 403:Source/core/selftest_browser.c ****     br_boot();                     /* re-reads mode into the engine */
 404:Source/core/selftest_browser.c ****     br_navigate_to("http://links.test/");
 405:Source/core/selftest_browser.c ****     pump_until_page(30);
 406:Source/core/selftest_browser.c ****     push_input(0, 0, 0);                       /* settle */
 407:Source/core/selftest_browser.c ****     frame();
 408:Source/core/selftest_browser.c ****     push_input(BR_BTN_DOWN, BR_BTN_DOWN, 0);   /* select first link */
 409:Source/core/selftest_browser.c ****     frame();
 410:Source/core/selftest_browser.c ****     st_check(lm_get_selected_link() != NULL, "E.down_selects");
 411:Source/core/selftest_browser.c ****     push_input(BR_BTN_A, BR_BTN_A, 0);         /* follow it */
 412:Source/core/selftest_browser.c ****     frame();
 413:Source/core/selftest_browser.c ****     pump_until_page(30);
 414:Source/core/selftest_browser.c ****     check_str("E.followed_doc_title", br_page_title(), "Page B");
 415:Source/core/selftest_browser.c ****     st_check(strstr(g_lastTarget, "/b.html") != NULL, "E.relative_resolved");
 416:Source/core/selftest_browser.c **** }
 417:Source/core/selftest_browser.c **** 
 418:Source/core/selftest_browser.c **** static void t_history_stack(void) {
 419:Source/core/selftest_browser.c ****     reset_all();
 420:Source/core/selftest_browser.c ****     br_boot();
 421:Source/core/selftest_browser.c ****     Route r1[] = { { "/", PAGE_A, 0 } };
 422:Source/core/selftest_browser.c ****     set_routes(r1, 1);
 423:Source/core/selftest_browser.c **** 
 424:Source/core/selftest_browser.c ****     /* seed three entries */
 425:Source/core/selftest_browser.c ****     const char* urls[] = { "u.test/1", "u.test/2", "u.test/3" };
 426:Source/core/selftest_browser.c ****     for (int i = 0; i < 3; i++) {
 427:Source/core/selftest_browser.c ****         br_navigate_to(urls[i]);
 428:Source/core/selftest_browser.c ****         pump_until_page(30);
 429:Source/core/selftest_browser.c ****     }
 430:Source/core/selftest_browser.c ****     st_check(br_history_count() == 3, "F.seeded_count");  /* boot pushes 0 */
 431:Source/core/selftest_browser.c ****     st_check(br_history_index() == 2, "F.seeded_index");
 432:Source/core/selftest_browser.c **** 
 433:Source/core/selftest_browser.c ****     /* consecutive duplicate is dropped */
