 224:Source/core/selftest_browser.c **** static void push_input(unsigned held, unsigned justPressed, float crank) {
 225:Source/core/selftest_browser.c ****     if (nQ >= 256) return;
 226:Source/core/selftest_browser.c ****     Q[nQ].held = held;
 227:Source/core/selftest_browser.c ****     Q[nQ].justPressed = justPressed;
 228:Source/core/selftest_browser.c ****     Q[nQ].crankChange = crank;
 229:Source/core/selftest_browser.c ****     CLOCK_NOW += 16;
 230:Source/core/selftest_browser.c ****     Q[nQ].nowMs = CLOCK_NOW;
 231:Source/core/selftest_browser.c ****     nQ++;
 232:Source/core/selftest_browser.c **** }
 233:Source/core/selftest_browser.c **** 
 234:Source/core/selftest_browser.c **** static void provider(BrInput* out, void* ud) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc9msa51.s 			page 21


 235:Source/core/selftest_browser.c ****     (void)ud;
 236:Source/core/selftest_browser.c ****     if (qHead < nQ) { CURRENT = Q[qHead++]; *out = CURRENT; }
 237:Source/core/selftest_browser.c ****     else {
 238:Source/core/selftest_browser.c ****         memset(out, 0, sizeof(*out));
 239:Source/core/selftest_browser.c ****         CLOCK_NOW += 16;
 240:Source/core/selftest_browser.c ****         out->nowMs = CLOCK_NOW;
 241:Source/core/selftest_browser.c ****     }
 242:Source/core/selftest_browser.c **** }
 243:Source/core/selftest_browser.c **** 
 244:Source/core/selftest_browser.c **** /* one frame: serve sockets, step inputs, run the real composition */
 245:Source/core/selftest_browser.c **** static void frame(void) {
 246:Source/core/selftest_browser.c ****     serve_pending();
 247:Source/core/selftest_browser.c ****     br_frame();
 248:Source/core/selftest_browser.c **** }
 249:Source/core/selftest_browser.c **** 
 250:Source/core/selftest_browser.c **** static void pump(int frames) { for (int i = 0; i < frames; i++) frame(); }
 251:Source/core/selftest_browser.c **** 
 252:Source/core/selftest_browser.c **** static int cond_state_page(void) { return br_state() == PLUTO_STATE_PAGE; }
 253:Source/core/selftest_browser.c **** 
 254:Source/core/selftest_browser.c **** /* settled = page reached AND cooperative build finished */
 255:Source/core/selftest_browser.c **** static int cond_settled(void) {
 256:Source/core/selftest_browser.c ****     return br_state() == PLUTO_STATE_PAGE && !br_is_rendering();
 257:Source/core/selftest_browser.c **** }
 258:Source/core/selftest_browser.c **** 
 259:Source/core/selftest_browser.c **** static void pump_until_page(int maxFrames) {
 260:Source/core/selftest_browser.c ****     frame(); /* always run at least one frame so pendingNav is consumed
 261:Source/core/selftest_browser.c ****                 even when the previous page is still on screen */
 262:Source/core/selftest_browser.c ****     for (int i = 0; i < maxFrames && !cond_settled(); i++) frame();
 263:Source/core/selftest_browser.c ****     /* idle tail: absorbs skipInputFrames armed by fake-clock jumps
 264:Source/core/selftest_browser.c ****      * (>500ms gap closes overlays and ignores input for 2 frames) */
 265:Source/core/selftest_browser.c ****     pump(3);
 266:Source/core/selftest_browser.c **** }
 267:Source/core/selftest_browser.c **** 
 268:Source/core/selftest_browser.c **** /* settle with NO idle tail: for flows where side effects must not fire
 269:Source/core/selftest_browser.c ****  * yet (e.g. a meta-refresh deadline landing during the tail frames) */
 270:Source/core/selftest_browser.c **** static void pump_settle_once(int maxFrames) {
 271:Source/core/selftest_browser.c ****     frame();
 272:Source/core/selftest_browser.c ****     for (int i = 0; i < maxFrames && !cond_settled(); i++) frame();
 273:Source/core/selftest_browser.c **** }
