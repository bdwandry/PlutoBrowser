 147:src/core/selftest_browser.c **** static void serve_pending(void) {
 148:src/core/selftest_browser.c ****     for (int i = 0; i < NSOCKS; i++) {
 149:src/core/selftest_browser.c ****         FakeSock* s = &SOCKS[i];
 150:src/core/selftest_browser.c ****         if (s->openCb != NULL && !s->opened) {
 151:src/core/selftest_browser.c ****             s->opened = 1;
 152:src/core/selftest_browser.c ****             /* arm network failure before the first write happens */
 153:src/core/selftest_browser.c ****             for (int rI = 0; rI < NROUTES; rI++)
 154:src/core/selftest_browser.c ****                 if (ROUTES[rI].netfail && ROUTES[rI].host != NULL &&
 155:src/core/selftest_browser.c ****                     !strcmp(ROUTES[rI].host, s->server)) {
 156:src/core/selftest_browser.c ****                     s->failWrite = NET_WRITE_ERROR;
 157:src/core/selftest_browser.c ****                     break;
 158:src/core/selftest_browser.c ****                 }
 159:src/core/selftest_browser.c ****             s->openCb((TCPConnection*)s, NET_OK, s->openUd);
 160:src/core/selftest_browser.c ****         }
 161:src/core/selftest_browser.c ****         if (s->opened && !s->fed && s->written.len > 0) {
 162:src/core/selftest_browser.c ****             /* record request line + host */
 163:src/core/selftest_browser.c ****             static char line[768];
 164:src/core/selftest_browser.c ****             size_t take = s->written.len < sizeof(line) - 1
 165:src/core/selftest_browser.c ****                               ? s->written.len : sizeof(line) - 1;
 166:src/core/selftest_browser.c ****             memcpy(line, s->written.data, take);
 167:src/core/selftest_browser.c ****             line[take] = '\0';
 168:src/core/selftest_browser.c ****             char* sp = strchr(line, ' ');
 169:src/core/selftest_browser.c ****             if (sp != NULL) {
 170:src/core/selftest_browser.c ****                 char* e = strchr(sp + 1, ' ');
 171:src/core/selftest_browser.c ****                 if (e != NULL) {
 172:src/core/selftest_browser.c ****                     size_t n = (size_t)(e - sp - 1);
 173:src/core/selftest_browser.c ****                     if (n >= sizeof(g_lastTarget))
 174:src/core/selftest_browser.c ****                         n = sizeof(g_lastTarget) - 1;
 175:src/core/selftest_browser.c ****                     memcpy(g_lastTarget, sp + 1, n);
 176:src/core/selftest_browser.c ****                     g_lastTarget[n] = '\0';
 177:src/core/selftest_browser.c ****                 }
 178:src/core/selftest_browser.c ****             }
