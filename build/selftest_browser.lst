  36:Source/core/selftest_browser.c ****     else      { st_fail++; PLUTO_ERROR("[P32] FAIL %s", name); }
  37:Source/core/selftest_browser.c **** }
  38:Source/core/selftest_browser.c **** 
  39:Source/core/selftest_browser.c **** static void check_str(const char* name, const char* got, const char* exp) {
  40:Source/core/selftest_browser.c ****     st_check(got != NULL && strcmp(got, exp) == 0, name);
  41:Source/core/selftest_browser.c **** }
