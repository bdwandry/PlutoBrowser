 355:src/core/selftest_browser.c **** /* ── test groups ─────────────────────────�
 356:src/core/selftest_browser.c **** 
 357:src/core/selftest_browser.c **** static void t_navigation_flow(void) {
 358:src/core/selftest_browser.c ****     reset_all();
 359:src/core/selftest_browser.c **** 
 360:src/core/selftest_browser.c ****     /* boot lands on home with an empty history */
 361:src/core/selftest_browser.c ****     br_boot();
 362:src/core/selftest_browser.c ****     st_check(br_state() == PLUTO_STATE_HOME, "A.boot_home");
 363:src/core/selftest_browser.c ****     check_str("A.boot_title", br_page_title(), "CometBrowser");
 364:src/core/selftest_browser.c ****     st_check(br_history_count() == 0, "A.boot_history_empty");
 365:src/core/selftest_browser.c **** 
 366:src/core/selftest_browser.c ****     /* about:home special case: no HTTP, start-page title, pushed */
 367:src/core/selftest_browser.c ****     br_navigate_to("about:home");
 368:src/core/selftest_browser.c ****     pump(2);
 369:src/core/selftest_browser.c ****     st_check(br_state() == PLUTO_STATE_HOME, "B.about_home_state");
 370:src/core/selftest_browser.c ****     check_str("B.about_home_title", br_page_title(),
 371:src/core/selftest_browser.c ****               "CometBrowser Start Page");
 372:src/core/selftest_browser.c ****     st_check(br_history_count() == 1 &&
 373:src/core/selftest_browser.c ****              !strcmp(br_history_at(0), "about:home"),
 374:src/core/selftest_browser.c ****              "B.about_home_pushed");
 375:src/core/selftest_browser.c **** 
 376:src/core/selftest_browser.c ****     /* bare host gets https:// prepended and fetches */
 377:src/core/selftest_browser.c ****     Route ra[] = { { "/b.html", PAGE_B, 0, NULL },
 378:src/core/selftest_browser.c ****                    { "/", PAGE_A, 0, NULL } };   /* exact "/" must be LAST */
 379:src/core/selftest_browser.c ****     set_routes(ra, 2);
 380:src/core/selftest_browser.c ****     br_navigate_to("example.com");
 381:src/core/selftest_browser.c ****     pump_until_page(30);
 382:src/core/selftest_browser.c ****     st_check(br_state() == PLUTO_STATE_PAGE, "C.page_reached");
 383:src/core/selftest_browser.c ****     check_str("C.prepended_host", g_lastHost, "example.com");
 384:src/core/selftest_browser.c ****     check_str("C.requested_path", g_lastTarget, "/");
 385:src/core/selftest_browser.c ****     check_str("C.normalized",
 386:src/core/selftest_browser.c ****               br_current_normalized(), "https://example.com/");
 387:src/core/selftest_browser.c ****     check_str("C.doc_title", br_page_title(), "Page A");
 388:src/core/selftest_browser.c ****     st_check(br_history_count() == 2 &&
 389:src/core/selftest_browser.c ****              !strcmp(br_history_at(1), "https://example.com"),
 390:src/core/selftest_browser.c ****              "C.history_pushed");
 391:src/core/selftest_browser.c **** 
 392:src/core/selftest_browser.c ****     /* search-query detection rewrites to duckduckgo */
 393:src/core/selftest_browser.c ****     br_navigate_to("playdate wiki");
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccKtCnF9.s 			page 68


 394:src/core/selftest_browser.c ****     pump_until_page(30);
 395:src/core/selftest_browser.c ****     st_check(strstr(g_lastTarget, "/html/?q=playdate") != NULL,
 396:src/core/selftest_browser.c ****              "D.search_query_prefix");
 397:src/core/selftest_browser.c ****     st_check(strstr(g_lastTarget, "wiki") != NULL, "D.search_query_term");
 398:src/core/selftest_browser.c ****     check_str("D.search_host", g_lastHost, "html.duckduckgo.com");
 399:src/core/selftest_browser.c **** 
 400:src/core/selftest_browser.c ****     /* relative link follow via selection + A (d-pad walk is READER-mode
 401:src/core/selftest_browser.c ****      * behavior in CometBrowser, so switch modes like a user would) */
 402:src/core/selftest_browser.c ****     storage_settings()->mode = PLUTO_MODE_READER;
 403:src/core/selftest_browser.c ****     br_boot();                     /* re-reads mode into the engine */
 404:src/core/selftest_browser.c ****     br_navigate_to("http://links.test/");
 405:src/core/selftest_browser.c ****     pump_until_page(30);
 406:src/core/selftest_browser.c ****     push_input(0, 0, 0);                       /* settle */
 407:src/core/selftest_browser.c ****     frame();
 408:src/core/selftest_browser.c ****     push_input(BR_BTN_DOWN, BR_BTN_DOWN, 0);   /* select first link */
 409:src/core/selftest_browser.c ****     frame();
 410:src/core/selftest_browser.c ****     st_check(lm_get_selected_link() != NULL, "E.down_selects");
 411:src/core/selftest_browser.c ****     push_input(BR_BTN_A, BR_BTN_A, 0);         /* follow it */
 412:src/core/selftest_browser.c ****     frame();
 413:src/core/selftest_browser.c ****     pump_until_page(30);
 414:src/core/selftest_browser.c ****     check_str("E.followed_doc_title", br_page_title(), "Page B");
 415:src/core/selftest_browser.c ****     st_check(strstr(g_lastTarget, "/b.html") != NULL, "E.relative_resolved");
 416:src/core/selftest_browser.c **** }
 417:src/core/selftest_browser.c **** 
 418:src/core/selftest_browser.c **** static void t_history_stack(void) {
 419:src/core/selftest_browser.c ****     reset_all();
 420:src/core/selftest_browser.c ****     br_boot();
 421:src/core/selftest_browser.c ****     Route r1[] = { { "/", PAGE_A, 0 } };
 422:src/core/selftest_browser.c ****     set_routes(r1, 1);
 423:src/core/selftest_browser.c **** 
 424:src/core/selftest_browser.c ****     /* seed three entries */
 425:src/core/selftest_browser.c ****     const char* urls[] = { "u.test/1", "u.test/2", "u.test/3" };
