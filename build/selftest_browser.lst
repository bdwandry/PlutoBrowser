   1:Source/core/selftest_browser.c **** // selftest_browser.c -- [P32] offline selftests for the browser engine.
   2:Source/core/selftest_browser.c **** //
   3:Source/core/selftest_browser.c **** // Fully deterministic: a fake playdate_tcp vtable serves canned pages from
   4:Source/core/selftest_browser.c **** // a route table (same injection pattern as the P07 suite), a fake
   5:Source/core/selftest_browser.c **** // millisecond clock feeds both HttpClient and the engine, and a scripted
   6:Source/core/selftest_browser.c **** // BrInput queue replaces hardware buttons. The suite drives br_frame()
   7:Source/core/selftest_browser.c **** // exactly like the real run loop, so navigation, rendering tasks, form
   8:Source/core/selftest_browser.c **** // submission, history, crank physics and the pause menu are all exercised
   9:Source/core/selftest_browser.c **** // end to end. Results land in pluto.log.
  10:Source/core/selftest_browser.c **** 
