 244:src/core/selftest_browser.c **** /* one frame: serve sockets, step inputs, run the real composition */
 245:src/core/selftest_browser.c **** static void frame(void) {
 246:src/core/selftest_browser.c ****     serve_pending();
 247:src/core/selftest_browser.c ****     br_frame();
 248:src/core/selftest_browser.c **** }
 249:src/core/selftest_browser.c **** 
 250:src/core/selftest_browser.c **** static void pump(int frames) { for (int i = 0; i < frames; i++) frame(); }
 251:src/core/selftest_browser.c **** 
 252:src/core/selftest_browser.c **** static int cond_state_page(void) { return br_state() == PLUTO_STATE_PAGE; }
 253:src/core/selftest_browser.c **** 
 254:src/core/selftest_browser.c **** /* settled = page reached AND cooperative build finished */
 255:src/core/selftest_browser.c **** static int cond_settled(void) {
 256:src/core/selftest_browser.c ****     return br_state() == PLUTO_STATE_PAGE && !br_is_rendering();
 257:src/core/selftest_browser.c **** }
 258:src/core/selftest_browser.c **** 
 259:src/core/selftest_browser.c **** static void pump_until_page(int maxFrames) {
 260:src/core/selftest_browser.c ****     frame(); /* always run at least one frame so pendingNav is consumed
 261:src/core/selftest_browser.c ****                 even when the previous page is still on screen */
 262:src/core/selftest_browser.c ****     for (int i = 0; i < maxFrames && !cond_settled(); i++) frame();
 263:src/core/selftest_browser.c ****     /* idle tail: absorbs skipInputFrames armed by fake-clock jumps
 264:src/core/selftest_browser.c ****      * (>500ms gap closes overlays and ignores input for 2 frames) */
 265:src/core/selftest_browser.c ****     pump(3);
 266:src/core/selftest_browser.c **** }
 267:src/core/selftest_browser.c **** 
 268:src/core/selftest_browser.c **** /* settle with NO idle tail: for flows where side effects must not fire
 269:src/core/selftest_browser.c ****  * yet (e.g. a meta-refresh deadline landing during the tail frames) */
 270:src/core/selftest_browser.c **** static void pump_settle_once(int maxFrames) {
 271:src/core/selftest_browser.c ****     frame();
 272:src/core/selftest_browser.c ****     for (int i = 0; i < maxFrames && !cond_settled(); i++) frame();
 273:src/core/selftest_browser.c **** }
