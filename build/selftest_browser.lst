 224:src/core/selftest_browser.c **** static void push_input(unsigned held, unsigned justPressed, float crank) {
 225:src/core/selftest_browser.c ****     if (nQ >= 256) return;
 226:src/core/selftest_browser.c ****     Q[nQ].held = held;
 227:src/core/selftest_browser.c ****     Q[nQ].justPressed = justPressed;
 228:src/core/selftest_browser.c ****     Q[nQ].crankChange = crank;
 229:src/core/selftest_browser.c ****     CLOCK_NOW += 16;
 230:src/core/selftest_browser.c ****     Q[nQ].nowMs = CLOCK_NOW;
 231:src/core/selftest_browser.c ****     nQ++;
 232:src/core/selftest_browser.c **** }
 233:src/core/selftest_browser.c **** 
