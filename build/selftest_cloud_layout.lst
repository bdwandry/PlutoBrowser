  54:Source/render/selftest_cloud_layout.c **** /* ── valid payload ─────────────────────────
  55:Source/render/selftest_cloud_layout.c **** 
  56:Source/render/selftest_cloud_layout.c **** static void case_parse_valid(void) {
  57:Source/render/selftest_cloud_layout.c ****     ClDoc* doc = cl_parse(kFixture, strlen(kFixture), NULL);
  58:Source/render/selftest_cloud_layout.c ****     ck("P.parse_ok", doc != NULL);
  59:Source/render/selftest_cloud_layout.c ****     if (doc == NULL) return;
  60:Source/render/selftest_cloud_layout.c **** 
  61:Source/render/selftest_cloud_layout.c ****     ck("P.title", strcmp(cl_doc_title(doc), "Cloud Demo") == 0);
  62:Source/render/selftest_cloud_layout.c **** 
  63:Source/render/selftest_cloud_layout.c ****     const JsonValue* els = cl_doc_elements(doc);
  64:Source/render/selftest_cloud_layout.c ****     size_t n = (els != NULL) ? json_arr_count(els) : 0;
  65:Source/render/selftest_cloud_layout.c ****     ck("P.elements_count", n == 9);
  66:Source/render/selftest_cloud_layout.c **** 
  67:Source/render/selftest_cloud_layout.c ****     cl_build(doc);
  68:Source/render/selftest_cloud_layout.c **** 
  69:Source/render/selftest_cloud_layout.c ****     /* 4 texts - 1 hidden + 1 image + 1 input + 1 submit = 7
  70:Source/render/selftest_cloud_layout.c ****      * (the plain link registers in LinkManager, not as an item) */
  71:Source/render/selftest_cloud_layout.c ****     ck("B.item_count", cl_item_count() == 7);
  72:Source/render/selftest_cloud_layout.c **** 
  73:Source/render/selftest_cloud_layout.c ****     int okTypes = 1;
  74:Source/render/selftest_cloud_layout.c ****     ClItemType want[] = { CL_TEXT, CL_TEXT, CL_TEXT,
  75:Source/render/selftest_cloud_layout.c ****                           CL_TEXT, CL_IMAGE, CL_INPUT, CL_SUBMIT };
  76:Source/render/selftest_cloud_layout.c ****     for (int i = 0; i < 7; i++) {
  77:Source/render/selftest_cloud_layout.c ****         const ClItem* it = cl_item_at(i);
  78:Source/render/selftest_cloud_layout.c ****         if (it == NULL || it->type != want[i]) okTypes = 0;
  79:Source/render/selftest_cloud_layout.c ****     }
  80:Source/render/selftest_cloud_layout.c ****     ck("B.item_types_order", okTypes);
  81:Source/render/selftest_cloud_layout.c **** 
  82:Source/render/selftest_cloud_layout.c ****     const ClItem* t0 = cl_item_at(0);
  83:Source/render/selftest_cloud_layout.c ****     ck("B.y_offset_content_y", t0->y == 24 + 4);   /* CONTENT_Y + el.y */
  84:Source/render/selftest_cloud_layout.c ****     ck("B.text_copy", t0->text && strcmp(t0->text, "Hello Cloud") == 0);
  85:Source/render/selftest_cloud_layout.c **** 
  86:Source/render/selftest_cloud_layout.c ****     /* font slot mapping */
  87:Source/render/selftest_cloud_layout.c ****     int sz, lh;
  88:Source/render/selftest_cloud_layout.c ****     PlutoFont* h1 = style_get_heading_font(1, NULL, NULL);
  89:Source/render/selftest_cloud_layout.c ****     PlutoFont* bb = style_get_body_font(1, 0, &sz);
  90:Source/render/selftest_cloud_layout.c ****     PlutoFont* mo = style_get_body_font(0, 1, &sz);
  91:Source/render/selftest_cloud_layout.c ****     PlutoFont* bo = style_get_body_font(0, 0, &sz);
  92:Source/render/selftest_cloud_layout.c ****     ck("F.large_heading1", cl_item_at(0)->font == h1);
  93:Source/render/selftest_cloud_layout.c ****     ck("F.bold_bodyBold", cl_item_at(1)->font == bb);
  94:Source/render/selftest_cloud_layout.c ****     ck("F.mono_mono", cl_item_at(2)->font == mo);
  95:Source/render/selftest_cloud_layout.c ****     ck("F.default_body", cl_item_at(3)->font == bo);
  96:Source/render/selftest_cloud_layout.c **** 
  97:Source/render/selftest_cloud_layout.c ****     const ClItem* img = cl_item_at(4);
  98:Source/render/selftest_cloud_layout.c ****     ck("I.src_alt_default",
  99:Source/render/selftest_cloud_layout.c ****        img->src && strcmp(img->src, "img/logo.png") == 0 &&
 100:Source/render/selftest_cloud_layout.c ****        img->alt && strcmp(img->alt, "Image") == 0);
 101:Source/render/selftest_cloud_layout.c **** 
 102:Source/render/selftest_cloud_layout.c ****     const ClItem* inp = cl_item_at(5);
 103:Source/render/selftest_cloud_layout.c ****     ck("N.input_fields",
 104:Source/render/selftest_cloud_layout.c ****        inp->inputType && strcmp(inp->inputType, "email") == 0 &&
 105:Source/render/selftest_cloud_layout.c ****        inp->name && strcmp(inp->name, "email") == 0 &&
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccVialj3.s 			page 14


 106:Source/render/selftest_cloud_layout.c ****        inp->value && strcmp(inp->value, "a@b.c") == 0 &&
 107:Source/render/selftest_cloud_layout.c ****        inp->placeholder &&
 108:Source/render/selftest_cloud_layout.c ****        strcmp(inp->placeholder, "you@example.com") == 0);
 109:Source/render/selftest_cloud_layout.c **** 
 110:Source/render/selftest_cloud_layout.c ****     const ClItem* sub = cl_item_at(6);
 111:Source/render/selftest_cloud_layout.c ****     ck("N.submit_fields",
 112:Source/render/selftest_cloud_layout.c ****        sub->label && strcmp(sub->label, "Go") == 0 &&
 113:Source/render/selftest_cloud_layout.c ****        sub->formAction && strcmp(sub->formAction, "/search") == 0);
 114:Source/render/selftest_cloud_layout.c **** 
 115:Source/render/selftest_cloud_layout.c ****     ck("S.total_height_kept", cl_total_height() == 500.0);
 116:Source/render/selftest_cloud_layout.c ****     ck("X.no_selected_input", cl_selected_input() == NULL);
 117:Source/render/selftest_cloud_layout.c **** 
 118:Source/render/selftest_cloud_layout.c ****     /* negative-y text skipped entirely */
 119:Source/render/selftest_cloud_layout.c ****     int hiddenFound = 0;
 120:Source/render/selftest_cloud_layout.c ****     for (int i = 0; i < cl_item_count(); i++)
 121:Source/render/selftest_cloud_layout.c ****         if (cl_item_at(i)->text &&
 122:Source/render/selftest_cloud_layout.c ****             strcmp(cl_item_at(i)->text, "hidden") == 0)
 123:Source/render/selftest_cloud_layout.c ****             hiddenFound = 1;
 124:Source/render/selftest_cloud_layout.c ****     ck("B.negative_y_skipped", !hiddenFound);
 125:Source/render/selftest_cloud_layout.c **** 
 126:Source/render/selftest_cloud_layout.c ****     /* LinkManager got: 1 plain link + input link + submit link.
 127:Source/render/selftest_cloud_layout.c ****      * Walk the selection exactly count times: selectNext wraps around,
 128:Source/render/selftest_cloud_layout.c ****      * so it never signals the end by returning NULL. */
 129:Source/render/selftest_cloud_layout.c ****     ck("L.lm_count_3", lm_get_count() == 3);
 130:Source/render/selftest_cloud_layout.c ****     LmLink* l = (lm_get_count() > 0) ? lm_select_next(0) : NULL;
 131:Source/render/selftest_cloud_layout.c ****     int formLinks = 0, blocksOk = 0;
 132:Source/render/selftest_cloud_layout.c ****     size_t steps = 1;
 133:Source/render/selftest_cloud_layout.c ****     while (l != NULL && steps <= lm_get_count()) {
 134:Source/render/selftest_cloud_layout.c ****         if (l->isFormInput) {
 135:Source/render/selftest_cloud_layout.c ****             formLinks++;
 136:Source/render/selftest_cloud_layout.c ****             if (l->inputBlock == (void*)inp || l->inputBlock == (void*)sub)
 137:Source/render/selftest_cloud_layout.c ****                 blocksOk++;
 138:Source/render/selftest_cloud_layout.c ****         }
 139:Source/render/selftest_cloud_layout.c ****         l = lm_select_next(l->primaryRect.y);
 140:Source/render/selftest_cloud_layout.c ****         steps++;
 141:Source/render/selftest_cloud_layout.c ****     }
 142:Source/render/selftest_cloud_layout.c ****     ck("L.form_links_2", formLinks == 2);
 143:Source/render/selftest_cloud_layout.c ****     ck("L.input_blocks_wired", blocksOk == 2);
 144:Source/render/selftest_cloud_layout.c **** 
 145:Source/render/selftest_cloud_layout.c ****     cl_doc_free(doc);
 146:Source/render/selftest_cloud_layout.c **** }
 147:Source/render/selftest_cloud_layout.c **** 
 148:Source/render/selftest_cloud_layout.c **** /* ── malformed JSON → Parse Error fallback ────────────────�
 149:Source/render/selftest_cloud_layout.c **** 
 150:Source/render/selftest_cloud_layout.c **** static void case_parse_error(void) {
 151:Source/render/selftest_cloud_layout.c ****     static const char* bad = "{\"title\": \"Broken\",,,}";
 152:Source/render/selftest_cloud_layout.c ****     ClDoc* doc = cl_parse(bad, strlen(bad), NULL);
 153:Source/render/selftest_cloud_layout.c ****     ck("E.doc_returned", doc != NULL);
 154:Source/render/selftest_cloud_layout.c ****     if (doc == NULL) return;
 155:Source/render/selftest_cloud_layout.c **** 
 156:Source/render/selftest_cloud_layout.c ****     ck("E.title_parse_error", strcmp(cl_doc_title(doc), "Parse Error") == 0);
 157:Source/render/selftest_cloud_layout.c ****     ck("E.elements_empty", cl_doc_elements(doc) == NULL);
 158:Source/render/selftest_cloud_layout.c **** 
 159:Source/render/selftest_cloud_layout.c ****     cl_build(doc);
 160:Source/render/selftest_cloud_layout.c ****     ck("E.build_resets_to_content_h",
 161:Source/render/selftest_cloud_layout.c ****        cl_total_height() == (double)PLUTO_CONTENT_HEIGHT &&
 162:Source/render/selftest_cloud_layout.c ****        cl_item_count() == 0);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccVialj3.s 			page 15


 163:Source/render/selftest_cloud_layout.c **** 
 164:Source/render/selftest_cloud_layout.c ****     cl_doc_free(doc);
 165:Source/render/selftest_cloud_layout.c **** }
 166:Source/render/selftest_cloud_layout.c **** 
 167:Source/render/selftest_cloud_layout.c **** /* ── defaults: missing title/totalHeight/elements ──────────────�
