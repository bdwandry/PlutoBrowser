 104:src/render/selftest_cloud_layout.c ****        inp->inputType && strcmp(inp->inputType, "email") == 0 &&
 105:src/render/selftest_cloud_layout.c ****        inp->name && strcmp(inp->name, "email") == 0 &&
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccfz1n3y.s 			page 14


 106:src/render/selftest_cloud_layout.c ****        inp->value && strcmp(inp->value, "a@b.c") == 0 &&
 107:src/render/selftest_cloud_layout.c ****        inp->placeholder &&
 108:src/render/selftest_cloud_layout.c ****        strcmp(inp->placeholder, "you@example.com") == 0);
 109:src/render/selftest_cloud_layout.c **** 
 110:src/render/selftest_cloud_layout.c ****     const ClItem* sub = cl_item_at(6);
 111:src/render/selftest_cloud_layout.c ****     ck("N.submit_fields",
 112:src/render/selftest_cloud_layout.c ****        sub->label && strcmp(sub->label, "Go") == 0 &&
 113:src/render/selftest_cloud_layout.c ****        sub->formAction && strcmp(sub->formAction, "/search") == 0);
 114:src/render/selftest_cloud_layout.c **** 
 115:src/render/selftest_cloud_layout.c ****     ck("S.total_height_kept", cl_total_height() == 500.0);
 116:src/render/selftest_cloud_layout.c ****     ck("X.no_selected_input", cl_selected_input() == NULL);
 117:src/render/selftest_cloud_layout.c **** 
 118:src/render/selftest_cloud_layout.c ****     /* negative-y text skipped entirely */
 119:src/render/selftest_cloud_layout.c ****     int hiddenFound = 0;
 120:src/render/selftest_cloud_layout.c ****     for (int i = 0; i < cl_item_count(); i++)
 121:src/render/selftest_cloud_layout.c ****         if (cl_item_at(i)->text &&
 122:src/render/selftest_cloud_layout.c ****             strcmp(cl_item_at(i)->text, "hidden") == 0)
 123:src/render/selftest_cloud_layout.c ****             hiddenFound = 1;
 124:src/render/selftest_cloud_layout.c ****     ck("B.negative_y_skipped", !hiddenFound);
 125:src/render/selftest_cloud_layout.c **** 
 126:src/render/selftest_cloud_layout.c ****     /* LinkManager got: 1 plain link + input link + submit link.
 127:src/render/selftest_cloud_layout.c ****      * Walk the selection exactly count times: selectNext wraps around,
 128:src/render/selftest_cloud_layout.c ****      * so it never signals the end by returning NULL. */
 129:src/render/selftest_cloud_layout.c ****     ck("L.lm_count_3", lm_get_count() == 3);
 130:src/render/selftest_cloud_layout.c ****     LmLink* l = (lm_get_count() > 0) ? lm_select_next(0) : NULL;
 131:src/render/selftest_cloud_layout.c ****     int formLinks = 0, blocksOk = 0;
 132:src/render/selftest_cloud_layout.c ****     size_t steps = 1;
 133:src/render/selftest_cloud_layout.c ****     while (l != NULL && steps <= lm_get_count()) {
 134:src/render/selftest_cloud_layout.c ****         if (l->isFormInput) {
 135:src/render/selftest_cloud_layout.c ****             formLinks++;
 136:src/render/selftest_cloud_layout.c ****             if (l->inputBlock == (void*)inp || l->inputBlock == (void*)sub)
 137:src/render/selftest_cloud_layout.c ****                 blocksOk++;
 138:src/render/selftest_cloud_layout.c ****         }
 139:src/render/selftest_cloud_layout.c ****         l = lm_select_next(l->primaryRect.y);
 140:src/render/selftest_cloud_layout.c ****         steps++;
 141:src/render/selftest_cloud_layout.c ****     }
 142:src/render/selftest_cloud_layout.c ****     ck("L.form_links_2", formLinks == 2);
 143:src/render/selftest_cloud_layout.c ****     ck("L.input_blocks_wired", blocksOk == 2);
 144:src/render/selftest_cloud_layout.c **** 
 145:src/render/selftest_cloud_layout.c ****     cl_doc_free(doc);
 146:src/render/selftest_cloud_layout.c **** }
