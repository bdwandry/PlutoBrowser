  30:Source/render/selftest_cloud_layout.c **** /* Fixture covering every element type incl. a negative-y skip. */
  31:Source/render/selftest_cloud_layout.c **** static const char* kFixture =
  32:Source/render/selftest_cloud_layout.c ****     "{\"title\":\"Cloud Demo\",\"totalHeight\":500,\"elements\":["
  33:Source/render/selftest_cloud_layout.c ****     "{\"type\":\"text\",\"x\":8,\"y\":4,\"w\":384,\"h\":20,"
  34:Source/render/selftest_cloud_layout.c ****     "\"text\":\"Hello Cloud\",\"font\":\"large\"},"
  35:Source/render/selftest_cloud_layout.c ****     "{\"type\":\"text\",\"x\":8,\"y\":30,\"w\":200,\"h\":14,"
  36:Source/render/selftest_cloud_layout.c ****     "\"text\":\"bold line\",\"font\":\"bold\"},"
  37:Source/render/selftest_cloud_layout.c ****     "{\"type\":\"text\",\"x\":8,\"y\":50,\"w\":200,\"h\":14,"
  38:Source/render/selftest_cloud_layout.c ****     "\"text\":\"code line\",\"font\":\"mono\"},"
  39:Source/render/selftest_cloud_layout.c ****     "{\"type\":\"text\",\"x\":8,\"y\":70,\"w\":300,\"h\":14,"
  40:Source/render/selftest_cloud_layout.c ****     "\"text\":\"plain line\"},"
  41:Source/render/selftest_cloud_layout.c ****     "{\"type\":\"image\",\"x\":8,\"y\":90,\"w\":64,\"h\":64,"
  42:Source/render/selftest_cloud_layout.c ****     "\"src\":\"img/logo.png\"},"
  43:Source/render/selftest_cloud_layout.c ****     "{\"type\":\"link\",\"x\":8,\"y\":160,\"w\":100,\"h\":14,"
  44:Source/render/selftest_cloud_layout.c ****     "\"href\":\"https://example.com/a\"},"
  45:Source/render/selftest_cloud_layout.c ****     "{\"type\":\"input\",\"x\":8,\"y\":180,\"w\":180,\"h\":22,"
  46:Source/render/selftest_cloud_layout.c ****     "\"inputType\":\"email\",\"name\":\"email\",\"value\":\"a@b.c\","
  47:Source/render/selftest_cloud_layout.c ****     "\"placeholder\":\"you@example.com\"},"
  48:Source/render/selftest_cloud_layout.c ****     "{\"type\":\"submit\",\"x\":196,\"y\":180,\"w\":60,\"h\":22,"
