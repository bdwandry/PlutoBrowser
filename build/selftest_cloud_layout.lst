  68:src/render/selftest_cloud_layout.c **** 
  69:src/render/selftest_cloud_layout.c ****     /* 4 texts - 1 hidden + 1 image + 1 input + 1 submit = 7
  70:src/render/selftest_cloud_layout.c ****      * (the plain link registers in LinkManager, not as an item) */
  71:src/render/selftest_cloud_layout.c ****     ck("B.item_count", cl_item_count() == 7);
  72:src/render/selftest_cloud_layout.c **** 
  73:src/render/selftest_cloud_layout.c ****     int okTypes = 1;
  74:src/render/selftest_cloud_layout.c ****     ClItemType want[] = { CL_TEXT, CL_TEXT, CL_TEXT,
  75:src/render/selftest_cloud_layout.c ****                           CL_TEXT, CL_IMAGE, CL_INPUT, CL_SUBMIT };
  76:src/render/selftest_cloud_layout.c ****     for (int i = 0; i < 7; i++) {
  77:src/render/selftest_cloud_layout.c ****         const ClItem* it = cl_item_at(i);
  78:src/render/selftest_cloud_layout.c ****         if (it == NULL || it->type != want[i]) okTypes = 0;
  79:src/render/selftest_cloud_layout.c ****     }
  80:src/render/selftest_cloud_layout.c ****     ck("B.item_types_order", okTypes);
  81:src/render/selftest_cloud_layout.c **** 
  82:src/render/selftest_cloud_layout.c ****     const ClItem* t0 = cl_item_at(0);
  83:src/render/selftest_cloud_layout.c ****     ck("B.y_offset_content_y", t0->y == 24 + 4);   /* CONTENT_Y + el.y */
  84:src/render/selftest_cloud_layout.c ****     ck("B.text_copy", t0->text && strcmp(t0->text, "Hello Cloud") == 0);
  85:src/render/selftest_cloud_layout.c **** 
  86:src/render/selftest_cloud_layout.c ****     /* font slot mapping */
  87:src/render/selftest_cloud_layout.c ****     int sz, lh;
  88:src/render/selftest_cloud_layout.c ****     PlutoFont* h1 = style_get_heading_font(1, NULL, NULL);
  89:src/render/selftest_cloud_layout.c ****     PlutoFont* bb = style_get_body_font(1, 0, &sz);
  90:src/render/selftest_cloud_layout.c ****     PlutoFont* mo = style_get_body_font(0, 1, &sz);
  91:src/render/selftest_cloud_layout.c ****     PlutoFont* bo = style_get_body_font(0, 0, &sz);
  92:src/render/selftest_cloud_layout.c ****     ck("F.large_heading1", cl_item_at(0)->font == h1);
  93:src/render/selftest_cloud_layout.c ****     ck("F.bold_bodyBold", cl_item_at(1)->font == bb);
  94:src/render/selftest_cloud_layout.c ****     ck("F.mono_mono", cl_item_at(2)->font == mo);
  95:src/render/selftest_cloud_layout.c ****     ck("F.default_body", cl_item_at(3)->font == bo);
  96:src/render/selftest_cloud_layout.c **** 
  97:src/render/selftest_cloud_layout.c ****     const ClItem* img = cl_item_at(4);
  98:src/render/selftest_cloud_layout.c ****     ck("I.src_alt_default",
  99:src/render/selftest_cloud_layout.c ****        img->src && strcmp(img->src, "img/logo.png") == 0 &&
 100:src/render/selftest_cloud_layout.c ****        img->alt && strcmp(img->alt, "Image") == 0);
 101:src/render/selftest_cloud_layout.c **** 
