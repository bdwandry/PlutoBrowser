 961:Source/keyboard/keyboard.c **** // override on the main playdate.update function so that we can run our animations without requirin
 962:Source/keyboard/keyboard.c **** static int keyboardUpdate(void * _Nonnull userdata) {
 963:Source/keyboard/keyboard.c ****     PDKeyboard *self = userdata;
 964:Source/keyboard/keyboard.c **** 
 965:Source/keyboard/keyboard.c ****     if (self->isVisible) {
 966:Source/keyboard/keyboard.c ****         static int kbDbgFrames = 0;
 967:Source/keyboard/keyboard.c ****         const int dbg = (kbDbgFrames < 25);
 968:Source/keyboard/keyboard.c ****         if (dbg) { logger_log("KB frame %d: enter", kbDbgFrames); }
 969:Source/keyboard/keyboard.c ****         enterNewLetterIfNecessary(self);
 970:Source/keyboard/keyboard.c ****         if (dbg) { logger_log("KB frame %d: letters ok", kbDbgFrames); }
 971:Source/keyboard/keyboard.c **** 
 972:Source/keyboard/keyboard.c ****         if (self->currentAnimationType != kAnimationTypeNone) {
 973:Source/keyboard/keyboard.c ****             updateAnimation(self);
 974:Source/keyboard/keyboard.c **** 
 975:Source/keyboard/keyboard.c ****             if (isShowOrHideAnimation(self->currentAnimationType)) {
 976:Source/keyboard/keyboard.c ****                 if (self->keyboardAnimatingCallback) {
 977:Source/keyboard/keyboard.c ****                     self->keyboardAnimatingCallback(self->keyboardAnimatingCallbackUserdata);
 978:Source/keyboard/keyboard.c ****                 }
 979:Source/keyboard/keyboard.c ****             }
 980:Source/keyboard/keyboard.c ****         }
 981:Source/keyboard/keyboard.c ****         if (dbg) { logger_log("KB frame %d: anim ok", kbDbgFrames); }
 982:Source/keyboard/keyboard.c **** 
 983:Source/keyboard/keyboard.c ****         if (!self->justOpened) {
 984:Source/keyboard/keyboard.c ****             checkButtonInputs(self);
 985:Source/keyboard/keyboard.c ****             const float crankChange = playdate->system->getCrankChange();
 986:Source/keyboard/keyboard.c ****             if (crankChange != 0.0f) {
 987:Source/keyboard/keyboard.c ****                 keyboardInputCranked(self, crankChange);
 988:Source/keyboard/keyboard.c ****             }
 989:Source/keyboard/keyboard.c ****         } else {
 990:Source/keyboard/keyboard.c ****             self->justOpened = false;
 991:Source/keyboard/keyboard.c ****         }
 992:Source/keyboard/keyboard.c ****         if (dbg) { logger_log("KB frame %d: input ok", kbDbgFrames); }
 993:Source/keyboard/keyboard.c **** 
 994:Source/keyboard/keyboard.c ****         self->playdateUpdate(self->playdateUpdateUserdata);
 995:Source/keyboard/keyboard.c ****         if (dbg) { logger_log("KB frame %d: app update ok", kbDbgFrames); }
 996:Source/keyboard/keyboard.c ****         drawKeyboard(self);
 997:Source/keyboard/keyboard.c ****         if (dbg) { logger_log("KB frame %d: draw ok", kbDbgFrames); }
 998:Source/keyboard/keyboard.c ****         kbDbgFrames++;
 999:Source/keyboard/keyboard.c ****     }
1000:Source/keyboard/keyboard.c ****     return true;
1001:Source/keyboard/keyboard.c **** }
