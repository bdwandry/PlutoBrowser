 192:Source/vendor/keyboard/keyboard.c **** #pragma mark - Keyboard Input Handler
 193:Source/vendor/keyboard/keyboard.c **** 
 194:Source/vendor/keyboard/keyboard.c **** static const float clickDegrees = 360.0f / 15.0f;
 195:Source/vendor/keyboard/keyboard.c **** 
 196:Source/vendor/keyboard/keyboard.c **** static void keyboardInputCranked(PDKeyboard * _Nonnull self, float change) {
 197:Source/vendor/keyboard/keyboard.c ****     const float acceleratedChange = change * (1.0f / (0.2f + powf(1.04f, -fabsf(change) + 20.0f)));
 198:Source/vendor/keyboard/keyboard.c ****     const float degreesSinceClick = self->degreesSinceClick + acceleratedChange;
 199:Source/vendor/keyboard/keyboard.c **** 
 200:Source/vendor/keyboard/keyboard.c ****     if (degreesSinceClick > clickDegrees) {
 201:Source/vendor/keyboard/keyboard.c ****         const int clickCount = floorf(degreesSinceClick / clickDegrees);
 202:Source/vendor/keyboard/keyboard.c ****         self->degreesSinceClick = 0.0f;
 203:Source/vendor/keyboard/keyboard.c ****         moveSelectionDown(self, clickCount, false);
 204:Source/vendor/keyboard/keyboard.c ****     } else if (degreesSinceClick < -clickDegrees) {
 205:Source/vendor/keyboard/keyboard.c ****         const int clickCount = ceilf(-degreesSinceClick / clickDegrees);
 206:Source/vendor/keyboard/keyboard.c ****         self->degreesSinceClick = 0.0f;
 207:Source/vendor/keyboard/keyboard.c ****         moveSelectionUp(self, clickCount, false);
 208:Source/vendor/keyboard/keyboard.c ****     } else {
 209:Source/vendor/keyboard/keyboard.c ****         self->degreesSinceClick = degreesSinceClick;
 210:Source/vendor/keyboard/keyboard.c ****     }
 211:Source/vendor/keyboard/keyboard.c **** }
 212:Source/vendor/keyboard/keyboard.c **** 
 213:Source/vendor/keyboard/keyboard.c **** 
