 221:Source/keyboard/keyboard.c **** static float linearEase(float t, float b, float c, float d) {
 222:Source/keyboard/keyboard.c ****     return c * t / d + b;
 223:Source/keyboard/keyboard.c **** }
 224:Source/keyboard/keyboard.c **** 
 225:Source/keyboard/keyboard.c **** static float outBackEase(float t, float b, float c, float d, float s) {
 226:Source/keyboard/keyboard.c ****     if (s == 0) {
 227:Source/keyboard/keyboard.c ****         s = 1.70158f;
 228:Source/keyboard/keyboard.c ****     }
 229:Source/keyboard/keyboard.c ****     t = t / d - 1.0f;
 230:Source/keyboard/keyboard.c ****     return floorf(c * (t * t * ((s + 1) * t + s) + 1) + b);
