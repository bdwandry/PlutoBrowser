 199:Source/keyboard/keyboard.c **** static const float clickDegrees = 360.0f / 15.0f;
 200:Source/keyboard/keyboard.c **** 
 201:Source/keyboard/keyboard.c **** static void keyboardInputCranked(PDKeyboard * _Nonnull self, float change) {
 202:Source/keyboard/keyboard.c ****     const float acceleratedChange = change * (1.0f / (0.2f + powf(1.04f, -fabsf(change) + 20.0f)));
 203:Source/keyboard/keyboard.c ****     const float degreesSinceClick = self->degreesSinceClick + acceleratedChange;
 204:Source/keyboard/keyboard.c **** 
 205:Source/keyboard/keyboard.c ****     if (degreesSinceClick > clickDegrees) {
 206:Source/keyboard/keyboard.c ****         const int clickCount = floorf(degreesSinceClick / clickDegrees);
 207:Source/keyboard/keyboard.c ****         self->degreesSinceClick = 0.0f;
 208:Source/keyboard/keyboard.c ****         moveSelectionDown(self, clickCount, false);
 209:Source/keyboard/keyboard.c ****     } else if (degreesSinceClick < -clickDegrees) {
 210:Source/keyboard/keyboard.c ****         const int clickCount = ceilf(-degreesSinceClick / clickDegrees);
 211:Source/keyboard/keyboard.c ****         self->degreesSinceClick = 0.0f;
 212:Source/keyboard/keyboard.c ****         moveSelectionUp(self, clickCount, false);
 213:Source/keyboard/keyboard.c ****     } else {
 214:Source/keyboard/keyboard.c ****         self->degreesSinceClick = degreesSinceClick;
 215:Source/keyboard/keyboard.c ****     }
 216:Source/keyboard/keyboard.c **** }
