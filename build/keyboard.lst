 356:vendor/keyboard/keyboard.c ****     }
 357:vendor/keyboard/keyboard.c **** 
 358:vendor/keyboard/keyboard.c ****     const int8_t rowShift = self->rowShift;
 359:vendor/keyboard/keyboard.c ****     if (rowShift > 0) {
 360:vendor/keyboard/keyboard.c ****         selectedRect.origin.y += 5;
 361:vendor/keyboard/keyboard.c ****         self->rowShift = rowShift - 1;
 362:vendor/keyboard/keyboard.c ****     } else if (rowShift < 0) {
 363:vendor/keyboard/keyboard.c ****         selectedRect.origin.y -= 5;
 364:vendor/keyboard/keyboard.c ****         self->rowShift = rowShift + 1;
 365:vendor/keyboard/keyboard.c ****     }
 366:vendor/keyboard/keyboard.c **** 
 367:vendor/keyboard/keyboard.c ****     const int8_t rowJiggle = self->rowJiggle;
 368:vendor/keyboard/keyboard.c ****     if (rowJiggle > 0) {
