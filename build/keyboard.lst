 346:Source/vendor/keyboard/keyboard.c ****     selectedRect.origin.x += leftX;
 347:Source/vendor/keyboard/keyboard.c ****     switch (currentAnimationType) {
 348:Source/vendor/keyboard/keyboard.c ****         case kAnimationTypeSelectionUp:
 349:Source/vendor/keyboard/keyboard.c ****             selectedRect.origin.y += 3;
 350:Source/vendor/keyboard/keyboard.c ****             break;
 351:Source/vendor/keyboard/keyboard.c ****         case kAnimationTypeSelectionDown:
 352:Source/vendor/keyboard/keyboard.c ****             selectedRect.origin.y -= 3;
