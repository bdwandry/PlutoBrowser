 215:vendor/keyboard/keyboard.c **** 
 216:vendor/keyboard/keyboard.c **** static float linearEase(float t, float b, float c, float d) {
 217:vendor/keyboard/keyboard.c ****     return c * t / d + b;
 218:vendor/keyboard/keyboard.c **** }
 219:vendor/keyboard/keyboard.c **** 
 220:vendor/keyboard/keyboard.c **** static float outBackEase(float t, float b, float c, float d, float s) {
 221:vendor/keyboard/keyboard.c ****     if (s == 0) {
 222:vendor/keyboard/keyboard.c ****         s = 1.70158f;
 223:vendor/keyboard/keyboard.c ****     }
 224:vendor/keyboard/keyboard.c ****     t = t / d - 1.0f;
 225:vendor/keyboard/keyboard.c ****     return floorf(c * (t * t * ((s + 1) * t + s) + 1) + b);
 226:vendor/keyboard/keyboard.c **** }
