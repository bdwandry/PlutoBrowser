 977:Source/keyboard/keyboard.c ****                 if (self->keyboardAnimatingCallback) {
 978:Source/keyboard/keyboard.c ****                     self->keyboardAnimatingCallback(self->keyboardAnimatingCallbackUserdata);
 979:Source/keyboard/keyboard.c ****                 }
 980:Source/keyboard/keyboard.c ****             }
 981:Source/keyboard/keyboard.c ****         }
 982:Source/keyboard/keyboard.c **** 
 983:Source/keyboard/keyboard.c ****         if (!self->justOpened) {
 984:Source/keyboard/keyboard.c ****             checkButtonInputs(self);
