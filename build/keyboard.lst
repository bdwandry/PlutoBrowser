 972:Source/keyboard/keyboard.c ****                 if (self->keyboardAnimatingCallback) {
 973:Source/keyboard/keyboard.c ****                     self->keyboardAnimatingCallback(self->keyboardAnimatingCallbackUserdata);
 974:Source/keyboard/keyboard.c ****                 }
 975:Source/keyboard/keyboard.c ****             }
 976:Source/keyboard/keyboard.c ****         }
 977:Source/keyboard/keyboard.c **** 
 978:Source/keyboard/keyboard.c ****         if (!self->justOpened) {
 979:Source/keyboard/keyboard.c ****             checkButtonInputs(self);
 980:Source/keyboard/keyboard.c ****             const float crankChange = playdate->system->getCrankChange();
 981:Source/keyboard/keyboard.c ****             if (crankChange != 0.0f) {
 982:Source/keyboard/keyboard.c ****                 keyboardInputCranked(self, crankChange);
 983:Source/keyboard/keyboard.c ****             }
 984:Source/keyboard/keyboard.c ****         } else {
 985:Source/keyboard/keyboard.c ****             self->justOpened = false;
 986:Source/keyboard/keyboard.c ****         }
 987:Source/keyboard/keyboard.c **** 
 988:Source/keyboard/keyboard.c ****         self->playdateUpdate(self->playdateUpdateUserdata);
 989:Source/keyboard/keyboard.c ****         drawKeyboard(self);
 990:Source/keyboard/keyboard.c ****     }
 991:Source/keyboard/keyboard.c ****     return true;
 992:Source/keyboard/keyboard.c **** }
