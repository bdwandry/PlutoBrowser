 340:Source/vendor/keyboard/keyboard.c ****     gfx.setDrawMode(kDrawModeCopy);
 341:Source/vendor/keyboard/keyboard.c ****     gfx.fillRect(leftX + 2, 0, displayWidth - leftX, displayHeight, kColorBlack);
