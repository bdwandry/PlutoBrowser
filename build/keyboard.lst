 316:vendor/keyboard/keyboard.c **** static void drawKeyboard(PDKeyboard * _Nonnull self) {
 317:vendor/keyboard/keyboard.c ****     // playdate->graphics->pushContext();
 318:vendor/keyboard/keyboard.c ****     const struct playdate_graphics gfx = *playdate->graphics;
 319:vendor/keyboard/keyboard.c **** 
 320:vendor/keyboard/keyboard.c ****     const PDKeyboardAnimationType currentAnimationType = self->currentAnimationType;
 321:vendor/keyboard/keyboard.c ****     const bool_t animating = isShowOrHideAnimation(currentAnimationType);
 322:vendor/keyboard/keyboard.c **** 
 323:vendor/keyboard/keyboard.c ****     const struct rectangle keyboardRect = self->keyboardRect;
 324:vendor/keyboard/keyboard.c ****     int columnOffsets[kColumnCount];
 325:vendor/keyboard/keyboard.c **** 
 326:vendor/keyboard/keyboard.c ****     if (!animating) {
 327:vendor/keyboard/keyboard.c ****         for (unsigned int index = 0; index < kColumnCount; index++) {
 328:vendor/keyboard/keyboard.c ****             columnOffsets[index] = keyboardRect.origin.x + columnPositions[index];
 329:vendor/keyboard/keyboard.c ****         }
 330:vendor/keyboard/keyboard.c ****     } else {
 331:vendor/keyboard/keyboard.c ****         const float progress = keyboardRect.size.width / keyboardWidth;
 332:vendor/keyboard/keyboard.c ****         for (unsigned int index = 0; index < kColumnCount; index++) {
 333:vendor/keyboard/keyboard.c ****             columnOffsets[index] = keyboardRect.origin.x + (columnPositions[index] * progress);
 334:vendor/keyboard/keyboard.c ****         }
 335:vendor/keyboard/keyboard.c ****     }
 336:vendor/keyboard/keyboard.c **** 
 337:vendor/keyboard/keyboard.c ****     const float leftX = keyboardRect.origin.x;
 338:vendor/keyboard/keyboard.c **** 
 339:vendor/keyboard/keyboard.c ****     // background
 340:vendor/keyboard/keyboard.c ****     gfx.setDrawMode(kDrawModeCopy);
 341:vendor/keyboard/keyboard.c ****     gfx.fillRect(leftX + 2, 0, displayWidth - leftX, displayHeight, kColorBlack);
 342:vendor/keyboard/keyboard.c ****     gfx.fillRect(leftX, 0, 2, displayHeight, kColorWhite);
 343:vendor/keyboard/keyboard.c **** 
 344:vendor/keyboard/keyboard.c ****     // selection
 345:vendor/keyboard/keyboard.c ****     struct rectangle selectedRect = self->selectedCharacterRect;
 346:vendor/keyboard/keyboard.c ****     selectedRect.origin.x += leftX;
 347:vendor/keyboard/keyboard.c ****     switch (currentAnimationType) {
 348:vendor/keyboard/keyboard.c ****         case kAnimationTypeSelectionUp:
 349:vendor/keyboard/keyboard.c ****             selectedRect.origin.y += 3;
 350:vendor/keyboard/keyboard.c ****             break;
 351:vendor/keyboard/keyboard.c ****         case kAnimationTypeSelectionDown:
 352:vendor/keyboard/keyboard.c ****             selectedRect.origin.y -= 3;
 353:vendor/keyboard/keyboard.c ****             break;
