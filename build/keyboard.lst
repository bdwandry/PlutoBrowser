 215:Source/vendor/keyboard/keyboard.c **** 
 216:Source/vendor/keyboard/keyboard.c **** static float linearEase(float t, float b, float c, float d) {
 217:Source/vendor/keyboard/keyboard.c ****     return c * t / d + b;
 218:Source/vendor/keyboard/keyboard.c **** }
 219:Source/vendor/keyboard/keyboard.c **** 
 220:Source/vendor/keyboard/keyboard.c **** static float outBackEase(float t, float b, float c, float d, float s) {
 221:Source/vendor/keyboard/keyboard.c ****     if (s == 0) {
 222:Source/vendor/keyboard/keyboard.c ****         s = 1.70158f;
 223:Source/vendor/keyboard/keyboard.c ****     }
 224:Source/vendor/keyboard/keyboard.c ****     t = t / d - 1.0f;
 225:Source/vendor/keyboard/keyboard.c ****     return floorf(c * (t * t * ((s + 1) * t + s) + 1) + b);
 226:Source/vendor/keyboard/keyboard.c **** }
