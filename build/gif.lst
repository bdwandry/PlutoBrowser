  96:src/render/decoders/gif.c **** static int gif_read_code(long* bitPos, int codeSize,
  97:src/render/decoders/gif.c ****                          const uint8_t* lzw, size_t lzwLen) {
  98:src/render/decoders/gif.c ****     size_t bytePos = (size_t)(*bitPos >> 3);   /* Lua bytePos-1 */
  99:src/render/decoders/gif.c ****     if (bytePos >= lzwLen) return -1;
 100:src/render/decoders/gif.c ****     int b1 = lzw[bytePos];
 101:src/render/decoders/gif.c ****     int b2 = bytePos + 1 < lzwLen ? lzw[bytePos + 1] : 0;
 102:src/render/decoders/gif.c ****     int b3 = bytePos + 2 < lzwLen ? lzw[bytePos + 2] : 0;
 103:src/render/decoders/gif.c ****     unsigned val = ((unsigned)b1 | ((unsigned)b2 << 8) |
 104:src/render/decoders/gif.c ****                     ((unsigned)b3 << 16)) >>
 105:src/render/decoders/gif.c ****                    (*bitPos & 7);
 106:src/render/decoders/gif.c ****     *bitPos += codeSize;
 107:src/render/decoders/gif.c ****     return (int)(val & ((1u << codeSize) - 1));
 108:src/render/decoders/gif.c **** }
 109:src/render/decoders/gif.c **** 
 110:src/render/decoders/gif.c **** int gif_decode_gray(const uint8_t* data, size_t len,
 111:src/render/decoders/gif.c ****                     int maxW, int maxH,
 112:src/render/decoders/gif.c ****                     uint8_t*** outRows, int* outW, int* outH) {
 113:src/render/decoders/gif.c ****     *outRows = NULL;
 114:src/render/decoders/gif.c ****     *outW = *outH = 0;
 115:src/render/decoders/gif.c ****     if (data == NULL || len < 14) return -1;
 116:src/render/decoders/gif.c **** 
 117:src/render/decoders/gif.c ****     if (memcmp(data, "GIF87a", 6) != 0 &&
 118:src/render/decoders/gif.c ****         memcmp(data, "GIF89a", 6) != 0)
 119:src/render/decoders/gif.c ****         return -1;
 120:src/render/decoders/gif.c **** 
 121:src/render/decoders/gif.c ****     if (maxW <= 0) maxW = 360;      /* Lua `maxW or 360` */
 122:src/render/decoders/gif.c ****     if (maxH <= 0) maxH = 200;
 123:src/render/decoders/gif.c **** 
 124:src/render/decoders/gif.c ****     int screenW = (int)gif_u16le(data, len, 6);
 125:src/render/decoders/gif.c ****     int screenH = (int)gif_u16le(data, len, 8);
 126:src/render/decoders/gif.c ****     int packed = gif_byte(data, len, 10);
 127:src/render/decoders/gif.c ****     if (packed < 0) packed = 0;
 128:src/render/decoders/gif.c **** 
 129:src/render/decoders/gif.c ****     int hasGlobalPal = (packed & 0x80) != 0;
 130:src/render/decoders/gif.c ****     int globalPalCount = 1 << ((packed & 0x07) + 1);
 131:src/render/decoders/gif.c **** 
 132:src/render/decoders/gif.c ****     size_t pos = 13;   /* Lua pos = 14, 1-based */
 133:src/render/decoders/gif.c ****     uint8_t globalPal[256];
 134:src/render/decoders/gif.c ****     int haveGlobal[256];   /* mirrors which keys exist in the Lua table */
 135:src/render/decoders/gif.c ****     memset(haveGlobal, 0, sizeof(haveGlobal));
 136:src/render/decoders/gif.c **** 
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cck7zbDo.s 			page 5


 137:src/render/decoders/gif.c ****     if (hasGlobalPal) {
 138:src/render/decoders/gif.c ****         if (globalPalCount > 256) globalPalCount = 256;
 139:src/render/decoders/gif.c ****         for (int i = 0; i < globalPalCount; i++) {
 140:src/render/decoders/gif.c ****             int r = gif_byte(data, len, pos);
 141:src/render/decoders/gif.c ****             int g = gif_byte(data, len, pos + 1);
 142:src/render/decoders/gif.c ****             int b = gif_byte(data, len, pos + 2);
 143:src/render/decoders/gif.c ****             pos += 3;
 144:src/render/decoders/gif.c ****             if (r >= 0 && g >= 0 && b >= 0)
 145:src/render/decoders/gif.c ****                 globalPal[i] = (uint8_t)dither_rgb_to_gray(r, g, b);
 146:src/render/decoders/gif.c ****             else
 147:src/render/decoders/gif.c ****                 globalPal[i] = 0;
 148:src/render/decoders/gif.c ****             haveGlobal[i] = 1;
 149:src/render/decoders/gif.c ****         }
 150:src/render/decoders/gif.c ****     }
 151:src/render/decoders/gif.c **** 
 152:src/render/decoders/gif.c ****     /* process blocks until the first Image Descriptor (0x2C) */
 153:src/render/decoders/gif.c ****     int transparentIndex = -1;   /* -1 == Lua nil */
 154:src/render/decoders/gif.c **** 
 155:src/render/decoders/gif.c ****     while (pos <= len) {
 156:src/render/decoders/gif.c ****         int b = gif_byte(data, len, pos);
 157:src/render/decoders/gif.c ****         if (b < 0 || b == 0x3B) {   /* trailer or end of data */
 158:src/render/decoders/gif.c ****             return -1;
 159:src/render/decoders/gif.c ****         } else if (b == 0x21) {     /* extension block */
 160:src/render/decoders/gif.c ****             int extType = gif_byte(data, len, pos + 1);
 161:src/render/decoders/gif.c ****             pos += 2;
 162:src/render/decoders/gif.c ****             if (extType == 0xF9) {  /* graphic control extension */
 163:src/render/decoders/gif.c ****                 int gcePacked = gif_byte(data, len, pos + 1);
 164:src/render/decoders/gif.c ****                 if (gcePacked < 0) gcePacked = 0;
 165:src/render/decoders/gif.c ****                 if ((gcePacked & 1) != 0) {
 166:src/render/decoders/gif.c ****                     transparentIndex =
 167:src/render/decoders/gif.c ****                         gif_byte(data, len, pos + 4);   /* maybe -1 */
 168:src/render/decoders/gif.c ****                 }
 169:src/render/decoders/gif.c ****             }
 170:src/render/decoders/gif.c ****             while (pos <= len) {
 171:src/render/decoders/gif.c ****                 int blockSize = gif_byte(data, len, pos);
 172:src/render/decoders/gif.c ****                 pos += 1;
 173:src/render/decoders/gif.c ****                 if (blockSize < 0) blockSize = 0;
 174:src/render/decoders/gif.c ****                 if (blockSize == 0) break;
 175:src/render/decoders/gif.c ****                 pos += (size_t)blockSize;
 176:src/render/decoders/gif.c ****             }
 177:src/render/decoders/gif.c ****         } else if (b == 0x2C) {     /* image descriptor: decode frame */
 178:src/render/decoders/gif.c ****             GifDeco g;
 179:src/render/decoders/gif.c ****             memset(&g, 0, sizeof(g));
 180:src/render/decoders/gif.c ****             g.imgLeft = (int)gif_u16le(data, len, pos + 1);
 181:src/render/decoders/gif.c ****             /* imgTop unused by the source beyond parsing (rows always
 182:src/render/decoders/gif.c ****              * composite at imgLeft on full-width canvas lines) */
 183:src/render/decoders/gif.c ****             (void)gif_u16le(data, len, pos + 3);
 184:src/render/decoders/gif.c ****             g.imgW = (int)gif_u16le(data, len, pos + 5);
 185:src/render/decoders/gif.c ****             g.imgH = (int)gif_u16le(data, len, pos + 7);
 186:src/render/decoders/gif.c ****             int imgPacked = gif_byte(data, len, pos + 9);
 187:src/render/decoders/gif.c ****             if (imgPacked < 0) imgPacked = 0;
 188:src/render/decoders/gif.c ****             pos += 10;
 189:src/render/decoders/gif.c **** 
 190:src/render/decoders/gif.c ****             g.screenW = screenW;
 191:src/render/decoders/gif.c ****             g.transparentIndex = transparentIndex;
