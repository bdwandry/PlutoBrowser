  43:src/render/decoders/gif.c ****     uint8_t* rowBuf;      /* imgW entries */
  44:src/render/decoders/gif.c ****     uint8_t* canvasRow;   /* screenW entries */
  45:src/render/decoders/gif.c **** 
  46:src/render/decoders/gif.c ****     int interlaced;
  47:src/render/decoders/gif.c ****     int* interlaceRows;   /* emitted row -> linear row */
  48:src/render/decoders/gif.c ****     int nInterRows;
  49:src/render/decoders/gif.c ****     uint8_t** interBuf;   /* linear row -> canvas copy (or NULL) */
  50:src/render/decoders/gif.c ****     uint8_t* blankRow;    /* screenW of 255 */
  51:src/render/decoders/gif.c **** 
