   1:src/render/decoders/gif.c **** // gif.c — C port of Source/render/decoders/gif.lua (GIFDecoder).
   2:src/render/decoders/gif.c **** //
   3:src/render/decoders/gif.c **** // Decodes the first frame of a GIF87a/89a, streaming LZW output straight
   4:src/render/decoders/gif.c **** // into the box-filter downscaler so a full-resolution pixel buffer is
   5:src/render/decoders/gif.c **** // never allocated. The LOGICAL SCREEN is the source canvas (white
   6:src/render/decoders/gif.c **** // background), so offset frames composite correctly. Animated GIFs
   7:src/render/decoders/gif.c **** // render as their first frame. Interlaced frames buffer their rows and
   8:src/render/decoders/gif.c **** // replay them in linear order after the stream ends. The decode loop
   9:src/render/decoders/gif.c **** // calls tasks_yield_check() so large images decode cooperatively.
  10:src/render/decoders/gif.c **** 
