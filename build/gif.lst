  90:src/render/decoders/gif.c **** /* endStream parity: flush the padded partial row, then fill the rest */
  91:src/render/decoders/gif.c **** static void gif_end_stream(GifDeco* g) {
  92:src/render/decoders/gif.c ****     gif_flush_row(g);
  93:src/render/decoders/gif.c ****     while (g->rowIdx < g->imgH) gif_flush_row(g);
  94:src/render/decoders/gif.c **** }
