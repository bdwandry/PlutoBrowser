  57:src/render/decoders/gif.c **** /* flushRow parity: pad the tail, composite onto white screen canvas,
  58:src/render/decoders/gif.c ****  * buffer or addRow, advance row index */
  59:src/render/decoders/gif.c **** static void gif_flush_row(GifDeco* g) {
  60:src/render/decoders/gif.c ****     for (int cx = g->x; cx < g->imgW; cx++) g->rowBuf[cx] = 255;
  61:src/render/decoders/gif.c ****     memset(g->canvasRow, 255, (size_t)g->screenW);
  62:src/render/decoders/gif.c ****     for (int cx = 0; cx < g->imgW; cx++) {
  63:src/render/decoders/gif.c ****         int dst = g->imgLeft + cx;
  64:src/render/decoders/gif.c ****         if (dst >= 0 && dst < g->screenW)
  65:src/render/decoders/gif.c ****             g->canvasRow[dst] = g->rowBuf[cx];
  66:src/render/decoders/gif.c ****     }
  67:src/render/decoders/gif.c ****     if (g->interlaced) {
  68:src/render/decoders/gif.c ****         int lin = g->rowIdx < g->nInterRows
  69:src/render/decoders/gif.c ****                       ? g->interlaceRows[g->rowIdx]
  70:src/render/decoders/gif.c ****                       : -1;
  71:src/render/decoders/gif.c ****         if (lin >= 0 && lin < g->imgH) {
  72:src/render/decoders/gif.c ****             /* rows may replay more than once only if passes overlap;
  73:src/render/decoders/gif.c ****              * they do not in the standard scheme, so allocate lazily */
  74:src/render/decoders/gif.c ****             if (g->interBuf[lin] == NULL)
  75:src/render/decoders/gif.c ****                 g->interBuf[lin] =
  76:src/render/decoders/gif.c ****                     (uint8_t*)pluto_malloc((size_t)g->screenW);
  77:src/render/decoders/gif.c ****             if (g->interBuf[lin] != NULL)
  78:src/render/decoders/gif.c ****                 memcpy(g->interBuf[lin], g->canvasRow,
  79:src/render/decoders/gif.c ****                        (size_t)g->screenW);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cck7zbDo.s 			page 4


  80:src/render/decoders/gif.c ****         }
  81:src/render/decoders/gif.c ****     } else {
  82:src/render/decoders/gif.c ****         scale_accum_add_row(g->acc, g->canvasRow);
  83:src/render/decoders/gif.c ****     }
  84:src/render/decoders/gif.c ****     g->rowIdx++;
  85:src/render/decoders/gif.c ****     g->x = 0;
  86:src/render/decoders/gif.c ****     g->pixelCounter++;
  87:src/render/decoders/gif.c ****     if (g->pixelCounter % 8 == 0) tasks_yield_check();
  88:src/render/decoders/gif.c **** }
