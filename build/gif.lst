  25:src/render/decoders/gif.c **** static unsigned gif_u16le(const uint8_t* d, size_t len, size_t o) {
  26:src/render/decoders/gif.c ****     if (o >= len || o + 1 >= len) return 0;
  27:src/render/decoders/gif.c ****     return (unsigned)d[o] | ((unsigned)d[o + 1] << 8);
  28:src/render/decoders/gif.c **** }
  29:src/render/decoders/gif.c **** 
  30:src/render/decoders/gif.c **** /* byte accessor: -1 == Lua nil */
  31:src/render/decoders/gif.c **** static int gif_byte(const uint8_t* d, size_t len, size_t o) {
  32:src/render/decoders/gif.c ****     return o < len ? d[o] : -1;
  33:src/render/decoders/gif.c **** }
