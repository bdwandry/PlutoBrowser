 116:src/render/decoders/selftest_gif.c **** static void case_benchmark(void) {
 117:src/render/decoders/selftest_gif.c ****     double ms = -1.0;
 118:src/render/decoders/selftest_gif.c **** #if defined(TARGET_PLAYDATE)
 119:src/render/decoders/selftest_gif.c ****     struct PlaydateAPI* pd = s_pd;   /* installed via selftest_gif_set_pd */
 120:src/render/decoders/selftest_gif.c ****     if (pd != NULL) {
 121:src/render/decoders/selftest_gif.c ****         float t0 = pd->system->getElapsedTime();
 122:src/render/decoders/selftest_gif.c ****         uint8_t** rows = NULL;
 123:src/render/decoders/selftest_gif.c ****         int w, hgt;
 124:src/render/decoders/selftest_gif.c ****         gif_decode_gray(fx_g_bench, FX_G_BENCH_LEN, 360, 200,
 125:src/render/decoders/selftest_gif.c ****                         &rows, &w, &hgt);
 126:src/render/decoders/selftest_gif.c ****         gif_free_rows(rows, hgt);
 127:src/render/decoders/selftest_gif.c ****         ms = (double)(pd->system->getElapsedTime() - t0) * 1000.0;
 128:src/render/decoders/selftest_gif.c ****     }
 129:src/render/decoders/selftest_gif.c **** #else
 130:src/render/decoders/selftest_gif.c ****     struct timespec t0, t1;
 131:src/render/decoders/selftest_gif.c ****     clock_gettime(CLOCK_MONOTONIC, &t0);
 132:src/render/decoders/selftest_gif.c ****     uint8_t** rows = NULL;
 133:src/render/decoders/selftest_gif.c ****     int w, hgt;
 134:src/render/decoders/selftest_gif.c ****     gif_decode_gray(fx_g_bench, FX_G_BENCH_LEN, 360, 200,
 135:src/render/decoders/selftest_gif.c ****                     &rows, &w, &hgt);
 136:src/render/decoders/selftest_gif.c ****     clock_gettime(CLOCK_MONOTONIC, &t1);
 137:src/render/decoders/selftest_gif.c ****     ms = (t1.tv_sec - t0.tv_sec) * 1000.0 +
 138:src/render/decoders/selftest_gif.c ****          (t1.tv_nsec - t0.tv_nsec) / 1e6;
 139:src/render/decoders/selftest_gif.c ****     gif_free_rows(rows, hgt);
 140:src/render/decoders/selftest_gif.c **** #endif
 141:src/render/decoders/selftest_gif.c ****     PLUTO_LOG("[P19] bench 600x400 -> %dx%d in %.1f ms", 300, 200, ms);
 142:src/render/decoders/selftest_gif.c ****     ck("B.bench_ran", ms >= 0.0);
 143:src/render/decoders/selftest_gif.c **** }
