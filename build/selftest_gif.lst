  55:src/render/decoders/selftest_gif.c **** static void case_decode_all(void) {
  56:src/render/decoders/selftest_gif.c ****     for (size_t i = 0; i < NFIX; i++) {
  57:src/render/decoders/selftest_gif.c ****         const Fixture* f = &kFixtures[i];
  58:src/render/decoders/selftest_gif.c ****         uint8_t** rows = NULL;
  59:src/render/decoders/selftest_gif.c ****         int w = 0, hgt = 0;
  60:src/render/decoders/selftest_gif.c ****         int maxW = 360, maxH = 200;
  61:src/render/decoders/selftest_gif.c ****         if (i == NFIX - 1) { maxW = 360; maxH = 200; }
  62:src/render/decoders/selftest_gif.c ****         if (gif_decode_gray(f->data, f->len, maxW, maxH,
  63:src/render/decoders/selftest_gif.c ****                             &rows, &w, &hgt) != 0 || rows == NULL) {
  64:src/render/decoders/selftest_gif.c ****             char nm[64];
  65:src/render/decoders/selftest_gif.c ****             snprintf(nm, sizeof(nm), "D.%s_decode", f->name);
  66:src/render/decoders/selftest_gif.c ****             ck(nm, 0);
  67:src/render/decoders/selftest_gif.c ****             continue;
  68:src/render/decoders/selftest_gif.c ****         }
  69:src/render/decoders/selftest_gif.c ****         int dimsOk = (w == f->tw && hgt == f->th);
  70:src/render/decoders/selftest_gif.c ****         int probesOk = 1;
  71:src/render/decoders/selftest_gif.c ****         for (int pi = 0; pi < GIF_PROBES_LEN && probesOk; pi++) {
  72:src/render/decoders/selftest_gif.c ****             const GifProbe* pr = &gif_probes[pi];
  73:src/render/decoders/selftest_gif.c ****             if (pr->img != (int)i) continue;
  74:src/render/decoders/selftest_gif.c ****             for (int k = 0; k < pr->nProbes; k++) {
  75:src/render/decoders/selftest_gif.c ****                 int x = pr->p[k].x, y = pr->p[k].y;
  76:src/render/decoders/selftest_gif.c ****                 if (x >= w || y >= hgt ||
  77:src/render/decoders/selftest_gif.c ****                     rows[y][x] != (uint8_t)pr->p[k].g) {
  78:src/render/decoders/selftest_gif.c ****                     PLUTO_ERROR("[P19] probe %s(%d,%d): got %d want %d",
  79:src/render/decoders/selftest_gif.c ****                                 f->name, x, y,
  80:src/render/decoders/selftest_gif.c ****                                 x < w && y < hgt ? rows[y][x] : -1,
  81:src/render/decoders/selftest_gif.c ****                                 pr->p[k].g);
  82:src/render/decoders/selftest_gif.c ****                     probesOk = 0;
  83:src/render/decoders/selftest_gif.c ****                     break;
  84:src/render/decoders/selftest_gif.c ****                 }
  85:src/render/decoders/selftest_gif.c ****             }
  86:src/render/decoders/selftest_gif.c ****         }
  87:src/render/decoders/selftest_gif.c ****         char nm[64];
  88:src/render/decoders/selftest_gif.c ****         snprintf(nm, sizeof(nm), "D.%s_%dx%d%s", f->name, w, hgt,
  89:src/render/decoders/selftest_gif.c ****                  dimsOk ? "" : "_BAD_DIMS");
  90:src/render/decoders/selftest_gif.c ****         ck(nm, dimsOk && probesOk);
  91:src/render/decoders/selftest_gif.c ****         gif_free_rows(rows, hgt);
