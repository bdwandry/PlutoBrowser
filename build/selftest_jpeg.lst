 151:src/render/decoders/selftest_jpeg.c ****                      360, 200, &rows, &w, &hgt);
 152:src/render/decoders/selftest_jpeg.c ****     clock_gettime(CLOCK_MONOTONIC, &t1);
 153:src/render/decoders/selftest_jpeg.c ****     ms = (t1.tv_sec - t0.tv_sec) * 1000.0 +
 154:src/render/decoders/selftest_jpeg.c ****          (t1.tv_nsec - t0.tv_nsec) / 1e6;
 155:src/render/decoders/selftest_jpeg.c ****     jpeg_free_rows(rows, hgt);
 156:src/render/decoders/selftest_jpeg.c **** #endif
 157:src/render/decoders/selftest_jpeg.c ****     PLUTO_LOG("[P20] bench 800x600 -> %dx%d in %.1f ms", w, hgt, ms);
 158:src/render/decoders/selftest_jpeg.c ****     ck("B.bench_ran", ms >= 0.0);
