  90:src/render/decoders/selftest_jpeg.c ****                                 x < w && y < hgt ? rows[y][x] : -1,
  91:src/render/decoders/selftest_jpeg.c ****                                 pr->p[k].g);
  92:src/render/decoders/selftest_jpeg.c ****                     probesOk = 0;
