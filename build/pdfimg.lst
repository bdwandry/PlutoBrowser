 669:Source/render/decoders/pdfimg.c **** static uint8_t pdfv_fill_val(const PdfGs *gs)
 670:Source/render/decoders/pdfimg.c **** {
 671:Source/render/decoders/pdfimg.c ****     int r = (int)(gs->fr * 255.0f + 0.5f);
 672:Source/render/decoders/pdfimg.c ****     int g = (int)(gs->fg * 255.0f + 0.5f);
 673:Source/render/decoders/pdfimg.c ****     int b = (int)(gs->fb * 255.0f + 0.5f);
 674:Source/render/decoders/pdfimg.c ****     if (r < 0) r = 0;
 675:Source/render/decoders/pdfimg.c ****     if (r > 255) r = 255;
 676:Source/render/decoders/pdfimg.c ****     if (g < 0) g = 0;
 677:Source/render/decoders/pdfimg.c ****     if (g > 255) g = 255;
 678:Source/render/decoders/pdfimg.c ****     if (b < 0) b = 0;
 679:Source/render/decoders/pdfimg.c ****     if (b > 255) b = 255;
 680:Source/render/decoders/pdfimg.c ****     return (uint8_t)dither_rgb_to_gray(r, g, b);
 681:Source/render/decoders/pdfimg.c **** }
 682:Source/render/decoders/pdfimg.c **** 
 683:Source/render/decoders/pdfimg.c **** static uint8_t pdfv_stroke_val(const PdfGs *gs)
 684:Source/render/decoders/pdfimg.c **** {
 685:Source/render/decoders/pdfimg.c ****     PdfGs tmp = *gs;
 686:Source/render/decoders/pdfimg.c ****     tmp.fr = gs->sr;
 687:Source/render/decoders/pdfimg.c ****     tmp.fg = gs->sg;
 688:Source/render/decoders/pdfimg.c ****     tmp.fb = gs->sb;
 689:Source/render/decoders/pdfimg.c ****     return pdfv_fill_val(&tmp);
 690:Source/render/decoders/pdfimg.c **** }
