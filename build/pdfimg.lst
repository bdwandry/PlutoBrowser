 397:Source/render/decoders/pdfimg.c **** static void pdfv_seg_wrap(uint8_t *gray, int W, int H, const PdfSub *s,
 398:Source/render/decoders/pdfimg.c ****                           float wEff, uint8_t val)
 399:Source/render/decoders/pdfimg.c **** {
 400:Source/render/decoders/pdfimg.c ****     /* closing segment of a closed subpath */
 401:Source/render/decoders/pdfimg.c ****     int ax = (int)(s->px[s->n - 1] + 0.5f), ay = (int)(s->py[s->n - 1] + 0.5f);
 402:Source/render/decoders/pdfimg.c ****     int bx = (int)(s->px[0] + 0.5f), by = (int)(s->py[0] + 0.5f);
 403:Source/render/decoders/pdfimg.c ****     if (wEff >= 1.6f)
 404:Source/render/decoders/pdfimg.c ****     {
 405:Source/render/decoders/pdfimg.c ****         /* thickness handled by pdfv_seg-style stamping */
 406:Source/render/decoders/pdfimg.c ****         PdfSub one;
 407:Source/render/decoders/pdfimg.c ****         one.n = 2;
 408:Source/render/decoders/pdfimg.c ****         one.closed = 0;
 409:Source/render/decoders/pdfimg.c ****         one.px[0] = s->px[s->n - 1];
 410:Source/render/decoders/pdfimg.c ****         one.py[0] = s->py[s->n - 1];
 411:Source/render/decoders/pdfimg.c ****         one.px[1] = s->px[0];
 412:Source/render/decoders/pdfimg.c ****         one.py[1] = s->py[0];
 413:Source/render/decoders/pdfimg.c ****         pdfv_seg(gray, W, H, &one, 0, wEff, val);
 414:Source/render/decoders/pdfimg.c ****         return;
 415:Source/render/decoders/pdfimg.c ****     }
 416:Source/render/decoders/pdfimg.c ****     pdfv_line(gray, W, H, ax, ay, bx, by, val);
 417:Source/render/decoders/pdfimg.c **** }
