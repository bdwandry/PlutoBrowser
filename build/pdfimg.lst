 430:Source/render/decoders/pdfimg.c **** static int pdfv_key_pos(const char *seg, size_t segLen, const char *key,
 431:Source/render/decoders/pdfimg.c ****                         size_t *valPos)
 432:Source/render/decoders/pdfimg.c **** {
 433:Source/render/decoders/pdfimg.c ****     size_t kl = strlen(key);
 434:Source/render/decoders/pdfimg.c ****     for (size_t i = 0; i + kl < segLen; i++)
 435:Source/render/decoders/pdfimg.c ****     {
 436:Source/render/decoders/pdfimg.c ****         if (seg[i] == '/' && strncmp(seg + i + 1, key, kl) == 0)
 437:Source/render/decoders/pdfimg.c ****         {
 438:Source/render/decoders/pdfimg.c ****             size_t j = i + 1 + kl;
 439:Source/render/decoders/pdfimg.c ****             while (j < segLen && (seg[j] == ' ' || seg[j] == '\n' ||
 440:Source/render/decoders/pdfimg.c ****                                   seg[j] == '\r' || seg[j] == '\t'))
 441:Source/render/decoders/pdfimg.c ****                 j++;
 442:Source/render/decoders/pdfimg.c ****             *valPos = j;
 443:Source/render/decoders/pdfimg.c ****             return 1;
 444:Source/render/decoders/pdfimg.c ****         }
 445:Source/render/decoders/pdfimg.c ****     }
 446:Source/render/decoders/pdfimg.c ****     return 0;
 447:Source/render/decoders/pdfimg.c **** }
