 661:Source/render/decoders/pdfimg.c ****         return;
 662:Source/render/decoders/pdfimg.c ****     }
 663:Source/render/decoders/pdfimg.c ****     *x0 = (int)xmin;
 664:Source/render/decoders/pdfimg.c ****     *y0 = (int)ymin;
