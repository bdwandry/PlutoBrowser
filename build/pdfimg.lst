 369:Source/render/decoders/pdfimg.c **** static void pdfv_seg(uint8_t *gray, int W, int H, const PdfSub *s, int j,
 370:Source/render/decoders/pdfimg.c ****                      float wEff, uint8_t val)
 371:Source/render/decoders/pdfimg.c **** {
 372:Source/render/decoders/pdfimg.c ****     int ax = (int)(s->px[j] + 0.5f), ay = (int)(s->py[j] + 0.5f);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc10iemP.s 			page 11


 373:Source/render/decoders/pdfimg.c ****     int bx = (int)(s->px[j + 1] + 0.5f), by = (int)(s->py[j + 1] + 0.5f);
