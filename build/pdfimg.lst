 341:Source/render/decoders/pdfimg.c ****                           float wEff, uint8_t val);
 342:Source/render/decoders/pdfimg.c **** 
 343:Source/render/decoders/pdfimg.c **** /* Stroke all subpaths. Thin lines (< ~1.6px effective) get a plain
 344:Source/render/decoders/pdfimg.c ****  * Bresenham pass; thicker widths stamp small squares along each segment. */
 345:Source/render/decoders/pdfimg.c **** static void pdfv_stroke(uint8_t *gray, int W, int H, const PdfSub *subs,
 346:Source/render/decoders/pdfimg.c ****                         int nSubs, uint8_t val, const PdfGs *gs)
 347:Source/render/decoders/pdfimg.c **** {
 348:Source/render/decoders/pdfimg.c ****     float wEff = pdfv_stroke_width(gs);
 349:Source/render/decoders/pdfimg.c **** 
 350:Source/render/decoders/pdfimg.c ****     for (int i = 0; i < nSubs; i++)
 351:Source/render/decoders/pdfimg.c ****     {
 352:Source/render/decoders/pdfimg.c ****         const PdfSub *s = &subs[i];
 353:Source/render/decoders/pdfimg.c ****         if (s->n == 0) continue;
 354:Source/render/decoders/pdfimg.c ****         for (int j = 0; j + 1 < s->n; j++)
 355:Source/render/decoders/pdfimg.c ****             pdfv_seg(gray, W, H, s, j, wEff, val);
 356:Source/render/decoders/pdfimg.c ****         if (s->closed && s->n > 2)
 357:Source/render/decoders/pdfimg.c ****             pdfv_seg_wrap(gray, W, H, s, wEff, val);
 358:Source/render/decoders/pdfimg.c ****     }
 359:Source/render/decoders/pdfimg.c **** }
 360:Source/render/decoders/pdfimg.c **** 
 361:Source/render/decoders/pdfimg.c **** static float pdfv_stroke_width(const PdfGs *gs)
 362:Source/render/decoders/pdfimg.c **** {
 363:Source/render/decoders/pdfimg.c ****     float det = gs->ctm.a * gs->ctm.d - gs->ctm.b * gs->ctm.c;
 364:Source/render/decoders/pdfimg.c ****     float scale = det < 0 ? -det : det;
 365:Source/render/decoders/pdfimg.c ****     if (scale < 0.0001f) scale = 1.0f;
 366:Source/render/decoders/pdfimg.c ****     return gs->lw * pdfv_sqrt(scale);
 367:Source/render/decoders/pdfimg.c **** }
