 449:Source/render/decoders/pdfimg.c **** static int pdfv_int_key(const char *seg, size_t segLen, const char *key,
 450:Source/render/decoders/pdfimg.c ****                         int *out)
 451:Source/render/decoders/pdfimg.c **** {
 452:Source/render/decoders/pdfimg.c ****     size_t p;
 453:Source/render/decoders/pdfimg.c ****     if (!pdfv_key_pos(seg, segLen, key, &p)) return 0;
 454:Source/render/decoders/pdfimg.c ****     char *end = NULL;
 455:Source/render/decoders/pdfimg.c ****     long v = strtol(seg + p, &end, 10);
 456:Source/render/decoders/pdfimg.c ****     if (end == seg + p) return 0;
 457:Source/render/decoders/pdfimg.c ****     *out = (int)v;
 458:Source/render/decoders/pdfimg.c ****     return 1;
 459:Source/render/decoders/pdfimg.c **** }
 460:Source/render/decoders/pdfimg.c **** 
 461:Source/render/decoders/pdfimg.c **** static int pdfv_floats_key(const char *seg, size_t segLen, const char *key,
 462:Source/render/decoders/pdfimg.c ****                            float *out, int maxN)
 463:Source/render/decoders/pdfimg.c **** {
 464:Source/render/decoders/pdfimg.c ****     size_t p;
 465:Source/render/decoders/pdfimg.c ****     if (!pdfv_key_pos(seg, segLen, key, &p)) return 0;
 466:Source/render/decoders/pdfimg.c ****     /* skip to '[' if present */
 467:Source/render/decoders/pdfimg.c ****     while (p < segLen && (seg[p] == ' ' || seg[p] == '\n' || seg[p] == '\r'))
 468:Source/render/decoders/pdfimg.c ****         p++;
 469:Source/render/decoders/pdfimg.c ****     if (p < segLen && seg[p] == '[') p++;
 470:Source/render/decoders/pdfimg.c ****     int n = 0;
 471:Source/render/decoders/pdfimg.c ****     while (n < maxN && p < segLen)
 472:Source/render/decoders/pdfimg.c ****     {
 473:Source/render/decoders/pdfimg.c ****         char *end = NULL;
 474:Source/render/decoders/pdfimg.c ****         double v = strtod(seg + p, &end);
 475:Source/render/decoders/pdfimg.c ****         if (end == seg + p) break;
 476:Source/render/decoders/pdfimg.c ****         out[n++] = (float)v;
 477:Source/render/decoders/pdfimg.c ****         p = (size_t)(end - seg);
 478:Source/render/decoders/pdfimg.c ****     }
 479:Source/render/decoders/pdfimg.c ****     return n;
 480:Source/render/decoders/pdfimg.c **** }
