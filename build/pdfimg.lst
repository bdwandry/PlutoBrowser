 646:Source/render/decoders/pdfimg.c **** static void pdfv_path_bbox(const PdfSub *subs, int nSubs, int *x0, int *y0,
 647:Source/render/decoders/pdfimg.c ****                            int *x1, int *y1)
 648:Source/render/decoders/pdfimg.c **** {
 649:Source/render/decoders/pdfimg.c ****     float xmin = 1e30f, ymin = 1e30f, xmax = -1e30f, ymax = -1e30f;
 650:Source/render/decoders/pdfimg.c ****     for (int i = 0; i < nSubs; i++)
 651:Source/render/decoders/pdfimg.c ****         for (int j = 0; j < subs[i].n; j++)
 652:Source/render/decoders/pdfimg.c ****         {
 653:Source/render/decoders/pdfimg.c ****             if (subs[i].px[j] < xmin) xmin = subs[i].px[j];
 654:Source/render/decoders/pdfimg.c ****             if (subs[i].px[j] > xmax) xmax = subs[i].px[j];
 655:Source/render/decoders/pdfimg.c ****             if (subs[i].py[j] < ymin) ymin = subs[i].py[j];
 656:Source/render/decoders/pdfimg.c ****             if (subs[i].py[j] > ymax) ymax = subs[i].py[j];
 657:Source/render/decoders/pdfimg.c ****         }
 658:Source/render/decoders/pdfimg.c ****     if (xmin > xmax)
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc10iemP.s 			page 20


 659:Source/render/decoders/pdfimg.c ****     {
