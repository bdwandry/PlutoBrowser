 311:Source/render/decoders/pdfimg.c **** static void pdfv_line(uint8_t *gray, int W, int H, int x0, int y0, int x1,
 312:Source/render/decoders/pdfimg.c ****                       int y1, uint8_t val)
 313:Source/render/decoders/pdfimg.c **** {
 314:Source/render/decoders/pdfimg.c ****     int dx = x1 - x0, dy = y1 - y0;
 315:Source/render/decoders/pdfimg.c ****     int sx = dx < 0 ? -1 : 1, sy = dy < 0 ? -1 : 1;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc10iemP.s 			page 10


 316:Source/render/decoders/pdfimg.c ****     dx = dx < 0 ? -dx : dx;
 317:Source/render/decoders/pdfimg.c ****     dy = dy < 0 ? -dy : dy;
 318:Source/render/decoders/pdfimg.c ****     int err = dx - dy;
 319:Source/render/decoders/pdfimg.c ****     for (;;)
 320:Source/render/decoders/pdfimg.c ****     {
 321:Source/render/decoders/pdfimg.c ****         pdfv_dot(gray, W, H, x0, y0, val);
 322:Source/render/decoders/pdfimg.c ****         if (x0 == x1 && y0 == y1) break;
 323:Source/render/decoders/pdfimg.c ****         int e2 = err * 2;
 324:Source/render/decoders/pdfimg.c ****         if (e2 > -dy)
 325:Source/render/decoders/pdfimg.c ****         {
 326:Source/render/decoders/pdfimg.c ****             err -= dy;
 327:Source/render/decoders/pdfimg.c ****             x0 += sx;
 328:Source/render/decoders/pdfimg.c ****         }
 329:Source/render/decoders/pdfimg.c ****         if (e2 < dx)
 330:Source/render/decoders/pdfimg.c ****         {
 331:Source/render/decoders/pdfimg.c ****             err += dx;
 332:Source/render/decoders/pdfimg.c ****             y0 += sy;
 333:Source/render/decoders/pdfimg.c ****         }
 334:Source/render/decoders/pdfimg.c ****     }
 335:Source/render/decoders/pdfimg.c **** }
