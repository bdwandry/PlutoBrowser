 106:Source/render/decoders/pdfimg.c **** /* ── Mini vector content-stream renderer ─────────────────�
 107:Source/render/decoders/pdfimg.c ****  * Rasterizes a page-1 content stream (q/Q/cm/rg/RG/g/G/w/re/m/l/c/h/S/s,
 108:Source/render/decoders/pdfimg.c ****  * fill/stroke paint, clip and shading ops) into a gray raster, then
 109:Source/render/decoders/pdfimg.c ****  * Bayer-dithers exactly like every other decoder. Covers the vector PDFs
 110:Source/render/decoders/pdfimg.c ****  * in the wild (e.g. the benchmark corpus's test_pattern.pdf: rects,
 111:Source/render/decoders/pdfimg.c ****  * polygons, grid lines, and axial shadings). No external deps; fixed-size
 112:Source/render/decoders/pdfimg.c ****  * path/edge buffers. */
 113:Source/render/decoders/pdfimg.c **** 
 114:Source/render/decoders/pdfimg.c **** typedef struct { float a, b, c, d, e, f; } PdfM;
 115:Source/render/decoders/pdfimg.c **** 
 116:Source/render/decoders/pdfimg.c **** /* Page space → device: flip Y, fit MediaBox into W×H. */
 117:Source/render/decoders/pdfimg.c **** static PdfM pdfv_page_matrix(float mx0, float my0, float mx1, float my1,
 118:Source/render/decoders/pdfimg.c ****                              int W, int H)
 119:Source/render/decoders/pdfimg.c **** {
 120:Source/render/decoders/pdfimg.c ****     PdfM m;
 121:Source/render/decoders/pdfimg.c ****     float sx = (float)W / (mx1 - mx0);
 122:Source/render/decoders/pdfimg.c ****     float sy = (float)H / (my1 - my0);
 123:Source/render/decoders/pdfimg.c ****     m.a = sx;
 124:Source/render/decoders/pdfimg.c ****     m.b = 0;
 125:Source/render/decoders/pdfimg.c ****     m.c = 0;
 126:Source/render/decoders/pdfimg.c ****     m.d = -sy;
 127:Source/render/decoders/pdfimg.c ****     m.e = -mx0 * sx;
 128:Source/render/decoders/pdfimg.c ****     m.f = my1 * sy;
 129:Source/render/decoders/pdfimg.c ****     return m;
 130:Source/render/decoders/pdfimg.c **** }
 131:Source/render/decoders/pdfimg.c **** 
 132:Source/render/decoders/pdfimg.c **** /* Row-vector composition (PDF semantics): p × (m × g) = (p × m) × g. */
 133:Source/render/decoders/pdfimg.c **** static PdfM pdfv_mul(PdfM m, PdfM g)
 134:Source/render/decoders/pdfimg.c **** {
 135:Source/render/decoders/pdfimg.c ****     PdfM r;
 136:Source/render/decoders/pdfimg.c ****     r.a = m.a * g.a + m.b * g.c;
 137:Source/render/decoders/pdfimg.c ****     r.b = m.a * g.b + m.b * g.d;
 138:Source/render/decoders/pdfimg.c ****     r.c = m.c * g.a + m.d * g.c;
 139:Source/render/decoders/pdfimg.c ****     r.d = m.c * g.b + m.d * g.d;
 140:Source/render/decoders/pdfimg.c ****     r.e = m.e * g.a + m.f * g.c + g.e;
 141:Source/render/decoders/pdfimg.c ****     r.f = m.e * g.b + m.f * g.d + g.f;
 142:Source/render/decoders/pdfimg.c ****     return r;
 143:Source/render/decoders/pdfimg.c **** }
 144:Source/render/decoders/pdfimg.c **** 
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc10iemP.s 			page 7


 145:Source/render/decoders/pdfimg.c **** static void pdfv_apply(PdfM m, float x, float y, float *ox, float *oy)
 146:Source/render/decoders/pdfimg.c **** {
 147:Source/render/decoders/pdfimg.c ****     *ox = m.a * x + m.c * y + m.e;
 148:Source/render/decoders/pdfimg.c ****     *oy = m.b * x + m.d * y + m.f;
 149:Source/render/decoders/pdfimg.c **** }
