 419:Source/render/decoders/pdfimg.c **** static float pdfv_sqrt(float v)
 420:Source/render/decoders/pdfimg.c **** {
 421:Source/render/decoders/pdfimg.c ****     if (v <= 0.0f) return 0.0f;
 422:Source/render/decoders/pdfimg.c ****     float x = v;
 423:Source/render/decoders/pdfimg.c ****     for (int i = 0; i < 12; i++)
 424:Source/render/decoders/pdfimg.c ****         x = 0.5f * (x + v / x);
 425:Source/render/decoders/pdfimg.c ****     return x;
 426:Source/render/decoders/pdfimg.c **** }
