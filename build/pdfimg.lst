 376:Source/render/decoders/pdfimg.c ****     {
 377:Source/render/decoders/pdfimg.c ****         pdfv_line(gray, W, H, ax, ay, bx, by, val);
 378:Source/render/decoders/pdfimg.c ****         return;
 379:Source/render/decoders/pdfimg.c ****     }
 380:Source/render/decoders/pdfimg.c ****     float dx = s->px[j + 1] - s->px[j], dy = s->py[j + 1] - s->py[j];
 381:Source/render/decoders/pdfimg.c ****     float len = pdfv_sqrt(dx * dx + dy * dy);
 382:Source/render/decoders/pdfimg.c ****     int steps = (int)(len * 2.0f) + 1;
 383:Source/render/decoders/pdfimg.c ****     if (steps < 1) steps = 1;
 384:Source/render/decoders/pdfimg.c ****     int r = (int)(wEff * 0.5f + 0.5f);
 385:Source/render/decoders/pdfimg.c ****     if (r < 1) r = 1;
 386:Source/render/decoders/pdfimg.c ****     for (int k = 0; k <= steps; k++)
 387:Source/render/decoders/pdfimg.c ****     {
 388:Source/render/decoders/pdfimg.c ****         float t = (float)k / (float)steps;
 389:Source/render/decoders/pdfimg.c ****         float fx = s->px[j] + t * dx, fy = s->py[j] + t * dy;
 390:Source/render/decoders/pdfimg.c ****         int cx = (int)(fx + 0.5f), cy = (int)(fy + 0.5f);
 391:Source/render/decoders/pdfimg.c ****         for (int oy = -r; oy <= r; oy++)
 392:Source/render/decoders/pdfimg.c ****             for (int ox = -r; ox <= r; ox++)
 393:Source/render/decoders/pdfimg.c ****                 pdfv_dot(gray, W, H, cx + ox, cy + oy, val);
 394:Source/render/decoders/pdfimg.c ****     }
 395:Source/render/decoders/pdfimg.c **** }
