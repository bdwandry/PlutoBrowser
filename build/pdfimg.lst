 202:Source/render/decoders/pdfimg.c ****         if (y0 < 0) y0 = 0;
 203:Source/render/decoders/pdfimg.c ****         if (x1 > W) x1 = W;
 204:Source/render/decoders/pdfimg.c ****         if (y1 > H) y1 = H;
 205:Source/render/decoders/pdfimg.c ****     }
 206:Source/render/decoders/pdfimg.c ****     for (i = 0; i < nSubs; i++) cap += subs[i].n;
 207:Source/render/decoders/pdfimg.c ****     if (cap < 3) return;
 208:Source/render/decoders/pdfimg.c ****     edges = (PdfEdge *)malloc(sizeof(PdfEdge) * (size_t)cap);
 209:Source/render/decoders/pdfimg.c ****     if (!edges) return;
 210:Source/render/decoders/pdfimg.c ****     int nE = 0;
 211:Source/render/decoders/pdfimg.c ****     for (i = 0; i < nSubs; i++)
 212:Source/render/decoders/pdfimg.c ****     {
 213:Source/render/decoders/pdfimg.c ****         const PdfSub *s = &subs[i];
 214:Source/render/decoders/pdfimg.c ****         for (int j = 0; j < s->n; j++)
 215:Source/render/decoders/pdfimg.c ****         {
 216:Source/render/decoders/pdfimg.c ****             int k = (j + 1 < s->n) ? j + 1 : 0; /* fill: implicit close */
 217:Source/render/decoders/pdfimg.c ****             float ax = s->px[j], ay = s->py[j];
 218:Source/render/decoders/pdfimg.c ****             float bx = s->px[k], by = s->py[k];
 219:Source/render/decoders/pdfimg.c ****             if (ay == by) continue;
 220:Source/render/decoders/pdfimg.c ****             edges[nE].x1 = ax;
 221:Source/render/decoders/pdfimg.c ****             edges[nE].y1 = ay;
 222:Source/render/decoders/pdfimg.c ****             edges[nE].x2 = bx;
 223:Source/render/decoders/pdfimg.c ****             edges[nE].y2 = by;
 224:Source/render/decoders/pdfimg.c ****             nE++;
 225:Source/render/decoders/pdfimg.c ****             if (ay < ymin) ymin = ay;
 226:Source/render/decoders/pdfimg.c ****             if (ay > ymax) ymax = ay;
 227:Source/render/decoders/pdfimg.c ****             if (by < ymin) ymin = by;
 228:Source/render/decoders/pdfimg.c ****             if (by > ymax) ymax = by;
 229:Source/render/decoders/pdfimg.c ****         }
 230:Source/render/decoders/pdfimg.c ****     }
 231:Source/render/decoders/pdfimg.c ****     if (nE == 0)
 232:Source/render/decoders/pdfimg.c ****     {
 233:Source/render/decoders/pdfimg.c ****         free(edges);
 234:Source/render/decoders/pdfimg.c ****         return;
 235:Source/render/decoders/pdfimg.c ****     }
 236:Source/render/decoders/pdfimg.c ****     int sy = (int)ymin;
 237:Source/render/decoders/pdfimg.c ****     if (sy < y0) sy = y0;
 238:Source/render/decoders/pdfimg.c ****     int ey = (int)ymax + 1;
 239:Source/render/decoders/pdfimg.c ****     if (ey > y1) ey = y1;
 240:Source/render/decoders/pdfimg.c **** 
 241:Source/render/decoders/pdfimg.c ****     float *xs = (float *)malloc(sizeof(float) * (size_t)nE);
 242:Source/render/decoders/pdfimg.c ****     int *ds = (int *)malloc(sizeof(int) * (size_t)nE);
 243:Source/render/decoders/pdfimg.c ****     if (xs && ds)
 244:Source/render/decoders/pdfimg.c ****     {
 245:Source/render/decoders/pdfimg.c ****         for (int y = sy; y < ey; y++)
 246:Source/render/decoders/pdfimg.c ****         {
 247:Source/render/decoders/pdfimg.c ****             float yc = (float)y + 0.5f;
 248:Source/render/decoders/pdfimg.c ****             int nX = 0;
 249:Source/render/decoders/pdfimg.c ****             for (int e = 0; e < nE; e++)
 250:Source/render/decoders/pdfimg.c ****             {
 251:Source/render/decoders/pdfimg.c ****                 float ay = edges[e].y1, by = edges[e].y2;
 252:Source/render/decoders/pdfimg.c ****                 if ((ay <= yc && by > yc) || (by <= yc && ay > yc))
 253:Source/render/decoders/pdfimg.c ****                 {
 254:Source/render/decoders/pdfimg.c ****                     float t = (yc - ay) / (by - ay);
 255:Source/render/decoders/pdfimg.c ****                     xs[nX] = edges[e].x1 + t * (edges[e].x2 - edges[e].x1);
 256:Source/render/decoders/pdfimg.c ****                     ds[nX] = (by > ay) ? 1 : -1;
 257:Source/render/decoders/pdfimg.c ****                     nX++;
 258:Source/render/decoders/pdfimg.c ****                 }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc10iemP.s 			page 9


 259:Source/render/decoders/pdfimg.c ****             }
 260:Source/render/decoders/pdfimg.c ****             /* insertion sort by x */
 261:Source/render/decoders/pdfimg.c ****             for (int a = 1; a < nX; a++)
 262:Source/render/decoders/pdfimg.c ****             {
 263:Source/render/decoders/pdfimg.c ****                 float fx = xs[a];
 264:Source/render/decoders/pdfimg.c ****                 int fd = ds[a];
 265:Source/render/decoders/pdfimg.c ****                 int b = a - 1;
 266:Source/render/decoders/pdfimg.c ****                 while (b >= 0 && xs[b] > fx)
 267:Source/render/decoders/pdfimg.c ****                 {
 268:Source/render/decoders/pdfimg.c ****                     xs[b + 1] = xs[b];
 269:Source/render/decoders/pdfimg.c ****                     ds[b + 1] = ds[b];
 270:Source/render/decoders/pdfimg.c ****                     b--;
 271:Source/render/decoders/pdfimg.c ****                 }
 272:Source/render/decoders/pdfimg.c ****                 xs[b + 1] = fx;
 273:Source/render/decoders/pdfimg.c ****                 ds[b + 1] = fd;
 274:Source/render/decoders/pdfimg.c ****             }
 275:Source/render/decoders/pdfimg.c ****             uint8_t *row = gray + (size_t)y * (size_t)W;
 276:Source/render/decoders/pdfimg.c ****             int wind = 0;
 277:Source/render/decoders/pdfimg.c ****             int spanStart = 0;
 278:Source/render/decoders/pdfimg.c ****             for (int a = 0; a < nX; a++)
 279:Source/render/decoders/pdfimg.c ****             {
 280:Source/render/decoders/pdfimg.c ****                 int before = wind;
 281:Source/render/decoders/pdfimg.c ****                 wind += ds[a];
 282:Source/render/decoders/pdfimg.c ****                 if (before == 0 && wind != 0)
 283:Source/render/decoders/pdfimg.c ****                     spanStart = a;
 284:Source/render/decoders/pdfimg.c ****                 else if (before != 0 && wind == 0)
 285:Source/render/decoders/pdfimg.c ****                 {
 286:Source/render/decoders/pdfimg.c ****                     float fa = xs[spanStart], fb2 = xs[a];
 287:Source/render/decoders/pdfimg.c ****                     int px0 = (int)(fa - 0.5f);
 288:Source/render/decoders/pdfimg.c ****                     if ((float)px0 < fa - 0.5f) px0++;
 289:Source/render/decoders/pdfimg.c ****                     if (px0 < x0) px0 = x0;
 290:Source/render/decoders/pdfimg.c ****                     int px1 = (int)(fb2 - 0.5f);
 291:Source/render/decoders/pdfimg.c ****                     if ((float)px1 < fb2 - 0.5f) px1++;
 292:Source/render/decoders/pdfimg.c ****                     px1 -= 1;
 293:Source/render/decoders/pdfimg.c ****                     if (px1 > x1 - 1) px1 = x1 - 1;
 294:Source/render/decoders/pdfimg.c ****                     for (int px = px0; px <= px1; px++)
 295:Source/render/decoders/pdfimg.c ****                         row[px] = val;
 296:Source/render/decoders/pdfimg.c ****                 }
 297:Source/render/decoders/pdfimg.c ****             }
 298:Source/render/decoders/pdfimg.c ****         }
 299:Source/render/decoders/pdfimg.c ****     }
 300:Source/render/decoders/pdfimg.c ****     free(xs);
 301:Source/render/decoders/pdfimg.c ****     free(ds);
 302:Source/render/decoders/pdfimg.c ****     free(edges);
 303:Source/render/decoders/pdfimg.c **** }
