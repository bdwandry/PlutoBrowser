 186:Source/render/decoders/pdfimg.c **** /* Nonzero-winding scanline fill of all subpaths (device space). */
 187:Source/render/decoders/pdfimg.c **** static void pdfv_fill(uint8_t *gray, int W, int H, const PdfSub *subs,
 188:Source/render/decoders/pdfimg.c ****                       int nSubs, uint8_t val, const PdfGs *gs)
 189:Source/render/decoders/pdfimg.c **** {
 190:Source/render/decoders/pdfimg.c ****     int cap = 0, i;
 191:Source/render/decoders/pdfimg.c ****     PdfEdge *edges;
 192:Source/render/decoders/pdfimg.c ****     float ymin = 1e30f, ymax = -1e30f;
 193:Source/render/decoders/pdfimg.c ****     int x0 = 0, x1 = W, y0 = 0, y1 = H;
 194:Source/render/decoders/pdfimg.c **** 
 195:Source/render/decoders/pdfimg.c ****     if (gs->hasClip)
 196:Source/render/decoders/pdfimg.c ****     {
