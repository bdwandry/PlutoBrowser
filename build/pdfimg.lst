1002:Source/render/decoders/pdfimg.c **** static LCDBitmap *pdfvec_render(const uint8_t *data, size_t len)
1003:Source/render/decoders/pdfimg.c **** {
1004:Source/render/decoders/pdfimg.c ****     /* MediaBox (default letter) */
1005:Source/render/decoders/pdfimg.c ****     float mb[4] = {0, 0, 612, 792};
1006:Source/render/decoders/pdfimg.c ****     {
1007:Source/render/decoders/pdfimg.c ****         const void *h = memstr_local(data, len, "/MediaBox");
1008:Source/render/decoders/pdfimg.c ****         if (h)
1009:Source/render/decoders/pdfimg.c ****         {
1010:Source/render/decoders/pdfimg.c ****             size_t off = (size_t)((const uint8_t *)h - data);
1011:Source/render/decoders/pdfimg.c ****             size_t segLen = len - off;
1012:Source/render/decoders/pdfimg.c ****             if (segLen > 96) segLen = 96;
1013:Source/render/decoders/pdfimg.c ****             pdfv_floats_key((const char *)h, segLen, "MediaBox", mb, 4);
1014:Source/render/decoders/pdfimg.c ****         }
1015:Source/render/decoders/pdfimg.c ****     }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc10iemP.s 			page 187


1016:Source/render/decoders/pdfimg.c ****     float pw = mb[2] - mb[0], ph = mb[3] - mb[1];
1017:Source/render/decoders/pdfimg.c ****     if (pw <= 0 || ph <= 0) return NULL;
1018:Source/render/decoders/pdfimg.c **** 
1019:Source/render/decoders/pdfimg.c ****     /* find the page content stream: first stream that inflates (or reads)
1020:Source/render/decoders/pdfimg.c ****      * as text containing path operators */
1021:Source/render/decoders/pdfimg.c ****     uint8_t *cs = NULL;
1022:Source/render/decoders/pdfimg.c ****     int csOwned = 0;
1023:Source/render/decoders/pdfimg.c ****     size_t csLen = 0, from = 0;
1024:Source/render/decoders/pdfimg.c ****     while (!cs)
1025:Source/render/decoders/pdfimg.c ****     {
1026:Source/render/decoders/pdfimg.c ****         size_t sLen = 0;
1027:Source/render/decoders/pdfimg.c ****         const uint8_t *sd = pdf_stream_data(data, len, from, &sLen);
1028:Source/render/decoders/pdfimg.c ****         if (!sd) break;
1029:Source/render/decoders/pdfimg.c ****         from = (size_t)(sd - data) + sLen + 9;
1030:Source/render/decoders/pdfimg.c ****         uint8_t *inf = NULL;
1031:Source/render/decoders/pdfimg.c ****         size_t infLen = 0;
1032:Source/render/decoders/pdfimg.c ****         if (sLen >= 2 && sd[0] == 0x78)
1033:Source/render/decoders/pdfimg.c ****             inf = inflate_decompress(sd, sLen, &infLen);
1034:Source/render/decoders/pdfimg.c ****         const uint8_t *cand = inf ? inf : sd;
1035:Source/render/decoders/pdfimg.c ****         size_t candLen = inf ? infLen : sLen;
1036:Source/render/decoders/pdfimg.c ****         if (candLen > 16 &&
1037:Source/render/decoders/pdfimg.c ****             (memstr_local(cand, candLen, " re") ||
1038:Source/render/decoders/pdfimg.c ****              memstr_local(cand, candLen, " f*") ||
1039:Source/render/decoders/pdfimg.c ****              memstr_local(cand, candLen, " S")))
1040:Source/render/decoders/pdfimg.c ****         {
1041:Source/render/decoders/pdfimg.c ****             if (inf)
1042:Source/render/decoders/pdfimg.c ****             {
1043:Source/render/decoders/pdfimg.c ****                 cs = inf;
1044:Source/render/decoders/pdfimg.c ****                 csOwned = 1;
1045:Source/render/decoders/pdfimg.c ****             }
1046:Source/render/decoders/pdfimg.c ****             else
1047:Source/render/decoders/pdfimg.c ****             {
1048:Source/render/decoders/pdfimg.c ****                 cs = (uint8_t *)malloc(candLen);
1049:Source/render/decoders/pdfimg.c ****                 if (cs)
1050:Source/render/decoders/pdfimg.c ****                 {
1051:Source/render/decoders/pdfimg.c ****                     memcpy(cs, cand, candLen);
1052:Source/render/decoders/pdfimg.c ****                     csOwned = 1;
1053:Source/render/decoders/pdfimg.c ****                 }
1054:Source/render/decoders/pdfimg.c ****             }
1055:Source/render/decoders/pdfimg.c ****             csLen = candLen;
1056:Source/render/decoders/pdfimg.c ****         }
1057:Source/render/decoders/pdfimg.c ****         else
1058:Source/render/decoders/pdfimg.c ****         {
1059:Source/render/decoders/pdfimg.c ****             free(inf);
1060:Source/render/decoders/pdfimg.c ****         }
1061:Source/render/decoders/pdfimg.c ****     }
1062:Source/render/decoders/pdfimg.c ****     if (!cs) return NULL;
1063:Source/render/decoders/pdfimg.c **** 
1064:Source/render/decoders/pdfimg.c ****     /* fit into 360x200, never upscale */
1065:Source/render/decoders/pdfimg.c ****     float scale = 360.0f / pw;
1066:Source/render/decoders/pdfimg.c ****     if (200.0f / ph < scale) scale = 200.0f / ph;
1067:Source/render/decoders/pdfimg.c ****     if (scale > 1.0f) scale = 1.0f;
1068:Source/render/decoders/pdfimg.c ****     int W = (int)(pw * scale);
1069:Source/render/decoders/pdfimg.c ****     int H = (int)(ph * scale);
1070:Source/render/decoders/pdfimg.c ****     if (W < 1) W = 1;
1071:Source/render/decoders/pdfimg.c ****     if (H < 1) H = 1;
1072:Source/render/decoders/pdfimg.c **** 
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc10iemP.s 			page 188


1073:Source/render/decoders/pdfimg.c ****     uint8_t *gray = (uint8_t *)malloc((size_t)W * (size_t)H);
1074:Source/render/decoders/pdfimg.c ****     if (!gray)
1075:Source/render/decoders/pdfimg.c ****     {
1076:Source/render/decoders/pdfimg.c ****         if (csOwned) free(cs);
1077:Source/render/decoders/pdfimg.c ****         return NULL;
1078:Source/render/decoders/pdfimg.c ****     }
1079:Source/render/decoders/pdfimg.c ****     memset(gray, 255, (size_t)W * (size_t)H);
1080:Source/render/decoders/pdfimg.c **** 
1081:Source/render/decoders/pdfimg.c ****     PdfM pageM = pdfv_page_matrix(mb[0], mb[1], mb[2], mb[3], W, H);
1082:Source/render/decoders/pdfimg.c ****     pdfv_run(cs, csLen, gray, W, H, pageM, data, len);
1083:Source/render/decoders/pdfimg.c ****     if (csOwned) free(cs);
1084:Source/render/decoders/pdfimg.c **** 
1085:Source/render/decoders/pdfimg.c ****     PdfVecPix pp;
1086:Source/render/decoders/pdfimg.c ****     pp.W = W;
1087:Source/render/decoders/pdfimg.c ****     pp.H = H;
1088:Source/render/decoders/pdfimg.c ****     pp.gray = gray;
1089:Source/render/decoders/pdfimg.c ****     LCDBitmap *img = dither_to_bitmap(W, H, pdfv_pixel_cb, &pp);
1090:Source/render/decoders/pdfimg.c ****     free(gray);
1091:Source/render/decoders/pdfimg.c ****     if (img) logger_log("PDF ok (vector) %dx%d", W, H);
1092:Source/render/decoders/pdfimg.c ****     return img;
1093:Source/render/decoders/pdfimg.c **** }
