 359:src/html/document.c **** /* ── meta refresh content parsing ────────────────────
 360:src/html/document.c **** /* "^(%d+%.?%d*)%s*;%s*[Uu][Rr][Ll]=%s*(.+)$" or "^(%d+\.?%d*)%s*$"       */
 361:src/html/document.c **** 
 362:src/html/document.c **** static int d_parse_meta_content(const char* content, double* delayOut,
 363:src/html/document.c ****                                 char** urlOut) {
 364:src/html/document.c ****     *urlOut = NULL;
 365:src/html/document.c ****     if (content == NULL) return 0;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccJOur1O.s 			page 9


 366:src/html/document.c ****     const char* p = content;
 367:src/html/document.c ****     if (!isdigit((unsigned char)*p)) return 0;
 368:src/html/document.c ****     const char* ds = p;
 369:src/html/document.c ****     while (isdigit((unsigned char)*p)) p++;
 370:src/html/document.c ****     if (*p == '.') {
 371:src/html/document.c ****         p++;
 372:src/html/document.c ****         while (isdigit((unsigned char)*p)) p++;
 373:src/html/document.c ****     }
 374:src/html/document.c ****     char dbuf[24];
 375:src/html/document.c ****     size_t dl = (size_t)(p - ds);
 376:src/html/document.c ****     if (dl >= sizeof(dbuf)) dl = sizeof(dbuf) - 1;
 377:src/html/document.c ****     memcpy(dbuf, ds, dl);
 378:src/html/document.c ****     dbuf[dl] = '\0';
 379:src/html/document.c **** 
 380:src/html/document.c ****     if (*p == ';') {
 381:src/html/document.c ****         p++;
 382:src/html/document.c ****         while (*p != '\0' && isspace((unsigned char)*p)) p++;
 383:src/html/document.c ****         if ((*p == 'u' || *p == 'U') && strncasecmp(p, "url", 3) == 0 &&
 384:src/html/document.c ****             p[3] == '=') {
 385:src/html/document.c ****             p += 4;
 386:src/html/document.c ****             while (*p != '\0' && isspace((unsigned char)*p)) p++;
 387:src/html/document.c ****             const char* us = p;
 388:src/html/document.c ****             while (*p != '\0') p++;          /* (.+)$ to end */
 389:src/html/document.c ****             size_t ul = (size_t)(p - us);
 390:src/html/document.c ****             while (ul > 0 && isspace((unsigned char)us[ul - 1])) ul--;
 391:src/html/document.c ****             if (ul == 0) {
 392:src/html/document.c ****                 *delayOut = strtod(dbuf, NULL);
 393:src/html/document.c ****                 return 1;
 394:src/html/document.c ****             }
 395:src/html/document.c ****             char* u = pluto_strndup(us, ul);
 396:src/html/document.c ****             if (u == NULL) return 0;
 397:src/html/document.c ****             *delayOut = strtod(dbuf, NULL);
 398:src/html/document.c ****             *urlOut = u;
 399:src/html/document.c ****             return 1;
 400:src/html/document.c ****         }
 401:src/html/document.c ****         return 0;  /* ';' but not url= : neither Lua pattern matches */
 402:src/html/document.c ****     }
 403:src/html/document.c ****     while (*p != '\0' && isspace((unsigned char)*p)) p++;
 404:src/html/document.c ****     if (*p != '\0') return 0;
 405:src/html/document.c ****     *delayOut = strtod(dbuf, NULL);
 406:src/html/document.c ****     return 1;
 407:src/html/document.c **** }
