 908:src/html/document.c **** }
 909:src/html/document.c **** 
 910:src/html/document.c **** static void d_split_code_lines(DocBlock* b) {
 911:src/html/document.c ****     const char* p = (b->codeText != NULL) ? b->codeText : "";
 912:src/html/document.c ****     size_t cap = 0;
 913:src/html/document.c ****     const char* seg = p;
 914:src/html/document.c ****     for (;;) {
 915:src/html/document.c ****         if (*p == '\n' || *p == '\0') {
 916:src/html/document.c ****             size_t len = (size_t)(p - seg);
 917:src/html/document.c ****             if (len > 0 && seg[len - 1] == '\r') len--;
 918:src/html/document.c ****             if (b->nLines == cap) {
 919:src/html/document.c ****                 size_t nc = cap ? cap * 2 : 8;
 920:src/html/document.c ****                 char** nl = pluto_realloc(b->lines, nc * sizeof(char*));
 921:src/html/document.c ****                 if (nl == NULL) return;
 922:src/html/document.c ****                 b->lines = nl;
 923:src/html/document.c ****                 cap = nc;
 924:src/html/document.c ****             }
 925:src/html/document.c ****             b->lines[b->nLines++] = pluto_strndup(seg, len);
 926:src/html/document.c ****             if (*p == '\0') break;
 927:src/html/document.c ****             seg = p + 1;
 928:src/html/document.c ****         }
 929:src/html/document.c ****         p++;
 930:src/html/document.c ****     }
 931:src/html/document.c **** }
