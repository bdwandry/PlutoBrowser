 352:Source/html/document.c **** static int d_valid_href(const char* raw) {
 353:Source/html/document.c ****     if (raw == NULL || raw[0] == '\0') return 0;
 354:Source/html/document.c ****     if (raw[0] == '#') return 0;
 355:Source/html/document.c ****     if (d_starts_ci(raw, "javascript:")) return 0;
 356:Source/html/document.c ****     if (d_starts_ci(raw, "data:")) return 0;
 357:Source/html/document.c ****     return 1;
 358:Source/html/document.c **** }
