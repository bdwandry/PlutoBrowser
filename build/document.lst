 383:Source/html/document.c **** /* Lua num(): strip '%', then STRICT tonumber. "10px" fails → component 0. */
 384:Source/html/document.c **** static int box_num(const char *v)
 385:Source/html/document.c **** {
 386:Source/html/document.c ****     if (!v)
 387:Source/html/document.c ****     {
 388:Source/html/document.c ****         return 0;
 389:Source/html/document.c ****     }
 390:Source/html/document.c ****     char tmp[64];
 391:Source/html/document.c ****     size_t o = 0;
 392:Source/html/document.c ****     for (size_t i = 0; v[i] && o + 1 < sizeof(tmp); i++)
 393:Source/html/document.c ****     {
 394:Source/html/document.c ****         if (v[i] != '%')
 395:Source/html/document.c ****         {
 396:Source/html/document.c ****             tmp[o++] = v[i];
 397:Source/html/document.c ****         }
 398:Source/html/document.c ****     }
 399:Source/html/document.c ****     tmp[o] = '\0';
 400:Source/html/document.c ****     char *end = NULL;
