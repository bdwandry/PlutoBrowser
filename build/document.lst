1101:Source/html/document.c **** /* in-place Lua "%s+" -> " " collapse plus end trim */
1102:Source/html/document.c **** static void d_collapse_trim(char* s) {
1103:Source/html/document.c ****     if (s == NULL) return;
1104:Source/html/document.c ****     size_t r = 0, w = 0;
1105:Source/html/document.c ****     int inWs = 0;
1106:Source/html/document.c ****     while (s[r] != '\0') {
1107:Source/html/document.c ****         if (isspace((unsigned char)s[r])) {
1108:Source/html/document.c ****             inWs = 1;
1109:Source/html/document.c ****             r++;
1110:Source/html/document.c ****         } else {
1111:Source/html/document.c ****             if (inWs && w > 0) s[w++] = ' ';
1112:Source/html/document.c ****             inWs = 0;
1113:Source/html/document.c ****             s[w++] = s[r++];
1114:Source/html/document.c ****         }
1115:Source/html/document.c ****     }
1116:Source/html/document.c ****     s[w] = '\0';
1117:Source/html/document.c **** }
1118:Source/html/document.c **** 
1119:Source/html/document.c **** static int d_details_override(const DocState* st, const char* key,
1120:Source/html/document.c ****                               int defaultOpen) {
1121:Source/html/document.c ****     if (st->opts != NULL && st->opts->detailsOverrides != NULL) {
1122:Source/html/document.c ****         for (size_t i = 0; i < st->opts->nOverrides; i++)
1123:Source/html/document.c ****             if (strcmp(st->opts->detailsOverrides[i].key, key) == 0)
1124:Source/html/document.c ****                 return st->opts->detailsOverrides[i].open ? 1 : 0;
1125:Source/html/document.c ****     }
1126:Source/html/document.c ****     return defaultOpen;
1127:Source/html/document.c **** }
1128:Source/html/document.c **** 
1129:Source/html/document.c **** /* shared "common" attribute bundle for input-family blocks */
1130:Source/html/document.c **** typedef struct {
1131:Source/html/document.c ****     char* name;          /* owned */
1132:Source/html/document.c ****     char* value;         /* owned */
1133:Source/html/document.c ****     unsigned char disabled, readonlyFlag, requiredFlag, inertFlag;
1134:Source/html/document.c ****     int maxlength;       /* -1 unset */
1135:Source/html/document.c **** } DInputCommon;
1136:Source/html/document.c **** 
1137:Source/html/document.c **** static void d_input_common(DocState* st, StrMap* attrs, DInputCommon* c) {
1138:Source/html/document.c ****     memset(c, 0, sizeof(*c));
1139:Source/html/document.c ****     const char* nm = da_get(attrs, "name");
1140:Source/html/document.c ****     c->name = pluto_strdup((nm != NULL) ? nm : "q");
1141:Source/html/document.c ****     const char* val = da_get(attrs, "value");
1142:Source/html/document.c ****     c->value = pluto_strdup((val != NULL) ? val : "");
1143:Source/html/document.c ****     int dis = da_has(attrs, "disabled") || st->disabledDepth > 0;
1144:Source/html/document.c ****     c->disabled = (unsigned char)dis;
1145:Source/html/document.c ****     c->readonlyFlag =
1146:Source/html/document.c ****         (unsigned char)(da_has(attrs, "readonly") || dis);
1147:Source/html/document.c ****     c->requiredFlag = (unsigned char)da_has(attrs, "required");
1148:Source/html/document.c ****     int ok = 0;
1149:Source/html/document.c ****     double mv = d_tonum(da_get(attrs, "maxlength"), &ok);
1150:Source/html/document.c ****     c->maxlength = ok ? (int)mv : -1;
1151:Source/html/document.c ****     c->inertFlag = (unsigned char)((st->inert > 0) || dis);
1152:Source/html/document.c **** }
