 668:src/html/document.c **** static void d_handle_image(DocState* st, StrMap* attrs) {
 669:src/html/document.c ****     char srcBuf[1024];
 670:src/html/document.c ****     const char* src = da_get(attrs, "src");
 671:src/html/document.c ****     if (src == NULL || src[0] == '\0') src = da_get(attrs, "data-src");
 672:src/html/document.c ****     if (src == NULL || src[0] == '\0') {
 673:src/html/document.c ****         const char* ss = da_get(attrs, "srcset");
 674:src/html/document.c ****         if (ss != NULL && ss[0] != '\0') {
 675:src/html/document.c ****             size_t j = 0;
 676:src/html/document.c ****             const char* p = ss;
 677:src/html/document.c ****             while (*p != '\0' && !(isspace((unsigned char)*p) || *p == ',') &&
 678:src/html/document.c ****                    j + 1 < sizeof(srcBuf))
 679:src/html/document.c ****                 srcBuf[j++] = *p++;
 680:src/html/document.c ****             srcBuf[j] = '\0';
 681:src/html/document.c ****             if (j > 0) src = srcBuf;
 682:src/html/document.c ****         }
 683:src/html/document.c ****     }
 684:src/html/document.c ****     if (src == NULL || src[0] == '\0') return;
 685:src/html/document.c **** 
 686:src/html/document.c ****     const char* alt = da_get(attrs, "alt");
 687:src/html/document.c ****     if (alt == NULL || alt[0] == '\0') alt = da_get(attrs, "title");
 688:src/html/document.c ****     if (alt == NULL || alt[0] == '\0') alt = "Image";
 689:src/html/document.c **** 
 690:src/html/document.c ****     int ok = 0;
 691:src/html/document.c ****     double wv = d_tonum(da_get(attrs, "width"), &ok);
 692:src/html/document.c ****     int w = (ok && wv > 0) ? (int)wv : 160;
 693:src/html/document.c ****     double hv = d_tonum(da_get(attrs, "height"), &ok);
 694:src/html/document.c ****     int h = (ok && hv > 0) ? (int)hv : 80;
