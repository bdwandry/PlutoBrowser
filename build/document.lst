 783:Source/html/document.c **** static void doc_ensure_block(DocState* st) {
 784:Source/html/document.c ****     if (st->currentBlock != NULL) return;
 785:Source/html/document.c ****     DocBlock* b = pluto_malloc(sizeof(DocBlock));
 786:Source/html/document.c ****     if (b == NULL) return;
 787:Source/html/document.c ****     memset(b, 0, sizeof(*b));
