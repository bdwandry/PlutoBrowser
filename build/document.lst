 360:Source/html/document.c **** /* ── meta refresh content parsing ────────────────────
 361:Source/html/document.c **** /* "^(%d+%.?%d*)%s*;%s*[Uu][Rr][Ll]=%s*(.+)$" or "^(%d+\.?%d*)%s*$"       */
 362:Source/html/document.c **** 
 363:Source/html/document.c **** static int d_parse_meta_content(const char* content, double* delayOut,
 364:Source/html/document.c ****                                 char** urlOut) {
 365:Source/html/document.c ****     *urlOut = NULL;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccoihWyO.s 			page 9


 366:Source/html/document.c ****     if (content == NULL) return 0;
 367:Source/html/document.c ****     const char* p = content;
 368:Source/html/document.c ****     if (!isdigit((unsigned char)*p)) return 0;
 369:Source/html/document.c ****     const char* ds = p;
 370:Source/html/document.c ****     while (isdigit((unsigned char)*p)) p++;
 371:Source/html/document.c ****     if (*p == '.') {
 372:Source/html/document.c ****         p++;
 373:Source/html/document.c ****         while (isdigit((unsigned char)*p)) p++;
 374:Source/html/document.c ****     }
 375:Source/html/document.c ****     char dbuf[24];
 376:Source/html/document.c ****     size_t dl = (size_t)(p - ds);
 377:Source/html/document.c ****     if (dl >= sizeof(dbuf)) dl = sizeof(dbuf) - 1;
 378:Source/html/document.c ****     memcpy(dbuf, ds, dl);
 379:Source/html/document.c ****     dbuf[dl] = '\0';
 380:Source/html/document.c **** 
 381:Source/html/document.c ****     if (*p == ';') {
 382:Source/html/document.c ****         p++;
 383:Source/html/document.c ****         while (*p != '\0' && isspace((unsigned char)*p)) p++;
 384:Source/html/document.c ****         if ((*p == 'u' || *p == 'U') && strncasecmp(p, "url", 3) == 0 &&
 385:Source/html/document.c ****             p[3] == '=') {
 386:Source/html/document.c ****             p += 4;
 387:Source/html/document.c ****             while (*p != '\0' && isspace((unsigned char)*p)) p++;
 388:Source/html/document.c ****             const char* us = p;
 389:Source/html/document.c ****             while (*p != '\0') p++;          /* (.+)$ to end */
 390:Source/html/document.c ****             size_t ul = (size_t)(p - us);
 391:Source/html/document.c ****             while (ul > 0 && isspace((unsigned char)us[ul - 1])) ul--;
 392:Source/html/document.c ****             if (ul == 0) {
 393:Source/html/document.c ****                 *delayOut = strtod(dbuf, NULL);
 394:Source/html/document.c ****                 return 1;
 395:Source/html/document.c ****             }
 396:Source/html/document.c ****             char* u = pluto_strndup(us, ul);
 397:Source/html/document.c ****             if (u == NULL) return 0;
 398:Source/html/document.c ****             *delayOut = strtod(dbuf, NULL);
 399:Source/html/document.c ****             *urlOut = u;
 400:Source/html/document.c ****             return 1;
 401:Source/html/document.c ****         }
 402:Source/html/document.c ****         return 0;  /* ';' but not url= : neither Lua pattern matches */
 403:Source/html/document.c ****     }
 404:Source/html/document.c ****     while (*p != '\0' && isspace((unsigned char)*p)) p++;
 405:Source/html/document.c ****     if (*p != '\0') return 0;
 406:Source/html/document.c ****     *delayOut = strtod(dbuf, NULL);
 407:Source/html/document.c ****     return 1;
 408:Source/html/document.c **** }
