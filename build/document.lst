1039:Source/html/document.c **** /* Collapse Lua %s+ runs into a single space, then trim. */
1040:Source/html/document.c **** static char *doc_arena_collapse(Walker *w, const char *s)
1041:Source/html/document.c **** {
1042:Source/html/document.c ****     if (!s)
1043:Source/html/document.c ****     {
1044:Source/html/document.c ****         return NULL;
1045:Source/html/document.c ****     }
1046:Source/html/document.c ****     static char tmp[1024]; /* hoisted: device gameTask stack is tiny */
1047:Source/html/document.c ****     size_t o = 0;
1048:Source/html/document.c ****     for (const char *p = s; *p && o + 1 < sizeof(tmp); p++)
1049:Source/html/document.c ****     {
1050:Source/html/document.c ****         if (is_lspace(*p))
1051:Source/html/document.c ****         {
1052:Source/html/document.c ****             if (o > 0 && tmp[o - 1] != ' ')
1053:Source/html/document.c ****             {
1054:Source/html/document.c ****                 tmp[o++] = ' ';
1055:Source/html/document.c ****             }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccrc7lPq.s 			page 37


1056:Source/html/document.c ****             while (is_lspace(p[1]) && o + 3 < sizeof(tmp))
1057:Source/html/document.c ****             {
1058:Source/html/document.c ****                 p++;
1059:Source/html/document.c ****             }
1060:Source/html/document.c ****         }
1061:Source/html/document.c ****         else
1062:Source/html/document.c ****         {
1063:Source/html/document.c ****             tmp[o++] = *p;
1064:Source/html/document.c ****         }
1065:Source/html/document.c ****     }
1066:Source/html/document.c ****     while (o > 0 && is_lspace(tmp[o - 1]))
1067:Source/html/document.c ****     {
1068:Source/html/document.c ****         o--;
1069:Source/html/document.c ****     }
1070:Source/html/document.c ****     tmp[o] = '\0';
1071:Source/html/document.c ****     return doc_arena_str(w, tmp);
1072:Source/html/document.c **** }
