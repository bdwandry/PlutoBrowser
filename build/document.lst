1232:Source/html/document.c **** /* mfenced attribute: entity-decoded with default; returns owned string */
1233:Source/html/document.c **** static char* d_mfenced_attr(StrMap* attrs, const char* key,
1234:Source/html/document.c ****                             const char* dflt) {
1235:Source/html/document.c ****     const char* raw = da_get(attrs, key);
1236:Source/html/document.c ****     if (raw == NULL || raw[0] == '\0') raw = dflt;
1237:Source/html/document.c ****     size_t outLen = 0;
