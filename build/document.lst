 143:Source/html/document.c ****         {
 144:Source/html/document.c ****             pos++;
 145:Source/html/document.c ****             continue;
 146:Source/html/document.c ****         }
 147:Source/html/document.c ****         size_t ke = pos;
 148:Source/html/document.c ****         while (ke < n && is_lkey(s[ke]))
 149:Source/html/document.c ****         {
 150:Source/html/document.c ****             ke++;
 151:Source/html/document.c ****         }
 152:Source/html/document.c ****         size_t c = ke;
 153:Source/html/document.c ****         while (c < n && is_lspace(s[c]))
 154:Source/html/document.c ****         {
 155:Source/html/document.c ****             c++;
 156:Source/html/document.c ****         }
