 160:Source/html/document.c ****             size_t vStart = c + 1;
 161:Source/html/document.c ****             size_t vEnd = vStart;
 162:Source/html/document.c ****             while (vEnd < n && is_lspace(s[vEnd]))
 163:Source/html/document.c ****             {
