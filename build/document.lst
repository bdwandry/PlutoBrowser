2470:src/html/document.c **** 
2471:src/html/document.c **** static void d_walk(DocState* st, DomNode* n) {
2472:src/html/document.c ****     tasks_yield_check();
2473:src/html/document.c ****     if (n->kind == DOM_TEXT) {
2474:src/html/document.c ****         d_handle_text_node(st, n);
2475:src/html/document.c ****         return;
2476:src/html/document.c ****     }
2477:src/html/document.c ****     if (n->kind != DOM_ELEMENT) return;
2478:src/html/document.c ****     if (d_is_display_none(n->attrs)) return;
2479:src/html/document.c ****     int inertHere = da_has(n->attrs, "inert");
2480:src/html/document.c ****     if (inertHere) st->inert++;
2481:src/html/document.c ****     d_handle_element(st, n);
2482:src/html/document.c ****     if (inertHere) st->inert--;
2483:src/html/document.c **** }
