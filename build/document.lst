1104:Source/html/document.c **** /* in-place Lua "%s+" -> " " collapse plus end trim */
1105:Source/html/document.c **** static void d_collapse_trim(char* s) {
1106:Source/html/document.c ****     if (s == NULL) return;
1107:Source/html/document.c ****     size_t r = 0, w = 0;
1108:Source/html/document.c ****     int inWs = 0;
1109:Source/html/document.c ****     while (s[r] != '\0') {
1110:Source/html/document.c ****         if (isspace((unsigned char)s[r])) {
1111:Source/html/document.c ****             inWs = 1;
1112:Source/html/document.c ****             r++;
1113:Source/html/document.c ****         } else {
1114:Source/html/document.c ****             if (inWs && w > 0) s[w++] = ' ';
1115:Source/html/document.c ****             inWs = 0;
1116:Source/html/document.c ****             s[w++] = s[r++];
1117:Source/html/document.c ****         }
1118:Source/html/document.c ****     }
1119:Source/html/document.c ****     s[w] = '\0';
1120:Source/html/document.c **** }
1121:Source/html/document.c **** 
1122:Source/html/document.c **** static int d_details_override(const DocState* st, const char* key,
1123:Source/html/document.c ****                               int defaultOpen) {
1124:Source/html/document.c ****     if (st->opts != NULL && st->opts->detailsOverrides != NULL) {
1125:Source/html/document.c ****         for (size_t i = 0; i < st->opts->nOverrides; i++)
1126:Source/html/document.c ****             if (strcmp(st->opts->detailsOverrides[i].key, key) == 0)
1127:Source/html/document.c ****                 return st->opts->detailsOverrides[i].open ? 1 : 0;
1128:Source/html/document.c ****     }
1129:Source/html/document.c ****     return defaultOpen;
1130:Source/html/document.c **** }
