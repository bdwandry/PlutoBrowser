 943:src/html/document.c **** /* in-place Lua "%s+" -> " " collapse plus end trim */
 944:src/html/document.c **** static void d_collapse_trim(char* s) {
 945:src/html/document.c ****     if (s == NULL) return;
 946:src/html/document.c ****     size_t r = 0, w = 0;
 947:src/html/document.c ****     int inWs = 0;
 948:src/html/document.c ****     while (s[r] != '\0') {
 949:src/html/document.c ****         if (isspace((unsigned char)s[r])) {
 950:src/html/document.c ****             inWs = 1;
 951:src/html/document.c ****             r++;
 952:src/html/document.c ****         } else {
 953:src/html/document.c ****             if (inWs && w > 0) s[w++] = ' ';
 954:src/html/document.c ****             inWs = 0;
 955:src/html/document.c ****             s[w++] = s[r++];
 956:src/html/document.c ****         }
 957:src/html/document.c ****     }
 958:src/html/document.c ****     s[w] = '\0';
 959:src/html/document.c **** }
 960:src/html/document.c **** 
 961:src/html/document.c **** static int d_details_override(const DocState* st, const char* key,
 962:src/html/document.c ****                               int defaultOpen) {
 963:src/html/document.c ****     if (st->opts != NULL && st->opts->detailsOverrides != NULL) {
 964:src/html/document.c ****         for (size_t i = 0; i < st->opts->nOverrides; i++)
 965:src/html/document.c ****             if (strcmp(st->opts->detailsOverrides[i].key, key) == 0)
 966:src/html/document.c ****                 return st->opts->detailsOverrides[i].open ? 1 : 0;
 967:src/html/document.c ****     }
 968:src/html/document.c ****     return defaultOpen;
 969:src/html/document.c **** }
 970:src/html/document.c **** 
 971:src/html/document.c **** /* shared "common" attribute bundle for input-family blocks */
 972:src/html/document.c **** typedef struct {
 973:src/html/document.c ****     char* name;          /* owned */
