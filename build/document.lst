1132:Source/html/document.c **** /* shared "common" attribute bundle for input-family blocks */
1133:Source/html/document.c **** typedef struct {
1134:Source/html/document.c ****     char* name;          /* owned */
1135:Source/html/document.c ****     char* value;         /* owned */
1136:Source/html/document.c ****     unsigned char disabled, readonlyFlag, requiredFlag, inertFlag;
1137:Source/html/document.c ****     int maxlength;       /* -1 unset */
1138:Source/html/document.c **** } DInputCommon;
1139:Source/html/document.c **** 
1140:Source/html/document.c **** static void d_input_common(DocState* st, StrMap* attrs, DInputCommon* c) {
1141:Source/html/document.c ****     memset(c, 0, sizeof(*c));
1142:Source/html/document.c ****     const char* nm = da_get(attrs, "name");
1143:Source/html/document.c ****     c->name = pluto_strdup((nm != NULL) ? nm : "q");
1144:Source/html/document.c ****     const char* val = da_get(attrs, "value");
1145:Source/html/document.c ****     c->value = pluto_strdup((val != NULL) ? val : "");
1146:Source/html/document.c ****     int dis = da_has(attrs, "disabled") || st->disabledDepth > 0;
1147:Source/html/document.c ****     c->disabled = (unsigned char)dis;
1148:Source/html/document.c ****     c->readonlyFlag =
1149:Source/html/document.c ****         (unsigned char)(da_has(attrs, "readonly") || dis);
1150:Source/html/document.c ****     c->requiredFlag = (unsigned char)da_has(attrs, "required");
1151:Source/html/document.c ****     int ok = 0;
1152:Source/html/document.c ****     double mv = d_tonum(da_get(attrs, "maxlength"), &ok);
