 652:src/html/document.c **** static void d_handle_text_node(DocState* st, DomNode* n) {
 653:src/html/document.c ****     const char* text = (n->text != NULL) ? n->text : "";
 654:src/html/document.c ****     if (text[0] == '\0') return;
 655:src/html/document.c ****     if (st->inPre) { sb_append_str(&st->preBuffer, text); return; }
 656:src/html/document.c ****     if (st->inTextarea) { sb_append_str(&st->textareaBuffer, text); return; }
 657:src/html/document.c ****     if (st->currentTableCell != NULL) return;              /* P11: tables */
 658:src/html/document.c ****     if (st->figureActive && !st->figureCaptionDone) {
 659:src/html/document.c ****         sb_append_str(&st->figCaption, text);
 660:src/html/document.c ****         return;
 661:src/html/document.c ****     }
 662:src/html/document.c ****     if (st->inMath) { sb_append_str(&st->mathParts, text); return; }
 663:src/html/document.c ****     doc_add_inline_text(st, text);
 664:src/html/document.c **** }
