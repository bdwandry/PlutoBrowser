  85:src/html/document.c **** static void d_parse_style(DStyle* out, const char* styleStr) {
  86:src/html/document.c ****     memset(out, 0, sizeof(*out));
  87:src/html/document.c ****     if (styleStr == NULL || styleStr[0] == '\0') return;
  88:src/html/document.c ****     const char* p = styleStr;
