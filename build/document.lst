1019:Source/html/document.c **** /* Lua string.gsub(s, "^(%s*).-(%s*)$" → trimmed copy). NULL → NULL. */
1020:Source/html/document.c **** static char *doc_arena_trim(Walker *w, const char *s)
1021:Source/html/document.c **** {
1022:Source/html/document.c ****     if (!s)
1023:Source/html/document.c ****     {
1024:Source/html/document.c ****         return NULL;
1025:Source/html/document.c ****     }
1026:Source/html/document.c ****     const char *a = s;
1027:Source/html/document.c ****     const char *z = s + strlen(s);
1028:Source/html/document.c ****     while (a < z && is_lspace(*a))
1029:Source/html/document.c ****     {
1030:Source/html/document.c ****         a++;
1031:Source/html/document.c ****     }
1032:Source/html/document.c ****     while (z > a && is_lspace(*(z - 1)))
1033:Source/html/document.c ****     {
1034:Source/html/document.c ****         z--;
1035:Source/html/document.c ****     }
1036:Source/html/document.c ****     return doc_arena_strn(w, a, (size_t)(z - a));
1037:Source/html/document.c **** }
