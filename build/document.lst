  32:Source/html/document.c **** /* Lua tonumber(): full-string numeric parse */
  33:Source/html/document.c **** static double d_tonum(const char* v, int* ok) {
  34:Source/html/document.c ****     *ok = 0;
  35:Source/html/document.c ****     if (v == NULL) return 0.0;
  36:Source/html/document.c ****     while (*v != '\0' && isspace((unsigned char)*v)) v++;
  37:Source/html/document.c ****     char* end = NULL;
