 315:Source/html/document.c **** static void d_attr_iter_cb(const char* key, void* value, void* ud) {
 316:Source/html/document.c ****     StrBuf* out = (StrBuf*)ud;
 317:Source/html/document.c ****     sb_append_char(out, ' ');
 318:Source/html/document.c ****     sb_append_str(out, key);
 319:Source/html/document.c ****     sb_append_str(out, "=\"");
 320:Source/html/document.c ****     d_svg_escape_value((value == HT_ATTR_TRUE) ? "" : (const char*)value, out);
 321:Source/html/document.c ****     sb_append_char(out, '"');
 322:Source/html/document.c **** }
 323:Source/html/document.c **** 
 324:Source/html/document.c **** static void d_serialize_svg_into(DomNode* n, StrBuf* out) {
 325:Source/html/document.c ****     if (n == NULL) return;
 326:Source/html/document.c ****     if (n->kind == DOM_TEXT) {
 327:Source/html/document.c ****         size_t encLen = 0;
 328:Source/html/document.c ****         char* enc = entities_encode(n->text ? n->text : "",
 329:Source/html/document.c ****                                     n->textLen, &encLen);
 330:Source/html/document.c ****         if (enc != NULL) {
 331:Source/html/document.c ****             sb_append(out, enc, encLen);
 332:Source/html/document.c ****             pluto_free(enc);
 333:Source/html/document.c ****         }
 334:Source/html/document.c ****         return;
 335:Source/html/document.c ****     }
 336:Source/html/document.c ****     if (n->kind != DOM_ELEMENT) return;
 337:Source/html/document.c ****     sb_append_char(out, '<');
 338:Source/html/document.c ****     sb_append_str(out, n->tag);
 339:Source/html/document.c ****     sm_foreach(n->attrs, d_attr_iter_cb, out);
 340:Source/html/document.c ****     if (n->nChildren == 0) {
 341:Source/html/document.c ****         sb_append_str(out, "/>");
 342:Source/html/document.c ****         return;
 343:Source/html/document.c ****     }
 344:Source/html/document.c ****     sb_append_char(out, '>');
 345:Source/html/document.c ****     for (size_t i = 0; i < n->nChildren; i++)
 346:Source/html/document.c ****         d_serialize_svg_into(n->children[i], out);
 347:Source/html/document.c ****     sb_append_str(out, "</");
 348:Source/html/document.c ****     sb_append_str(out, n->tag);
 349:Source/html/document.c ****     sb_append_char(out, '>');
 350:Source/html/document.c **** }
