 351:src/html/document.c **** static int d_valid_href(const char* raw) {
 352:src/html/document.c ****     if (raw == NULL || raw[0] == '\0') return 0;
 353:src/html/document.c ****     if (raw[0] == '#') return 0;
 354:src/html/document.c ****     if (d_starts_ci(raw, "javascript:")) return 0;
 355:src/html/document.c ****     if (d_starts_ci(raw, "data:")) return 0;
 356:src/html/document.c ****     return 1;
 357:src/html/document.c **** }
