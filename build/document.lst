 106:Source/html/document.c ****         const char* vs = p;
 107:Source/html/document.c ****         while (*p != '\0' && *p != ';') p++;
 108:Source/html/document.c ****         size_t vlen = (size_t)(p - vs);
 109:Source/html/document.c ****         if (*p == ';') p++;
 110:Source/html/document.c ****         if (klen == 0 || vlen == 0) continue;
 111:Source/html/document.c **** 
 112:Source/html/document.c ****         char key[40], val[80];
 113:Source/html/document.c ****         if (klen >= sizeof(key)) klen = sizeof(key) - 1;
