4186:Source/html/document.c **** static char* d_resolve_meta_url(const char* baseUrl, const char* raw) {
4187:Source/html/document.c ****     if (raw == NULL || raw[0] == '\0') return NULL;
4188:Source/html/document.c ****     StrBuf r;
4189:Source/html/document.c ****     sb_init(&r);
4190:Source/html/document.c ****     url_resolve(baseUrl, raw, &r);
4191:Source/html/document.c ****     return sb_detach(&r);
4192:Source/html/document.c **** }
