 773:Source/html/document.c **** static void doc_flush_block(DocState* st) {
 774:Source/html/document.c ****     DocBlock* cb = st->currentBlock;
 775:Source/html/document.c ****     if (cb == NULL) return;
 776:Source/html/document.c ****     st->currentBlock = NULL;
 777:Source/html/document.c ****     if (!(cb->type == DB_PARAGRAPH && cb->nInlines == 0))
 778:Source/html/document.c ****         doc_add_block(st, cb);
 779:Source/html/document.c ****     else
 780:Source/html/document.c ****         db_free(cb);
 781:Source/html/document.c **** }
