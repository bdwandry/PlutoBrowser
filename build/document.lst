 628:src/html/document.c **** static void doc_push_link(DocDocument* doc, const char* href,
 629:src/html/document.c ****                           const char* text, const char* target) {
 630:src/html/document.c ****     DocLink nl;
 631:src/html/document.c ****     memset(&nl, 0, sizeof(nl));
 632:src/html/document.c ****     nl.href = pluto_strdup(href ? href : "");
 633:src/html/document.c ****     nl.text = pluto_strdup(text ? text : "");
 634:src/html/document.c ****     nl.target = pluto_strdup(target ? target : "");
 635:src/html/document.c ****     if (nl.href == NULL || nl.text == NULL || nl.target == NULL) {
 636:src/html/document.c ****         pluto_free(nl.href); pluto_free(nl.text); pluto_free(nl.target);
 637:src/html/document.c ****         return;
 638:src/html/document.c ****     }
 639:src/html/document.c ****     DocLink* arr = pluto_realloc(doc->links,
 640:src/html/document.c ****                                  (doc->nLinks + 1) * sizeof(DocLink));
 641:src/html/document.c ****     if (arr == NULL) {
 642:src/html/document.c ****         pluto_free(nl.href); pluto_free(nl.text); pluto_free(nl.target);
 643:src/html/document.c ****         return;
 644:src/html/document.c ****     }
 645:src/html/document.c ****     doc->links = arr;
 646:src/html/document.c ****     doc->capLinks = doc->nLinks + 1;
 647:src/html/document.c ****     doc->links[doc->nLinks++] = nl;
 648:src/html/document.c **** }
