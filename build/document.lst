1294:src/html/document.c **** static void d_collect_areas(DocState* st, DomNode* n, DocMap* m) {
1295:src/html/document.c ****     for (size_t i = 0; i < n->nChildren; i++) {
1296:src/html/document.c ****         DomNode* c = n->children[i];
1297:src/html/document.c ****         if (c->kind != DOM_ELEMENT) continue;
1298:src/html/document.c ****         if (!strcmp(c->tag, "area")) {
1299:src/html/document.c ****             StrMap* a = c->attrs;
1300:src/html/document.c ****             const char* shape = da_get(a, "shape");
1301:src/html/document.c ****             const char* coordsRaw = da_get(a, "coords");
1302:src/html/document.c ****             const char* alt = da_get(a, "alt");
1303:src/html/document.c **** 
1304:src/html/document.c ****             DocAreaRegion r;
1305:src/html/document.c ****             memset(&r, 0, sizeof(r));
1306:src/html/document.c ****             r.shape = pluto_strdup((shape != NULL && shape[0] != '\0')
1307:src/html/document.c ****                                        ? shape : "rect");
1308:src/html/document.c **** 
1309:src/html/document.c ****             int* carr = NULL;
1310:src/html/document.c ****             size_t cn = 0;
1311:src/html/document.c ****             const char* p = (coordsRaw != NULL) ? coordsRaw : "";
1312:src/html/document.c ****             while (*p != '\0') {
1313:src/html/document.c ****                 while (*p != '\0' && !isdigit((unsigned char)*p)) p++;
1314:src/html/document.c ****                 if (*p == '\0') break;
1315:src/html/document.c ****                 long v = strtol(p, (char**)&p, 10);
1316:src/html/document.c ****                 int* narr = pluto_realloc(carr, (cn + 1) * sizeof(int));
1317:src/html/document.c ****                 if (narr == NULL) break;
1318:src/html/document.c ****                 carr = narr;
1319:src/html/document.c ****                 carr[cn++] = (int)v;
1320:src/html/document.c ****             }
1321:src/html/document.c ****             r.coords = carr;
1322:src/html/document.c ****             r.nCoords = cn;
1323:src/html/document.c **** 
1324:src/html/document.c ****             if (d_valid_href(da_get(a, "href"))) {
1325:src/html/document.c ****                 StrBuf rb;
1326:src/html/document.c ****                 sb_init(&rb);
1327:src/html/document.c ****                 url_resolve(st->baseUrl, da_get(a, "href"), &rb);
1328:src/html/document.c ****                 r.href = sb_detach(&rb);
1329:src/html/document.c ****             }
1330:src/html/document.c ****             r.alt = pluto_strdup((alt != NULL) ? alt : "");
1331:src/html/document.c **** 
1332:src/html/document.c ****             DocAreaRegion* arr = pluto_realloc(
1333:src/html/document.c ****                 m->regions, (m->nRegions + 1) * sizeof(DocAreaRegion));
