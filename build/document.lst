 742:Source/html/document.c **** static int db_push_inline(DocBlock* b, DocInline in) {
 743:Source/html/document.c ****     if (b->nInlines == b->capInlines) {
 744:Source/html/document.c ****         size_t nc = b->capInlines ? b->capInlines * 2 : 8;
 745:Source/html/document.c ****         DocInline* ni = pluto_realloc(b->inlines, nc * sizeof(DocInline));
 746:Source/html/document.c ****         if (ni == NULL) return 0;
 747:Source/html/document.c ****         b->inlines = ni;
 748:Source/html/document.c ****         b->capInlines = nc;
 749:Source/html/document.c ****     }
 750:Source/html/document.c ****     b->inlines[b->nInlines++] = in;
 751:Source/html/document.c ****     return 1;
 752:Source/html/document.c **** }
