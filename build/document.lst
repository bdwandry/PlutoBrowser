 976:Source/html/document.c ****     if (!p)
 977:Source/html/document.c ****     {
 978:Source/html/document.c ****         w->error = 1;
 979:Source/html/document.c ****         return NULL;
 980:Source/html/document.c ****     }
 981:Source/html/document.c ****     memcpy(p, s, n + 1);
 982:Source/html/document.c ****     return p;
 983:Source/html/document.c **** }
