 287:Source/html/document.c **** 
 288:Source/html/document.c **** static void d_concat_into(DomNode* node, StrBuf* sb) {
 289:Source/html/document.c ****     if (node == NULL) return;
 290:Source/html/document.c ****     if (node->kind == DOM_TEXT) {
 291:Source/html/document.c ****         sb_append_str(sb, node->text ? node->text : "");
 292:Source/html/document.c ****     } else if (node->kind == DOM_ELEMENT) {
 293:Source/html/document.c ****         for (size_t i = 0; i < node->nChildren; i++)
 294:Source/html/document.c ****             d_concat_into(node->children[i], sb);
 295:Source/html/document.c ****     }
 296:Source/html/document.c **** }
 297:Source/html/document.c **** 
 298:Source/html/document.c **** static void d_svg_escape_value(const char* v, StrBuf* out) {
 299:Source/html/document.c ****     for (const char* p = v ? v : ""; *p != '\0'; p++) {
 300:Source/html/document.c ****         if (*p == '"') sb_append_str(out, "&quot;");
 301:Source/html/document.c ****         else if (*p == '<') sb_append_str(out, "&lt;");
 302:Source/html/document.c ****         else sb_append_char(out, *p);
 303:Source/html/document.c ****     }
 304:Source/html/document.c **** }
