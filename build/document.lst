 297:src/html/document.c **** static void d_svg_escape_value(const char* v, StrBuf* out) {
 298:src/html/document.c ****     for (const char* p = v ? v : ""; *p != '\0'; p++) {
 299:src/html/document.c ****         if (*p == '"') sb_append_str(out, "&quot;");
 300:src/html/document.c ****         else if (*p == '<') sb_append_str(out, "&lt;");
 301:src/html/document.c ****         else sb_append_char(out, *p);
 302:src/html/document.c ****     }
 303:src/html/document.c **** }
