 536:Source/html/document.c **** static size_t concat_rec(const DomNode *n, char *buf, size_t cap, size_t off)
 537:Source/html/document.c **** {
 538:Source/html/document.c ****     if (!n)
 539:Source/html/document.c ****     {
 540:Source/html/document.c ****         return off;
 541:Source/html/document.c ****     }
 542:Source/html/document.c ****     if (n->kind == DOM_TEXT)
 543:Source/html/document.c ****     {
 544:Source/html/document.c ****         const char *t = n->text ? n->text : "";
 545:Source/html/document.c ****         size_t len = strlen(t);
 546:Source/html/document.c ****         if (off + 1 < cap)
 547:Source/html/document.c ****         {
 548:Source/html/document.c ****             size_t room = cap - off - 1;
 549:Source/html/document.c ****             size_t cn = len < room ? len : room;
 550:Source/html/document.c ****             memcpy(buf + off, t, cn);
 551:Source/html/document.c ****         }
 552:Source/html/document.c ****         return off + len; /* logical offset advances by FULL len; writes clamped */
 553:Source/html/document.c ****     }
 554:Source/html/document.c ****     if (n->kind == DOM_ELEMENT)
 555:Source/html/document.c ****     {
 556:Source/html/document.c ****         for (int i = 0; i < n->childCount; i++)
 557:Source/html/document.c ****         {
 558:Source/html/document.c ****             off = concat_rec(n->children[i], buf, cap, off);
 559:Source/html/document.c ****         }
 560:Source/html/document.c ****     }
 561:Source/html/document.c ****     return off;
 562:Source/html/document.c **** }
 563:Source/html/document.c **** 
 564:Source/html/document.c **** size_t doc_concat_node_text(const DomNode *node, char *buf, size_t cap)
 565:Source/html/document.c **** {
 566:Source/html/document.c ****     size_t need = concat_rec(node, buf, cap, 0);
 567:Source/html/document.c ****     if (cap > 0)
 568:Source/html/document.c ****     {
 569:Source/html/document.c ****         size_t written = need < cap - 1 ? need : cap - 1;
 570:Source/html/document.c ****         buf[written] = '\0';
 571:Source/html/document.c ****     }
 572:Source/html/document.c ****     return need;
 573:Source/html/document.c **** }
