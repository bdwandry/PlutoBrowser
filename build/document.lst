4224:Source/html/document.c **** /* ── base-href validation: ^[a-zA-Z][%w+%-.]*:// ───────────────
4225:Source/html/document.c **** 
4226:Source/html/document.c **** static int d_valid_absolute_url(const char* s) {
4227:Source/html/document.c ****     if (s == NULL) return 0;
4228:Source/html/document.c ****     unsigned char c0 = (unsigned char)s[0];
4229:Source/html/document.c ****     if (!((c0 >= 'a' && c0 <= 'z') || (c0 >= 'A' && c0 <= 'Z'))) return 0;
4230:Source/html/document.c ****     size_t i = 1;
4231:Source/html/document.c ****     while (isalnum((unsigned char)s[i]) || s[i] == '+' || s[i] == '-' ||
4232:Source/html/document.c ****            s[i] == '.')
4233:Source/html/document.c ****         i++;
4234:Source/html/document.c ****     return s[i] == ':' && s[i + 1] == '/' && s[i + 2] == '/';
4235:Source/html/document.c **** }
