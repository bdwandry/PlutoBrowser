3864:Source/html/document.c ****         return;
3865:Source/html/document.c ****     }
3866:Source/html/document.c ****     AttrList a = attrs_of(node);
3867:Source/html/document.c ****     /* hidden/popover/display:none suppress the element AND its subtree */
3868:Source/html/document.c ****     if (walk_display_none(a))
3869:Source/html/document.c ****     {
3870:Source/html/document.c ****         return;
3871:Source/html/document.c ****     }
3872:Source/html/document.c ****     int wasInert = w->inert;
3873:Source/html/document.c ****     if (attr_has(a, "inert"))
