4188:Source/html/document.c ****     int inertHere = da_has(n->attrs, "inert");
4189:Source/html/document.c ****     if (inertHere) st->inert++;
4190:Source/html/document.c ****     d_handle_element(st, n);
4191:Source/html/document.c ****     if (inertHere) st->inert--;
4192:Source/html/document.c **** }
