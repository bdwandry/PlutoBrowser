 906:src/html/document.c **** static void d_split_code_lines(DocBlock* b) {
 907:src/html/document.c ****     const char* p = (b->codeText != NULL) ? b->codeText : "";
 908:src/html/document.c ****     size_t cap = 0;
 909:src/html/document.c ****     const char* seg = p;
 910:src/html/document.c ****     for (;;) {
 911:src/html/document.c ****         if (*p == '\n' || *p == '\0') {
 912:src/html/document.c ****             size_t len = (size_t)(p - seg);
 913:src/html/document.c ****             if (len > 0 && seg[len - 1] == '\r') len--;
 914:src/html/document.c ****             if (b->nLines == cap) {
 915:src/html/document.c ****                 size_t nc = cap ? cap * 2 : 8;
 916:src/html/document.c ****                 char** nl = pluto_realloc(b->lines, nc * sizeof(char*));
 917:src/html/document.c ****                 if (nl == NULL) return;
 918:src/html/document.c ****                 b->lines = nl;
 919:src/html/document.c ****                 cap = nc;
 920:src/html/document.c ****             }
 921:src/html/document.c ****             b->lines[b->nLines++] = pluto_strndup(seg, len);
 922:src/html/document.c ****             if (*p == '\0') break;
 923:src/html/document.c ****             seg = p + 1;
 924:src/html/document.c ****         }
 925:src/html/document.c ****         p++;
 926:src/html/document.c ****     }
 927:src/html/document.c **** }
