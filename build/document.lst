2481:src/html/document.c ****     if (n->kind != DOM_ELEMENT) return;
2482:src/html/document.c ****     if (d_is_display_none(n->attrs)) return;
2483:src/html/document.c ****     int inertHere = da_has(n->attrs, "inert");
2484:src/html/document.c ****     if (inertHere) st->inert++;
2485:src/html/document.c ****     d_handle_element(st, n);
2486:src/html/document.c ****     if (inertHere) st->inert--;
2487:src/html/document.c **** }
