  86:Source/html/document.c **** static void d_parse_style(DStyle* out, const char* styleStr) {
  87:Source/html/document.c ****     memset(out, 0, sizeof(*out));
  88:Source/html/document.c ****     if (styleStr == NULL || styleStr[0] == '\0') return;
  89:Source/html/document.c ****     const char* p = styleStr;
  90:Source/html/document.c ****     while (*p != '\0') {
  91:Source/html/document.c ****         const char* ks = p;
