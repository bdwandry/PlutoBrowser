 123:Source/html/document.c **** void doc_parse_style(const char *styleStr, DocStyle *out)
 124:Source/html/document.c **** {
 125:Source/html/document.c ****     memset(out, 0, sizeof(*out));
 126:Source/html/document.c ****     if (!styleStr || styleStr[0] == '\0')
 127:Source/html/document.c ****     {
 128:Source/html/document.c ****         return;
 129:Source/html/document.c ****     }
 130:Source/html/document.c ****     /* Exact emulation of string.gmatch(styleStr, "([%w%-]+)%s*:%s*([^;]+)"):
 131:Source/html/document.c ****      * the scan is NOT anchored to ';'-segments — it advances one character at
 132:Source/html/document.c ****      * a time and takes the FIRST position where a [%w%-]+ run (optionally
 133:Source/html/document.c ****      * space-separated) hits ':'. The value [^;]+ then consumes to the next
 134:Source/html/document.c ****      * ';' or end. After a match, scanning resumes after the value. A match
 135:Source/html/document.c ****      * with an all-space tail still stores an EMPTY value (Lua "" is truthy
 136:Source/html/document.c ****      * and consumers treat it as set-but-blank). */
 137:Source/html/document.c ****     const char *s = styleStr;
 138:Source/html/document.c ****     size_t n = strlen(s);
 139:Source/html/document.c ****     size_t pos = 0;
 140:Source/html/document.c ****     while (pos < n)
 141:Source/html/document.c ****     {
