 108:Source/html/document.c **** /* Lua %s character class: space, \t, \n, \v, \f, \r. */
 109:Source/html/document.c **** static int is_lspace(char c)
 110:Source/html/document.c **** {
 111:Source/html/document.c ****     return c == ' ' || c == '\t' || c == '\n' || c == '\v' || c == '\f' ||
 112:Source/html/document.c ****            c == '\r';
 113:Source/html/document.c **** }
 114:Source/html/document.c **** 
 115:Source/html/document.c **** static int is_lkey(char c)
 116:Source/html/document.c **** {
 117:Source/html/document.c ****     return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
 118:Source/html/document.c ****            (c >= '0' && c <= '9') || c == '-';
 119:Source/html/document.c **** }
