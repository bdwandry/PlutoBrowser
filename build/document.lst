 939:src/html/document.c **** /* in-place Lua "%s+" -> " " collapse plus end trim */
 940:src/html/document.c **** static void d_collapse_trim(char* s) {
 941:src/html/document.c ****     if (s == NULL) return;
 942:src/html/document.c ****     size_t r = 0, w = 0;
 943:src/html/document.c ****     int inWs = 0;
 944:src/html/document.c ****     while (s[r] != '\0') {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccdDRgGA.s 			page 37


 945:src/html/document.c ****         if (isspace((unsigned char)s[r])) {
 946:src/html/document.c ****             inWs = 1;
 947:src/html/document.c ****             r++;
 948:src/html/document.c ****         } else {
 949:src/html/document.c ****             if (inWs && w > 0) s[w++] = ' ';
 950:src/html/document.c ****             inWs = 0;
 951:src/html/document.c ****             s[w++] = s[r++];
 952:src/html/document.c ****         }
 953:src/html/document.c ****     }
 954:src/html/document.c ****     s[w] = '\0';
 955:src/html/document.c **** }
 956:src/html/document.c **** 
 957:src/html/document.c **** static int d_details_override(const DocState* st, const char* key,
 958:src/html/document.c ****                               int defaultOpen) {
 959:src/html/document.c ****     if (st->opts != NULL && st->opts->detailsOverrides != NULL) {
 960:src/html/document.c ****         for (size_t i = 0; i < st->opts->nOverrides; i++)
 961:src/html/document.c ****             if (strcmp(st->opts->detailsOverrides[i].key, key) == 0)
 962:src/html/document.c ****                 return st->opts->detailsOverrides[i].open ? 1 : 0;
 963:src/html/document.c ****     }
 964:src/html/document.c ****     return defaultOpen;
 965:src/html/document.c **** }
 966:src/html/document.c **** 
 967:src/html/document.c **** /* shared "common" attribute bundle for input-family blocks */
 968:src/html/document.c **** typedef struct {
 969:src/html/document.c ****     char* name;          /* owned */
 970:src/html/document.c ****     char* value;         /* owned */
 971:src/html/document.c ****     unsigned char disabled, readonlyFlag, requiredFlag, inertFlag;
 972:src/html/document.c ****     int maxlength;       /* -1 unset */
 973:src/html/document.c **** } DInputCommon;
 974:src/html/document.c **** 
 975:src/html/document.c **** static void d_input_common(DocState* st, StrMap* attrs, DInputCommon* c) {
 976:src/html/document.c ****     memset(c, 0, sizeof(*c));
 977:src/html/document.c ****     const char* nm = da_get(attrs, "name");
 978:src/html/document.c ****     c->name = pluto_strdup((nm != NULL) ? nm : "q");
 979:src/html/document.c ****     const char* val = da_get(attrs, "value");
 980:src/html/document.c ****     c->value = pluto_strdup((val != NULL) ? val : "");
 981:src/html/document.c ****     int dis = da_has(attrs, "disabled") || st->disabledDepth > 0;
 982:src/html/document.c ****     c->disabled = (unsigned char)dis;
 983:src/html/document.c ****     c->readonlyFlag =
 984:src/html/document.c ****         (unsigned char)(da_has(attrs, "readonly") || dis);
 985:src/html/document.c ****     c->requiredFlag = (unsigned char)da_has(attrs, "required");
