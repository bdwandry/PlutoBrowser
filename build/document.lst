3875:Source/html/document.c ****         /* Lua: wasInert = state.inert; state.inert += 1; walk(node);
3876:Source/html/document.c ****          * state.inert = wasInert — the scope covers the whole subtree, so the
3877:Source/html/document.c ****          * restore must run AFTER the children (exit frame, pushed first). */
3878:Source/html/document.c ****         w->inert++;
3879:Source/html/document.c ****         ExitCtx *x = push_exit(w, WX_INERT_END);
3880:Source/html/document.c ****         if (x)
3881:Source/html/document.c ****         {
3882:Source/html/document.c ****             x->inertSaved = wasInert;
3883:Source/html/document.c ****         }
3884:Source/html/document.c ****     }
3885:Source/html/document.c ****     handle_element(w, node);
3886:Source/html/document.c **** }
