 287:src/html/document.c **** static void d_concat_into(DomNode* node, StrBuf* sb) {
 288:src/html/document.c ****     if (node == NULL) return;
 289:src/html/document.c ****     if (node->kind == DOM_TEXT) {
 290:src/html/document.c ****         sb_append_str(sb, node->text ? node->text : "");
 291:src/html/document.c ****     } else if (node->kind == DOM_ELEMENT) {
 292:src/html/document.c ****         for (size_t i = 0; i < node->nChildren; i++)
 293:src/html/document.c ****             d_concat_into(node->children[i], sb);
 294:src/html/document.c ****     }
 295:src/html/document.c **** }
