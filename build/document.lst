3855:Source/html/document.c **** static void walk_node(Walker *w, const DomNode *node)
3856:Source/html/document.c **** {
3857:Source/html/document.c ****     if (!node)
3858:Source/html/document.c ****     {
3859:Source/html/document.c ****         return;
3860:Source/html/document.c ****     }
3861:Source/html/document.c ****     if (node->kind == DOM_TEXT)
3862:Source/html/document.c ****     {
