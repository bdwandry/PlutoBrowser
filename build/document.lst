 562:src/html/document.c **** static void doc_add_inline_text(DocState* st, const char* raw) {
 563:src/html/document.c ****     if (raw == NULL || raw[0] == '\0') return;
 564:src/html/document.c ****     char* collapsed = NULL;
 565:src/html/document.c ****     const char* text = raw;
 566:src/html/document.c ****     if (!st->inPre) {
 567:src/html/document.c ****         collapsed = pluto_malloc(strlen(raw) * 2 + 2);
 568:src/html/document.c ****         if (collapsed == NULL) return;
 569:src/html/document.c ****         const char* p = raw;
 570:src/html/document.c ****         char* o = collapsed;
 571:src/html/document.c ****         while (*p != '\0') {
 572:src/html/document.c ****             if (*p == '\r' || *p == '\n' || *p == '\t') {
 573:src/html/document.c ****                 *o++ = ' ';
 574:src/html/document.c ****                 while (*p == '\r' || *p == '\n' || *p == '\t') p++;
 575:src/html/document.c ****             } else {
 576:src/html/document.c ****                 *o++ = *p++;
 577:src/html/document.c ****             }
 578:src/html/document.c ****         }
 579:src/html/document.c ****         *o = '\0';
 580:src/html/document.c ****         text = collapsed;
 581:src/html/document.c ****     }
 582:src/html/document.c ****     size_t tl = strlen(text);
 583:src/html/document.c ****     size_t a = 0;
 584:src/html/document.c ****     while (a < tl && isspace((unsigned char)text[a])) a++;
 585:src/html/document.c ****     if (a == tl) {
 586:src/html/document.c ****         pluto_free(collapsed);
 587:src/html/document.c ****         return;
 588:src/html/document.c ****     }
