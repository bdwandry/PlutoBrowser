  93:Source/html/document.c ****         size_t klen = (size_t)(p - ks);
  94:Source/html/document.c ****         const char* q = p;
  95:Source/html/document.c ****         while (*q != '\0' && isspace((unsigned char)*q)) q++;
  96:Source/html/document.c ****         if (klen == 0 || *q != ':') {
  97:Source/html/document.c ****             if (*p == '\0') break;
  98:Source/html/document.c ****             p = (*p == ';') ? p + 1 : q;
  99:Source/html/document.c ****             if (*p == ':') p++;
 100:Source/html/document.c ****             while (*p != '\0' && *p != ';') p++;
 101:Source/html/document.c ****             if (*p == ';') p++;
 102:Source/html/document.c ****             continue;
 103:Source/html/document.c ****         }
 104:Source/html/document.c ****         p = q + 1;
 105:Source/html/document.c ****         while (*p != '\0' && isspace((unsigned char)*p)) p++;
 106:Source/html/document.c ****         const char* vs = p;
 107:Source/html/document.c ****         while (*p != '\0' && *p != ';') p++;
 108:Source/html/document.c ****         size_t vlen = (size_t)(p - vs);
 109:Source/html/document.c ****         if (*p == ';') p++;
 110:Source/html/document.c ****         if (klen == 0 || vlen == 0) continue;
 111:Source/html/document.c **** 
 112:Source/html/document.c ****         char key[40], val[80];
 113:Source/html/document.c ****         if (klen >= sizeof(key)) klen = sizeof(key) - 1;
 114:Source/html/document.c ****         memcpy(key, ks, klen);
 115:Source/html/document.c ****         key[klen] = '\0';
 116:Source/html/document.c ****         for (char* c = key; *c; c++) *c = (char)tolower((unsigned char)*c);
 117:Source/html/document.c ****         if (vlen >= sizeof(val)) vlen = sizeof(val) - 1;
 118:Source/html/document.c ****         memcpy(val, vs, vlen);
 119:Source/html/document.c ****         val[vlen] = '\0';
 120:Source/html/document.c ****         {
 121:Source/html/document.c ****             size_t a = 0, len = vlen;
 122:Source/html/document.c ****             while (a < len && isspace((unsigned char)val[a])) a++;
 123:Source/html/document.c ****             while (len > a && isspace((unsigned char)val[len - 1])) len--;
 124:Source/html/document.c ****             memmove(val, val + a, len - a);
 125:Source/html/document.c ****             val[len - a] = '\0';
 126:Source/html/document.c ****             for (char* c = val; *c; c++) *c = (char)tolower((unsigned char)*c);
 127:Source/html/document.c ****         }
 128:Source/html/document.c **** 
 129:Source/html/document.c ****         int found = 0;
 130:Source/html/document.c ****         for (int i = 0; i < out->n; i++) {
 131:Source/html/document.c ****             if (strcmp(out->e[i].key, key) == 0) {
