 754:Source/html/document.c **** static void doc_add_block(DocState* st, DocBlock* blk) {
 755:Source/html/document.c ****     if (blk != NULL && st->doc->nBlocks < DOC_MAX_BLOCKS) {
 756:Source/html/document.c ****         DocDocument* doc = st->doc;
 757:Source/html/document.c ****         DocBlock* nb = pluto_realloc(doc->blocks,
 758:Source/html/document.c ****                                      (doc->nBlocks + 1) * sizeof(DocBlock));
 759:Source/html/document.c ****         if (nb == NULL) {
 760:Source/html/document.c ****             db_free(blk);
 761:Source/html/document.c ****             return;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccoihWyO.s 			page 19


 762:Source/html/document.c ****         }
 763:Source/html/document.c ****         doc->blocks = nb;
 764:Source/html/document.c ****         doc->capBlocks = doc->nBlocks + 1;
 765:Source/html/document.c ****         doc->blocks[doc->nBlocks++] = *blk;
 766:Source/html/document.c ****         pluto_free(blk);
 767:Source/html/document.c ****         return;
 768:Source/html/document.c ****     }
 769:Source/html/document.c ****     if (blk != NULL) st->truncated = 1;
 770:Source/html/document.c ****     db_free(blk);
 771:Source/html/document.c **** }
