1194:Source/html/document.c **** /* viewBox fallback sizing. The Lua source binds captures #1/#2 (minx/miny)
1195:Source/html/document.c ****  * and uses them as w/h fallbacks — replicate exactly, quirks included:
1196:Source/html/document.c ****  *   vbW, vbH = match("^%s*([num]+)%s+([num]+)%s+[num]+%s+[num]+$")   */
1197:Source/html/document.c **** static void d_parse_viewbox(const char* vb, double* wOut, double* hOut) {
1198:Source/html/document.c ****     *wOut = 0;
1199:Source/html/document.c ****     *hOut = 0;
1200:Source/html/document.c ****     if (vb == NULL) return;
1201:Source/html/document.c ****     int n = 0;
1202:Source/html/document.c ****     double first = 0, second = 0;
1203:Source/html/document.c ****     const char* p = vb;
1204:Source/html/document.c ****     while (*p != '\0' && n < 2) {
1205:Source/html/document.c ****         while (*p != '\0' && isspace((unsigned char)*p)) p++;
1206:Source/html/document.c ****         if (*p == '\0') break;
1207:Source/html/document.c ****         char* end = NULL;
1208:Source/html/document.c ****         double v = strtod(p, &end);
1209:Source/html/document.c ****         if (end == p) { p++; continue; }
1210:Source/html/document.c ****         if (n == 0) first = v;
1211:Source/html/document.c ****         else second = v;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc7xDouQ.s 			page 45


1212:Source/html/document.c ****         n++;
1213:Source/html/document.c ****         p = end;
1214:Source/html/document.c ****     }
1215:Source/html/document.c ****     /* full pattern requires FOUR number groups before it matches */
1216:Source/html/document.c ****     if (n < 2) return;
1217:Source/html/document.c ****     int groups = 2;
1218:Source/html/document.c ****     while (*p != '\0') {
1219:Source/html/document.c ****         while (*p != '\0' && isspace((unsigned char)*p)) p++;
1220:Source/html/document.c ****         if (*p == '\0') break;
1221:Source/html/document.c ****         char* end = NULL;
1222:Source/html/document.c ****         (void)strtod(p, &end);
1223:Source/html/document.c ****         if (end == p) break;
1224:Source/html/document.c ****         groups++;
1225:Source/html/document.c ****         p = end;
1226:Source/html/document.c ****     }
1227:Source/html/document.c ****     if (groups < 4) return;
1228:Source/html/document.c ****     *wOut = first;
1229:Source/html/document.c ****     *hOut = second;
1230:Source/html/document.c **** }
