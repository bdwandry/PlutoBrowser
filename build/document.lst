1290:Source/html/document.c ****  * skip empty / all-whitespace runs; append to linkText inside a link. */
1291:Source/html/document.c **** static void add_inline_text(Walker *w, const char *raw)
1292:Source/html/document.c **** {
1293:Source/html/document.c ****     if (!raw || raw[0] == '\0')
1294:Source/html/document.c ****     {
1295:Source/html/document.c ****         return;
1296:Source/html/document.c ****     }
1297:Source/html/document.c ****     char tmp[512];
1298:Source/html/document.c ****     const char *text = raw;
1299:Source/html/document.c ****     if (!w->inPre)
1300:Source/html/document.c ****     {
1301:Source/html/document.c ****         size_t o = 0;
1302:Source/html/document.c ****         size_t i = 0;
1303:Source/html/document.c ****         while (raw[i] && o + 1 < sizeof(tmp))
1304:Source/html/document.c ****         {
1305:Source/html/document.c ****             if (raw[i] == '\r' || raw[i] == '\n' || raw[i] == '\t')
1306:Source/html/document.c ****             {
1307:Source/html/document.c ****                 tmp[o++] = ' ';
1308:Source/html/document.c ****                 while ((raw[i + 1] == '\r' || raw[i + 1] == '\n' ||
1309:Source/html/document.c ****                         raw[i + 1] == '\t') &&
1310:Source/html/document.c ****                        i + 2 < sizeof(tmp))
1311:Source/html/document.c ****                 {
1312:Source/html/document.c ****                     i++;
1313:Source/html/document.c ****                 }
1314:Source/html/document.c ****             }
1315:Source/html/document.c ****             else
1316:Source/html/document.c ****             {
1317:Source/html/document.c ****                 tmp[o++] = raw[i];
1318:Source/html/document.c ****             }
1319:Source/html/document.c ****             i++;
1320:Source/html/document.c ****         }
1321:Source/html/document.c ****         tmp[o] = '\0';
1322:Source/html/document.c ****         text = tmp;
1323:Source/html/document.c ****     }
1324:Source/html/document.c ****     if (text[0] == '\0')
1325:Source/html/document.c ****     {
1326:Source/html/document.c ****         return;
1327:Source/html/document.c ****     }
1328:Source/html/document.c ****     {
