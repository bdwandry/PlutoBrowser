4180:Source/html/document.c **** static void d_walk(DocState* st, DomNode* n) {
4181:Source/html/document.c ****     tasks_yield_check();
4182:Source/html/document.c ****     if (n->kind == DOM_TEXT) {
4183:Source/html/document.c ****         d_handle_text_node(st, n);
4184:Source/html/document.c ****         return;
4185:Source/html/document.c ****     }
4186:Source/html/document.c ****     if (n->kind != DOM_ELEMENT) return;
