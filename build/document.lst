 166:src/html/document.c **** static int d_is_display_none(StrMap* attrs) {
 167:src/html/document.c ****     if (attrs == NULL) return 0;
 168:src/html/document.c ****     if (da_has(attrs, "hidden")) return 1;
 169:src/html/document.c ****     if (da_has(attrs, "popover")) return 1;
 170:src/html/document.c ****     DStyle st;
 171:src/html/document.c ****     d_parse_style(&st, da_get(attrs, "style"));
 172:src/html/document.c ****     const char* disp = d_style_get(&st, "display");
 173:src/html/document.c ****     if (disp != NULL && strstr(disp, "none") != NULL) return 1;
 174:src/html/document.c ****     const char* vis = d_style_get(&st, "visibility");
 175:src/html/document.c ****     if (vis != NULL && strstr(vis, "hidden") != NULL) return 1;
 176:src/html/document.c ****     return 0;
 177:src/html/document.c **** }
