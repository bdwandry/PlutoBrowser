 765:Source/html/document.c ****         }
 766:Source/html/document.c ****         doc->blocks = nb;
 767:Source/html/document.c ****         doc->capBlocks = doc->nBlocks + 1;
 768:Source/html/document.c ****         doc->blocks[doc->nBlocks++] = *blk;
 769:Source/html/document.c ****         pluto_free(blk);
