1029:src/html/document.c **** /* viewBox fallback sizing. The Lua source binds captures #1/#2 (minx/miny)
1030:src/html/document.c ****  * and uses them as w/h fallbacks — replicate exactly, quirks included:
1031:src/html/document.c ****  *   vbW, vbH = match("^%s*([num]+)%s+([num]+)%s+[num]+%s+[num]+$")   */
1032:src/html/document.c **** static void d_parse_viewbox(const char* vb, double* wOut, double* hOut) {
1033:src/html/document.c ****     *wOut = 0;
1034:src/html/document.c ****     *hOut = 0;
1035:src/html/document.c ****     if (vb == NULL) return;
1036:src/html/document.c ****     int n = 0;
1037:src/html/document.c ****     double first = 0, second = 0;
1038:src/html/document.c ****     const char* p = vb;
1039:src/html/document.c ****     while (*p != '\0' && n < 2) {
1040:src/html/document.c ****         while (*p != '\0' && isspace((unsigned char)*p)) p++;
1041:src/html/document.c ****         if (*p == '\0') break;
1042:src/html/document.c ****         char* end = NULL;
1043:src/html/document.c ****         double v = strtod(p, &end);
1044:src/html/document.c ****         if (end == p) { p++; continue; }
1045:src/html/document.c ****         if (n == 0) first = v;
1046:src/html/document.c ****         else second = v;
1047:src/html/document.c ****         n++;
1048:src/html/document.c ****         p = end;
1049:src/html/document.c ****     }
1050:src/html/document.c ****     /* full pattern requires FOUR number groups before it matches */
1051:src/html/document.c ****     if (n < 2) return;
1052:src/html/document.c ****     int groups = 2;
1053:src/html/document.c ****     while (*p != '\0') {
1054:src/html/document.c ****         while (*p != '\0' && isspace((unsigned char)*p)) p++;
1055:src/html/document.c ****         if (*p == '\0') break;
1056:src/html/document.c ****         char* end = NULL;
1057:src/html/document.c ****         (void)strtod(p, &end);
1058:src/html/document.c ****         if (end == p) break;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccdDRgGA.s 			page 39


1059:src/html/document.c ****         groups++;
1060:src/html/document.c ****         p = end;
1061:src/html/document.c ****     }
1062:src/html/document.c ****     if (groups < 4) return;
1063:src/html/document.c ****     *wOut = first;
1064:src/html/document.c ****     *hOut = second;
1065:src/html/document.c **** }
