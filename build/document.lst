4237:Source/html/document.c **** /* ── entry point ─────────────────────────�
4238:Source/html/document.c **** 
4239:Source/html/document.c **** DocDocument* doc_parse_opts(const char* html, const char* baseUrl, int mode,
4240:Source/html/document.c ****                             const DocParseOpts* opts) {
4241:Source/html/document.c ****     tasks_yield_check();
4242:Source/html/document.c **** 
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccoihWyO.s 			page 340


4243:Source/html/document.c ****     if (html == NULL || html[0] == '\0') {
4244:Source/html/document.c ****         DocDocument* d = pluto_malloc(sizeof(DocDocument));
4245:Source/html/document.c ****         if (d == NULL) return NULL;
4246:Source/html/document.c ****         memset(d, 0, sizeof(*d));
4247:Source/html/document.c ****         d->title = pluto_strdup("Blank Page");
4248:Source/html/document.c ****         d->baseUrl = pluto_strdup((baseUrl != NULL && baseUrl[0]) ? baseUrl
4249:Source/html/document.c ****                                                                   : "about:blank");
4250:Source/html/document.c ****         d->rawHtml = pluto_strdup("");
4251:Source/html/document.c ****         return d;
4252:Source/html/document.c ****     }
4253:Source/html/document.c **** 
4254:Source/html/document.c ****     HttTokens* tokens = htt_tokenize(html, strlen(html));
4255:Source/html/document.c ****     if (tokens == NULL) return NULL;
4256:Source/html/document.c **** 
4257:Source/html/document.c ****     if (mode == PLUTO_MODE_READER) {
4258:Source/html/document.c ****         /* Lua document.lua: pageTitle = extractedTitle or "Web Page";
4259:Source/html/document.c ****          * the reader branch uses the caller baseUrl (no <base> override) */
4260:Source/html/document.c ****         const char* pageTitle = (tokens->pageTitle != NULL)
4261:Source/html/document.c ****                                     ? tokens->pageTitle : "Web Page";
4262:Source/html/document.c ****         DocDocument* rd = readability_distill(tokens, pageTitle,
4263:Source/html/document.c ****                                               (baseUrl != NULL) ? baseUrl : "");
4264:Source/html/document.c ****         htt_free(tokens);
4265:Source/html/document.c ****         if (rd != NULL) rd->rawHtml = pluto_strdup(html);
4266:Source/html/document.c ****         return rd;
