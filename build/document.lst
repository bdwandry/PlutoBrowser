 314:src/html/document.c **** static void d_attr_iter_cb(const char* key, void* value, void* ud) {
 315:src/html/document.c ****     StrBuf* out = (StrBuf*)ud;
 316:src/html/document.c ****     sb_append_char(out, ' ');
 317:src/html/document.c ****     sb_append_str(out, key);
 318:src/html/document.c ****     sb_append_str(out, "=\"");
 319:src/html/document.c ****     d_svg_escape_value((value == HT_ATTR_TRUE) ? "" : (const char*)value, out);
 320:src/html/document.c ****     sb_append_char(out, '"');
 321:src/html/document.c **** }
 322:src/html/document.c **** 
 323:src/html/document.c **** static void d_serialize_svg_into(DomNode* n, StrBuf* out) {
 324:src/html/document.c ****     if (n == NULL) return;
 325:src/html/document.c ****     if (n->kind == DOM_TEXT) {
 326:src/html/document.c ****         size_t encLen = 0;
 327:src/html/document.c ****         char* enc = entities_encode(n->text ? n->text : "",
 328:src/html/document.c ****                                     n->textLen, &encLen);
 329:src/html/document.c ****         if (enc != NULL) {
 330:src/html/document.c ****             sb_append(out, enc, encLen);
 331:src/html/document.c ****             pluto_free(enc);
 332:src/html/document.c ****         }
 333:src/html/document.c ****         return;
 334:src/html/document.c ****     }
 335:src/html/document.c ****     if (n->kind != DOM_ELEMENT) return;
 336:src/html/document.c ****     sb_append_char(out, '<');
 337:src/html/document.c ****     sb_append_str(out, n->tag);
 338:src/html/document.c ****     sm_foreach(n->attrs, d_attr_iter_cb, out);
 339:src/html/document.c ****     if (n->nChildren == 0) {
 340:src/html/document.c ****         sb_append_str(out, "/>");
 341:src/html/document.c ****         return;
 342:src/html/document.c ****     }
 343:src/html/document.c ****     sb_append_char(out, '>');
 344:src/html/document.c ****     for (size_t i = 0; i < n->nChildren; i++)
 345:src/html/document.c ****         d_serialize_svg_into(n->children[i], out);
 346:src/html/document.c ****     sb_append_str(out, "</");
 347:src/html/document.c ****     sb_append_str(out, n->tag);
 348:src/html/document.c ****     sb_append_char(out, '>');
 349:src/html/document.c **** }
