 101:src/html/document.c ****             continue;
 102:src/html/document.c ****         }
 103:src/html/document.c ****         p = q + 1;
 104:src/html/document.c ****         while (*p != '\0' && isspace((unsigned char)*p)) p++;
 105:src/html/document.c ****         const char* vs = p;
 106:src/html/document.c ****         while (*p != '\0' && *p != ';') p++;
 107:src/html/document.c ****         size_t vlen = (size_t)(p - vs);
 108:src/html/document.c ****         if (*p == ';') p++;
 109:src/html/document.c ****         if (klen == 0 || vlen == 0) continue;
 110:src/html/document.c **** 
 111:src/html/document.c ****         char key[40], val[80];
 112:src/html/document.c ****         if (klen >= sizeof(key)) klen = sizeof(key) - 1;
 113:src/html/document.c ****         memcpy(key, ks, klen);
 114:src/html/document.c ****         key[klen] = '\0';
 115:src/html/document.c ****         for (char* c = key; *c; c++) *c = (char)tolower((unsigned char)*c);
 116:src/html/document.c ****         if (vlen >= sizeof(val)) vlen = sizeof(val) - 1;
 117:src/html/document.c ****         memcpy(val, vs, vlen);
 118:src/html/document.c ****         val[vlen] = '\0';
 119:src/html/document.c ****         {
 120:src/html/document.c ****             size_t a = 0, len = vlen;
