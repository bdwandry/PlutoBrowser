 231:Source/html/document.c ****         int haveT = 0, haveB = 0, haveL = 0, haveR = 0;
 232:Source/html/document.c ****         int vT = 0, vB = 0, vL = 0, vR = 0;
 233:Source/html/document.c ****         if (np == 1) {
 234:Source/html/document.c ****             vT = vR = vB = vL = d_css_half(parts[0]);
 235:Source/html/document.c ****             haveT = haveR = haveB = haveL = 1;
 236:Source/html/document.c ****         } else if (np == 2) {
 237:Source/html/document.c ****             vT = vB = d_css_half(parts[0]); haveT = haveB = 1;
 238:Source/html/document.c ****             vR = vL = d_css_half(parts[1]); haveR = haveL = 1;
 239:Source/html/document.c ****         } else if (np == 3) {
 240:Source/html/document.c ****             vT = d_css_half(parts[0]); haveT = 1;
 241:Source/html/document.c ****             vR = vL = d_css_half(parts[1]); haveR = haveL = 1;
 242:Source/html/document.c ****             vB = d_css_half(parts[2]); haveB = 1;
 243:Source/html/document.c ****         } else if (np >= 4) {
 244:Source/html/document.c ****             vT = d_css_half(parts[0]); haveT = 1;
 245:Source/html/document.c ****             vR = d_css_half(parts[1]); haveR = 1;
 246:Source/html/document.c ****             vB = d_css_half(parts[2]); haveB = 1;
 247:Source/html/document.c ****             vL = d_css_half(parts[3]); haveL = 1;
 248:Source/html/document.c ****         }
 249:Source/html/document.c ****         if (haveT) out->top = vT;
 250:Source/html/document.c ****         if (haveB) out->bottom = vB;
 251:Source/html/document.c ****         if (haveL) out->left = vL;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccoihWyO.s 			page 7


 252:Source/html/document.c ****         if (haveR) out->right = vR;
 253:Source/html/document.c ****     } else {
 254:Source/html/document.c ****         const char* mt = d_style_get(&st, "margin-top");
 255:Source/html/document.c ****         if (mt != NULL) out->top = d_css_half(mt);
 256:Source/html/document.c ****         const char* mb = d_style_get(&st, "margin-bottom");
 257:Source/html/document.c ****         if (mb != NULL) out->bottom = d_css_half(mb);
 258:Source/html/document.c ****         const char* ml = d_style_get(&st, "margin-left");
 259:Source/html/document.c ****         if (ml != NULL) out->left = d_css_half(ml);
 260:Source/html/document.c ****         const char* mr = d_style_get(&st, "margin-right");
 261:Source/html/document.c ****         if (mr != NULL) out->right = d_css_half(mr);
 262:Source/html/document.c ****     }
 263:Source/html/document.c **** 
 264:Source/html/document.c ****     const char* pad = d_style_get(&st, "padding");
 265:Source/html/document.c ****     if (pad != NULL) {
 266:Source/html/document.c ****         char parts[8][24];
 267:Source/html/document.c ****         size_t np = d_split_ws_comma(pad, parts, 8);
 268:Source/html/document.c ****         if (np == 1) out->left += d_css_half(parts[0]);
 269:Source/html/document.c ****         else if (np == 2) out->left += d_css_half(parts[1]);
 270:Source/html/document.c ****         else if (np >= 4) out->left += d_css_half(parts[3]);
 271:Source/html/document.c ****     } else {
 272:Source/html/document.c ****         const char* pl = d_style_get(&st, "padding-left");
 273:Source/html/document.c ****         if (pl != NULL) out->left += d_css_half(pl);
 274:Source/html/document.c ****     }
 275:Source/html/document.c **** }
