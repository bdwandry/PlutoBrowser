 202:src/html/document.c **** static size_t d_split_ws_comma(const char* s, char parts[][24], size_t max) {
 203:src/html/document.c ****     size_t n = 0;
 204:src/html/document.c ****     const char* p = s;
 205:src/html/document.c ****     while (*p != '\0' && n < max) {
 206:src/html/document.c ****         while (*p != '\0' && (isspace((unsigned char)*p) || *p == ',')) p++;
