  95:src/html/document.c ****         if (klen == 0 || *q != ':') {
  96:src/html/document.c ****             if (*p == '\0') break;
  97:src/html/document.c ****             p = (*p == ';') ? p + 1 : q;
  98:src/html/document.c ****             if (*p == ':') p++;
