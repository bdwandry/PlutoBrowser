  46:Source/html/document.c **** /* CSS length -> floor(n / 2) after '%' strip; invalid -> 0 */
  47:Source/html/document.c **** 
  48:Source/html/document.c **** static int d_css_half(const char* v) {
  49:Source/html/document.c ****     int ok = 0;
  50:Source/html/document.c ****     double n;
