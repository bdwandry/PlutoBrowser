1459:Source/html/document.c **** static void d_collect_areas(DocState* st, DomNode* n, DocMap* m) {
1460:Source/html/document.c ****     for (size_t i = 0; i < n->nChildren; i++) {
1461:Source/html/document.c ****         DomNode* c = n->children[i];
1462:Source/html/document.c ****         if (c->kind != DOM_ELEMENT) continue;
1463:Source/html/document.c ****         if (!strcmp(c->tag, "area")) {
1464:Source/html/document.c ****             StrMap* a = c->attrs;
1465:Source/html/document.c ****             const char* shape = da_get(a, "shape");
1466:Source/html/document.c ****             const char* coordsRaw = da_get(a, "coords");
1467:Source/html/document.c ****             const char* alt = da_get(a, "alt");
1468:Source/html/document.c **** 
1469:Source/html/document.c ****             DocAreaRegion r;
1470:Source/html/document.c ****             memset(&r, 0, sizeof(r));
1471:Source/html/document.c ****             r.shape = pluto_strdup((shape != NULL && shape[0] != '\0')
1472:Source/html/document.c ****                                        ? shape : "rect");
1473:Source/html/document.c **** 
1474:Source/html/document.c ****             int* carr = NULL;
1475:Source/html/document.c ****             size_t cn = 0;
1476:Source/html/document.c ****             const char* p = (coordsRaw != NULL) ? coordsRaw : "";
1477:Source/html/document.c ****             while (*p != '\0') {
1478:Source/html/document.c ****                 while (*p != '\0' && !isdigit((unsigned char)*p)) p++;
1479:Source/html/document.c ****                 if (*p == '\0') break;
1480:Source/html/document.c ****                 long v = strtol(p, (char**)&p, 10);
1481:Source/html/document.c ****                 int* narr = pluto_realloc(carr, (cn + 1) * sizeof(int));
1482:Source/html/document.c ****                 if (narr == NULL) break;
1483:Source/html/document.c ****                 carr = narr;
1484:Source/html/document.c ****                 carr[cn++] = (int)v;
1485:Source/html/document.c ****             }
1486:Source/html/document.c ****             r.coords = carr;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc7xDouQ.s 			page 52


1487:Source/html/document.c ****             r.nCoords = cn;
1488:Source/html/document.c **** 
1489:Source/html/document.c ****             if (d_valid_href(da_get(a, "href"))) {
1490:Source/html/document.c ****                 StrBuf rb;
1491:Source/html/document.c ****                 sb_init(&rb);
1492:Source/html/document.c ****                 url_resolve(st->baseUrl, da_get(a, "href"), &rb);
1493:Source/html/document.c ****                 r.href = sb_detach(&rb);
1494:Source/html/document.c ****             }
1495:Source/html/document.c ****             r.alt = pluto_strdup((alt != NULL) ? alt : "");
1496:Source/html/document.c **** 
1497:Source/html/document.c ****             DocAreaRegion* arr = pluto_realloc(
1498:Source/html/document.c ****                 m->regions, (m->nRegions + 1) * sizeof(DocAreaRegion));
1499:Source/html/document.c ****             if (arr == NULL) {
1500:Source/html/document.c ****                 pluto_free(r.shape);
1501:Source/html/document.c ****                 pluto_free(r.coords);
1502:Source/html/document.c ****                 pluto_free(r.href);
1503:Source/html/document.c ****                 pluto_free(r.alt);
1504:Source/html/document.c ****                 return;
1505:Source/html/document.c ****             }
1506:Source/html/document.c ****             m->regions = arr;
1507:Source/html/document.c ****             m->capRegions = m->nRegions + 1;
1508:Source/html/document.c ****             m->regions[m->nRegions++] = r;
1509:Source/html/document.c ****         }
1510:Source/html/document.c ****         /* direct children only — matches the source collector */
1511:Source/html/document.c ****     }
