1182:src/html/document.c **** static void d_walk_children(DocState* st, DomNode* node) {
1183:src/html/document.c ****     for (size_t i = 0; i < node->nChildren; i++)
1184:src/html/document.c ****         d_walk(st, node->children[i]);
1185:src/html/document.c **** }
1186:src/html/document.c **** 
1187:src/html/document.c **** static void d_walk(DocState* st, DomNode* n) {
1188:src/html/document.c ****     tasks_yield_check();
1189:src/html/document.c ****     if (n->kind == DOM_TEXT) {
1190:src/html/document.c ****         d_handle_text_node(st, n);
1191:src/html/document.c ****         return;
1192:src/html/document.c ****     }
1193:src/html/document.c ****     if (n->kind != DOM_ELEMENT) return;
1194:src/html/document.c ****     if (d_is_display_none(n->attrs)) return;
1195:src/html/document.c ****     int inertHere = da_has(n->attrs, "aria-hidden");
1196:src/html/document.c ****     if (inertHere) st->inert++;
1197:src/html/document.c ****     d_handle_element(st, n);
1198:src/html/document.c ****     if (inertHere) st->inert--;
1199:src/html/document.c **** }
