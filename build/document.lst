 763:src/html/document.c **** static void d_split_code_lines(DocBlock* b) {
 764:src/html/document.c ****     const char* p = (b->codeText != NULL) ? b->codeText : "";
 765:src/html/document.c ****     size_t cap = 0;
 766:src/html/document.c ****     const char* seg = p;
 767:src/html/document.c ****     for (;;) {
 768:src/html/document.c ****         if (*p == '\n' || *p == '\0') {
 769:src/html/document.c ****             size_t len = (size_t)(p - seg);
 770:src/html/document.c ****             if (len > 0 && seg[len - 1] == '\r') len--;
 771:src/html/document.c ****             if (b->nLines == cap) {
 772:src/html/document.c ****                 size_t nc = cap ? cap * 2 : 8;
 773:src/html/document.c ****                 char** nl = pluto_realloc(b->lines, nc * sizeof(char*));
 774:src/html/document.c ****                 if (nl == NULL) return;
 775:src/html/document.c ****                 b->lines = nl;
 776:src/html/document.c ****                 cap = nc;
 777:src/html/document.c ****             }
 778:src/html/document.c ****             b->lines[b->nLines++] = pluto_strndup(seg, len);
 779:src/html/document.c ****             if (*p == '\0') break;
 780:src/html/document.c ****             seg = p + 1;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccJOur1O.s 			page 70


 781:src/html/document.c ****         }
 782:src/html/document.c ****         p++;
 783:src/html/document.c ****     }
 784:src/html/document.c **** }
