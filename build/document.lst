1229:Source/html/document.c **** /* mfenced attribute: entity-decoded with default; returns owned string */
1230:Source/html/document.c **** static char* d_mfenced_attr(StrMap* attrs, const char* key,
1231:Source/html/document.c ****                             const char* dflt) {
1232:Source/html/document.c ****     const char* raw = da_get(attrs, key);
1233:Source/html/document.c ****     if (raw == NULL || raw[0] == '\0') raw = dflt;
1234:Source/html/document.c ****     size_t outLen = 0;
1235:Source/html/document.c ****     char* dec = entities_decode(raw, strlen(raw), &outLen);
1236:Source/html/document.c ****     if (dec != NULL) {
1237:Source/html/document.c ****         dec[outLen] = '\0';
1238:Source/html/document.c ****         return dec;
1239:Source/html/document.c ****     }
1240:Source/html/document.c ****     return pluto_strdup(dflt);
1241:Source/html/document.c **** }
