1072:Source/html/document.c ****     const char* p = (b->codeText != NULL) ? b->codeText : "";
1073:Source/html/document.c ****     size_t cap = 0;
1074:Source/html/document.c ****     const char* seg = p;
1075:Source/html/document.c ****     for (;;) {
1076:Source/html/document.c ****         if (*p == '\n' || *p == '\0') {
1077:Source/html/document.c ****             size_t len = (size_t)(p - seg);
1078:Source/html/document.c ****             if (len > 0 && seg[len - 1] == '\r') len--;
1079:Source/html/document.c ****             if (b->nLines == cap) {
1080:Source/html/document.c ****                 size_t nc = cap ? cap * 2 : 8;
1081:Source/html/document.c ****                 char** nl = pluto_realloc(b->lines, nc * sizeof(char*));
1082:Source/html/document.c ****                 if (nl == NULL) return;
1083:Source/html/document.c ****                 b->lines = nl;
1084:Source/html/document.c ****                 cap = nc;
1085:Source/html/document.c ****             }
1086:Source/html/document.c ****             b->lines[b->nLines++] = pluto_strndup(seg, len);
1087:Source/html/document.c ****             if (*p == '\0') break;
1088:Source/html/document.c ****             seg = p + 1;
1089:Source/html/document.c ****         }
1090:Source/html/document.c ****         p++;
1091:Source/html/document.c ****     }
1092:Source/html/document.c **** }
