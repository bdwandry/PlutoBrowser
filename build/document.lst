 201:src/html/document.c **** static size_t d_split_ws_comma(const char* s, char parts[][24], size_t max) {
 202:src/html/document.c ****     size_t n = 0;
 203:src/html/document.c ****     const char* p = s;
 204:src/html/document.c ****     while (*p != '\0' && n < max) {
 205:src/html/document.c ****         while (*p != '\0' && (isspace((unsigned char)*p) || *p == ',')) p++;
 206:src/html/document.c ****         if (*p == '\0') break;
 207:src/html/document.c ****         size_t len = 0;
 208:src/html/document.c ****         while (p[len] != '\0' &&
 209:src/html/document.c ****                !(isspace((unsigned char)p[len]) || p[len] == ','))
 210:src/html/document.c ****             len++;
 211:src/html/document.c ****         if (len > 23) len = 23;
 212:src/html/document.c ****         memcpy(parts[n], p, len);
 213:src/html/document.c ****         parts[n][len] = '\0';
 214:src/html/document.c ****         n++;
 215:src/html/document.c ****         p += len;
 216:src/html/document.c ****     }
 217:src/html/document.c ****     return n;
 218:src/html/document.c **** }
