4194:Source/html/document.c **** static void d_finalize(DocState* st, int scannedHas, double scannedDelay,
4195:Source/html/document.c ****                        char* scannedUrl) {
4196:Source/html/document.c ****     DocDocument* doc = st->doc;
4197:Source/html/document.c ****     doc_flush_block(st);
4198:Source/html/document.c **** 
4199:Source/html/document.c ****     if (st->truncated)
4200:Source/html/document.c ****         d_push_notice(st, "(Page too large - rest not rendered)", 0);
4201:Source/html/document.c **** 
4202:Source/html/document.c ****     if (doc->nBlocks == 0)
4203:Source/html/document.c ****         d_push_notice(st, "(Empty Web Page)", 1);
4204:Source/html/document.c **** 
4205:Source/html/document.c ****     if (st->hasMetaRefresh) {
4206:Source/html/document.c ****         doc->hasMetaRefresh = 1;
4207:Source/html/document.c ****         doc->metaDelay = st->metaDelay;
4208:Source/html/document.c ****         doc->metaUrl = d_resolve_meta_url(doc->baseUrl, st->metaUrl);
4209:Source/html/document.c ****         pluto_free(st->metaUrl);
4210:Source/html/document.c ****         st->metaUrl = NULL;
4211:Source/html/document.c ****         pluto_free(scannedUrl);
4212:Source/html/document.c ****     } else if (scannedHas) {
4213:Source/html/document.c ****         doc->hasMetaRefresh = 1;
4214:Source/html/document.c ****         doc->metaDelay = scannedDelay;
4215:Source/html/document.c ****         doc->metaUrl = d_resolve_meta_url(doc->baseUrl, scannedUrl);
4216:Source/html/document.c ****         pluto_free(scannedUrl);
4217:Source/html/document.c ****     } else {
4218:Source/html/document.c ****         pluto_free(scannedUrl);
4219:Source/html/document.c ****     }
4220:Source/html/document.c ****     pluto_free(st->metaUrl);
4221:Source/html/document.c ****     st->metaUrl = NULL;
4222:Source/html/document.c **** }
