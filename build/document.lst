  53:src/html/document.c ****     size_t j = 0;
  54:src/html/document.c ****     for (size_t i = 0; v[i] != '\0' && j + 1 < sizeof(buf); i++)
  55:src/html/document.c ****         if (v[i] != '%') buf[j++] = v[i];
  56:src/html/document.c ****     buf[j] = '\0';
  57:src/html/document.c ****     n = d_tonum(buf, &ok);
  58:src/html/document.c ****     if (!ok) return 0;
  59:src/html/document.c ****     return (int)floor(n / 2.0);
  60:src/html/document.c **** }
