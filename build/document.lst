  46:src/html/document.c **** /* CSS length -> floor(n / 2) after '%' strip; invalid -> 0 */
  47:src/html/document.c **** 
  48:src/html/document.c **** static int d_css_half(const char* v) {
  49:src/html/document.c ****     int ok = 0;
  50:src/html/document.c ****     double n;
