 209:src/html/document.c ****         while (p[len] != '\0' &&
 210:src/html/document.c ****                !(isspace((unsigned char)p[len]) || p[len] == ','))
 211:src/html/document.c ****             len++;
 212:src/html/document.c ****         if (len > 23) len = 23;
 213:src/html/document.c ****         memcpy(parts[n], p, len);
 214:src/html/document.c ****         parts[n][len] = '\0';
 215:src/html/document.c ****         n++;
 216:src/html/document.c ****         p += len;
 217:src/html/document.c ****     }
 218:src/html/document.c ****     return n;
 219:src/html/document.c **** }
