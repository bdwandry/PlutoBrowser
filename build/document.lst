 152:src/html/document.c **** static const char* d_parse_align(StrMap* attrs) {
 153:src/html/document.c ****     if (attrs == NULL) return NULL;
 154:src/html/document.c ****     const char* a = da_get(attrs, "align");
 155:src/html/document.c ****     DStyle st;
 156:src/html/document.c ****     d_parse_style(&st, da_get(attrs, "style"));
 157:src/html/document.c ****     const char* ta = d_style_get(&st, "text-align");
 158:src/html/document.c ****     if (ta != NULL) a = ta;
 159:src/html/document.c ****     if (a == NULL) return NULL;
 160:src/html/document.c ****     if (strcasecmp(a, "center") == 0) return "center";
 161:src/html/document.c ****     if (strcasecmp(a, "right") == 0) return "right";
 162:src/html/document.c ****     if (strcasecmp(a, "left") == 0) return "left";
 163:src/html/document.c ****     return NULL;
 164:src/html/document.c **** }
