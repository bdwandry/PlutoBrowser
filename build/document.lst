1383:src/html/document.c ****         DocBlock* b = d_new_block(DB_HEADING);
1384:src/html/document.c ****         if (b == NULL) return;
1385:src/html/document.c ****         b->level = tag[1] - '0';
1386:src/html/document.c ****         b->spacingTop = sp.top;
