 107:src/html/document.c ****         while (*p != '\0' && *p != ';') p++;
 108:src/html/document.c ****         size_t vlen = (size_t)(p - vs);
 109:src/html/document.c ****         if (*p == ';') p++;
 110:src/html/document.c ****         if (klen == 0 || vlen == 0) continue;
 111:src/html/document.c **** 
 112:src/html/document.c ****         char key[40], val[80];
 113:src/html/document.c ****         if (klen >= sizeof(key)) klen = sizeof(key) - 1;
