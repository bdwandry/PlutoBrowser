2563:src/html/document.c ****            s[i] == '.')
2564:src/html/document.c ****         i++;
2565:src/html/document.c ****     return s[i] == ':' && s[i + 1] == '/' && s[i + 2] == '/';
2566:src/html/document.c **** }
