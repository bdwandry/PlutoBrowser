 231:src/html/document.c ****         int haveT = 0, haveB = 0, haveL = 0, haveR = 0;
 232:src/html/document.c ****         int vT = 0, vB = 0, vL = 0, vR = 0;
 233:src/html/document.c ****         if (np == 1) {
 234:src/html/document.c ****             vT = vR = vB = vL = d_css_half(parts[0]);
 235:src/html/document.c ****             haveT = haveR = haveB = haveL = 1;
 236:src/html/document.c ****         } else if (np == 2) {
 237:src/html/document.c ****             vT = vB = d_css_half(parts[0]); haveT = haveB = 1;
 238:src/html/document.c ****             vR = vL = d_css_half(parts[1]); haveR = haveL = 1;
 239:src/html/document.c ****         } else if (np == 3) {
 240:src/html/document.c ****             vT = d_css_half(parts[0]); haveT = 1;
 241:src/html/document.c ****             vR = vL = d_css_half(parts[1]); haveR = haveL = 1;
 242:src/html/document.c ****             vB = d_css_half(parts[2]); haveB = 1;
 243:src/html/document.c ****         } else if (np >= 4) {
 244:src/html/document.c ****             vT = d_css_half(parts[0]); haveT = 1;
 245:src/html/document.c ****             vR = d_css_half(parts[1]); haveR = 1;
 246:src/html/document.c ****             vB = d_css_half(parts[2]); haveB = 1;
 247:src/html/document.c ****             vL = d_css_half(parts[3]); haveL = 1;
 248:src/html/document.c ****         }
 249:src/html/document.c ****         if (haveT) out->top = vT;
 250:src/html/document.c ****         if (haveB) out->bottom = vB;
 251:src/html/document.c ****         if (haveL) out->left = vL;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccD8FGXv.s 			page 7


 252:src/html/document.c ****         if (haveR) out->right = vR;
 253:src/html/document.c ****     } else {
 254:src/html/document.c ****         const char* mt = d_style_get(&st, "margin-top");
 255:src/html/document.c ****         if (mt != NULL) out->top = d_css_half(mt);
 256:src/html/document.c ****         const char* mb = d_style_get(&st, "margin-bottom");
 257:src/html/document.c ****         if (mb != NULL) out->bottom = d_css_half(mb);
 258:src/html/document.c ****         const char* ml = d_style_get(&st, "margin-left");
 259:src/html/document.c ****         if (ml != NULL) out->left = d_css_half(ml);
 260:src/html/document.c ****         const char* mr = d_style_get(&st, "margin-right");
 261:src/html/document.c ****         if (mr != NULL) out->right = d_css_half(mr);
 262:src/html/document.c ****     }
 263:src/html/document.c **** 
 264:src/html/document.c ****     const char* pad = d_style_get(&st, "padding");
 265:src/html/document.c ****     if (pad != NULL) {
 266:src/html/document.c ****         char parts[8][24];
 267:src/html/document.c ****         size_t np = d_split_ws_comma(pad, parts, 8);
 268:src/html/document.c ****         if (np == 1) out->left += d_css_half(parts[0]);
 269:src/html/document.c ****         else if (np == 2) out->left += d_css_half(parts[1]);
 270:src/html/document.c ****         else if (np >= 4) out->left += d_css_half(parts[3]);
 271:src/html/document.c ****     } else {
 272:src/html/document.c ****         const char* pl = d_style_get(&st, "padding-left");
 273:src/html/document.c ****         if (pl != NULL) out->left += d_css_half(pl);
 274:src/html/document.c ****     }
