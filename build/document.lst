1104:Source/html/document.c **** /* Push an exit frame with the given kind; returns ctx (NULL on OOM). */
1105:Source/html/document.c **** static ExitCtx *push_exit(Walker *w, int kind)
1106:Source/html/document.c **** {
1107:Source/html/document.c ****     ExitCtx *x = (ExitCtx *)doc_arena_alloc(&w->arena, sizeof(ExitCtx));
1108:Source/html/document.c ****     WFrame f;
1109:Source/html/document.c ****     if (!x)
1110:Source/html/document.c ****     {
1111:Source/html/document.c ****         w->error = 1;
1112:Source/html/document.c ****         return NULL;
1113:Source/html/document.c ****     }
1114:Source/html/document.c ****     memset(x, 0, sizeof(*x));
1115:Source/html/document.c ****     x->kind = kind;
1116:Source/html/document.c ****     f.kind = 1;
1117:Source/html/document.c ****     f.node = NULL;
1118:Source/html/document.c ****     f.ctx = x;
1119:Source/html/document.c ****     f.sep = NULL;
1120:Source/html/document.c ****     if (frame_push(w, f))
1121:Source/html/document.c ****     {
1122:Source/html/document.c ****         return NULL;
1123:Source/html/document.c ****     }
1124:Source/html/document.c ****     return x;
1125:Source/html/document.c **** }
