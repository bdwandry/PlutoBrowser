 885:src/html/document.c **** static void d_break_inline(DocState* st, int type) {
 886:src/html/document.c ****     DocInline in;
 887:src/html/document.c ****     memset(&in, 0, sizeof(in));
 888:src/html/document.c ****     in.type = type;
 889:src/html/document.c ****     in.bold = st->f.bold;
 890:src/html/document.c ****     in.italic = st->f.italic;
 891:src/html/document.c ****     in.underline = st->f.underline || (st->currentHref != NULL);
 892:src/html/document.c ****     in.code = st->f.code;
 893:src/html/document.c ****     in.small = st->f.small;
 894:src/html/document.c ****     in.big = st->f.big;
 895:src/html/document.c ****     in.sub = st->f.sub;
 896:src/html/document.c ****     in.sup = st->f.sup;
 897:src/html/document.c ****     in.mark = st->f.mark;
 898:src/html/document.c ****     in.strike = st->f.strike;
 899:src/html/document.c ****     in.invert = st->f.invert;
 900:src/html/document.c ****     in.inert = st->inert > 0;
 901:src/html/document.c ****     in.anchorIndex = st->currentAnchorIndex;
 902:src/html/document.c ****     if (st->currentHref != NULL) in.href = pluto_strdup(st->currentHref);
 903:src/html/document.c ****     doc_add_inline(st, &in);
 904:src/html/document.c **** }
