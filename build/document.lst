1033:src/html/document.c **** /* viewBox fallback sizing. The Lua source binds captures #1/#2 (minx/miny)
1034:src/html/document.c ****  * and uses them as w/h fallbacks — replicate exactly, quirks included:
1035:src/html/document.c ****  *   vbW, vbH = match("^%s*([num]+)%s+([num]+)%s+[num]+%s+[num]+$")   */
1036:src/html/document.c **** static void d_parse_viewbox(const char* vb, double* wOut, double* hOut) {
1037:src/html/document.c ****     *wOut = 0;
1038:src/html/document.c ****     *hOut = 0;
1039:src/html/document.c ****     if (vb == NULL) return;
1040:src/html/document.c ****     int n = 0;
1041:src/html/document.c ****     double first = 0, second = 0;
1042:src/html/document.c ****     const char* p = vb;
1043:src/html/document.c ****     while (*p != '\0' && n < 2) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccD8FGXv.s 			page 39


1044:src/html/document.c ****         while (*p != '\0' && isspace((unsigned char)*p)) p++;
1045:src/html/document.c ****         if (*p == '\0') break;
1046:src/html/document.c ****         char* end = NULL;
1047:src/html/document.c ****         double v = strtod(p, &end);
1048:src/html/document.c ****         if (end == p) { p++; continue; }
1049:src/html/document.c ****         if (n == 0) first = v;
1050:src/html/document.c ****         else second = v;
1051:src/html/document.c ****         n++;
1052:src/html/document.c ****         p = end;
1053:src/html/document.c ****     }
1054:src/html/document.c ****     /* full pattern requires FOUR number groups before it matches */
1055:src/html/document.c ****     if (n < 2) return;
1056:src/html/document.c ****     int groups = 2;
1057:src/html/document.c ****     while (*p != '\0') {
1058:src/html/document.c ****         while (*p != '\0' && isspace((unsigned char)*p)) p++;
1059:src/html/document.c ****         if (*p == '\0') break;
1060:src/html/document.c ****         char* end = NULL;
1061:src/html/document.c ****         (void)strtod(p, &end);
1062:src/html/document.c ****         if (end == p) break;
1063:src/html/document.c ****         groups++;
1064:src/html/document.c ****         p = end;
1065:src/html/document.c ****     }
1066:src/html/document.c ****     if (groups < 4) return;
1067:src/html/document.c ****     *wOut = first;
1068:src/html/document.c ****     *hOut = second;
1069:src/html/document.c **** }
