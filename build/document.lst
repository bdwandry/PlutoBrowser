1387:src/html/document.c ****         b->spacingBottom = sp.bottom;
1388:src/html/document.c ****         b->align = d_parse_align(attrs);
1389:src/html/document.c ****         b->indent = sp.left;
1390:src/html/document.c ****         if (d_is_inverted_style(attrs)) b->invert = 1;
1391:src/html/document.c ****         st->currentBlock = b;
1392:src/html/document.c ****         d_walk_children(st, n);
1393:src/html/document.c ****         doc_flush_block(st);
1394:src/html/document.c ****         return;
1395:src/html/document.c ****     }
1396:src/html/document.c **** 
1397:src/html/document.c ****     if (!strcmp(tag, "br")) { d_break_inline(st, DIT_BR); return; }
