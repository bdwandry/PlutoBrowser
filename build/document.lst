 403:Source/html/document.c ****     {
 404:Source/html/document.c ****         return 0;
 405:Source/html/document.c ****     }
 406:Source/html/document.c ****     return (int)floor(d / 2.0); /* math.floor(n / 2) — true floor */
 407:Source/html/document.c **** }
