 409:Source/html/document.c **** /* Split value on spaces/commas (Lua "[^%s,]+"), max 4 parts. */
 410:Source/html/document.c **** static int split_parts(const char *v, char parts[4][32])
 411:Source/html/document.c **** {
 412:Source/html/document.c ****     int n = 0;
 413:Source/html/document.c ****     const char *p = v;
 414:Source/html/document.c ****     while (*p && n < 4)
 415:Source/html/document.c ****     {
 416:Source/html/document.c ****         while (*p == ' ' || *p == '\t' || *p == ',' || *p == '\n' || *p == '\r')
 417:Source/html/document.c ****         {
 418:Source/html/document.c ****             p++;
 419:Source/html/document.c ****         }
 420:Source/html/document.c ****         if (!*p)
 421:Source/html/document.c ****         {
 422:Source/html/document.c ****             break;
 423:Source/html/document.c ****         }
 424:Source/html/document.c ****         size_t len = 0;
 425:Source/html/document.c ****         while (p[len] && p[len] != ' ' && p[len] != '\t' && p[len] != ',' &&
 426:Source/html/document.c ****                p[len] != '\n' && p[len] != '\r')
 427:Source/html/document.c ****         {
 428:Source/html/document.c ****             len++;
 429:Source/html/document.c ****         }
 430:Source/html/document.c ****         size_t cn = len < 31 ? len : 31;
 431:Source/html/document.c ****         memcpy(parts[n], p, cn);
 432:Source/html/document.c ****         parts[n][cn] = '\0';
 433:Source/html/document.c ****         n++;
 434:Source/html/document.c ****         p += len;
 435:Source/html/document.c ****     }
 436:Source/html/document.c ****     return n;
 437:Source/html/document.c **** }
