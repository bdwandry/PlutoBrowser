 208:Source/html/document.c ****         size_t len = 0;
 209:Source/html/document.c ****         while (p[len] != '\0' &&
 210:Source/html/document.c ****                !(isspace((unsigned char)p[len]) || p[len] == ','))
 211:Source/html/document.c ****             len++;
 212:Source/html/document.c ****         if (len > 23) len = 23;
 213:Source/html/document.c ****         memcpy(parts[n], p, len);
 214:Source/html/document.c ****         parts[n][len] = '\0';
 215:Source/html/document.c ****         n++;
 216:Source/html/document.c ****         p += len;
 217:Source/html/document.c ****     }
 218:Source/html/document.c ****     return n;
 219:Source/html/document.c **** }
