 786:src/html/document.c **** static void d_handle_element(DocState* st, DomNode* n) {
 787:src/html/document.c ****     const char* tag = n->tag;
 788:src/html/document.c ****     StrMap* attrs = n->attrs;
 789:src/html/document.c **** 
 790:src/html/document.c ****     /* metadata containers never render */
 791:src/html/document.c ****     if (!strcmp(tag, "script") || !strcmp(tag, "style") ||
 792:src/html/document.c ****         !strcmp(tag, "title"))
 793:src/html/document.c ****         return;
 794:src/html/document.c **** 
