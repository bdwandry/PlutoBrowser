 179:src/html/document.c **** static int d_is_inverted_style(StrMap* attrs) {
 180:src/html/document.c ****     if (attrs == NULL) return 0;
 181:src/html/document.c ****     DStyle st;
 182:src/html/document.c ****     d_parse_style(&st, da_get(attrs, "style"));
 183:src/html/document.c ****     const char* c = d_style_get(&st, "color");
 184:src/html/document.c ****     const char* bg = d_style_get(&st, "background-color");
 185:src/html/document.c ****     if (bg == NULL) bg = d_style_get(&st, "background");
 186:src/html/document.c ****     if (c != NULL && (strstr(c, "white") != NULL ||
 187:src/html/document.c ****                       strstr(c, "#fff") != NULL || strstr(c, "#FFFF") != NULL))
 188:src/html/document.c ****         return 1;
 189:src/html/document.c ****     if (bg != NULL && (strstr(bg, "black") != NULL ||
 190:src/html/document.c ****                        strstr(bg, "#000") != NULL))
 191:src/html/document.c ****         return 1;
 192:src/html/document.c ****     return 0;
 193:src/html/document.c **** }
