 255:Source/render/decoders/jpeg.c **** 
 256:Source/render/decoders/jpeg.c **** /* Two-pass separable fixed-point IDCT (verbatim algorithm). */
 257:Source/render/decoders/jpeg.c **** /* 64-bit accumulators throughout: the Lua reference computes in doubles and
 258:Source/render/decoders/jpeg.c ****  * intermediate sums (dequantized coefficients x 4096-scale basis, two passes)
 259:Source/render/decoders/jpeg.c ****  * overflow int32 — the exact bug the battery caught. Final spatial values
 260:Source/render/decoders/jpeg.c ****  * final spatial samples (pixel 255 -> (255-128)*4*4096*4096 ~ 8.5e9) do NOT
 261:Source/render/decoders/jpeg.c ****  * fit int32 either — the Lua reference holds them in doubles. So the output
 262:Source/render/decoders/jpeg.c ****  * is int64 as well and the caller divides + rounds in 64-bit. */
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cczP6QcW.s 			page 26


 263:Source/render/decoders/jpeg.c **** static void jpeg_idct2d(int64_t *block, int64_t *tmp)
 264:Source/render/decoders/jpeg.c **** {
 265:Source/render/decoders/jpeg.c ****     for (int r = 0; r < 8; r++)
 266:Source/render/decoders/jpeg.c ****     {
 267:Source/render/decoders/jpeg.c ****         int off = r * 8;
 268:Source/render/decoders/jpeg.c ****         for (int n = 0; n < 8; n++)
 269:Source/render/decoders/jpeg.c ****         {
 270:Source/render/decoders/jpeg.c ****             int64_t s = 0;
 271:Source/render/decoders/jpeg.c ****             for (int k = 0; k < 8; k++)
 272:Source/render/decoders/jpeg.c ****             {
 273:Source/render/decoders/jpeg.c ****                 s += (int64_t)block[off + k] * JPEG_IDCT_T[k * 8 + n];
 274:Source/render/decoders/jpeg.c ****             }
 275:Source/render/decoders/jpeg.c ****             tmp[off + n] = s;
 276:Source/render/decoders/jpeg.c ****         }
 277:Source/render/decoders/jpeg.c ****     }
 278:Source/render/decoders/jpeg.c ****     for (int c = 0; c < 8; c++)
 279:Source/render/decoders/jpeg.c ****     {
 280:Source/render/decoders/jpeg.c ****         for (int n = 0; n < 8; n++)
 281:Source/render/decoders/jpeg.c ****         {
 282:Source/render/decoders/jpeg.c ****             int64_t s = 0;
 283:Source/render/decoders/jpeg.c ****             for (int k = 0; k < 8; k++)
 284:Source/render/decoders/jpeg.c ****             {
 285:Source/render/decoders/jpeg.c ****                 s += tmp[k * 8 + c] * JPEG_IDCT_T[k * 8 + n];
 286:Source/render/decoders/jpeg.c ****             }
 287:Source/render/decoders/jpeg.c ****             block[n * 8 + c] = s;
 288:Source/render/decoders/jpeg.c ****         }
 289:Source/render/decoders/jpeg.c ****     }
 290:Source/render/decoders/jpeg.c **** }
