 331:Source/render/decoders/jpeg.c **** static int decode_baseline(const uint8_t* data, size_t len, size_t pos,
 332:Source/render/decoders/jpeg.c ****                            const JFrame* f, const JScan* sc,
 333:Source/render/decoders/jpeg.c ****                            JHuff* const* dcTables, JHuff* const* acTables,
 334:Source/render/decoders/jpeg.c ****                            int* const* qt,
 335:Source/render/decoders/jpeg.c ****                            int restartInterval, int maxW, int maxH,
 336:Source/render/decoders/jpeg.c ****                            ScaleAccum** outAcc, size_t* outPos) {
