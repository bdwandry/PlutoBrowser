 305:Source/render/decoders/jpeg.c **** /* ── AC coefficients (natural order, dequantized) ──────────────�
 306:Source/render/decoders/jpeg.c **** /* Returns 1 ok, 0 end-of-scan (marker/EOB-exhausted) — the Lua boolean. */
 307:Source/render/decoders/jpeg.c **** static int jpeg_decode_ac(JpegReader *r, const JpegHuff *tbl, int64_t *block, const uint16_t *qt)
 308:Source/render/decoders/jpeg.c **** {
 309:Source/render/decoders/jpeg.c ****     int k = 1; /* zigzag position, 1..63 (Lua k) */
 310:Source/render/decoders/jpeg.c ****     while (k <= 63)
 311:Source/render/decoders/jpeg.c ****     {
 312:Source/render/decoders/jpeg.c ****         int s = jpeg_decode_symbol(r, tbl);
 313:Source/render/decoders/jpeg.c ****         if (s < 0)
 314:Source/render/decoders/jpeg.c ****         {
 315:Source/render/decoders/jpeg.c ****             return 0;
 316:Source/render/decoders/jpeg.c ****         }
 317:Source/render/decoders/jpeg.c ****         int run = s >> 4;
 318:Source/render/decoders/jpeg.c ****         int cs = s & 15;
 319:Source/render/decoders/jpeg.c ****         if (cs == 0)
