 195:Source/render/decoders/jpeg.c **** /* Progressive state: persists across scans within one decode call.
 196:Source/render/decoders/jpeg.c ****  * Keys are 1-based component indices (0 unused), so all arrays span [256]. */
 197:Source/render/decoders/jpeg.c **** typedef struct {
 198:Source/render/decoders/jpeg.c ****     long long dcPred[256];   /* keyed by frame comp index */
 199:Source/render/decoders/jpeg.c ****     long long* blockDC[256];
 200:Source/render/decoders/jpeg.c ****     int cap[256];
 201:Source/render/decoders/jpeg.c ****     long long blkIdx[256];
 202:Source/render/decoders/jpeg.c **** } JPState;
 203:Source/render/decoders/jpeg.c **** 
 204:Source/render/decoders/jpeg.c **** static void jpstate_reset(JFrame* f, JPState* st) {
 205:Source/render/decoders/jpeg.c ****     int sMaxH = 1, sMaxV = 1;
 206:Source/render/decoders/jpeg.c ****     for (int i = 0; i < f->ncomp; i++) {
 207:Source/render/decoders/jpeg.c ****         if (f->comps[i].h > sMaxH) sMaxH = f->comps[i].h;
 208:Source/render/decoders/jpeg.c ****         if (f->comps[i].v > sMaxV) sMaxV = f->comps[i].v;
 209:Source/render/decoders/jpeg.c ****     }
 210:Source/render/decoders/jpeg.c ****     int bw = sMaxH * 8, bh = sMaxV * 8;
 211:Source/render/decoders/jpeg.c ****     long long mcuColsF = (f->width + bw - 1) / bw; if (mcuColsF < 1) mcuColsF = 1;
 212:Source/render/decoders/jpeg.c ****     long long mcuRowsF = (f->height + bh - 1) / bh; if (mcuRowsF < 1) mcuRowsF = 1;
 213:Source/render/decoders/jpeg.c ****     for (int c = 1; c < 256; c++) {
 214:Source/render/decoders/jpeg.c ****         st->dcPred[c] = 0;
 215:Source/render/decoders/jpeg.c ****         st->blkIdx[c] = 0;
 216:Source/render/decoders/jpeg.c ****     }
 217:Source/render/decoders/jpeg.c ****     for (int i = 1; i <= f->ncomp && i < 256; i++) {
 218:Source/render/decoders/jpeg.c ****         if (st->blockDC[i]) pluto_free(st->blockDC[i]);
 219:Source/render/decoders/jpeg.c ****         st->blockDC[i] = NULL;
 220:Source/render/decoders/jpeg.c ****         long long cap = mcuColsF * f->comps[i - 1].h * mcuRowsF * f->comps[i - 1].v;
 221:Source/render/decoders/jpeg.c ****         if (cap < 1) cap = 1;
 222:Source/render/decoders/jpeg.c ****         st->cap[i] = (cap > 0x7FFFFFF0LL) ? 0x7FFFFFF0 : (int)cap;
 223:Source/render/decoders/jpeg.c ****         st->blockDC[i] = (long long*)pluto_calloc((size_t)st->cap[i], sizeof(long long));
 224:Source/render/decoders/jpeg.c ****         if (st->blockDC[i] == NULL) st->cap[i] = 0;
 225:Source/render/decoders/jpeg.c ****     }
 226:Source/render/decoders/jpeg.c ****     for (int i = f->ncomp + 1; i < 256; i++) {
 227:Source/render/decoders/jpeg.c ****         if (st->blockDC[i]) pluto_free(st->blockDC[i]);
 228:Source/render/decoders/jpeg.c ****         st->blockDC[i] = NULL;
 229:Source/render/decoders/jpeg.c ****         st->cap[i] = 0;
 230:Source/render/decoders/jpeg.c ****     }
 231:Source/render/decoders/jpeg.c **** }
 232:Source/render/decoders/jpeg.c **** 
 233:Source/render/decoders/jpeg.c **** static void jpstate_free(JPState* st) {
 234:Source/render/decoders/jpeg.c ****     for (int i = 0; i < 256; i++) {
 235:Source/render/decoders/jpeg.c ****         if (st->blockDC[i]) pluto_free(st->blockDC[i]);
 236:Source/render/decoders/jpeg.c ****         st->blockDC[i] = NULL;
 237:Source/render/decoders/jpeg.c ****         st->cap[i] = 0;
 238:Source/render/decoders/jpeg.c ****     }
 239:Source/render/decoders/jpeg.c **** }
 240:Source/render/decoders/jpeg.c **** 
 241:Source/render/decoders/jpeg.c **** static long long* jp_block_slot(JPState* st, int c, long long idx) {
 242:Source/render/decoders/jpeg.c ****     if (c < 1 || c > 255) return NULL;
 243:Source/render/decoders/jpeg.c ****     if (idx < 0 || idx >= st->cap[c]) return NULL;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccfnwQdQ.s 			page 17


 244:Source/render/decoders/jpeg.c ****     return &st->blockDC[c][idx];
 245:Source/render/decoders/jpeg.c **** }
