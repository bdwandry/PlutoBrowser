 247:Source/render/decoders/jpeg.c **** /* Lazy row buffer over the source canvas (rows calloc'd zero-filled where
 248:Source/render/decoders/jpeg.c ****  * Lua left untouched cells as nil). */
 249:Source/render/decoders/jpeg.c **** static uint8_t** rowbuf_new(int h) {
 250:Source/render/decoders/jpeg.c ****     return (uint8_t**)pluto_calloc((size_t)(h > 0 ? h : 1), sizeof(uint8_t*));
 251:Source/render/decoders/jpeg.c **** }
 252:Source/render/decoders/jpeg.c **** 
 253:Source/render/decoders/jpeg.c **** static void rowbuf_put(uint8_t** rb, int width, int h,
 254:Source/render/decoders/jpeg.c ****                        int x, int y, uint8_t g) {
 255:Source/render/decoders/jpeg.c ****     /* Lua wrote into a sparse canvas: off-canvas cells were silently
 256:Source/render/decoders/jpeg.c ****      * dropped. MCU padding blocks land past height/width, so clip here. */
 257:Source/render/decoders/jpeg.c ****     if (x < 0 || y < 0 || x >= width || y >= h || !rb) return;
 258:Source/render/decoders/jpeg.c ****     if (!rb[y]) rb[y] = (uint8_t*)pluto_calloc((size_t)width, 1);
 259:Source/render/decoders/jpeg.c ****     if (rb[y]) rb[y][x] = g;
 260:Source/render/decoders/jpeg.c **** }
 261:Source/render/decoders/jpeg.c **** 
 262:Source/render/decoders/jpeg.c **** static void rowbuf_fill_block(uint8_t** rb, int width, int h,
 263:Source/render/decoders/jpeg.c ****                               int px, int py, uint8_t g) {
 264:Source/render/decoders/jpeg.c ****     for (int ri = 0; ri < 8; ri++)
 265:Source/render/decoders/jpeg.c ****         for (int cx = 0; cx < 8; cx++)
 266:Source/render/decoders/jpeg.c ****             rowbuf_put(rb, width, h, px + cx, py + ri, g);
 267:Source/render/decoders/jpeg.c **** }
 268:Source/render/decoders/jpeg.c **** 
 269:Source/render/decoders/jpeg.c **** static void rowbuf_free(uint8_t** rb, int h) {
 270:Source/render/decoders/jpeg.c ****     if (!rb) return;
 271:Source/render/decoders/jpeg.c ****     for (int y = 0; y < h; y++) pluto_free(rb[y]);
 272:Source/render/decoders/jpeg.c ****     pluto_free(rb);
 273:Source/render/decoders/jpeg.c **** }
