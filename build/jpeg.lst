 522:Source/render/decoders/jpeg.c **** static ScaleAccum* render_progressive_dc(const JFrame* f, JPState* st,
 523:Source/render/decoders/jpeg.c ****                                          int maxW, int maxH, int* const* qt) {
 524:Source/render/decoders/jpeg.c ****     int yc = 1;   /* luma assumed first component */
 525:Source/render/decoders/jpeg.c **** 
 526:Source/render/decoders/jpeg.c ****     int sMaxH = 1, sMaxV = 1;
 527:Source/render/decoders/jpeg.c ****     for (int i = 0; i < f->ncomp; i++) {
 528:Source/render/decoders/jpeg.c ****         if (f->comps[i].h > sMaxH) sMaxH = f->comps[i].h;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccfnwQdQ.s 			page 22


 529:Source/render/decoders/jpeg.c ****         if (f->comps[i].v > sMaxV) sMaxV = f->comps[i].v;
 530:Source/render/decoders/jpeg.c ****     }
 531:Source/render/decoders/jpeg.c ****     int bw = sMaxH * 8, bh = sMaxV * 8;
 532:Source/render/decoders/jpeg.c ****     int mcuCols = (f->width + bw - 1) / bw; if (mcuCols < 1) mcuCols = 1;
 533:Source/render/decoders/jpeg.c ****     int mcuRows = (f->height + bh - 1) / bh; if (mcuRows < 1) mcuRows = 1;
 534:Source/render/decoders/jpeg.c **** 
 535:Source/render/decoders/jpeg.c ****     ScaleAccum* acc = scale_accum_new(f->width, f->height, maxW, maxH);
 536:Source/render/decoders/jpeg.c ****     if (!acc) return NULL;
 537:Source/render/decoders/jpeg.c ****     uint8_t** rowBuf = rowbuf_new(f->height);
 538:Source/render/decoders/jpeg.c **** 
 539:Source/render/decoders/jpeg.c ****     const JComp* yfc = &f->comps[yc - 1];
 540:Source/render/decoders/jpeg.c ****     const int* qtz = qt[yfc->qt];
 541:Source/render/decoders/jpeg.c ****     long long qdc = qtz ? qtz[0] : 1;
 542:Source/render/decoders/jpeg.c ****     long long idx = 0;
 543:Source/render/decoders/jpeg.c **** 
 544:Source/render/decoders/jpeg.c ****     for (int mcuY = 0; mcuY < mcuRows; mcuY++) {
 545:Source/render/decoders/jpeg.c ****         tasks_yield_check();
 546:Source/render/decoders/jpeg.c ****         for (int mcuX = 0; mcuX < mcuCols; mcuX++) {
 547:Source/render/decoders/jpeg.c ****             for (int bj = 0; bj < yfc->v; bj++) {
 548:Source/render/decoders/jpeg.c ****                 for (int bi = 0; bi < yfc->h; bi++) {
 549:Source/render/decoders/jpeg.c ****                     tasks_yield_check();
 550:Source/render/decoders/jpeg.c ****                     long long dc = 0;
 551:Source/render/decoders/jpeg.c ****                     long long* slot = jp_block_slot(st, yc, idx);
 552:Source/render/decoders/jpeg.c ****                     if (slot) dc = *slot;
 553:Source/render/decoders/jpeg.c ****                     idx++;
 554:Source/render/decoders/jpeg.c ****                     int px = mcuX * sMaxH * 8 + bi * 8;
 555:Source/render/decoders/jpeg.c ****                     int py = mcuY * sMaxV * 8 + bj * 8;
 556:Source/render/decoders/jpeg.c ****                     int g = clamp255ll(
 557:Source/render/decoders/jpeg.c ****                         (long long)floor((double)dc * (double)qdc / 8.0 + 0.5) + 128);
 558:Source/render/decoders/jpeg.c ****                     rowbuf_fill_block(rowBuf, f->width, f->height, px, py, (uint8_t)g);
 559:Source/render/decoders/jpeg.c ****                 }
 560:Source/render/decoders/jpeg.c ****             }
 561:Source/render/decoders/jpeg.c ****         }
 562:Source/render/decoders/jpeg.c ****         int base = mcuY * sMaxV * 8;
 563:Source/render/decoders/jpeg.c ****         for (int ri = 0; ri < sMaxV * 8; ri++) {
 564:Source/render/decoders/jpeg.c ****             int y = base + ri;
 565:Source/render/decoders/jpeg.c ****             if (y < f->height) scale_accum_add_row(acc, rowBuf[y]);
 566:Source/render/decoders/jpeg.c ****         }
 567:Source/render/decoders/jpeg.c ****     }
 568:Source/render/decoders/jpeg.c **** 
 569:Source/render/decoders/jpeg.c ****     rowbuf_free(rowBuf, f->height);
 570:Source/render/decoders/jpeg.c ****     return acc;
