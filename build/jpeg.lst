 350:Source/render/decoders/jpeg.c ****     int mcuRows = (f->height + bh - 1) / bh; if (mcuRows < 1) mcuRows = 1;
 351:Source/render/decoders/jpeg.c **** 
 352:Source/render/decoders/jpeg.c ****     ScaleAccum* acc = scale_accum_new(f->width, f->height, maxW, maxH);
 353:Source/render/decoders/jpeg.c ****     if (!acc) { *outPos = pos; return 0; }
 354:Source/render/decoders/jpeg.c ****     uint8_t** rowBuf = rowbuf_new(f->height);
 355:Source/render/decoders/jpeg.c **** 
 356:Source/render/decoders/jpeg.c ****     int boxW = 1, boxH = 1, twIgn = 0, thIgn = 0;
