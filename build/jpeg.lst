 394:Source/render/decoders/jpeg.c ****     {
 395:Source/render/decoders/jpeg.c ****         return 1;
 396:Source/render/decoders/jpeg.c ****     }
 397:Source/render/decoders/jpeg.c ****     int newCap = st->blockDCcap[c] ? st->blockDCcap[c] : 256;
 398:Source/render/decoders/jpeg.c ****     while (newCap < n)
 399:Source/render/decoders/jpeg.c ****     {
 400:Source/render/decoders/jpeg.c ****         newCap *= 2;
 401:Source/render/decoders/jpeg.c ****     }
 402:Source/render/decoders/jpeg.c ****     int64_t *p = (int64_t *)PLUTO_MALLOC(sizeof(int64_t) * (size_t)newCap);
 403:Source/render/decoders/jpeg.c ****     if (!p)
 404:Source/render/decoders/jpeg.c ****     {
 405:Source/render/decoders/jpeg.c ****         return 0;
 406:Source/render/decoders/jpeg.c ****     }
 407:Source/render/decoders/jpeg.c ****     memset(p, 0, sizeof(int64_t) * (size_t)newCap);
 408:Source/render/decoders/jpeg.c ****     if (st->blockDC[c])
 409:Source/render/decoders/jpeg.c ****     {
 410:Source/render/decoders/jpeg.c ****         memcpy(p, st->blockDC[c], sizeof(int64_t) * (size_t)st->blockDCcap[c]);
 411:Source/render/decoders/jpeg.c ****         PLUTO_FREE(st->blockDC[c]);
 412:Source/render/decoders/jpeg.c ****     }
 413:Source/render/decoders/jpeg.c ****     st->blockDC[c] = p;
 414:Source/render/decoders/jpeg.c ****     st->blockDCcap[c] = newCap;
 415:Source/render/decoders/jpeg.c ****     return 1;
 416:Source/render/decoders/jpeg.c **** }
