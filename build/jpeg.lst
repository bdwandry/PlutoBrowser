 299:Source/render/decoders/jpeg.c **** static int decode_ac(JReader* rd, const JHuff* tbl, long long block[64],
 300:Source/render/decoders/jpeg.c ****                      const int* qt) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccfnwQdQ.s 			page 18


 301:Source/render/decoders/jpeg.c ****     tasks_yield_check();
 302:Source/render/decoders/jpeg.c ****     int k = 1;
 303:Source/render/decoders/jpeg.c ****     while (k <= 63) {
 304:Source/render/decoders/jpeg.c ****         int s = decode_symbol(rd, tbl);
 305:Source/render/decoders/jpeg.c ****         if (s == JPEG_NIL) return 0;
 306:Source/render/decoders/jpeg.c ****         int rr = s >> 4, cs = s & 15;
 307:Source/render/decoders/jpeg.c ****         if (cs == 0) {
 308:Source/render/decoders/jpeg.c ****             if (rr == 15) { k += 16; continue; }  /* ZRL */
 309:Source/render/decoders/jpeg.c ****             return 1;                             /* EOB */
 310:Source/render/decoders/jpeg.c ****         }
 311:Source/render/decoders/jpeg.c ****         k += rr;
 312:Source/render/decoders/jpeg.c ****         if (k > 63) return 1;                     /* overrun quirk: no bits consumed */
 313:Source/render/decoders/jpeg.c ****         int v = jr_read_bits(rd, cs);
 314:Source/render/decoders/jpeg.c ****         if (v == JPEG_NIL) return 0;
 315:Source/render/decoders/jpeg.c ****         block[kZigzag[k]] = (long long)jpg_extend(v, cs) * qt[k];
 316:Source/render/decoders/jpeg.c ****         k += 1;
 317:Source/render/decoders/jpeg.c ****     }
 318:Source/render/decoders/jpeg.c ****     return 1;
 319:Source/render/decoders/jpeg.c **** }
