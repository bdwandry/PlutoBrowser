  50:Source/render/decoders/jpeg.c **** static void ensure_tables(void) {
  51:Source/render/decoders/jpeg.c ****     if (g_tablesReady) return;
  52:Source/render/decoders/jpeg.c ****     const double c0 = 0.707106781186548;
  53:Source/render/decoders/jpeg.c ****     for (int k = 0; k < 8; k++) {
  54:Source/render/decoders/jpeg.c ****         double c = (k == 0) ? c0 : 1.0;
  55:Source/render/decoders/jpeg.c ****         for (int n = 0; n < 8; n++) {
  56:Source/render/decoders/jpeg.c ****             double v = 4096.0 * c * cos((2 * n + 1) * k * M_PI / 16);
  57:Source/render/decoders/jpeg.c ****             g_idctT[k * 8 + n] = (long long)floor(v + 0.5);
  58:Source/render/decoders/jpeg.c ****         }
  59:Source/render/decoders/jpeg.c ****     }
  60:Source/render/decoders/jpeg.c ****     g_tablesReady = 1;
