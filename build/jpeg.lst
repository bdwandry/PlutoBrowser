   1:Source/render/decoders/jpeg.c **** // jpeg.c — C port of Source/render/decoders/jpeg.lua (JPEGDecoder).
   2:Source/render/decoders/jpeg.c **** //
   3:Source/render/decoders/jpeg.c **** // Baseline SOF0: full luma-only 8x8 IDCT decode; chroma coefficients are
   4:Source/render/decoders/jpeg.c **** // consumed for bitstream sync but never upsampled (the Lua original only
   5:Source/render/decoders/jpeg.c **** // renders Y). When the box filter is coarse (>=4x) or the source area is
   6:Source/render/decoders/jpeg.c **** // large, blocks render as their DC value only (AC still consumed for
   7:Source/render/decoders/jpeg.c **** // sync). Progressive SOF2 files are decoded from their DC scans alone;
   8:Source/render/decoders/jpeg.c **** // AC scans trigger rendering of what is available. Arithmetic coding
   9:Source/render/decoders/jpeg.c **** // (SOF9/10/11) is unsupported. Restart markers are consumed by the bit
  10:Source/render/decoders/jpeg.c **** // reader and returned as-is into the stream (faithful quirk). The decode
  11:Source/render/decoders/jpeg.c **** // loop yields cooperatively via tasks_yield_check().
  12:Source/render/decoders/jpeg.c **** 
