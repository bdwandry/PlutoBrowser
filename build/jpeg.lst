 339:Source/render/decoders/jpeg.c **** 
 340:Source/render/decoders/jpeg.c ****     int sMaxH = 1, sMaxV = 1;
 341:Source/render/decoders/jpeg.c ****     for (int ci = 1; ci <= ns; ci++) {
 342:Source/render/decoders/jpeg.c ****         const JComp* fc = &f->comps[sc->ci[ci] - 1];
 343:Source/render/decoders/jpeg.c ****         if (fc->h > sMaxH) sMaxH = fc->h;
 344:Source/render/decoders/jpeg.c ****         if (fc->v > sMaxV) sMaxV = fc->v;
 345:Source/render/decoders/jpeg.c ****     }
