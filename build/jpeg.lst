 126:Source/render/decoders/jpeg.c **** 
 127:Source/render/decoders/jpeg.c **** static JHuff* build_huff(const int counts[17], const uint8_t* values, int total) {
 128:Source/render/decoders/jpeg.c ****     JHuff* t = (JHuff*)pluto_malloc(sizeof(JHuff));
 129:Source/render/decoders/jpeg.c ****     if (!t) return NULL;
 130:Source/render/decoders/jpeg.c ****     memset(t, 0, sizeof(*t));
 131:Source/render/decoders/jpeg.c ****     int code = 0, k = 1;
 132:Source/render/decoders/jpeg.c ****     for (int l = 1; l <= 16; l++) {
 133:Source/render/decoders/jpeg.c ****         t->valptr[l] = k;
 134:Source/render/decoders/jpeg.c ****         t->mincode[l] = code;
 135:Source/render/decoders/jpeg.c ****         int c = counts[l];
 136:Source/render/decoders/jpeg.c ****         t->maxcode[l] = (c == 0) ? (-1) : (code + c - 1);
 137:Source/render/decoders/jpeg.c ****         k += c;
 138:Source/render/decoders/jpeg.c ****         code = (code + c) << 1;
 139:Source/render/decoders/jpeg.c ****     }
 140:Source/render/decoders/jpeg.c ****     t->nValues = total;
 141:Source/render/decoders/jpeg.c ****     memcpy(t->values, values, (size_t)(total > 256 ? 256 : total));
 142:Source/render/decoders/jpeg.c ****     return t;
 143:Source/render/decoders/jpeg.c **** }
