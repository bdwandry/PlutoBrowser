 160:Source/render/decoders/jpeg.c **** static int jpg_extend(int v, int s) {
 161:Source/render/decoders/jpeg.c ****     if (s == 0) return 0;
 162:Source/render/decoders/jpeg.c ****     return (v < (1 << (s - 1))) ? (v - (1 << s) + 1) : v;
 163:Source/render/decoders/jpeg.c **** }
 164:Source/render/decoders/jpeg.c **** 
 165:Source/render/decoders/jpeg.c **** static void idct2d(long long b[64]) {
 166:Source/render/decoders/jpeg.c ****     long long tmp[64];
 167:Source/render/decoders/jpeg.c ****     for (int rr = 0; rr < 8; rr++)
 168:Source/render/decoders/jpeg.c ****         for (int n = 0; n < 8; n++) {
 169:Source/render/decoders/jpeg.c ****             long long s = 0;
 170:Source/render/decoders/jpeg.c ****             for (int k = 0; k < 8; k++) s += b[rr * 8 + k] * g_idctT[k * 8 + n];
 171:Source/render/decoders/jpeg.c ****             tmp[rr * 8 + n] = s;
 172:Source/render/decoders/jpeg.c ****         }
 173:Source/render/decoders/jpeg.c ****     for (int c = 0; c < 8; c++)
 174:Source/render/decoders/jpeg.c ****         for (int n = 0; n < 8; n++) {
 175:Source/render/decoders/jpeg.c ****             long long s = 0;
 176:Source/render/decoders/jpeg.c ****             for (int k = 0; k < 8; k++) s += tmp[k * 8 + c] * g_idctT[k * 8 + n];
 177:Source/render/decoders/jpeg.c ****             b[n * 8 + c] = s;
 178:Source/render/decoders/jpeg.c ****         }
 179:Source/render/decoders/jpeg.c **** }
