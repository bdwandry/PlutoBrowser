 121:Source/render/decoders/jpeg.c **** typedef struct {
 122:Source/render/decoders/jpeg.c ****     int mincode[17], maxcode[17], valptr[17]; /* levels 1..16 */
 123:Source/render/decoders/jpeg.c ****     uint8_t values[256];
