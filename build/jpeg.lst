 188:Source/render/decoders/jpeg.c **** typedef struct {
 189:Source/render/decoders/jpeg.c ****     int ns;
 190:Source/render/decoders/jpeg.c ****     int ci[256];      /* frame component indices (1-based), fallback = scan pos */
 191:Source/render/decoders/jpeg.c ****     int dcSel[256], acSel[256];
