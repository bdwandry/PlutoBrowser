 320:Source/render/decoders/jpeg.c ****         {
 321:Source/render/decoders/jpeg.c ****             if (run == 15)
 322:Source/render/decoders/jpeg.c ****             {
 323:Source/render/decoders/jpeg.c ****                 k += 16; /* ZRL */
 324:Source/render/decoders/jpeg.c ****             }
 325:Source/render/decoders/jpeg.c ****             else
 326:Source/render/decoders/jpeg.c ****             {
 327:Source/render/decoders/jpeg.c ****                 return 1; /* EOB */
 328:Source/render/decoders/jpeg.c ****             }
 329:Source/render/decoders/jpeg.c ****         }
 330:Source/render/decoders/jpeg.c ****         else
 331:Source/render/decoders/jpeg.c ****         {
 332:Source/render/decoders/jpeg.c ****             k += run;
 333:Source/render/decoders/jpeg.c ****             if (k > 63)
 334:Source/render/decoders/jpeg.c ****             {
 335:Source/render/decoders/jpeg.c ****                 return 1;
 336:Source/render/decoders/jpeg.c ****             }
 337:Source/render/decoders/jpeg.c ****             int v = jpeg_rd_bits(r, cs);
 338:Source/render/decoders/jpeg.c ****             if (v < 0)
 339:Source/render/decoders/jpeg.c ****             {
 340:Source/render/decoders/jpeg.c ****                 return 0;
 341:Source/render/decoders/jpeg.c ****             }
 342:Source/render/decoders/jpeg.c ****             block[JPEG_ZIGZAG[k]] = (int64_t)jpeg_extend(v, cs) * qt[k + 1];
 343:Source/render/decoders/jpeg.c ****             k += 1;
 344:Source/render/decoders/jpeg.c ****         }
 345:Source/render/decoders/jpeg.c ****     }
 346:Source/render/decoders/jpeg.c ****     return 1;
 347:Source/render/decoders/jpeg.c **** }
