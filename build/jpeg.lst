 443:Source/render/decoders/jpeg.c **** static int decode_progressive_dc(const uint8_t* data, size_t len, size_t pos,
 444:Source/render/decoders/jpeg.c ****                                  const JFrame* f, const JScan* sc,
 445:Source/render/decoders/jpeg.c ****                                  JHuff* const* dcTables,
 446:Source/render/decoders/jpeg.c ****                                  int restartInterval, JPState* st,
 447:Source/render/decoders/jpeg.c ****                                  size_t* outPos) {
 448:Source/render/decoders/jpeg.c ****     int ns = sc->ns;
 449:Source/render/decoders/jpeg.c **** 
 450:Source/render/decoders/jpeg.c ****     int maxHf = 1, maxVf = 1;
 451:Source/render/decoders/jpeg.c ****     for (int i = 0; i < f->ncomp; i++) {
 452:Source/render/decoders/jpeg.c ****         if (f->comps[i].h > maxHf) maxHf = f->comps[i].h;
 453:Source/render/decoders/jpeg.c ****         if (f->comps[i].v > maxVf) maxVf = f->comps[i].v;
 454:Source/render/decoders/jpeg.c ****     }
 455:Source/render/decoders/jpeg.c ****     int bw = maxHf * 8, bh = maxVf * 8;
 456:Source/render/decoders/jpeg.c ****     int mcuColsF = (f->width + bw - 1) / bw; if (mcuColsF < 1) mcuColsF = 1;
 457:Source/render/decoders/jpeg.c ****     int mcuRowsF = (f->height + bh - 1) / bh; if (mcuRowsF < 1) mcuRowsF = 1;
 458:Source/render/decoders/jpeg.c **** 
 459:Source/render/decoders/jpeg.c ****     int mcuCols, mcuRows;
 460:Source/render/decoders/jpeg.c ****     if (ns == 1) {
 461:Source/render/decoders/jpeg.c ****         const JComp* fc = &f->comps[sc->ci[1] - 1];
 462:Source/render/decoders/jpeg.c ****         mcuCols = mcuColsF * fc->h;
 463:Source/render/decoders/jpeg.c ****         mcuRows = mcuRowsF * fc->v;
 464:Source/render/decoders/jpeg.c ****     } else {
 465:Source/render/decoders/jpeg.c ****         mcuCols = mcuColsF;
 466:Source/render/decoders/jpeg.c ****         mcuRows = mcuRowsF;
 467:Source/render/decoders/jpeg.c ****     }
 468:Source/render/decoders/jpeg.c **** 
 469:Source/render/decoders/jpeg.c ****     JReader rd = { data, len, pos, 0, 0 };
 470:Source/render/decoders/jpeg.c ****     int refinement = (sc->ah != 0);
 471:Source/render/decoders/jpeg.c ****     long long mcuIndex = 0;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccfnwQdQ.s 			page 21


 472:Source/render/decoders/jpeg.c ****     int ended = 0;
 473:Source/render/decoders/jpeg.c **** 
 474:Source/render/decoders/jpeg.c ****     for (int mcuY = 0; mcuY < mcuRows && !ended; mcuY++) {
 475:Source/render/decoders/jpeg.c ****         tasks_yield_check();
 476:Source/render/decoders/jpeg.c ****         for (int mcuX = 0; mcuX < mcuCols && !ended; mcuX++) {
 477:Source/render/decoders/jpeg.c ****             if (restartInterval > 0 && mcuIndex > 0 &&
 478:Source/render/decoders/jpeg.c ****                 (mcuIndex % restartInterval) == 0) {
 479:Source/render/decoders/jpeg.c ****                 if (!jr_expect_restart(&rd, (int)(mcuIndex % 8))) {
 480:Source/render/decoders/jpeg.c ****                     ended = 1;
 481:Source/render/decoders/jpeg.c ****                     break;
 482:Source/render/decoders/jpeg.c ****                 }
 483:Source/render/decoders/jpeg.c ****                 for (int i = 1; i <= ns; i++)
 484:Source/render/decoders/jpeg.c ****                     st->dcPred[sc->ci[i]] = 0;
 485:Source/render/decoders/jpeg.c ****             }
 486:Source/render/decoders/jpeg.c **** 
 487:Source/render/decoders/jpeg.c ****             for (int cix = 1; cix <= ns && !ended; cix++) {
 488:Source/render/decoders/jpeg.c ****                 int c = sc->ci[cix];
 489:Source/render/decoders/jpeg.c ****                 const JHuff* dcTbl = dcTables[sc->dcSel[cix]];
 490:Source/render/decoders/jpeg.c ****                 int blocks = (ns == 1) ? 1
 491:Source/render/decoders/jpeg.c ****                     : f->comps[c - 1].h * f->comps[c - 1].v;
 492:Source/render/decoders/jpeg.c ****                 for (int bi = 0; bi < blocks && !ended; bi++) {
 493:Source/render/decoders/jpeg.c ****                     tasks_yield_check();
 494:Source/render/decoders/jpeg.c ****                     long long idx = st->blkIdx[c];
 495:Source/render/decoders/jpeg.c ****                     st->blkIdx[c] = idx + 1;
 496:Source/render/decoders/jpeg.c ****                     long long* slot = jp_block_slot(st, c, idx);
 497:Source/render/decoders/jpeg.c ****                     if (refinement) {
 498:Source/render/decoders/jpeg.c ****                         int bit = jr_read_bits(&rd, 1);
 499:Source/render/decoders/jpeg.c ****                         if (bit == JPEG_NIL) { ended = 1; break; }
 500:Source/render/decoders/jpeg.c ****                         long long dcv = slot ? *slot : 0;
 501:Source/render/decoders/jpeg.c ****                         if (slot) {
 502:Source/render/decoders/jpeg.c ****                             if (bit != 0) *slot = dcv + (1LL << sc->al);
 503:Source/render/decoders/jpeg.c ****                             else          *slot = dcv - (1LL << sc->al);
 504:Source/render/decoders/jpeg.c ****                         }
 505:Source/render/decoders/jpeg.c ****                     } else {
 506:Source/render/decoders/jpeg.c ****                         int ok;
 507:Source/render/decoders/jpeg.c ****                         int diff = decode_dc_sym(&rd, dcTbl, &ok);
 508:Source/render/decoders/jpeg.c ****                         if (!ok) { ended = 1; break; }
 509:Source/render/decoders/jpeg.c ****                         st->dcPred[c] += diff;
 510:Source/render/decoders/jpeg.c ****                         if (slot) *slot = st->dcPred[c] << sc->al;
 511:Source/render/decoders/jpeg.c ****                     }
 512:Source/render/decoders/jpeg.c ****                 }
 513:Source/render/decoders/jpeg.c ****             }
 514:Source/render/decoders/jpeg.c ****             mcuIndex++;
 515:Source/render/decoders/jpeg.c ****         }
 516:Source/render/decoders/jpeg.c ****     }
 517:Source/render/decoders/jpeg.c **** 
 518:Source/render/decoders/jpeg.c ****     *outPos = rd.pos;
 519:Source/render/decoders/jpeg.c ****     return !ended;
 520:Source/render/decoders/jpeg.c **** }
