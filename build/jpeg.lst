 480:Source/render/decoders/jpeg.c **** static JpegBaseResult jpeg_decode_baseline(const uint8_t *data, size_t len, size_t entropyPos,
 481:Source/render/decoders/jpeg.c ****                                            const JpegFrame *frame, const JpegScan *scan,
 482:Source/render/decoders/jpeg.c ****                                            const JpegHuff *dcTables, const JpegHuff *acTables,
 483:Source/render/decoders/jpeg.c ****                                            const JpegQt *qt, int restartInterval,
