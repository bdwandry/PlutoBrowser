 385:Source/render/decoders/jpeg.c **** /* Ensure blockDC[c] holds >= n int64 DC coefficients (zero-filled on first
 386:Source/render/decoders/jpeg.c ****  * alloc). DC values live in Lua doubles — must stay 64-bit in C. */
 387:Source/render/decoders/jpeg.c **** static int jpeg_prog_ensure(JpegProgState *st, int c, int n)
 388:Source/render/decoders/jpeg.c **** {
 389:Source/render/decoders/jpeg.c ****     if (c < 1 || c > 4)
 390:Source/render/decoders/jpeg.c ****     {
 391:Source/render/decoders/jpeg.c ****         return 0;
 392:Source/render/decoders/jpeg.c ****     }
