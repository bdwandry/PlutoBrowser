 321:Source/render/decoders/jpeg.c **** static int decode_dc_sym(JReader* rd, const JHuff* tbl, int* ok) {
 322:Source/render/decoders/jpeg.c ****     int s = decode_symbol(rd, tbl);
 323:Source/render/decoders/jpeg.c ****     *ok = 1;
 324:Source/render/decoders/jpeg.c ****     if (s == JPEG_NIL) { *ok = 0; return 0; }
 325:Source/render/decoders/jpeg.c ****     if (s == 0) return 0;
 326:Source/render/decoders/jpeg.c ****     int v = jr_read_bits(rd, s);
 327:Source/render/decoders/jpeg.c ****     if (v == JPEG_NIL) { *ok = 0; return 0; }
 328:Source/render/decoders/jpeg.c ****     return jpg_extend(v, s);
 329:Source/render/decoders/jpeg.c **** }
