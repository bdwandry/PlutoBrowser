 843:Source/render/decoders/jpeg.c ****     const int64_t *blockDC = state->blockDC[yc];
 844:Source/render/decoders/jpeg.c ****     int blockDCcap = state->blockDCcap[yc];
 845:Source/render/decoders/jpeg.c ****     int yfc_h = frame->comps[yc - 1].h;
