 359:Source/render/decoders/jpeg.c ****                  ((long long)f->width * (long long)f->height > 200000LL);
 360:Source/render/decoders/jpeg.c **** 
 361:Source/render/decoders/jpeg.c ****     JReader rd = { data, len, pos, 0, 0 };
 362:Source/render/decoders/jpeg.c ****     int dcPred[256] = {0};   /* keyed by scan component position 1..ns */
 363:Source/render/decoders/jpeg.c ****     long long block[64];
 364:Source/render/decoders/jpeg.c ****     long long mcuIndex = 0;
 365:Source/render/decoders/jpeg.c ****     int ended = 0;
 366:Source/render/decoders/jpeg.c ****     int zeroQt[64] = {0};
 367:Source/render/decoders/jpeg.c **** 
 368:Source/render/decoders/jpeg.c ****     for (int mcuY = 0; mcuY < mcuRows; mcuY++) {
 369:Source/render/decoders/jpeg.c ****         tasks_yield_check();
 370:Source/render/decoders/jpeg.c ****         for (int mcuX = 0; mcuX < mcuCols; mcuX++) {
 371:Source/render/decoders/jpeg.c ****             if (!ended && restartInterval > 0 && mcuIndex > 0 &&
 372:Source/render/decoders/jpeg.c ****                 (mcuIndex % restartInterval) == 0) {
 373:Source/render/decoders/jpeg.c ****                 if (!jr_expect_restart(&rd, (int)(mcuIndex % 8))) {
 374:Source/render/decoders/jpeg.c ****                     ended = 1;
