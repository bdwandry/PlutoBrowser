 410:Source/render/decoders/jpeg.c ****                                                     (double)IDCT_SCALE;
 411:Source/render/decoders/jpeg.c ****                                         int g = clamp255ll(
 412:Source/render/decoders/jpeg.c ****                                             (long long)floor(dv + 0.5) + 128);
 413:Source/render/decoders/jpeg.c ****                                         rowbuf_put(rowBuf, f->width, f->height, px + vx, py + vy,
 414:Source/render/decoders/jpeg.c ****                                                    (uint8_t)g);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccfnwQdQ.s 			page 20


 415:Source/render/decoders/jpeg.c ****                                     }
 416:Source/render/decoders/jpeg.c ****                                 }
 417:Source/render/decoders/jpeg.c ****                             }
 418:Source/render/decoders/jpeg.c ****                         } else {
 419:Source/render/decoders/jpeg.c ****                             /* Chroma: consumed for sync only, results discarded */
 420:Source/render/decoders/jpeg.c ****                             block[0] = 0;
 421:Source/render/decoders/jpeg.c ****                             decode_ac(&rd, acTbl, block, qtz);
 422:Source/render/decoders/jpeg.c ****                         }
 423:Source/render/decoders/jpeg.c ****                     }
