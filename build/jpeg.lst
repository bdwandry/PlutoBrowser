  68:Source/render/decoders/jpeg.c **** 
  69:Source/render/decoders/jpeg.c **** /* guarded accessors: -1 == Lua nil */
  70:Source/render/decoders/jpeg.c **** static unsigned j_u16(const uint8_t* d, size_t len, size_t o) {
  71:Source/render/decoders/jpeg.c ****     if (o >= len || o + 1 >= len) return 0;
  72:Source/render/decoders/jpeg.c ****     return ((unsigned)d[o] << 8) | (unsigned)d[o + 1];  /* JPEG: big-endian */
  73:Source/render/decoders/jpeg.c **** }
  74:Source/render/decoders/jpeg.c **** static int j_byte(const uint8_t* d, size_t len, size_t o) {
