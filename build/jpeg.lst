  38:Source/render/decoders/jpeg.c **** /* Fixed-point IDCT basis (verbatim):
  39:Source/render/decoders/jpeg.c ****  * idctT[k*8+n] = floor(4096 * C(k) * cos((2n+1)k*pi/16) + 0.5) */
  40:Source/render/decoders/jpeg.c **** static int JPEG_IDCT_T[64];
  41:Source/render/decoders/jpeg.c **** static int jpeg_idct_ready = 0;
  42:Source/render/decoders/jpeg.c **** 
  43:Source/render/decoders/jpeg.c **** static void jpeg_idct_init(void)
  44:Source/render/decoders/jpeg.c **** {
  45:Source/render/decoders/jpeg.c ****     if (jpeg_idct_ready)
  46:Source/render/decoders/jpeg.c ****     {
  47:Source/render/decoders/jpeg.c ****         return;
  48:Source/render/decoders/jpeg.c ****     }
  49:Source/render/decoders/jpeg.c ****     const double c0 = 0.707106781186548;
  50:Source/render/decoders/jpeg.c ****     for (int k = 0; k < 8; k++)
  51:Source/render/decoders/jpeg.c ****     {
  52:Source/render/decoders/jpeg.c ****         double c = (k == 0) ? c0 : 1.0;
  53:Source/render/decoders/jpeg.c ****         for (int n = 0; n < 8; n++)
  54:Source/render/decoders/jpeg.c ****         {
  55:Source/render/decoders/jpeg.c ****             double v = 4096.0 * c * cos((2 * n + 1) * k * 3.14159265358979323846 / 16.0);
  56:Source/render/decoders/jpeg.c ****             JPEG_IDCT_T[k * 8 + n] = (int)floor(v + 0.5);
  57:Source/render/decoders/jpeg.c ****         }
  58:Source/render/decoders/jpeg.c ****     }
  59:Source/render/decoders/jpeg.c ****     jpeg_idct_ready = 1;
  60:Source/render/decoders/jpeg.c **** }
