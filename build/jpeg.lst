 824:Source/render/decoders/jpeg.c ****     if (mcuCols < 1) mcuCols = 1;
 825:Source/render/decoders/jpeg.c ****     if (mcuRows < 1) mcuRows = 1;
 826:Source/render/decoders/jpeg.c **** 
 827:Source/render/decoders/jpeg.c ****     ScaleAccum *acc = scale_accum_new(width, height, maxW, maxH);
