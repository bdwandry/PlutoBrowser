 687:Source/render/decoders/jpeg.c **** /* Returns 1 on success, 0 on truncation. */
 688:Source/render/decoders/jpeg.c **** static int jpeg_decode_prog_dc(const uint8_t *data, size_t len, size_t entropyPos,
 689:Source/render/decoders/jpeg.c ****                                const JpegFrame *frame, const JpegScan *scan,
