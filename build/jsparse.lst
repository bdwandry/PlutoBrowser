  87:Source/js/jsparse.c **** static js_Ast *jsP_list(js_Ast *head)
  88:Source/js/jsparse.c **** {
  89:Source/js/jsparse.c **** 	/* set parent pointers in list nodes */
  90:Source/js/jsparse.c **** 	js_Ast *prev = head, *node = head->b;
  91:Source/js/jsparse.c **** 	while (node) {
  92:Source/js/jsparse.c **** 		node->parent = prev;
  93:Source/js/jsparse.c **** 		prev = node;
  94:Source/js/jsparse.c **** 		node = node->b;
  95:Source/js/jsparse.c **** 	}
  96:Source/js/jsparse.c **** 	return head;
  97:Source/js/jsparse.c **** }
