 314:Source/js/jsparse.c **** /* Expressions */
 315:Source/js/jsparse.c **** 
 316:Source/js/jsparse.c **** static js_Ast *primary(js_State *J)
 317:Source/js/jsparse.c **** {
 318:Source/js/jsparse.c **** 	js_Ast *a;
 319:Source/js/jsparse.c **** 	int line = J->lexline;
 320:Source/js/jsparse.c **** 
 321:Source/js/jsparse.c **** 	if (J->lookahead == TK_IDENTIFIER) {
 322:Source/js/jsparse.c **** 		a = jsP_newstrnode(J, EXP_IDENTIFIER, J->text);
 323:Source/js/jsparse.c **** 		jsP_next(J);
 324:Source/js/jsparse.c **** 		return a;
 325:Source/js/jsparse.c **** 	}
 326:Source/js/jsparse.c **** 	if (J->lookahead == TK_STRING) {
 327:Source/js/jsparse.c **** 		a = jsP_newstrnode(J, EXP_STRING, J->text);
 328:Source/js/jsparse.c **** 		jsP_next(J);
 329:Source/js/jsparse.c **** 		return a;
 330:Source/js/jsparse.c **** 	}
 331:Source/js/jsparse.c **** 	if (J->lookahead == TK_REGEXP) {
 332:Source/js/jsparse.c **** 		a = jsP_newstrnode(J, EXP_REGEXP, J->text);
 333:Source/js/jsparse.c **** 		a->number = J->number;
 334:Source/js/jsparse.c **** 		jsP_next(J);
 335:Source/js/jsparse.c **** 		return a;
 336:Source/js/jsparse.c **** 	}
 337:Source/js/jsparse.c **** 	if (J->lookahead == TK_NUMBER) {
 338:Source/js/jsparse.c **** 		a = jsP_newnumnode(J, EXP_NUMBER, J->number);
 339:Source/js/jsparse.c **** 		jsP_next(J);
 340:Source/js/jsparse.c **** 		return a;
 341:Source/js/jsparse.c **** 	}
 342:Source/js/jsparse.c **** 
 343:Source/js/jsparse.c **** 	if (jsP_accept(J, TK_THIS)) return EXP0(THIS);
 344:Source/js/jsparse.c **** 	if (jsP_accept(J, TK_NULL)) return EXP0(NULL);
 345:Source/js/jsparse.c **** 	if (jsP_accept(J, TK_TRUE)) return EXP0(TRUE);
 346:Source/js/jsparse.c **** 	if (jsP_accept(J, TK_FALSE)) return EXP0(FALSE);
 347:Source/js/jsparse.c **** 	if (jsP_accept(J, '{')) {
 348:Source/js/jsparse.c **** 		a = EXP1(OBJECT, objectliteral(J));
 349:Source/js/jsparse.c **** 		jsP_expect(J, '}');
 350:Source/js/jsparse.c **** 		return a;
 351:Source/js/jsparse.c **** 	}
 352:Source/js/jsparse.c **** 	if (jsP_accept(J, '[')) {
 353:Source/js/jsparse.c **** 		a = EXP1(ARRAY, arrayliteral(J));
 354:Source/js/jsparse.c **** 		jsP_expect(J, ']');
 355:Source/js/jsparse.c **** 		return a;
 356:Source/js/jsparse.c **** 	}
 357:Source/js/jsparse.c **** 	if (jsP_accept(J, '(')) {
 358:Source/js/jsparse.c **** 		a = expression(J, 0);
 359:Source/js/jsparse.c **** 		jsP_expect(J, ')');
 360:Source/js/jsparse.c **** 		return a;
 361:Source/js/jsparse.c **** 	}
 362:Source/js/jsparse.c **** 
 363:Source/js/jsparse.c **** 	jsP_error(J, "unexpected token in expression: %s", jsY_tokenstring(J->lookahead));
 364:Source/js/jsparse.c **** }
 365:Source/js/jsparse.c **** 
 366:Source/js/jsparse.c **** static js_Ast *arguments(js_State *J)
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccwh1ZIm.s 			page 30


 367:Source/js/jsparse.c **** {
 368:Source/js/jsparse.c **** 	js_Ast *head, *tail;
 369:Source/js/jsparse.c **** 	if (J->lookahead == ')')
 370:Source/js/jsparse.c **** 		return NULL;
 371:Source/js/jsparse.c **** 	head = tail = LIST(assignment(J, 0));
 372:Source/js/jsparse.c **** 	while (jsP_accept(J, ',')) {
 373:Source/js/jsparse.c **** 		tail = tail->b = LIST(assignment(J, 0));
 374:Source/js/jsparse.c **** 	}
 375:Source/js/jsparse.c **** 	return jsP_list(head);
 376:Source/js/jsparse.c **** }
 377:Source/js/jsparse.c **** 
 378:Source/js/jsparse.c **** static js_Ast *newexp(js_State *J)
 379:Source/js/jsparse.c **** {
 380:Source/js/jsparse.c **** 	js_Ast *a, *b;
 381:Source/js/jsparse.c **** 	int line = J->lexline;
 382:Source/js/jsparse.c **** 
 383:Source/js/jsparse.c **** 	if (jsP_accept(J, TK_NEW)) {
 384:Source/js/jsparse.c **** 		a = memberexp(J);
 385:Source/js/jsparse.c **** 		if (jsP_accept(J, '(')) {
 386:Source/js/jsparse.c **** 			b = arguments(J);
 387:Source/js/jsparse.c **** 			jsP_expect(J, ')');
 388:Source/js/jsparse.c **** 			return EXP2(NEW, a, b);
 389:Source/js/jsparse.c **** 		}
 390:Source/js/jsparse.c **** 		return EXP1(NEW, a);
 391:Source/js/jsparse.c **** 	}
 392:Source/js/jsparse.c **** 
 393:Source/js/jsparse.c **** 	if (jsP_accept(J, TK_FUNCTION))
 394:Source/js/jsparse.c **** 		return funexp(J, line);
 395:Source/js/jsparse.c **** 
 396:Source/js/jsparse.c **** 	return primary(J);
 397:Source/js/jsparse.c **** }
 398:Source/js/jsparse.c **** 
 399:Source/js/jsparse.c **** static js_Ast *memberexp(js_State *J)
 400:Source/js/jsparse.c **** {
 401:Source/js/jsparse.c **** 	js_Ast *a = newexp(J);
 402:Source/js/jsparse.c **** 	int line;
 403:Source/js/jsparse.c **** 	SAVEREC();
 404:Source/js/jsparse.c **** loop:
 405:Source/js/jsparse.c **** 	INCREC();
 406:Source/js/jsparse.c **** 	line = J->lexline;
 407:Source/js/jsparse.c **** 	if (jsP_accept(J, '.')) { a = EXP2(MEMBER, a, identifiername(J)); goto loop; }
 408:Source/js/jsparse.c **** 	if (jsP_accept(J, '[')) { a = EXP2(INDEX, a, expression(J, 0)); jsP_expect(J, ']'); goto loop; }
 409:Source/js/jsparse.c **** 	POPREC();
 410:Source/js/jsparse.c **** 	return a;
 411:Source/js/jsparse.c **** }
 412:Source/js/jsparse.c **** 
 413:Source/js/jsparse.c **** static js_Ast *callexp(js_State *J)
 414:Source/js/jsparse.c **** {
 415:Source/js/jsparse.c **** 	js_Ast *a = newexp(J);
 416:Source/js/jsparse.c **** 	int line;
 417:Source/js/jsparse.c **** 	SAVEREC();
 418:Source/js/jsparse.c **** loop:
 419:Source/js/jsparse.c **** 	INCREC();
 420:Source/js/jsparse.c **** 	line = J->lexline;
 421:Source/js/jsparse.c **** 	if (jsP_accept(J, '.')) { a = EXP2(MEMBER, a, identifiername(J)); goto loop; }
 422:Source/js/jsparse.c **** 	if (jsP_accept(J, '[')) { a = EXP2(INDEX, a, expression(J, 0)); jsP_expect(J, ']'); goto loop; }
 423:Source/js/jsparse.c **** 	if (jsP_accept(J, '(')) { a = EXP2(CALL, a, arguments(J)); jsP_expect(J, ')'); goto loop; }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccwh1ZIm.s 			page 31


 424:Source/js/jsparse.c **** 	POPREC();
 425:Source/js/jsparse.c **** 	return a;
 426:Source/js/jsparse.c **** }
 427:Source/js/jsparse.c **** 
 428:Source/js/jsparse.c **** static js_Ast *postfix(js_State *J)
 429:Source/js/jsparse.c **** {
 430:Source/js/jsparse.c **** 	js_Ast *a = callexp(J);
 431:Source/js/jsparse.c **** 	int line = J->lexline;
 432:Source/js/jsparse.c **** 	if (!J->newline && jsP_accept(J, TK_INC)) return EXP1(POSTINC, a);
 433:Source/js/jsparse.c **** 	if (!J->newline && jsP_accept(J, TK_DEC)) return EXP1(POSTDEC, a);
 434:Source/js/jsparse.c **** 	return a;
 435:Source/js/jsparse.c **** }
 436:Source/js/jsparse.c **** 
 437:Source/js/jsparse.c **** static js_Ast *unary(js_State *J)
 438:Source/js/jsparse.c **** {
 439:Source/js/jsparse.c **** 	js_Ast *a;
 440:Source/js/jsparse.c **** 	int line = J->lexline;
 441:Source/js/jsparse.c **** 	INCREC();
 442:Source/js/jsparse.c **** 	if (jsP_accept(J, TK_DELETE)) a = EXP1(DELETE, unary(J));
 443:Source/js/jsparse.c **** 	else if (jsP_accept(J, TK_VOID)) a = EXP1(VOID, unary(J));
 444:Source/js/jsparse.c **** 	else if (jsP_accept(J, TK_TYPEOF)) a = EXP1(TYPEOF, unary(J));
 445:Source/js/jsparse.c **** 	else if (jsP_accept(J, TK_INC)) a = EXP1(PREINC, unary(J));
 446:Source/js/jsparse.c **** 	else if (jsP_accept(J, TK_DEC)) a = EXP1(PREDEC, unary(J));
 447:Source/js/jsparse.c **** 	else if (jsP_accept(J, '+')) a = EXP1(POS, unary(J));
 448:Source/js/jsparse.c **** 	else if (jsP_accept(J, '-')) a = EXP1(NEG, unary(J));
 449:Source/js/jsparse.c **** 	else if (jsP_accept(J, '~')) a = EXP1(BITNOT, unary(J));
 450:Source/js/jsparse.c **** 	else if (jsP_accept(J, '!')) a = EXP1(LOGNOT, unary(J));
 451:Source/js/jsparse.c **** 	else a = postfix(J);
 452:Source/js/jsparse.c **** 	DECREC();
 453:Source/js/jsparse.c **** 	return a;
 454:Source/js/jsparse.c **** }
