 507:Source/js/jsparse.c **** 	line = J->lexline;
 508:Source/js/jsparse.c **** 	if (jsP_accept(J, '<')) { a = EXP2(LT, a, shift(J)); goto loop; }
 509:Source/js/jsparse.c **** 	if (jsP_accept(J, '>')) { a = EXP2(GT, a, shift(J)); goto loop; }
 510:Source/js/jsparse.c **** 	if (jsP_accept(J, TK_LE)) { a = EXP2(LE, a, shift(J)); goto loop; }
