 113:Source/js/jsparse.c **** static void jsP_freejumps(js_State *J, js_JumpList *node)
 114:Source/js/jsparse.c **** {
 115:Source/js/jsparse.c **** 	while (node) {
 116:Source/js/jsparse.c **** 		js_JumpList *next = node->next;
 117:Source/js/jsparse.c **** 		js_free(J, node);
 118:Source/js/jsparse.c **** 		node = next;
 119:Source/js/jsparse.c **** 	}
 120:Source/js/jsparse.c **** }
