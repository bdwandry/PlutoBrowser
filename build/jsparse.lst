 456:Source/js/jsparse.c **** static js_Ast *multiplicative(js_State *J)
 457:Source/js/jsparse.c **** {
 458:Source/js/jsparse.c **** 	js_Ast *a = unary(J);
 459:Source/js/jsparse.c **** 	int line;
 460:Source/js/jsparse.c **** 	SAVEREC();
 461:Source/js/jsparse.c **** loop:
 462:Source/js/jsparse.c **** 	INCREC();
 463:Source/js/jsparse.c **** 	line = J->lexline;
 464:Source/js/jsparse.c **** 	if (jsP_accept(J, '*')) { a = EXP2(MUL, a, unary(J)); goto loop; }
 465:Source/js/jsparse.c **** 	if (jsP_accept(J, '/')) { a = EXP2(DIV, a, unary(J)); goto loop; }
 466:Source/js/jsparse.c **** 	if (jsP_accept(J, '%')) { a = EXP2(MOD, a, unary(J)); goto loop; }
 467:Source/js/jsparse.c **** 	POPREC();
 468:Source/js/jsparse.c **** 	return a;
 469:Source/js/jsparse.c **** }
