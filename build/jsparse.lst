 186:Source/js/jsparse.c **** static js_Ast *arrayelement(js_State *J)
 187:Source/js/jsparse.c **** {
 188:Source/js/jsparse.c **** 	int line = J->lexline;
 189:Source/js/jsparse.c **** 	if (J->lookahead == ',')
 190:Source/js/jsparse.c **** 		return EXP0(ELISION);
 191:Source/js/jsparse.c **** 	return assignment(J, 0);
 192:Source/js/jsparse.c **** }
 193:Source/js/jsparse.c **** 
 194:Source/js/jsparse.c **** static js_Ast *arrayliteral(js_State *J)
 195:Source/js/jsparse.c **** {
 196:Source/js/jsparse.c **** 	js_Ast *head, *tail;
 197:Source/js/jsparse.c **** 	if (J->lookahead == ']')
 198:Source/js/jsparse.c **** 		return NULL;
 199:Source/js/jsparse.c **** 	head = tail = LIST(arrayelement(J));
 200:Source/js/jsparse.c **** 	while (jsP_accept(J, ',')) {
 201:Source/js/jsparse.c **** 		if (J->lookahead != ']')
 202:Source/js/jsparse.c **** 			tail = tail->b = LIST(arrayelement(J));
 203:Source/js/jsparse.c **** 	}
 204:Source/js/jsparse.c **** 	return jsP_list(head);
 205:Source/js/jsparse.c **** }
 206:Source/js/jsparse.c **** 
 207:Source/js/jsparse.c **** static js_Ast *propname(js_State *J)
 208:Source/js/jsparse.c **** {
 209:Source/js/jsparse.c **** 	js_Ast *name;
 210:Source/js/jsparse.c **** 	if (J->lookahead == TK_NUMBER) {
 211:Source/js/jsparse.c **** 		name = jsP_newnumnode(J, EXP_NUMBER, J->number);
 212:Source/js/jsparse.c **** 		jsP_next(J);
 213:Source/js/jsparse.c **** 	} else if (J->lookahead == TK_STRING) {
 214:Source/js/jsparse.c **** 		name = jsP_newstrnode(J, EXP_STRING, J->text);
 215:Source/js/jsparse.c **** 		jsP_next(J);
 216:Source/js/jsparse.c **** 	} else {
 217:Source/js/jsparse.c **** 		name = identifiername(J);
 218:Source/js/jsparse.c **** 	}
 219:Source/js/jsparse.c **** 	return name;
 220:Source/js/jsparse.c **** }
 221:Source/js/jsparse.c **** 
 222:Source/js/jsparse.c **** static js_Ast *propassign(js_State *J)
 223:Source/js/jsparse.c **** {
 224:Source/js/jsparse.c **** 	js_Ast *name, *value, *arg, *body;
 225:Source/js/jsparse.c **** 	int line = J->lexline;
 226:Source/js/jsparse.c **** 
 227:Source/js/jsparse.c **** 	name = propname(J);
 228:Source/js/jsparse.c **** 
 229:Source/js/jsparse.c **** 	if (J->lookahead != ':' && name->type == AST_IDENTIFIER) {
 230:Source/js/jsparse.c **** 		if (!strcmp(name->string, "get")) {
 231:Source/js/jsparse.c **** 			name = propname(J);
 232:Source/js/jsparse.c **** 			jsP_expect(J, '(');
 233:Source/js/jsparse.c **** 			jsP_expect(J, ')');
 234:Source/js/jsparse.c **** 			body = funbody(J);
 235:Source/js/jsparse.c **** 			return EXP3(PROP_GET, name, NULL, body);
 236:Source/js/jsparse.c **** 		}
 237:Source/js/jsparse.c **** 		if (!strcmp(name->string, "set")) {
 238:Source/js/jsparse.c **** 			name = propname(J);
 239:Source/js/jsparse.c **** 			jsP_expect(J, '(');
 240:Source/js/jsparse.c **** 			arg = identifier(J);
 241:Source/js/jsparse.c **** 			jsP_expect(J, ')');
 242:Source/js/jsparse.c **** 			body = funbody(J);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccwh1ZIm.s 			page 17


 243:Source/js/jsparse.c **** 			return EXP3(PROP_SET, name, LIST(arg), body);
 244:Source/js/jsparse.c **** 		}
 245:Source/js/jsparse.c **** 	}
 246:Source/js/jsparse.c **** 
 247:Source/js/jsparse.c **** 	jsP_expect(J, ':');
 248:Source/js/jsparse.c **** 	value = assignment(J, 0);
 249:Source/js/jsparse.c **** 	return EXP2(PROP_VAL, name, value);
 250:Source/js/jsparse.c **** }
 251:Source/js/jsparse.c **** 
 252:Source/js/jsparse.c **** static js_Ast *objectliteral(js_State *J)
 253:Source/js/jsparse.c **** {
 254:Source/js/jsparse.c **** 	js_Ast *head, *tail;
 255:Source/js/jsparse.c **** 	if (J->lookahead == '}')
 256:Source/js/jsparse.c **** 		return NULL;
 257:Source/js/jsparse.c **** 	head = tail = LIST(propassign(J));
 258:Source/js/jsparse.c **** 	while (jsP_accept(J, ',')) {
 259:Source/js/jsparse.c **** 		if (J->lookahead == '}')
 260:Source/js/jsparse.c **** 			break;
 261:Source/js/jsparse.c **** 		tail = tail->b = LIST(propassign(J));
 262:Source/js/jsparse.c **** 	}
 263:Source/js/jsparse.c **** 	return jsP_list(head);
 264:Source/js/jsparse.c **** }
