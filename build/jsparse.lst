 135:Source/js/jsparse.c **** 
 136:Source/js/jsparse.c **** static void jsP_next(js_State *J)
 137:Source/js/jsparse.c **** {
 138:Source/js/jsparse.c **** 	J->lookahead = jsY_lex(J);
 139:Source/js/jsparse.c **** }
 140:Source/js/jsparse.c **** 
 141:Source/js/jsparse.c **** #define jsP_accept(J,x) (J->lookahead == x ? (jsP_next(J), 1) : 0)
 142:Source/js/jsparse.c **** 
 143:Source/js/jsparse.c **** #define jsP_expect(J,x) if (!jsP_accept(J, x)) jsP_error(J, "unexpected token: %s (expected %s)", j
 144:Source/js/jsparse.c **** 
 145:Source/js/jsparse.c **** static void semicolon(js_State *J)
 146:Source/js/jsparse.c **** {
 147:Source/js/jsparse.c **** 	if (J->lookahead == ';') {
 148:Source/js/jsparse.c **** 		jsP_next(J);
 149:Source/js/jsparse.c **** 		return;
 150:Source/js/jsparse.c **** 	}
 151:Source/js/jsparse.c **** 	if (J->newline || J->lookahead == '}' || J->lookahead == 0)
 152:Source/js/jsparse.c **** 		return;
 153:Source/js/jsparse.c **** 	jsP_error(J, "unexpected token: %s (expected ';')", jsY_tokenstring(J->lookahead));
 154:Source/js/jsparse.c **** }
