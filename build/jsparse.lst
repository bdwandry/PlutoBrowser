 280:Source/js/jsparse.c **** static js_Ast *fundec(js_State *J, int line)
 281:Source/js/jsparse.c **** {
 282:Source/js/jsparse.c **** 	js_Ast *a, *b, *c;
 283:Source/js/jsparse.c **** 	a = identifier(J);
 284:Source/js/jsparse.c **** 	jsP_expect(J, '(');
 285:Source/js/jsparse.c **** 	b = parameters(J);
 286:Source/js/jsparse.c **** 	jsP_expect(J, ')');
 287:Source/js/jsparse.c **** 	c = funbody(J);
 288:Source/js/jsparse.c **** 	return jsP_newnode(J, AST_FUNDEC, line, a, b, c, 0);
 289:Source/js/jsparse.c **** }
 290:Source/js/jsparse.c **** 
 291:Source/js/jsparse.c **** static js_Ast *funstm(js_State *J, int line)
 292:Source/js/jsparse.c **** {
 293:Source/js/jsparse.c **** 	js_Ast *a, *b, *c;
 294:Source/js/jsparse.c **** 	a = identifier(J);
 295:Source/js/jsparse.c **** 	jsP_expect(J, '(');
 296:Source/js/jsparse.c **** 	b = parameters(J);
 297:Source/js/jsparse.c **** 	jsP_expect(J, ')');
 298:Source/js/jsparse.c **** 	c = funbody(J);
 299:Source/js/jsparse.c **** 	/* rewrite function statement as "var X = function X() {}" */
 300:Source/js/jsparse.c **** 	return STM1(VAR, LIST(EXP2(VAR, a, EXP3(FUN, a, b, c))));
 301:Source/js/jsparse.c **** }
