 269:Source/js/jsvalue.c **** /* ToString() on a number */
 270:Source/js/jsvalue.c **** const char *jsV_numbertostring(js_State *J, char buf[32], double f)
 271:Source/js/jsvalue.c **** {
 272:Source/js/jsvalue.c **** 	char digits[32], *p = buf, *s = digits;
 273:Source/js/jsvalue.c **** 	int exp, ndigits, point;
 274:Source/js/jsvalue.c **** 
 275:Source/js/jsvalue.c **** 	if (f == 0) return "0";
 276:Source/js/jsvalue.c **** 	if (isnan(f)) return "NaN";
 277:Source/js/jsvalue.c **** 	if (isinf(f)) return f < 0 ? "-Infinity" : "Infinity";
 278:Source/js/jsvalue.c **** 
 279:Source/js/jsvalue.c **** 	/* Fast case for integers. This only works assuming all integers can be
 280:Source/js/jsvalue.c **** 	 * exactly represented by a float. This is true for 32-bit integers and
 281:Source/js/jsvalue.c **** 	 * 64-bit floats. */
 282:Source/js/jsvalue.c **** 	if (f >= INT_MIN && f <= INT_MAX) {
 283:Source/js/jsvalue.c **** 		int i = (int)f;
 284:Source/js/jsvalue.c **** 		if ((double)i == f)
 285:Source/js/jsvalue.c **** 			return js_itoa(buf, i);
 286:Source/js/jsvalue.c **** 	}
 287:Source/js/jsvalue.c **** 
 288:Source/js/jsvalue.c **** 	ndigits = js_grisu2(f, digits, &exp);
 289:Source/js/jsvalue.c **** 	point = ndigits + exp;
 290:Source/js/jsvalue.c **** 
 291:Source/js/jsvalue.c **** 	if (signbit(f))
 292:Source/js/jsvalue.c **** 		*p++ = '-';
 293:Source/js/jsvalue.c **** 
 294:Source/js/jsvalue.c **** 	if (point < -5 || point > 21) {
 295:Source/js/jsvalue.c **** 		*p++ = *s++;
 296:Source/js/jsvalue.c **** 		if (ndigits > 1) {
 297:Source/js/jsvalue.c **** 			int n = ndigits - 1;
 298:Source/js/jsvalue.c **** 			*p++ = '.';
 299:Source/js/jsvalue.c **** 			while (n--)
 300:Source/js/jsvalue.c **** 				*p++ = *s++;
 301:Source/js/jsvalue.c **** 		}
 302:Source/js/jsvalue.c **** 		js_fmtexp(p, point - 1);
 303:Source/js/jsvalue.c **** 	}
 304:Source/js/jsvalue.c **** 
 305:Source/js/jsvalue.c **** 	else if (point <= 0) {
 306:Source/js/jsvalue.c **** 		*p++ = '0';
 307:Source/js/jsvalue.c **** 		*p++ = '.';
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccx3Ze4S.s 			page 8


 308:Source/js/jsvalue.c **** 		while (point++ < 0)
 309:Source/js/jsvalue.c **** 			*p++ = '0';
 310:Source/js/jsvalue.c **** 		while (ndigits-- > 0)
 311:Source/js/jsvalue.c **** 			*p++ = *s++;
 312:Source/js/jsvalue.c **** 		*p = 0;
 313:Source/js/jsvalue.c **** 	}
 314:Source/js/jsvalue.c **** 
 315:Source/js/jsvalue.c **** 	else {
 316:Source/js/jsvalue.c **** 		while (ndigits-- > 0) {
 317:Source/js/jsvalue.c **** 			*p++ = *s++;
 318:Source/js/jsvalue.c **** 			if (--point == 0 && ndigits > 0)
 319:Source/js/jsvalue.c **** 				*p++ = '.';
 320:Source/js/jsvalue.c **** 		}
 321:Source/js/jsvalue.c **** 		while (point-- > 0)
 322:Source/js/jsvalue.c **** 			*p++ = '0';
 323:Source/js/jsvalue.c **** 		*p = 0;
 324:Source/js/jsvalue.c **** 	}
 325:Source/js/jsvalue.c **** 
 326:Source/js/jsvalue.c **** 	return buf;
 327:Source/js/jsvalue.c **** }
 328:Source/js/jsvalue.c **** 
 329:Source/js/jsvalue.c **** /* ToString() on a value */
 330:Source/js/jsvalue.c **** const char *jsV_tostring(js_State *J, js_Value *v)
 331:Source/js/jsvalue.c **** {
 332:Source/js/jsvalue.c **** 	char buf[32];
 333:Source/js/jsvalue.c **** 	const char *p;
 334:Source/js/jsvalue.c **** 	switch (v->t.type) {
 335:Source/js/jsvalue.c **** 	default:
 336:Source/js/jsvalue.c **** 	case JS_TSHRSTR: return v->u.shrstr;
 337:Source/js/jsvalue.c **** 	case JS_TUNDEFINED: return "undefined";
 338:Source/js/jsvalue.c **** 	case JS_TNULL: return "null";
 339:Source/js/jsvalue.c **** 	case JS_TBOOLEAN: return v->u.boolean ? "true" : "false";
 340:Source/js/jsvalue.c **** 	case JS_TLITSTR: return v->u.litstr;
 341:Source/js/jsvalue.c **** 	case JS_TMEMSTR: return v->u.memstr->p;
 342:Source/js/jsvalue.c **** 	case JS_TNUMBER:
 343:Source/js/jsvalue.c **** 		p = jsV_numbertostring(J, buf, v->u.number);
 344:Source/js/jsvalue.c **** 		if (p == buf) {
 345:Source/js/jsvalue.c **** 			int n = strlen(p);
 346:Source/js/jsvalue.c **** 			if (n <= soffsetof(js_Value, t.type)) {
 347:Source/js/jsvalue.c **** 				char *s = v->u.shrstr;
 348:Source/js/jsvalue.c **** 				while (n--) *s++ = *p++;
 349:Source/js/jsvalue.c **** 				*s = 0;
 350:Source/js/jsvalue.c **** 				v->t.type = JS_TSHRSTR;
 351:Source/js/jsvalue.c **** 				return v->u.shrstr;
 352:Source/js/jsvalue.c **** 			} else {
 353:Source/js/jsvalue.c **** 				v->u.memstr = jsV_newmemstring(J, p, n);
 354:Source/js/jsvalue.c **** 				v->t.type = JS_TMEMSTR;
 355:Source/js/jsvalue.c **** 				return v->u.memstr->p;
 356:Source/js/jsvalue.c **** 			}
 357:Source/js/jsvalue.c **** 		}
 358:Source/js/jsvalue.c **** 		return p;
 359:Source/js/jsvalue.c **** 	case JS_TOBJECT:
 360:Source/js/jsvalue.c **** 		jsV_toprimitive(J, v, JS_HSTRING);
 361:Source/js/jsvalue.c **** 		return jsV_tostring(J, v);
 362:Source/js/jsvalue.c **** 	}
 363:Source/js/jsvalue.c **** }
 364:Source/js/jsvalue.c **** 
