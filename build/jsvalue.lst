 216:Source/js/jsvalue.c **** 	}
 217:Source/js/jsvalue.c **** 	if (end == e) {
 218:Source/js/jsvalue.c **** 		*ep = (char*)e;
 219:Source/js/jsvalue.c **** 		return n;
 220:Source/js/jsvalue.c **** 	}
 221:Source/js/jsvalue.c **** 	*ep = (char*)s;
 222:Source/js/jsvalue.c **** 	return 0;
 223:Source/js/jsvalue.c **** }
