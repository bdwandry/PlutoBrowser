 225:Source/js/jsvalue.c **** /* ToNumber() on a string */
 226:Source/js/jsvalue.c **** double jsV_stringtonumber(js_State *J, const char *s)
 227:Source/js/jsvalue.c **** {
 228:Source/js/jsvalue.c **** 	char *e;
 229:Source/js/jsvalue.c **** 	double n;
 230:Source/js/jsvalue.c **** 	while (jsY_iswhite(*s) || jsY_isnewline(*s)) ++s;
 231:Source/js/jsvalue.c **** 	if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X') && s[2] != 0)
 232:Source/js/jsvalue.c **** 		n = js_strtol(s + 2, &e, 16);
 233:Source/js/jsvalue.c **** 	else if (!strncmp(s, "Infinity", 8))
 234:Source/js/jsvalue.c **** 		n = INFINITY, e = (char*)s + 8;
 235:Source/js/jsvalue.c **** 	else if (!strncmp(s, "+Infinity", 9))
 236:Source/js/jsvalue.c **** 		n = INFINITY, e = (char*)s + 9;
 237:Source/js/jsvalue.c **** 	else if (!strncmp(s, "-Infinity", 9))
 238:Source/js/jsvalue.c **** 		n = -INFINITY, e = (char*)s + 9;
 239:Source/js/jsvalue.c **** 	else
 240:Source/js/jsvalue.c **** 		n = js_stringtofloat(s, &e);
 241:Source/js/jsvalue.c **** 	while (jsY_iswhite(*e) || jsY_isnewline(*e)) ++e;
 242:Source/js/jsvalue.c **** 	if (*e) return NAN;
 243:Source/js/jsvalue.c **** 	return n;
 244:Source/js/jsvalue.c **** }
 245:Source/js/jsvalue.c **** 
 246:Source/js/jsvalue.c **** /* ToNumber() on a value */
 247:Source/js/jsvalue.c **** double jsV_tonumber(js_State *J, js_Value *v)
 248:Source/js/jsvalue.c **** {
 249:Source/js/jsvalue.c **** 	switch (v->t.type) {
 250:Source/js/jsvalue.c **** 	default:
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccx3Ze4S.s 			page 7


 251:Source/js/jsvalue.c **** 	case JS_TSHRSTR: return jsV_stringtonumber(J, v->u.shrstr);
 252:Source/js/jsvalue.c **** 	case JS_TUNDEFINED: return NAN;
 253:Source/js/jsvalue.c **** 	case JS_TNULL: return 0;
 254:Source/js/jsvalue.c **** 	case JS_TBOOLEAN: return v->u.boolean;
 255:Source/js/jsvalue.c **** 	case JS_TNUMBER: return v->u.number;
 256:Source/js/jsvalue.c **** 	case JS_TLITSTR: return jsV_stringtonumber(J, v->u.litstr);
 257:Source/js/jsvalue.c **** 	case JS_TMEMSTR: return jsV_stringtonumber(J, v->u.memstr->p);
 258:Source/js/jsvalue.c **** 	case JS_TOBJECT:
 259:Source/js/jsvalue.c **** 		jsV_toprimitive(J, v, JS_HNUMBER);
 260:Source/js/jsvalue.c **** 		return jsV_tonumber(J, v);
 261:Source/js/jsvalue.c **** 	}
 262:Source/js/jsvalue.c **** }
