 151:Source/js/jsvalue.c **** /* ToBoolean() on a value */
 152:Source/js/jsvalue.c **** int jsV_toboolean(js_State *J, js_Value *v)
 153:Source/js/jsvalue.c **** {
 154:Source/js/jsvalue.c **** 	switch (v->t.type) {
 155:Source/js/jsvalue.c **** 	default:
 156:Source/js/jsvalue.c **** 	case JS_TSHRSTR: return v->u.shrstr[0] != 0;
 157:Source/js/jsvalue.c **** 	case JS_TUNDEFINED: return 0;
 158:Source/js/jsvalue.c **** 	case JS_TNULL: return 0;
 159:Source/js/jsvalue.c **** 	case JS_TBOOLEAN: return v->u.boolean;
 160:Source/js/jsvalue.c **** 	case JS_TNUMBER: return v->u.number != 0 && !isnan(v->u.number);
 161:Source/js/jsvalue.c **** 	case JS_TLITSTR: return v->u.litstr[0] != 0;
 162:Source/js/jsvalue.c **** 	case JS_TMEMSTR: return v->u.memstr->p[0] != 0;
 163:Source/js/jsvalue.c **** 	case JS_TOBJECT: return 1;
 164:Source/js/jsvalue.c **** 	}
 165:Source/js/jsvalue.c **** }
