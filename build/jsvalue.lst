  41:Source/js/jsvalue.c **** int jsV_numbertointeger(double n)
  42:Source/js/jsvalue.c **** {
  43:Source/js/jsvalue.c **** 	if (n == 0) return 0;
  44:Source/js/jsvalue.c **** 	if (isnan(n)) return 0;
  45:Source/js/jsvalue.c **** 	n = (n < 0) ? -floor(-n) : floor(n);
  46:Source/js/jsvalue.c **** 	if (n < INT_MIN) return INT_MIN;
  47:Source/js/jsvalue.c **** 	if (n > INT_MAX) return INT_MAX;
  48:Source/js/jsvalue.c **** 	return (int)n;
  49:Source/js/jsvalue.c **** }
