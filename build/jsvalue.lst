 167:Source/js/jsvalue.c **** const char *js_itoa(char *out, int v)
 168:Source/js/jsvalue.c **** {
 169:Source/js/jsvalue.c **** 	char buf[32], *s = out;
 170:Source/js/jsvalue.c **** 	unsigned int a;
 171:Source/js/jsvalue.c **** 	int i = 0;
 172:Source/js/jsvalue.c **** 	if (v < 0) {
 173:Source/js/jsvalue.c **** 		a = -(unsigned)v; /* cast to avoid -INT_MIN signed overflow UB */
 174:Source/js/jsvalue.c **** 		*s++ = '-';
 175:Source/js/jsvalue.c **** 	} else {
 176:Source/js/jsvalue.c **** 		a = v;
 177:Source/js/jsvalue.c **** 	}
 178:Source/js/jsvalue.c **** 	while (a) {
 179:Source/js/jsvalue.c **** 		buf[i++] = (a % 10) + '0';
 180:Source/js/jsvalue.c **** 		a /= 10;
 181:Source/js/jsvalue.c **** 	}
 182:Source/js/jsvalue.c **** 	if (i == 0)
 183:Source/js/jsvalue.c **** 		buf[i++] = '0';
 184:Source/js/jsvalue.c **** 	while (i > 0)
 185:Source/js/jsvalue.c **** 		*s++ = buf[--i];
 186:Source/js/jsvalue.c **** 	*s = 0;
 187:Source/js/jsvalue.c **** 	return out;
 188:Source/js/jsvalue.c **** }
