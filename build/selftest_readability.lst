 116:Source/html/selftest_readability.c **** /* ── A. basics ──────────────────────────�
 117:Source/html/selftest_readability.c **** 
 118:Source/html/selftest_readability.c **** static void case_basics(void) {
 119:Source/html/selftest_readability.c ****     DocDocument* d = reader("<p>Hello brave world</p>");
 120:Source/html/selftest_readability.c ****     ck("A.mode_flag", d != NULL && d->isReaderMode == 1);
 121:Source/html/selftest_readability.c ****     ck("A.raw_html_kept", d != NULL && d->rawHtml != NULL &&
 122:Source/html/selftest_readability.c ****        strcmp(d->rawHtml, "<p>Hello brave world</p>") == 0);
 123:Source/html/selftest_readability.c ****     ck("A.base_kept", d != NULL && d->baseUrl != NULL &&
 124:Source/html/selftest_readability.c ****        strcmp(d->baseUrl, BASE) == 0);
 125:Source/html/selftest_readability.c ****     ck("A.block_count", d != NULL && d->nBlocks == 4);
 126:Source/html/selftest_readability.c ****     ck("A.header_host", d != NULL && d->blocks[0].readerHost != NULL &&
 127:Source/html/selftest_readability.c ****        strcmp(d->blocks[0].readerHost, "EX.COM") == 0);
 128:Source/html/selftest_readability.c ****     ck("A.header_title_fallback", d != NULL &&
 129:Source/html/selftest_readability.c ****        d->blocks[0].readerTitle != NULL &&
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccaeqnMj.s 			page 36


 130:Source/html/selftest_readability.c ****        strcmp(d->blocks[0].readerTitle, "Web Page") == 0);
 131:Source/html/selftest_readability.c ****     ck("A.reading_time_math", d != NULL &&
 132:Source/html/selftest_readability.c ****        d->blocks[0].readingTime != NULL &&
 133:Source/html/selftest_readability.c ****        strcmp(d->blocks[0].readingTime, "1 min read (3 words)") == 0 &&
 134:Source/html/selftest_readability.c ****        d->readerWords == 3 && d->readerTime != NULL &&
 135:Source/html/selftest_readability.c ****        strcmp(d->readerTime, "1 min read (3 words)") == 0);
 136:Source/html/selftest_readability.c ****     ck("A.title_h1_bold", d != NULL && d->blocks[1].type == DB_HEADING &&
 137:Source/html/selftest_readability.c ****        d->blocks[1].level == 1 && d->blocks[1].nInlines == 1 &&
