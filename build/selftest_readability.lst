  48:Source/html/selftest_readability.c **** static int doc_contains_text(const DocDocument* d, const char* needle) {
  49:Source/html/selftest_readability.c ****     if (d == NULL) return 0;
  50:Source/html/selftest_readability.c ****     for (size_t i = 0; i < d->nBlocks; i++) {
  51:Source/html/selftest_readability.c ****         const DocBlock* b = &d->blocks[i];
  52:Source/html/selftest_readability.c ****         if (b->codeText != NULL && strstr(b->codeText, needle)) return 1;
  53:Source/html/selftest_readability.c ****         if (b->alt != NULL && strstr(b->alt, needle)) return 1;
  54:Source/html/selftest_readability.c ****         for (size_t k = 0; k < b->nInlines; k++)
  55:Source/html/selftest_readability.c ****             if (b->inlines[k].text != NULL &&
  56:Source/html/selftest_readability.c ****                 strstr(b->inlines[k].text, needle)) return 1;
  57:Source/html/selftest_readability.c ****     }
  58:Source/html/selftest_readability.c ****     return 0;
  59:Source/html/selftest_readability.c **** }
