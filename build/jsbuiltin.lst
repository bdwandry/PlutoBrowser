 127:Source/js/jsbuiltin.c **** static void Decode(js_State *J, const char *str_, const char *reserved)
 128:Source/js/jsbuiltin.c **** {
 129:Source/js/jsbuiltin.c **** 	/* NOTE: volatile to silence GCC warning about longjmp clobbering a variable */
 130:Source/js/jsbuiltin.c **** 	const char * volatile str = str_;
