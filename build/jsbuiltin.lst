 144:Source/js/jsbuiltin.c **** 			if (!str[0] || !str[1])
 145:Source/js/jsbuiltin.c **** 				js_urierror(J, "truncated escape sequence");
 146:Source/js/jsbuiltin.c **** 			a = *str++;
