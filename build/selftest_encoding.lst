   2:src/core/selftest_encoding.c **** //
   3:src/core/selftest_encoding.c **** // Every expectation mirrors observable behavior of Source/core/encoding.lua
   4:src/core/selftest_encoding.c **** // and Source/html/entities.lua captured via the host-Lua oracle
   5:src/core/selftest_encoding.c **** // (p06_oracle.lua -> p06_truth.txt): CP1252 table edges (0x81 self-map,
   6:src/core/selftest_encoding.c **** // 0x7F raw), UTF-16 lone-high-surrogate consuming the next unit, quoted
   7:src/core/selftest_encoding.c **** // header charset values FAILING the Lua pattern, meta-scan 1024-byte window,
   8:src/core/selftest_encoding.c **** // header-beats-meta precedence (unless header is utf-8), entity fast path,
   9:src/core/selftest_encoding.c **** // hex/decimal special-case asymmetry (0x201A/0x201E missing from hex),
  10:src/core/selftest_encoding.c **** // per-byte emoji widening, truncated-tail handling.
