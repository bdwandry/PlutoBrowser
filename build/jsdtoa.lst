 538:Source/js/jsdtoa.c **** /* Table giving binary powers of 10. Entry
 539:Source/js/jsdtoa.c ****  * is 10^2^i. Used to convert decimal
 540:Source/js/jsdtoa.c ****  * exponents into floating-point numbers.
 541:Source/js/jsdtoa.c ****  */
 542:Source/js/jsdtoa.c **** static double powersOf10[] = {
 543:Source/js/jsdtoa.c **** 	10.,
 544:Source/js/jsdtoa.c **** 	100.,
 545:Source/js/jsdtoa.c **** 	1.0e4,
 546:Source/js/jsdtoa.c **** 	1.0e8,
 547:Source/js/jsdtoa.c **** 	1.0e16,
 548:Source/js/jsdtoa.c **** 	1.0e32,
 549:Source/js/jsdtoa.c **** 	1.0e64,
