 408:Source/js/jsdtoa.c **** static uint64_t double_to_uint64(double d)
 409:Source/js/jsdtoa.c **** {
 410:Source/js/jsdtoa.c **** 	uint64_t n;
 411:Source/js/jsdtoa.c **** 	memcpy(&n, &d, 8);
 412:Source/js/jsdtoa.c **** 	return n;
 413:Source/js/jsdtoa.c **** }
 414:Source/js/jsdtoa.c **** 
 415:Source/js/jsdtoa.c **** #define DP_SIGNIFICAND_SIZE 52
 416:Source/js/jsdtoa.c **** #define DP_EXPONENT_BIAS (0x3FF + DP_SIGNIFICAND_SIZE)
 417:Source/js/jsdtoa.c **** #define DP_MIN_EXPONENT (-DP_EXPONENT_BIAS)
 418:Source/js/jsdtoa.c **** #define DP_EXPONENT_MASK 0x7FF0000000000000
 419:Source/js/jsdtoa.c **** #define DP_SIGNIFICAND_MASK 0x000FFFFFFFFFFFFF
 420:Source/js/jsdtoa.c **** #define DP_HIDDEN_BIT 0x0010000000000000
 421:Source/js/jsdtoa.c **** 
 422:Source/js/jsdtoa.c **** static diy_fp_t double2diy_fp(double d)
 423:Source/js/jsdtoa.c **** {
 424:Source/js/jsdtoa.c **** 	uint64_t d64 = double_to_uint64(d);
 425:Source/js/jsdtoa.c **** 	int biased_e = (d64 & DP_EXPONENT_MASK) >> DP_SIGNIFICAND_SIZE;
 426:Source/js/jsdtoa.c **** 	uint64_t significand = (d64 & DP_SIGNIFICAND_MASK);
 427:Source/js/jsdtoa.c **** 	diy_fp_t res;
 428:Source/js/jsdtoa.c **** 	if (biased_e != 0) {
 429:Source/js/jsdtoa.c **** 		res.f = significand + DP_HIDDEN_BIT;
 430:Source/js/jsdtoa.c **** 		res.e = biased_e - DP_EXPONENT_BIAS;
 431:Source/js/jsdtoa.c **** 	} else {
 432:Source/js/jsdtoa.c **** 		res.f = significand;
 433:Source/js/jsdtoa.c **** 		res.e = DP_MIN_EXPONENT + 1;
 434:Source/js/jsdtoa.c **** 	}
 435:Source/js/jsdtoa.c **** 	return res;
 436:Source/js/jsdtoa.c **** }
 437:Source/js/jsdtoa.c **** 
 438:Source/js/jsdtoa.c **** static diy_fp_t normalize_boundary(diy_fp_t in)
 439:Source/js/jsdtoa.c **** {
 440:Source/js/jsdtoa.c **** 	diy_fp_t res = in;
 441:Source/js/jsdtoa.c **** 	/* Normalize now */
 442:Source/js/jsdtoa.c **** 	/* the original number could have been a denormal. */
 443:Source/js/jsdtoa.c **** 	while (! (res.f & (DP_HIDDEN_BIT << 1))) {
 444:Source/js/jsdtoa.c **** 		res.f <<= 1;
 445:Source/js/jsdtoa.c **** 		res.e--;
 446:Source/js/jsdtoa.c **** 	}
 447:Source/js/jsdtoa.c **** 	/* do the final shifts in one go. Don't forget the hidden bit (the '-1') */
 448:Source/js/jsdtoa.c **** 	res.f <<= (DIY_SIGNIFICAND_SIZE - DP_SIGNIFICAND_SIZE - 2);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc7yFwYj.s 			page 15


 449:Source/js/jsdtoa.c **** 	res.e = res.e - (DIY_SIGNIFICAND_SIZE - DP_SIGNIFICAND_SIZE - 2);
 450:Source/js/jsdtoa.c **** 	return res;
 451:Source/js/jsdtoa.c **** }
 452:Source/js/jsdtoa.c **** 
 453:Source/js/jsdtoa.c **** static void normalized_boundaries(double d, diy_fp_t* out_m_minus, diy_fp_t* out_m_plus)
 454:Source/js/jsdtoa.c **** {
 455:Source/js/jsdtoa.c **** 	diy_fp_t v = double2diy_fp(d);
 456:Source/js/jsdtoa.c **** 	diy_fp_t pl, mi;
 457:Source/js/jsdtoa.c **** 	int significand_is_zero = v.f == DP_HIDDEN_BIT;
 458:Source/js/jsdtoa.c **** 	pl.f = (v.f << 1) + 1; pl.e = v.e - 1;
 459:Source/js/jsdtoa.c **** 	pl = normalize_boundary(pl);
 460:Source/js/jsdtoa.c **** 	if (significand_is_zero) {
 461:Source/js/jsdtoa.c **** 		mi.f = (v.f << 2) - 1;
 462:Source/js/jsdtoa.c **** 		mi.e = v.e - 2;
 463:Source/js/jsdtoa.c **** 	} else {
 464:Source/js/jsdtoa.c **** 		mi.f = (v.f << 1) - 1;
 465:Source/js/jsdtoa.c **** 		mi.e = v.e - 1;
 466:Source/js/jsdtoa.c **** 	}
 467:Source/js/jsdtoa.c **** 	mi.f <<= mi.e - pl.e;
 468:Source/js/jsdtoa.c **** 	mi.e = pl.e;
 469:Source/js/jsdtoa.c **** 	*out_m_plus = pl;
 470:Source/js/jsdtoa.c **** 	*out_m_minus = mi;
 471:Source/js/jsdtoa.c **** }
