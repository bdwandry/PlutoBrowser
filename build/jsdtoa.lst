 473:Source/js/jsdtoa.c **** #define TEN2 100
 474:Source/js/jsdtoa.c **** static void digit_gen(diy_fp_t Mp, diy_fp_t delta, char* buffer, int* len, int* K)
 475:Source/js/jsdtoa.c **** {
 476:Source/js/jsdtoa.c **** 	uint32_t div, p1;
 477:Source/js/jsdtoa.c **** 	uint64_t p2;
 478:Source/js/jsdtoa.c **** 	int d,kappa;
 479:Source/js/jsdtoa.c **** 	diy_fp_t one;
 480:Source/js/jsdtoa.c **** 	one.f = ((uint64_t) 1) << -Mp.e; one.e = Mp.e;
 481:Source/js/jsdtoa.c **** 	p1 = Mp.f >> -one.e;
 482:Source/js/jsdtoa.c **** 	p2 = Mp.f & (one.f - 1);
 483:Source/js/jsdtoa.c **** 	*len = 0; kappa = 3; div = TEN2;
 484:Source/js/jsdtoa.c **** 	while (kappa > 0) {
 485:Source/js/jsdtoa.c **** 		d = p1 / div;
 486:Source/js/jsdtoa.c **** 		if (d || *len) buffer[(*len)++] = '0' + d;
 487:Source/js/jsdtoa.c **** 		p1 %= div; kappa--; div /= 10;
 488:Source/js/jsdtoa.c **** 		if ((((uint64_t)p1)<<-one.e)+p2 <= delta.f) {
 489:Source/js/jsdtoa.c **** 			*K += kappa; return;
 490:Source/js/jsdtoa.c **** 		}
 491:Source/js/jsdtoa.c **** 	}
 492:Source/js/jsdtoa.c **** 	do {
 493:Source/js/jsdtoa.c **** 		p2 *= 10;
 494:Source/js/jsdtoa.c **** 		d = p2 >> -one.e;
 495:Source/js/jsdtoa.c **** 		if (d || *len) buffer[(*len)++] = '0' + d;
 496:Source/js/jsdtoa.c **** 		p2 &= one.f - 1; kappa--; delta.f *= 10;
 497:Source/js/jsdtoa.c **** 	} while (p2 > delta.f);
 498:Source/js/jsdtoa.c **** 	*K += kappa;
 499:Source/js/jsdtoa.c **** }
