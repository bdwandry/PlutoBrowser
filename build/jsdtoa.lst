 370:Source/js/jsdtoa.c **** static diy_fp_t cached_power(int k)
 371:Source/js/jsdtoa.c **** {
 372:Source/js/jsdtoa.c **** 	diy_fp_t res;
 373:Source/js/jsdtoa.c **** 	int index = 343 + k;
 374:Source/js/jsdtoa.c **** 	res.f = powers_ten[index];
 375:Source/js/jsdtoa.c **** 	res.e = powers_ten_e[index];
 376:Source/js/jsdtoa.c **** 	return res;
 377:Source/js/jsdtoa.c **** }
 378:Source/js/jsdtoa.c **** 
 379:Source/js/jsdtoa.c **** static int k_comp(int e, int alpha, int gamma) {
 380:Source/js/jsdtoa.c **** 	return ceil((alpha-e+63) * D_1_LOG2_10);
 381:Source/js/jsdtoa.c **** }
 382:Source/js/jsdtoa.c **** 
 383:Source/js/jsdtoa.c **** static diy_fp_t minus(diy_fp_t x, diy_fp_t y)
 384:Source/js/jsdtoa.c **** {
 385:Source/js/jsdtoa.c **** 	diy_fp_t r;
 386:Source/js/jsdtoa.c **** 	assert(x.e == y.e);
 387:Source/js/jsdtoa.c **** 	assert(x.f >= y.f);
 388:Source/js/jsdtoa.c **** 	r.f = x.f - y.f;
 389:Source/js/jsdtoa.c **** 	r.e = x.e;
 390:Source/js/jsdtoa.c **** 	return r;
 391:Source/js/jsdtoa.c **** }
