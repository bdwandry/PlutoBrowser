 393:Source/js/jsdtoa.c **** static diy_fp_t multiply(diy_fp_t x, diy_fp_t y)
 394:Source/js/jsdtoa.c **** {
 395:Source/js/jsdtoa.c **** 	uint64_t a,b,c,d,ac,bc,ad,bd,tmp;
 396:Source/js/jsdtoa.c **** 	diy_fp_t r;
 397:Source/js/jsdtoa.c **** 	uint64_t M32 = 0xFFFFFFFF;
 398:Source/js/jsdtoa.c **** 	a = x.f >> 32; b = x.f & M32;
 399:Source/js/jsdtoa.c **** 	c = y.f >> 32; d = y.f & M32;
 400:Source/js/jsdtoa.c **** 	ac = a*c; bc = b*c; ad = a*d; bd = b*d;
 401:Source/js/jsdtoa.c **** 	tmp = (bd>>32) + (ad&M32) + (bc&M32);
 402:Source/js/jsdtoa.c **** 	tmp += 1U << 31;
 403:Source/js/jsdtoa.c **** 	r.f = ac+(ad>>32)+(bc>>32)+(tmp >>32);
 404:Source/js/jsdtoa.c **** 	r.e = x.e + y.e + 64;
 405:Source/js/jsdtoa.c **** 	return r;
 406:Source/js/jsdtoa.c **** }
