 249:Source/render/decoders/ico.c **** 
 250:Source/render/decoders/ico.c **** /* Best entry: largest area, then highest bit depth (matches Chromium).
 251:Source/render/decoders/ico.c ****  * Equal area+bpp keeps file order (stable tie-break). */
 252:Source/render/decoders/ico.c **** static int entry_cmp(const void* pa, const void* pb) {
 253:Source/render/decoders/ico.c ****     const IcoEntry* a = (const IcoEntry*)pa;
 254:Source/render/decoders/ico.c ****     const IcoEntry* b = (const IcoEntry*)pb;
 255:Source/render/decoders/ico.c ****     long areaA = (long)a->w * (long)a->h;
 256:Source/render/decoders/ico.c ****     long areaB = (long)b->w * (long)b->h;
 257:Source/render/decoders/ico.c ****     if (areaA != areaB) return areaA > areaB ? -1 : 1;
 258:Source/render/decoders/ico.c ****     if (a->bpp != b->bpp) return a->bpp > b->bpp ? -1 : 1;
 259:Source/render/decoders/ico.c ****     return 0;
 260:Source/render/decoders/ico.c **** }
