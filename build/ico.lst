  39:Source/render/decoders/ico.c **** /* Lua composite(gray, a): alpha toward white, half-up. */
  40:Source/render/decoders/ico.c **** static uint8_t ico_composite(int gray, int a)
  41:Source/render/decoders/ico.c **** {
  42:Source/render/decoders/ico.c ****     if (a >= 255)
  43:Source/render/decoders/ico.c ****     {
  44:Source/render/decoders/ico.c ****         return (uint8_t)gray;
  45:Source/render/decoders/ico.c ****     }
  46:Source/render/decoders/ico.c ****     if (a <= 0)
  47:Source/render/decoders/ico.c ****     {
  48:Source/render/decoders/ico.c ****         return 255;
  49:Source/render/decoders/ico.c ****     }
  50:Source/render/decoders/ico.c ****     return (uint8_t)((gray * a + 255 * (255 - a)) / 255 + 0.5);
  51:Source/render/decoders/ico.c **** }
