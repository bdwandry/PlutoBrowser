 262:Source/render/decoders/ico.c **** int ico_decode_gray(const uint8_t* data, size_t len,
 263:Source/render/decoders/ico.c ****                     int maxW, int maxH,
 264:Source/render/decoders/ico.c ****                     uint8_t*** outRows, int* outW, int* outH) {
 265:Source/render/decoders/ico.c ****     unsigned reserved, fileType, count, i;
 266:Source/render/decoders/ico.c ****     IcoEntry* entries = NULL;
 267:Source/render/decoders/ico.c ****     int nEntries = 0;
 268:Source/render/decoders/ico.c **** 
 269:Source/render/decoders/ico.c ****     if (outRows == NULL || outW == NULL || outH == NULL) return -1;
 270:Source/render/decoders/ico.c ****     *outRows = NULL;
 271:Source/render/decoders/ico.c ****     *outW = *outH = 0;
 272:Source/render/decoders/ico.c ****     if (data == NULL || len < 22) return -1;
 273:Source/render/decoders/ico.c ****     if (maxW <= 0) maxW = 360;
 274:Source/render/decoders/ico.c ****     if (maxH <= 0) maxH = 200;
 275:Source/render/decoders/ico.c **** 
 276:Source/render/decoders/ico.c ****     /* ICONDIR: reserved(2)=0, type(2): 1=icon, 2=cursor, count(2) */
 277:Source/render/decoders/ico.c ****     reserved = rd16le(data, len, 0);
 278:Source/render/decoders/ico.c ****     fileType = rd16le(data, len, 2);
 279:Source/render/decoders/ico.c ****     count = rd16le(data, len, 4);
 280:Source/render/decoders/ico.c ****     if (reserved != 0 || (fileType != 1 && fileType != 2) || count == 0)
 281:Source/render/decoders/ico.c ****         return -1;
 282:Source/render/decoders/ico.c **** 
 283:Source/render/decoders/ico.c ****     entries = (IcoEntry*)pluto_malloc(sizeof(IcoEntry) * count);
 284:Source/render/decoders/ico.c ****     if (entries == NULL) return -1;
 285:Source/render/decoders/ico.c ****     for (i = 0; i < count; i++) {
 286:Source/render/decoders/ico.c ****         size_t base = 6 + (size_t)i * 16;   /* Lua 7 + i*16 */
 287:Source/render/decoders/ico.c ****         IcoEntry e;
 288:Source/render/decoders/ico.c ****         int w = byte_at_or(data, len, base, 0);
 289:Source/render/decoders/ico.c ****         int h = byte_at_or(data, len, base + 1, 0);
 290:Source/render/decoders/ico.c ****         if (w == 0) w = 256;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccXatfv9.s 			page 9


 291:Source/render/decoders/ico.c ****         if (h == 0) h = 256;
 292:Source/render/decoders/ico.c ****         e.w = w;
 293:Source/render/decoders/ico.c ****         e.h = h;
 294:Source/render/decoders/ico.c ****         e.bpp = (fileType == 1)
 295:Source/render/decoders/ico.c ****                     ? (int)rd16le(data, len, base + 6) : 0;
 296:Source/render/decoders/ico.c ****         e.size = rd32le(data, len, base + 8);
 297:Source/render/decoders/ico.c ****         e.offset = rd32le(data, len, base + 12);
 298:Source/render/decoders/ico.c ****         if (e.offset > 0 && e.size > 0 &&
 299:Source/render/decoders/ico.c ****             (size_t)e.offset + (size_t)e.size <= len)
 300:Source/render/decoders/ico.c ****             entries[nEntries++] = e;
 301:Source/render/decoders/ico.c ****     }
 302:Source/render/decoders/ico.c ****     if (nEntries == 0) {
 303:Source/render/decoders/ico.c ****         pluto_free(entries);
 304:Source/render/decoders/ico.c ****         return -1;
 305:Source/render/decoders/ico.c ****     }
 306:Source/render/decoders/ico.c ****     qsort(entries, (size_t)nEntries, sizeof(IcoEntry), entry_cmp);
 307:Source/render/decoders/ico.c **** 
 308:Source/render/decoders/ico.c ****     /* Try each entry in order until one decodes successfully. */
 309:Source/render/decoders/ico.c ****     {
 310:Source/render/decoders/ico.c ****         int j;
 311:Source/render/decoders/ico.c ****         for (j = 0; j < nEntries; j++) {
 312:Source/render/decoders/ico.c ****             const IcoEntry* e = &entries[j];
 313:Source/render/decoders/ico.c ****             const uint8_t* chunk = data + e->offset;
 314:Source/render/decoders/ico.c ****             if (chunk[0] == 0x89 && chunk[1] == 0x50 &&
 315:Source/render/decoders/ico.c ****                 chunk[2] == 0x4E && chunk[3] == 0x47) {
 316:Source/render/decoders/ico.c ****                 /* pcall-style containment: a failed PNG entry just
 317:Source/render/decoders/ico.c ****                  * falls through to the next one */
 318:Source/render/decoders/ico.c ****                 uint8_t** rows = NULL;
 319:Source/render/decoders/ico.c ****                 int w = 0, h = 0;
 320:Source/render/decoders/ico.c ****                 if (png_decode_gray(chunk, e->size, maxW, maxH,
 321:Source/render/decoders/ico.c ****                                     &rows, &w, &h) == 0 && rows) {
 322:Source/render/decoders/ico.c ****                     pluto_free(entries);
 323:Source/render/decoders/ico.c ****                     *outRows = rows;
 324:Source/render/decoders/ico.c ****                     *outW = w;
 325:Source/render/decoders/ico.c ****                     *outH = h;
 326:Source/render/decoders/ico.c ****                     return 0;
 327:Source/render/decoders/ico.c ****                 }
 328:Source/render/decoders/ico.c ****             } else {
 329:Source/render/decoders/ico.c ****                 uint8_t** rows = NULL;
 330:Source/render/decoders/ico.c ****                 int w = 0, h = 0;
 331:Source/render/decoders/ico.c ****                 if (ico_decode_dib(chunk, e->size, maxW, maxH,
 332:Source/render/decoders/ico.c ****                                    &rows, &w, &h) == 0 && rows) {
 333:Source/render/decoders/ico.c ****                     pluto_free(entries);
 334:Source/render/decoders/ico.c ****                     *outRows = rows;
 335:Source/render/decoders/ico.c ****                     *outW = w;
 336:Source/render/decoders/ico.c ****                     *outH = h;
 337:Source/render/decoders/ico.c ****                     return 0;
 338:Source/render/decoders/ico.c ****                 }
 339:Source/render/decoders/ico.c ****             }
 340:Source/render/decoders/ico.c ****         }
 341:Source/render/decoders/ico.c ****     }
 342:Source/render/decoders/ico.c ****     pluto_free(entries);
 343:Source/render/decoders/ico.c ****     return -1;
 344:Source/render/decoders/ico.c **** }
