  99:Source/ui/selftest_ui.c **** static void case_scrollbar(void) {
 100:Source/ui/selftest_ui.c ****     int y = -99, h = -99;
 101:Source/ui/selftest_ui.c **** 
 102:Source/ui/selftest_ui.c ****     hd_scrollbar_thumb(216.0, 10, &y, &h);
 103:Source/ui/selftest_ui.c ****     ck("S.no_bar_at_content_h", y == -1 && h == -1);
 104:Source/ui/selftest_ui.c ****     hd_scrollbar_thumb(100.0, 0, &y, &h);
 105:Source/ui/selftest_ui.c ****     ck("S.no_bar_short_page", y == -1 && h == -1);
 106:Source/ui/selftest_ui.c **** 
 107:Source/ui/selftest_ui.c ****     hd_scrollbar_thumb(432.0, 108, &y, &h);
 108:Source/ui/selftest_ui.c ****     /* trackH=212; thumbH=floor(212*216/432)=106; ratio=.5 ->
 109:Source/ui/selftest_ui.c ****      * thumbY=26+floor(106*.5)=79 */
 110:Source/ui/selftest_ui.c ****     ck("S.double_height_mid", h == 106 && y == 79);
 111:Source/ui/selftest_ui.c **** 
 112:Source/ui/selftest_ui.c ****     hd_scrollbar_thumb(432.0, -50, &y, &h);
 113:Source/ui/selftest_ui.c ****     ck("S.clamp_negative", y == 26 && h == 106);
 114:Source/ui/selftest_ui.c **** 
 115:Source/ui/selftest_ui.c ****     hd_scrollbar_thumb(432.0, 9999, &y, &h);
 116:Source/ui/selftest_ui.c ****     ck("S.clamp_over", y == 26 + (212 - 106) && h == 106);
 117:Source/ui/selftest_ui.c **** 
 118:Source/ui/selftest_ui.c ****     /* huge page -> minimum thumb height 12 */
 119:Source/ui/selftest_ui.c ****     hd_scrollbar_thumb(100000.0, 49892, &y, &h);
 120:Source/ui/selftest_ui.c ****     /* maxScroll=99784; ratio≈0.5 -> 26+floor((212-12)*ratio) */
 121:Source/ui/selftest_ui.c ****     ck("S.min_thumb_h", h == 12 && y >= 26 && y <= 26 + 200);
 122:Source/ui/selftest_ui.c **** }
