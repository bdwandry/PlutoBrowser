  78:Source/ui/selftest_ui.c **** /* ── loading animation + progress math ──────────────────�
  79:Source/ui/selftest_ui.c **** 
  80:Source/ui/selftest_ui.c **** static void case_anim_progress(void) {
  81:Source/ui/selftest_ui.c ****     int ok = 1;
  82:Source/ui/selftest_ui.c ****     for (int f = 0; f <= 3; f++) ok = ok && (ch_comet_group(f) == 0);
  83:Source/ui/selftest_ui.c ****     for (int f = 4; f <= 7; f++) ok = ok && (ch_comet_group(f) == 1);
  84:Source/ui/selftest_ui.c ****     for (int f = 8; f <= 11; f++) ok = ok && (ch_comet_group(f) == 2);
  85:Source/ui/selftest_ui.c ****     ok = ok && (ch_comet_group(12) == 0) && (ch_comet_group(23) == 2) &&
  86:Source/ui/selftest_ui.c ****          (ch_comet_group(24) == 0); /* 24 % 12 == 0 */
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccUo5btI.s 			page 11


  87:Source/ui/selftest_ui.c ****     ck("A.comet_groups_12phase", ok);
  88:Source/ui/selftest_ui.c **** 
  89:Source/ui/selftest_ui.c ****     ck("P.known_half", ch_progress_ratio(100, 200, 7) == 0.5);
  90:Source/ui/selftest_ui.c ****     ck("P.known_clamp_over", ch_progress_ratio(500, 200, 0) == 1.0);
  91:Source/ui/selftest_ui.c ****     ck("P.indet_frame0", ch_progress_ratio(0, 0, 0) == 0.0);
  92:Source/ui/selftest_ui.c ****     /* ((33*3)%100)/100 = 99/100 ; ((34*3)%100)=2 */
  93:Source/ui/selftest_ui.c ****     ck("P.indet_frame33", ch_progress_ratio(0, 0, 33) == 0.99);
  94:Source/ui/selftest_ui.c ****     ck("P.indet_wrap34", ch_progress_ratio(0, 0, 34) == 0.02);
  95:Source/ui/selftest_ui.c **** }
