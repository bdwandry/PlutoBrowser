  80:src/ui/selftest_ui.c **** static void case_anim_progress(void) {
  81:src/ui/selftest_ui.c ****     int ok = 1;
  82:src/ui/selftest_ui.c ****     for (int f = 0; f <= 3; f++) ok = ok && (ch_comet_group(f) == 0);
