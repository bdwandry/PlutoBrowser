 119:src/ui/selftest_ui.c ****     hd_scrollbar_thumb(100000.0, 49892, &y, &h);
 120:src/ui/selftest_ui.c ****     /* maxScroll=99784; ratio≈0.5 -> 26+floor((212-12)*ratio) */
 121:src/ui/selftest_ui.c ****     ck("S.min_thumb_h", h == 12 && y >= 26 && y <= 26 + 200);
