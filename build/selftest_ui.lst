  84:src/ui/selftest_ui.c ****     for (int f = 8; f <= 11; f++) ok = ok && (ch_comet_group(f) == 2);
  85:src/ui/selftest_ui.c ****     ok = ok && (ch_comet_group(12) == 0) && (ch_comet_group(23) == 2) &&
  86:src/ui/selftest_ui.c ****          (ch_comet_group(24) == 0); /* 24 % 12 == 0 */
  87:src/ui/selftest_ui.c ****     ck("A.comet_groups_12phase", ok);
