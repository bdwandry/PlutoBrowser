 189:Source/render/decoders/selftest_ico.c ****                              &rows, &w, &h) == 0 && rows != NULL;
 190:Source/render/decoders/selftest_ico.c ****     ck("B.smoke_266x200", ok && w == FX_I_I_SCALED_W &&
 191:Source/render/decoders/selftest_ico.c ****                             h == FX_I_I_SCALED_H &&
 192:Source/render/decoders/selftest_ico.c ****                             fnv_rows(rows, w, h) == FX_I_I_SCALED_CK);
 193:Source/render/decoders/selftest_ico.c ****     if (rows) ico_free_rows(rows, h);
 194:Source/render/decoders/selftest_ico.c **** 
 195:Source/render/decoders/selftest_ico.c **** #if defined(TARGET_PLAYDATE)
 196:Source/render/decoders/selftest_ico.c ****     if (s_pd != NULL) {
 197:Source/render/decoders/selftest_ico.c ****         float t0 = s_pd->system->getElapsedTime();
 198:Source/render/decoders/selftest_ico.c ****         for (it = 0; it < iters; it++) {
 199:Source/render/decoders/selftest_ico.c ****             rows = NULL;
 200:Source/render/decoders/selftest_ico.c ****             if (ico_decode_gray(fx_i_scaled, FX_I_I_SCALED_LEN,
 201:Source/render/decoders/selftest_ico.c ****                                 360, 200, &rows, &w, &h) == 0)
 202:Source/render/decoders/selftest_ico.c ****                 ico_free_rows(rows, h);
 203:Source/render/decoders/selftest_ico.c ****             else
 204:Source/render/decoders/selftest_ico.c ****                 break;
 205:Source/render/decoders/selftest_ico.c ****         }
 206:Source/render/decoders/selftest_ico.c ****         ms = (double)(s_pd->system->getElapsedTime() - t0) * 1000.0;
 207:Source/render/decoders/selftest_ico.c ****     } else {
 208:Source/render/decoders/selftest_ico.c ****         it = iters;
 209:Source/render/decoders/selftest_ico.c ****     }
 210:Source/render/decoders/selftest_ico.c **** #else
 211:Source/render/decoders/selftest_ico.c ****     {
 212:Source/render/decoders/selftest_ico.c ****         struct timespec t0, t1;
 213:Source/render/decoders/selftest_ico.c ****         clock_gettime(CLOCK_MONOTONIC, &t0);
 214:Source/render/decoders/selftest_ico.c ****         for (it = 0; it < iters; it++) {
 215:Source/render/decoders/selftest_ico.c ****             rows = NULL;
 216:Source/render/decoders/selftest_ico.c ****             if (ico_decode_gray(fx_i_scaled, FX_I_I_SCALED_LEN,
 217:Source/render/decoders/selftest_ico.c ****                                 360, 200, &rows, &w, &h) == 0)
 218:Source/render/decoders/selftest_ico.c ****                 ico_free_rows(rows, h);
 219:Source/render/decoders/selftest_ico.c ****             else
 220:Source/render/decoders/selftest_ico.c ****                 break;
 221:Source/render/decoders/selftest_ico.c ****         }
