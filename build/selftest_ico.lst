  80:Source/render/decoders/selftest_ico.c **** static unsigned fnv_rows(uint8_t** rows, int w, int h) {
  81:Source/render/decoders/selftest_ico.c ****     unsigned hsh = FNV_OFFSET;
  82:Source/render/decoders/selftest_ico.c ****     int x, y;
  83:Source/render/decoders/selftest_ico.c ****     for (y = 0; y < h; y++)
  84:Source/render/decoders/selftest_ico.c ****         for (x = 0; x < w; x++) {
  85:Source/render/decoders/selftest_ico.c ****             hsh ^= rows[y][x];
  86:Source/render/decoders/selftest_ico.c ****             hsh *= FNV_PRIME;
  87:Source/render/decoders/selftest_ico.c ****         }
  88:Source/render/decoders/selftest_ico.c ****     return hsh;
  89:Source/render/decoders/selftest_ico.c **** }
