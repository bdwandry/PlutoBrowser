 183:Source/render/decoders/selftest_ico.c **** static void case_bench(void) {
 184:Source/render/decoders/selftest_ico.c ****     uint8_t** rows = NULL;
 185:Source/render/decoders/selftest_ico.c ****     int w = 0, h = 0;
