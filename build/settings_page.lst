 104:src/ui/settings_page.c **** /* Row 1: Search Engine cycle — Lua ((v-2+n)%n)+1 / (v%n)+1 */
 105:src/ui/settings_page.c **** static void cycle_engine(int dir) {
 106:src/ui/settings_page.c ****     const int n = PLUTO_SEARCH_ENGINE_COUNT;
 107:src/ui/settings_page.c ****     int v = s_staged.searchEngine;
 108:src/ui/settings_page.c ****     if (dir < 0) {
 109:src/ui/settings_page.c ****         v = ((v - 2 + n) % n) + 1;
 110:src/ui/settings_page.c ****     } else {
 111:src/ui/settings_page.c ****         v = (v % n) + 1;
 112:src/ui/settings_page.c ****     }
 113:src/ui/settings_page.c ****     s_staged.searchEngine = v;
 114:src/ui/settings_page.c **** }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc8XxjlC.s 			page 16


 115:src/ui/settings_page.c **** 
 116:src/ui/settings_page.c **** /* Row 2: Browse Mode toggle (both directions identical in Lua) */
 117:src/ui/settings_page.c **** static void toggle_mode(void) {
 118:src/ui/settings_page.c ****     s_staged.mode = (s_staged.mode == (int)PLUTO_MODE_RAW_HTML)
 119:src/ui/settings_page.c ****                         ? (int)PLUTO_MODE_READER
 120:src/ui/settings_page.c ****                         : (int)PLUTO_MODE_RAW_HTML;
 121:src/ui/settings_page.c **** }
 122:src/ui/settings_page.c **** 
 123:src/ui/settings_page.c **** /* Row 3: Invert Crank toggle */
 124:src/ui/settings_page.c **** static void toggle_invert(void) {
 125:src/ui/settings_page.c ****     s_staged.invertCrank = !s_staged.invertCrank;
 126:src/ui/settings_page.c **** }
 127:src/ui/settings_page.c **** 
 128:src/ui/settings_page.c **** /* Row 4: Image Mode cycle in IMAGE_MODE_NAMES order (enum order) */
 129:src/ui/settings_page.c **** static void cycle_image_mode(int dir) {
 130:src/ui/settings_page.c ****     const int n = (int)PLUTO_IMAGE_MODE_DISABLED + 1;
 131:src/ui/settings_page.c ****     int v = s_staged.imageMode;
 132:src/ui/settings_page.c ****     v += (dir < 0) ? -1 : 1;
 133:src/ui/settings_page.c ****     if (v < 0) v += n;
 134:src/ui/settings_page.c ****     if (v >= n) v -= n;
 135:src/ui/settings_page.c ****     s_staged.imageMode = v;
 136:src/ui/settings_page.c **** }
 137:src/ui/settings_page.c **** 
 138:src/ui/settings_page.c **** /* Row 5: Clear Cookies action (immediate, both directions) */
 139:src/ui/settings_page.c **** static void clear_cookies(void) {
 140:src/ui/settings_page.c ****     cj_clear();
 141:src/ui/settings_page.c ****     PLUTO_LOG("[P31] cookies cleared");
 142:src/ui/settings_page.c **** }
 143:src/ui/settings_page.c **** 
 144:src/ui/settings_page.c **** static SpAction save_and_close(void) {
 145:src/ui/settings_page.c ****     PlutoSettings* st = storage_settings();
 146:src/ui/settings_page.c ****     if (st != NULL) {
 147:src/ui/settings_page.c ****         st->searchEngine = s_staged.searchEngine;
 148:src/ui/settings_page.c ****         st->mode = s_staged.mode;
 149:src/ui/settings_page.c ****         st->invertCrank = s_staged.invertCrank;
 150:src/ui/settings_page.c ****         st->imageMode = s_staged.imageMode;
 151:src/ui/settings_page.c ****     }
 152:src/ui/settings_page.c ****     storage_save();
 153:src/ui/settings_page.c ****     if (s_onChange != NULL) {
 154:src/ui/settings_page.c ****         s_onChange();
 155:src/ui/settings_page.c ****     }
 156:src/ui/settings_page.c ****     PLUTO_LOG("[P31] saveAndClose: mode=%d imageMode=%d", s_staged.mode,
 157:src/ui/settings_page.c ****               s_staged.imageMode);
 158:src/ui/settings_page.c ****     sp_close();
 159:src/ui/settings_page.c ****     return SP_ACT_SAVED;
 160:src/ui/settings_page.c **** }
