  87:Source/ui/settings_page.c **** 
  88:Source/ui/settings_page.c **** /* Height available for the row list inside the fixed panel. */
  89:Source/ui/settings_page.c **** static int settings_list_height(void)
  90:Source/ui/settings_page.c **** {
  91:Source/ui/settings_page.c ****     return BOX_H - 20 /* panel inner margins */ - SETTINGS_TITLE_H -
  92:Source/ui/settings_page.c ****            SETTINGS_FOOTER_H;
  93:Source/ui/settings_page.c **** }
  94:Source/ui/settings_page.c **** 
  95:Source/ui/settings_page.c **** /* Max scroll offset: the bottom of the LAST row must sit at the list bottom.
  96:Source/ui/settings_page.c ****  * Both edges are in content space (measured from the panel's inner top). */
  97:Source/ui/settings_page.c **** static int settings_max_scroll(void)
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccYvzJUe.s 			page 6


  98:Source/ui/settings_page.c **** {
  99:Source/ui/settings_page.c ****     int contentBottom = SETTINGS_TITLE_H +
 100:Source/ui/settings_page.c ****                         (OPTION_COUNT - 1) * SETTINGS_ROW_PITCH +
 101:Source/ui/settings_page.c ****                         SETTINGS_ITEM_H;
 102:Source/ui/settings_page.c ****     int windowBottom = SETTINGS_TITLE_H + settings_list_height();
 103:Source/ui/settings_page.c ****     return contentBottom > windowBottom ? contentBottom - windowBottom : 0;
 104:Source/ui/settings_page.c **** }
 105:Source/ui/settings_page.c **** 
 106:Source/ui/settings_page.c **** /* Clamp the scroll so the SELECTED row is always fully visible (keeps D-pad
 107:Source/ui/settings_page.c ****  * and crank scrolling consistent). */
 108:Source/ui/settings_page.c **** static int settings_clamped_scroll(void)
 109:Source/ui/settings_page.c **** {
 110:Source/ui/settings_page.c ****     int maxScroll = settings_max_scroll();
 111:Source/ui/settings_page.c ****     int scroll = g_scrollOffset;
 112:Source/ui/settings_page.c ****     if (scroll > maxScroll)
 113:Source/ui/settings_page.c ****     {
 114:Source/ui/settings_page.c ****         scroll = maxScroll;
 115:Source/ui/settings_page.c ****     }
 116:Source/ui/settings_page.c ****     if (scroll < 0)
 117:Source/ui/settings_page.c ****     {
 118:Source/ui/settings_page.c ****         scroll = 0;
 119:Source/ui/settings_page.c ****     }
 120:Source/ui/settings_page.c ****     /* keep the selected row fully on-screen */
 121:Source/ui/settings_page.c ****     int selTop = SETTINGS_TITLE_H + (g_selectedIndex - 1) * SETTINGS_ROW_PITCH;
 122:Source/ui/settings_page.c ****     int selBottom = selTop + SETTINGS_ITEM_H;
 123:Source/ui/settings_page.c ****     int listBottom = SETTINGS_TITLE_H + settings_list_height();
 124:Source/ui/settings_page.c ****     int minScroll = selBottom - listBottom;
 125:Source/ui/settings_page.c ****     int maxForSel = selTop - SETTINGS_TITLE_H;
 126:Source/ui/settings_page.c ****     if (minScroll > maxForSel)
 127:Source/ui/settings_page.c ****     {
 128:Source/ui/settings_page.c ****         minScroll = maxForSel;
 129:Source/ui/settings_page.c ****     }
 130:Source/ui/settings_page.c ****     if (scroll < minScroll)
 131:Source/ui/settings_page.c ****     {
 132:Source/ui/settings_page.c ****         scroll = minScroll;
 133:Source/ui/settings_page.c ****     }
 134:Source/ui/settings_page.c ****     if (scroll > maxForSel)
 135:Source/ui/settings_page.c ****     {
 136:Source/ui/settings_page.c ****         scroll = maxForSel;
 137:Source/ui/settings_page.c ****     }
 138:Source/ui/settings_page.c ****     return scroll;
 139:Source/ui/settings_page.c **** }
