 104:Source/ui/settings_page.c **** /* Row 1: Search Engine cycle — Lua ((v-2+n)%n)+1 / (v%n)+1 */
 105:Source/ui/settings_page.c **** static void cycle_engine(int dir) {
 106:Source/ui/settings_page.c ****     const int n = PLUTO_SEARCH_ENGINE_COUNT;
 107:Source/ui/settings_page.c ****     int v = s_staged.searchEngine;
 108:Source/ui/settings_page.c ****     if (dir < 0) {
 109:Source/ui/settings_page.c ****         v = ((v - 2 + n) % n) + 1;
 110:Source/ui/settings_page.c ****     } else {
 111:Source/ui/settings_page.c ****         v = (v % n) + 1;
 112:Source/ui/settings_page.c ****     }
 113:Source/ui/settings_page.c ****     s_staged.searchEngine = v;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccmkxWhk.s 			page 16


 114:Source/ui/settings_page.c **** }
 115:Source/ui/settings_page.c **** 
 116:Source/ui/settings_page.c **** /* Row 2: Browse Mode toggle (both directions identical in Lua) */
 117:Source/ui/settings_page.c **** static void toggle_mode(void) {
 118:Source/ui/settings_page.c ****     s_staged.mode = (s_staged.mode == (int)PLUTO_MODE_RAW_HTML)
 119:Source/ui/settings_page.c ****                         ? (int)PLUTO_MODE_READER
 120:Source/ui/settings_page.c ****                         : (int)PLUTO_MODE_RAW_HTML;
 121:Source/ui/settings_page.c **** }
 122:Source/ui/settings_page.c **** 
 123:Source/ui/settings_page.c **** /* Row 3: Invert Crank toggle */
 124:Source/ui/settings_page.c **** static void toggle_invert(void) {
 125:Source/ui/settings_page.c ****     s_staged.invertCrank = !s_staged.invertCrank;
 126:Source/ui/settings_page.c **** }
 127:Source/ui/settings_page.c **** 
 128:Source/ui/settings_page.c **** /* Row 4: Image Mode cycle in IMAGE_MODE_NAMES order (enum order) */
 129:Source/ui/settings_page.c **** static void cycle_image_mode(int dir) {
 130:Source/ui/settings_page.c ****     const int n = (int)PLUTO_IMAGE_MODE_DISABLED + 1;
 131:Source/ui/settings_page.c ****     int v = s_staged.imageMode;
 132:Source/ui/settings_page.c ****     v += (dir < 0) ? -1 : 1;
 133:Source/ui/settings_page.c ****     if (v < 0) v += n;
 134:Source/ui/settings_page.c ****     if (v >= n) v -= n;
 135:Source/ui/settings_page.c ****     s_staged.imageMode = v;
 136:Source/ui/settings_page.c **** }
 137:Source/ui/settings_page.c **** 
 138:Source/ui/settings_page.c **** /* Row 5: Clear Cookies action (immediate, both directions) */
 139:Source/ui/settings_page.c **** static void clear_cookies(void) {
 140:Source/ui/settings_page.c ****     cj_clear();
 141:Source/ui/settings_page.c ****     PLUTO_LOG("[P31] cookies cleared");
 142:Source/ui/settings_page.c **** }
 143:Source/ui/settings_page.c **** 
 144:Source/ui/settings_page.c **** static SpAction save_and_close(void) {
 145:Source/ui/settings_page.c ****     PlutoSettings* st = storage_settings();
 146:Source/ui/settings_page.c ****     if (st != NULL) {
 147:Source/ui/settings_page.c ****         st->searchEngine = s_staged.searchEngine;
 148:Source/ui/settings_page.c ****         st->mode = s_staged.mode;
 149:Source/ui/settings_page.c ****         st->invertCrank = s_staged.invertCrank;
 150:Source/ui/settings_page.c ****         st->imageMode = s_staged.imageMode;
 151:Source/ui/settings_page.c ****     }
 152:Source/ui/settings_page.c ****     storage_save();
 153:Source/ui/settings_page.c ****     if (s_onChange != NULL) {
 154:Source/ui/settings_page.c ****         s_onChange();
 155:Source/ui/settings_page.c ****     }
 156:Source/ui/settings_page.c ****     PLUTO_LOG("[P31] saveAndClose: mode=%d imageMode=%d", s_staged.mode,
 157:Source/ui/settings_page.c ****               s_staged.imageMode);
 158:Source/ui/settings_page.c ****     sp_close();
 159:Source/ui/settings_page.c ****     return SP_ACT_SAVED;
 160:Source/ui/settings_page.c **** }
