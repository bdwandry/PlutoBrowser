  46:Source/ui/settings_page.c **** #define SETTINGS_FOOTER_H 18
  47:Source/ui/settings_page.c **** #define SETTINGS_ITEM_H 26
  48:Source/ui/settings_page.c **** #define SETTINGS_ROW_PITCH (SETTINGS_ITEM_H + 2)
