 118:Source/ui/settings_page.c **** /* Row 1: Search Engine cycle — Lua ((v-2+n)%n)+1 / (v%n)+1 */
 119:Source/ui/settings_page.c **** static void cycle_engine(int dir) {
 120:Source/ui/settings_page.c ****     const int n = PLUTO_SEARCH_ENGINE_COUNT;
 121:Source/ui/settings_page.c ****     int v = s_staged.searchEngine;
 122:Source/ui/settings_page.c ****     if (dir < 0) {
 123:Source/ui/settings_page.c ****         v = ((v - 2 + n) % n) + 1;
 124:Source/ui/settings_page.c ****     } else {
 125:Source/ui/settings_page.c ****         v = (v % n) + 1;
 126:Source/ui/settings_page.c ****     }
 127:Source/ui/settings_page.c ****     s_staged.searchEngine = v;
 128:Source/ui/settings_page.c **** }
 129:Source/ui/settings_page.c **** 
 130:Source/ui/settings_page.c **** /* Row 2: Browse Mode toggle (both directions identical in Lua) */
 131:Source/ui/settings_page.c **** static void toggle_mode(void) {
 132:Source/ui/settings_page.c ****     s_staged.mode = (s_staged.mode == (int)PLUTO_MODE_RAW_HTML)
 133:Source/ui/settings_page.c ****                         ? (int)PLUTO_MODE_READER
 134:Source/ui/settings_page.c ****                         : (int)PLUTO_MODE_RAW_HTML;
 135:Source/ui/settings_page.c **** }
 136:Source/ui/settings_page.c **** 
 137:Source/ui/settings_page.c **** /* Row 3: Invert Crank toggle */
 138:Source/ui/settings_page.c **** static void toggle_invert(void) {
 139:Source/ui/settings_page.c ****     s_staged.invertCrank = !s_staged.invertCrank;
 140:Source/ui/settings_page.c **** }
 141:Source/ui/settings_page.c **** 
 142:Source/ui/settings_page.c **** /* Row 4: Image Mode cycle in IMAGE_MODE_NAMES order (enum order) */
 143:Source/ui/settings_page.c **** static void cycle_image_mode(int dir) {
 144:Source/ui/settings_page.c ****     const int n = (int)PLUTO_IMAGE_MODE_DISABLED + 1;
 145:Source/ui/settings_page.c ****     int v = s_staged.imageMode;
 146:Source/ui/settings_page.c ****     v += (dir < 0) ? -1 : 1;
 147:Source/ui/settings_page.c ****     if (v < 0) v += n;
 148:Source/ui/settings_page.c ****     if (v >= n) v -= n;
 149:Source/ui/settings_page.c ****     s_staged.imageMode = v;
 150:Source/ui/settings_page.c **** }
 151:Source/ui/settings_page.c **** 
 152:Source/ui/settings_page.c **** /* Row 5: Clear Cookies action (immediate, both directions) */
 153:Source/ui/settings_page.c **** static void clear_cookies(void) {
 154:Source/ui/settings_page.c ****     cj_clear();
 155:Source/ui/settings_page.c ****     PLUTO_LOG("[P31] cookies cleared");
 156:Source/ui/settings_page.c **** }
 157:Source/ui/settings_page.c **** 
 158:Source/ui/settings_page.c **** /* Row 6: Protocol cycle (http <-> tcp), both directions identical */
 159:Source/ui/settings_page.c **** static void cycle_protocol(void) {
 160:Source/ui/settings_page.c ****     s_staged.protocol = (s_staged.protocol == (int)PLUTO_PROTOCOL_HTTP)
 161:Source/ui/settings_page.c ****                             ? (int)PLUTO_PROTOCOL_TCP
 162:Source/ui/settings_page.c ****                             : (int)PLUTO_PROTOCOL_HTTP;
 163:Source/ui/settings_page.c **** }
 164:Source/ui/settings_page.c **** 
 165:Source/ui/settings_page.c **** static SpAction save_and_close(void) {
 166:Source/ui/settings_page.c ****     PlutoSettings* st = storage_settings();
 167:Source/ui/settings_page.c ****     if (st != NULL) {
 168:Source/ui/settings_page.c ****         st->searchEngine = s_staged.searchEngine;
 169:Source/ui/settings_page.c ****         st->mode = s_staged.mode;
 170:Source/ui/settings_page.c ****         st->invertCrank = s_staged.invertCrank;
 171:Source/ui/settings_page.c ****         st->imageMode = s_staged.imageMode;
 172:Source/ui/settings_page.c ****         st->protocol = s_staged.protocol;
 173:Source/ui/settings_page.c ****     }
 174:Source/ui/settings_page.c ****     storage_save();
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccfVdDv4.s 			page 19


 175:Source/ui/settings_page.c ****     if (s_onChange != NULL) {
 176:Source/ui/settings_page.c ****         s_onChange();
 177:Source/ui/settings_page.c ****     }
 178:Source/ui/settings_page.c ****     PLUTO_LOG("[P31] saveAndClose: mode=%d imageMode=%d protocol=%d",
 179:Source/ui/settings_page.c ****               s_staged.mode, s_staged.imageMode, s_staged.protocol);
 180:Source/ui/settings_page.c ****     sp_close();
 181:Source/ui/settings_page.c ****     return SP_ACT_SAVED;
 182:Source/ui/settings_page.c **** }
