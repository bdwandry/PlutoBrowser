  90:src/core/selftest_tasks.c **** // Oracle section M: 1000 yieldCheck() iterations, clock +20ms per
  91:src/core/selftest_tasks.c **** // iteration. Ground truth: first yield at iteration 64, 16 frames total.
  92:src/core/selftest_tasks.c **** static int step_budget_loop(void* ctx)
  93:src/core/selftest_tasks.c **** {
  94:src/core/selftest_tasks.c ****     ScriptCtx* c = (ScriptCtx*)ctx;
  95:src/core/selftest_tasks.c ****     while (c->loopIters < 1000) {
  96:src/core/selftest_tasks.c ****         c->loopIters++;
  97:src/core/selftest_tasks.c ****         if (tasks_yield_check()) {
  98:src/core/selftest_tasks.c ****             if (c->firstYieldAtIter < 0) {
  99:src/core/selftest_tasks.c ****                 c->firstYieldAtIter = (int)c->loopIters;
 100:src/core/selftest_tasks.c ****             }
 101:src/core/selftest_tasks.c ****             return PLUTO_TASK_YIELD;
 102:src/core/selftest_tasks.c ****         }
 103:src/core/selftest_tasks.c ****         g_now += 20; // wall clock advances inside the loop
 104:src/core/selftest_tasks.c ****     }
 105:src/core/selftest_tasks.c ****     c->done = 1;
 106:src/core/selftest_tasks.c ****     return PLUTO_TASK_DONE;
 107:src/core/selftest_tasks.c **** }
 108:src/core/selftest_tasks.c **** 
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cccVjOjV.s 			page 8


 109:src/core/selftest_tasks.c **** // Frozen-clock variant: budget gate can never fire (elapsed == frameStart).
 110:src/core/selftest_tasks.c **** static int step_frozen_loop(void* ctx)
 111:src/core/selftest_tasks.c **** {
 112:src/core/selftest_tasks.c ****     ScriptCtx* c = (ScriptCtx*)ctx;
 113:src/core/selftest_tasks.c ****     while (c->loopIters < 1000) {
 114:src/core/selftest_tasks.c ****         c->loopIters++;
 115:src/core/selftest_tasks.c ****         if (tasks_yield_check()) {
 116:src/core/selftest_tasks.c ****             c->firstYieldAtIter = (int)c->loopIters;
 117:src/core/selftest_tasks.c ****             return PLUTO_TASK_YIELD;
 118:src/core/selftest_tasks.c ****         }
 119:src/core/selftest_tasks.c ****     }
 120:src/core/selftest_tasks.c ****     c->done = 1;
 121:src/core/selftest_tasks.c ****     return PLUTO_TASK_DONE;
 122:src/core/selftest_tasks.c **** }
