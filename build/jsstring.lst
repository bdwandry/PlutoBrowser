 243:Source/js/jsstring.c **** 	tail = head;
 244:Source/js/jsstring.c **** 	for (k = i - a; k < n; ++k) {
 245:Source/js/jsstring.c **** 		tail += chartorune(&tail_rune, tail);
 246:Source/js/jsstring.c **** 		if (tail_rune >= 0x10000)
 247:Source/js/jsstring.c **** 			++k;
 248:Source/js/jsstring.c **** 	}
 249:Source/js/jsstring.c **** 
 250:Source/js/jsstring.c **** 	/* no surrogate pair splits! */
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccyXUjeP.s 			page 7


 251:Source/js/jsstring.c **** 	if (i == a && k == n) {
 252:Source/js/jsstring.c **** 		js_pushlstring(J, head, tail - head);
 253:Source/js/jsstring.c **** 		return;
 254:Source/js/jsstring.c **** 	}
 255:Source/js/jsstring.c **** 
 256:Source/js/jsstring.c **** 	if (js_try(J)) {
 257:Source/js/jsstring.c **** 		js_free(J, p);
 258:Source/js/jsstring.c **** 		js_throw(J);
 259:Source/js/jsstring.c **** 	}
 260:Source/js/jsstring.c **** 
 261:Source/js/jsstring.c **** 	p = js_malloc(J, UTFmax + (tail - head));
 262:Source/js/jsstring.c **** 
 263:Source/js/jsstring.c **** 	/* substring starts with low surrogate (head is just after character) */
 264:Source/js/jsstring.c **** 	if (i > a) {
 265:Source/js/jsstring.c **** 		head_rune = 0xdc00 + ((head_rune - 0x10000) & 0x3ff);
 266:Source/js/jsstring.c **** 		head_len = runetochar(p, &head_rune);
 267:Source/js/jsstring.c **** 		memcpy(p + head_len, head, tail - head);
 268:Source/js/jsstring.c **** 		js_pushlstring(J, p, head_len + (tail - head));
 269:Source/js/jsstring.c **** 	}
 270:Source/js/jsstring.c **** 
 271:Source/js/jsstring.c **** 	/* substring ends with high surrogate (tail is just after character) */
 272:Source/js/jsstring.c **** 	if (k > n) {
 273:Source/js/jsstring.c **** 		tail -= runelen(tail_rune);
 274:Source/js/jsstring.c **** 		memcpy(p, head, tail - head);
 275:Source/js/jsstring.c **** 		tail_rune = 0xd800 + ((tail_rune - 0x10000) >> 10);
 276:Source/js/jsstring.c **** 		tail_len = runetochar(p + (tail - head), &tail_rune);
 277:Source/js/jsstring.c **** 		js_pushlstring(J, p, (tail - head) + tail_len);
 278:Source/js/jsstring.c **** 	}
 279:Source/js/jsstring.c **** 
 280:Source/js/jsstring.c **** 	js_endtry(J);
 281:Source/js/jsstring.c **** 	js_free(J, p);
 282:Source/js/jsstring.c **** }
