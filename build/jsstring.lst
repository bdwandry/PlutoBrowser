 284:Source/js/jsstring.c **** static void Sp_slice(js_State *J)
 285:Source/js/jsstring.c **** {
 286:Source/js/jsstring.c **** 	const char *str = checkstring(J, 0);
 287:Source/js/jsstring.c **** 	int len = js_utflen(str);
 288:Source/js/jsstring.c **** 	int s = js_tointeger(J, 1);
 289:Source/js/jsstring.c **** 	int e = js_isdefined(J, 2) ? js_tointeger(J, 2) : len;
 290:Source/js/jsstring.c **** 
 291:Source/js/jsstring.c **** 	s = s < 0 ? s + len : s;
 292:Source/js/jsstring.c **** 	e = e < 0 ? e + len : e;
 293:Source/js/jsstring.c **** 
 294:Source/js/jsstring.c **** 	s = s < 0 ? 0 : s > len ? len : s;
 295:Source/js/jsstring.c **** 	e = e < 0 ? 0 : e > len ? len : e;
