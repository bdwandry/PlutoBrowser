 428:Source/js/jsstring.c **** static int istrim(int c)
 429:Source/js/jsstring.c **** {
 430:Source/js/jsstring.c **** 	return c == 0x9 || c == 0xB || c == 0xC || c == 0x20 || c == 0xA0 || c == 0xFEFF ||
 431:Source/js/jsstring.c **** 		c == 0xA || c == 0xD || c == 0x2028 || c == 0x2029;
 432:Source/js/jsstring.c **** }
 433:Source/js/jsstring.c **** 
 434:Source/js/jsstring.c **** static void Sp_trim(js_State *J)
 435:Source/js/jsstring.c **** {
 436:Source/js/jsstring.c **** 	const char *s, *e;
 437:Source/js/jsstring.c **** 	s = checkstring(J, 0);
 438:Source/js/jsstring.c **** 	while (istrim(*s))
 439:Source/js/jsstring.c **** 		++s;
 440:Source/js/jsstring.c **** 	e = s + strlen(s);
 441:Source/js/jsstring.c **** 	while (e > s && istrim(e[-1]))
 442:Source/js/jsstring.c **** 		--e;
 443:Source/js/jsstring.c **** 	js_pushlstring(J, s, e - s);
 444:Source/js/jsstring.c **** }
