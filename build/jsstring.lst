 719:Source/js/jsstring.c **** static void Sp_split_regexp(js_State *J)
 720:Source/js/jsstring.c **** {
 721:Source/js/jsstring.c **** 	js_Regexp *re;
 722:Source/js/jsstring.c **** 	const char *text;
 723:Source/js/jsstring.c **** 	int limit, len, k;
 724:Source/js/jsstring.c **** 	const char *p, *a, *b, *c, *e;
 725:Source/js/jsstring.c **** 	Resub m;
 726:Source/js/jsstring.c **** 	Rune rune;
 727:Source/js/jsstring.c **** 
 728:Source/js/jsstring.c **** 	text = checkstring(J, 0);
 729:Source/js/jsstring.c **** 	re = js_toregexp(J, 1);
 730:Source/js/jsstring.c **** 	limit = js_isdefined(J, 2) ? js_tointeger(J, 2) : 1 << 30;
 731:Source/js/jsstring.c **** 
 732:Source/js/jsstring.c **** 	js_newarray(J);
 733:Source/js/jsstring.c **** 	len = 0;
 734:Source/js/jsstring.c **** 
 735:Source/js/jsstring.c **** 	if (limit == 0)
 736:Source/js/jsstring.c **** 		return;
 737:Source/js/jsstring.c **** 
 738:Source/js/jsstring.c **** 	e = text + strlen(text);
 739:Source/js/jsstring.c **** 
 740:Source/js/jsstring.c **** 	/* splitting the empty string */
 741:Source/js/jsstring.c **** 	if (e == text) {
 742:Source/js/jsstring.c **** 		if (js_doregexec(J, re->prog, text, &m, 0)) {
 743:Source/js/jsstring.c **** 			js_pushliteral(J, "");
 744:Source/js/jsstring.c **** 			js_setindex(J, -2, 0);
 745:Source/js/jsstring.c **** 		}
 746:Source/js/jsstring.c **** 		return;
 747:Source/js/jsstring.c **** 	}
 748:Source/js/jsstring.c **** 
 749:Source/js/jsstring.c **** 	p = a = text;
 750:Source/js/jsstring.c **** 	while (a < e) {
 751:Source/js/jsstring.c **** 		if (js_doregexec(J, re->prog, a, &m, isbol(re, text, a) ? 0 : REG_NOTBOL))
 752:Source/js/jsstring.c **** 			break; /* no match */
 753:Source/js/jsstring.c **** 
 754:Source/js/jsstring.c **** 		b = m.sub[0].sp;
 755:Source/js/jsstring.c **** 		c = m.sub[0].ep;
 756:Source/js/jsstring.c **** 
 757:Source/js/jsstring.c **** 		/* empty string at end of last match */
 758:Source/js/jsstring.c **** 		if (b == c && b == p) {
 759:Source/js/jsstring.c **** 			a += chartorune(&rune, a);
 760:Source/js/jsstring.c **** 			continue;
 761:Source/js/jsstring.c **** 		}
 762:Source/js/jsstring.c **** 
 763:Source/js/jsstring.c **** 		if (len == limit) return;
 764:Source/js/jsstring.c **** 		js_pushlstring(J, p, b - p);
 765:Source/js/jsstring.c **** 		js_setindex(J, -2, len++);
 766:Source/js/jsstring.c **** 
 767:Source/js/jsstring.c **** 		for (k = 1; k < m.nsub; ++k) {
 768:Source/js/jsstring.c **** 			if (len == limit) return;
