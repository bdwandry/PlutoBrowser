 781:Source/js/jsstring.c **** static void Sp_split_string(js_State *J)
 782:Source/js/jsstring.c **** {
 783:Source/js/jsstring.c **** 	const char *str = checkstring(J, 0);
 784:Source/js/jsstring.c **** 	const char *sep = js_tostring(J, 1);
 785:Source/js/jsstring.c **** 	int limit = js_isdefined(J, 2) ? js_tointeger(J, 2) : 1 << 30;
 786:Source/js/jsstring.c **** 	int i, n;
 787:Source/js/jsstring.c **** 
 788:Source/js/jsstring.c **** 	js_newarray(J);
 789:Source/js/jsstring.c **** 
 790:Source/js/jsstring.c **** 	if (limit == 0)
 791:Source/js/jsstring.c **** 		return;
 792:Source/js/jsstring.c **** 
 793:Source/js/jsstring.c **** 	n = strlen(sep);
 794:Source/js/jsstring.c **** 
 795:Source/js/jsstring.c **** 	/* empty string */
 796:Source/js/jsstring.c **** 	if (n == 0) {
 797:Source/js/jsstring.c **** 		Rune rune;
 798:Source/js/jsstring.c **** 		for (i = 0; *str && i < limit; ++i) {
 799:Source/js/jsstring.c **** 			n = chartorune(&rune, str);
 800:Source/js/jsstring.c **** 			js_pushlstring(J, str, n);
 801:Source/js/jsstring.c **** 			js_setindex(J, -2, i);
 802:Source/js/jsstring.c **** 			str += n;
 803:Source/js/jsstring.c **** 		}
 804:Source/js/jsstring.c **** 		return;
 805:Source/js/jsstring.c **** 	}
 806:Source/js/jsstring.c **** 
 807:Source/js/jsstring.c **** 	for (i = 0; str && i < limit; ++i) {
 808:Source/js/jsstring.c **** 		const char *s = strstr(str, sep);
 809:Source/js/jsstring.c **** 		if (s) {
 810:Source/js/jsstring.c **** 			js_pushlstring(J, str, s-str);
 811:Source/js/jsstring.c **** 			js_setindex(J, -2, i);
 812:Source/js/jsstring.c **** 			str = s + n;
 813:Source/js/jsstring.c **** 		} else {
 814:Source/js/jsstring.c **** 			js_pushstring(J, str);
 815:Source/js/jsstring.c **** 			js_setindex(J, -2, i);
 816:Source/js/jsstring.c **** 			str = NULL;
 817:Source/js/jsstring.c **** 		}
 818:Source/js/jsstring.c **** 	}
 819:Source/js/jsstring.c **** }
