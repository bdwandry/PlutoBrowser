 300:Source/js/jsstring.c **** 		Sp_substring_imp(J, str, e, s - e);
 301:Source/js/jsstring.c **** 	else
 302:Source/js/jsstring.c **** 		js_pushliteral(J, "");
 303:Source/js/jsstring.c **** }
