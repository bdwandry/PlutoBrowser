 769:Source/js/jsstring.c **** 			js_pushlstring(J, m.sub[k].sp, m.sub[k].ep - m.sub[k].sp);
 770:Source/js/jsstring.c **** 			js_setindex(J, -2, len++);
 771:Source/js/jsstring.c **** 		}
 772:Source/js/jsstring.c **** 
 773:Source/js/jsstring.c **** 		a = p = c;
 774:Source/js/jsstring.c **** 	}
 775:Source/js/jsstring.c **** 
