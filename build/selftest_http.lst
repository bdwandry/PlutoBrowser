 301:src/core/selftest_http.c **** // A. buildRequest: byte-exact format, no cookies.
 302:src/core/selftest_http.c **** static void test_build_request_plain(void)
 303:src/core/selftest_http.c **** {
 304:src/core/selftest_http.c ****     reset_fixture();
 305:src/core/selftest_http.c ****     int ret = hc_get("http://example.com/x?a=1", &NC);
 306:src/core/selftest_http.c ****     FakeSock* s = last_sock();
 307:src/core/selftest_http.c ****     st_check(ret == 1, "A.ret");
 308:src/core/selftest_http.c ****     st_check(hc_is_loading() == 1, "A.loading_after_get");
 309:src/core/selftest_http.c ****     st_check(strcmp(s->server, "example.com") == 0 && s->port == 80 &&
 310:src/core/selftest_http.c ****                  s->usessl == 0,
 311:src/core/selftest_http.c ****              "A.conn_args");
 312:src/core/selftest_http.c ****     st_check(CT_MS == 10000 && RT_MS == 10000 && BS_BYTES == 16384,
 313:src/core/selftest_http.c ****              "A.timeouts_ms_and_bufsize");
 314:src/core/selftest_http.c ****     fire_open(s, 1);
 315:src/core/selftest_http.c ****     run(1); // write happens on the update AFTER open
 316:src/core/selftest_http.c ****     static const char REQ[] =
 317:src/core/selftest_http.c ****         "GET /x?a=1 HTTP/1.1\r\n"
 318:src/core/selftest_http.c ****         "Host: example.com\r\n"
 319:src/core/selftest_http.c ****         "User-Agent: CometBrowser/1.0 (Playdate)\r\n"
 320:src/core/selftest_http.c ****         "Accept: text/html,text/plain;q=0.8\r\n"
 321:src/core/selftest_http.c ****         "Accept-Language: en-US,en;q=0.9\r\n"
 322:src/core/selftest_http.c ****         "Connection: close\r\n"
 323:src/core/selftest_http.c ****         "\r\n";
 324:src/core/selftest_http.c ****     st_check(s->written.len == sizeof(REQ) - 1 &&
 325:src/core/selftest_http.c ****                  memcmp(s->written.data, REQ, sizeof(REQ) - 1) == 0,
 326:src/core/selftest_http.c ****              "A.request_bytes_exact");
 327:src/core/selftest_http.c ****     // Complete it so isLoading returns to false.
 328:src/core/selftest_http.c ****     feed(s, "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n");
 329:src/core/selftest_http.c ****     run(3);
 330:src/core/selftest_http.c ****     st_check(hc_is_loading() == 0, "A.loading_after_success");
 331:src/core/selftest_http.c **** }
