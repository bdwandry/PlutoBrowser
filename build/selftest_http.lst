 277:Source/core/selftest_http.c **** static FakeSock* last_sock(void) { return &SOCKS[NSOCKS - 1]; }
 278:Source/core/selftest_http.c **** 
 279:Source/core/selftest_http.c **** static void feed(FakeSock* s, const char* bytes)
 280:Source/core/selftest_http.c **** {
