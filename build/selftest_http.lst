 735:Source/core/selftest_http.c **** // W. open failure: error delivered on the next update tick.
 736:Source/core/selftest_http.c **** static void test_open_failure(void)
 737:Source/core/selftest_http.c **** {
 738:Source/core/selftest_http.c ****     reset_fixture();
 739:Source/core/selftest_http.c ****     PlutoHttpCallbacks cbs = make_cbs();
 740:Source/core/selftest_http.c ****     hc_get("http://w/w", &cbs);
 741:Source/core/selftest_http.c ****     FakeSock* s = last_sock();
 742:Source/core/selftest_http.c ****     s->openErr = NET_NO_DEVICE;
 743:Source/core/selftest_http.c ****     fire_open(s, 0); // open callback resolves with a failure (state=error now)
 744:Source/core/selftest_http.c ****     st_check(R.errorN == 0 && hc_is_loading() == 0,
 745:Source/core/selftest_http.c ****              "W.error_state_before_tick");
 746:Source/core/selftest_http.c ****     run(1); // error branch delivers
 747:Source/core/selftest_http.c ****     st_check(R.errorN == 1 && R.successN == 0, "W.open_failed_delivered");
