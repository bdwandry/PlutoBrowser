 366:Source/core/selftest_http.c **** // B/C: status parse, lowercased keys, Set-Cookie capture into real jar.
 367:Source/core/selftest_http.c **** static void test_status_headers_cookies(void)
 368:Source/core/selftest_http.c **** {
 369:Source/core/selftest_http.c ****     reset_fixture();
 370:Source/core/selftest_http.c ****     hc_get("http://h/b",
 371:Source/core/selftest_http.c ****            &NC); // no callbacks: delivery is a no-op
 372:Source/core/selftest_http.c ****     FakeSock* s = last_sock();
 373:Source/core/selftest_http.c ****     fire_open(s, 1);
 374:Source/core/selftest_http.c ****     run(1);
 375:Source/core/selftest_http.c ****     feed(s, "HTTP/1.1 404 Not Found\r\nContent-Type: Text/Plain\r\n"
 376:Source/core/selftest_http.c ****             "Content-Length: 5\r\nSet-Cookie: sid=abc\r\n"
 377:Source/core/selftest_http.c ****             "Set-Cookie: t=1\r\n\r\nhello");
 378:Source/core/selftest_http.c ****     run(3);
 379:Source/core/selftest_http.c ****     st_check(cj_count() == 2, "C.jar_count_2");
 380:Source/core/selftest_http.c ****     // Round-trip: next request to same host carries both cookies.
 381:Source/core/selftest_http.c ****     hc_get("http://h/x2", &NC);
 382:Source/core/selftest_http.c ****     FakeSock* s2 = last_sock();
 383:Source/core/selftest_http.c ****     fire_open(s2, 1);
 384:Source/core/selftest_http.c ****     run(1);
 385:Source/core/selftest_http.c ****     st_check(strstr(s2->written.data, "Cookie: sid=abc; t=1\r\n") != NULL,
 386:Source/core/selftest_http.c ****              "C.cookie_header_roundtrip");
 387:Source/core/selftest_http.c **** }
