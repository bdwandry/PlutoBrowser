 282:Source/core/selftest_http.c **** }
 283:Source/core/selftest_http.c **** 
 284:Source/core/selftest_http.c **** static void fire_open(FakeSock* s, int ok)
 285:Source/core/selftest_http.c **** {
 286:Source/core/selftest_http.c ****     s->openCb((TCPConnection*)s, ok ? NET_OK : s->openErr, s->openUd);
 287:Source/core/selftest_http.c **** }
 288:Source/core/selftest_http.c **** 
 289:Source/core/selftest_http.c **** static void server_close(FakeSock* s)
 290:Source/core/selftest_http.c **** {
 291:Source/core/selftest_http.c ****     s->closedCb((TCPConnection*)s, NET_CONNECTION_CLOSED);
 292:Source/core/selftest_http.c **** }
