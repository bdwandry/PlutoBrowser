 425:Source/core/selftest_http.c **** // F. redirect deferral: hop opens NEXT tick; relative Location resolved.
 426:Source/core/selftest_http.c **** static void test_redirect_deferral(void)
 427:Source/core/selftest_http.c **** {
 428:Source/core/selftest_http.c ****     reset_fixture();
 429:Source/core/selftest_http.c ****     PlutoHttpCallbacks cbs = make_cbs();
 430:Source/core/selftest_http.c ****     hc_get("http://origin.example/dir/page", &cbs);
 431:Source/core/selftest_http.c ****     FakeSock* s = last_sock();
 432:Source/core/selftest_http.c ****     fire_open(s, 1);
 433:Source/core/selftest_http.c ****     run(1);
 434:Source/core/selftest_http.c ****     feed(s, "HTTP/1.1 301 Moved Permanently\r\nLocation: b?q=2\r\n"
 435:Source/core/selftest_http.c ****             "Content-Length: 0\r\n\r\n");
 436:Source/core/selftest_http.c ****     run(1); // parses 301 -> defer + close
 437:Source/core/selftest_http.c ****     st_check(NSOCKS == 1 && s->closedCount == 1, "F.first_hop_closed");
