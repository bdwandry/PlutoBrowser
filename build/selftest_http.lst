 347:Source/core/selftest_http.c ****         "User-Agent: CometBrowser/1.0 (Playdate)\r\n"
 348:Source/core/selftest_http.c ****         "Accept: text/html,text/plain;q=0.8\r\n"
 349:Source/core/selftest_http.c ****         "Accept-Language: en-US,en;q=0.9\r\n"
 350:Source/core/selftest_http.c ****         "Cookie: sid=abc; t=1\r\n"
 351:Source/core/selftest_http.c ****         "Connection: close\r\n"
 352:Source/core/selftest_http.c ****         "\r\n";
 353:Source/core/selftest_http.c ****     st_check(s->written.len == sizeof(REQ) - 1 &&
 354:Source/core/selftest_http.c ****                  memcmp(s->written.data, REQ, sizeof(REQ) - 1) == 0,
 355:Source/core/selftest_http.c ****              "A2.cookie_request_bytes");
 356:Source/core/selftest_http.c **** 
