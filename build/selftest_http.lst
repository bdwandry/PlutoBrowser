   1:Source/core/selftest_http.c **** // selftest_http.c — P07 verification suite.
   2:Source/core/selftest_http.c **** //
   3:Source/core/selftest_http.c **** // Every expectation mirrors observable behavior of Source/core/http_client.lua
   4:Source/core/selftest_http.c **** // captured via the host-Lua oracle (p07_oracle.lua -> p07_truth.txt): exact
   5:Source/core/selftest_http.c **** // request bytes, slice-to-end Content-Length quirk, chunked decoding rules,
   6:Source/core/selftest_http.c **** // one-tick deferred redirects, the too-many-redirects SILENT DROP (source bug
   7:Source/core/selftest_http.c **** // kept faithfully), 60 s watchdog with the >512-byte partial-data escape,
   8:Source/core/selftest_http.c **** // closed-connection messages, stale-open self-close after cancel, local
   9:Source/core/selftest_http.c **** // about: pages, progress semantics (0,0 before headers), access gating.
  10:Source/core/selftest_http.c **** //
  11:Source/core/selftest_http.c **** // Runs fully offline: a fake playdate_tcp vtable + fake millisecond clock are
  12:Source/core/selftest_http.c **** // injected via hc_set_tcp_for_tests()/hc_set_clock_fn().
