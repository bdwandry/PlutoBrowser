 380:src/core/selftest_http.c ****     // Round-trip: next request to same host carries both cookies.
 381:src/core/selftest_http.c ****     hc_get("http://h/x2", &NC);
 382:src/core/selftest_http.c ****     FakeSock* s2 = last_sock();
 383:src/core/selftest_http.c ****     fire_open(s2, 1);
 384:src/core/selftest_http.c ****     run(1);
 385:src/core/selftest_http.c ****     st_check(strstr(s2->written.data, "Cookie: sid=abc; t=1\r\n") != NULL,
 386:src/core/selftest_http.c ****              "C.cookie_header_roundtrip");
 387:src/core/selftest_http.c **** }
