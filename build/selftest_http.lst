 433:src/core/selftest_http.c ****     run(1);
 434:src/core/selftest_http.c ****     feed(s, "HTTP/1.1 301 Moved Permanently\r\nLocation: b?q=2\r\n"
 435:src/core/selftest_http.c ****             "Content-Length: 0\r\n\r\n");
 436:src/core/selftest_http.c ****     run(1); // parses 301 -> defer + close
