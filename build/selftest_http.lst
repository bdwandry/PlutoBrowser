 425:src/core/selftest_http.c **** // F. redirect deferral: hop opens NEXT tick; relative Location resolved.
 426:src/core/selftest_http.c **** static void test_redirect_deferral(void)
 427:src/core/selftest_http.c **** {
 428:src/core/selftest_http.c ****     reset_fixture();
 429:src/core/selftest_http.c ****     PlutoHttpCallbacks cbs = make_cbs();
 430:src/core/selftest_http.c ****     hc_get("http://origin.example/dir/page", &cbs);
 431:src/core/selftest_http.c ****     FakeSock* s = last_sock();
