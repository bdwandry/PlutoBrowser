 282:src/core/selftest_http.c **** }
 283:src/core/selftest_http.c **** 
 284:src/core/selftest_http.c **** static void fire_open(FakeSock* s, int ok)
 285:src/core/selftest_http.c **** {
 286:src/core/selftest_http.c ****     s->openCb((TCPConnection*)s, ok ? NET_OK : s->openErr, s->openUd);
 287:src/core/selftest_http.c **** }
 288:src/core/selftest_http.c **** 
 289:src/core/selftest_http.c **** static void server_close(FakeSock* s)
 290:src/core/selftest_http.c **** {
 291:src/core/selftest_http.c ****     s->closedCb((TCPConnection*)s, NET_CONNECTION_CLOSED);
 292:src/core/selftest_http.c **** }
