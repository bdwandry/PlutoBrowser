   2:src/core/selftest_http.c **** //
   3:src/core/selftest_http.c **** // Every expectation mirrors observable behavior of Source/core/http_client.lua
   4:src/core/selftest_http.c **** // captured via the host-Lua oracle (p07_oracle.lua -> p07_truth.txt): exact
   5:src/core/selftest_http.c **** // request bytes, slice-to-end Content-Length quirk, chunked decoding rules,
   6:src/core/selftest_http.c **** // one-tick deferred redirects, the too-many-redirects SILENT DROP (source bug
   7:src/core/selftest_http.c **** // kept faithfully), 60 s watchdog with the >512-byte partial-data escape,
   8:src/core/selftest_http.c **** // closed-connection messages, stale-open self-close after cancel, local
   9:src/core/selftest_http.c **** // about: pages, progress semantics (0,0 before headers), access gating.
  10:src/core/selftest_http.c **** //
  11:src/core/selftest_http.c **** // Runs fully offline: a fake playdate_tcp vtable + fake millisecond clock are
