  68:src/html/selftest_document.c ****     ck("C.h2_meta", h != NULL && h->level == 2 &&
  69:src/html/selftest_document.c ****         h->spacingTop == 0 && h->spacingBottom == 0 &&
  70:src/html/selftest_document.c ****         h->nInlines == 1 && txt_is(inl(h, 0), "T"));
