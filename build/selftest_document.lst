 118:src/html/selftest_document.c **** /* ── E. inline formats ───────────────────────�
 119:src/html/selftest_document.c **** 
 120:src/html/selftest_document.c **** static void case_formats(void) {
 121:src/html/selftest_document.c ****     DocDocument* d = parse("<b>B<i>I</i></b>");
 122:src/html/selftest_document.c ****     DocBlock* p = find_type(d, DB_PARAGRAPH);
 123:src/html/selftest_document.c ****     ck("E.nest_bi", p != NULL && p->nInlines == 2 &&
 124:src/html/selftest_document.c ****        txt_is(inl(p, 0), "B") && inl(p, 0)->bold && !inl(p, 0)->italic &&
 125:src/html/selftest_document.c ****        txt_is(inl(p, 1), "I") && inl(p, 1)->bold && inl(p, 1)->italic);
 126:src/html/selftest_document.c ****     doc_free(d);
 127:src/html/selftest_document.c **** 
 128:src/html/selftest_document.c ****     d = parse("<u>u</u><s>x</s><mark>m</mark><small>s</small>"
 129:src/html/selftest_document.c ****               "<big>g</big><sub>lo</sub><sup>hi</sup>");
 130:src/html/selftest_document.c ****     p = find_type(d, DB_PARAGRAPH);
 131:src/html/selftest_document.c ****     ck("E.flags7", p != NULL && p->nInlines == 7 &&
 132:src/html/selftest_document.c ****        inl(p, 0)->underline && !inl(p, 1)->underline &&
 133:src/html/selftest_document.c ****        inl(p, 1)->strike && inl(p, 2)->mark && inl(p, 3)->small &&
 134:src/html/selftest_document.c ****        inl(p, 4)->big && inl(p, 5)->sub && inl(p, 6)->sup);
 135:src/html/selftest_document.c ****     doc_free(d);
