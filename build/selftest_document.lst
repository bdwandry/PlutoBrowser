  44:src/html/selftest_document.c **** 
  45:src/html/selftest_document.c **** static void case_empty(void) {
  46:src/html/selftest_document.c ****     DocDocument* d = parse("");
  47:src/html/selftest_document.c ****     ck("A.blank_title", d != NULL && d->title != NULL &&
  48:src/html/selftest_document.c ****        strcmp(d->title, "Blank Page") == 0);
  49:src/html/selftest_document.c ****     ck("A.blank_base", d != NULL && d->baseUrl != NULL &&
  50:src/html/selftest_document.c ****        strcmp(d->baseUrl, BASE) == 0);
  51:src/html/selftest_document.c ****     ck("A.empty_no_blocks", d != NULL && d->nBlocks == 0 &&
  52:src/html/selftest_document.c ****        d->links == NULL && d->nLinks == 0 && !d->hasMetaRefresh);
  53:src/html/selftest_document.c ****     if (d != NULL) ck("A.raw_html", d->rawHtml != NULL &&
  54:src/html/selftest_document.c ****                       strcmp(d->rawHtml, "") == 0);
  55:src/html/selftest_document.c ****     doc_free(d);
  56:src/html/selftest_document.c **** }
