1101:src/html/selftest_document.c ****         DocBlock* img = find_type(d, DB_IMAGE);
1102:src/html/selftest_document.c ****         /* parity quirk: attribute keys are lowercased by the tokenizer in
1103:src/html/selftest_document.c ****          * BOTH implementations, so the "viewBox" lookup never matches and
