  59:src/html/selftest_document.c ****     /* P12: reader mode now distills instead of returning NULL */
  60:src/html/selftest_document.c ****     DocDocument* d = doc_parse("<p>hi</p>", BASE, PLUTO_MODE_READER);
  61:src/html/selftest_document.c ****     ck("B.reader_doc", d != NULL && d->isReaderMode == 1 &&
  62:src/html/selftest_document.c ****        d->nBlocks >= 3 && d->blocks[0].type == DB_READER_HEADER);
  63:src/html/selftest_document.c ****     doc_free(d);
  64:src/html/selftest_document.c **** }
  65:src/html/selftest_document.c **** 
