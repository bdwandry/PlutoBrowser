  75:Source/js/jsintern.c **** 	return node;
  76:Source/js/jsintern.c **** }
  77:Source/js/jsintern.c **** 
  78:Source/js/jsintern.c **** static js_StringNode *jsS_insert(js_State *J, js_StringNode *node, const char *string, const char *
  79:Source/js/jsintern.c **** {
  80:Source/js/jsintern.c **** 	if (node != &jsS_sentinel) {
