  41:Source/js/jsintern.c **** static js_StringNode jsS_sentinel = { &jsS_sentinel, &jsS_sentinel, 0, ""};
  42:Source/js/jsintern.c **** 
  43:Source/js/jsintern.c **** static js_StringNode *jsS_newstringnode(js_State *J, const char *string, const char **result)
  44:Source/js/jsintern.c **** {
  45:Source/js/jsintern.c **** 	size_t n = strlen(string);
  46:Source/js/jsintern.c **** 	if (n > JS_STRLIMIT)
  47:Source/js/jsintern.c **** 		js_rangeerror(J, "invalid string length");
  48:Source/js/jsintern.c **** 	js_StringNode *node = js_malloc(J, soffsetof(js_StringNode, string) + n + 1);
  49:Source/js/jsintern.c **** 	node->left = node->right = &jsS_sentinel;
  50:Source/js/jsintern.c **** 	node->level = 1;
  51:Source/js/jsintern.c **** 	memcpy(node->string, string, n + 1);
  52:Source/js/jsintern.c **** 	return *result = node->string, node;
  53:Source/js/jsintern.c **** }
  54:Source/js/jsintern.c **** 
  55:Source/js/jsintern.c **** static js_StringNode *jsS_skew(js_StringNode *node)
  56:Source/js/jsintern.c **** {
  57:Source/js/jsintern.c **** 	if (node->left->level == node->level) {
  58:Source/js/jsintern.c **** 		js_StringNode *temp = node;
  59:Source/js/jsintern.c **** 		node = node->left;
  60:Source/js/jsintern.c **** 		temp->left = node->right;
  61:Source/js/jsintern.c **** 		node->right = temp;
  62:Source/js/jsintern.c **** 	}
  63:Source/js/jsintern.c **** 	return node;
  64:Source/js/jsintern.c **** }
  65:Source/js/jsintern.c **** 
