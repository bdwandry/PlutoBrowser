  97:Source/js/jsdate.c **** static int YearFromTime(double t)
  98:Source/js/jsdate.c **** {
  99:Source/js/jsdate.c **** 	int y = floor(t / (msPerDay * 365.2425)) + 1970;
 100:Source/js/jsdate.c **** 	double t2 = TimeFromYear(y);
 101:Source/js/jsdate.c **** 	if (t2 > t)
 102:Source/js/jsdate.c **** 		--y;
 103:Source/js/jsdate.c **** 	else if (t2 + msPerDay * DaysInYear(y) <= t)
 104:Source/js/jsdate.c **** 		++y;
 105:Source/js/jsdate.c **** 	return y;
 106:Source/js/jsdate.c **** }
 107:Source/js/jsdate.c **** 
 108:Source/js/jsdate.c **** static int InLeapYear(double t)
 109:Source/js/jsdate.c **** {
 110:Source/js/jsdate.c **** 	return DaysInYear(YearFromTime(t)) == 366;
 111:Source/js/jsdate.c **** }
