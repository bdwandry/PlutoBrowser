 136:Source/js/jsdate.c **** static int DateFromTime(double t)
 137:Source/js/jsdate.c **** {
 138:Source/js/jsdate.c **** 	int day = DayWithinYear(t);
 139:Source/js/jsdate.c **** 	int leap = InLeapYear(t);
 140:Source/js/jsdate.c **** 	switch (MonthFromTime(t)) {
 141:Source/js/jsdate.c **** 	case 0: return day + 1;
