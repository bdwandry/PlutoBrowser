 249:Source/js/jsdate.c **** 
 250:Source/js/jsdate.c **** static double parseDateTime(const char *s)
 251:Source/js/jsdate.c **** {
 252:Source/js/jsdate.c **** 	int y = 1970, m = 1, d = 1, H = 0, M = 0, S = 0, ms = 0;
 253:Source/js/jsdate.c **** 	int tza = 0;
 254:Source/js/jsdate.c **** 	double t;
 255:Source/js/jsdate.c **** 
 256:Source/js/jsdate.c **** 	/* Parse ISO 8601 formatted date and time: */
 257:Source/js/jsdate.c **** 	/* YYYY("-"MM("-"DD)?)?("T"HH":"mm(":"ss("."sss)?)?("Z"|[+-]HH(":"mm)?)?)? */
 258:Source/js/jsdate.c **** 
 259:Source/js/jsdate.c **** 	if (!toint(&s, 4, &y)) return NAN;
 260:Source/js/jsdate.c **** 	if (*s == '-') {
 261:Source/js/jsdate.c **** 		s += 1;
 262:Source/js/jsdate.c **** 		if (!toint(&s, 2, &m)) return NAN;
 263:Source/js/jsdate.c **** 		if (*s == '-') {
 264:Source/js/jsdate.c **** 			s += 1;
 265:Source/js/jsdate.c **** 			if (!toint(&s, 2, &d)) return NAN;
 266:Source/js/jsdate.c **** 		}
 267:Source/js/jsdate.c **** 	}
 268:Source/js/jsdate.c **** 
 269:Source/js/jsdate.c **** 	if (*s == 'T') {
 270:Source/js/jsdate.c **** 		s += 1;
 271:Source/js/jsdate.c **** 		if (!toint(&s, 2, &H)) return NAN;
 272:Source/js/jsdate.c **** 		if (*s != ':') return NAN;
 273:Source/js/jsdate.c **** 		s += 1;
 274:Source/js/jsdate.c **** 		if (!toint(&s, 2, &M)) return NAN;
 275:Source/js/jsdate.c **** 		if (*s == ':') {
 276:Source/js/jsdate.c **** 			s += 1;
 277:Source/js/jsdate.c **** 			if (!toint(&s, 2, &S)) return NAN;
 278:Source/js/jsdate.c **** 			if (*s == '.') {
 279:Source/js/jsdate.c **** 				s += 1;
 280:Source/js/jsdate.c **** 				if (!toint(&s, 3, &ms)) return NAN;
 281:Source/js/jsdate.c **** 			}
 282:Source/js/jsdate.c **** 		}
 283:Source/js/jsdate.c **** 		if (*s == 'Z') {
 284:Source/js/jsdate.c **** 			s += 1;
 285:Source/js/jsdate.c **** 			tza = 0;
 286:Source/js/jsdate.c **** 		} else if (*s == '+' || *s == '-') {
 287:Source/js/jsdate.c **** 			int tzh = 0, tzm = 0;
 288:Source/js/jsdate.c **** 			int tzs = *s == '+' ? 1 : -1;
 289:Source/js/jsdate.c **** 			s += 1;
 290:Source/js/jsdate.c **** 			if (!toint(&s, 2, &tzh)) return NAN;
 291:Source/js/jsdate.c **** 			if (*s == ':') {
 292:Source/js/jsdate.c **** 				s += 1;
 293:Source/js/jsdate.c **** 				if (!toint(&s, 2, &tzm)) return NAN;
 294:Source/js/jsdate.c **** 			}
 295:Source/js/jsdate.c **** 			if (tzh > 23 || tzm > 59) return NAN;
 296:Source/js/jsdate.c **** 			tza = tzs * (tzh * msPerHour + tzm * msPerMinute);
 297:Source/js/jsdate.c **** 		} else {
 298:Source/js/jsdate.c **** 			tza = LocalTZA();
 299:Source/js/jsdate.c **** 		}
 300:Source/js/jsdate.c **** 	}
 301:Source/js/jsdate.c **** 
 302:Source/js/jsdate.c **** 	if (*s) return NAN;
 303:Source/js/jsdate.c **** 
 304:Source/js/jsdate.c **** 	if (m < 1 || m > 12) return NAN;
 305:Source/js/jsdate.c **** 	if (d < 1 || d > 31) return NAN;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccqOsqBI.s 			page 8


 306:Source/js/jsdate.c **** 	if (H < 0 || H > 24) return NAN;
 307:Source/js/jsdate.c **** 	if (M < 0 || M > 59) return NAN;
 308:Source/js/jsdate.c **** 	if (S < 0 || S > 59) return NAN;
 309:Source/js/jsdate.c **** 	if (ms < 0 || ms > 999) return NAN;
 310:Source/js/jsdate.c **** 	if (H == 24 && (M != 0 || S != 0 || ms != 0)) return NAN;
 311:Source/js/jsdate.c **** 
 312:Source/js/jsdate.c **** 	/* TODO: DaylightSavingTA on local times */
 313:Source/js/jsdate.c **** 	t = MakeDate(MakeDay(y, m-1, d), MakeTime(H, M, S, ms));
 314:Source/js/jsdate.c **** 	return t - tza;
 315:Source/js/jsdate.c **** }
 316:Source/js/jsdate.c **** 
 317:Source/js/jsdate.c **** /* date formatting */
 318:Source/js/jsdate.c **** 
 319:Source/js/jsdate.c **** static char *fmtdate(char *buf, double t)
 320:Source/js/jsdate.c **** {
 321:Source/js/jsdate.c **** 	int y = YearFromTime(t);
 322:Source/js/jsdate.c **** 	int m = MonthFromTime(t);
 323:Source/js/jsdate.c **** 	int d = DateFromTime(t);
 324:Source/js/jsdate.c **** 	if (!isfinite(t))
 325:Source/js/jsdate.c **** 		return "Invalid Date";
 326:Source/js/jsdate.c **** 	sprintf(buf, "%04d-%02d-%02d", y, m+1, d);
 327:Source/js/jsdate.c **** 	return buf;
 328:Source/js/jsdate.c **** }
 329:Source/js/jsdate.c **** 
 330:Source/js/jsdate.c **** static char *fmttime(char *buf, double t, double tza)
 331:Source/js/jsdate.c **** {
 332:Source/js/jsdate.c **** 	int H = HourFromTime(t);
 333:Source/js/jsdate.c **** 	int M = MinFromTime(t);
 334:Source/js/jsdate.c **** 	int S = SecFromTime(t);
 335:Source/js/jsdate.c **** 	int ms = msFromTime(t);
 336:Source/js/jsdate.c **** 	int tzh = HourFromTime(fabs(tza));
 337:Source/js/jsdate.c **** 	int tzm = MinFromTime(fabs(tza));
 338:Source/js/jsdate.c **** 	if (!isfinite(t))
 339:Source/js/jsdate.c **** 		return "Invalid Date";
 340:Source/js/jsdate.c **** 	if (tza == 0)
 341:Source/js/jsdate.c **** 		sprintf(buf, "%02d:%02d:%02d.%03dZ", H, M, S, ms);
 342:Source/js/jsdate.c **** 	else if (tza < 0)
 343:Source/js/jsdate.c **** 		sprintf(buf, "%02d:%02d:%02d.%03d-%02d:%02d", H, M, S, ms, tzh, tzm);
 344:Source/js/jsdate.c **** 	else
 345:Source/js/jsdate.c **** 		sprintf(buf, "%02d:%02d:%02d.%03d+%02d:%02d", H, M, S, ms, tzh, tzm);
 346:Source/js/jsdate.c **** 	return buf;
 347:Source/js/jsdate.c **** }
 348:Source/js/jsdate.c **** 
 349:Source/js/jsdate.c **** static char *fmtdatetime(char *buf, double t, double tza)
 350:Source/js/jsdate.c **** {
 351:Source/js/jsdate.c **** 	char dbuf[20], tbuf[20];
 352:Source/js/jsdate.c **** 	if (!isfinite(t))
 353:Source/js/jsdate.c **** 		return "Invalid Date";
 354:Source/js/jsdate.c **** 	fmtdate(dbuf, t);
 355:Source/js/jsdate.c **** 	fmttime(tbuf, t, tza);
 356:Source/js/jsdate.c **** 	sprintf(buf, "%sT%s", dbuf, tbuf);
 357:Source/js/jsdate.c **** 	return buf;
 358:Source/js/jsdate.c **** }
