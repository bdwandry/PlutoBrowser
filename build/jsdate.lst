 118:Source/js/jsdate.c **** static int MonthFromTime(double t)
 119:Source/js/jsdate.c **** {
 120:Source/js/jsdate.c **** 	int day = DayWithinYear(t);
 121:Source/js/jsdate.c **** 	int leap = InLeapYear(t);
 122:Source/js/jsdate.c **** 	if (day < 31) return 0;
 123:Source/js/jsdate.c **** 	if (day < 59 + leap) return 1;
 124:Source/js/jsdate.c **** 	if (day < 90 + leap) return 2;
 125:Source/js/jsdate.c **** 	if (day < 120 + leap) return 3;
 126:Source/js/jsdate.c **** 	if (day < 151 + leap) return 4;
 127:Source/js/jsdate.c **** 	if (day < 181 + leap) return 5;
 128:Source/js/jsdate.c **** 	if (day < 212 + leap) return 6;
 129:Source/js/jsdate.c **** 	if (day < 243 + leap) return 7;
 130:Source/js/jsdate.c **** 	if (day < 273 + leap) return 8;
 131:Source/js/jsdate.c **** 	if (day < 304 + leap) return 9;
 132:Source/js/jsdate.c **** 	if (day < 334 + leap) return 10;
 133:Source/js/jsdate.c **** 	return 11;
 134:Source/js/jsdate.c **** }
