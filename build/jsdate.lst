  84:Source/js/jsdate.c **** static int DayFromYear(int y)
  85:Source/js/jsdate.c **** {
  86:Source/js/jsdate.c **** 	return 365 * (y - 1970) +
  87:Source/js/jsdate.c **** 		floor((y - 1969) / 4.0) -
  88:Source/js/jsdate.c **** 		floor((y - 1901) / 100.0) +
  89:Source/js/jsdate.c **** 		floor((y - 1601) / 400.0);
  90:Source/js/jsdate.c **** }
