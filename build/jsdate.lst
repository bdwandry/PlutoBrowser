 196:Source/js/jsdate.c **** static double MakeDay(double y, double m, double date)
 197:Source/js/jsdate.c **** {
 198:Source/js/jsdate.c **** 	/*
 199:Source/js/jsdate.c **** 	 * The following array contains the day of year for the first day of
 200:Source/js/jsdate.c **** 	 * each month, where index 0 is January, and day 0 is January 1.
 201:Source/js/jsdate.c **** 	 */
 202:Source/js/jsdate.c **** 	static const double firstDayOfMonth[2][12] = {
 203:Source/js/jsdate.c **** 		{0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334},
 204:Source/js/jsdate.c **** 		{0, 31, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335}
 205:Source/js/jsdate.c **** 	};
 206:Source/js/jsdate.c **** 
 207:Source/js/jsdate.c **** 	double yd, md;
 208:Source/js/jsdate.c **** 	int im;
 209:Source/js/jsdate.c **** 
 210:Source/js/jsdate.c **** 	y += floor(m / 12);
 211:Source/js/jsdate.c **** 	m = pmod(m, 12);
 212:Source/js/jsdate.c **** 
 213:Source/js/jsdate.c **** 	im = (int)m;
 214:Source/js/jsdate.c **** 	if (im < 0 || im >= 12)
 215:Source/js/jsdate.c **** 		return NAN;
 216:Source/js/jsdate.c **** 
 217:Source/js/jsdate.c **** 	yd = floor(TimeFromYear(y) / msPerDay);
 218:Source/js/jsdate.c **** 	md = firstDayOfMonth[DaysInYear(y) == 366][im];
 219:Source/js/jsdate.c **** 
 220:Source/js/jsdate.c **** 	return yd + md + date - 1;
 221:Source/js/jsdate.c **** }
