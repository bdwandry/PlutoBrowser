 360:Source/js/jsdate.c **** /* Date functions */
 361:Source/js/jsdate.c **** 
 362:Source/js/jsdate.c **** static double js_todate(js_State *J, int idx)
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccqOsqBI.s 			page 9


 363:Source/js/jsdate.c **** {
 364:Source/js/jsdate.c **** 	js_Object *self = js_toobject(J, idx);
 365:Source/js/jsdate.c **** 	if (self->type != JS_CDATE)
 366:Source/js/jsdate.c **** 		js_typeerror(J, "not a date");
 367:Source/js/jsdate.c **** 	return self->u.number;
 368:Source/js/jsdate.c **** }
 369:Source/js/jsdate.c **** 
 370:Source/js/jsdate.c **** static void js_setdate(js_State *J, int idx, double t)
 371:Source/js/jsdate.c **** {
 372:Source/js/jsdate.c **** 	js_Object *self = js_toobject(J, idx);
 373:Source/js/jsdate.c **** 	if (self->type != JS_CDATE)
 374:Source/js/jsdate.c **** 		js_typeerror(J, "not a date");
 375:Source/js/jsdate.c **** 	self->u.number = TimeClip(t);
 376:Source/js/jsdate.c **** 	js_pushnumber(J, self->u.number);
 377:Source/js/jsdate.c **** }
 378:Source/js/jsdate.c **** 
 379:Source/js/jsdate.c **** static void D_parse(js_State *J)
 380:Source/js/jsdate.c **** {
 381:Source/js/jsdate.c **** 	double t = parseDateTime(js_tostring(J, 1));
 382:Source/js/jsdate.c **** 	js_pushnumber(J, t);
 383:Source/js/jsdate.c **** }
 384:Source/js/jsdate.c **** 
 385:Source/js/jsdate.c **** static void D_UTC(js_State *J)
 386:Source/js/jsdate.c **** {
 387:Source/js/jsdate.c **** 	double y, m, d, H, M, S, ms, t;
 388:Source/js/jsdate.c **** 	y = js_tonumber(J, 1);
 389:Source/js/jsdate.c **** 	if (y < 100) y += 1900;
 390:Source/js/jsdate.c **** 	m = js_tonumber(J, 2);
 391:Source/js/jsdate.c **** 	d = js_optnumber(J, 3, 1);
 392:Source/js/jsdate.c **** 	H = js_optnumber(J, 4, 0);
 393:Source/js/jsdate.c **** 	M = js_optnumber(J, 5, 0);
 394:Source/js/jsdate.c **** 	S = js_optnumber(J, 6, 0);
 395:Source/js/jsdate.c **** 	ms = js_optnumber(J, 7, 0);
 396:Source/js/jsdate.c **** 	t = MakeDate(MakeDay(y, m, d), MakeTime(H, M, S, ms));
 397:Source/js/jsdate.c **** 	t = TimeClip(t);
 398:Source/js/jsdate.c **** 	js_pushnumber(J, t);
 399:Source/js/jsdate.c **** }
