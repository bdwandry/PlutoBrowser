 784:Source/js/jscompile.c **** /* Patch break and continue statements */
 785:Source/js/jscompile.c **** 
 786:Source/js/jscompile.c **** static void addjump(JF, enum js_AstType type, js_Ast *target, int inst)
 787:Source/js/jscompile.c **** {
 788:Source/js/jscompile.c **** 	js_JumpList *jump = js_malloc(J, sizeof *jump);
 789:Source/js/jscompile.c **** 	jump->type = type;
 790:Source/js/jscompile.c **** 	jump->inst = inst;
 791:Source/js/jscompile.c **** 	jump->next = target->jumps;
 792:Source/js/jscompile.c **** 	target->jumps = jump;
 793:Source/js/jscompile.c **** }
 794:Source/js/jscompile.c **** 
 795:Source/js/jscompile.c **** static void labeljumps(JF, js_Ast *stm, int baddr, int caddr)
 796:Source/js/jscompile.c **** {
 797:Source/js/jscompile.c **** 	js_JumpList *jump = stm->jumps;
 798:Source/js/jscompile.c **** 	while (jump) {
 799:Source/js/jscompile.c **** 		js_JumpList *next = jump->next;
 800:Source/js/jscompile.c **** 		if (jump->type == STM_BREAK)
 801:Source/js/jscompile.c **** 			labelto(J, F, jump->inst, baddr);
 802:Source/js/jscompile.c **** 		if (jump->type == STM_CONTINUE)
 803:Source/js/jscompile.c **** 			labelto(J, F, jump->inst, caddr);
 804:Source/js/jscompile.c **** 		js_free(J, jump);
 805:Source/js/jscompile.c **** 		jump = next;
 806:Source/js/jscompile.c **** 	}
 807:Source/js/jscompile.c **** 	stm->jumps = NULL;
 808:Source/js/jscompile.c **** }
 809:Source/js/jscompile.c **** 
 810:Source/js/jscompile.c **** static int isloop(enum js_AstType T)
 811:Source/js/jscompile.c **** {
