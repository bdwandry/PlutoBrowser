 283:Source/js/jscompile.c **** static void carray(JF, js_Ast *list)
 284:Source/js/jscompile.c **** {
 285:Source/js/jscompile.c **** 	while (list) {
 286:Source/js/jscompile.c **** 		emitline(J, F, list->a);
 287:Source/js/jscompile.c **** 		if (list->a->type == EXP_ELISION) {
 288:Source/js/jscompile.c **** 			emit(J, F, OP_SKIPARRAY);
 289:Source/js/jscompile.c **** 		} else {
 290:Source/js/jscompile.c **** 			cexp(J, F, list->a);
 291:Source/js/jscompile.c **** 			emit(J, F, OP_INITARRAY);
 292:Source/js/jscompile.c **** 		}
 293:Source/js/jscompile.c **** 		list = list->b;
 294:Source/js/jscompile.c **** 	}
 295:Source/js/jscompile.c **** }
