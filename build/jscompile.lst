 935:Source/js/jscompile.c **** /* Try/catch/finally */
 936:Source/js/jscompile.c **** 
 937:Source/js/jscompile.c **** static void ctryfinally(JF, js_Ast *trystm, js_Ast *finallystm)
 938:Source/js/jscompile.c **** {
