 376:Source/js/jscompile.c **** static void cassign(JF, js_Ast *exp)
 377:Source/js/jscompile.c **** {
 378:Source/js/jscompile.c **** 	js_Ast *lhs = exp->a;
 379:Source/js/jscompile.c **** 	js_Ast *rhs = exp->b;
 380:Source/js/jscompile.c **** 	switch (lhs->type) {
 381:Source/js/jscompile.c **** 	case EXP_IDENTIFIER:
 382:Source/js/jscompile.c **** 		cexp(J, F, rhs);
 383:Source/js/jscompile.c **** 		emitline(J, F, exp);
 384:Source/js/jscompile.c **** 		emitlocal(J, F, OP_SETLOCAL, OP_SETVAR, lhs);
 385:Source/js/jscompile.c **** 		break;
 386:Source/js/jscompile.c **** 	case EXP_INDEX:
 387:Source/js/jscompile.c **** 		cexp(J, F, lhs->a);
 388:Source/js/jscompile.c **** 		cexp(J, F, lhs->b);
 389:Source/js/jscompile.c **** 		cexp(J, F, rhs);
 390:Source/js/jscompile.c **** 		emitline(J, F, exp);
 391:Source/js/jscompile.c **** 		emit(J, F, OP_SETPROP);
 392:Source/js/jscompile.c **** 		break;
 393:Source/js/jscompile.c **** 	case EXP_MEMBER:
 394:Source/js/jscompile.c **** 		cexp(J, F, lhs->a);
 395:Source/js/jscompile.c **** 		cexp(J, F, rhs);
 396:Source/js/jscompile.c **** 		emitline(J, F, exp);
 397:Source/js/jscompile.c **** 		emitstring(J, F, OP_SETPROP_S, lhs->b->string);
 398:Source/js/jscompile.c **** 		break;
 399:Source/js/jscompile.c **** 	default:
 400:Source/js/jscompile.c **** 		jsC_error(J, lhs, "invalid l-value in assignment");
 401:Source/js/jscompile.c **** 	}
 402:Source/js/jscompile.c **** }
