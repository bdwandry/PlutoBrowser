 882:Source/js/jscompile.c **** 		switch (node->type) {
 883:Source/js/jscompile.c **** 		default:
 884:Source/js/jscompile.c **** 			/* impossible */
 885:Source/js/jscompile.c **** 			break;
 886:Source/js/jscompile.c **** 		case STM_WITH:
 887:Source/js/jscompile.c **** 			emitline(J, F, node);
 888:Source/js/jscompile.c **** 			emit(J, F, OP_ENDWITH);
 889:Source/js/jscompile.c **** 			break;
 890:Source/js/jscompile.c **** 		case STM_FOR_IN:
 891:Source/js/jscompile.c **** 		case STM_FOR_IN_VAR:
 892:Source/js/jscompile.c **** 			emitline(J, F, node);
 893:Source/js/jscompile.c **** 			/* pop the iterator if leaving the loop */
 894:Source/js/jscompile.c **** 			if (F->script) {
 895:Source/js/jscompile.c **** 				if (T == STM_RETURN || T == STM_BREAK || (T == STM_CONTINUE && target != node)) {
