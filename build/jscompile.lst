 563:Source/js/jscompile.c **** 	default:
 564:Source/js/jscompile.c **** 		cexp(J, F, fun);
 565:Source/js/jscompile.c **** 		emit(J, F, OP_UNDEF);
 566:Source/js/jscompile.c **** 		break;
 567:Source/js/jscompile.c **** 	}
 568:Source/js/jscompile.c **** 	n = cargs(J, F, args);
 569:Source/js/jscompile.c **** 	emit(J, F, OP_CALL);
 570:Source/js/jscompile.c **** 	emitarg(J, F, n);
 571:Source/js/jscompile.c **** }
