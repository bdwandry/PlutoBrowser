 813:Source/js/jscompile.c **** 		T == STM_FOR || T == STM_FOR_VAR ||
 814:Source/js/jscompile.c **** 		T == STM_FOR_IN || T == STM_FOR_IN_VAR;
 815:Source/js/jscompile.c **** }
 816:Source/js/jscompile.c **** 
 817:Source/js/jscompile.c **** static int isfun(enum js_AstType T)
 818:Source/js/jscompile.c **** {
 819:Source/js/jscompile.c **** 	return T == AST_FUNDEC || T == EXP_FUN || T == EXP_PROP_GET || T == EXP_PROP_SET;
 820:Source/js/jscompile.c **** }
