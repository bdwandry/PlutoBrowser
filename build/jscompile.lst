 156:Source/js/jscompile.c **** static void emitnumber(JF, double num)
 157:Source/js/jscompile.c **** {
 158:Source/js/jscompile.c **** 	if (num == 0) {
 159:Source/js/jscompile.c **** 		emit(J, F, OP_INTEGER);
 160:Source/js/jscompile.c **** 		emitarg(J, F, 32768);
 161:Source/js/jscompile.c **** 		if (signbit(num))
 162:Source/js/jscompile.c **** 			emit(J, F, OP_NEG);
 163:Source/js/jscompile.c **** 	} else if (num >= SHRT_MIN && num <= SHRT_MAX && num == (int)num) {
 164:Source/js/jscompile.c **** 		emit(J, F, OP_INTEGER);
 165:Source/js/jscompile.c **** 		emitarg(J, F, num + 32768);
 166:Source/js/jscompile.c **** 	} else {
 167:Source/js/jscompile.c **** #define N (sizeof(num) / sizeof(js_Instruction))
 168:Source/js/jscompile.c **** 		js_Instruction x[N];
 169:Source/js/jscompile.c **** 		size_t i;
 170:Source/js/jscompile.c **** 		emit(J, F, OP_NUMBER);
 171:Source/js/jscompile.c **** 		memcpy(x, &num, sizeof(num));
 172:Source/js/jscompile.c **** 		for (i = 0; i < N; ++i)
 173:Source/js/jscompile.c **** 			emitarg(J, F, x[i]);
 174:Source/js/jscompile.c **** #undef N
 175:Source/js/jscompile.c **** 	}
 176:Source/js/jscompile.c **** }
