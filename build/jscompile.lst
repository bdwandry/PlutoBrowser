 297:Source/js/jscompile.c **** static void checkdup(JF, js_Ast *list, js_Ast *end)
 298:Source/js/jscompile.c **** {
 299:Source/js/jscompile.c **** 	char nbuf[32], sbuf[32];
 300:Source/js/jscompile.c **** 	const char *needle, *straw;
 301:Source/js/jscompile.c **** 
 302:Source/js/jscompile.c **** 	if (end->a->type == EXP_NUMBER)
 303:Source/js/jscompile.c **** 		needle = jsV_numbertostring(J, nbuf, end->a->number);
 304:Source/js/jscompile.c **** 	else
 305:Source/js/jscompile.c **** 		needle = end->a->string;
 306:Source/js/jscompile.c **** 
 307:Source/js/jscompile.c **** 	while (list->a != end) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccFuvmgY.s 			page 8


 308:Source/js/jscompile.c **** 		if (list->a->type == end->type) {
 309:Source/js/jscompile.c **** 			js_Ast *prop = list->a->a;
 310:Source/js/jscompile.c **** 			if (prop->type == EXP_NUMBER)
 311:Source/js/jscompile.c **** 				straw = jsV_numbertostring(J, sbuf, prop->number);
 312:Source/js/jscompile.c **** 			else
 313:Source/js/jscompile.c **** 				straw =  prop->string;
 314:Source/js/jscompile.c **** 			if (!strcmp(needle, straw))
 315:Source/js/jscompile.c **** 				jsC_error(J, list, "duplicate property '%s' in object literal", needle);
 316:Source/js/jscompile.c **** 		}
 317:Source/js/jscompile.c **** 		list = list->b;
 318:Source/js/jscompile.c **** 	}
 319:Source/js/jscompile.c **** }
