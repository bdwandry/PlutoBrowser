 897:Source/js/jscompile.c **** 					emit(J, F, OP_ROT2);
 898:Source/js/jscompile.c **** 					emit(J, F, OP_POP);
 899:Source/js/jscompile.c **** 				}
 900:Source/js/jscompile.c **** 				if (T == STM_CONTINUE)
 901:Source/js/jscompile.c **** 					emit(J, F, OP_ROT2); /* put the iterator back on top */
 902:Source/js/jscompile.c **** 			} else {
 903:Source/js/jscompile.c **** 				if (T == STM_RETURN) {
 904:Source/js/jscompile.c **** 					/* pop the iterator, save the return value */
 905:Source/js/jscompile.c **** 					emit(J, F, OP_ROT2);
 906:Source/js/jscompile.c **** 					emit(J, F, OP_POP);
 907:Source/js/jscompile.c **** 				}
 908:Source/js/jscompile.c **** 				if (T == STM_BREAK || (T == STM_CONTINUE && target != node))
 909:Source/js/jscompile.c **** 					emit(J, F, OP_POP); /* pop the iterator */
 910:Source/js/jscompile.c **** 			}
 911:Source/js/jscompile.c **** 			break;
 912:Source/js/jscompile.c **** 		case STM_TRY:
 913:Source/js/jscompile.c **** 			emitline(J, F, node);
 914:Source/js/jscompile.c **** 			/* came from try block */
 915:Source/js/jscompile.c **** 			if (prev == node->a) {
 916:Source/js/jscompile.c **** 				emit(J, F, OP_ENDTRY);
 917:Source/js/jscompile.c **** 				if (node->d) cstm(J, F, node->d); /* finally */
 918:Source/js/jscompile.c **** 			}
 919:Source/js/jscompile.c **** 			/* came from catch block */
 920:Source/js/jscompile.c **** 			if (prev == node->c) {
 921:Source/js/jscompile.c **** 				/* ... with finally */
 922:Source/js/jscompile.c **** 				if (node->d) {
 923:Source/js/jscompile.c **** 					emit(J, F, OP_ENDCATCH);
 924:Source/js/jscompile.c **** 					emit(J, F, OP_ENDTRY);
 925:Source/js/jscompile.c **** 					cstm(J, F, node->d); /* finally */
 926:Source/js/jscompile.c **** 				} else {
 927:Source/js/jscompile.c **** 					emit(J, F, OP_ENDCATCH);
 928:Source/js/jscompile.c **** 				}
 929:Source/js/jscompile.c **** 			}
 930:Source/js/jscompile.c **** 			break;
 931:Source/js/jscompile.c **** 		}
 932:Source/js/jscompile.c **** 	} while (node != target);
 933:Source/js/jscompile.c **** }
