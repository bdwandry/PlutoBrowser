 425:Source/js/jscompile.c **** 		cexp(J, F, lhs->b);
 426:Source/js/jscompile.c **** 		emitline(J, F, lhs);
 427:Source/js/jscompile.c **** 		emit(J, F, OP_ROT3);
 428:Source/js/jscompile.c **** 		emit(J, F, OP_SETPROP);
 429:Source/js/jscompile.c **** 		emit(J, F, OP_POP);
 430:Source/js/jscompile.c **** 		break;
 431:Source/js/jscompile.c **** 	case EXP_MEMBER:
 432:Source/js/jscompile.c **** 		cexp(J, F, lhs->a);
 433:Source/js/jscompile.c **** 		emitline(J, F, lhs);
 434:Source/js/jscompile.c **** 		emit(J, F, OP_ROT2);
 435:Source/js/jscompile.c **** 		emitstring(J, F, OP_SETPROP_S, lhs->b->string);
 436:Source/js/jscompile.c **** 		emit(J, F, OP_POP);
 437:Source/js/jscompile.c **** 		break;
 438:Source/js/jscompile.c **** 	default:
