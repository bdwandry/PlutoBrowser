 875:Source/js/jscompile.c **** /* Emit code to rebalance stack and scopes during an abrupt exit */
 876:Source/js/jscompile.c **** 
 877:Source/js/jscompile.c **** static void cexit(JF, enum js_AstType T, js_Ast *node, js_Ast *target)
 878:Source/js/jscompile.c **** {
 879:Source/js/jscompile.c **** 	js_Ast *prev;
 880:Source/js/jscompile.c **** 	do {
 881:Source/js/jscompile.c **** 		prev = node, node = node->parent;
