 540:Source/js/jscompile.c **** static void ccall(JF, js_Ast *fun, js_Ast *args)
 541:Source/js/jscompile.c **** {
 542:Source/js/jscompile.c **** 	int n;
 543:Source/js/jscompile.c **** 	switch (fun->type) {
 544:Source/js/jscompile.c **** 	case EXP_INDEX:
 545:Source/js/jscompile.c **** 		cexp(J, F, fun->a);
 546:Source/js/jscompile.c **** 		emit(J, F, OP_DUP);
 547:Source/js/jscompile.c **** 		cexp(J, F, fun->b);
 548:Source/js/jscompile.c **** 		emit(J, F, OP_GETPROP);
 549:Source/js/jscompile.c **** 		emit(J, F, OP_ROT2);
 550:Source/js/jscompile.c **** 		break;
 551:Source/js/jscompile.c **** 	case EXP_MEMBER:
 552:Source/js/jscompile.c **** 		cexp(J, F, fun->a);
 553:Source/js/jscompile.c **** 		emit(J, F, OP_DUP);
 554:Source/js/jscompile.c **** 		emitstring(J, F, OP_GETPROP_S, fun->b->string);
 555:Source/js/jscompile.c **** 		emit(J, F, OP_ROT2);
 556:Source/js/jscompile.c **** 		break;
 557:Source/js/jscompile.c **** 	case EXP_IDENTIFIER:
 558:Source/js/jscompile.c **** 		if (!strcmp(fun->string, "eval")) {
 559:Source/js/jscompile.c **** 			ceval(J, F, fun, args);
 560:Source/js/jscompile.c **** 			return;
 561:Source/js/jscompile.c **** 		}
