 321:Source/js/jscompile.c **** static void cobject(JF, js_Ast *list)
 322:Source/js/jscompile.c **** {
 323:Source/js/jscompile.c **** 	js_Ast *head = list;
 324:Source/js/jscompile.c **** 
 325:Source/js/jscompile.c **** 	while (list) {
 326:Source/js/jscompile.c **** 		js_Ast *kv = list->a;
 327:Source/js/jscompile.c **** 		js_Ast *prop = kv->a;
 328:Source/js/jscompile.c **** 
 329:Source/js/jscompile.c **** 		if (prop->type == AST_IDENTIFIER || prop->type == EXP_STRING) {
 330:Source/js/jscompile.c **** 			emitline(J, F, prop);
 331:Source/js/jscompile.c **** 			emitstring(J, F, OP_STRING, prop->string);
 332:Source/js/jscompile.c **** 		} else if (prop->type == EXP_NUMBER) {
 333:Source/js/jscompile.c **** 			emitline(J, F, prop);
 334:Source/js/jscompile.c **** 			emitnumber(J, F, prop->number);
 335:Source/js/jscompile.c **** 		} else {
 336:Source/js/jscompile.c **** 			jsC_error(J, prop, "invalid property name in object initializer");
 337:Source/js/jscompile.c **** 		}
 338:Source/js/jscompile.c **** 
 339:Source/js/jscompile.c **** 		if (F->strict)
 340:Source/js/jscompile.c **** 			checkdup(J, F, head, kv);
 341:Source/js/jscompile.c **** 
 342:Source/js/jscompile.c **** 		switch (kv->type) {
 343:Source/js/jscompile.c **** 		default: /* impossible */ break;
 344:Source/js/jscompile.c **** 		case EXP_PROP_VAL:
 345:Source/js/jscompile.c **** 			cexp(J, F, kv->b);
 346:Source/js/jscompile.c **** 			emitline(J, F, kv);
 347:Source/js/jscompile.c **** 			emit(J, F, OP_INITPROP);
 348:Source/js/jscompile.c **** 			break;
 349:Source/js/jscompile.c **** 		case EXP_PROP_GET:
 350:Source/js/jscompile.c **** 			emitfunction(J, F, newfun(J, prop->line, NULL, NULL, kv->c, 0, F->strict, 1));
 351:Source/js/jscompile.c **** 			emitline(J, F, kv);
 352:Source/js/jscompile.c **** 			emit(J, F, OP_INITGETTER);
 353:Source/js/jscompile.c **** 			break;
 354:Source/js/jscompile.c **** 		case EXP_PROP_SET:
 355:Source/js/jscompile.c **** 			emitfunction(J, F, newfun(J, prop->line, NULL, kv->b, kv->c, 0, F->strict, 1));
 356:Source/js/jscompile.c **** 			emitline(J, F, kv);
 357:Source/js/jscompile.c **** 			emit(J, F, OP_INITSETTER);
 358:Source/js/jscompile.c **** 			break;
 359:Source/js/jscompile.c **** 		}
 360:Source/js/jscompile.c **** 
 361:Source/js/jscompile.c **** 		list = list->b;
 362:Source/js/jscompile.c **** 	}
 363:Source/js/jscompile.c **** }
