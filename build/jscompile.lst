 941:Source/js/jscompile.c **** 	{
 942:Source/js/jscompile.c **** 		/* if we get here, we have caught an exception in the try block */
 943:Source/js/jscompile.c **** 		cstm(J, F, finallystm); /* inline finally block */
 944:Source/js/jscompile.c **** 		emit(J, F, OP_THROW); /* rethrow exception */
