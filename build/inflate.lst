 479:Source/render/decoders/inflate.c **** static void st_pump_until(InflateStream* s, size_t n) {
 480:Source/render/decoders/inflate.c ****     while (!s->eof && (s->pendLen - s->pendHead) < n) {
 481:Source/render/decoders/inflate.c ****         tasks_yield_check();
 482:Source/render/decoders/inflate.c ****         if (s->mode == ST_UNCOMPRESSED) {
 483:Source/render/decoders/inflate.c ****             if (s->remaining > 0) {
 484:Source/render/decoders/inflate.c ****                 s->remaining--;
 485:Source/render/decoders/inflate.c ****                 int b = bs_read_bits(&s->bs, 8);
 486:Source/render/decoders/inflate.c ****                 if (b < 0) { s->eof = 1; break; }
 487:Source/render/decoders/inflate.c ****                 st_emit(s, (uint8_t)b);
 488:Source/render/decoders/inflate.c ****             } else {
 489:Source/render/decoders/inflate.c ****                 if (s->isFinalBlock) { s->eof = 1; break; }
 490:Source/render/decoders/inflate.c ****                 s->mode = ST_BLOCK;
 491:Source/render/decoders/inflate.c ****             }
 492:Source/render/decoders/inflate.c ****         } else if (s->mode == ST_BLOCK) {
 493:Source/render/decoders/inflate.c ****             st_begin_block(s);
 494:Source/render/decoders/inflate.c ****         } else {   /* ST_HUFF */
 495:Source/render/decoders/inflate.c ****             int sym = decode_symbol(&s->bs, &s->litTable);
 496:Source/render/decoders/inflate.c ****             if (sym < 0) { s->eof = 1; break; }
 497:Source/render/decoders/inflate.c ****             if (sym == 256) {
 498:Source/render/decoders/inflate.c ****                 if (s->isFinalBlock) { s->eof = 1; break; }
 499:Source/render/decoders/inflate.c ****                 s->mode = ST_BLOCK;
 500:Source/render/decoders/inflate.c ****             } else if (sym < 256) {
 501:Source/render/decoders/inflate.c ****                 st_emit(s, (uint8_t)sym);
 502:Source/render/decoders/inflate.c ****             } else {
 503:Source/render/decoders/inflate.c ****                 int idx = sym - 257;
 504:Source/render/decoders/inflate.c ****                 int baseL = idx < 29 ? kLengthBase[idx] : 3;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cclsQyQR.s 			page 79


 505:Source/render/decoders/inflate.c ****                 int el = idx < 29 ? kLengthExtra[idx] : 0;
 506:Source/render/decoders/inflate.c ****                 int extraL = 0;
 507:Source/render/decoders/inflate.c ****                 if (el > 0) {
 508:Source/render/decoders/inflate.c ****                     int v = bs_read_bits(&s->bs, el);
 509:Source/render/decoders/inflate.c ****                     extraL = v < 0 ? 0 : v;
 510:Source/render/decoders/inflate.c ****                 }
 511:Source/render/decoders/inflate.c ****                 int len = baseL + extraL;
 512:Source/render/decoders/inflate.c ****                 int distSym = decode_symbol(&s->bs, &s->distTable);
 513:Source/render/decoders/inflate.c ****                 if (distSym < 0) { s->eof = 1; break; }
 514:Source/render/decoders/inflate.c ****                 int baseD = distSym < 30 ? kDistBase[distSym] : 1;
 515:Source/render/decoders/inflate.c ****                 int ed = distSym < 30 ? kDistExtra[distSym] : 0;
 516:Source/render/decoders/inflate.c ****                 int extraD = 0;
 517:Source/render/decoders/inflate.c ****                 if (ed > 0) {
 518:Source/render/decoders/inflate.c ****                     int v = bs_read_bits(&s->bs, ed);
 519:Source/render/decoders/inflate.c ****                     extraD = v < 0 ? 0 : v;
 520:Source/render/decoders/inflate.c ****                 }
 521:Source/render/decoders/inflate.c ****                 st_emit_match(s, len, baseD + extraD);
 522:Source/render/decoders/inflate.c ****             }
 523:Source/render/decoders/inflate.c ****         }
 524:Source/render/decoders/inflate.c ****     }
 525:Source/render/decoders/inflate.c **** }
