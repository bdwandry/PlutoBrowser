  45:Source/render/decoders/inflate.c **** static void bs_align_byte(BitStream* bs) {
  46:Source/render/decoders/inflate.c ****     int drop = bs->bitCount & 7;
  47:Source/render/decoders/inflate.c ****     if (drop > 0) {
  48:Source/render/decoders/inflate.c ****         bs->bitBuf >>= drop;
  49:Source/render/decoders/inflate.c ****         bs->bitCount -= drop;
