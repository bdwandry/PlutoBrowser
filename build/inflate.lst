  72:Source/render/decoders/inflate.c **** static int huff_cmp(const void* a, const void* b) {
  73:Source/render/decoders/inflate.c ****     const HuffEntry* ea = (const HuffEntry*)a;
  74:Source/render/decoders/inflate.c ****     const HuffEntry* eb = (const HuffEntry*)b;
  75:Source/render/decoders/inflate.c ****     if (ea->len != eb->len) return ea->len < eb->len ? -1 : 1;
  76:Source/render/decoders/inflate.c ****     /* deterministic tie order (Lua's unstable sort is order-irrelevant
  77:Source/render/decoders/inflate.c ****      * here: codes within one length are unique) */
  78:Source/render/decoders/inflate.c ****     return ea->symbol < eb->symbol ? -1 : (ea->symbol > eb->symbol ? 1 : 0);
  79:Source/render/decoders/inflate.c **** }
