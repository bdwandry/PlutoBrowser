 546:Source/render/decoders/inflate.c **** /* Lua beginBlock: returns 0 when eof was set. */
 547:Source/render/decoders/inflate.c **** static int st_begin_block(InflateStream *s)
 548:Source/render/decoders/inflate.c **** {
 549:Source/render/decoders/inflate.c ****     uint32_t fin = 0, btype = 0;
 550:Source/render/decoders/inflate.c ****     int okF = bs_read_bits(&s->bs, 1, &fin);
 551:Source/render/decoders/inflate.c ****     int okB = bs_read_bits(&s->bs, 2, &btype);
 552:Source/render/decoders/inflate.c ****     if (!okF || !okB)
 553:Source/render/decoders/inflate.c ****     {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccRfnRtN.s 			page 77


 554:Source/render/decoders/inflate.c ****         s->eof = 1;
 555:Source/render/decoders/inflate.c ****         return 0;
 556:Source/render/decoders/inflate.c ****     }
 557:Source/render/decoders/inflate.c ****     s->isFinalBlock = (fin == 1);
 558:Source/render/decoders/inflate.c ****     if (btype == 0)
 559:Source/render/decoders/inflate.c ****     {
 560:Source/render/decoders/inflate.c ****         bs_align_byte(&s->bs);
 561:Source/render/decoders/inflate.c ****         s->remaining = (int)bs_read_bits_or0(&s->bs, 16);
 562:Source/render/decoders/inflate.c ****         (void)bs_read_bits_or0(&s->bs, 16); /* NLEN */
 563:Source/render/decoders/inflate.c ****         s->mode = 1;
 564:Source/render/decoders/inflate.c ****     }
 565:Source/render/decoders/inflate.c ****     else if (btype == 1)
 566:Source/render/decoders/inflate.c ****     {
 567:Source/render/decoders/inflate.c ****         inf_fixed_tables();
 568:Source/render/decoders/inflate.c ****         s->litT = fixedLit;
 569:Source/render/decoders/inflate.c ****         s->distT = fixedDist;
 570:Source/render/decoders/inflate.c ****         s->mode = 2;
 571:Source/render/decoders/inflate.c ****     }
 572:Source/render/decoders/inflate.c ****     else if (btype == 2)
 573:Source/render/decoders/inflate.c ****     {
 574:Source/render/decoders/inflate.c ****         if (!inf_read_dynamic(&s->bs, &s->litT, &s->distT, 1))
 575:Source/render/decoders/inflate.c ****         {
 576:Source/render/decoders/inflate.c ****             s->eof = 1;
 577:Source/render/decoders/inflate.c ****             return 0;
 578:Source/render/decoders/inflate.c ****         }
 579:Source/render/decoders/inflate.c ****         s->mode = 2;
 580:Source/render/decoders/inflate.c ****     }
 581:Source/render/decoders/inflate.c ****     /* btype == 3: no branch in Lua — mode unchanged; the pump keeps
 582:Source/render/decoders/inflate.c ****      * calling beginBlock, consuming bits until EOF. Preserved. */
 583:Source/render/decoders/inflate.c ****     return 1;
 584:Source/render/decoders/inflate.c **** }
