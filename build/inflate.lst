 288:Source/render/decoders/inflate.c **** /* ── one-shot decompress ───────────────────────
 289:Source/render/decoders/inflate.c **** 
 290:Source/render/decoders/inflate.c **** long inflate_decompress(const uint8_t* data, size_t len,
 291:Source/render/decoders/inflate.c ****                         uint8_t** out, size_t* outLen) {
 292:Source/render/decoders/inflate.c ****     *out = NULL;
 293:Source/render/decoders/inflate.c ****     *outLen = 0;
 294:Source/render/decoders/inflate.c ****     if (data == NULL || len < 2) return -1;
 295:Source/render/decoders/inflate.c **** 
 296:Source/render/decoders/inflate.c ****     BitStream bs;
 297:Source/render/decoders/inflate.c ****     bs_init(&bs, data + zlib_skip(data, len), len - zlib_skip(data, len));
 298:Source/render/decoders/inflate.c **** 
 299:Source/render/decoders/inflate.c ****     ByteOut output = {0};
 300:Source/render/decoders/inflate.c ****     int isFinal = 0;
 301:Source/render/decoders/inflate.c ****     while (isFinal == 0) {
 302:Source/render/decoders/inflate.c ****         isFinal = bs_read_bits(&bs, 1);
 303:Source/render/decoders/inflate.c ****         int btype = bs_read_bits(&bs, 2);
 304:Source/render/decoders/inflate.c ****         if (btype < 0) break;
 305:Source/render/decoders/inflate.c **** 
 306:Source/render/decoders/inflate.c ****         if (btype == 0) {                       /* uncompressed block */
 307:Source/render/decoders/inflate.c ****             bs_align_byte(&bs);
 308:Source/render/decoders/inflate.c ****             int blen = bs_read_bits(&bs, 16);
 309:Source/render/decoders/inflate.c ****             bs_read_bits(&bs, 16);              /* NLEN */
 310:Source/render/decoders/inflate.c ****             if (blen < 0) break;
 311:Source/render/decoders/inflate.c ****             for (int i = 0; i < blen; i++) {
 312:Source/render/decoders/inflate.c ****                 int b = bs_read_bits(&bs, 8);
 313:Source/render/decoders/inflate.c ****                 if (b < 0) break;
 314:Source/render/decoders/inflate.c ****                 if (bo_push(&output, (uint8_t)b) != 0) goto done;
 315:Source/render/decoders/inflate.c ****             }
 316:Source/render/decoders/inflate.c ****         } else if (btype == 1 || btype == 2) {  /* Huffman blocks */
 317:Source/render/decoders/inflate.c ****             HuffTable litTable, distTable;
 318:Source/render/decoders/inflate.c ****             if (btype == 1) {
 319:Source/render/decoders/inflate.c ****                 get_fixed_tables();
 320:Source/render/decoders/inflate.c ****                 litTable = s_fixedLit;
 321:Source/render/decoders/inflate.c ****                 distTable = s_fixedDist;
 322:Source/render/decoders/inflate.c ****             } else {
 323:Source/render/decoders/inflate.c ****                 if (read_dynamic_tables(&bs, &litTable, &distTable) != 0)
 324:Source/render/decoders/inflate.c ****                     break;
 325:Source/render/decoders/inflate.c ****             }
 326:Source/render/decoders/inflate.c **** 
 327:Source/render/decoders/inflate.c ****             while (1) {
 328:Source/render/decoders/inflate.c ****                 tasks_yield_check();
 329:Source/render/decoders/inflate.c ****                 int sym = decode_symbol(&bs, &litTable);
 330:Source/render/decoders/inflate.c ****                 if (sym < 0 || sym == 256) break;
 331:Source/render/decoders/inflate.c **** 
 332:Source/render/decoders/inflate.c ****                 if (sym < 256) {
 333:Source/render/decoders/inflate.c ****                     if (bo_push(&output, (uint8_t)sym) != 0) {
 334:Source/render/decoders/inflate.c ****                         if (btype == 2) { huff_free(&litTable);
 335:Source/render/decoders/inflate.c ****                                           huff_free(&distTable); }
 336:Source/render/decoders/inflate.c ****                         goto done;
 337:Source/render/decoders/inflate.c ****                     }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cclsQyQR.s 			page 47


 338:Source/render/decoders/inflate.c ****                 } else {
 339:Source/render/decoders/inflate.c ****                     int idx = sym - 257;
 340:Source/render/decoders/inflate.c ****                     int baseL = idx < 29 ? kLengthBase[idx] : 3;
 341:Source/render/decoders/inflate.c ****                     int extraLBits = idx < 29 ? kLengthExtra[idx] : 0;
 342:Source/render/decoders/inflate.c ****                     int extraL = 0;
 343:Source/render/decoders/inflate.c ****                     if (extraLBits > 0) {
 344:Source/render/decoders/inflate.c ****                         int v = bs_read_bits(&bs, extraLBits);
 345:Source/render/decoders/inflate.c ****                         if (v < 0) v = 0;
 346:Source/render/decoders/inflate.c ****                         extraL = v;
 347:Source/render/decoders/inflate.c ****                     }
 348:Source/render/decoders/inflate.c ****                     int matchLen = baseL + extraL;
 349:Source/render/decoders/inflate.c **** 
 350:Source/render/decoders/inflate.c ****                     int distSym = decode_symbol(&bs, &distTable);
 351:Source/render/decoders/inflate.c ****                     if (distSym < 0) distSym = 0;
 352:Source/render/decoders/inflate.c ****                     int baseD = distSym < 30 ? kDistBase[distSym] : 1;
 353:Source/render/decoders/inflate.c ****                     int extraDBits = distSym < 30 ? kDistExtra[distSym] : 0;
 354:Source/render/decoders/inflate.c ****                     int extraD = 0;
 355:Source/render/decoders/inflate.c ****                     if (extraDBits > 0) {
 356:Source/render/decoders/inflate.c ****                         int v = bs_read_bits(&bs, extraDBits);
 357:Source/render/decoders/inflate.c ****                         if (v < 0) v = 0;
 358:Source/render/decoders/inflate.c ****                         extraD = v;
 359:Source/render/decoders/inflate.c ****                     }
 360:Source/render/decoders/inflate.c ****                     if (bo_copy_match(&output, matchLen,
 361:Source/render/decoders/inflate.c ****                                       baseD + extraD) != 0) {
 362:Source/render/decoders/inflate.c ****                         if (btype == 2) { huff_free(&litTable);
 363:Source/render/decoders/inflate.c ****                                           huff_free(&distTable); }
 364:Source/render/decoders/inflate.c ****                         goto done;
 365:Source/render/decoders/inflate.c ****                     }
 366:Source/render/decoders/inflate.c ****                 }
 367:Source/render/decoders/inflate.c ****             }
 368:Source/render/decoders/inflate.c ****             if (btype == 2) {
 369:Source/render/decoders/inflate.c ****                 huff_free(&litTable);
 370:Source/render/decoders/inflate.c ****                 huff_free(&distTable);
 371:Source/render/decoders/inflate.c ****             }
 372:Source/render/decoders/inflate.c ****         }
 373:Source/render/decoders/inflate.c ****         /* btype == 3: silently skipped, like the Lua original */
 374:Source/render/decoders/inflate.c ****     }
 375:Source/render/decoders/inflate.c **** 
