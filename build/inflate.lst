 132:Source/render/decoders/inflate.c **** static int decode_symbol(BitStream* bs, const HuffTable* huff) {
 133:Source/render/decoders/inflate.c ****     int curCode = 0;
 134:Source/render/decoders/inflate.c ****     int curLen = 0;
 135:Source/render/decoders/inflate.c ****     for (int i = 0; i < huff->count; i++) {
 136:Source/render/decoders/inflate.c ****         const HuffEntry* e = &huff->entries[i];
 137:Source/render/decoders/inflate.c ****         while (curLen < e->len) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cclsQyQR.s 			page 17


 138:Source/render/decoders/inflate.c ****             int bit = bs_read_bits(bs, 1);
 139:Source/render/decoders/inflate.c ****             if (bit < 0) return -1;
 140:Source/render/decoders/inflate.c ****             curCode |= bit << curLen;
 141:Source/render/decoders/inflate.c ****             curLen++;
 142:Source/render/decoders/inflate.c ****         }
 143:Source/render/decoders/inflate.c ****         if (curCode == e->code && curLen == e->len) return e->symbol;
 144:Source/render/decoders/inflate.c ****     }
 145:Source/render/decoders/inflate.c ****     return -1;
 146:Source/render/decoders/inflate.c **** }
