 627:Source/render/decoders/inflate.c ****                 break;
 628:Source/render/decoders/inflate.c ****             }
 629:Source/render/decoders/inflate.c ****             if (sym == 256)
 630:Source/render/decoders/inflate.c ****             {
 631:Source/render/decoders/inflate.c ****                 if (s->isFinalBlock)
 632:Source/render/decoders/inflate.c ****                 {
 633:Source/render/decoders/inflate.c ****                     s->eof = 1;
 634:Source/render/decoders/inflate.c ****                     break;
 635:Source/render/decoders/inflate.c ****                 }
 636:Source/render/decoders/inflate.c ****                 s->mode = 0;
 637:Source/render/decoders/inflate.c ****             }
 638:Source/render/decoders/inflate.c ****             else if (sym < 256)
 639:Source/render/decoders/inflate.c ****             {
 640:Source/render/decoders/inflate.c ****                 st_emit(s, (uint8_t)sym);
 641:Source/render/decoders/inflate.c ****             }
 642:Source/render/decoders/inflate.c ****             else
 643:Source/render/decoders/inflate.c ****             {
 644:Source/render/decoders/inflate.c ****                 int li = sym - 257;
 645:Source/render/decoders/inflate.c ****                 int baseL = (li >= 0 && li < 29) ? lengthBaseTab[li] : 3;
 646:Source/render/decoders/inflate.c ****                 int el = (li >= 0 && li < 29) ? lengthExtraTab[li] : 0;
 647:Source/render/decoders/inflate.c ****                 uint32_t extraL = el > 0 ? bs_read_bits_or0(&s->bs, el) : 0;
 648:Source/render/decoders/inflate.c ****                 int matchLen = baseL + (int)extraL;
