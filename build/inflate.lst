 251:Source/render/decoders/inflate.c **** static int bo_push(ByteOut* o, uint8_t b) {
 252:Source/render/decoders/inflate.c ****     if (bo_reserve(o, 1) != 0) return -1;
 253:Source/render/decoders/inflate.c ****     o->bytes[o->len++] = b;
 254:Source/render/decoders/inflate.c ****     return 0;
 255:Source/render/decoders/inflate.c **** }
 256:Source/render/decoders/inflate.c **** 
 257:Source/render/decoders/inflate.c **** /* copies a match; out-of-range source bytes become 0 (Lua `or 0`) */
 258:Source/render/decoders/inflate.c **** static int bo_copy_match(ByteOut* o, int matchLen, long matchDist) {
 259:Source/render/decoders/inflate.c ****     if (bo_reserve(o, (size_t)(matchLen > 0 ? matchLen : 0)) != 0)
 260:Source/render/decoders/inflate.c ****         return -1;
 261:Source/render/decoders/inflate.c ****     /* base offset fixed once; overlapping copies must observe the bytes
 262:Source/render/decoders/inflate.c ****      * appended by earlier iterations (classic LZ77 semantics) */
 263:Source/render/decoders/inflate.c ****     long srcIdx = (long)o->len - matchDist;
 264:Source/render/decoders/inflate.c ****     for (int i = 0; i < matchLen; i++) {
 265:Source/render/decoders/inflate.c ****         uint8_t b = 0;
 266:Source/render/decoders/inflate.c ****         long idx = srcIdx + i;
 267:Source/render/decoders/inflate.c ****         if (idx >= 0 && (size_t)idx < o->len)
 268:Source/render/decoders/inflate.c ****             b = o->bytes[idx];
 269:Source/render/decoders/inflate.c ****         o->bytes[o->len++] = b;
 270:Source/render/decoders/inflate.c ****     }
 271:Source/render/decoders/inflate.c ****     return 0;
 272:Source/render/decoders/inflate.c **** }
 273:Source/render/decoders/inflate.c **** 
 274:Source/render/decoders/inflate.c **** /* skips zlib CMF/FLG (+ preset dict) header when present */
 275:Source/render/decoders/inflate.c **** static size_t zlib_skip(const uint8_t* data, size_t len) {
 276:Source/render/decoders/inflate.c ****     size_t startPos = 0;
 277:Source/render/decoders/inflate.c ****     if (len >= 2) {
 278:Source/render/decoders/inflate.c ****         int cmf = data[0], flg = data[1];
 279:Source/render/decoders/inflate.c ****         if ((cmf & 0x0F) == 8 && ((cmf * 256 + flg) % 31) == 0) {
 280:Source/render/decoders/inflate.c ****             startPos = 2;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cclsQyQR.s 			page 46


 281:Source/render/decoders/inflate.c ****             if ((flg & 0x20) != 0) startPos += 4;
 282:Source/render/decoders/inflate.c ****         }
 283:Source/render/decoders/inflate.c ****     }
 284:Source/render/decoders/inflate.c ****     if (startPos > len) startPos = len;
 285:Source/render/decoders/inflate.c ****     return startPos;
 286:Source/render/decoders/inflate.c **** }
