 148:Source/render/decoders/inflate.c **** /* ── fixed tables (built once) ─────────────────────
 149:Source/render/decoders/inflate.c **** 
 150:Source/render/decoders/inflate.c **** static HuffTable s_fixedLit, s_fixedDist;
 151:Source/render/decoders/inflate.c **** static int s_fixedLitBuilt = 0;
 152:Source/render/decoders/inflate.c **** 
 153:Source/render/decoders/inflate.c **** static void get_fixed_tables(void) {
 154:Source/render/decoders/inflate.c ****     if (s_fixedLitBuilt) return;
 155:Source/render/decoders/inflate.c **** 
 156:Source/render/decoders/inflate.c ****     uint8_t litLens[288];
 157:Source/render/decoders/inflate.c ****     for (int i = 0; i <= 143; i++) litLens[i] = 8;
 158:Source/render/decoders/inflate.c ****     for (int i = 144; i <= 255; i++) litLens[i] = 9;
 159:Source/render/decoders/inflate.c ****     for (int i = 256; i <= 279; i++) litLens[i] = 7;
 160:Source/render/decoders/inflate.c ****     for (int i = 280; i <= 287; i++) litLens[i] = 8;
 161:Source/render/decoders/inflate.c ****     build_huffman_table(&s_fixedLit, litLens, 288);
 162:Source/render/decoders/inflate.c **** 
 163:Source/render/decoders/inflate.c ****     uint8_t distLens[32];
 164:Source/render/decoders/inflate.c ****     for (int i = 0; i < 32; i++) distLens[i] = 5;
 165:Source/render/decoders/inflate.c ****     build_huffman_table(&s_fixedDist, distLens, 32);
 166:Source/render/decoders/inflate.c ****     s_fixedLitBuilt = 1;
 167:Source/render/decoders/inflate.c **** }
