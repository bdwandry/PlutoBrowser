 654:Source/render/decoders/inflate.c ****                 }
 655:Source/render/decoders/inflate.c ****                 int baseD = distSym <= 29 ? distBaseTab[distSym] : 1;
 656:Source/render/decoders/inflate.c ****                 int ed = distSym <= 29 ? distExtraTab[distSym] : 0;
 657:Source/render/decoders/inflate.c ****                 uint32_t extraD = ed > 0 ? bs_read_bits_or0(&s->bs, ed) : 0;
 658:Source/render/decoders/inflate.c ****                 st_emit_match(s, matchLen, baseD + (int)extraD);
 659:Source/render/decoders/inflate.c ****             }
