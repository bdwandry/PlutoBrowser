 205:Source/render/decoders/inflate.c ****     build_huffman_table(&clTable, codeLens, 19);
 206:Source/render/decoders/inflate.c **** 
 207:Source/render/decoders/inflate.c ****     uint8_t allLens[320];
 208:Source/render/decoders/inflate.c ****     memset(allLens, 0, sizeof(allLens));
 209:Source/render/decoders/inflate.c ****     int nLens = 0;
 210:Source/render/decoders/inflate.c ****     while (nLens < hlit + hdist) {
 211:Source/render/decoders/inflate.c ****         int sym = decode_symbol(bs, &clTable);
 212:Source/render/decoders/inflate.c ****         if (sym < 0) break;
 213:Source/render/decoders/inflate.c ****         if (sym < 16) {
 214:Source/render/decoders/inflate.c ****             allLens[nLens++] = (uint8_t)sym;
 215:Source/render/decoders/inflate.c ****         } else if (sym == 16) {
 216:Source/render/decoders/inflate.c ****             int rc = rb_or0(bs, 2) + 3;
 217:Source/render/decoders/inflate.c ****             uint8_t last = nLens > 0 ? allLens[nLens - 1] : 0;
 218:Source/render/decoders/inflate.c ****             while (rc-- > 0 && nLens < 320) allLens[nLens++] = last;
 219:Source/render/decoders/inflate.c ****         } else if (sym == 17) {
 220:Source/render/decoders/inflate.c ****             int rc = rb_or0(bs, 3) + 3;
 221:Source/render/decoders/inflate.c ****             while (rc-- > 0 && nLens < 320) allLens[nLens++] = 0;
 222:Source/render/decoders/inflate.c ****         } else {   /* 18 */
 223:Source/render/decoders/inflate.c ****             int rc = rb_or0(bs, 7) + 11;
 224:Source/render/decoders/inflate.c ****             while (rc-- > 0 && nLens < 320) allLens[nLens++] = 0;
 225:Source/render/decoders/inflate.c ****         }
 226:Source/render/decoders/inflate.c ****     }
 227:Source/render/decoders/inflate.c ****     huff_free(&clTable);
 228:Source/render/decoders/inflate.c **** 
 229:Source/render/decoders/inflate.c ****     build_huffman_table(litTable, allLens, hlit);
 230:Source/render/decoders/inflate.c ****     build_huffman_table(distTable, allLens + hlit, hdist);
 231:Source/render/decoders/inflate.c ****     return 0;
 232:Source/render/decoders/inflate.c **** }
