 195:Source/render/decoders/inflate.c ****     int hclen = rb_or0(bs, 4) + 4;
 196:Source/render/decoders/inflate.c ****     if (hlit > 288 || hdist > 32) return -1;   /* corrupt; Lua would spin */
 197:Source/render/decoders/inflate.c **** 
 198:Source/render/decoders/inflate.c ****     uint8_t codeLens[19];
 199:Source/render/decoders/inflate.c ****     memset(codeLens, 0, sizeof(codeLens));
 200:Source/render/decoders/inflate.c ****     for (int i = 0; i < hclen; i++) {
 201:Source/render/decoders/inflate.c ****         int cl = bs_read_bits(bs, 3);
 202:Source/render/decoders/inflate.c ****         codeLens[kClOrder[i]] = (uint8_t)(cl < 0 ? 0 : cl);
 203:Source/render/decoders/inflate.c ****     }
