  53:Source/render/decoders/inflate.c **** /* Lua's `bs:readBits(n) or 0`: EOF (-1/nil) coerces to 0 */
  54:Source/render/decoders/inflate.c **** static int rb_or0(BitStream* bs, int n) {
  55:Source/render/decoders/inflate.c ****     int v = bs_read_bits(bs, n);
  56:Source/render/decoders/inflate.c ****     return v < 0 ? 0 : v;
  57:Source/render/decoders/inflate.c **** }
