 190:Source/render/decoders/inflate.c **** /* dynamic-header helper shared by both decoders; returns 0 ok / -1 eof */
 191:Source/render/decoders/inflate.c **** static int read_dynamic_tables(BitStream* bs, HuffTable* litTable,
 192:Source/render/decoders/inflate.c ****                                HuffTable* distTable) {
 193:Source/render/decoders/inflate.c ****     int hlit = rb_or0(bs, 5) + 257;
 194:Source/render/decoders/inflate.c ****     int hdist = rb_or0(bs, 5) + 1;
