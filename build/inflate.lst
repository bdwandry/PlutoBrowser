 536:Source/render/decoders/inflate.c **** static void st_emit_match(InflateStream *s, int matchLen, int matchDist)
 537:Source/render/decoders/inflate.c **** {
 538:Source/render/decoders/inflate.c ****     for (int i = 0; i < matchLen; i++)
 539:Source/render/decoders/inflate.c ****     {
 540:Source/render/decoders/inflate.c ****         long long rel = (s->produced - matchDist) - s->winStart;
 541:Source/render/decoders/inflate.c ****         uint8_t b = (rel >= 0 && rel < s->winN) ? s->win[rel] : 0; /* win[rel] or 0 */
 542:Source/render/decoders/inflate.c ****         st_emit(s, b);
 543:Source/render/decoders/inflate.c ****     }
 544:Source/render/decoders/inflate.c **** }
