 586:Source/render/decoders/inflate.c **** static void st_pump(InflateStream *s, size_t n)
 587:Source/render/decoders/inflate.c **** {
 588:Source/render/decoders/inflate.c ****     while (!s->eof && s->pendingN < n)
 589:Source/render/decoders/inflate.c ****     {
 590:Source/render/decoders/inflate.c ****         /* Tasks.yieldCheck() call site (see header note) */
 591:Source/render/decoders/inflate.c ****         if (s->mode == 1)
 592:Source/render/decoders/inflate.c ****         {
 593:Source/render/decoders/inflate.c ****             if (s->remaining > 0)
 594:Source/render/decoders/inflate.c ****             {
 595:Source/render/decoders/inflate.c ****                 s->remaining--;
 596:Source/render/decoders/inflate.c ****                 uint32_t b;
 597:Source/render/decoders/inflate.c ****                 if (!bs_read_bits(&s->bs, 8, &b))
 598:Source/render/decoders/inflate.c ****                 {
 599:Source/render/decoders/inflate.c ****                     s->eof = 1;
 600:Source/render/decoders/inflate.c ****                     break;
 601:Source/render/decoders/inflate.c ****                 }
 602:Source/render/decoders/inflate.c ****                 st_emit(s, (uint8_t)b);
 603:Source/render/decoders/inflate.c ****             }
 604:Source/render/decoders/inflate.c ****             else
 605:Source/render/decoders/inflate.c ****             {
 606:Source/render/decoders/inflate.c ****                 if (s->isFinalBlock)
 607:Source/render/decoders/inflate.c ****                 {
 608:Source/render/decoders/inflate.c ****                     s->eof = 1;
 609:Source/render/decoders/inflate.c ****                     break;
 610:Source/render/decoders/inflate.c ****                 }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccRfnRtN.s 			page 78


 611:Source/render/decoders/inflate.c ****                 s->mode = 0;
 612:Source/render/decoders/inflate.c ****             }
 613:Source/render/decoders/inflate.c ****         }
 614:Source/render/decoders/inflate.c ****         else if (s->mode == 0)
 615:Source/render/decoders/inflate.c ****         {
 616:Source/render/decoders/inflate.c ****             if (!st_begin_block(s))
 617:Source/render/decoders/inflate.c ****             {
 618:Source/render/decoders/inflate.c ****                 break;
 619:Source/render/decoders/inflate.c ****             }
 620:Source/render/decoders/inflate.c ****         }
 621:Source/render/decoders/inflate.c ****         else
 622:Source/render/decoders/inflate.c ****         {
