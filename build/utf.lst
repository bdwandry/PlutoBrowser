 198:Source/js/utf.c **** ucd_bsearch(Rune c, const Rune *t, int n, int ne)
 199:Source/js/utf.c **** {
 200:Source/js/utf.c **** 	const Rune *p;
 201:Source/js/utf.c **** 	int m;
