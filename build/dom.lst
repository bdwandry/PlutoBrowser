 179:src/html/dom.c **** static int dn_add_child(DomNode* parent, DomNode* child) {
 180:src/html/dom.c ****     if (parent->nChildren == parent->capChildren) {
 181:src/html/dom.c ****         size_t ncap = parent->capChildren ? parent->capChildren * 2 : 4;
 182:src/html/dom.c ****         DomNode** nc = pluto_realloc(parent->children,
 183:src/html/dom.c ****                                      ncap * sizeof(DomNode*));
 184:src/html/dom.c ****         if (nc == NULL) return 0;
 185:src/html/dom.c ****         parent->children = nc;
 186:src/html/dom.c ****         parent->capChildren = ncap;
 187:src/html/dom.c ****     }
 188:src/html/dom.c ****     parent->children[parent->nChildren++] = child;
 189:src/html/dom.c ****     return 1;
 190:src/html/dom.c **** }
