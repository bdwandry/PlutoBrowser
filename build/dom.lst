  77:src/html/dom.c **** static void dom_prepare_list_item(DomStack* s) {
  78:src/html/dom.c ****     for (size_t i = s->n; i-- > 1; ) {
  79:src/html/dom.c ****         const char* t = s->items[i]->tag;
  80:src/html/dom.c ****         if (strcmp(t, "li") == 0) { ds_pop_to(s, i); break; }
  81:src/html/dom.c ****         if (strcmp(t, "ul") == 0 || strcmp(t, "ol") == 0 ||
  82:src/html/dom.c ****             strcmp(t, "menu") == 0 || strcmp(t, "dir") == 0) break;
  83:src/html/dom.c ****     }
