  50:src/html/dom.c ****         s->cap = ncap;
  51:src/html/dom.c ****     }
  52:src/html/dom.c ****     s->items[s->n++] = n;
  53:src/html/dom.c ****     return 1;
  54:src/html/dom.c **** }
