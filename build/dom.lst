 211:Source/html/dom.c ****     if (s->count == 0)
 212:Source/html/dom.c ****     {
 213:Source/html/dom.c ****         return 0;
 214:Source/html/dom.c ****     }
 215:Source/html/dom.c ****     *tag = s->items[s->count - 1]->tag;
 216:Source/html/dom.c ****     return 1;
 217:Source/html/dom.c **** }
 218:Source/html/dom.c **** 
 219:Source/html/dom.c **** /* Pop elements until (and including) the matching tag; indices mirror the
 220:Source/html/dom.c ****  * Lua loops: scan from top down to index 2 (1-based), i.e. never pop root. */
 221:Source/html/dom.c **** static void pop_to_tag(Stack *s, const char *tag)
 222:Source/html/dom.c **** {
 223:Source/html/dom.c ****     for (int i = s->count - 1; i >= 1; i--)
 224:Source/html/dom.c ****     {
 225:Source/html/dom.c ****         if (strcmp(s->items[i]->tag, tag) == 0)
 226:Source/html/dom.c ****         {
 227:Source/html/dom.c ****             s->count = i; /* drop items[i..top] */
 228:Source/html/dom.c ****             return;
 229:Source/html/dom.c ****         }
 230:Source/html/dom.c ****     }
 231:Source/html/dom.c **** }
 232:Source/html/dom.c **** 
 233:Source/html/dom.c **** /* Lua closeOpenP: scan for the deepest open "p" (root excluded) and pop it
 234:Source/html/dom.c ****  * and everything above it. */
 235:Source/html/dom.c **** static void close_open_p(Stack *s)
 236:Source/html/dom.c **** {
 237:Source/html/dom.c ****     pop_to_tag(s, "p");
 238:Source/html/dom.c **** }
 239:Source/html/dom.c **** 
 240:Source/html/dom.c **** static int stack_has_tag(const Stack *s, const char *tag)
 241:Source/html/dom.c **** {
 242:Source/html/dom.c ****     for (int i = s->count - 1; i >= 1; i--)
 243:Source/html/dom.c ****     {
 244:Source/html/dom.c ****         if (strcmp(s->items[i]->tag, tag) == 0)
 245:Source/html/dom.c ****         {
 246:Source/html/dom.c ****             return 1;
 247:Source/html/dom.c ****         }
 248:Source/html/dom.c ****     }
 249:Source/html/dom.c ****     return 0;
 250:Source/html/dom.c **** }
