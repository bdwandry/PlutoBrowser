 667:Source/html/dom.c **** /* Iterative free (explicit stack). The previous recursive version recursed
 668:Source/html/dom.c ****  * once per DOM depth; a deep page could overflow the game-task stack during
 669:Source/html/dom.c ****  * teardown on device (same class of failure as the P18 watchdog crash). */
 670:Source/html/dom.c **** static void free_node_recursive(DomNode *root)
 671:Source/html/dom.c **** {
 672:Source/html/dom.c ****     if (!root)
 673:Source/html/dom.c ****     {
 674:Source/html/dom.c ****         return;
 675:Source/html/dom.c ****     }
 676:Source/html/dom.c ****     typedef struct
 677:Source/html/dom.c ****     {
 678:Source/html/dom.c ****         DomNode *node;
 679:Source/html/dom.c ****         int nextChild;
 680:Source/html/dom.c ****     } FreFrame;
 681:Source/html/dom.c ****     int cap = 64;
 682:Source/html/dom.c ****     int top = 0;
 683:Source/html/dom.c ****     FreFrame *st = (FreFrame *)PLUTO_MALLOC(sizeof(FreFrame) * (size_t)cap);
 684:Source/html/dom.c ****     if (!st)
 685:Source/html/dom.c ****     {
 686:Source/html/dom.c ****         return; /* nothing we can do; allocator is out */
 687:Source/html/dom.c ****     }
 688:Source/html/dom.c ****     st[top].node = root;
 689:Source/html/dom.c ****     st[top].nextChild = 0;
 690:Source/html/dom.c ****     while (top >= 0)
 691:Source/html/dom.c ****     {
 692:Source/html/dom.c ****         DomNode *n = st[top].node;
 693:Source/html/dom.c ****         if (st[top].nextChild < n->childCount)
 694:Source/html/dom.c ****         {
 695:Source/html/dom.c ****             DomNode *c = n->children[st[top].nextChild];
 696:Source/html/dom.c ****             st[top].nextChild++;
 697:Source/html/dom.c ****             if (c)
 698:Source/html/dom.c ****             {
 699:Source/html/dom.c ****                 if (top + 1 >= cap)
 700:Source/html/dom.c ****                 {
 701:Source/html/dom.c ****                     cap *= 2;
 702:Source/html/dom.c ****                     FreFrame *grown = (FreFrame *)PLUTO_MALLOC(sizeof(FreFrame) * (size_t)cap);
 703:Source/html/dom.c ****                     if (!grown)
 704:Source/html/dom.c ****                     {
 705:Source/html/dom.c ****                         PLUTO_FREE(st);
 706:Source/html/dom.c ****                         return;
 707:Source/html/dom.c ****                     }
 708:Source/html/dom.c ****                     memcpy(grown, st, sizeof(FreFrame) * (size_t)top);
 709:Source/html/dom.c ****                     PLUTO_FREE(st);
 710:Source/html/dom.c ****                     st = grown;
 711:Source/html/dom.c ****                 }
 712:Source/html/dom.c ****                 top++;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccqKZU3V.s 			page 92


 713:Source/html/dom.c ****                 st[top].node = c;
 714:Source/html/dom.c ****                 st[top].nextChild = 0;
 715:Source/html/dom.c ****             }
 716:Source/html/dom.c ****         }
 717:Source/html/dom.c ****         else
 718:Source/html/dom.c ****         {
 719:Source/html/dom.c ****             if (n->children)
 720:Source/html/dom.c ****             {
 721:Source/html/dom.c ****                 PLUTO_FREE(n->children);
 722:Source/html/dom.c ****             }
 723:Source/html/dom.c ****             if (n->attrs)
 724:Source/html/dom.c ****             {
 725:Source/html/dom.c ****                 PLUTO_FREE(n->attrs);
 726:Source/html/dom.c ****             }
 727:Source/html/dom.c ****             PLUTO_FREE(n);
 728:Source/html/dom.c ****             top--;
 729:Source/html/dom.c ****         }
 730:Source/html/dom.c ****     }
 731:Source/html/dom.c ****     PLUTO_FREE(st);
 732:Source/html/dom.c **** }
