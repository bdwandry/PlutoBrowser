  26:Source/html/dom.c **** /* ── String arena: chunk list (same design as tokenizer.c) ───────────�
  27:Source/html/dom.c ****  * Pointers handed out by arena_dup must stay valid for the result's lifetime
  28:Source/html/dom.c ****  * even as more strings are added — so chunks are allocated once and never
  29:Source/html/dom.c ****  * moved/reallocated. A chunk that fills up is retired; a new one is appended. */
  30:Source/html/dom.c **** typedef struct ArenaChunk
  31:Source/html/dom.c **** {
  32:Source/html/dom.c ****     struct ArenaChunk *next;
  33:Source/html/dom.c ****     size_t used;
  34:Source/html/dom.c ****     size_t cap;
  35:Source/html/dom.c ****     char data[]; /* flexible array member */
  36:Source/html/dom.c **** } ArenaChunk;
  37:Source/html/dom.c **** 
  38:Source/html/dom.c **** typedef struct
  39:Source/html/dom.c **** {
  40:Source/html/dom.c ****     ArenaChunk *head;
  41:Source/html/dom.c ****     ArenaChunk *tail;
  42:Source/html/dom.c **** } Arena;
  43:Source/html/dom.c **** 
  44:Source/html/dom.c **** #define ARENA_CHUNK_MIN 8192
  45:Source/html/dom.c **** 
  46:Source/html/dom.c **** static int arena_reserve(Arena *a, size_t extra)
  47:Source/html/dom.c **** {
  48:Source/html/dom.c ****     if (a->tail && a->tail->cap - a->tail->used >= extra + 1)
  49:Source/html/dom.c ****     {
  50:Source/html/dom.c ****         return 0;
  51:Source/html/dom.c ****     }
  52:Source/html/dom.c ****     size_t cap = ARENA_CHUNK_MIN;
  53:Source/html/dom.c ****     if (extra + 1 > cap)
  54:Source/html/dom.c ****     {
  55:Source/html/dom.c ****         cap = extra + 1; /* oversized string gets its own right-sized chunk */
  56:Source/html/dom.c ****     }
  57:Source/html/dom.c ****     ArenaChunk *c = (ArenaChunk *)PLUTO_MALLOC(sizeof(ArenaChunk) + cap);
  58:Source/html/dom.c ****     if (!c)
  59:Source/html/dom.c ****     {
  60:Source/html/dom.c ****         return -1;
  61:Source/html/dom.c ****     }
  62:Source/html/dom.c ****     c->next = NULL;
  63:Source/html/dom.c ****     c->used = 0;
  64:Source/html/dom.c ****     c->cap = cap;
  65:Source/html/dom.c ****     if (a->tail)
  66:Source/html/dom.c ****     {
  67:Source/html/dom.c ****         a->tail->next = c;
  68:Source/html/dom.c ****     }
  69:Source/html/dom.c ****     else
  70:Source/html/dom.c ****     {
  71:Source/html/dom.c ****         a->head = c;
  72:Source/html/dom.c ****     }
  73:Source/html/dom.c ****     a->tail = c;
  74:Source/html/dom.c ****     return 0;
  75:Source/html/dom.c **** }
  76:Source/html/dom.c **** 
  77:Source/html/dom.c **** static char *arena_dup(Arena *a, const char *s, size_t n)
  78:Source/html/dom.c **** {
  79:Source/html/dom.c ****     if (arena_reserve(a, n) != 0)
  80:Source/html/dom.c ****     {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccqKZU3V.s 			page 4


  81:Source/html/dom.c ****         return NULL;
  82:Source/html/dom.c ****     }
  83:Source/html/dom.c ****     char *out = a->tail->data + a->tail->used;
  84:Source/html/dom.c ****     memcpy(out, s, n);
  85:Source/html/dom.c ****     out[n] = '\0';
  86:Source/html/dom.c ****     a->tail->used += n + 1;
  87:Source/html/dom.c ****     return out;
  88:Source/html/dom.c **** }
