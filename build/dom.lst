 169:src/html/dom.c **** static DomNode* dom_new_text(char* text, size_t len) {
 170:src/html/dom.c ****     DomNode* n = pluto_malloc(sizeof(DomNode));
 171:src/html/dom.c ****     if (n == NULL) return NULL;
 172:src/html/dom.c ****     memset(n, 0, sizeof(*n));
 173:src/html/dom.c ****     n->kind = DOM_TEXT;
 174:src/html/dom.c ****     n->text = text;
 175:src/html/dom.c ****     n->textLen = len;
 176:src/html/dom.c ****     return n;
 177:src/html/dom.c **** }
