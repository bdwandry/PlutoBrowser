 179:src/render/decoders/selftest_webp.c ****                          FX_W_ANIM_DUR2, FX_W_ANIM_DUR3};
 180:src/render/decoders/selftest_webp.c ****     const unsigned cks[4] = {FX_W_ANIM_F0_CK, FX_W_ANIM_F1_CK,
 181:src/render/decoders/selftest_webp.c ****                              FX_W_ANIM_F2_CK, FX_W_ANIM_F3_CK};
 182:src/render/decoders/selftest_webp.c ****     const WebpProbePt* pts[4] = {wp_anim_f0, wp_anim_f1,
 183:src/render/decoders/selftest_webp.c ****                                  wp_anim_f2, wp_anim_f3};
 184:src/render/decoders/selftest_webp.c ****     const int plens[4] = {wp_anim_f0_len, wp_anim_f1_len,
 185:src/render/decoders/selftest_webp.c ****                           wp_anim_f2_len, wp_anim_f3_len};
 186:src/render/decoders/selftest_webp.c ****     int i;
 187:src/render/decoders/selftest_webp.c **** 
 188:src/render/decoders/selftest_webp.c ****     ck("A.anim_badsig_reject",
 189:src/render/decoders/selftest_webp.c ****        webp_decode_anim(fx_w_badsig, FX_W_BADSIG_LEN, &anim) != 0 &&
 190:src/render/decoders/selftest_webp.c ****        anim == NULL);
 191:src/render/decoders/selftest_webp.c ****     ck("A.decode",
 192:src/render/decoders/selftest_webp.c ****        webp_decode_anim(fx_w_anim, FX_W_ANIM_LEN, &anim) == 0 &&
 193:src/render/decoders/selftest_webp.c ****        anim != NULL);
