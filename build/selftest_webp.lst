  92:src/render/decoders/selftest_webp.c ****                              &rows, &w, &hgt) != 0 || rows == NULL) {
  93:src/render/decoders/selftest_webp.c ****             snprintf(nm, sizeof(nm), "D.%s_decode", f->name);
  94:src/render/decoders/selftest_webp.c ****             ck(nm, 0);
  95:src/render/decoders/selftest_webp.c ****             continue;
  96:src/render/decoders/selftest_webp.c ****         }
  97:src/render/decoders/selftest_webp.c ****         snprintf(nm, sizeof(nm), "D.%s_dims", f->name);
  98:src/render/decoders/selftest_webp.c ****         ck(nm, w == f->sw && hgt == f->sh);
  99:src/render/decoders/selftest_webp.c ****         snprintf(nm, sizeof(nm), "D.%s_cksum", f->name);
 100:src/render/decoders/selftest_webp.c ****         ck(nm, fnv_rows(rows, w, hgt) == f->cksum);
 101:src/render/decoders/selftest_webp.c **** 
 102:src/render/decoders/selftest_webp.c ****         {
 103:src/render/decoders/selftest_webp.c ****             int probesOk = 1;
 104:src/render/decoders/selftest_webp.c ****             for (pi = 0; pi < webp_probes_len && probesOk; pi++) {
 105:src/render/decoders/selftest_webp.c ****                 const WebpProbe* pr = &webp_probes[pi];
 106:src/render/decoders/selftest_webp.c ****                 int k;
 107:src/render/decoders/selftest_webp.c ****                 if (pr->img != f->genIdx) continue;
 108:src/render/decoders/selftest_webp.c ****                 for (k = 0; k < pr->nProbes; k++) {
 109:src/render/decoders/selftest_webp.c ****                     int x = pr->p[k].x, y = pr->p[k].y;
 110:src/render/decoders/selftest_webp.c ****                     unsigned got, want = pr->p[k].argb;
 111:src/render/decoders/selftest_webp.c ****                     if (x >= w || y >= hgt) { probesOk = 0; break; }
 112:src/render/decoders/selftest_webp.c ****                     got = rows[y][x];
 113:src/render/decoders/selftest_webp.c ****                     if (got != want) {
 114:src/render/decoders/selftest_webp.c ****                         PLUTO_ERROR(
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccueJaFT.s 			page 10


 115:src/render/decoders/selftest_webp.c ****                             "[P21] probe %s(%d,%d): got %08X want %08X",
 116:src/render/decoders/selftest_webp.c ****                             f->name, x, y, got, want);
 117:src/render/decoders/selftest_webp.c ****                         probesOk = 0;
 118:src/render/decoders/selftest_webp.c ****                         break;
 119:src/render/decoders/selftest_webp.c ****                     }
 120:src/render/decoders/selftest_webp.c ****                 }
 121:src/render/decoders/selftest_webp.c ****             }
 122:src/render/decoders/selftest_webp.c ****             snprintf(nm, sizeof(nm), "D.%s_probes", f->name);
 123:src/render/decoders/selftest_webp.c ****             ck(nm, probesOk);
 124:src/render/decoders/selftest_webp.c ****         }
 125:src/render/decoders/selftest_webp.c ****         webp_free_rows_argb(rows, hgt);
 126:src/render/decoders/selftest_webp.c ****     }
