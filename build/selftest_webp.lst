  85:src/render/decoders/selftest_webp.c ****     int pi;
  86:src/render/decoders/selftest_webp.c ****     for (i = 0; i < NFIX; i++) {
  87:src/render/decoders/selftest_webp.c ****         const Fixture* f = &kFixtures[i];
  88:src/render/decoders/selftest_webp.c ****         uint32_t** rows = NULL;
  89:src/render/decoders/selftest_webp.c ****         int w = 0, hgt = 0;
  90:src/render/decoders/selftest_webp.c ****         char nm[64];
