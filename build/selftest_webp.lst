  74:src/render/decoders/selftest_webp.c **** #define FNV_OFFSET 0x811C9DC5u
  75:src/render/decoders/selftest_webp.c **** #define FNV_PRIME  0x01000193u
  76:src/render/decoders/selftest_webp.c **** 
  77:src/render/decoders/selftest_webp.c **** static unsigned fnv_rows(uint32_t** rows, int w, int h) {
  78:src/render/decoders/selftest_webp.c ****     unsigned hsh = FNV_OFFSET;
  79:src/render/decoders/selftest_webp.c ****     int x, y;
  80:src/render/decoders/selftest_webp.c ****     for (y = 0; y < h; y++) {
  81:src/render/decoders/selftest_webp.c ****         for (x = 0; x < w; x++) {
  82:src/render/decoders/selftest_webp.c ****             hsh ^= rows[y][x];
  83:src/render/decoders/selftest_webp.c ****             hsh *= FNV_PRIME;
  84:src/render/decoders/selftest_webp.c ****         }
  85:src/render/decoders/selftest_webp.c ****     }
  86:src/render/decoders/selftest_webp.c ****     return hsh;
  87:src/render/decoders/selftest_webp.c **** }
  88:src/render/decoders/selftest_webp.c **** 
  89:src/render/decoders/selftest_webp.c **** static unsigned fnv_flat(const uint32_t* pix, int w, int h) {
  90:src/render/decoders/selftest_webp.c ****     unsigned hsh = FNV_OFFSET;
  91:src/render/decoders/selftest_webp.c ****     size_t i, n = (size_t)w * (size_t)h;
  92:src/render/decoders/selftest_webp.c ****     for (i = 0; i < n; i++) {
  93:src/render/decoders/selftest_webp.c ****         hsh ^= pix[i];
  94:src/render/decoders/selftest_webp.c ****         hsh *= FNV_PRIME;
  95:src/render/decoders/selftest_webp.c ****     }
  96:src/render/decoders/selftest_webp.c ****     return hsh;
  97:src/render/decoders/selftest_webp.c **** }
