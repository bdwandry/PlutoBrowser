 185:src/render/decoders/selftest_webp.c ****                                 h == FX_W_PIL_BENCH_H &&
 186:src/render/decoders/selftest_webp.c ****                                 fnv_rows(rows, w, h) == FX_W_PIL_BENCH_CK);
 187:src/render/decoders/selftest_webp.c ****     if (rows) webp_free_rows_argb(rows, h);
 188:src/render/decoders/selftest_webp.c **** 
 189:src/render/decoders/selftest_webp.c **** #if defined(TARGET_PLAYDATE)
 190:src/render/decoders/selftest_webp.c ****     if (s_pd != NULL) {
 191:src/render/decoders/selftest_webp.c ****         float t0 = s_pd->system->getElapsedTime();
 192:src/render/decoders/selftest_webp.c ****         for (it = 0; it < iters; it++) {
 193:src/render/decoders/selftest_webp.c ****             rows = NULL;
 194:src/render/decoders/selftest_webp.c ****             if (webp_decode_argb(fx_w_pil_bench, FX_W_PIL_BENCH_LEN,
 195:src/render/decoders/selftest_webp.c ****                                  360, 200, &rows, &w, &h) == 0)
 196:src/render/decoders/selftest_webp.c ****                 webp_free_rows_argb(rows, h);
 197:src/render/decoders/selftest_webp.c ****             else
