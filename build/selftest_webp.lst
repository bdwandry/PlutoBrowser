 215:src/render/decoders/selftest_webp.c ****         }
 216:src/render/decoders/selftest_webp.c ****         clock_gettime(CLOCK_MONOTONIC, &t1);
 217:src/render/decoders/selftest_webp.c ****         ms = (t1.tv_sec - t0.tv_sec) * 1000.0 +
 218:src/render/decoders/selftest_webp.c ****              (t1.tv_nsec - t0.tv_nsec) / 1e6;
 219:src/render/decoders/selftest_webp.c ****     }
 220:src/render/decoders/selftest_webp.c **** #endif
 221:src/render/decoders/selftest_webp.c ****     PLUTO_LOG("[P21] bench %dx%d: %d iters in %.2f ms (%.3f ms/iter)",
 222:src/render/decoders/selftest_webp.c ****               FX_W_PIL_BENCH_W, FX_W_PIL_BENCH_H, iters, ms, ms / iters);
 223:src/render/decoders/selftest_webp.c ****     ck("B.bench_ran", it == iters && ms >= 0.0);
 224:src/render/decoders/selftest_webp.c **** }
