 199:src/render/decoders/selftest_webp.c ****         }
 200:src/render/decoders/selftest_webp.c ****         ms = (double)(s_pd->system->getElapsedTime() - t0) * 1000.0;
 201:src/render/decoders/selftest_webp.c ****     } else {
 202:src/render/decoders/selftest_webp.c ****         it = iters;
 203:src/render/decoders/selftest_webp.c ****     }
 204:src/render/decoders/selftest_webp.c **** #else
 205:src/render/decoders/selftest_webp.c ****     {
 206:src/render/decoders/selftest_webp.c ****         struct timespec t0, t1;
 207:src/render/decoders/selftest_webp.c ****         clock_gettime(CLOCK_MONOTONIC, &t0);
 208:src/render/decoders/selftest_webp.c ****         for (it = 0; it < iters; it++) {
 209:src/render/decoders/selftest_webp.c ****             rows = NULL;
 210:src/render/decoders/selftest_webp.c ****             if (webp_decode_argb(fx_w_pil_bench, FX_W_PIL_BENCH_LEN,
 211:src/render/decoders/selftest_webp.c ****                                  360, 200, &rows, &w, &h) == 0)
 212:src/render/decoders/selftest_webp.c ****                 webp_free_rows_argb(rows, h);
 213:src/render/decoders/selftest_webp.c ****             else
