 129:src/render/decoders/selftest_webp.c **** static void case_gray_smoke(void) {
 130:src/render/decoders/selftest_webp.c ****     uint32_t** argb = NULL;
 131:src/render/decoders/selftest_webp.c ****     uint8_t** rows = NULL;
 132:src/render/decoders/selftest_webp.c ****     int aw = 0, ah = 0, gw = 0, gh = 0;
 133:src/render/decoders/selftest_webp.c ****     int bw, bh, tw, th;
 134:src/render/decoders/selftest_webp.c ****     int ok;
 135:src/render/decoders/selftest_webp.c **** 
 136:src/render/decoders/selftest_webp.c ****     /* gray pipeline consistency on the gradient fixture */
 137:src/render/decoders/selftest_webp.c ****     ok = webp_decode_gray(fx_w_gradient, FX_W_GRADIENT_LEN, 360, 200,
 138:src/render/decoders/selftest_webp.c ****                           &rows, &gw, &gh) == 0 && rows != NULL;
 139:src/render/decoders/selftest_webp.c ****     ck("G.gradient_decode", ok);
 140:src/render/decoders/selftest_webp.c ****     scale_box_sizes(FX_W_GRADIENT_W, FX_W_GRADIENT_H, 360, 200,
 141:src/render/decoders/selftest_webp.c ****                     &bw, &bh, &tw, &th);
 142:src/render/decoders/selftest_webp.c ****     ck("G.gradient_dims", ok && gw == tw && gh == th);
 143:src/render/decoders/selftest_webp.c ****     if (rows) webp_free_rows(rows, gh);
 144:src/render/decoders/selftest_webp.c ****     rows = NULL;
 145:src/render/decoders/selftest_webp.c **** 
 146:src/render/decoders/selftest_webp.c ****     /* alpha compositing path runs without crashing on the alpha ramp */
 147:src/render/decoders/selftest_webp.c ****     ok = webp_decode_argb(fx_w_alpha, FX_W_ALPHA_LEN, 24, 16,
 148:src/render/decoders/selftest_webp.c ****                           &argb, &aw, &ah) == 0 && argb != NULL;
 149:src/render/decoders/selftest_webp.c ****     ck("G.alpha_argb", ok);
 150:src/render/decoders/selftest_webp.c ****     if (argb) webp_free_rows_argb(argb, ah);
 151:src/render/decoders/selftest_webp.c **** 
 152:src/render/decoders/selftest_webp.c ****     /* tiny flat image stays exact through the box filter (no scaling) */
 153:src/render/decoders/selftest_webp.c ****     ok = webp_decode_gray(fx_w_flat, FX_W_FLAT_LEN, 64, 64,
 154:src/render/decoders/selftest_webp.c ****                           &rows, &gw, &gh) == 0 && rows != NULL;
 155:src/render/decoders/selftest_webp.c ****     scale_box_sizes(FX_W_FLAT_W, FX_W_FLAT_H, 64, 64, &bw, &bh, &tw, &th);
 156:src/render/decoders/selftest_webp.c ****     ck("G.flat_dims", ok && gw == tw && gh == th);
 157:src/render/decoders/selftest_webp.c ****     if (rows) webp_free_rows(rows, gh);
 158:src/render/decoders/selftest_webp.c **** }
