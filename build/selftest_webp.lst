  76:src/render/decoders/selftest_webp.c ****             hsh ^= rows[y][x];
  77:src/render/decoders/selftest_webp.c ****             hsh *= FNV_PRIME;
  78:src/render/decoders/selftest_webp.c ****         }
  79:src/render/decoders/selftest_webp.c ****     }
  80:src/render/decoders/selftest_webp.c ****     return hsh;
  81:src/render/decoders/selftest_webp.c **** }
