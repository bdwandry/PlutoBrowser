 287:src/render/decoders/selftest_webp.c ****             rows = NULL;
 288:src/render/decoders/selftest_webp.c ****             if (webp_decode_argb(fx_w_pil_bench, FX_W_PIL_BENCH_LEN,
 289:src/render/decoders/selftest_webp.c ****                                  360, 200, &rows, &w, &h) == 0)
 290:src/render/decoders/selftest_webp.c ****                 webp_free_rows_argb(rows, h);
 291:src/render/decoders/selftest_webp.c ****             else
 292:src/render/decoders/selftest_webp.c ****                 break;
 293:src/render/decoders/selftest_webp.c ****         }
 294:src/render/decoders/selftest_webp.c ****         clock_gettime(CLOCK_MONOTONIC, &t1);
 295:src/render/decoders/selftest_webp.c ****         ms = (t1.tv_sec - t0.tv_sec) * 1000.0 +
 296:src/render/decoders/selftest_webp.c ****              (t1.tv_nsec - t0.tv_nsec) / 1e6;
 297:src/render/decoders/selftest_webp.c ****     }
 298:src/render/decoders/selftest_webp.c **** #endif
 299:src/render/decoders/selftest_webp.c ****     PLUTO_LOG("[P21] bench %dx%d: %d iters in %.2f ms (%.3f ms/iter)",
 300:src/render/decoders/selftest_webp.c ****               FX_W_PIL_BENCH_W, FX_W_PIL_BENCH_H, iters, ms, ms / iters);
 301:src/render/decoders/selftest_webp.c ****     ck("B.bench_ran", it == iters && ms >= 0.0);
