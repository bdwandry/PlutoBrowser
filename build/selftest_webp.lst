 176:src/render/decoders/selftest_webp.c **** static void case_anim(void) {
 177:src/render/decoders/selftest_webp.c ****     WebPAnim* anim = NULL;
 178:src/render/decoders/selftest_webp.c ****     const int durs[4] = {FX_W_ANIM_DUR0, FX_W_ANIM_DUR1,
