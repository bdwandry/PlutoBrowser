  71:src/render/decoders/selftest_webp.c **** static unsigned fnv_rows(uint32_t** rows, int w, int h) {
  72:src/render/decoders/selftest_webp.c ****     unsigned hsh = FNV_OFFSET;
  73:src/render/decoders/selftest_webp.c ****     int x, y;
  74:src/render/decoders/selftest_webp.c ****     for (y = 0; y < h; y++) {
