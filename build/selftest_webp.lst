  99:src/render/decoders/selftest_webp.c **** static void case_decode_argb_all(void) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccbarwJy.s 			page 11


 100:src/render/decoders/selftest_webp.c ****     size_t i;
 101:src/render/decoders/selftest_webp.c ****     int pi;
 102:src/render/decoders/selftest_webp.c ****     for (i = 0; i < NFIX; i++) {
 103:src/render/decoders/selftest_webp.c ****         const Fixture* f = &kFixtures[i];
 104:src/render/decoders/selftest_webp.c ****         uint32_t** rows = NULL;
 105:src/render/decoders/selftest_webp.c ****         int w = 0, hgt = 0;
 106:src/render/decoders/selftest_webp.c ****         char nm[64];
 107:src/render/decoders/selftest_webp.c ****         if (webp_decode_argb(f->data, f->len, 360, 200,
 108:src/render/decoders/selftest_webp.c ****                              &rows, &w, &hgt) != 0 || rows == NULL) {
 109:src/render/decoders/selftest_webp.c ****             snprintf(nm, sizeof(nm), "D.%s_decode", f->name);
 110:src/render/decoders/selftest_webp.c ****             ck(nm, 0);
 111:src/render/decoders/selftest_webp.c ****             continue;
 112:src/render/decoders/selftest_webp.c ****         }
 113:src/render/decoders/selftest_webp.c ****         snprintf(nm, sizeof(nm), "D.%s_dims", f->name);
 114:src/render/decoders/selftest_webp.c ****         ck(nm, w == f->sw && hgt == f->sh);
 115:src/render/decoders/selftest_webp.c ****         snprintf(nm, sizeof(nm), "D.%s_cksum", f->name);
 116:src/render/decoders/selftest_webp.c ****         ck(nm, fnv_rows(rows, w, hgt) == f->cksum);
 117:src/render/decoders/selftest_webp.c **** 
 118:src/render/decoders/selftest_webp.c ****         {
 119:src/render/decoders/selftest_webp.c ****             int probesOk = 1;
 120:src/render/decoders/selftest_webp.c ****             for (pi = 0; pi < webp_probes_len && probesOk; pi++) {
 121:src/render/decoders/selftest_webp.c ****                 const WebpProbe* pr = &webp_probes[pi];
 122:src/render/decoders/selftest_webp.c ****                 int k;
 123:src/render/decoders/selftest_webp.c ****                 if (pr->img != f->genIdx) continue;
 124:src/render/decoders/selftest_webp.c ****                 for (k = 0; k < pr->nProbes; k++) {
 125:src/render/decoders/selftest_webp.c ****                     int x = pr->p[k].x, y = pr->p[k].y;
 126:src/render/decoders/selftest_webp.c ****                     unsigned got, want = pr->p[k].argb;
 127:src/render/decoders/selftest_webp.c ****                     if (x >= w || y >= hgt) { probesOk = 0; break; }
 128:src/render/decoders/selftest_webp.c ****                     got = rows[y][x];
 129:src/render/decoders/selftest_webp.c ****                     if (got != want) {
 130:src/render/decoders/selftest_webp.c ****                         PLUTO_ERROR(
 131:src/render/decoders/selftest_webp.c ****                             "[P21] probe %s(%d,%d): got %08X want %08X",
 132:src/render/decoders/selftest_webp.c ****                             f->name, x, y, got, want);
 133:src/render/decoders/selftest_webp.c ****                         probesOk = 0;
 134:src/render/decoders/selftest_webp.c ****                         break;
 135:src/render/decoders/selftest_webp.c ****                     }
 136:src/render/decoders/selftest_webp.c ****                 }
 137:src/render/decoders/selftest_webp.c ****             }
 138:src/render/decoders/selftest_webp.c ****             snprintf(nm, sizeof(nm), "D.%s_probes", f->name);
 139:src/render/decoders/selftest_webp.c ****             ck(nm, probesOk);
 140:src/render/decoders/selftest_webp.c ****         }
 141:src/render/decoders/selftest_webp.c ****         webp_free_rows_argb(rows, hgt);
 142:src/render/decoders/selftest_webp.c ****     }
 143:src/render/decoders/selftest_webp.c **** }
