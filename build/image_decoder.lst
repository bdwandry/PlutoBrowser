 167:src/render/image_decoder.c **** typedef void (*IdDoneFn)(void* ud, struct LCDBitmap* img);
 168:src/render/image_decoder.c **** 
 169:src/render/image_decoder.c **** typedef struct IdJob {
 170:src/render/image_decoder.c ****     uint8_t* data;           /* owned copy for async formats */
 171:src/render/image_decoder.c ****     size_t len;
 172:src/render/image_decoder.c ****     int fmt;                 /* 0 jpeg 1 png 2 webp 3 gif */
 173:src/render/image_decoder.c ****     IdDoneFn done;
 174:src/render/image_decoder.c ****     void* ud;
 175:src/render/image_decoder.c **** } IdJob;
 176:src/render/image_decoder.c **** 
 177:src/render/image_decoder.c **** static int job_step(void* ctx) {
 178:src/render/image_decoder.c ****     IdJob* j = (IdJob*)ctx;
 179:src/render/image_decoder.c **** #ifdef PLUTO_ID_PD
 180:src/render/image_decoder.c ****     struct LCDBitmap* img = NULL;
 181:src/render/image_decoder.c ****     switch (j->fmt) {
 182:src/render/image_decoder.c ****         case 0:
 183:src/render/image_decoder.c ****             img = jpeg_decode(s_pd, j->data, j->len, 360, 200);
 184:src/render/image_decoder.c ****             break;
 185:src/render/image_decoder.c ****         case 1:
 186:src/render/image_decoder.c ****             img = png_decode(s_pd, j->data, j->len, 360, 200);
 187:src/render/image_decoder.c ****             break;
 188:src/render/image_decoder.c ****         case 2:
 189:src/render/image_decoder.c ****             img = webp_decode(s_pd, j->data, j->len, 360, 200);
 190:src/render/image_decoder.c ****             break;
 191:src/render/image_decoder.c ****         default:
 192:src/render/image_decoder.c ****             img = gif_decode(s_pd, j->data, j->len, 360, 200);
 193:src/render/image_decoder.c ****             break;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccDTeOVq.s 			page 6


 194:src/render/image_decoder.c ****     }
 195:src/render/image_decoder.c ****     /* deliver inside the scheduler frame, like the Lua coroutine result */
 196:src/render/image_decoder.c ****     j->done(j->ud, img);
 197:src/render/image_decoder.c **** #else
 198:src/render/image_decoder.c ****     (void)j;
 199:src/render/image_decoder.c **** #endif
 200:src/render/image_decoder.c ****     return PLUTO_TASK_DONE;
 201:src/render/image_decoder.c **** }
