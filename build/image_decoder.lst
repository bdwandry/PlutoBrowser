  99:Source/render/image_decoder.c **** typedef struct AsyncDecodeState
 100:Source/render/image_decoder.c **** {
 101:Source/render/image_decoder.c ****     uint8_t *data;   /* owned copy of the body */
 102:Source/render/image_decoder.c ****     size_t len;
 103:Source/render/image_decoder.c ****     char url[IMGDEC_URL_MAX];
 104:Source/render/image_decoder.c ****     int kind;        /* 0 jpeg, 1 png, 2 webp, 3 gif */
 105:Source/render/image_decoder.c ****     int phase;       /* 0 = decode pending, 1 = finished */
 106:Source/render/image_decoder.c ****     LCDBitmap *result;
 107:Source/render/image_decoder.c ****     TaskCtx *ctx;    /* set by the step for yield_check parity */
 108:Source/render/image_decoder.c **** } AsyncDecodeState;
 109:Source/render/image_decoder.c **** 
 110:Source/render/image_decoder.c **** static int async_decode_step(TaskCtx *ctx)
 111:Source/render/image_decoder.c **** {
 112:Source/render/image_decoder.c ****     AsyncDecodeState *st = (AsyncDecodeState *)ctx->data;
 113:Source/render/image_decoder.c ****     if (!st || st->phase != 0) return 0;
 114:Source/render/image_decoder.c ****     st->ctx = ctx;
 115:Source/render/image_decoder.c ****     /* Tasks.yieldCheck() call site (task layer owns the frame budget) —
 116:Source/render/image_decoder.c ****      * JPEG/PNG/GIF/WebP decode loops check it per row/MCU in the Lua ref. */
 117:Source/render/image_decoder.c ****     switch (st->kind)
 118:Source/render/image_decoder.c ****     {
 119:Source/render/image_decoder.c ****     case 0: st->result = jpeg_decode(st->data, st->len, 360, 200); break;
 120:Source/render/image_decoder.c ****     case 1: st->result = png_decode(st->data, st->len, 360, 200); break;
 121:Source/render/image_decoder.c ****     case 2: st->result = webp_decode(st->data, st->len, 360, 200); break;
 122:Source/render/image_decoder.c ****     default: st->result = gif_decode(st->data, st->len, 360, 200); break;
 123:Source/render/image_decoder.c ****     }
 124:Source/render/image_decoder.c **** 
 125:Source/render/image_decoder.c ****     st->phase = 1;
 126:Source/render/image_decoder.c ****     /* Returning 0 completes the task; ctx->data is delivered to onDone. */
 127:Source/render/image_decoder.c ****     ctx->data = st;
 128:Source/render/image_decoder.c ****     return 0;
 129:Source/render/image_decoder.c **** }
