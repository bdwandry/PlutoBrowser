 189:Source/render/image_decoder.c ****     else if (memcmp(data, "GIF87a", 6) == 0 || memcmp(data, "GIF89a", 6) == 0)
 190:Source/render/image_decoder.c ****         kind = 3; /* GIF */
 191:Source/render/image_decoder.c **** 
 192:Source/render/image_decoder.c ****     if (kind >= 0)
 193:Source/render/image_decoder.c ****     {
