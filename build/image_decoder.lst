ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccDTeOVq.s 			page 8


 240:src/render/image_decoder.c ****     uint8_t b1, b2, b3, b4;
 241:src/render/image_decoder.c ****     struct LCDBitmap* img = NULL;
 242:src/render/image_decoder.c ****     if (!data || len < 4) { done(ud, NULL); return; }
 243:src/render/image_decoder.c ****     b1 = data[0];
 244:src/render/image_decoder.c ****     b2 = data[1];
 245:src/render/image_decoder.c ****     b3 = data[2];
 246:src/render/image_decoder.c ****     b4 = data[3];
 247:src/render/image_decoder.c **** 
 248:src/render/image_decoder.c **** #ifndef PLUTO_ID_PD
 249:src/render/image_decoder.c ****     (void)b3; (void)b4;
 250:src/render/image_decoder.c **** #endif
 251:src/render/image_decoder.c **** 
 252:src/render/image_decoder.c ****     /* JPEG: FF D8 (async, can take seconds for big photos) */
 253:src/render/image_decoder.c ****     if (b1 == 0xFF && b2 == 0xD8) {
 254:src/render/image_decoder.c ****         decode_async(0, data, len, done, ud);
 255:src/render/image_decoder.c ****         return;
 256:src/render/image_decoder.c ****     }
 257:src/render/image_decoder.c ****     /* PNG / GIF / WebP also run through the task scheduler */
 258:src/render/image_decoder.c ****     if (b1 == 0x89 && b2 == 0x50 && b3 == 0x4E && b4 == 0x47) {
 259:src/render/image_decoder.c ****         decode_async(1, data, len, done, ud);
 260:src/render/image_decoder.c ****         return;
 261:src/render/image_decoder.c ****     }
 262:src/render/image_decoder.c ****     if (len >= 12 && memcmp(data, "RIFF", 4) == 0 &&
 263:src/render/image_decoder.c ****         memcmp(data + 8, "WEBP", 4) == 0) {
 264:src/render/image_decoder.c ****         decode_async(2, data, len, done, ud);
 265:src/render/image_decoder.c ****         return;
 266:src/render/image_decoder.c ****     }
 267:src/render/image_decoder.c ****     if (len >= 6 && (memcmp(data, "GIF87a", 6) == 0 ||
 268:src/render/image_decoder.c ****                      memcmp(data, "GIF89a", 6) == 0)) {
 269:src/render/image_decoder.c ****         decode_async(3, data, len, done, ud);
 270:src/render/image_decoder.c ****         return;
 271:src/render/image_decoder.c ****     }
 272:src/render/image_decoder.c **** 
 273:src/render/image_decoder.c ****     /* inline formats */
 274:src/render/image_decoder.c **** #ifdef PLUTO_ID_PD
 275:src/render/image_decoder.c ****     /* BMP: BM */
 276:src/render/image_decoder.c ****     if (b1 == 'B' && b2 == 'M') {
 277:src/render/image_decoder.c ****         img = bmp_decode(s_pd, data, len);
 278:src/render/image_decoder.c ****     } else if (b1 == 0 && b2 == 0 && (b3 == 1 || b3 == 2) && b4 == 0) {
 279:src/render/image_decoder.c ****         /* ICO / CUR: reserved(2)=0, type(2)=1 icon / 2 cursor */
 280:src/render/image_decoder.c ****         img = ico_decode(s_pd, data, len, 360, 200);
 281:src/render/image_decoder.c ****     } else {
 282:src/render/image_decoder.c ****         char head[201];
 283:src/render/image_decoder.c ****         size_t hn = len < 200 ? len : 200;
 284:src/render/image_decoder.c ****         size_t k;
 285:src/render/image_decoder.c ****         for (k = 0; k < hn; k++) {
 286:src/render/image_decoder.c ****             char c = (char)data[k];
 287:src/render/image_decoder.c ****             head[k] = (c >= 'A' && c <= 'Z') ? (char)(c - 'A' + 'a') : c;
 288:src/render/image_decoder.c ****         }
 289:src/render/image_decoder.c ****         head[hn] = '\0';
 290:src/render/image_decoder.c ****         if (strstr(head, "<svg") || strstr(head, "<?xml")) {
 291:src/render/image_decoder.c ****             img = svg_decode(s_pd, (const char*)data, len, 360, 200);
 292:src/render/image_decoder.c ****         }
 293:src/render/image_decoder.c ****     }
 294:src/render/image_decoder.c **** #endif
 295:src/render/image_decoder.c ****     done(ud, img);
 296:src/render/image_decoder.c **** }
