 292:Source/render/image_decoder.c ****     /* The busy flag is released by the decode completion / the failure path
 293:Source/render/image_decoder.c ****      * below; the queue re-schedules 16ms after the cache write. */
 294:Source/render/image_decoder.c ****     /* Lua: if body and #body > 8 → decodeRawImageData(body, url, cb);
