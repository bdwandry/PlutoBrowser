 141:Source/render/image_decoder.c **** static int async_decode_step(TaskCtx *ctx)
 142:Source/render/image_decoder.c **** {
 143:Source/render/image_decoder.c ****     AsyncDecodeState *st = (AsyncDecodeState *)ctx->data;
 144:Source/render/image_decoder.c ****     if (!st || st->phase != 0) return 0;
 145:Source/render/image_decoder.c ****     st->ctx = ctx;
 146:Source/render/image_decoder.c ****     /* Tasks.yieldCheck() call site (task layer owns the frame budget) —
 147:Source/render/image_decoder.c ****      * JPEG/PNG/GIF/WebP decode loops check it per row/MCU in the Lua ref. */
 148:Source/render/image_decoder.c ****     switch (st->kind)
 149:Source/render/image_decoder.c ****     {
 150:Source/render/image_decoder.c ****     case 0: st->result = jpeg_decode(st->data, st->len, 360, 200); break;
 151:Source/render/image_decoder.c ****     case 1: st->result = png_decode(st->data, st->len, 360, 200); break;
 152:Source/render/image_decoder.c ****     case 2: st->result = webp_decode(st->data, st->len, 360, 200); break;
 153:Source/render/image_decoder.c ****     default: st->result = gif_decode(st->data, st->len, 360, 200); break;
 154:Source/render/image_decoder.c ****     }
 155:Source/render/image_decoder.c **** 
 156:Source/render/image_decoder.c ****     st->phase = 1;
 157:Source/render/image_decoder.c ****     /* Returning 0 completes the task; ctx->data is delivered to onDone. */
 158:Source/render/image_decoder.c ****     ctx->data = st;
 159:Source/render/image_decoder.c ****     return 0;
 160:Source/render/image_decoder.c **** }
