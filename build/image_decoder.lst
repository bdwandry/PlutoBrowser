 526:Source/render/image_decoder.c **** 
 527:Source/render/image_decoder.c **** typedef struct TestDecodeState
 528:Source/render/image_decoder.c **** {
 529:Source/render/image_decoder.c ****     const uint8_t *data;
 530:Source/render/image_decoder.c ****     size_t len;
 531:Source/render/image_decoder.c ****     LCDBitmap *result;
 532:Source/render/image_decoder.c ****     int done;
 533:Source/render/image_decoder.c **** } TestDecodeState;
 534:Source/render/image_decoder.c **** 
 535:Source/render/image_decoder.c **** static int test_decode_step(TaskCtx *ctx)
 536:Source/render/image_decoder.c **** {
 537:Source/render/image_decoder.c ****     TestDecodeState *t = (TestDecodeState *)ctx->userdata;
 538:Source/render/image_decoder.c ****     /* Run the dispatch inline: temporarily neutralize the async split so the
 539:Source/render/image_decoder.c ****      * result is available synchronously (the reference's _testDecode had the
 540:Source/render/image_decoder.c ****      * same caveat — async formats were not covered by it). */
 541:Source/render/image_decoder.c ****     uint8_t b1 = t->data[0], b2 = t->len > 1 ? t->data[1] : 0;
 542:Source/render/image_decoder.c ****     int isJpeg = (b1 == 0xFF && b2 == 0xD8);
 543:Source/render/image_decoder.c ****     if (isJpeg)
 544:Source/render/image_decoder.c ****         t->result = jpeg_decode(t->data, t->len, 360, 200);
 545:Source/render/image_decoder.c ****     else if (t->len > 8 && memcmp(t->data, "RIFF", 4) == 0 && memcmp(t->data + 8, "WEBP", 4) == 0)
 546:Source/render/image_decoder.c ****         t->result = webp_decode(t->data, t->len, 360, 200);
 547:Source/render/image_decoder.c ****     else if (t->len > 3 && b1 == 0x89 && b2 == 0x50)
 548:Source/render/image_decoder.c ****         t->result = png_decode(t->data, t->len, 360, 200);
 549:Source/render/image_decoder.c ****     else if (t->len > 5 && (memcmp(t->data, "GIF87a", 6) == 0 || memcmp(t->data, "GIF89a", 6) == 0)
 550:Source/render/image_decoder.c ****         t->result = gif_decode(t->data, t->len, 360, 200);
 551:Source/render/image_decoder.c ****     else if (t->len > 1 && t->data[0] == 'B' && t->data[1] == 'M')
 552:Source/render/image_decoder.c ****         t->result = bmp_decode(t->data, t->len);
 553:Source/render/image_decoder.c ****     else if (t->len > 3 && t->data[0] == 0 && t->data[1] == 0 && (t->data[2] == 1 || t->data[2] == 
 554:Source/render/image_decoder.c ****         t->result = ico_decode(t->data, t->len, 360, 200);
 555:Source/render/image_decoder.c ****     else
 556:Source/render/image_decoder.c ****     {
 557:Source/render/image_decoder.c ****         char head[201];
 558:Source/render/image_decoder.c ****         size_t hl = t->len < 200 ? t->len : 200;
 559:Source/render/image_decoder.c ****         memcpy(head, t->data, hl);
 560:Source/render/image_decoder.c ****         head[hl] = '\0';
 561:Source/render/image_decoder.c ****         if (strstr(head, "<svg") || strstr(head, "<?xml"))
 562:Source/render/image_decoder.c ****             t->result = svg_decode((const char *)t->data, 360, 200);
 563:Source/render/image_decoder.c ****     }
 564:Source/render/image_decoder.c ****     t->done = 1;
 565:Source/render/image_decoder.c ****     ctx->data = t;
 566:Source/render/image_decoder.c ****     return 0;
 567:Source/render/image_decoder.c **** }
