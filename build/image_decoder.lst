 193:Source/render/image_decoder.c **** /* ── decodeRawImageData (magic dispatch) ─────────────────�
 194:Source/render/image_decoder.c **** 
 195:Source/render/image_decoder.c **** static void decode_raw_image_data(const uint8_t *data, size_t len, const char *url)
 196:Source/render/image_decoder.c **** {
 197:Source/render/image_decoder.c ****     if (!data || len < 4)
 198:Source/render/image_decoder.c ****     {
 199:Source/render/image_decoder.c ****         /* onDone(nil): caller stores `false`. */
 200:Source/render/image_decoder.c ****         cache_put(url, NULL);
 201:Source/render/image_decoder.c ****         g_isDecoding = 0;
 202:Source/render/image_decoder.c ****         return;
 203:Source/render/image_decoder.c ****     }
 204:Source/render/image_decoder.c **** 
 205:Source/render/image_decoder.c ****     uint8_t b1 = data[0], b2 = data[1], b3 = data[2], b4 = data[3];
 206:Source/render/image_decoder.c **** 
 207:Source/render/image_decoder.c ****     int kind = -1; /* -1 = not async */
 208:Source/render/image_decoder.c ****     if (b1 == 0xFF && b2 == 0xD8)
