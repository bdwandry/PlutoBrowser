  28:Source/render/decoders/psd.c **** static size_t packbits_row(const uint8_t *in, size_t inLen, uint8_t *out,
  29:Source/render/decoders/psd.c ****                            size_t outCap)
  30:Source/render/decoders/psd.c **** {
  31:Source/render/decoders/psd.c ****     size_t ip = 0, op = 0;
  32:Source/render/decoders/psd.c ****     while (ip < inLen && op < outCap)
  33:Source/render/decoders/psd.c ****     {
  34:Source/render/decoders/psd.c ****         int n = (int8_t)in[ip++];
  35:Source/render/decoders/psd.c ****         if (n >= 0)
  36:Source/render/decoders/psd.c ****         {
  37:Source/render/decoders/psd.c ****             size_t cnt = (size_t)n + 1;
  38:Source/render/decoders/psd.c ****             if (ip + cnt > inLen) break;
  39:Source/render/decoders/psd.c ****             if (op + cnt > outCap) cnt = outCap - op;
  40:Source/render/decoders/psd.c ****             memcpy(out + op, in + ip, cnt);
  41:Source/render/decoders/psd.c ****             ip += cnt;
  42:Source/render/decoders/psd.c ****             op += cnt;
  43:Source/render/decoders/psd.c ****         }
  44:Source/render/decoders/psd.c ****         else if (n != -128)
  45:Source/render/decoders/psd.c ****         {
  46:Source/render/decoders/psd.c ****             size_t cnt = (size_t)(257 - (size_t)(n & 0xFF));
  47:Source/render/decoders/psd.c ****             if (ip >= inLen) break;
  48:Source/render/decoders/psd.c ****             uint8_t v = in[ip++];
  49:Source/render/decoders/psd.c ****             if (op + cnt > outCap) cnt = outCap - op;
  50:Source/render/decoders/psd.c ****             memset(out + op, v, cnt);
  51:Source/render/decoders/psd.c ****             op += cnt;
  52:Source/render/decoders/psd.c ****         }
  53:Source/render/decoders/psd.c ****     }
  54:Source/render/decoders/psd.c ****     return op;
  55:Source/render/decoders/psd.c **** }
