  26:Source/core/logger.c **** static int g_seq = 0;
  27:Source/core/logger.c **** 
  28:Source/core/logger.c **** static void nowString(char *out, size_t outLen)
  29:Source/core/logger.c **** {
  30:Source/core/logger.c ****     struct PDDateTime t;
  31:Source/core/logger.c ****     memset(&t, 0, sizeof(t));
  32:Source/core/logger.c ****     g_pd->system->convertEpochToDateTime(g_pd->system->getSecondsSinceEpoch(NULL), &t);
  33:Source/core/logger.c ****     snprintf(out, outLen, "%02d:%02d:%02d", (int)t.hour, (int)t.minute, (int)t.second);
  34:Source/core/logger.c **** }
