   1:src/core/logger.c **** // logger.c — full C port of CometBrowser Source/core/logger.lua
   2:src/core/logger.c **** //
   3:src/core/logger.c **** // Lua original behavior (source of truth):
   4:src/core/logger.c **** //   LOG_PATH = "comet.log"  -> PlutoBrowser writes "pluto.log"
   5:src/core/logger.c **** //   Logger.init():  kFileWrite (truncate), banner + "gamePath: <path>"
   6:src/core/logger.c **** //   Logger.log(m):  "[HH:MM:SS #seq] m\n" via kFileAppend, open+close per line
   7:src/core/logger.c **** //   Logger.error(m): "ERROR: m  ||  stack: where()"
   8:src/core/logger.c **** // Every write is failure-tolerant (Lua wrapped each step in pcall; the C port
   9:src/core/logger.c **** // checks every return value and never crashes on I/O errors).
