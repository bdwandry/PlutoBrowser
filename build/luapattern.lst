 391:Source/util/luapattern.c **** 
 392:Source/util/luapattern.c **** // Run one match attempt sequence starting at subject offset `start`,
 393:Source/util/luapattern.c **** // replicating Lua's find/match scan loop ('^' anchors to `start` only).
 394:Source/util/luapattern.c **** // Returns 1 with *outStart/*outEnd set to the [start,end) of the whole
 395:Source/util/luapattern.c **** // match, 0 on no-match, LP_ERR_PATTERN on bad pattern.
 396:Source/util/luapattern.c **** static int run_match(MatchState* ms, const char* s, size_t slen,
 397:Source/util/luapattern.c ****                      const char* pat, size_t patlen, size_t start,
 398:Source/util/luapattern.c ****                      const char** outStart, const char** outEnd)
 399:Source/util/luapattern.c **** {
 400:Source/util/luapattern.c ****     const char* sp = s + start;
 401:Source/util/luapattern.c ****     int anchored = 0;
 402:Source/util/luapattern.c **** 
 403:Source/util/luapattern.c ****     ms->src = s;
 404:Source/util/luapattern.c ****     ms->send = s + slen;
 405:Source/util/luapattern.c ****     ms->pend = pat + patlen;
 406:Source/util/luapattern.c ****     ms->level = 0;
 407:Source/util/luapattern.c ****     ms->depth = 0;
 408:Source/util/luapattern.c ****     ms->err = 0;
 409:Source/util/luapattern.c **** 
 410:Source/util/luapattern.c ****     if (patlen > 0 && pat[0] == '^') {
 411:Source/util/luapattern.c ****         anchored = 1;
 412:Source/util/luapattern.c ****         pat++;
 413:Source/util/luapattern.c ****     }
 414:Source/util/luapattern.c ****     do {
 415:Source/util/luapattern.c ****         const char* e;
 416:Source/util/luapattern.c ****         ms->level = 0;
 417:Source/util/luapattern.c ****         ms->depth = 0;
 418:Source/util/luapattern.c ****         ms->err = 0;
 419:Source/util/luapattern.c ****         e = do_match(ms, sp, pat);
 420:Source/util/luapattern.c ****         if (e != NULL) {
 421:Source/util/luapattern.c ****             *outStart = sp;
 422:Source/util/luapattern.c ****             *outEnd = e;
 423:Source/util/luapattern.c ****             return 1;
 424:Source/util/luapattern.c ****         }
 425:Source/util/luapattern.c ****         if (ms->err) {
 426:Source/util/luapattern.c ****             return LP_ERR_PATTERN;
 427:Source/util/luapattern.c ****         }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccQ3uuOu.s 			page 61


 428:Source/util/luapattern.c ****         sp++;
 429:Source/util/luapattern.c ****     } while (sp <= ms->send && !anchored);
 430:Source/util/luapattern.c ****     return 0;
 431:Source/util/luapattern.c **** }
 432:Source/util/luapattern.c **** 
 433:Source/util/luapattern.c **** // Convert engine captures to public spans. With zero explicit captures,
 434:Source/util/luapattern.c **** // caps[0] becomes the whole match (Lua push_captures behavior).
 435:Source/util/luapattern.c **** static void fill_caps(const MatchState* ms, const char* mStart,
 436:Source/util/luapattern.c ****                       const char* mEnd, LPCap caps[], int* outCount)
 437:Source/util/luapattern.c **** {
 438:Source/util/luapattern.c ****     int i;
 439:Source/util/luapattern.c ****     int n = (int)ms->level;
 440:Source/util/luapattern.c **** 
 441:Source/util/luapattern.c ****     if (n == 0) {
 442:Source/util/luapattern.c ****         caps[0].start = (size_t)(mStart - ms->src);
 443:Source/util/luapattern.c ****         caps[0].len = (size_t)(mEnd - mStart);
 444:Source/util/luapattern.c ****         caps[0].isPosition = 0;
 445:Source/util/luapattern.c ****         *outCount = 1;
 446:Source/util/luapattern.c ****         return;
 447:Source/util/luapattern.c ****     }
 448:Source/util/luapattern.c ****     for (i = 0; i < n; i++) {
 449:Source/util/luapattern.c ****         caps[i].isPosition = (ms->capture[i].len == CAP_POSITION);
 450:Source/util/luapattern.c ****         caps[i].start = (size_t)(ms->capture[i].init - ms->src);
 451:Source/util/luapattern.c ****         caps[i].len = (ms->capture[i].len > 0) ? (size_t)ms->capture[i].len : 0;
 452:Source/util/luapattern.c ****     }
 453:Source/util/luapattern.c ****     *outCount = n;
 454:Source/util/luapattern.c **** }
