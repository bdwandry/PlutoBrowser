 219:Source/util/luapattern.c **** static const char* min_expand(MatchState* ms, const char* s, const char* p,
 220:Source/util/luapattern.c ****                               const char* ep)
 221:Source/util/luapattern.c **** {
 222:Source/util/luapattern.c ****     while (1) {
 223:Source/util/luapattern.c ****         const char* res = do_match(ms, s, ep + 1);
 224:Source/util/luapattern.c ****         if (res != NULL) {
 225:Source/util/luapattern.c ****             return res;
 226:Source/util/luapattern.c ****         }
 227:Source/util/luapattern.c ****         if (single_match(ms, s, p, ep)) {
 228:Source/util/luapattern.c ****             s++;
 229:Source/util/luapattern.c ****         } else {
 230:Source/util/luapattern.c ****             return NULL;
 231:Source/util/luapattern.c ****         }
 232:Source/util/luapattern.c ****     }
 233:Source/util/luapattern.c **** }
