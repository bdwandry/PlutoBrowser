 172:Source/util/luapattern.c **** static const char* match_balance(MatchState* ms, const char* s, const char* p)
 173:Source/util/luapattern.c **** {
 174:Source/util/luapattern.c ****     // Need two argument chars (x at p, y at p+1): reject only when p+1 is
 175:Source/util/luapattern.c ****     // past the end (lstrlib: p >= pend - 1).
 176:Source/util/luapattern.c ****     if (p + 2 > ms->pend) {
 177:Source/util/luapattern.c ****         pattern_error(ms, "malformed %b pattern");
 178:Source/util/luapattern.c ****         return NULL;
 179:Source/util/luapattern.c ****     }
 180:Source/util/luapattern.c ****     if (s >= ms->send || *s != *p) {
 181:Source/util/luapattern.c ****         return NULL;
 182:Source/util/luapattern.c ****     }
 183:Source/util/luapattern.c ****     {
 184:Source/util/luapattern.c ****         int b = (unsigned char)*p;
 185:Source/util/luapattern.c ****         int e = (unsigned char)*(p + 1);
 186:Source/util/luapattern.c ****         int cont = 1;
 187:Source/util/luapattern.c ****         while (++s < ms->send) {
 188:Source/util/luapattern.c ****             if (*s == e) {
 189:Source/util/luapattern.c ****                 if (--cont == 0) {
 190:Source/util/luapattern.c ****                     return s + 1;
 191:Source/util/luapattern.c ****                 }
 192:Source/util/luapattern.c ****             } else if (*s == b) {
 193:Source/util/luapattern.c ****                 cont++;
 194:Source/util/luapattern.c ****             }
 195:Source/util/luapattern.c ****         }
 196:Source/util/luapattern.c ****     }
 197:Source/util/luapattern.c ****     return NULL;
 198:Source/util/luapattern.c **** }
