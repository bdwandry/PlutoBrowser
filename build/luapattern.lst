 578:src/util/luapattern.c **** // Append template expansion for match [src, e) using ms captures.
 579:src/util/luapattern.c **** static int append_replacement(const MatchState* ms, const char* src,
 580:src/util/luapattern.c ****                               const char* e, const char* repl, size_t replLen,
 581:src/util/luapattern.c ****                               StrBuf* out)
 582:src/util/luapattern.c **** {
 583:src/util/luapattern.c ****     size_t i = 0;
 584:src/util/luapattern.c ****     while (i < replLen) {
 585:src/util/luapattern.c ****         char c = repl[i];
 586:src/util/luapattern.c ****         if (c == L_ESC && i + 1 < replLen) {
 587:src/util/luapattern.c ****             char nx = repl[i + 1];
 588:src/util/luapattern.c ****             if (nx == L_ESC) {
 589:src/util/luapattern.c ****                 if (!sb_append_char(out, L_ESC)) return 0;
 590:src/util/luapattern.c ****                 i += 2;
 591:src/util/luapattern.c ****                 continue;
