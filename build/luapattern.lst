 172:src/util/luapattern.c **** static const char* match_balance(MatchState* ms, const char* s, const char* p)
 173:src/util/luapattern.c **** {
 174:src/util/luapattern.c ****     // Need two argument chars (x at p, y at p+1): reject only when p+1 is
 175:src/util/luapattern.c ****     // past the end (lstrlib: p >= pend - 1).
 176:src/util/luapattern.c ****     if (p + 2 > ms->pend) {
 177:src/util/luapattern.c ****         pattern_error(ms, "malformed %b pattern");
 178:src/util/luapattern.c ****         return NULL;
 179:src/util/luapattern.c ****     }
 180:src/util/luapattern.c ****     if (s >= ms->send || *s != *p) {
 181:src/util/luapattern.c ****         return NULL;
 182:src/util/luapattern.c ****     }
 183:src/util/luapattern.c ****     {
 184:src/util/luapattern.c ****         int b = (unsigned char)*p;
 185:src/util/luapattern.c ****         int e = (unsigned char)*(p + 1);
 186:src/util/luapattern.c ****         int cont = 1;
 187:src/util/luapattern.c ****         while (++s < ms->send) {
 188:src/util/luapattern.c ****             if (*s == e) {
 189:src/util/luapattern.c ****                 if (--cont == 0) {
 190:src/util/luapattern.c ****                     return s + 1;
 191:src/util/luapattern.c ****                 }
 192:src/util/luapattern.c ****             } else if (*s == b) {
 193:src/util/luapattern.c ****                 cont++;
 194:src/util/luapattern.c ****             }
 195:src/util/luapattern.c ****         }
 196:src/util/luapattern.c ****     }
 197:src/util/luapattern.c ****     return NULL;
 198:src/util/luapattern.c **** }
