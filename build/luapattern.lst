 578:Source/util/luapattern.c **** // Append template expansion for match [src, e) using ms captures.
 579:Source/util/luapattern.c **** static int append_replacement(const MatchState* ms, const char* src,
 580:Source/util/luapattern.c ****                               const char* e, const char* repl, size_t replLen,
 581:Source/util/luapattern.c ****                               StrBuf* out)
 582:Source/util/luapattern.c **** {
 583:Source/util/luapattern.c ****     size_t i = 0;
 584:Source/util/luapattern.c ****     while (i < replLen) {
 585:Source/util/luapattern.c ****         char c = repl[i];
 586:Source/util/luapattern.c ****         if (c == L_ESC && i + 1 < replLen) {
 587:Source/util/luapattern.c ****             char nx = repl[i + 1];
 588:Source/util/luapattern.c ****             if (nx == L_ESC) {
 589:Source/util/luapattern.c ****                 if (!sb_append_char(out, L_ESC)) return 0;
