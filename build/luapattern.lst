 391:src/util/luapattern.c **** 
 392:src/util/luapattern.c **** // Run one match attempt sequence starting at subject offset `start`,
 393:src/util/luapattern.c **** // replicating Lua's find/match scan loop ('^' anchors to `start` only).
 394:src/util/luapattern.c **** // Returns 1 with *outStart/*outEnd set to the [start,end) of the whole
 395:src/util/luapattern.c **** // match, 0 on no-match, LP_ERR_PATTERN on bad pattern.
 396:src/util/luapattern.c **** static int run_match(MatchState* ms, const char* s, size_t slen,
 397:src/util/luapattern.c ****                      const char* pat, size_t patlen, size_t start,
 398:src/util/luapattern.c ****                      const char** outStart, const char** outEnd)
 399:src/util/luapattern.c **** {
 400:src/util/luapattern.c ****     const char* sp = s + start;
 401:src/util/luapattern.c ****     int anchored = 0;
 402:src/util/luapattern.c **** 
 403:src/util/luapattern.c ****     ms->src = s;
 404:src/util/luapattern.c ****     ms->send = s + slen;
 405:src/util/luapattern.c ****     ms->pend = pat + patlen;
 406:src/util/luapattern.c ****     ms->level = 0;
 407:src/util/luapattern.c ****     ms->depth = 0;
 408:src/util/luapattern.c ****     ms->err = 0;
 409:src/util/luapattern.c **** 
 410:src/util/luapattern.c ****     if (patlen > 0 && pat[0] == '^') {
 411:src/util/luapattern.c ****         anchored = 1;
 412:src/util/luapattern.c ****         pat++;
 413:src/util/luapattern.c ****     }
 414:src/util/luapattern.c ****     do {
 415:src/util/luapattern.c ****         const char* e;
 416:src/util/luapattern.c ****         ms->level = 0;
 417:src/util/luapattern.c ****         ms->depth = 0;
 418:src/util/luapattern.c ****         ms->err = 0;
 419:src/util/luapattern.c ****         e = do_match(ms, sp, pat);
 420:src/util/luapattern.c ****         if (e != NULL) {
 421:src/util/luapattern.c ****             *outStart = sp;
 422:src/util/luapattern.c ****             *outEnd = e;
 423:src/util/luapattern.c ****             return 1;
 424:src/util/luapattern.c ****         }
 425:src/util/luapattern.c ****         if (ms->err) {
 426:src/util/luapattern.c ****             return LP_ERR_PATTERN;
 427:src/util/luapattern.c ****         }
 428:src/util/luapattern.c ****         sp++;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc1Weoxx.s 			page 61


 429:src/util/luapattern.c ****     } while (sp <= ms->send && !anchored);
 430:src/util/luapattern.c ****     return 0;
 431:src/util/luapattern.c **** }
 432:src/util/luapattern.c **** 
 433:src/util/luapattern.c **** // Convert engine captures to public spans. With zero explicit captures,
 434:src/util/luapattern.c **** // caps[0] becomes the whole match (Lua push_captures behavior).
 435:src/util/luapattern.c **** static void fill_caps(const MatchState* ms, const char* mStart,
 436:src/util/luapattern.c ****                       const char* mEnd, LPCap caps[], int* outCount)
 437:src/util/luapattern.c **** {
 438:src/util/luapattern.c ****     int i;
 439:src/util/luapattern.c ****     int n = (int)ms->level;
 440:src/util/luapattern.c **** 
 441:src/util/luapattern.c ****     if (n == 0) {
 442:src/util/luapattern.c ****         caps[0].start = (size_t)(mStart - ms->src);
 443:src/util/luapattern.c ****         caps[0].len = (size_t)(mEnd - mStart);
 444:src/util/luapattern.c ****         caps[0].isPosition = 0;
 445:src/util/luapattern.c ****         *outCount = 1;
 446:src/util/luapattern.c ****         return;
 447:src/util/luapattern.c ****     }
 448:src/util/luapattern.c ****     for (i = 0; i < n; i++) {
 449:src/util/luapattern.c ****         caps[i].isPosition = (ms->capture[i].len == CAP_POSITION);
 450:src/util/luapattern.c ****         caps[i].start = (size_t)(ms->capture[i].init - ms->src);
 451:src/util/luapattern.c ****         caps[i].len = (ms->capture[i].len > 0) ? (size_t)ms->capture[i].len : 0;
 452:src/util/luapattern.c ****     }
 453:src/util/luapattern.c ****     *outCount = n;
 454:src/util/luapattern.c **** }
