 202:Source/util/luapattern.c **** static const char* max_expand(MatchState* ms, const char* s, const char* p,
 203:Source/util/luapattern.c ****                               const char* ep)
 204:Source/util/luapattern.c **** {
 205:Source/util/luapattern.c ****     ptrdiff_t i = 0;
 206:Source/util/luapattern.c ****     while (single_match(ms, s + i, p, ep)) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccQ3uuOu.s 			page 28


 207:Source/util/luapattern.c ****         i++;
 208:Source/util/luapattern.c ****     }
 209:Source/util/luapattern.c ****     while (i >= 0) { // backtrack from greediest
 210:Source/util/luapattern.c ****         const char* res = do_match(ms, s + i, ep + 1);
 211:Source/util/luapattern.c ****         if (res != NULL) {
 212:Source/util/luapattern.c ****             return res;
 213:Source/util/luapattern.c ****         }
 214:Source/util/luapattern.c ****         i--;
 215:Source/util/luapattern.c ****     }
 216:Source/util/luapattern.c ****     return NULL;
 217:Source/util/luapattern.c **** }
