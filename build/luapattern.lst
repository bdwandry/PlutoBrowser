   1:Source/util/luapattern.c **** // luapattern.c — Lua 5.4 pattern matcher port (see header for scope).
   2:Source/util/luapattern.c **** //
   3:Source/util/luapattern.c **** // Structure mirrors lstrlib.c: class_end / match_class / matchbracketclass /
   4:Source/util/luapattern.c **** // singlematch / max_expand / min_expand / captures / %b / %f / do_match,
   5:Source/util/luapattern.c **** // then public wrappers (find, find_plain, match, gmatch, gsub).
   6:Source/util/luapattern.c **** //
   7:Source/util/luapattern.c **** // Depth accounting is centralized in do_match(); all other helpers assume
   8:Source/util/luapattern.c **** // they run inside its bracket. Subjects and patterns carry explicit lengths
   9:Source/util/luapattern.c **** // (NUL-safe). Malformed patterns set ms->err instead of raising.
