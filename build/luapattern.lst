 212:src/util/luapattern.c ****             return res;
 213:src/util/luapattern.c ****         }
 214:src/util/luapattern.c ****         i--;
 215:src/util/luapattern.c ****     }
 216:src/util/luapattern.c ****     return NULL;
 217:src/util/luapattern.c **** }
