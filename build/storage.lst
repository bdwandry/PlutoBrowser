 289:Source/core/storage.c **** static void load_defaults(void)
 290:Source/core/storage.c **** {
 291:Source/core/storage.c ****     free_lists();
 292:Source/core/storage.c ****     for (int i = 0; i < DEFAULT_BOOKMARK_COUNT; i++)
 293:Source/core/storage.c ****     {
 294:Source/core/storage.c ****         StoredBookmark *b = (StoredBookmark *)PLUTO_MALLOC(sizeof(StoredBookmark));
 295:Source/core/storage.c ****         if (!b)
 296:Source/core/storage.c ****         {
 297:Source/core/storage.c ****             break;
 298:Source/core/storage.c ****         }
 299:Source/core/storage.c ****         b->title = dup_str(DEFAULT_BOOKMARKS[i].title);
 300:Source/core/storage.c ****         b->url = dup_str(DEFAULT_BOOKMARKS[i].url);
 301:Source/core/storage.c ****         b->desc = dup_str(DEFAULT_BOOKMARKS[i].desc);
 302:Source/core/storage.c ****         g_bookmarks[g_bookmarkCount++] = b;
 303:Source/core/storage.c ****     }
 304:Source/core/storage.c ****     /* settings stay at their initializer defaults; fontSize="medium" etc. */
 305:Source/core/storage.c **** }
 306:Source/core/storage.c **** 
 307:Source/core/storage.c **** static void load_cookies_from_jar_test_shim(void)
 308:Source/core/storage.c **** {
 309:Source/core/storage.c ****     /* Cookies live in the jar (Phase 8); the file's [cookies] section is
 310:Source/core/storage.c ****      * written from the jar and restored into it here via the public test
 311:Source/core/storage.c ****      * accessor. Phase 30 integration will move this behind the save hook. */
 312:Source/core/storage.c **** }
 313:Source/core/storage.c **** 
 314:Source/core/storage.c **** /* Big scratch buffers live in BSS, not the stack: the device game-task
 315:Source/core/storage.c ****  * stack is small, and storage_load → storage_save → logger_log nests three
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccWkglxB.s 			page 27


 316:Source/core/storage.c ****  * ~2-3KB frames (same failure mode as the P18 battery; see main.c). These
 317:Source/core/storage.c ****  * are safe as statics — the game is single-task and never re-enters them. */
 318:Source/core/storage.c **** static char g_loadLine[1024];
 319:Source/core/storage.c **** static char g_saveEsc[800];
 320:Source/core/storage.c **** static char g_saveLine[1200];
 321:Source/core/storage.c **** 
 322:Source/core/storage.c **** void storage_load(void)
 323:Source/core/storage.c **** {
 324:Source/core/storage.c ****     /* NOTE: kFileRead reads the game BUNDLE; data files written via kFileWrite
 325:Source/core/storage.c ****      * live in the /Data/<bundleid> sandbox and must be read with
 326:Source/core/storage.c ****      * kFileReadData (this is what datastore read/write used in Lua). */
 327:Source/core/storage.c ****     logger_log("STORAGE: load enter");
 328:Source/core/storage.c ****     SDFile *f = pluto_pd()->file->open(DATA_FILENAME, kFileReadData);
 329:Source/core/storage.c ****     if (!f)
 330:Source/core/storage.c ****     {
 331:Source/core/storage.c ****         logger_log("STORAGE: no data file -> defaults");
 332:Source/core/storage.c ****         load_defaults();
 333:Source/core/storage.c ****         logger_log("STORAGE: defaults done (bm=%d)", g_bookmarkCount);
 334:Source/core/storage.c ****         g_haveDefaults = 1;
 335:Source/core/storage.c ****         logger_log("STORAGE: save enter");
 336:Source/core/storage.c ****         storage_save(); /* Lua: first run saves the defaults */
 337:Source/core/storage.c ****         logger_log("STORAGE: save done");
 338:Source/core/storage.c ****         return;
 339:Source/core/storage.c ****     }
 340:Source/core/storage.c ****     logger_log("STORAGE: file opened, parsing");
 341:Source/core/storage.c **** 
 342:Source/core/storage.c ****     free_lists();
 343:Source/core/storage.c **** 
 344:Source/core/storage.c ****     /* reset settings to defaults before applying the file */
 345:Source/core/storage.c ****     storage_set_setting_int("searchEngine", 1);
 346:Source/core/storage.c ****     storage_set_setting_int("mode", 1); /* Constants.MODE_RAW_HTML (Lua default) */
 347:Source/core/storage.c ****     storage_set_setting_int("autoReader", 0);
 348:Source/core/storage.c ****     storage_set_setting_str("fontSize", "medium");
 349:Source/core/storage.c ****     storage_set_setting_str("imageMode", "viewport"); /* IMAGE_MODE_VIEWPORT */
 350:Source/core/storage.c ****     storage_set_setting_int("showFps", 0); /* FPS overlay off by default */
 351:Source/core/storage.c ****     storage_set_setting_int("invertCrank", 0);
 352:Source/core/storage.c **** 
 353:Source/core/storage.c ****     char *line = g_loadLine;
 354:Source/core/storage.c ****     char section[32] = "";
 355:Source/core/storage.c ****     while (read_line(f, line, 1024))
 356:Source/core/storage.c ****     {
 357:Source/core/storage.c ****         size_t len = strlen(line);
 358:Source/core/storage.c ****         while (len > 0 && (line[len - 1] == '\n' || line[len - 1] == '\r'))
 359:Source/core/storage.c ****         {
 360:Source/core/storage.c ****             line[--len] = '\0';
 361:Source/core/storage.c ****         }
