   1:Source/core/storage.c **** // storage.c — persistent Storage (see header).
   2:Source/core/storage.c **** //
   3:Source/core/storage.c **** // Parity notes vs core/storage.lua:
   4:Source/core/storage.c **** //  - init: missing/empty bookmarks -> DEFAULT_BOOKMARKS; history/cookies
   5:Source/core/storage.c **** //    adopted verbatim when present; settings merged per-key.
   6:Source/core/storage.c **** //  - addHistory: skips NULL/""/"^about:" URLs, dedups by exact URL scanning
   7:Source/core/storage.c **** //    from the END (first match removed), inserts at front, caps at 50 by
   8:Source/core/storage.c **** //    dropping from the tail, auto-saves.
   9:Source/core/storage.c **** //  - addBookmark: duplicate URL updates TITLE ONLY (desc untouched).
  10:Source/core/storage.c **** //  - removeBookmark takes a 1-based index; out-of-range -> 0, no change.
  11:Source/core/storage.c **** 
