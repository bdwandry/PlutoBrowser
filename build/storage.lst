 178:Source/core/storage.c **** {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccae2aBf.s 			page 12


 179:Source/core/storage.c ****     if (c >= '0' && c <= '9')
 180:Source/core/storage.c ****     {
 181:Source/core/storage.c ****         return c - '0';
 182:Source/core/storage.c ****     }
 183:Source/core/storage.c ****     if (c >= 'A' && c <= 'F')
 184:Source/core/storage.c ****     {
