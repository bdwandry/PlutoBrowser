  94:Source/core/storage.c **** 
  95:Source/core/storage.c **** static const char* mode_to_str(int mode)
  96:Source/core/storage.c **** {
  97:Source/core/storage.c ****     switch ((PlutoMode)mode) {
  98:Source/core/storage.c ****         case PLUTO_MODE_READER:   return "reader";
  99:Source/core/storage.c ****         case PLUTO_MODE_RAW_HTML: return "html";
 100:Source/core/storage.c ****         case PLUTO_MODE_OPERA_DS: return "ds";
 101:Source/core/storage.c ****         default:                  return "html";
 102:Source/core/storage.c ****     }
 103:Source/core/storage.c **** }
 104:Source/core/storage.c **** 
 105:Source/core/storage.c **** static int mode_from_str(const char* s)
 106:Source/core/storage.c **** {
 107:Source/core/storage.c ****     if (strcmp(s, "reader") == 0) return PLUTO_MODE_READER;
 108:Source/core/storage.c ****     if (strcmp(s, "html") == 0)   return PLUTO_MODE_RAW_HTML;
 109:Source/core/storage.c ****     if (strcmp(s, "ds") == 0)     return PLUTO_MODE_OPERA_DS;
 110:Source/core/storage.c ****     return -1;
 111:Source/core/storage.c **** }
 112:Source/core/storage.c **** 
 113:Source/core/storage.c **** static const char* image_mode_to_str(int mode)
 114:Source/core/storage.c **** {
 115:Source/core/storage.c ****     switch ((PlutoImageMode)mode) {
 116:Source/core/storage.c ****         case PLUTO_IMAGE_MODE_ALL:      return "all";
 117:Source/core/storage.c ****         case PLUTO_IMAGE_MODE_VIEWPORT: return "viewport";
 118:Source/core/storage.c ****         case PLUTO_IMAGE_MODE_ONDEMAND: return "ondemand";
 119:Source/core/storage.c ****         case PLUTO_IMAGE_MODE_HOVER:    return "hover";
 120:Source/core/storage.c ****         case PLUTO_IMAGE_MODE_DISABLED: return "disabled";
 121:Source/core/storage.c ****         default:                        return "viewport";
 122:Source/core/storage.c ****     }
 123:Source/core/storage.c **** }
 124:Source/core/storage.c **** 
 125:Source/core/storage.c **** static int image_mode_from_str(const char* s)
 126:Source/core/storage.c **** {
 127:Source/core/storage.c ****     if (strcmp(s, "all") == 0)      return PLUTO_IMAGE_MODE_ALL;
 128:Source/core/storage.c ****     if (strcmp(s, "viewport") == 0) return PLUTO_IMAGE_MODE_VIEWPORT;
 129:Source/core/storage.c ****     if (strcmp(s, "ondemand") == 0) return PLUTO_IMAGE_MODE_ONDEMAND;
 130:Source/core/storage.c ****     if (strcmp(s, "hover") == 0)    return PLUTO_IMAGE_MODE_HOVER;
