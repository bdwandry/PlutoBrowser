 177:Source/core/storage.c **** static int hexval(char c)
 178:Source/core/storage.c **** {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccf0UlJP.s 			page 12


 179:Source/core/storage.c ****     if (c >= '0' && c <= '9')
 180:Source/core/storage.c ****     {
 181:Source/core/storage.c ****         return c - '0';
 182:Source/core/storage.c ****     }
 183:Source/core/storage.c ****     if (c >= 'A' && c <= 'F')
 184:Source/core/storage.c ****     {
 185:Source/core/storage.c ****         return c - 'A' + 10;
 186:Source/core/storage.c ****     }
 187:Source/core/storage.c ****     if (c >= 'a' && c <= 'f')
 188:Source/core/storage.c ****     {
 189:Source/core/storage.c ****         return c - 'a' + 10;
 190:Source/core/storage.c ****     }
 191:Source/core/storage.c ****     return -1;
 192:Source/core/storage.c **** }
