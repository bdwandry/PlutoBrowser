 241:Source/core/storage.c **** /* ── line reader (the C file API has no readline) ──────────────�
 242:Source/core/storage.c **** 
 243:Source/core/storage.c **** /* Reads one '\n'-terminated line into buf. Returns 1 on success, 0 at EOF.
 244:Source/core/storage.c ****  * The trailing newline is NOT stored; a NUL is appended. */
 245:Source/core/storage.c **** static int read_line(SDFile *f, char *buf, size_t cap)
 246:Source/core/storage.c **** {
 247:Source/core/storage.c ****     size_t o = 0;
 248:Source/core/storage.c ****     int c;
 249:Source/core/storage.c ****     char ch;
 250:Source/core/storage.c ****     int got = 0;
 251:Source/core/storage.c ****     while ((c = pluto_pd()->file->read(f, &ch, 1)) == 1)
 252:Source/core/storage.c ****     {
 253:Source/core/storage.c ****         got = 1;
 254:Source/core/storage.c ****         if (ch == '\n')
 255:Source/core/storage.c ****         {
 256:Source/core/storage.c ****             break;
 257:Source/core/storage.c ****         }
 258:Source/core/storage.c ****         if (o + 1 < cap)
 259:Source/core/storage.c ****         {
 260:Source/core/storage.c ****             buf[o++] = ch;
 261:Source/core/storage.c ****         }
 262:Source/core/storage.c ****     }
 263:Source/core/storage.c ****     buf[o] = '\0';
 264:Source/core/storage.c ****     return got;
 265:Source/core/storage.c **** }
