 195:Source/core/storage.c **** static void unescape_to(const char *in, char *out, size_t cap)
 196:Source/core/storage.c **** {
 197:Source/core/storage.c ****     size_t o = 0;
 198:Source/core/storage.c ****     for (const char *p = in; *p && o + 1 < cap; p++)
 199:Source/core/storage.c ****     {
 200:Source/core/storage.c ****         if (*p == '\\' && p[1])
 201:Source/core/storage.c ****         {
 202:Source/core/storage.c ****             p++;
 203:Source/core/storage.c ****             if (*p == 'p')
 204:Source/core/storage.c ****             {
 205:Source/core/storage.c ****                 out[o++] = '|';
 206:Source/core/storage.c ****             }
 207:Source/core/storage.c ****             else if (*p == 't')
 208:Source/core/storage.c ****             {
 209:Source/core/storage.c ****                 out[o++] = '\t';
 210:Source/core/storage.c ****             }
 211:Source/core/storage.c ****             else if (*p == 'n')
 212:Source/core/storage.c ****             {
 213:Source/core/storage.c ****                 out[o++] = '\n';
 214:Source/core/storage.c ****             }
 215:Source/core/storage.c ****             else if (*p == 'r')
 216:Source/core/storage.c ****             {
 217:Source/core/storage.c ****                 out[o++] = '\r';
 218:Source/core/storage.c ****             }
 219:Source/core/storage.c ****             else if (*p == '\\')
 220:Source/core/storage.c ****             {
 221:Source/core/storage.c ****                 out[o++] = '\\';
 222:Source/core/storage.c ****             }
 223:Source/core/storage.c ****             else if (*p == 'x' && hexval(p[1]) >= 0 && hexval(p[2]) >= 0)
 224:Source/core/storage.c ****             {
 225:Source/core/storage.c ****                 out[o++] = (char)((hexval(p[1]) << 4) | hexval(p[2]));
 226:Source/core/storage.c ****                 p += 2;
 227:Source/core/storage.c ****             }
 228:Source/core/storage.c ****             else
 229:Source/core/storage.c ****             {
 230:Source/core/storage.c ****                 out[o++] = *p; /* unknown escape: keep the char literally */
 231:Source/core/storage.c ****             }
 232:Source/core/storage.c ****         }
 233:Source/core/storage.c ****         else
 234:Source/core/storage.c ****         {
 235:Source/core/storage.c ****             out[o++] = *p;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccWkglxB.s 			page 13


 236:Source/core/storage.c ****         }
 237:Source/core/storage.c ****     }
 238:Source/core/storage.c ****     out[o] = '\0';
 239:Source/core/storage.c **** }
