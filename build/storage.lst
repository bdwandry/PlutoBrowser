 288:Source/core/storage.c **** static void load_defaults(void)
 289:Source/core/storage.c **** {
 290:Source/core/storage.c ****     free_lists();
 291:Source/core/storage.c ****     for (int i = 0; i < DEFAULT_BOOKMARK_COUNT; i++)
 292:Source/core/storage.c ****     {
 293:Source/core/storage.c ****         StoredBookmark *b = (StoredBookmark *)PLUTO_MALLOC(sizeof(StoredBookmark));
 294:Source/core/storage.c ****         if (!b)
 295:Source/core/storage.c ****         {
 296:Source/core/storage.c ****             break;
 297:Source/core/storage.c ****         }
 298:Source/core/storage.c ****         b->title = dup_str(DEFAULT_BOOKMARKS[i].title);
 299:Source/core/storage.c ****         b->url = dup_str(DEFAULT_BOOKMARKS[i].url);
 300:Source/core/storage.c ****         b->desc = dup_str(DEFAULT_BOOKMARKS[i].desc);
 301:Source/core/storage.c ****         g_bookmarks[g_bookmarkCount++] = b;
 302:Source/core/storage.c ****     }
 303:Source/core/storage.c ****     /* settings stay at their initializer defaults; fontSize="medium" etc. */
 304:Source/core/storage.c **** }
 305:Source/core/storage.c **** 
 306:Source/core/storage.c **** static void load_cookies_from_jar_test_shim(void)
 307:Source/core/storage.c **** {
 308:Source/core/storage.c ****     /* Cookies live in the jar (Phase 8); the file's [cookies] section is
 309:Source/core/storage.c ****      * written from the jar and restored into it here via the public test
 310:Source/core/storage.c ****      * accessor. Phase 30 integration will move this behind the save hook. */
 311:Source/core/storage.c **** }
 312:Source/core/storage.c **** 
 313:Source/core/storage.c **** /* Big scratch buffers live in BSS, not the stack: the device game-task
 314:Source/core/storage.c ****  * stack is small, and storage_load → storage_save → logger_log nests three
 315:Source/core/storage.c ****  * ~2-3KB frames (same failure mode as the P18 battery; see main.c). These
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccuhzemY.s 			page 27


 316:Source/core/storage.c ****  * are safe as statics — the game is single-task and never re-enters them. */
 317:Source/core/storage.c **** static char g_loadLine[1024];
 318:Source/core/storage.c **** static char g_saveEsc[800];
 319:Source/core/storage.c **** static char g_saveLine[1200];
 320:Source/core/storage.c **** 
 321:Source/core/storage.c **** void storage_load(void)
 322:Source/core/storage.c **** {
 323:Source/core/storage.c ****     /* NOTE: kFileRead reads the game BUNDLE; data files written via kFileWrite
 324:Source/core/storage.c ****      * live in the /Data/<bundleid> sandbox and must be read with
 325:Source/core/storage.c ****      * kFileReadData (this is what datastore read/write used in Lua). */
 326:Source/core/storage.c ****     logger_log("STORAGE: load enter");
 327:Source/core/storage.c ****     SDFile *f = pluto_pd()->file->open(DATA_FILENAME, kFileReadData);
 328:Source/core/storage.c ****     if (!f)
 329:Source/core/storage.c ****     {
 330:Source/core/storage.c ****         logger_log("STORAGE: no data file -> defaults");
 331:Source/core/storage.c ****         load_defaults();
 332:Source/core/storage.c ****         logger_log("STORAGE: defaults done (bm=%d)", g_bookmarkCount);
 333:Source/core/storage.c ****         g_haveDefaults = 1;
 334:Source/core/storage.c ****         logger_log("STORAGE: save enter");
 335:Source/core/storage.c ****         storage_save(); /* Lua: first run saves the defaults */
 336:Source/core/storage.c ****         logger_log("STORAGE: save done");
 337:Source/core/storage.c ****         return;
 338:Source/core/storage.c ****     }
 339:Source/core/storage.c ****     logger_log("STORAGE: file opened, parsing");
 340:Source/core/storage.c **** 
 341:Source/core/storage.c ****     free_lists();
 342:Source/core/storage.c **** 
 343:Source/core/storage.c ****     /* reset settings to defaults before applying the file */
 344:Source/core/storage.c ****     storage_set_setting_int("searchEngine", 1);
 345:Source/core/storage.c ****     storage_set_setting_int("mode", 1); /* Constants.MODE_RAW_HTML (Lua default) */
 346:Source/core/storage.c ****     storage_set_setting_int("autoReader", 0);
 347:Source/core/storage.c ****     storage_set_setting_str("fontSize", "medium");
 348:Source/core/storage.c ****     storage_set_setting_str("imageMode", "viewport"); /* IMAGE_MODE_VIEWPORT */
 349:Source/core/storage.c ****     storage_set_setting_int("invertCrank", 0);
 350:Source/core/storage.c **** 
 351:Source/core/storage.c ****     char *line = g_loadLine;
 352:Source/core/storage.c ****     char section[32] = "";
 353:Source/core/storage.c ****     while (read_line(f, line, 1024))
 354:Source/core/storage.c ****     {
 355:Source/core/storage.c ****         size_t len = strlen(line);
 356:Source/core/storage.c ****         while (len > 0 && (line[len - 1] == '\n' || line[len - 1] == '\r'))
 357:Source/core/storage.c ****         {
 358:Source/core/storage.c ****             line[--len] = '\0';
 359:Source/core/storage.c ****         }
 360:Source/core/storage.c ****         if (len == 0 || line[0] == '#')
 361:Source/core/storage.c ****         {
 362:Source/core/storage.c ****             continue;
 363:Source/core/storage.c ****         }
 364:Source/core/storage.c ****         if (line[0] == '[')
 365:Source/core/storage.c ****         {
 366:Source/core/storage.c ****             char *end = strchr(line, ']');
