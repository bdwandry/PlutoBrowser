  95:Source/core/storage.c **** 
  96:Source/core/storage.c **** static const char* mode_to_str(int mode)
  97:Source/core/storage.c **** {
  98:Source/core/storage.c ****     switch ((PlutoMode)mode) {
  99:Source/core/storage.c ****         case PLUTO_MODE_READER:   return "reader";
 100:Source/core/storage.c ****         case PLUTO_MODE_RAW_HTML: return "html";
 101:Source/core/storage.c ****         case PLUTO_MODE_OPERA_DS: return "ds";
 102:Source/core/storage.c ****         default:                  return "html";
 103:Source/core/storage.c ****     }
 104:Source/core/storage.c **** }
 105:Source/core/storage.c **** 
 106:Source/core/storage.c **** static int mode_from_str(const char* s)
 107:Source/core/storage.c **** {
 108:Source/core/storage.c ****     if (strcmp(s, "reader") == 0) return PLUTO_MODE_READER;
 109:Source/core/storage.c ****     if (strcmp(s, "html") == 0)   return PLUTO_MODE_RAW_HTML;
 110:Source/core/storage.c ****     if (strcmp(s, "ds") == 0)     return PLUTO_MODE_OPERA_DS;
 111:Source/core/storage.c ****     return -1;
 112:Source/core/storage.c **** }
 113:Source/core/storage.c **** 
 114:Source/core/storage.c **** static const char* image_mode_to_str(int mode)
 115:Source/core/storage.c **** {
 116:Source/core/storage.c ****     switch ((PlutoImageMode)mode) {
 117:Source/core/storage.c ****         case PLUTO_IMAGE_MODE_ALL:      return "all";
 118:Source/core/storage.c ****         case PLUTO_IMAGE_MODE_VIEWPORT: return "viewport";
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccx95cFp.s 			page 11


 119:Source/core/storage.c ****         case PLUTO_IMAGE_MODE_ONDEMAND: return "ondemand";
 120:Source/core/storage.c ****         case PLUTO_IMAGE_MODE_HOVER:    return "hover";
 121:Source/core/storage.c ****         case PLUTO_IMAGE_MODE_DISABLED: return "disabled";
 122:Source/core/storage.c ****         default:                        return "viewport";
 123:Source/core/storage.c ****     }
 124:Source/core/storage.c **** }
 125:Source/core/storage.c **** 
