  57:Source/core/storage.c ****     // shift [0..n-2] up one slot, place new element at 0
  58:Source/core/storage.c ****     memmove((char*)a->items + a->elemsize, a->items,
  59:Source/core/storage.c ****             (a->count - 1) * a->elemsize);
  60:Source/core/storage.c ****     memcpy(a->items, elem, a->elemsize);
