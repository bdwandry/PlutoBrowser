 240:Source/core/storage.c **** /* ── line reader (the C file API has no readline) ──────────────�
 241:Source/core/storage.c **** 
 242:Source/core/storage.c **** /* Reads one '\n'-terminated line into buf. Returns 1 on success, 0 at EOF.
 243:Source/core/storage.c ****  * The trailing newline is NOT stored; a NUL is appended. */
 244:Source/core/storage.c **** static int read_line(SDFile *f, char *buf, size_t cap)
 245:Source/core/storage.c **** {
 246:Source/core/storage.c ****     size_t o = 0;
 247:Source/core/storage.c ****     int c;
 248:Source/core/storage.c ****     char ch;
 249:Source/core/storage.c ****     int got = 0;
 250:Source/core/storage.c ****     while ((c = pluto_pd()->file->read(f, &ch, 1)) == 1)
 251:Source/core/storage.c ****     {
 252:Source/core/storage.c ****         got = 1;
 253:Source/core/storage.c ****         if (ch == '\n')
 254:Source/core/storage.c ****         {
 255:Source/core/storage.c ****             break;
 256:Source/core/storage.c ****         }
 257:Source/core/storage.c ****         if (o + 1 < cap)
 258:Source/core/storage.c ****         {
 259:Source/core/storage.c ****             buf[o++] = ch;
 260:Source/core/storage.c ****         }
 261:Source/core/storage.c ****     }
 262:Source/core/storage.c ****     buf[o] = '\0';
 263:Source/core/storage.c ****     return got;
 264:Source/core/storage.c **** }
