 194:Source/core/storage.c **** static void unescape_to(const char *in, char *out, size_t cap)
 195:Source/core/storage.c **** {
 196:Source/core/storage.c ****     size_t o = 0;
 197:Source/core/storage.c ****     for (const char *p = in; *p && o + 1 < cap; p++)
 198:Source/core/storage.c ****     {
 199:Source/core/storage.c ****         if (*p == '\\' && p[1])
 200:Source/core/storage.c ****         {
 201:Source/core/storage.c ****             p++;
 202:Source/core/storage.c ****             if (*p == 'p')
 203:Source/core/storage.c ****             {
 204:Source/core/storage.c ****                 out[o++] = '|';
 205:Source/core/storage.c ****             }
 206:Source/core/storage.c ****             else if (*p == 't')
 207:Source/core/storage.c ****             {
 208:Source/core/storage.c ****                 out[o++] = '\t';
 209:Source/core/storage.c ****             }
 210:Source/core/storage.c ****             else if (*p == 'n')
 211:Source/core/storage.c ****             {
 212:Source/core/storage.c ****                 out[o++] = '\n';
 213:Source/core/storage.c ****             }
 214:Source/core/storage.c ****             else if (*p == 'r')
 215:Source/core/storage.c ****             {
 216:Source/core/storage.c ****                 out[o++] = '\r';
 217:Source/core/storage.c ****             }
 218:Source/core/storage.c ****             else if (*p == '\\')
 219:Source/core/storage.c ****             {
 220:Source/core/storage.c ****                 out[o++] = '\\';
 221:Source/core/storage.c ****             }
 222:Source/core/storage.c ****             else if (*p == 'x' && hexval(p[1]) >= 0 && hexval(p[2]) >= 0)
 223:Source/core/storage.c ****             {
 224:Source/core/storage.c ****                 out[o++] = (char)((hexval(p[1]) << 4) | hexval(p[2]));
 225:Source/core/storage.c ****                 p += 2;
 226:Source/core/storage.c ****             }
 227:Source/core/storage.c ****             else
 228:Source/core/storage.c ****             {
 229:Source/core/storage.c ****                 out[o++] = *p; /* unknown escape: keep the char literally */
 230:Source/core/storage.c ****             }
 231:Source/core/storage.c ****         }
 232:Source/core/storage.c ****         else
 233:Source/core/storage.c ****         {
 234:Source/core/storage.c ****             out[o++] = *p;
 235:Source/core/storage.c ****         }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccuhzemY.s 			page 13


 236:Source/core/storage.c ****     }
 237:Source/core/storage.c ****     out[o] = '\0';
 238:Source/core/storage.c **** }
