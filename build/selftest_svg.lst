   3:Source/render/decoders/selftest_svg.c **** // Decodes SVG fixtures cross-validated against an independent Python
   4:Source/render/decoders/selftest_svg.c **** // replica of the C rasterizer+parser spec (rects incl. rounded corners,
   5:Source/render/decoders/selftest_svg.c **** // circles, ringed ellipses, lines, polylines/polygons, path commands
   6:Source/render/decoders/selftest_svg.c **** // M/L/H/V/Z/C/S/Q/T/A, use/defs expansion, nested skip containers,
