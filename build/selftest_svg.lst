  95:Source/render/decoders/selftest_svg.c ****         for (x = 0; x < w; x++) {
  96:Source/render/decoders/selftest_svg.c ****             hsh ^= rows[y][x];
  97:Source/render/decoders/selftest_svg.c ****             hsh *= FNV_PRIME;
  98:Source/render/decoders/selftest_svg.c ****         }
  99:Source/render/decoders/selftest_svg.c ****     return hsh;
 100:Source/render/decoders/selftest_svg.c **** }
