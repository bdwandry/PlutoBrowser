  74:src/render/decoders/bmp.c ****     } else if (c->bpp == 8) {
  75:src/render/decoders/bmp.c ****         size_t pPos = rowStart + (size_t)srcX;
  76:src/render/decoders/bmp.c ****         int idx = pPos < len ? d[pPos] : 0;   /* `idx or 0` */
  77:src/render/decoders/bmp.c ****         return idx < c->numColors ? c->palette[idx] : 0;
  78:src/render/decoders/bmp.c ****     } else if (c->bpp == 4) {
  79:src/render/decoders/bmp.c ****         size_t pPos = rowStart + (size_t)(srcX >> 1);
  80:src/render/decoders/bmp.c ****         int b = pPos < len ? d[pPos] : 0;
