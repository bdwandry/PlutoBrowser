  63:src/render/decoders/bmp.c **** 
  64:src/render/decoders/bmp.c ****     size_t rowStart = (size_t)c->pixelOffset +
  65:src/render/decoders/bmp.c ****                       (size_t)bmpY * c->rowBytes;
  66:src/render/decoders/bmp.c **** 
  67:src/render/decoders/bmp.c ****     if (c->bpp == 24 || c->bpp == 32) {
  68:src/render/decoders/bmp.c ****         size_t stride = (size_t)c->bpp / 8;
  69:src/render/decoders/bmp.c ****         size_t pPos = rowStart + (size_t)srcX * stride;
  70:src/render/decoders/bmp.c ****         if (pPos < len && pPos + 2 < len)
  71:src/render/decoders/bmp.c ****             return dither_rgb_to_gray(d[pPos + 2], d[pPos + 1],
  72:src/render/decoders/bmp.c ****                                       d[pPos]);
