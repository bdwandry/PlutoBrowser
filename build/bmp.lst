  56:src/render/decoders/bmp.c ****     size_t len = c->len;
  57:src/render/decoders/bmp.c **** 
  58:src/render/decoders/bmp.c ****     int srcX = (int)floor(outX * c->scale);
  59:src/render/decoders/bmp.c ****     if (srcX > c->width - 1) srcX = c->width - 1;
  60:src/render/decoders/bmp.c ****     int srcY = (int)floor(outY * c->scale);
  61:src/render/decoders/bmp.c ****     if (srcY > c->height - 1) srcY = c->height - 1;
  62:src/render/decoders/bmp.c ****     int bmpY = c->isTopDown ? srcY : (c->height - 1 - srcY);
