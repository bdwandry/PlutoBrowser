 119:Source/render/decoders/bmp.c **** 
 120:Source/render/decoders/bmp.c **** /* Load the palette (bpp<=8): 1<<bpp entries of BGR at palOffset. */
 121:Source/render/decoders/bmp.c **** static void bmp_load_palette(BmpCtx *c, size_t palOffset)
 122:Source/render/decoders/bmp.c **** {
 123:Source/render/decoders/bmp.c ****     int numColors = 1 << c->bpp;
 124:Source/render/decoders/bmp.c ****     for (int i = 0; i < numColors && i < 256; i++)
 125:Source/render/decoders/bmp.c ****     {
 126:Source/render/decoders/bmp.c ****         size_t p = palOffset + (size_t)i * 4;
 127:Source/render/decoders/bmp.c ****         if (p + 2 < c->len)
 128:Source/render/decoders/bmp.c ****         {
 129:Source/render/decoders/bmp.c ****             c->palette[i] = (uint8_t)dither_rgb_to_gray(c->data[p + 2], c->data[p + 1], c->data[p])
 130:Source/render/decoders/bmp.c ****         }
 131:Source/render/decoders/bmp.c ****         else
 132:Source/render/decoders/bmp.c ****         {
 133:Source/render/decoders/bmp.c ****             c->palette[i] = 0;
 134:Source/render/decoders/bmp.c ****         }
 135:Source/render/decoders/bmp.c ****     }
 136:Source/render/decoders/bmp.c **** }
