 120:Source/render/decoders/bmp.c **** 
 121:Source/render/decoders/bmp.c **** /* Load the palette (bpp<=8): 1<<bpp entries of BGR at palOffset. */
 122:Source/render/decoders/bmp.c **** static void bmp_load_palette(BmpCtx *c, size_t palOffset)
 123:Source/render/decoders/bmp.c **** {
 124:Source/render/decoders/bmp.c ****     int numColors = 1 << c->bpp;
 125:Source/render/decoders/bmp.c ****     size_t stride = c->isOs2Pal ? 3 : 4; /* OS/2: RGBTRIPLE (3 bytes) */
 126:Source/render/decoders/bmp.c ****     for (int i = 0; i < numColors && i < 256; i++)
 127:Source/render/decoders/bmp.c ****     {
 128:Source/render/decoders/bmp.c ****         size_t p = palOffset + (size_t)i * stride;
 129:Source/render/decoders/bmp.c ****         if (p + 2 < c->len)
 130:Source/render/decoders/bmp.c ****         {
 131:Source/render/decoders/bmp.c ****             c->palette[i] = (uint8_t)dither_rgb_to_gray(c->data[p + 2], c->data[p + 1], c->data[p])
 132:Source/render/decoders/bmp.c ****         }
 133:Source/render/decoders/bmp.c ****         else
 134:Source/render/decoders/bmp.c ****         {
 135:Source/render/decoders/bmp.c ****             c->palette[i] = 0;
 136:Source/render/decoders/bmp.c ****         }
 137:Source/render/decoders/bmp.c ****     }
 138:Source/render/decoders/bmp.c **** }
