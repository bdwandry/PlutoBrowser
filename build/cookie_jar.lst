 116:Source/core/cookie_jar.c **** static int month_from_name(const char *s, size_t len)
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccyi5xij.s 			page 15


 117:Source/core/cookie_jar.c **** {
 118:Source/core/cookie_jar.c ****     /* Exact 3-letter names, case-sensitive (Lua table lookup semantics). */
 119:Source/core/cookie_jar.c ****     static const char *const months[12] = {"Jan", "Feb", "Mar", "Apr", "May", "Jun",
 120:Source/core/cookie_jar.c ****                                            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"};
 121:Source/core/cookie_jar.c ****     if (len != 3)
 122:Source/core/cookie_jar.c ****     {
 123:Source/core/cookie_jar.c ****         return 0;
 124:Source/core/cookie_jar.c ****     }
 125:Source/core/cookie_jar.c ****     for (int i = 0; i < 12; i++)
 126:Source/core/cookie_jar.c ****     {
 127:Source/core/cookie_jar.c ****         if (s[0] == months[i][0] && s[1] == months[i][1] && s[2] == months[i][2])
 128:Source/core/cookie_jar.c ****         {
 129:Source/core/cookie_jar.c ****             return i + 1;
 130:Source/core/cookie_jar.c ****         }
 131:Source/core/cookie_jar.c ****     }
 132:Source/core/cookie_jar.c ****     return 0;
 133:Source/core/cookie_jar.c **** }
 134:Source/core/cookie_jar.c **** 
 135:Source/core/cookie_jar.c **** static long long parse_digits(const char *s, size_t *pos)
 136:Source/core/cookie_jar.c **** {
 137:Source/core/cookie_jar.c ****     long long v = 0;
 138:Source/core/cookie_jar.c ****     int any = 0;
 139:Source/core/cookie_jar.c ****     while (s[*pos] >= '0' && s[*pos] <= '9')
 140:Source/core/cookie_jar.c ****     {
 141:Source/core/cookie_jar.c ****         v = v * 10 + (s[*pos] - '0');
 142:Source/core/cookie_jar.c ****         (*pos)++;
 143:Source/core/cookie_jar.c ****         any = 1;
 144:Source/core/cookie_jar.c ****     }
 145:Source/core/cookie_jar.c ****     return any ? v : -1;
 146:Source/core/cookie_jar.c **** }
 147:Source/core/cookie_jar.c **** 
 148:Source/core/cookie_jar.c **** static size_t skip_alpha(const char *s, size_t i)
 149:Source/core/cookie_jar.c **** {
 150:Source/core/cookie_jar.c ****     while ((s[i] >= 'a' && s[i] <= 'z') || (s[i] >= 'A' && s[i] <= 'Z'))
 151:Source/core/cookie_jar.c ****     {
 152:Source/core/cookie_jar.c ****         i++;
 153:Source/core/cookie_jar.c ****     }
 154:Source/core/cookie_jar.c ****     return i;
 155:Source/core/cookie_jar.c **** }
