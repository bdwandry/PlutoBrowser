 394:Source/core/cookie_jar.c **** static int name_char_ok(char c)
 395:Source/core/cookie_jar.c **** {
 396:Source/core/cookie_jar.c ****     /* Lua class: %w!#$%&'*+-.^_`|~ */
 397:Source/core/cookie_jar.c ****     if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))
 398:Source/core/cookie_jar.c ****     {
 399:Source/core/cookie_jar.c ****         return 1;
 400:Source/core/cookie_jar.c ****     }
 401:Source/core/cookie_jar.c ****     return strchr("!#$%&'*+-.^_`|~", c) != NULL && c != '\0';
 402:Source/core/cookie_jar.c **** }
