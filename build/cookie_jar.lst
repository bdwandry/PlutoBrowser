 309:Source/core/cookie_jar.c **** /* ── matching (mirror the Lua functions) ─────────────────�
 310:Source/core/cookie_jar.c **** 
 311:Source/core/cookie_jar.c **** static int domain_matches(const Cookie *c, const char *host)
 312:Source/core/cookie_jar.c **** {
 313:Source/core/cookie_jar.c ****     if (c->hostOnly)
 314:Source/core/cookie_jar.c ****     {
 315:Source/core/cookie_jar.c ****         return strcmp(host, c->domain) == 0;
 316:Source/core/cookie_jar.c ****     }
 317:Source/core/cookie_jar.c ****     size_t cdlen = strlen(c->domain);
 318:Source/core/cookie_jar.c ****     size_t hlen = strlen(host);
 319:Source/core/cookie_jar.c ****     if (strcmp(host, c->domain) == 0)
 320:Source/core/cookie_jar.c ****     {
 321:Source/core/cookie_jar.c ****         return 1;
 322:Source/core/cookie_jar.c ****     }
 323:Source/core/cookie_jar.c ****     if (hlen > cdlen + 1)
 324:Source/core/cookie_jar.c ****     {
 325:Source/core/cookie_jar.c ****         /* string.sub(host, -#cd - 1) == "." .. cd */
 326:Source/core/cookie_jar.c ****         return host[hlen - cdlen - 1] == '.' &&
 327:Source/core/cookie_jar.c ****                strcmp(host + hlen - cdlen, c->domain) == 0;
 328:Source/core/cookie_jar.c ****     }
 329:Source/core/cookie_jar.c ****     return 0;
 330:Source/core/cookie_jar.c **** }
 331:Source/core/cookie_jar.c **** 
 332:Source/core/cookie_jar.c **** static int path_matches(const Cookie *c, const char *reqPath)
 333:Source/core/cookie_jar.c **** {
 334:Source/core/cookie_jar.c ****     const char *cpath = c->path ? c->path : "/";
 335:Source/core/cookie_jar.c ****     const char *rp = reqPath ? reqPath : "/";
 336:Source/core/cookie_jar.c ****     size_t clen = strlen(cpath);
 337:Source/core/cookie_jar.c ****     if (strcmp(rp, cpath) == 0)
 338:Source/core/cookie_jar.c ****     {
 339:Source/core/cookie_jar.c ****         return 1;
 340:Source/core/cookie_jar.c ****     }
 341:Source/core/cookie_jar.c ****     if (strncmp(rp, cpath, clen) == 0)
 342:Source/core/cookie_jar.c ****     {
 343:Source/core/cookie_jar.c ****         char tail = rp[clen]; /* 0 at end-of-string == Lua's "" tail */
 344:Source/core/cookie_jar.c ****         if (clen > 0 && cpath[clen - 1] == '/')
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccyi5xij.s 			page 19


 345:Source/core/cookie_jar.c ****         {
 346:Source/core/cookie_jar.c ****             return 1;
 347:Source/core/cookie_jar.c ****         }
 348:Source/core/cookie_jar.c ****         if (tail == '/')
 349:Source/core/cookie_jar.c ****         {
 350:Source/core/cookie_jar.c ****             return 1;
 351:Source/core/cookie_jar.c ****         }
 352:Source/core/cookie_jar.c ****     }
 353:Source/core/cookie_jar.c ****     return 0;
 354:Source/core/cookie_jar.c **** }
