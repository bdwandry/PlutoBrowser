 356:Source/core/cookie_jar.c **** /* "H:"/"D:" .. domain .. "|" .. path|"/" .. "|" .. name */
 357:Source/core/cookie_jar.c **** static void cookie_key(const Cookie *c, char *out, size_t cap)
 358:Source/core/cookie_jar.c **** {
 359:Source/core/cookie_jar.c ****     snprintf(out, cap, "%c:%s|%s|%s",
 360:Source/core/cookie_jar.c ****              c->hostOnly ? 'H' : 'D',
 361:Source/core/cookie_jar.c ****              c->domain ? c->domain : "",
 362:Source/core/cookie_jar.c ****              c->path ? c->path : "/",
 363:Source/core/cookie_jar.c ****              c->name ? c->name : "");
 364:Source/core/cookie_jar.c **** }
