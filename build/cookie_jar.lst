  72:Source/core/cookie_jar.c ****     doe = yoe * 365 + fdiv_ll(yoe, 4) - fdiv_ll(yoe, 100) + doy;
  73:Source/core/cookie_jar.c ****     days = era * 146097 + doe - 719468;
  74:Source/core/cookie_jar.c **** 
