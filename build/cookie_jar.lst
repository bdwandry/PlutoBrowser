 516:src/core/cookie_jar.c ****         rp = "/";
 517:src/core/cookie_jar.c ****     }
 518:src/core/cookie_jar.c ****     if (strcmp(rp, cpath) == 0) {
 519:src/core/cookie_jar.c ****         return 1;
 520:src/core/cookie_jar.c ****     }
 521:src/core/cookie_jar.c ****     if (strncmp(rp, cpath, pl) != 0) {
