 157:Source/core/cookie_jar.c **** /* Parse an RFC 6265 Expires date (IMF-fixdate / RFC 850 / asctime) into epoch
 158:Source/core/cookie_jar.c ****  * seconds, or 0 if unrecognized. Separator rules are faithful to the Lua
 159:Source/core/cookie_jar.c ****  * string.match patterns (single literal spaces / dashes). */
 160:Source/core/cookie_jar.c **** static long long parse_date(const char *str)
 161:Source/core/cookie_jar.c **** {
 162:Source/core/cookie_jar.c ****     if (!str || !str[0])
 163:Source/core/cookie_jar.c ****     {
 164:Source/core/cookie_jar.c ****         return 0;
 165:Source/core/cookie_jar.c ****     }
 166:Source/core/cookie_jar.c ****     char t[128];
 167:Source/core/cookie_jar.c ****     trim(str, t, sizeof(t));
 168:Source/core/cookie_jar.c **** 
 169:Source/core/cookie_jar.c ****     size_t i = 0;
 170:Source/core/cookie_jar.c ****     long long d, y, h, mi, s;
 171:Source/core/cookie_jar.c ****     int mon;
 172:Source/core/cookie_jar.c ****     size_t a0;
 173:Source/core/cookie_jar.c **** 
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccyi5xij.s 			page 16


 174:Source/core/cookie_jar.c ****     /* Format 1: IMF-fixdate  "Wdy, DD Mon YYYY HH:MM:SS" */
 175:Source/core/cookie_jar.c ****     i = skip_alpha(t, 0);
 176:Source/core/cookie_jar.c ****     if (i > 0 && t[i] == ',' && t[i + 1] == ' ')
 177:Source/core/cookie_jar.c ****     {
 178:Source/core/cookie_jar.c ****         i += 2;
 179:Source/core/cookie_jar.c ****         d = parse_digits(t, &i);
 180:Source/core/cookie_jar.c ****         if (d >= 0 && t[i] == ' ')
 181:Source/core/cookie_jar.c ****         {
 182:Source/core/cookie_jar.c ****             i++;
 183:Source/core/cookie_jar.c ****             a0 = i;
 184:Source/core/cookie_jar.c ****             i = skip_alpha(t, i);
 185:Source/core/cookie_jar.c ****             mon = month_from_name(t + a0, i - a0);
 186:Source/core/cookie_jar.c ****             if (mon && t[i] == ' ')
 187:Source/core/cookie_jar.c ****             {
 188:Source/core/cookie_jar.c ****                 i++;
 189:Source/core/cookie_jar.c ****                 y = parse_digits(t, &i);
 190:Source/core/cookie_jar.c ****                 if (y >= 0 && t[i] == ' ')
 191:Source/core/cookie_jar.c ****                 {
 192:Source/core/cookie_jar.c ****                     i++;
 193:Source/core/cookie_jar.c ****                     h = parse_digits(t, &i);
 194:Source/core/cookie_jar.c ****                     if (h >= 0 && t[i] == ':')
 195:Source/core/cookie_jar.c ****                     {
 196:Source/core/cookie_jar.c ****                         i++;
 197:Source/core/cookie_jar.c ****                         mi = parse_digits(t, &i);
 198:Source/core/cookie_jar.c ****                         if (mi >= 0 && t[i] == ':')
 199:Source/core/cookie_jar.c ****                         {
 200:Source/core/cookie_jar.c ****                             i++;
 201:Source/core/cookie_jar.c ****                             s = parse_digits(t, &i);
 202:Source/core/cookie_jar.c ****                             if (s >= 0)
 203:Source/core/cookie_jar.c ****                             {
 204:Source/core/cookie_jar.c ****                                 return make_timestamp(y, mon, d, h, mi, s);
 205:Source/core/cookie_jar.c ****                             }
 206:Source/core/cookie_jar.c ****                         }
 207:Source/core/cookie_jar.c ****                     }
 208:Source/core/cookie_jar.c ****                 }
 209:Source/core/cookie_jar.c ****             }
 210:Source/core/cookie_jar.c ****         }
 211:Source/core/cookie_jar.c ****         /* fall through: same "Wdy, " prefix is also RFC 850's */
 212:Source/core/cookie_jar.c ****     }
