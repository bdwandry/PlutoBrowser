 265:Source/core/cookie_jar.c **** // RFC 2616 token chars allowed in cookie names.
 266:Source/core/cookie_jar.c **** static int token_char(unsigned char c)
 267:Source/core/cookie_jar.c **** {
 268:Source/core/cookie_jar.c ****     if ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') ||
 269:Source/core/cookie_jar.c ****         (c >= 'A' && c <= 'Z')) {
 270:Source/core/cookie_jar.c ****         return 1;
 271:Source/core/cookie_jar.c ****     }
 272:Source/core/cookie_jar.c ****     switch (c) {
 273:Source/core/cookie_jar.c ****         case '!': case '#': case '$': case '%': case '&': case '\'':
 274:Source/core/cookie_jar.c ****         case '*': case '+': case '-': case '.': case '^': case '_':
 275:Source/core/cookie_jar.c ****         case '`': case '|': case '~':
 276:Source/core/cookie_jar.c ****             return 1;
 277:Source/core/cookie_jar.c ****         default:
 278:Source/core/cookie_jar.c ****             return 0;
 279:Source/core/cookie_jar.c ****     }
 280:Source/core/cookie_jar.c **** }
