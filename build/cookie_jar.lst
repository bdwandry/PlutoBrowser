 249:Source/core/cookie_jar.c **** static int ascii_isspace_ch(unsigned char c)
 250:Source/core/cookie_jar.c **** {
 251:Source/core/cookie_jar.c ****     return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' ||
 252:Source/core/cookie_jar.c ****            c == '\v';
 253:Source/core/cookie_jar.c **** }
