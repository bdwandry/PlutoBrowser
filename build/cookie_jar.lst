 255:Source/core/cookie_jar.c **** static void trim_span_buf(char* buf, size_t* len)
 256:Source/core/cookie_jar.c **** {
 257:Source/core/cookie_jar.c ****     size_t s = 0, e = *len;
 258:Source/core/cookie_jar.c ****     while (s < e && ascii_isspace_ch((unsigned char)buf[s])) s++;
 259:Source/core/cookie_jar.c ****     while (e > s && ascii_isspace_ch((unsigned char)buf[e - 1])) e--;
 260:Source/core/cookie_jar.c ****     if (s > 0 && e > s) memmove(buf, buf + s, e - s);
 261:Source/core/cookie_jar.c ****     buf[e - s] = '\0';
 262:Source/core/cookie_jar.c ****     *len = e - s;
 263:Source/core/cookie_jar.c **** }
