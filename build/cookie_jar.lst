 100:Source/core/cookie_jar.c **** static int cap_copy(const char* subj, const LPCap caps[], int ncaps, int i,
 101:Source/core/cookie_jar.c ****                     char* out, size_t outSz)
 102:Source/core/cookie_jar.c **** {
 103:Source/core/cookie_jar.c ****     size_t cs, cl;
