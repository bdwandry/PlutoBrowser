 495:src/core/cookie_jar.c **** {
 496:src/core/cookie_jar.c ****     size_t hl = strlen(host), dl = strlen(domain);
 497:src/core/cookie_jar.c ****     if (strcmp(host, domain) == 0) {
 498:src/core/cookie_jar.c ****         return 1;
 499:src/core/cookie_jar.c ****     }
 500:src/core/cookie_jar.c ****     return hl > dl && host[hl - dl - 1] == '.' &&
 501:src/core/cookie_jar.c ****            strcmp(host + hl - dl, domain) == 0;
 502:src/core/cookie_jar.c **** }
 503:src/core/cookie_jar.c **** 
 504:src/core/cookie_jar.c **** static int domain_matches(const PlutoCookie* c, const char* host)
 505:src/core/cookie_jar.c **** {
 506:src/core/cookie_jar.c ****     if (c->hostOnly) {
 507:src/core/cookie_jar.c ****         return strcmp(host, c->domain) == 0;
 508:src/core/cookie_jar.c ****     }
 509:src/core/cookie_jar.c ****     return host_matches_domain(host, c->domain);
 510:src/core/cookie_jar.c **** }
