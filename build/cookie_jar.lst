 269:src/core/cookie_jar.c ****         (c >= 'A' && c <= 'Z')) {
 270:src/core/cookie_jar.c ****         return 1;
 271:src/core/cookie_jar.c ****     }
 272:src/core/cookie_jar.c ****     switch (c) {
 273:src/core/cookie_jar.c ****         case '!': case '#': case '$': case '%': case '&': case '\'':
 274:src/core/cookie_jar.c ****         case '*': case '+': case '-': case '.': case '^': case '_':
 275:src/core/cookie_jar.c ****         case '`': case '|': case '~':
 276:src/core/cookie_jar.c ****             return 1;
 277:src/core/cookie_jar.c ****         default:
 278:src/core/cookie_jar.c ****             return 0;
 279:src/core/cookie_jar.c ****     }
 280:src/core/cookie_jar.c **** }
