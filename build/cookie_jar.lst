  51:Source/core/cookie_jar.c ****                          double minute, double second)
  52:Source/core/cookie_jar.c **** {
  53:Source/core/cookie_jar.c ****     long long Y, M, D, y, era, yoe, mp, doy, doe, days;
  54:Source/core/cookie_jar.c **** 
  55:Source/core/cookie_jar.c ****     if (year < 0.0) year = 0.0;
  56:Source/core/cookie_jar.c ****     year = (double)(long long)year; // math.floor (values >= 0 here)
