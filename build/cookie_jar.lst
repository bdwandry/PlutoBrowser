 494:Source/core/cookie_jar.c **** static int host_matches_domain(const char* host, const char* domain)
 495:Source/core/cookie_jar.c **** {
 496:Source/core/cookie_jar.c ****     size_t hl = strlen(host), dl = strlen(domain);
 497:Source/core/cookie_jar.c ****     if (strcmp(host, domain) == 0) {
 498:Source/core/cookie_jar.c ****         return 1;
 499:Source/core/cookie_jar.c ****     }
 500:Source/core/cookie_jar.c ****     return hl > dl && host[hl - dl - 1] == '.' &&
 501:Source/core/cookie_jar.c ****            strcmp(host + hl - dl, domain) == 0;
 502:Source/core/cookie_jar.c **** }
 503:Source/core/cookie_jar.c **** 
 504:Source/core/cookie_jar.c **** static int domain_matches(const PlutoCookie* c, const char* host)
 505:Source/core/cookie_jar.c **** {
 506:Source/core/cookie_jar.c ****     if (c->hostOnly) {
 507:Source/core/cookie_jar.c ****         return strcmp(host, c->domain) == 0;
 508:Source/core/cookie_jar.c ****     }
 509:Source/core/cookie_jar.c ****     return host_matches_domain(host, c->domain);
 510:Source/core/cookie_jar.c **** }
 511:Source/core/cookie_jar.c **** 
 512:Source/core/cookie_jar.c **** static int path_matches(const char* cpath, const char* rp)
 513:Source/core/cookie_jar.c **** {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc1FQvh7.s 			page 13


 514:Source/core/cookie_jar.c ****     size_t pl = strlen(cpath);
 515:Source/core/cookie_jar.c ****     if (rp == NULL || rp[0] == '\0') {
 516:Source/core/cookie_jar.c ****         rp = "/";
 517:Source/core/cookie_jar.c ****     }
 518:Source/core/cookie_jar.c ****     if (strcmp(rp, cpath) == 0) {
 519:Source/core/cookie_jar.c ****         return 1;
 520:Source/core/cookie_jar.c ****     }
 521:Source/core/cookie_jar.c ****     if (strncmp(rp, cpath, pl) != 0) {
 522:Source/core/cookie_jar.c ****         return 0;
 523:Source/core/cookie_jar.c ****     }
 524:Source/core/cookie_jar.c ****     if (pl > 0 && cpath[pl - 1] == '/') {
 525:Source/core/cookie_jar.c ****         return 1;
 526:Source/core/cookie_jar.c ****     }
 527:Source/core/cookie_jar.c ****     return rp[pl] == '/';
 528:Source/core/cookie_jar.c **** }
 529:Source/core/cookie_jar.c **** 
 530:Source/core/cookie_jar.c **** static void build_key(const PlutoCookie* c, StrBuf* out)
 531:Source/core/cookie_jar.c **** {
 532:Source/core/cookie_jar.c ****     sb_append_str(out, c->hostOnly ? "H:" : "D:");
 533:Source/core/cookie_jar.c ****     sb_append_str(out, c->domain);
 534:Source/core/cookie_jar.c ****     sb_append_char(out, '|');
 535:Source/core/cookie_jar.c ****     sb_append_str(out, c->path[0] != '\0' ? c->path : "/");
 536:Source/core/cookie_jar.c ****     sb_append_char(out, '|');
 537:Source/core/cookie_jar.c ****     sb_append_str(out, c->name);
 538:Source/core/cookie_jar.c **** }
