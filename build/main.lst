 422:Source/main.c **** 
 423:Source/main.c ****         /* detailsOpen overrides for toggle re-renders. */
 424:Source/main.c ****         DocParseOpts opts;
 425:Source/main.c ****         memset(&opts, 0, sizeof(opts));
 426:Source/main.c ****         if (rt->isToggle && detailsKeyCount > 0)
 427:Source/main.c ****         {
