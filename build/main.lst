1893:Source/main.c ****     }
1894:Source/main.c **** 
1895:Source/main.c ****     /* Draw mouse cursor as the very last thing so nothing can draw over it
1896:Source/main.c ****      * (Lua main.lua: white-filled triangle + black outline + inner line). */
1897:Source/main.c ****     if (currentState == STATE_PAGE && currentBrowseMode == MODE_RAW_HTML)
1898:Source/main.c ****     {
