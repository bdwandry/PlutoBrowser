 653:Source/main.c ****     {
 654:Source/main.c ****         currentState = STATE_HOME;
 655:Source/main.c ****         if (!currentUrlObj)
 656:Source/main.c ****         {
 657:Source/main.c ****             currentUrlObj = (UrlParsed *)malloc(sizeof(UrlParsed));
 658:Source/main.c ****         }
