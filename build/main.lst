 639:Source/main.c ****     char *trimmed = strutil_trim_dup(unwrapped ? unwrapped : urlString);
 640:Source/main.c ****     pluto_free(unwrapped);
 641:Source/main.c ****     snprintf(urlBuf, sizeof(urlBuf), "%s", trimmed ? trimmed : urlString);
 642:Source/main.c ****     pluto_free(trimmed);
 643:Source/main.c **** 
 644:Source/main.c ****     /* Reset per-navigation state (Lua runNavigation). The old layout items
 645:Source/main.c ****      * (with their owned values) are freed by layout_clear during the render
 646:Source/main.c ****      * task, so no form-value cleanup is needed here. */
 647:Source/main.c ****     formInputItem = NULL;
 648:Source/main.c ****     formKeyboardOpen = 0;
 649:Source/main.c ****     imgdec_clear_cache();
