 937:Source/main.c ****         int n = block->optionCount;
 938:Source/main.c ****         if (n > 0)
 939:Source/main.c ****         {
 940:Source/main.c ****             int tries = n + 1;
 941:Source/main.c ****             while (tries > 0)
 942:Source/main.c ****             {
 943:Source/main.c ****                 block->selectedIndex = (block->selectedIndex % n) + 1;
 944:Source/main.c ****                 DocOption *opt = block->options[block->selectedIndex - 1];
 945:Source/main.c ****                 if (opt && !opt->disabled && !opt->group)
 946:Source/main.c ****                 {
 947:Source/main.c ****                     break;
 948:Source/main.c ****                 }
 949:Source/main.c ****                 tries--;
 950:Source/main.c ****             }
 951:Source/main.c ****         }
 952:Source/main.c ****         layout_set_selected_input(item);
 953:Source/main.c ****         break;
 954:Source/main.c ****     }
 955:Source/main.c ****     default:
