1895:Source/main.c ****                                    kColorWhite);
1896:Source/main.c ****         /* Lua gfx.drawTriangle has no C equivalent: draw the 3 edges with
1897:Source/main.c ****          * width 1 (Lua's default line width) via drawLine. */
