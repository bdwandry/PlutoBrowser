 545:Source/main.c **** static void render_error(const char *message, void *userdata)
 546:Source/main.c **** {
 547:Source/main.c ****     /* tasks.c passes the task's data pointer as "message" — ignore it and use
 548:Source/main.c ****      * the static error buffer set by render_step. */
 549:Source/main.c ****     (void)message;
 550:Source/main.c ****     RenderTask *rt = (RenderTask *)userdata;
 551:Source/main.c ****     isRendering = 0;
 552:Source/main.c ****     if (rt)
 553:Source/main.c ****     {
 554:Source/main.c ****         if (rt->isToggle)
 555:Source/main.c ****         {
 556:Source/main.c ****             /* Lua: undo the toggle flip on error. */
 557:Source/main.c ****             if (detailsKeyCount > 0)
 558:Source/main.c ****             {
 559:Source/main.c ****                 detailsOpenState[detailsKeyCount - 1] =
 560:Source/main.c ****                     !detailsOpenState[detailsKeyCount - 1];
 561:Source/main.c ****             }
 562:Source/main.c ****         }
 563:Source/main.c ****         if (rt->body)
 564:Source/main.c ****         {
 565:Source/main.c ****             pluto_free(rt->body);
 566:Source/main.c ****         }
 567:Source/main.c ****         if (rt->doc)
 568:Source/main.c ****         {
 569:Source/main.c ****             document_free(rt->doc);
 570:Source/main.c ****             free(rt->doc);
 571:Source/main.c ****         }
 572:Source/main.c ****         free(rt);
 573:Source/main.c ****     }
 574:Source/main.c ****     error_page_show(g_renderErrMsg, currentUrlObj ? currentUrlObj->normalized : "");
 575:Source/main.c ****     currentState = STATE_ERROR;
 576:Source/main.c ****     snprintf(pageTitle, sizeof(pageTitle), "Render Error");
 577:Source/main.c ****     update_system_menu();
 578:Source/main.c **** }
