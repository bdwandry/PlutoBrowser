 194:Source/main.c ****     }
 195:Source/main.c ****     else
 196:Source/main.c ****     {
 197:Source/main.c ****         /* Lua: table.remove(navHistory, 1) then insert; index shifts down. */
 198:Source/main.c ****         pluto_free(navHistory[0]);
 199:Source/main.c ****         memmove(&navHistory[0], &navHistory[1], sizeof(char *) * (MAX_HISTORY - 1));
 200:Source/main.c ****         navHistory[MAX_HISTORY - 1] = pluto_strdup(urlString);
 201:Source/main.c ****         historyIndex = MAX_HISTORY;
 202:Source/main.c ****     }
 203:Source/main.c **** }
 204:Source/main.c **** 
 205:Source/main.c **** static const char *go_back(void)
 206:Source/main.c **** {
 207:Source/main.c ****     if (historyIndex > 1)
 208:Source/main.c ****     {
 209:Source/main.c ****         historyIndex--;
 210:Source/main.c ****         navigatingHistory = 1;
 211:Source/main.c ****         return navHistory[historyIndex - 1];
 212:Source/main.c ****     }
 213:Source/main.c ****     return NULL;
 214:Source/main.c **** }
 215:Source/main.c **** 
 216:Source/main.c **** static const char *go_forward(void)
 217:Source/main.c **** {
