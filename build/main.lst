 559:src/main.c    ****         long cur = 0, tot = 0;
 560:src/main.c    **** 
 561:src/main.c    ****         switch (s_p27Scenario % 5) {
 562:src/main.c    ****         case 0:
 563:src/main.c    ****             strcpy(demo.scheme, "https");
