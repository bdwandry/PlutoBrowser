 619:Source/main.c **** /* runNavigation + executeNavigation (port). */
 620:Source/main.c **** static void navigate_to(const char *urlString)
 621:Source/main.c **** {
 622:Source/main.c ****     if (!urlString || !urlString[0])
 623:Source/main.c ****     {
 624:Source/main.c ****         return;
 625:Source/main.c ****     }
 626:Source/main.c **** 
 627:Source/main.c ****     /* Any still-running parse/render of a previous page must be dropped;
 628:Source/main.c ****      * its onComplete would otherwise fire later and hijack the new page. */
 629:Source/main.c ****     tasks_cancel_all();
 630:Source/main.c ****     isRendering = 0;
 631:Source/main.c ****     /* Drop the previous page's layout (borrows doc strings) before the doc
 632:Source/main.c ****      * is freed on the next render_done. */
 633:Source/main.c ****     layout_clear();
 634:Source/main.c **** 
