 164:Source/main.c **** /* Navigation history stack (port of navHistory/historyIndex, MAX_HISTORY=30). */
 165:Source/main.c **** #define MAX_HISTORY 30
 166:Source/main.c **** static char *navHistory[MAX_HISTORY];
 167:Source/main.c **** static int navHistoryCount = 0;
 168:Source/main.c **** static int historyIndex = 0; /* 1-based (Lua parity); 0 = empty */
 169:Source/main.c **** 
 170:Source/main.c **** static void push_history(const char *urlString)
 171:Source/main.c **** {
 172:Source/main.c ****     if (!urlString || !urlString[0])
 173:Source/main.c ****     {
 174:Source/main.c ****         return;
 175:Source/main.c ****     }
 176:Source/main.c ****     if (historyIndex < navHistoryCount)
 177:Source/main.c ****     {
 178:Source/main.c ****         /* Navigating somewhere new clears the forward entries. */
 179:Source/main.c ****         for (int i = historyIndex; i < navHistoryCount; i++)
 180:Source/main.c ****         {
 181:Source/main.c ****             pluto_free(navHistory[i]);
 182:Source/main.c ****         }
 183:Source/main.c ****         navHistoryCount = historyIndex;
 184:Source/main.c ****     }
 185:Source/main.c ****     if (navHistoryCount > 0 &&
 186:Source/main.c ****         strcmp(navHistory[navHistoryCount - 1], urlString) == 0)
 187:Source/main.c ****     {
 188:Source/main.c ****         return; /* Lua: top-of-stack duplicate is dropped */
 189:Source/main.c ****     }
 190:Source/main.c ****     if (navHistoryCount < MAX_HISTORY)
 191:Source/main.c ****     {
 192:Source/main.c ****         navHistory[navHistoryCount++] = pluto_strdup(urlString);
 193:Source/main.c ****         historyIndex = navHistoryCount;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccw1hsgF.s 			page 6


 194:Source/main.c ****     }
 195:Source/main.c ****     else
 196:Source/main.c ****     {
 197:Source/main.c ****         /* Lua: table.remove(navHistory, 1) then insert; index shifts down. */
 198:Source/main.c ****         pluto_free(navHistory[0]);
 199:Source/main.c ****         memmove(&navHistory[0], &navHistory[1], sizeof(char *) * (MAX_HISTORY - 1));
 200:Source/main.c ****         navHistory[MAX_HISTORY - 1] = pluto_strdup(urlString);
 201:Source/main.c ****         historyIndex = MAX_HISTORY;
 202:Source/main.c ****     }
 203:Source/main.c **** }
 204:Source/main.c **** 
 205:Source/main.c **** static const char *go_back(void)
 206:Source/main.c **** {
 207:Source/main.c ****     if (historyIndex > 1)
 208:Source/main.c ****     {
 209:Source/main.c ****         historyIndex--;
 210:Source/main.c ****         navigatingHistory = 1;
 211:Source/main.c ****         return navHistory[historyIndex - 1];
 212:Source/main.c ****     }
 213:Source/main.c ****     return NULL;
 214:Source/main.c **** }
 215:Source/main.c **** 
 216:Source/main.c **** static const char *go_forward(void)
 217:Source/main.c **** {
 218:Source/main.c ****     if (historyIndex < navHistoryCount)
 219:Source/main.c ****     {
 220:Source/main.c ****         historyIndex++;
 221:Source/main.c ****         navigatingHistory = 1;
 222:Source/main.c ****         return navHistory[historyIndex - 1];
 223:Source/main.c ****     }
 224:Source/main.c ****     return NULL;
 225:Source/main.c **** }
