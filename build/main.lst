 620:Source/main.c **** /* runNavigation + executeNavigation (port). */
 621:Source/main.c **** static void navigate_to(const char *urlString)
 622:Source/main.c **** {
 623:Source/main.c ****     if (!urlString || !urlString[0])
 624:Source/main.c ****     {
 625:Source/main.c ****         return;
 626:Source/main.c ****     }
 627:Source/main.c **** 
 628:Source/main.c ****     /* Any still-running parse/render of a previous page must be dropped;
 629:Source/main.c ****      * its onComplete would otherwise fire later and hijack the new page. */
 630:Source/main.c ****     tasks_cancel_all();
 631:Source/main.c ****     isRendering = 0;
