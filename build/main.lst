 684:Source/main.c ****             if (engine < 0 || engine >= SEARCH_ENGINE_COUNT)
 685:Source/main.c ****             {
 686:Source/main.c ****                 engine = 0;
 687:Source/main.c ****             }
 688:Source/main.c ****             char *full = url_build_search_url(SEARCH_ENGINES[engine].url, urlBuf);
 689:Source/main.c ****             if (full)
 690:Source/main.c ****             {
 691:Source/main.c ****                 snprintf(urlBuf, sizeof(urlBuf), "%s", full);
 692:Source/main.c ****                 pluto_free(full);
 693:Source/main.c ****             }
 694:Source/main.c ****         }
 695:Source/main.c ****         else
