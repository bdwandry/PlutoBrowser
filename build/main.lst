 561:Source/main.c ****                     !detailsOpenState[detailsKeyCount - 1];
 562:Source/main.c ****             }
 563:Source/main.c ****         }
 564:Source/main.c ****         if (rt->body)
 565:Source/main.c ****         {
 566:Source/main.c ****             pluto_free(rt->body);
 567:Source/main.c ****         }
 568:Source/main.c ****         if (rt->doc)
 569:Source/main.c ****         {
 570:Source/main.c ****             document_free(rt->doc);
 571:Source/main.c ****             free(rt->doc);
 572:Source/main.c ****         }
 573:Source/main.c ****         free(rt);
 574:Source/main.c ****     }
 575:Source/main.c ****     error_page_show(g_renderErrMsg, currentUrlObj ? currentUrlObj->normalized : "");
 576:Source/main.c ****     currentState = STATE_ERROR;
 577:Source/main.c ****     snprintf(pageTitle, sizeof(pageTitle), "Render Error");
 578:Source/main.c ****     update_system_menu();
 579:Source/main.c **** }
