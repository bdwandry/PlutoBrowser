 422:Source/main.c **** 
 423:Source/main.c ****         /* detailsOpen overrides for toggle re-renders. */
 424:Source/main.c ****         DocParseOpts opts;
 425:Source/main.c ****         memset(&opts, 0, sizeof(opts));
 426:Source/main.c ****         if (rt->isToggle && detailsKeyCount > 0)
 427:Source/main.c ****         {
 428:Source/main.c ****             opts.detailsOpen = detailsOpenState;
 429:Source/main.c ****             opts.detailsOpenCount = detailsKeyCount;
 430:Source/main.c ****         }
 431:Source/main.c ****         opts.svgDecoder = app_svg_decoder;
 432:Source/main.c **** 
 433:Source/main.c ****         int rc = document_parse(rt->body, rt->url, currentBrowseMode,
 434:Source/main.c ****                                 rt->isToggle ? &opts : NULL, rt->doc);
 435:Source/main.c ****         if (rc != 0 || rt->doc->parseError)
 436:Source/main.c ****         {
 437:Source/main.c ****             snprintf(g_renderErrMsg, sizeof(g_renderErrMsg),
 438:Source/main.c ****                      "Parse Error: parse failed");
 439:Source/main.c ****             return -1;
 440:Source/main.c ****         }
 441:Source/main.c ****         tasks_report_progress(0.6f);
 442:Source/main.c ****         return 1; /* more work: layout next tick */
 443:Source/main.c ****     }
 444:Source/main.c **** 
 445:Source/main.c ****     /* Layout step. */
 446:Source/main.c ****     layout_build(rt->doc);
 447:Source/main.c ****     if (layout_build_failed())
 448:Source/main.c ****     {
 449:Source/main.c ****         snprintf(g_renderErrMsg, sizeof(g_renderErrMsg),
 450:Source/main.c ****                  "Layout Error: invalid table width (percent not supported)");
 451:Source/main.c ****         return -1;
 452:Source/main.c ****     }
 453:Source/main.c ****     tasks_report_progress(1.0f);
 454:Source/main.c ****     return 0;
 455:Source/main.c **** }
