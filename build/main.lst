 641:Source/main.c ****     char *trimmed = strutil_trim_dup(unwrapped ? unwrapped : urlString);
 642:Source/main.c ****     pluto_free(unwrapped);
 643:Source/main.c ****     snprintf(urlBuf, sizeof(urlBuf), "%s", trimmed ? trimmed : urlString);
 644:Source/main.c ****     pluto_free(trimmed);
 645:Source/main.c **** 
