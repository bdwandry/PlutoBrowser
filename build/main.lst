 768:Source/main.c **** static void toggle_details(const char *dkey)
 769:Source/main.c **** {
 770:Source/main.c ****     if (!currentDoc || !currentDoc->rawHtml || !currentDoc->rawHtml[0] || isRendering)
 771:Source/main.c ****     {
 772:Source/main.c ****         return;
 773:Source/main.c ****     }
 774:Source/main.c ****     int idx = details_key_index(dkey);
 775:Source/main.c ****     if (idx < 0)
 776:Source/main.c ****     {
 777:Source/main.c ****         return;
 778:Source/main.c ****     }
