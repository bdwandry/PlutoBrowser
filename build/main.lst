 805:Source/main.c **** /* ── Form input values ───────────────────────�
 806:Source/main.c ****  * Lua input items alias the block table, so openKeyboardForInput's
 807:Source/main.c ****  * activeInputField.value = entered made typed text visible to BOTH the
 808:Source/main.c ****  * renderer and the submit path. In C the LayoutItem and DocBlock are separate
 809:Source/main.c ****  * structs, so the typed text lives on the item itself (owned heap copy set
 810:Source/main.c ****  * through layout_set_input_value; freed by layout_clear). form_item_value()
 811:Source/main.c ****  * therefore just reads the item's current value. */
 812:Source/main.c **** static void form_set_block_value(const LayoutItem *item, const char *text)
 813:Source/main.c **** {
 814:Source/main.c ****     layout_set_input_value(item, text);
 815:Source/main.c **** }
 816:Source/main.c **** 
 817:Source/main.c **** /* Effective value for an input item (live typed value > block value). */
 818:Source/main.c **** static const char *form_item_value(const LayoutItem *item)
 819:Source/main.c **** {
 820:Source/main.c ****     return item && item->value ? item->value : "";
 821:Source/main.c **** }
 822:Source/main.c **** 
 823:Source/main.c **** /* ── Form input keyboard (port of openKeyboardForInput) ────────────�
 824:Source/main.c **** static void open_keyboard_for_input(const LayoutItem *item)
 825:Source/main.c **** {
 826:Source/main.c ****     if (!item || !g_kb)
 827:Source/main.c ****     {
 828:Source/main.c ****         return;
 829:Source/main.c ****     }
 830:Source/main.c ****     formInputItem = item;
 831:Source/main.c ****     formKeyboardOpen = 1;
 832:Source/main.c ****     layout_set_selected_input(item); /* Lua: Layout.selectedInputItem = block */
 833:Source/main.c ****     keyboardApi.setKeyboardWillHideCallback(g_kb, form_kb_will_hide, NULL);
 834:Source/main.c ****     keyboardApi.setKeyboardDidHideCallback(g_kb, form_kb_did_hide, NULL);
 835:Source/main.c ****     keyboardApi.setTextChangedCallback(g_kb, form_kb_text_changed, NULL);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccr1bG3O.s 			page 18


 836:Source/main.c ****     keyboardApi.show(g_kb, item->value ? item->value : "",
 837:Source/main.c ****                      (unsigned int)(item->value ? strlen(item->value) : 0));
 838:Source/main.c **** }
