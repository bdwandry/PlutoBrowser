 733:Source/main.c **** static void http_on_success(int status, char **headerKeys, char **headerVals,
 734:Source/main.c ****                             int headerCount, const char *body, size_t bodyLen,
 735:Source/main.c ****                             const char *url)
 736:Source/main.c **** {
 737:Source/main.c ****     (void)status;
 738:Source/main.c ****     const char *contentType = NULL;
 739:Source/main.c ****     for (int i = 0; i < headerCount; i++)
 740:Source/main.c ****     {
 741:Source/main.c ****         if (headerKeys && headerKeys[i] && headerVals &&
 742:Source/main.c ****             strcmp(headerKeys[i], "content-type") == 0)
 743:Source/main.c ****         {
 744:Source/main.c ****             contentType = headerVals[i];
 745:Source/main.c ****             break;
 746:Source/main.c ****         }
 747:Source/main.c ****     }
 748:Source/main.c ****     /* Lua: body = Encoding.toUtf8(body, headers["content-type"]). */
 749:Source/main.c ****     char *utf8 = encoding_to_utf8((const unsigned char *)body,
 750:Source/main.c ****                                   body ? strlen(body) : 0, contentType);
 751:Source/main.c ****     render_body(utf8 ? utf8 : (body ? body : ""), url, 1);
 752:Source/main.c ****     if (utf8)
 753:Source/main.c ****     {
 754:Source/main.c ****         pluto_free(utf8);
 755:Source/main.c ****     }
 756:Source/main.c **** }
 757:Source/main.c **** 
