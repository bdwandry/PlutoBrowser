 457:Source/main.c **** static void render_done(void *result, void *userdata)
 458:Source/main.c **** {
 459:Source/main.c ****     RenderTask *rt = (RenderTask *)userdata;
 460:Source/main.c ****     (void)result;
 461:Source/main.c ****     if (!rt)
 462:Source/main.c ****     {
 463:Source/main.c ****         return;
 464:Source/main.c ****     }
