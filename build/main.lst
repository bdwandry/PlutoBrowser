 479:Source/main.c ****     {
 480:Source/main.c ****         scrollY = rt->prevScroll;
 481:Source/main.c ****         targetScrollY = rt->prevTarget;
 482:Source/main.c ****     }
 483:Source/main.c ****     else
 484:Source/main.c ****     {
 485:Source/main.c ****         scrollY = 0;
 486:Source/main.c ****         targetScrollY = 0;
 487:Source/main.c ****     }
 488:Source/main.c ****     crankVelocity = 0;
 489:Source/main.c ****     currentState = STATE_PAGE;
 490:Source/main.c ****     if (rt->addToHistory)
 491:Source/main.c ****     {
 492:Source/main.c ****         storage_add_history(pageTitle, rt->url);
 493:Source/main.c ****     }
 494:Source/main.c ****     update_system_menu();
 495:Source/main.c **** 
 496:Source/main.c ****     /* Enqueue images per the image mode setting (Lua: IMAGE_MODE_ALL). */
 497:Source/main.c ****     {
 498:Source/main.c ****         const char *im = storage_setting_str("imageMode");
 499:Source/main.c ****         int imgMode = IMAGE_MODE_ALL;
 500:Source/main.c ****         for (int m = 0; m < IMAGE_MODE_COUNT; m++)
 501:Source/main.c ****         {
 502:Source/main.c ****             if (im && strcmp(im, IMAGE_MODE_NAMES[m]) == 0)
 503:Source/main.c ****             {
 504:Source/main.c ****                 imgMode = m;
 505:Source/main.c ****                 break;
 506:Source/main.c ****             }
 507:Source/main.c ****         }
 508:Source/main.c ****         if (imgMode == IMAGE_MODE_ALL && currentDoc)
 509:Source/main.c ****         {
 510:Source/main.c ****             for (int bi = 0; bi < currentDoc->blockCount; bi++)
 511:Source/main.c ****             {
 512:Source/main.c ****                 DocBlock *blk = currentDoc->blocks[bi];
 513:Source/main.c ****                 if (blk->type == DOC_BLOCK_IMAGE && blk->src && blk->src[0])
 514:Source/main.c ****                 {
 515:Source/main.c ****                     imgdec_enqueue(blk->src);
 516:Source/main.c ****                 }
 517:Source/main.c ****             }
 518:Source/main.c ****         }
 519:Source/main.c ****     }
 520:Source/main.c **** 
 521:Source/main.c ****     /* Auto-redirect for <meta http-equiv="refresh">. */
 522:Source/main.c ****     if (currentDoc && currentDoc->metaRefresh.present && currentDoc->metaRefresh.delay >= 0)
 523:Source/main.c ****     {
 524:Source/main.c ****         const char *redirectUrl = currentDoc->metaRefresh.url[0]
 525:Source/main.c ****                                       ? currentDoc->metaRefresh.url
 526:Source/main.c ****                                       : rt->url;
 527:Source/main.c ****         int redirectDelay = (int)(currentDoc->metaRefresh.delay * 1000.0f);
 528:Source/main.c ****         if (redirectDelay < 0)
 529:Source/main.c ****         {
 530:Source/main.c ****             redirectDelay = 0;
 531:Source/main.c ****         }
 532:Source/main.c ****         /* Capture the URL in a heap holder for the timer callback. */
 533:Source/main.c ****         char *urlCopy = pluto_strdup(redirectUrl);
 534:Source/main.c ****         if (urlCopy)
 535:Source/main.c ****         {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc7OxaNJ.s 			page 12


 536:Source/main.c ****             pdtimer_perform_after_delay(pd, (unsigned int)redirectDelay,
 537:Source/main.c ****                                         meta_refresh_cb, urlCopy);
 538:Source/main.c ****         }
 539:Source/main.c ****     }
 540:Source/main.c **** 
 541:Source/main.c ****     pluto_free(rt->body);
 542:Source/main.c ****     free(rt);
 543:Source/main.c **** }
