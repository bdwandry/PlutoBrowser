 228:Source/main.c **** /* detailsOpenSet key bookkeeping: find or add "d<N>", return index. */
 229:Source/main.c **** static int details_key_index(const char *dkey)
 230:Source/main.c **** {
 231:Source/main.c ****     if (!dkey)
 232:Source/main.c ****     {
 233:Source/main.c ****         return -1;
 234:Source/main.c ****     }
 235:Source/main.c ****     for (int i = 0; i < detailsKeyCount; i++)
 236:Source/main.c ****     {
 237:Source/main.c ****         if (strcmp(detailsKeys[i], dkey) == 0)
 238:Source/main.c ****         {
 239:Source/main.c ****             return i;
 240:Source/main.c ****         }
 241:Source/main.c ****     }
 242:Source/main.c ****     if (detailsKeyCount < 64)
 243:Source/main.c ****     {
 244:Source/main.c ****         detailsKeys[detailsKeyCount] = pluto_strdup(dkey);
 245:Source/main.c ****         detailsOpenState[detailsKeyCount] = 0;
 246:Source/main.c ****         return detailsKeyCount++;
 247:Source/main.c ****     }
 248:Source/main.c ****     return -1;
 249:Source/main.c **** }
