 621:Source/main.c **** /* runNavigation + executeNavigation (port). */
 622:Source/main.c **** static void navigate_to(const char *urlString)
 623:Source/main.c **** {
 624:Source/main.c ****     if (!urlString || !urlString[0])
 625:Source/main.c ****     {
 626:Source/main.c ****         return;
 627:Source/main.c ****     }
 628:Source/main.c **** 
 629:Source/main.c ****     /* Any still-running parse/render of a previous page must be dropped;
 630:Source/main.c ****      * its onComplete would otherwise fire later and hijack the new page. */
 631:Source/main.c ****     tasks_cancel_all();
