 673:Source/main.c ****     {
 674:Source/main.c ****         /* Other about: pages go through the normal load path (http_client
 675:Source/main.c ****          * serves about:acidtest etc. internally). */
 676:Source/main.c ****     }
 677:Source/main.c ****     else if (strncmp(urlBuf, "http://", 7) != 0 && strncmp(urlBuf, "https://", 8) != 0)
 678:Source/main.c ****     {
 679:Source/main.c ****         /* No scheme: search query or bare host (Lua parity). */
 680:Source/main.c ****         if (url_is_search_query(urlBuf))
 681:Source/main.c ****         {
 682:Source/main.c ****             int engine = storage_setting_int("searchEngine");
 683:Source/main.c ****             if (engine < 0 || engine >= SEARCH_ENGINE_COUNT)
 684:Source/main.c ****             {
 685:Source/main.c ****                 engine = 0;
 686:Source/main.c ****             }
 687:Source/main.c ****             char *full = url_build_search_url(SEARCH_ENGINES[engine].url, urlBuf);
 688:Source/main.c ****             if (full)
 689:Source/main.c ****             {
 690:Source/main.c ****                 snprintf(urlBuf, sizeof(urlBuf), "%s", full);
 691:Source/main.c ****                 pluto_free(full);
 692:Source/main.c ****             }
 693:Source/main.c ****         }
