 652:Source/main.c ****     {
 653:Source/main.c ****         currentState = STATE_HOME;
 654:Source/main.c ****         if (!currentUrlObj)
 655:Source/main.c ****         {
 656:Source/main.c ****             currentUrlObj = (UrlParsed *)malloc(sizeof(UrlParsed));
 657:Source/main.c ****         }
