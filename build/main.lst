1146:Source/main.c **** static void settings_on_change(void)
1147:Source/main.c **** {
1148:Source/main.c ****     currentBrowseMode = storage_setting_int("mode");
1149:Source/main.c ****     if (currentBrowseMode != MODE_READER && currentBrowseMode != MODE_RAW_HTML)
1150:Source/main.c ****     {
1151:Source/main.c ****         currentBrowseMode = MODE_READER;
1152:Source/main.c ****     }
1153:Source/main.c ****     /* User request: saving from a website RELOADS the current page (fresh
1154:Source/main.c ****      * fetch + re-render with the new settings) instead of re-rendering in
1155:Source/main.c ****      * place. No page open -> nothing to reload. */
1156:Source/main.c ****     if (currentUrlObj && currentUrlObj->normalized[0] &&
1157:Source/main.c ****         strcmp(currentUrlObj->normalized, "about:home") != 0)
1158:Source/main.c ****     {
1159:Source/main.c ****         navigate_to(currentUrlObj->normalized);
1160:Source/main.c ****     }
1161:Source/main.c **** }
