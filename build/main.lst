 260:src/main.c    **** static void bench_start_current(void)
 261:src/main.c    **** {
 262:src/main.c    ****     if (s_benchIdx >= BENCH_NURLS) {
 263:src/main.c    ****         if (!s_benchDone) {
 264:src/main.c    ****             PLUTO_LOG("[P07] benchmark done");
 265:src/main.c    ****             s_benchDone = 1;
 266:src/main.c    ****         }
 267:src/main.c    ****         return;
 268:src/main.c    ****     }
 269:src/main.c    ****     PlutoHttpCallbacks cbs;
 270:src/main.c    ****     memset(&cbs, 0, sizeof(cbs));
 271:src/main.c    ****     cbs.onSuccess = bench_on_success;
 272:src/main.c    ****     cbs.onError = bench_on_error;
 273:src/main.c    ****     s_benchStartMs = pd->system->getCurrentTimeMilliseconds();
 274:src/main.c    ****     PLUTO_LOG("[P07] bench start %s", BENCH_URLS[s_benchIdx]);
 275:src/main.c    ****     // Return value intentionally ignored: synchronous rejections still fire
 276:src/main.c    ****     // onError (which advances the chain).
 277:src/main.c    ****     hc_get(BENCH_URLS[s_benchIdx], &cbs);
 278:src/main.c    **** }
