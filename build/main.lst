 400:Source/main.c ****     int prevScroll;
 401:Source/main.c ****     int prevTarget;
 402:Source/main.c ****     DocParseResult *doc; /* set by the parse step, consumed by done */
 403:Source/main.c **** } RenderTask;
 404:Source/main.c **** 
 405:Source/main.c **** /* Static error buffer: tasks fire onError(data) with the task's data pointer
 406:Source/main.c ****  * (see tasks.c), so the real message travels through this side channel. */
 407:Source/main.c **** static char g_renderErrMsg[192];
 408:Source/main.c **** 
 409:Source/main.c **** static int render_step(TaskCtx *ctx)
 410:Source/main.c **** {
 411:Source/main.c ****     RenderTask *rt = (RenderTask *)ctx->data;
 412:Source/main.c ****     if (!rt->doc)
 413:Source/main.c ****     {
 414:Source/main.c ****         rt->doc = (DocParseResult *)malloc(sizeof(DocParseResult));
 415:Source/main.c ****         if (!rt->doc)
 416:Source/main.c ****         {
 417:Source/main.c ****             snprintf(g_renderErrMsg, sizeof(g_renderErrMsg),
 418:Source/main.c ****                      "Parse Error: out of memory");
 419:Source/main.c ****             return -1;
 420:Source/main.c ****         }
 421:Source/main.c ****         memset(rt->doc, 0, sizeof(DocParseResult));
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccw1hsgF.s 			page 10


 422:Source/main.c ****         tasks_report_progress(0.05f);
 423:Source/main.c **** 
 424:Source/main.c ****         /* detailsOpen overrides for toggle re-renders. */
 425:Source/main.c ****         DocParseOpts opts;
 426:Source/main.c ****         memset(&opts, 0, sizeof(opts));
 427:Source/main.c ****         if (rt->isToggle && detailsKeyCount > 0)
 428:Source/main.c ****         {
 429:Source/main.c ****             opts.detailsOpen = detailsOpenState;
 430:Source/main.c ****             opts.detailsOpenCount = detailsKeyCount;
 431:Source/main.c ****         }
 432:Source/main.c ****         opts.svgDecoder = app_svg_decoder;
 433:Source/main.c **** 
 434:Source/main.c ****         int rc = document_parse(rt->body, rt->url, currentBrowseMode,
 435:Source/main.c ****                                 rt->isToggle ? &opts : NULL, rt->doc);
 436:Source/main.c ****         if (rc != 0 || rt->doc->parseError)
 437:Source/main.c ****         {
 438:Source/main.c ****             snprintf(g_renderErrMsg, sizeof(g_renderErrMsg),
 439:Source/main.c ****                      "Parse Error: parse failed");
 440:Source/main.c ****             return -1;
 441:Source/main.c ****         }
 442:Source/main.c ****         tasks_report_progress(0.6f);
 443:Source/main.c ****         return 1; /* more work: layout next tick */
 444:Source/main.c ****     }
 445:Source/main.c **** 
 446:Source/main.c ****     /* Layout step. */
 447:Source/main.c ****     layout_build(rt->doc);
 448:Source/main.c ****     if (layout_build_failed())
 449:Source/main.c ****     {
 450:Source/main.c ****         snprintf(g_renderErrMsg, sizeof(g_renderErrMsg),
 451:Source/main.c ****                  "Layout Error: invalid table width (percent not supported)");
 452:Source/main.c ****         return -1;
 453:Source/main.c ****     }
 454:Source/main.c ****     tasks_report_progress(1.0f);
 455:Source/main.c ****     return 0;
 456:Source/main.c **** }
