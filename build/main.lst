 120:src/main.c    **** 
 121:src/main.c    **** static void draw_placeholder(void)
 122:src/main.c    **** {
 123:src/main.c    ****     // Temporary P01/P02 placeholder screen: proves the loop runs, fonts load,
 124:src/main.c    ****     // and shows the util self-test summary.
 125:src/main.c    ****     pd->graphics->clear(kColorWhite);
 126:src/main.c    **** 
 127:src/main.c    ****     if (s_fontBody != NULL) {
 128:src/main.c    ****         pd->graphics->setFont(s_fontBody);
 129:src/main.c    ****     }
 130:src/main.c    ****     // C API text drawing: black via kDrawModeCopy (default); white text later
