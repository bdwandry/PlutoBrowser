 402:Source/main.c **** } RenderTask;
 403:Source/main.c **** 
 404:Source/main.c **** /* Static error buffer: tasks fire onError(data) with the task's data pointer
 405:Source/main.c ****  * (see tasks.c), so the real message travels through this side channel. */
 406:Source/main.c **** static char g_renderErrMsg[192];
 407:Source/main.c **** 
 408:Source/main.c **** static int render_step(TaskCtx *ctx)
 409:Source/main.c **** {
 410:Source/main.c ****     RenderTask *rt = (RenderTask *)ctx->data;
 411:Source/main.c ****     if (!rt->doc)
 412:Source/main.c ****     {
 413:Source/main.c ****         rt->doc = (DocParseResult *)malloc(sizeof(DocParseResult));
 414:Source/main.c ****         if (!rt->doc)
 415:Source/main.c ****         {
 416:Source/main.c ****             snprintf(g_renderErrMsg, sizeof(g_renderErrMsg),
 417:Source/main.c ****                      "Parse Error: out of memory");
 418:Source/main.c ****             return -1;
 419:Source/main.c ****         }
 420:Source/main.c ****         memset(rt->doc, 0, sizeof(DocParseResult));
 421:Source/main.c ****         tasks_report_progress(0.05f);
