 388:Source/main.c **** /* ── renderBody (port): parse + Layout.build as a cooperative task ─────────
 389:Source/main.c **** static void render_body(const char *body, const char *url, int addToHistory);
 390:Source/main.c **** 
 391:Source/main.c **** /* renderBody task state (task-private continuation). */
 392:Source/main.c **** typedef struct RenderTask
 393:Source/main.c **** {
 394:Source/main.c ****     char *body;        /* malloc'd copy of the html to parse */
 395:Source/main.c ****     char url[512];
 396:Source/main.c ****     int addToHistory;
 397:Source/main.c ****     int isToggle;      /* details-toggle re-render: restore scroll, no history */
 398:Source/main.c ****     int prevScroll;
 399:Source/main.c ****     int prevTarget;
 400:Source/main.c ****     DocParseResult *doc; /* set by the parse step, consumed by done */
 401:Source/main.c **** } RenderTask;
 402:Source/main.c **** 
 403:Source/main.c **** /* Static error buffer: tasks fire onError(data) with the task's data pointer
 404:Source/main.c ****  * (see tasks.c), so the real message travels through this side channel. */
 405:Source/main.c **** static char g_renderErrMsg[192];
 406:Source/main.c **** 
 407:Source/main.c **** static int render_step(TaskCtx *ctx)
 408:Source/main.c **** {
 409:Source/main.c ****     RenderTask *rt = (RenderTask *)ctx->data;
 410:Source/main.c ****     if (!rt->doc)
 411:Source/main.c ****     {
 412:Source/main.c ****         rt->doc = (DocParseResult *)malloc(sizeof(DocParseResult));
 413:Source/main.c ****         if (!rt->doc)
 414:Source/main.c ****         {
 415:Source/main.c ****             snprintf(g_renderErrMsg, sizeof(g_renderErrMsg),
 416:Source/main.c ****                      "Parse Error: out of memory");
 417:Source/main.c ****             return -1;
 418:Source/main.c ****         }
 419:Source/main.c ****         memset(rt->doc, 0, sizeof(DocParseResult));
 420:Source/main.c ****         tasks_report_progress(0.05f);
 421:Source/main.c **** 
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc7OxaNJ.s 			page 10


 422:Source/main.c ****         /* detailsOpen overrides for toggle re-renders. */
 423:Source/main.c ****         DocParseOpts opts;
 424:Source/main.c ****         memset(&opts, 0, sizeof(opts));
 425:Source/main.c ****         if (rt->isToggle && detailsKeyCount > 0)
 426:Source/main.c ****         {
 427:Source/main.c ****             opts.detailsOpen = detailsOpenState;
 428:Source/main.c ****             opts.detailsOpenCount = detailsKeyCount;
 429:Source/main.c ****         }
 430:Source/main.c ****         opts.svgDecoder = app_svg_decoder;
 431:Source/main.c **** 
 432:Source/main.c ****         int rc = document_parse(rt->body, rt->url, currentBrowseMode,
 433:Source/main.c ****                                 rt->isToggle ? &opts : NULL, rt->doc);
 434:Source/main.c ****         if (rc != 0 || rt->doc->parseError)
 435:Source/main.c ****         {
 436:Source/main.c ****             snprintf(g_renderErrMsg, sizeof(g_renderErrMsg),
 437:Source/main.c ****                      "Parse Error: parse failed");
 438:Source/main.c ****             return -1;
 439:Source/main.c ****         }
 440:Source/main.c ****         tasks_report_progress(0.6f);
 441:Source/main.c ****         return 1; /* more work: layout next tick */
 442:Source/main.c ****     }
 443:Source/main.c **** 
 444:Source/main.c ****     /* Layout step. */
 445:Source/main.c ****     layout_build(rt->doc);
 446:Source/main.c ****     if (layout_build_failed())
 447:Source/main.c ****     {
 448:Source/main.c ****         snprintf(g_renderErrMsg, sizeof(g_renderErrMsg),
 449:Source/main.c ****                  "Layout Error: invalid table width (percent not supported)");
 450:Source/main.c ****         return -1;
 451:Source/main.c ****     }
 452:Source/main.c ****     tasks_report_progress(1.0f);
 453:Source/main.c ****     return 0;
 454:Source/main.c **** }
 455:Source/main.c **** 
 456:Source/main.c **** static void render_done(void *result, void *userdata)
 457:Source/main.c **** {
 458:Source/main.c ****     RenderTask *rt = (RenderTask *)userdata;
 459:Source/main.c ****     (void)result;
 460:Source/main.c ****     if (!rt)
 461:Source/main.c ****     {
 462:Source/main.c ****         return;
 463:Source/main.c ****     }
 464:Source/main.c ****     isRendering = 0;
 465:Source/main.c **** 
 466:Source/main.c ****     /* Free the previous doc AFTER the new build (layout borrows strings). */
 467:Source/main.c ****     if (currentDoc)
 468:Source/main.c ****     {
 469:Source/main.c ****         document_free(currentDoc);
 470:Source/main.c ****         free(currentDoc);
 471:Source/main.c ****     }
 472:Source/main.c ****     currentDoc = rt->doc;
 473:Source/main.c ****     rt->doc = NULL;
 474:Source/main.c **** 
 475:Source/main.c ****     snprintf(pageTitle, sizeof(pageTitle), "%s",
 476:Source/main.c ****              currentDoc->title[0] ? currentDoc->title
 477:Source/main.c ****              : (currentUrlObj ? currentUrlObj->host : "Web Page"));
 478:Source/main.c ****     if (rt->isToggle)
