 641:Source/main.c ****     pluto_free(unwrapped);
 642:Source/main.c ****     snprintf(urlBuf, sizeof(urlBuf), "%s", trimmed ? trimmed : urlString);
 643:Source/main.c ****     pluto_free(trimmed);
 644:Source/main.c **** 
 645:Source/main.c ****     /* Reset per-navigation state (Lua runNavigation). The old layout items
 646:Source/main.c ****      * (with their owned values) are freed by layout_clear during the render
 647:Source/main.c ****      * task, so no form-value cleanup is needed here. */
 648:Source/main.c ****     formInputItem = NULL;
 649:Source/main.c ****     formKeyboardOpen = 0;
