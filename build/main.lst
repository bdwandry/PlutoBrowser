 237:src/main.c    **** static void bench_on_success(void* ud, int status, const StrMap* headers,
 238:src/main.c    ****                              const char* body, size_t bodyLen,
 239:src/main.c    ****                              const char* url)
 240:src/main.c    **** {
 241:src/main.c    ****     (void)ud;
 242:src/main.c    ****     (void)headers;
 243:src/main.c    ****     unsigned ms = pd->system->getCurrentTimeMilliseconds() - s_benchStartMs;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccFtYUJG.s 			page 7


 244:src/main.c    ****     PLUTO_LOG("[P07] bench OK %s status=%d bytes=%u ms=%u kbps=%u", url,
 245:src/main.c    ****               status, (unsigned)bodyLen, ms,
 246:src/main.c    ****               ms > 0 ? (unsigned)((bodyLen * 1000u) / (ms * 1024u)) : 0);
 247:src/main.c    ****     s_benchIdx++;
 248:src/main.c    ****     bench_start_current();
 249:src/main.c    **** }
