 558:Source/main.c ****             /* Lua: undo the toggle flip on error. */
 559:Source/main.c ****             if (detailsKeyCount > 0)
 560:Source/main.c ****             {
 561:Source/main.c ****                 detailsOpenState[detailsKeyCount - 1] =
 562:Source/main.c ****                     !detailsOpenState[detailsKeyCount - 1];
 563:Source/main.c ****             }
 564:Source/main.c ****         }
 565:Source/main.c ****         if (rt->body)
 566:Source/main.c ****         {
 567:Source/main.c ****             pluto_free(rt->body);
 568:Source/main.c ****         }
 569:Source/main.c ****         if (rt->doc)
 570:Source/main.c ****         {
 571:Source/main.c ****             document_free(rt->doc);
 572:Source/main.c ****             free(rt->doc);
 573:Source/main.c ****         }
 574:Source/main.c ****         free(rt);
 575:Source/main.c ****     }
 576:Source/main.c ****     error_page_show(g_renderErrMsg, currentUrlObj ? currentUrlObj->normalized : "");
 577:Source/main.c ****     currentState = STATE_ERROR;
 578:Source/main.c ****     snprintf(pageTitle, sizeof(pageTitle), "Render Error");
 579:Source/main.c ****     update_system_menu();
 580:Source/main.c **** }
