 734:Source/main.c **** static void http_on_success(int status, char **headerKeys, char **headerVals,
 735:Source/main.c ****                             int headerCount, const char *body, size_t bodyLen,
 736:Source/main.c ****                             const char *url)
 737:Source/main.c **** {
 738:Source/main.c ****     (void)status;
 739:Source/main.c ****     const char *contentType = NULL;
 740:Source/main.c ****     for (int i = 0; i < headerCount; i++)
 741:Source/main.c ****     {
 742:Source/main.c ****         if (headerKeys && headerKeys[i] && headerVals &&
 743:Source/main.c ****             strcmp(headerKeys[i], "content-type") == 0)
 744:Source/main.c ****         {
 745:Source/main.c ****             contentType = headerVals[i];
 746:Source/main.c ****             break;
 747:Source/main.c ****         }
 748:Source/main.c ****     }
 749:Source/main.c ****     /* Lua: body = Encoding.toUtf8(body, headers["content-type"]). */
 750:Source/main.c ****     char *utf8 = encoding_to_utf8((const unsigned char *)body,
 751:Source/main.c ****                                   body ? strlen(body) : 0, contentType);
 752:Source/main.c ****     render_body(utf8 ? utf8 : (body ? body : ""), url, 1);
 753:Source/main.c ****     if (utf8)
 754:Source/main.c ****     {
 755:Source/main.c ****         pluto_free(utf8);
 756:Source/main.c ****     }
 757:Source/main.c **** }
 758:Source/main.c **** 
 759:Source/main.c **** static void http_on_error(const char *message)
 760:Source/main.c **** {
 761:Source/main.c ****     error_page_show(message, currentUrlObj ? currentUrlObj->normalized : "");
 762:Source/main.c ****     currentState = STATE_ERROR;
 763:Source/main.c ****     snprintf(pageTitle, sizeof(pageTitle), "Connection Error");
 764:Source/main.c ****     update_system_menu();
 765:Source/main.c **** }
