 549:src/main.c    ****     /* P27 chrome/hud showcase: rotates every 60 frames through
 550:src/main.c    ****      * ssl-web / reader-badge / loading-known-total / indeterminate /
 551:src/main.c    ****      * about-page states. */
 552:src/main.c    ****     {
 553:src/main.c    ****         static PlutoUrl demo;
 554:src/main.c    ****         memset(&demo, 0, sizeof(demo));
 555:src/main.c    ****         int loading = 0, reader = 0;
 556:src/main.c    ****         long cur = 0, tot = 0;
 557:src/main.c    **** 
 558:src/main.c    ****         switch (s_p27Scenario % 5) {
 559:src/main.c    ****         case 0:
 560:src/main.c    ****             strcpy(demo.scheme, "https");
 561:src/main.c    ****             strcpy(demo.host, "example.com");
 562:src/main.c    ****             demo.isSsl = 1;
 563:src/main.c    ****             break;
 564:src/main.c    ****         case 1:
 565:src/main.c    ****             strcpy(demo.scheme, "https");
 566:src/main.c    ****             strcpy(demo.host, "news.example.com");
 567:src/main.c    ****             demo.isSsl = 1;
 568:src/main.c    ****             reader = 1;
 569:src/main.c    ****             break;
