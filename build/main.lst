 227:Source/main.c **** /* detailsOpenSet key bookkeeping: find or add "d<N>", return index. */
 228:Source/main.c **** static int details_key_index(const char *dkey)
 229:Source/main.c **** {
 230:Source/main.c ****     if (!dkey)
 231:Source/main.c ****     {
 232:Source/main.c ****         return -1;
 233:Source/main.c ****     }
 234:Source/main.c ****     for (int i = 0; i < detailsKeyCount; i++)
 235:Source/main.c ****     {
 236:Source/main.c ****         if (strcmp(detailsKeys[i], dkey) == 0)
 237:Source/main.c ****         {
 238:Source/main.c ****             return i;
 239:Source/main.c ****         }
 240:Source/main.c ****     }
 241:Source/main.c ****     if (detailsKeyCount < 64)
 242:Source/main.c ****     {
 243:Source/main.c ****         detailsKeys[detailsKeyCount] = pluto_strdup(dkey);
 244:Source/main.c ****         detailsOpenState[detailsKeyCount] = 0;
 245:Source/main.c ****         return detailsKeyCount++;
 246:Source/main.c ****     }
 247:Source/main.c ****     return -1;
 248:Source/main.c **** }
