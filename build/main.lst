 674:Source/main.c ****     {
 675:Source/main.c ****         /* Other about: pages go through the normal load path (http_client
 676:Source/main.c ****          * serves about:acidtest etc. internally). */
 677:Source/main.c ****     }
 678:Source/main.c ****     else if (strncmp(urlBuf, "http://", 7) != 0 && strncmp(urlBuf, "https://", 8) != 0)
 679:Source/main.c ****     {
