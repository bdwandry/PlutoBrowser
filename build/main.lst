1893:Source/main.c ****     /* ── Address bar per-frame glue (Lua parity) ──
1894:Source/main.c ****      * 1. Arm skipInputFrames requested by the keyboard willHide callback.
1895:Source/main.c ****      * 2. System-menu-close detection: >500ms frame gap closes the bar.
1896:Source/main.c ****      * 3. Live-sync keyboard text into the bar (Lua textChanged callback kept
1897:Source/main.c ****      *    g_inputText current; sync covers any path that missed it).
1898:Source/main.c ****      * 4. drawOverlay runs after chrome (Lua: Chrome.draw then drawOverlay). */
1899:Source/main.c ****     {
1900:Source/main.c ****         int pending = address_bar_consume_skip_frames();
1901:Source/main.c ****         if (pending > skipInputFrames)
1902:Source/main.c ****         {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccHeGSPa.s 			page 140


1903:Source/main.c ****             skipInputFrames = pending;
1904:Source/main.c ****         }
1905:Source/main.c ****         if (g_lastFrameAtMs > 0 &&
1906:Source/main.c ****             (unsigned int)(pd->system->getCurrentTimeMilliseconds() - g_lastFrameAtMs) > 500)
1907:Source/main.c ****         {
1908:Source/main.c ****             if (address_bar_is_open())
1909:Source/main.c ****             {
1910:Source/main.c ****                 address_bar_cancel();
1911:Source/main.c ****                 logger_log("main: system menu close detected, address bar cancelled");
1912:Source/main.c ****             }
1913:Source/main.c ****             skipInputFrames = 2;
1914:Source/main.c ****         }
1915:Source/main.c ****         g_lastFrameAtMs = pd->system->getCurrentTimeMilliseconds();
1916:Source/main.c ****         address_bar_sync_text();
1917:Source/main.c ****     }
1918:Source/main.c **** 
1919:Source/main.c ****     /* ── chrome: always drawn last (Lua parity) ── */
1920:Source/main.c ****     chrome_draw(currentUrlObj, NULL, currentState == STATE_LOADING, 0, 0,
1921:Source/main.c ****                 currentBrowseMode == 0);
1922:Source/main.c ****     address_bar_draw_overlay();
1923:Source/main.c **** 
1924:Source/main.c ****     /* State-transition log (first entry to each state). */
1925:Source/main.c ****     if (currentState != g_lastLoggedState)
1926:Source/main.c ****     {
