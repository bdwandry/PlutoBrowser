1887:Source/main.c ****     }
1888:Source/main.c **** 
1889:Source/main.c ****     /* Draw mouse cursor as the very last thing so nothing can draw over it
1890:Source/main.c ****      * (Lua main.lua: white-filled triangle + black outline + inner line). */
1891:Source/main.c ****     if (currentState == STATE_PAGE && currentBrowseMode == MODE_RAW_HTML)
1892:Source/main.c ****     {
1893:Source/main.c ****         int mx = mouseX, my = mouseY;
