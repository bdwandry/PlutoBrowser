 805:Source/main.c **** /* ── Form input value override table ───────────────────
 806:Source/main.c ****  * Lua input items alias the block table, so writing item.value mutates the
 807:Source/main.c ****  * block. C strings are borrowed const arena pointers, so the value override
 808:Source/main.c ****  * lives in a side table keyed by block pointer; layout's draw and submit
 809:Source/main.c ****  * consult it through form_item_value(). */
 810:Source/main.c **** typedef struct
 811:Source/main.c **** {
 812:Source/main.c ****     const void *block;
 813:Source/main.c ****     char *value; /* heap (pluto allocator) */
 814:Source/main.c **** } FormValueOverride;
 815:Source/main.c **** 
 816:Source/main.c **** #define FORM_OVERRIDE_MAX 32
 817:Source/main.c **** static FormValueOverride g_formOverrides[FORM_OVERRIDE_MAX];
 818:Source/main.c **** static int g_formOverrideCount = 0;
 819:Source/main.c **** 
 820:Source/main.c **** static void form_overrides_clear(void)
 821:Source/main.c **** {
 822:Source/main.c ****     for (int i = 0; i < g_formOverrideCount; i++)
 823:Source/main.c ****     {
 824:Source/main.c ****         pluto_free(g_formOverrides[i].value);
 825:Source/main.c ****     }
 826:Source/main.c ****     g_formOverrideCount = 0;
 827:Source/main.c **** }
