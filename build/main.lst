 664:Source/main.c ****         }
 665:Source/main.c ****         navigatingHistory = 0;
 666:Source/main.c ****         scrollY = 0;
 667:Source/main.c ****         targetScrollY = 0;
 668:Source/main.c ****         home_page_reset();
