 458:Source/main.c **** static void render_done(void *result, void *userdata)
 459:Source/main.c **** {
 460:Source/main.c ****     RenderTask *rt = (RenderTask *)userdata;
 461:Source/main.c ****     (void)result;
 462:Source/main.c ****     if (!rt)
 463:Source/main.c ****     {
 464:Source/main.c ****         return;
 465:Source/main.c ****     }
