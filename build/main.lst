 117:src/main.c    **** static void draw_placeholder(void)
 118:src/main.c    **** {
 119:src/main.c    ****     // Temporary P01/P02 placeholder screen: proves the loop runs, fonts load,
 120:src/main.c    ****     // and shows the util self-test summary.
 121:src/main.c    ****     pd->graphics->clear(kColorWhite);
 122:src/main.c    **** 
 123:src/main.c    ****     if (s_fontBody != NULL) {
 124:src/main.c    ****         pd->graphics->setFont(s_fontBody);
 125:src/main.c    ****     }
 126:src/main.c    ****     // C API text drawing: black via kDrawModeCopy (default); white text later
 127:src/main.c    ****     // via setDrawMode(kDrawModeFillWhite), mirroring Lua setImageDrawMode.
 128:src/main.c    **** 
 129:src/main.c    ****     const char* title = "PlutoBrowser";
 130:src/main.c    ****     pd->graphics->drawText(title, strlen(title), kASCIIEncoding, 150, 80);
 131:src/main.c    **** 
