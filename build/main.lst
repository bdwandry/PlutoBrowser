 228:src/main.c    **** // ── P07 benchmark (MASTER_TODO §4.10): fetch assets from the bitmaps host
 229:src/main.c    **** // and log URL / bytes / download ms / KB per second. Log-only: failures are
 230:src/main.c    **** // expected whenever the simulator has no network or the access prompt blocks.
 231:src/main.c    **** static const char* BENCH_URLS[] = {
 232:src/main.c    ****     "https://wiesmann.codiferes.net/share/bitmaps/",
 233:src/main.c    ****     "http://wiesmann.codiferes.net/share/bitmaps/test_image_4c.png",
 234:src/main.c    **** };
 235:src/main.c    **** #define BENCH_NURLS (int)(sizeof(BENCH_URLS) / sizeof(BENCH_URLS[0]))
 236:src/main.c    **** static int s_benchIdx = -1;
 237:src/main.c    **** static int s_benchDone = 0;
 238:src/main.c    **** static unsigned s_benchStartMs = 0;
 239:src/main.c    **** 
 240:src/main.c    **** static void bench_start_current(void);
 241:src/main.c    **** 
 242:src/main.c    **** static void bench_on_success(void* ud, int status, const StrMap* headers,
 243:src/main.c    ****                              const char* body, size_t bodyLen,
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccL52q5y.s 			page 7


 244:src/main.c    ****                              const char* url)
 245:src/main.c    **** {
 246:src/main.c    ****     (void)ud;
 247:src/main.c    ****     (void)headers;
 248:src/main.c    ****     unsigned ms = pd->system->getCurrentTimeMilliseconds() - s_benchStartMs;
 249:src/main.c    ****     PLUTO_LOG("[P07] bench OK %s status=%d bytes=%u ms=%u kbps=%u", url,
 250:src/main.c    ****               status, (unsigned)bodyLen, ms,
 251:src/main.c    ****               ms > 0 ? (unsigned)((bodyLen * 1000u) / (ms * 1024u)) : 0);
 252:src/main.c    ****     s_benchIdx++;
 253:src/main.c    ****     bench_start_current();
 254:src/main.c    **** }
 255:src/main.c    **** 
 256:src/main.c    **** static void bench_on_error(void* ud, const char* msg)
 257:src/main.c    **** {
 258:src/main.c    ****     (void)ud;
 259:src/main.c    ****     PLUTO_LOG("[P07] bench FAIL %s (%s)", BENCH_URLS[s_benchIdx],
 260:src/main.c    ****               msg ? msg : "?");
 261:src/main.c    ****     s_benchIdx++;
 262:src/main.c    ****     bench_start_current();
 263:src/main.c    **** }
 264:src/main.c    **** 
 265:src/main.c    **** static void bench_start_current(void)
 266:src/main.c    **** {
 267:src/main.c    ****     if (s_benchIdx >= BENCH_NURLS) {
 268:src/main.c    ****         if (!s_benchDone) {
 269:src/main.c    ****             PLUTO_LOG("[P07] benchmark done");
 270:src/main.c    ****             s_benchDone = 1;
 271:src/main.c    ****         }
 272:src/main.c    ****         return;
 273:src/main.c    ****     }
 274:src/main.c    ****     PlutoHttpCallbacks cbs;
 275:src/main.c    ****     memset(&cbs, 0, sizeof(cbs));
 276:src/main.c    ****     cbs.onSuccess = bench_on_success;
 277:src/main.c    ****     cbs.onError = bench_on_error;
 278:src/main.c    ****     s_benchStartMs = pd->system->getCurrentTimeMilliseconds();
 279:src/main.c    ****     PLUTO_LOG("[P07] bench start %s", BENCH_URLS[s_benchIdx]);
 280:src/main.c    ****     // Return value intentionally ignored: synchronous rejections still fire
 281:src/main.c    ****     // onError (which advances the chain).
 282:src/main.c    ****     hc_get(BENCH_URLS[s_benchIdx], &cbs);
 283:src/main.c    **** }
