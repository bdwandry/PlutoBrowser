 390:Source/main.c **** static void render_body(const char *body, const char *url, int addToHistory);
 391:Source/main.c **** 
 392:Source/main.c **** /* renderBody task state (task-private continuation). */
 393:Source/main.c **** typedef struct RenderTask
 394:Source/main.c **** {
 395:Source/main.c ****     char *body;        /* malloc'd copy of the html to parse */
 396:Source/main.c ****     char url[512];
