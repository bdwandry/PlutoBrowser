 544:src/main.c    ****     /* P27 chrome/hud showcase: rotates every 60 frames through
 545:src/main.c    ****      * ssl-web / reader-badge / loading-known-total / indeterminate /
 546:src/main.c    ****      * about-page states. */
 547:src/main.c    ****     {
 548:src/main.c    ****         static PlutoUrl demo;
 549:src/main.c    ****         memset(&demo, 0, sizeof(demo));
 550:src/main.c    ****         int loading = 0, reader = 0;
 551:src/main.c    ****         long cur = 0, tot = 0;
 552:src/main.c    **** 
 553:src/main.c    ****         switch (s_p27Scenario % 5) {
 554:src/main.c    ****         case 0:
 555:src/main.c    ****             strcpy(demo.scheme, "https");
 556:src/main.c    ****             strcpy(demo.host, "example.com");
 557:src/main.c    ****             demo.isSsl = 1;
 558:src/main.c    ****             break;
 559:src/main.c    ****         case 1:
 560:src/main.c    ****             strcpy(demo.scheme, "https");
 561:src/main.c    ****             strcpy(demo.host, "news.example.com");
 562:src/main.c    ****             demo.isSsl = 1;
 563:src/main.c    ****             reader = 1;
 564:src/main.c    ****             break;
 565:src/main.c    ****         case 2:
 566:src/main.c    ****             strcpy(demo.scheme, "https");
 567:src/main.c    ****             strcpy(demo.host, "big.example.com");
 568:src/main.c    ****             loading = 1;
 569:src/main.c    ****             tot = 1000;
