 547:Source/main.c **** static void render_error(const char *message, void *userdata)
 548:Source/main.c **** {
 549:Source/main.c ****     /* tasks.c passes the task's data pointer as "message" — ignore it and use
 550:Source/main.c ****      * the static error buffer set by render_step. */
