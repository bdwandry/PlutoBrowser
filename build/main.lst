 894:Source/main.c **** static void activate_form_block(const LayoutItem *item)
 895:Source/main.c **** {
 896:Source/main.c ****     if (!item || item->disabled)
 897:Source/main.c ****     {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cczGGec2.s 			page 75


 898:Source/main.c ****         return;
 899:Source/main.c ****     }
 900:Source/main.c ****     if (item->block && ((const DocBlock *)item->block)->inert)
 901:Source/main.c ****     {
 902:Source/main.c ****         return;
 903:Source/main.c ****     }
 904:Source/main.c ****     switch (item->type)
 905:Source/main.c ****     {
 906:Source/main.c ****     case LRI_INPUT_FIELD:
 907:Source/main.c ****         open_keyboard_for_input(item);
 908:Source/main.c ****         break;
 909:Source/main.c ****     case LRI_INPUT_SUBMIT:
 910:Source/main.c ****         submit_form(item->formAction, item);
 911:Source/main.c ****         break;
 912:Source/main.c ****     case LRI_CHECKBOX_FIELD:
 913:Source/main.c ****     {
 914:Source/main.c ****         DocBlock *block = (DocBlock *)item->block;
 915:Source/main.c ****         if (block->radio)
 916:Source/main.c ****         {
 917:Source/main.c ****             for (int i = 0; i < layout_get_item_count(); i++)
 918:Source/main.c ****             {
 919:Source/main.c ****                 const LayoutItem *it = layout_item_at(i);
 920:Source/main.c ****                 if (it && it != item && it->type == LRI_CHECKBOX_FIELD && it->radio &&
 921:Source/main.c ****                     it->name && block->name && strcmp(it->name, block->name) == 0)
 922:Source/main.c ****                 {
 923:Source/main.c ****                     ((DocBlock *)it->block)->checked = 0;
 924:Source/main.c ****                 }
 925:Source/main.c ****             }
 926:Source/main.c ****             block->checked = 1;
 927:Source/main.c ****         }
 928:Source/main.c ****         else
 929:Source/main.c ****         {
 930:Source/main.c ****             block->checked = !block->checked;
 931:Source/main.c ****         }
 932:Source/main.c ****         layout_set_selected_input(item);
 933:Source/main.c ****         break;
 934:Source/main.c ****     }
 935:Source/main.c ****     case LRI_SELECT_FIELD:
 936:Source/main.c ****     {
 937:Source/main.c ****         DocBlock *block = (DocBlock *)item->block;
 938:Source/main.c ****         int n = block->optionCount;
 939:Source/main.c ****         if (n > 0)
 940:Source/main.c ****         {
 941:Source/main.c ****             int tries = n + 1;
 942:Source/main.c ****             while (tries > 0)
 943:Source/main.c ****             {
 944:Source/main.c ****                 block->selectedIndex = (block->selectedIndex % n) + 1;
 945:Source/main.c ****                 DocOption *opt = block->options[block->selectedIndex - 1];
 946:Source/main.c ****                 if (opt && !opt->disabled && !opt->group)
 947:Source/main.c ****                 {
 948:Source/main.c ****                     break;
 949:Source/main.c ****                 }
 950:Source/main.c ****                 tries--;
 951:Source/main.c ****             }
 952:Source/main.c ****         }
 953:Source/main.c ****         layout_set_selected_input(item);
 954:Source/main.c ****         break;
