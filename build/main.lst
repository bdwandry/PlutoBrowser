1929:Source/main.c ****     }
1930:Source/main.c **** 
1931:Source/main.c ****     if (frameCount == 1)
1932:Source/main.c ****     {
1933:Source/main.c ****         logger_log("updateFrame: first frame executed");
1934:Source/main.c ****     }
1935:Source/main.c **** 
1936:Source/main.c ****     /* Log a periodic heartbeat every 300 frames (~10s at 30fps) so logs show liveness. */
1937:Source/main.c ****     if (frameCount % 300 == 0)
1938:Source/main.c ****     {
1939:Source/main.c ****         logger_log("updateFrame: heartbeat frame=%u", frameCount);
1940:Source/main.c ****     }
1941:Source/main.c **** 
1942:Source/main.c ****     /* Phase 4: pump timers each frame. */
1943:Source/main.c ****     pdtimer_update();
1944:Source/main.c **** 
1945:Source/main.c ****     /* Phase 24: pump the HTTP state machine each frame. */
1946:Source/main.c ****     http_update();
1947:Source/main.c **** 
1948:Source/main.c ****     /* P30: pump the image download/decode queue each frame. */
1949:Source/main.c ****     imgdec_update();
1950:Source/main.c **** 
1951:Source/main.c ****     /* Drive cooperative tasks (Lua Tasks.update parity). */
1952:Source/main.c ****     tasks_update();
1953:Source/main.c **** 
1954:Source/main.c ****     /* Return non-zero to tell the system to update the display. */
1955:Source/main.c ****     return 1;
