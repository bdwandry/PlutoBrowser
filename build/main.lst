 493:Source/main.c ****     {
 494:Source/main.c ****         storage_add_history(pageTitle, rt->url);
 495:Source/main.c ****     }
 496:Source/main.c ****     update_system_menu();
 497:Source/main.c **** 
 498:Source/main.c ****     /* Enqueue images per the image mode setting (Lua: IMAGE_MODE_ALL). */
 499:Source/main.c ****     {
