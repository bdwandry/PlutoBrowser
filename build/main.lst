1145:Source/main.c **** /* ── Settings change (reference SettingsPage.onChangeCallback) ──────────�
1146:Source/main.c **** /* ── FPS overlay (Beta: user request) ──────────────────�
1147:Source/main.c **** static int g_showFps = 0;              /* cached setting; re-read on boot/save */
1148:Source/main.c **** static unsigned int g_fpsFrames = 0;   /* frames since last sample window */
1149:Source/main.c **** static unsigned int g_fpsWindowStart = 0; /* ms timestamp of window start */
1150:Source/main.c **** static int g_fpsValue = 0;             /* last computed frames-per-second */
1151:Source/main.c **** static unsigned int g_fpsLastSampleMs = 0;
1152:Source/main.c **** static LCDFont *g_fpsFont = NULL;      /* bold body font, loaded once */
1153:Source/main.c **** 
1154:Source/main.c **** /* Draw a small bold FPS number flush in the bottom-right corner.
1155:Source/main.c ****  * Runs AFTER every state's draw, in its own full-screen context with no
1156:Source/main.c ****  * clip, so nothing can clip it out (the visibility bug from the first
1157:Source/main.c ****  * attempt). 1px white backing keeps it readable over dark content. */
1158:Source/main.c **** static void draw_fps_overlay(void)
1159:Source/main.c **** {
1160:Source/main.c ****     if (!g_showFps || !g_fpsFont)
1161:Source/main.c ****     {
1162:Source/main.c ****         return;
1163:Source/main.c ****     }
1164:Source/main.c ****     PlaydateAPI *pd = pluto_pd();
1165:Source/main.c ****     char num[8];
1166:Source/main.c ****     snprintf(num, sizeof(num), "%d", g_fpsValue);
1167:Source/main.c ****     pd->graphics->pushContext(NULL);
1168:Source/main.c ****     pd->graphics->clearClipRect();
1169:Source/main.c ****     pd->graphics->setFont(g_fpsFont);
1170:Source/main.c ****     int w = pd->graphics->getTextWidth(g_fpsFont, num, strlen(num), kUTF8Encoding, 0);
1171:Source/main.c ****     int h = pd->graphics->getFontHeight(g_fpsFont);
1172:Source/main.c ****     int x = LCD_COLUMNS - w;          /* flush right */
1173:Source/main.c ****     int y = LCD_ROWS - h;             /* flush bottom, touching the border */
1174:Source/main.c ****     pd->graphics->fillRect(x - 1, y, w + 1, h, kColorWhite);
1175:Source/main.c ****     pd->graphics->setDrawMode(kDrawModeCopy);
1176:Source/main.c ****     pd->graphics->drawText(num, strlen(num), kUTF8Encoding, x, y);
1177:Source/main.c ****     pd->graphics->popContext();
1178:Source/main.c **** }
