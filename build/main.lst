 804:Source/main.c **** /* ── Form input values ───────────────────────�
 805:Source/main.c ****  * Lua input items alias the block table, so openKeyboardForInput's
 806:Source/main.c ****  * activeInputField.value = entered made typed text visible to BOTH the
 807:Source/main.c ****  * renderer and the submit path. In C the LayoutItem and DocBlock are separate
 808:Source/main.c ****  * structs, so the typed text lives on the item itself (owned heap copy set
 809:Source/main.c ****  * through layout_set_input_value; freed by layout_clear). form_item_value()
 810:Source/main.c ****  * therefore just reads the item's current value. */
 811:Source/main.c **** static void form_set_block_value(const LayoutItem *item, const char *text)
 812:Source/main.c **** {
 813:Source/main.c ****     layout_set_input_value(item, text);
 814:Source/main.c **** }
 815:Source/main.c **** 
 816:Source/main.c **** /* Effective value for an input item (live typed value > block value). */
 817:Source/main.c **** static const char *form_item_value(const LayoutItem *item)
 818:Source/main.c **** {
 819:Source/main.c ****     return item && item->value ? item->value : "";
 820:Source/main.c **** }
 821:Source/main.c **** 
 822:Source/main.c **** /* ── Form input keyboard (port of openKeyboardForInput) ────────────�
 823:Source/main.c **** static void open_keyboard_for_input(const LayoutItem *item)
 824:Source/main.c **** {
 825:Source/main.c ****     if (!item || !g_kb)
 826:Source/main.c ****     {
 827:Source/main.c ****         return;
 828:Source/main.c ****     }
 829:Source/main.c ****     formInputItem = item;
 830:Source/main.c ****     formKeyboardOpen = 1;
 831:Source/main.c ****     layout_set_selected_input(item); /* Lua: Layout.selectedInputItem = block */
 832:Source/main.c ****     keyboardApi.setKeyboardWillHideCallback(g_kb, form_kb_will_hide, NULL);
 833:Source/main.c ****     keyboardApi.setKeyboardDidHideCallback(g_kb, form_kb_did_hide, NULL);
 834:Source/main.c ****     keyboardApi.setTextChangedCallback(g_kb, form_kb_text_changed, NULL);
 835:Source/main.c ****     keyboardApi.show(g_kb, item->value ? item->value : "",
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc7OxaNJ.s 			page 18


