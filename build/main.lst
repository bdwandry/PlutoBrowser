 117:src/main.c    ****         pd->graphics->setFont(s_fontBody);
 118:src/main.c    ****     }
 119:src/main.c    ****     // C API text drawing: black via kDrawModeCopy (default); white text later
 120:src/main.c    ****     // via setDrawMode(kDrawModeFillWhite), mirroring Lua setImageDrawMode.
 121:src/main.c    **** 
 122:src/main.c    ****     const char* title = "PlutoBrowser";
 123:src/main.c    ****     pd->graphics->drawText(title, strlen(title), kASCIIEncoding, 150, 80);
