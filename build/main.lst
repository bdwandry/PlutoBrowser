 552:src/main.c    ****     /* P27 chrome/hud showcase: rotates every 60 frames through
 553:src/main.c    ****      * ssl-web / reader-badge / loading-known-total / indeterminate /
 554:src/main.c    ****      * about-page states. */
 555:src/main.c    ****     {
 556:src/main.c    ****         static PlutoUrl demo;
 557:src/main.c    ****         memset(&demo, 0, sizeof(demo));
