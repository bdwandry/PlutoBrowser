 245:src/main.c    **** static void bench_on_success(void* ud, int status, const StrMap* headers,
 246:src/main.c    ****                              const char* body, size_t bodyLen,
 247:src/main.c    ****                              const char* url)
 248:src/main.c    **** {
 249:src/main.c    ****     (void)ud;
 250:src/main.c    ****     (void)headers;
 251:src/main.c    ****     unsigned ms = pd->system->getCurrentTimeMilliseconds() - s_benchStartMs;
 252:src/main.c    ****     PLUTO_LOG("[P07] bench OK %s status=%d bytes=%u ms=%u kbps=%u", url,
 253:src/main.c    ****               status, (unsigned)bodyLen, ms,
 254:src/main.c    ****               ms > 0 ? (unsigned)((bodyLen * 1000u) / (ms * 1024u)) : 0);
 255:src/main.c    ****     s_benchIdx++;
 256:src/main.c    ****     bench_start_current();
 257:src/main.c    **** }
 258:src/main.c    **** 
 259:src/main.c    **** static void bench_on_error(void* ud, const char* msg)
 260:src/main.c    **** {
 261:src/main.c    ****     (void)ud;
 262:src/main.c    ****     PLUTO_LOG("[P07] bench FAIL %s (%s)", BENCH_URLS[s_benchIdx],
 263:src/main.c    ****               msg ? msg : "?");
 264:src/main.c    ****     s_benchIdx++;
 265:src/main.c    ****     bench_start_current();
 266:src/main.c    **** }
 267:src/main.c    **** 
 268:src/main.c    **** static void bench_start_current(void)
 269:src/main.c    **** {
 270:src/main.c    ****     if (s_benchIdx >= BENCH_NURLS) {
 271:src/main.c    ****         if (!s_benchDone) {
 272:src/main.c    ****             PLUTO_LOG("[P07] benchmark done");
 273:src/main.c    ****             s_benchDone = 1;
 274:src/main.c    ****         }
 275:src/main.c    ****         return;
 276:src/main.c    ****     }
 277:src/main.c    ****     PlutoHttpCallbacks cbs;
 278:src/main.c    ****     memset(&cbs, 0, sizeof(cbs));
 279:src/main.c    ****     cbs.onSuccess = bench_on_success;
 280:src/main.c    ****     cbs.onError = bench_on_error;
 281:src/main.c    ****     s_benchStartMs = pd->system->getCurrentTimeMilliseconds();
 282:src/main.c    ****     PLUTO_LOG("[P07] bench start %s", BENCH_URLS[s_benchIdx]);
 283:src/main.c    ****     // Return value intentionally ignored: synchronous rejections still fire
 284:src/main.c    ****     // onError (which advances the chain).
 285:src/main.c    ****     hc_get(BENCH_URLS[s_benchIdx], &cbs);
 286:src/main.c    **** }
