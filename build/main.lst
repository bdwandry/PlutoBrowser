 390:Source/main.c **** /* ── renderBody (port): parse + Layout.build as a cooperative task ─────────
 391:Source/main.c **** static void render_body(const char *body, const char *url, int addToHistory);
 392:Source/main.c **** 
 393:Source/main.c **** /* renderBody task state (task-private continuation). */
 394:Source/main.c **** typedef struct RenderTask
 395:Source/main.c **** {
 396:Source/main.c ****     char *body;        /* malloc'd copy of the html to parse */
 397:Source/main.c ****     char url[512];
 398:Source/main.c ****     int addToHistory;
