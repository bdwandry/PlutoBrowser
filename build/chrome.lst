  20:Source/ui/chrome.c **** /* Lua string.sub(text, 1, 25) .. "..." equivalent (byte-based, as in Lua). */
  21:Source/ui/chrome.c **** static void truncate_ellipsis(const char *in, char *out, size_t cap,
  22:Source/ui/chrome.c ****                               size_t keep)
  23:Source/ui/chrome.c **** {
  24:Source/ui/chrome.c ****     size_t len = strlen(in);
  25:Source/ui/chrome.c ****     if (len <= keep + 3)
  26:Source/ui/chrome.c ****     {
  27:Source/ui/chrome.c ****         snprintf(out, cap, "%s", in);
  28:Source/ui/chrome.c ****         return;
  29:Source/ui/chrome.c ****     }
  30:Source/ui/chrome.c ****     snprintf(out, cap, "%.*s...", (int)keep, in);
  31:Source/ui/chrome.c **** }
