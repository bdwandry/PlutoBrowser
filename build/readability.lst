 109:Source/html/readability.c **** /* Lua tonumber() for width/height attributes: NULL/invalid -> fallback */
 110:Source/html/readability.c **** static double r_tonum_or(const char* s, double fallback) {
 111:Source/html/readability.c ****     if (s == NULL) return fallback;
 112:Source/html/readability.c ****     while (isspace((unsigned char)*s)) s++;
 113:Source/html/readability.c ****     char* end = NULL;
 114:Source/html/readability.c ****     double v = strtod(s, &end);
 115:Source/html/readability.c ****     if (end == s) return fallback;
 116:Source/html/readability.c ****     while (isspace((unsigned char)*end)) end++;
 117:Source/html/readability.c ****     if (*end != '\0') return fallback;
 118:Source/html/readability.c ****     return v;
 119:Source/html/readability.c **** }
