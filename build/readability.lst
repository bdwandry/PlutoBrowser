 157:src/html/readability.c **** /* full text of an inline-carrier block, trimmed (Lua flushBlock/addText) */
 158:src/html/readability.c **** static char* r_concat_text(const DocBlock* b) {
 159:src/html/readability.c ****     StrBuf sb;
 160:src/html/readability.c ****     sb_init(&sb);
 161:src/html/readability.c ****     for (size_t i = 0; i < b->nInlines; i++)
 162:src/html/readability.c ****         if (b->inlines[i].text != NULL)
 163:src/html/readability.c ****             sb_append_str(&sb, b->inlines[i].text);
 164:src/html/readability.c ****     char* out = sb_detach(&sb);
 165:src/html/readability.c ****     r_trim(out);
 166:src/html/readability.c ****     return out;
 167:src/html/readability.c **** }
