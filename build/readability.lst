 114:Source/html/readability.c **** /* Attribute lookup over a Token (value NULL when boolean-attr marker). */
 115:Source/html/readability.c **** static int rd_get_attr(const Token *tok, const char *key, const char **outVal)
 116:Source/html/readability.c **** {
 117:Source/html/readability.c ****     for (int i = 0; i < tok->attrCount; i++)
 118:Source/html/readability.c ****     {
 119:Source/html/readability.c ****         if (strcmp(tok->attrs[i].key, key) == 0)
 120:Source/html/readability.c ****         {
 121:Source/html/readability.c ****             const char *v = tok->attrs[i].value;
 122:Source/html/readability.c ****             *outVal = (v == PLUTO_TOK_ATTR_TRUE) ? "" : v;
 123:Source/html/readability.c ****             return 1;
 124:Source/html/readability.c ****         }
 125:Source/html/readability.c ****     }
 126:Source/html/readability.c ****     return 0;
 127:Source/html/readability.c **** }
