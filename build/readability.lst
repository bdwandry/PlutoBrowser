  58:Source/html/readability.c **** /* True when the text is just a bare URL/domain (e.g.
  59:Source/html/readability.c ****  * "en.wikipedia.org/wiki/Mesklin"). Such anchors only duplicate the target
  60:Source/html/readability.c ****  * address, so reader mode hides them (Safari-style reading). */
  61:Source/html/readability.c **** static int r_is_bare_url(const char* text) {
