 235:Source/html/readability.c **** /* Lua flushBlock */
 236:Source/html/readability.c **** static void r_flush(RD* s, DocBlock* b) {
 237:Source/html/readability.c ****     if (b == NULL) return;
 238:Source/html/readability.c ****     RContainer* c = r_cur(s);
 239:Source/html/readability.c ****     if (b->type == DB_HR || b->type == DB_IMAGE ||
 240:Source/html/readability.c ****         b->type == DB_INPUT_FIELD || b->type == DB_INPUT_SUBMIT) {
 241:Source/html/readability.c ****         r_cont_push_block(c, b);
 242:Source/html/readability.c ****         if (b->type == DB_IMAGE) c->imageCount++;
 243:Source/html/readability.c ****         return;
 244:Source/html/readability.c ****     }
 245:Source/html/readability.c **** 
 246:Source/html/readability.c ****     char* fullText = r_concat_text(b);
 247:Source/html/readability.c ****     int drop = (fullText[0] == '\0' && b->type != DB_CODE_BLOCK);
 248:Source/html/readability.c **** 
 249:Source/html/readability.c ****     if (!drop) {
 250:Source/html/readability.c ****         int wc = r_wordcount(fullText);
 251:Source/html/readability.c ****         c->wordCount += wc;
 252:Source/html/readability.c ****         c->textLen += (int)strlen(fullText);
 253:Source/html/readability.c ****         for (size_t i = 0; i < b->nInlines; i++)
 254:Source/html/readability.c ****             if (b->inlines[i].href != NULL)
 255:Source/html/readability.c ****                 c->linkWords += r_wordcount(b->inlines[i].text);
 256:Source/html/readability.c ****         r_cont_push_block(c, b);
 257:Source/html/readability.c ****     }
 258:Source/html/readability.c ****     pluto_free(fullText);
 259:Source/html/readability.c ****     if (drop) doc_free_block_fields(b);
 260:Source/html/readability.c **** }
 261:Source/html/readability.c **** 
 262:Source/html/readability.c **** static void r_commit(RD* s) {
 263:Source/html/readability.c ****     if (s->hasPending) {
 264:Source/html/readability.c ****         r_flush(s, &s->pending);
 265:Source/html/readability.c ****         s->hasPending = 0;
 266:Source/html/readability.c ****     }
 267:Source/html/readability.c **** }
 268:Source/html/readability.c **** 
 269:Source/html/readability.c **** static void r_ensure(RD* s) {
 270:Source/html/readability.c ****     if (s->hasPending) return;
 271:Source/html/readability.c ****     r_blk_init(&s->pending, s->inBlockquote ? DB_BLOCKQUOTE : DB_PARAGRAPH);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccOeRGS6.s 			page 12


 272:Source/html/readability.c ****     s->hasPending = 1;
 273:Source/html/readability.c **** }
 274:Source/html/readability.c **** 
 275:Source/html/readability.c **** static void r_add_text(RD* s, const char* text, size_t len) {
 276:Source/html/readability.c ****     if (s->stripDepth > 0) return;
 277:Source/html/readability.c ****     if (text == NULL || len == 0) return;
 278:Source/html/readability.c ****     char* t = pluto_strndup(text, len);
 279:Source/html/readability.c ****     if (t == NULL) return;
 280:Source/html/readability.c ****     if (!s->inPre) {
 281:Source/html/readability.c ****         /* [\r\n\t]+ -> " " */
 282:Source/html/readability.c ****         for (char* p = t; *p; p++) {
 283:Source/html/readability.c ****             if (*p == '\r' || *p == '\n' || *p == '\t') {
 284:Source/html/readability.c ****                 *p = ' ';
 285:Source/html/readability.c ****                 size_t r2 = (size_t)(p - t) + 1;
 286:Source/html/readability.c ****                 size_t w2 = r2;
 287:Source/html/readability.c ****                 while (t[r2] == '\r' || t[r2] == '\n' || t[r2] == '\t') r2++;
 288:Source/html/readability.c ****                 if (r2 > w2) memmove(t + w2, t + r2, strlen(t + r2) + 1);
 289:Source/html/readability.c ****             }
 290:Source/html/readability.c ****         }
 291:Source/html/readability.c ****     }
 292:Source/html/readability.c ****     if (t[0] == '\0' || (t[0] == ' ' && t[1] == '\0')) {
 293:Source/html/readability.c ****         pluto_free(t);
 294:Source/html/readability.c ****         return;
 295:Source/html/readability.c ****     }
 296:Source/html/readability.c ****     if (s->currentHref != NULL && r_is_bare_url(t)) {
 297:Source/html/readability.c ****         pluto_free(t);
 298:Source/html/readability.c ****         return;
 299:Source/html/readability.c ****     }
 300:Source/html/readability.c ****     r_ensure(s);
 301:Source/html/readability.c ****     DocInline in;
 302:Source/html/readability.c ****     memset(&in, 0, sizeof(in));
 303:Source/html/readability.c ****     in.type = DIT_TEXT;
 304:Source/html/readability.c ****     in.text = t;
 305:Source/html/readability.c ****     in.bold = (unsigned char)(s->isBold != 0);
 306:Source/html/readability.c ****     in.italic = (unsigned char)(s->isItalic != 0);
 307:Source/html/readability.c ****     in.code = (unsigned char)(s->isCode != 0);
 308:Source/html/readability.c ****     in.underline = (unsigned char)(s->currentHref != NULL);
 309:Source/html/readability.c ****     in.href = (s->currentHref != NULL) ? pluto_strdup(s->currentHref) : NULL;
 310:Source/html/readability.c ****     r_inl_push(&s->pending, &in);
 311:Source/html/readability.c **** }
