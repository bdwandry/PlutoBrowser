 644:Source/html/readability.c **** static int rd_ends_sentence(const char *s, size_t n)
 645:Source/html/readability.c **** {
 646:Source/html/readability.c ****     /* Lua: match(lastAccum, "[%.%?!%:]%s*$") — one terminator char then ws. */
 647:Source/html/readability.c ****     if (n == 0)
 648:Source/html/readability.c ****     {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccLtYndd.s 			page 14


 649:Source/html/readability.c ****         return 0;
 650:Source/html/readability.c ****     }
 651:Source/html/readability.c ****     size_t i = n;
 652:Source/html/readability.c ****     while (i > 0 && (s[i - 1] == ' ' || s[i - 1] == '\t'))
 653:Source/html/readability.c ****     {
 654:Source/html/readability.c ****         i--;
 655:Source/html/readability.c ****     }
 656:Source/html/readability.c ****     if (i == 0)
 657:Source/html/readability.c ****     {
 658:Source/html/readability.c ****         return 0;
 659:Source/html/readability.c ****     }
 660:Source/html/readability.c ****     char c = s[i - 1];
 661:Source/html/readability.c ****     return c == '.' || c == '?' || c == '!' || c == ':';
 662:Source/html/readability.c **** }
