 235:src/html/readability.c **** /* Lua flushBlock */
 236:src/html/readability.c **** static void r_flush(RD* s, DocBlock* b) {
 237:src/html/readability.c ****     if (b == NULL) return;
 238:src/html/readability.c ****     RContainer* c = r_cur(s);
 239:src/html/readability.c ****     if (b->type == DB_HR || b->type == DB_IMAGE ||
 240:src/html/readability.c ****         b->type == DB_INPUT_FIELD || b->type == DB_INPUT_SUBMIT) {
 241:src/html/readability.c ****         r_cont_push_block(c, b);
 242:src/html/readability.c ****         if (b->type == DB_IMAGE) c->imageCount++;
 243:src/html/readability.c ****         return;
 244:src/html/readability.c ****     }
 245:src/html/readability.c **** 
 246:src/html/readability.c ****     char* fullText = r_concat_text(b);
 247:src/html/readability.c ****     int drop = (fullText[0] == '\0' && b->type != DB_CODE_BLOCK);
 248:src/html/readability.c **** 
 249:src/html/readability.c ****     if (!drop) {
 250:src/html/readability.c ****         int wc = r_wordcount(fullText);
 251:src/html/readability.c ****         c->wordCount += wc;
 252:src/html/readability.c ****         c->textLen += (int)strlen(fullText);
 253:src/html/readability.c ****         for (size_t i = 0; i < b->nInlines; i++)
 254:src/html/readability.c ****             if (b->inlines[i].href != NULL)
 255:src/html/readability.c ****                 c->linkWords += r_wordcount(b->inlines[i].text);
 256:src/html/readability.c ****         r_cont_push_block(c, b);
 257:src/html/readability.c ****     }
 258:src/html/readability.c ****     pluto_free(fullText);
 259:src/html/readability.c ****     if (drop) doc_free_block_fields(b);
 260:src/html/readability.c **** }
 261:src/html/readability.c **** 
 262:src/html/readability.c **** static void r_commit(RD* s) {
 263:src/html/readability.c ****     if (s->hasPending) {
 264:src/html/readability.c ****         r_flush(s, &s->pending);
 265:src/html/readability.c ****         s->hasPending = 0;
 266:src/html/readability.c ****     }
 267:src/html/readability.c **** }
 268:src/html/readability.c **** 
 269:src/html/readability.c **** static void r_ensure(RD* s) {
 270:src/html/readability.c ****     if (s->hasPending) return;
 271:src/html/readability.c ****     r_blk_init(&s->pending, s->inBlockquote ? DB_BLOCKQUOTE : DB_PARAGRAPH);
 272:src/html/readability.c ****     s->hasPending = 1;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccXlHInx.s 			page 12


 273:src/html/readability.c **** }
 274:src/html/readability.c **** 
 275:src/html/readability.c **** static void r_add_text(RD* s, const char* text, size_t len) {
 276:src/html/readability.c ****     if (s->stripDepth > 0) return;
 277:src/html/readability.c ****     if (text == NULL || len == 0) return;
 278:src/html/readability.c ****     char* t = pluto_strndup(text, len);
 279:src/html/readability.c ****     if (t == NULL) return;
 280:src/html/readability.c ****     if (!s->inPre) {
 281:src/html/readability.c ****         /* [\r\n\t]+ -> " " */
 282:src/html/readability.c ****         for (char* p = t; *p; p++) {
 283:src/html/readability.c ****             if (*p == '\r' || *p == '\n' || *p == '\t') {
 284:src/html/readability.c ****                 *p = ' ';
 285:src/html/readability.c ****                 size_t r2 = (size_t)(p - t) + 1;
 286:src/html/readability.c ****                 size_t w2 = r2;
 287:src/html/readability.c ****                 while (t[r2] == '\r' || t[r2] == '\n' || t[r2] == '\t') r2++;
 288:src/html/readability.c ****                 if (r2 > w2) memmove(t + w2, t + r2, strlen(t + r2) + 1);
 289:src/html/readability.c ****             }
 290:src/html/readability.c ****         }
 291:src/html/readability.c ****     }
 292:src/html/readability.c ****     if (t[0] == '\0' || (t[0] == ' ' && t[1] == '\0')) {
 293:src/html/readability.c ****         pluto_free(t);
 294:src/html/readability.c ****         return;
 295:src/html/readability.c ****     }
 296:src/html/readability.c ****     if (s->currentHref != NULL && r_is_bare_url(t)) {
 297:src/html/readability.c ****         pluto_free(t);
 298:src/html/readability.c ****         return;
 299:src/html/readability.c ****     }
 300:src/html/readability.c ****     r_ensure(s);
 301:src/html/readability.c ****     DocInline in;
 302:src/html/readability.c ****     memset(&in, 0, sizeof(in));
 303:src/html/readability.c ****     in.type = DIT_TEXT;
 304:src/html/readability.c ****     in.text = t;
 305:src/html/readability.c ****     in.bold = (unsigned char)(s->isBold != 0);
 306:src/html/readability.c ****     in.italic = (unsigned char)(s->isItalic != 0);
 307:src/html/readability.c ****     in.code = (unsigned char)(s->isCode != 0);
 308:src/html/readability.c ****     in.underline = (unsigned char)(s->currentHref != NULL);
 309:src/html/readability.c ****     in.href = (s->currentHref != NULL) ? pluto_strdup(s->currentHref) : NULL;
 310:src/html/readability.c ****     r_inl_push(&s->pending, &in);
 311:src/html/readability.c **** }
 312:src/html/readability.c **** 
 313:src/html/readability.c **** static void r_push_container(RD* s, int isContent, int isNav) {
 314:src/html/readability.c ****     r_commit(s);
 315:src/html/readability.c ****     if (s->nConts == s->capConts) {
 316:src/html/readability.c ****         size_t nc = s->capConts ? s->capConts * 2 : 4;
 317:src/html/readability.c ****         RContainer* ns =
 318:src/html/readability.c ****             (RContainer*)pluto_realloc(s->conts, nc * sizeof(RContainer));
 319:src/html/readability.c ****         if (ns == NULL) return;
 320:src/html/readability.c ****         s->conts = ns;
 321:src/html/readability.c ****         s->capConts = nc;
 322:src/html/readability.c ****     }
 323:src/html/readability.c ****     RContainer* c = &s->conts[s->nConts++];
 324:src/html/readability.c ****     memset(c, 0, sizeof(*c));
