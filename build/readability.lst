 157:Source/html/readability.c **** /* full text of an inline-carrier block, trimmed (Lua flushBlock/addText) */
 158:Source/html/readability.c **** static char* r_concat_text(const DocBlock* b) {
 159:Source/html/readability.c ****     StrBuf sb;
 160:Source/html/readability.c ****     sb_init(&sb);
 161:Source/html/readability.c ****     for (size_t i = 0; i < b->nInlines; i++)
 162:Source/html/readability.c ****         if (b->inlines[i].text != NULL)
 163:Source/html/readability.c ****             sb_append_str(&sb, b->inlines[i].text);
 164:Source/html/readability.c ****     char* out = sb_detach(&sb);
 165:Source/html/readability.c ****     r_trim(out);
 166:Source/html/readability.c ****     return out;
 167:Source/html/readability.c **** }
