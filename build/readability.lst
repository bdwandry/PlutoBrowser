 156:Source/html/readability.c **** /* Lua wordCount: count of %S+ runs. */
 157:Source/html/readability.c **** static int rd_word_count(const char *s, size_t len)
 158:Source/html/readability.c **** {
 159:Source/html/readability.c ****     if (!s || len == 0)
 160:Source/html/readability.c ****     {
 161:Source/html/readability.c ****         return 0;
 162:Source/html/readability.c ****     }
 163:Source/html/readability.c ****     int count = 0;
 164:Source/html/readability.c ****     int inWord = 0;
 165:Source/html/readability.c ****     for (size_t i = 0; i < len; i++)
 166:Source/html/readability.c ****     {
 167:Source/html/readability.c ****         unsigned char c = (unsigned char)s[i];
 168:Source/html/readability.c ****         int isSpace = (c == ' ' || c == '\t' || c == '\r' || c == '\n' ||
 169:Source/html/readability.c ****                        c == '\f' || c == '\v');
 170:Source/html/readability.c ****         if (!isSpace && !inWord)
 171:Source/html/readability.c ****         {
 172:Source/html/readability.c ****             count++;
 173:Source/html/readability.c ****             inWord = 1;
 174:Source/html/readability.c ****         }
 175:Source/html/readability.c ****         else if (isSpace)
 176:Source/html/readability.c ****         {
 177:Source/html/readability.c ****             inWord = 0;
 178:Source/html/readability.c ****         }
 179:Source/html/readability.c ****     }
 180:Source/html/readability.c ****     return count;
 181:Source/html/readability.c **** }
