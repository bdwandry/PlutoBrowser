 109:src/html/readability.c **** /* Lua tonumber() for width/height attributes: NULL/invalid -> fallback */
 110:src/html/readability.c **** static double r_tonum_or(const char* s, double fallback) {
 111:src/html/readability.c ****     if (s == NULL) return fallback;
 112:src/html/readability.c ****     while (isspace((unsigned char)*s)) s++;
 113:src/html/readability.c ****     char* end = NULL;
 114:src/html/readability.c ****     double v = strtod(s, &end);
 115:src/html/readability.c ****     if (end == s) return fallback;
 116:src/html/readability.c ****     while (isspace((unsigned char)*end)) end++;
 117:src/html/readability.c ****     if (*end != '\0') return fallback;
 118:src/html/readability.c ****     return v;
 119:src/html/readability.c **** }
