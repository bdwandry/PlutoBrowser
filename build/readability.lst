 145:src/html/readability.c **** static void r_inl_push(DocBlock* b, const DocInline* in) {
 146:src/html/readability.c ****     if (b->nInlines == b->capInlines) {
 147:src/html/readability.c ****         size_t nc = b->capInlines ? b->capInlines * 2 : 4;
 148:src/html/readability.c ****         DocInline* ni =
 149:src/html/readability.c ****             (DocInline*)pluto_realloc(b->inlines, nc * sizeof(DocInline));
 150:src/html/readability.c ****         if (ni == NULL) return;
 151:src/html/readability.c ****         b->inlines = ni;
 152:src/html/readability.c ****         b->capInlines = nc;
 153:src/html/readability.c ****     }
 154:src/html/readability.c ****     b->inlines[b->nInlines++] = *in;
 155:src/html/readability.c **** }
