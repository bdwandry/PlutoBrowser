 313:Source/html/readability.c **** static void r_push_container(RD* s, int isContent, int isNav) {
 314:Source/html/readability.c ****     r_commit(s);
 315:Source/html/readability.c ****     if (s->nConts == s->capConts) {
 316:Source/html/readability.c ****         size_t nc = s->capConts ? s->capConts * 2 : 4;
 317:Source/html/readability.c ****         RContainer* ns =
 318:Source/html/readability.c ****             (RContainer*)pluto_realloc(s->conts, nc * sizeof(RContainer));
 319:Source/html/readability.c ****         if (ns == NULL) return;
 320:Source/html/readability.c ****         s->conts = ns;
 321:Source/html/readability.c ****         s->capConts = nc;
 322:Source/html/readability.c ****     }
 323:Source/html/readability.c ****     RContainer* c = &s->conts[s->nConts++];
