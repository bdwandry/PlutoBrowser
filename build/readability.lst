  58:src/html/readability.c **** /* True when the text is just a bare URL/domain (e.g.
  59:src/html/readability.c ****  * "en.wikipedia.org/wiki/Mesklin"). Such anchors only duplicate the target
  60:src/html/readability.c ****  * address, so reader mode hides them (Safari-style reading). */
  61:src/html/readability.c **** static int r_is_bare_url(const char* text) {
  62:src/html/readability.c ****     if (text == NULL) return 0;
  63:src/html/readability.c ****     char* t = pluto_strdup(text);
  64:src/html/readability.c ****     if (t == NULL) return 0;
  65:src/html/readability.c ****     size_t n = r_trim(t);
  66:src/html/readability.c ****     if (n == 0) {
  67:src/html/readability.c ****         pluto_free(t);
  68:src/html/readability.c ****         return 0;
  69:src/html/readability.c ****     }
  70:src/html/readability.c ****     for (size_t i = 0; i < n; i++) {
  71:src/html/readability.c ****         if (isspace((unsigned char)t[i])) {
  72:src/html/readability.c ****             pluto_free(t);
  73:src/html/readability.c ****             return 0;
  74:src/html/readability.c ****         }
  75:src/html/readability.c ****     }
  76:src/html/readability.c ****     int bare = 0;
  77:src/html/readability.c ****     if ((strncmp(t, "http://", 7) == 0 || strncmp(t, "https://", 8) == 0)) {
  78:src/html/readability.c ****         bare = 1; /* rest already verified space-free above */
  79:src/html/readability.c ****     } else {
  80:src/html/readability.c ****         /* ^[a-zA-Z0-9][a-zA-Z0-9%-%.]*%.[a-zA-Z][a-zA-Z0-9%-]*
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccXlHInx.s 			page 4


  81:src/html/readability.c ****          * ([/%?][^%s]*)?$  -- the leading run is greedy, so candidate dots
  82:src/html/readability.c ****          * are tried right-to-left like regex backtracking would */
  83:src/html/readability.c ****         if (isalnum((unsigned char)t[0])) {
  84:src/html/readability.c ****             size_t runEnd = 1;
  85:src/html/readability.c ****             while (isalnum((unsigned char)t[runEnd]) ||
  86:src/html/readability.c ****                    t[runEnd] == '-' || t[runEnd] == '.')
  87:src/html/readability.c ****                 runEnd++;
  88:src/html/readability.c ****             for (size_t j = runEnd; j-- > 1;) {
  89:src/html/readability.c ****                 if (t[j] != '.') continue;
  90:src/html/readability.c ****                 if (!isalpha((unsigned char)t[j + 1])) continue;
  91:src/html/readability.c ****                 size_t k = j + 2;
  92:src/html/readability.c ****                 while (isalnum((unsigned char)t[k]) || t[k] == '-') k++;
  93:src/html/readability.c ****                 if (t[k] == '\0') {
  94:src/html/readability.c ****                     bare = 1;
  95:src/html/readability.c ****                 } else if (t[k] == '/' || t[k] == '?') {
  96:src/html/readability.c ****                     bare = 1;
  97:src/html/readability.c ****                     for (; t[k]; k++) {
  98:src/html/readability.c ****                         if (isspace((unsigned char)t[k])) bare = 0;
  99:src/html/readability.c ****                     }
 100:src/html/readability.c ****                 }
 101:src/html/readability.c ****                 break; /* rightmost dot inside the run decided the outcome */
 102:src/html/readability.c ****             }
 103:src/html/readability.c ****         }
 104:src/html/readability.c ****     }
 105:src/html/readability.c ****     pluto_free(t);
 106:src/html/readability.c ****     return bare;
 107:src/html/readability.c **** }
