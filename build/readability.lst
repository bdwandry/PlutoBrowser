  46:Source/html/readability.c **** static void *rd_arena_alloc(RdArena *a, size_t n)
  47:Source/html/readability.c **** {
  48:Source/html/readability.c ****     n = (n + 7u) & ~(size_t)7u;
  49:Source/html/readability.c ****     if (a->head && a->head->used + n <= a->head->cap)
  50:Source/html/readability.c ****     {
  51:Source/html/readability.c ****         void *p = (char *)a->head + sizeof(RdChunk) + a->head->used;
  52:Source/html/readability.c ****         a->head->used += n;
  53:Source/html/readability.c ****         return p;
  54:Source/html/readability.c ****     }
  55:Source/html/readability.c ****     size_t c = n > 4096 ? n : 4096;
  56:Source/html/readability.c ****     RdChunk *ch = (RdChunk *)PLUTO_MALLOC(sizeof(RdChunk) + c);
  57:Source/html/readability.c ****     if (!ch)
  58:Source/html/readability.c ****     {
  59:Source/html/readability.c ****         return NULL;
  60:Source/html/readability.c ****     }
  61:Source/html/readability.c ****     ch->next = a->head;
  62:Source/html/readability.c ****     ch->used = 0;
  63:Source/html/readability.c ****     ch->cap = c;
  64:Source/html/readability.c ****     a->head = ch;
  65:Source/html/readability.c ****     void *p = (char *)ch + sizeof(RdChunk);
  66:Source/html/readability.c ****     ch->used = n;
  67:Source/html/readability.c ****     return p;
  68:Source/html/readability.c **** }
