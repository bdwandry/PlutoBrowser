  80:Source/html/readability.c ****         /* ^[a-zA-Z0-9][a-zA-Z0-9%-%.]*%.[a-zA-Z][a-zA-Z0-9%-]*
  81:Source/html/readability.c ****          * ([/%?][^%s]*)?$  -- the leading run is greedy, so candidate dots
  82:Source/html/readability.c ****          * are tried right-to-left like regex backtracking would */
  83:Source/html/readability.c ****         if (isalnum((unsigned char)t[0])) {
  84:Source/html/readability.c ****             size_t runEnd = 1;
  85:Source/html/readability.c ****             while (isalnum((unsigned char)t[runEnd]) ||
  86:Source/html/readability.c ****                    t[runEnd] == '-' || t[runEnd] == '.')
  87:Source/html/readability.c ****                 runEnd++;
  88:Source/html/readability.c ****             for (size_t j = runEnd; j-- > 1;) {
  89:Source/html/readability.c ****                 if (t[j] != '.') continue;
  90:Source/html/readability.c ****                 if (!isalpha((unsigned char)t[j + 1])) continue;
  91:Source/html/readability.c ****                 size_t k = j + 2;
  92:Source/html/readability.c ****                 while (isalnum((unsigned char)t[k]) || t[k] == '-') k++;
  93:Source/html/readability.c ****                 if (t[k] == '\0') {
  94:Source/html/readability.c ****                     bare = 1;
  95:Source/html/readability.c ****                 } else if (t[k] == '/' || t[k] == '?') {
  96:Source/html/readability.c ****                     bare = 1;
  97:Source/html/readability.c ****                     for (; t[k]; k++) {
  98:Source/html/readability.c ****                         if (isspace((unsigned char)t[k])) bare = 0;
  99:Source/html/readability.c ****                     }
 100:Source/html/readability.c ****                 }
 101:Source/html/readability.c ****                 break; /* rightmost dot inside the run decided the outcome */
 102:Source/html/readability.c ****             }
 103:Source/html/readability.c ****         }
 104:Source/html/readability.c ****     }
 105:Source/html/readability.c ****     pluto_free(t);
 106:Source/html/readability.c ****     return bare;
 107:Source/html/readability.c **** }
