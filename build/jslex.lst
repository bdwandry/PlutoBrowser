 518:Source/js/jslex.c **** 		if (jsY_accept(J, 'g')) ++g;
 519:Source/js/jslex.c **** 		else if (jsY_accept(J, 'i')) ++i;
 520:Source/js/jslex.c **** 		else if (jsY_accept(J, 'm')) ++m;
 521:Source/js/jslex.c **** 		else jsY_error(J, "illegal flag in regular expression: %c", J->lexchar);
 522:Source/js/jslex.c **** 	}
 523:Source/js/jslex.c **** 
 524:Source/js/jslex.c **** 	if (g > 1 || i > 1 || m > 1)
 525:Source/js/jslex.c **** 		jsY_error(J, "duplicated flag in regular expression");
 526:Source/js/jslex.c **** 
 527:Source/js/jslex.c **** 	J->text = s;
 528:Source/js/jslex.c **** 
 529:Source/js/jslex.c **** 	flags = 0;
 530:Source/js/jslex.c **** 	if (g) flags |= JS_REGEXP_G;
 531:Source/js/jslex.c **** 	if (i) flags |= JS_REGEXP_I;
 532:Source/js/jslex.c **** 	if (m) flags |= JS_REGEXP_M;
 533:Source/js/jslex.c **** 	J->number = flags;
 534:Source/js/jslex.c **** 	return TK_REGEXP;
 535:Source/js/jslex.c **** }
