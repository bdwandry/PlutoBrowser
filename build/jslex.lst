 747:Source/js/jslex.c **** static int lexjsonnumber(js_State *J)
 748:Source/js/jslex.c **** {
 749:Source/js/jslex.c **** 	const char *s = J->source - 1;
 750:Source/js/jslex.c **** 
 751:Source/js/jslex.c **** 	if (J->lexchar == '-')
 752:Source/js/jslex.c **** 		jsY_next(J);
 753:Source/js/jslex.c **** 
 754:Source/js/jslex.c **** 	if (J->lexchar == '0')
 755:Source/js/jslex.c **** 		jsY_next(J);
 756:Source/js/jslex.c **** 	else if (J->lexchar >= '1' && J->lexchar <= '9')
 757:Source/js/jslex.c **** 		while (isdigit(J->lexchar))
 758:Source/js/jslex.c **** 			jsY_next(J);
 759:Source/js/jslex.c **** 	else
 760:Source/js/jslex.c **** 		jsY_error(J, "unexpected non-digit");
 761:Source/js/jslex.c **** 
 762:Source/js/jslex.c **** 	if (jsY_accept(J, '.')) {
 763:Source/js/jslex.c **** 		if (isdigit(J->lexchar))
 764:Source/js/jslex.c **** 			while (isdigit(J->lexchar))
 765:Source/js/jslex.c **** 				jsY_next(J);
 766:Source/js/jslex.c **** 		else
 767:Source/js/jslex.c **** 			jsY_error(J, "missing digits after decimal point");
 768:Source/js/jslex.c **** 	}
 769:Source/js/jslex.c **** 
 770:Source/js/jslex.c **** 	if (jsY_accept(J, 'e') || jsY_accept(J, 'E')) {
 771:Source/js/jslex.c **** 		if (J->lexchar == '-' || J->lexchar == '+')
 772:Source/js/jslex.c **** 			jsY_next(J);
 773:Source/js/jslex.c **** 		if (isdigit(J->lexchar))
 774:Source/js/jslex.c **** 			while (isdigit(J->lexchar))
 775:Source/js/jslex.c **** 				jsY_next(J);
 776:Source/js/jslex.c **** 		else
 777:Source/js/jslex.c **** 			jsY_error(J, "missing digits after exponent indicator");
 778:Source/js/jslex.c **** 	}
 779:Source/js/jslex.c **** 
 780:Source/js/jslex.c **** 	J->number = js_strtod(s, NULL);
 781:Source/js/jslex.c **** 	return TK_NUMBER;
 782:Source/js/jslex.c **** }
