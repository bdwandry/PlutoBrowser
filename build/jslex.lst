 148:Source/js/jslex.c **** 
 149:Source/js/jslex.c **** int jsY_tohex(int c)
 150:Source/js/jslex.c **** {
 151:Source/js/jslex.c **** 	if (c >= '0' && c <= '9') return c - '0';
 152:Source/js/jslex.c **** 	if (c >= 'a' && c <= 'f') return c - 'a' + 0xA;
 153:Source/js/jslex.c **** 	if (c >= 'A' && c <= 'F') return c - 'A' + 0xA;
 154:Source/js/jslex.c **** 	return 0;
 155:Source/js/jslex.c **** }
