  81:Source/js/jslex.c **** int jsY_findword(const char *s, const char **list, int num)
  82:Source/js/jslex.c **** {
  83:Source/js/jslex.c **** 	int l = 0;
  84:Source/js/jslex.c **** 	int r = num - 1;
  85:Source/js/jslex.c **** 	while (l <= r) {
  86:Source/js/jslex.c **** 		int m = (l + r) >> 1;
  87:Source/js/jslex.c **** 		int c = strcmp(s, list[m]);
  88:Source/js/jslex.c **** 		if (c < 0)
  89:Source/js/jslex.c **** 			r = m - 1;
  90:Source/js/jslex.c **** 		else if (c > 0)
  91:Source/js/jslex.c **** 			l = m + 1;
  92:Source/js/jslex.c **** 		else
  93:Source/js/jslex.c **** 			return m;
  94:Source/js/jslex.c **** 	}
  95:Source/js/jslex.c **** 	return -1;
  96:Source/js/jslex.c **** }
  97:Source/js/jslex.c **** 
  98:Source/js/jslex.c **** static int jsY_findkeyword(js_State *J, const char *s)
  99:Source/js/jslex.c **** {
 100:Source/js/jslex.c **** 	int i = jsY_findword(s, keywords, nelem(keywords));
 101:Source/js/jslex.c **** 	if (i >= 0) {
 102:Source/js/jslex.c **** 		J->text = keywords[i];
 103:Source/js/jslex.c **** 		return TK_BREAK + i; /* first keyword + i */
 104:Source/js/jslex.c **** 	}
 105:Source/js/jslex.c **** 	J->text = s;
 106:Source/js/jslex.c **** 	return TK_IDENTIFIER;
 107:Source/js/jslex.c **** }
