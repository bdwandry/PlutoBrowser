 429:Source/js/jslex.c **** static int lexstring(js_State *J)
 430:Source/js/jslex.c **** {
 431:Source/js/jslex.c **** 	const char *s;
 432:Source/js/jslex.c **** 
 433:Source/js/jslex.c **** 	int q = J->lexchar;
 434:Source/js/jslex.c **** 	jsY_next(J);
 435:Source/js/jslex.c **** 
 436:Source/js/jslex.c **** 	textinit(J);
 437:Source/js/jslex.c **** 
 438:Source/js/jslex.c **** 	while (J->lexchar != q) {
 439:Source/js/jslex.c **** 		if (J->lexchar == EOF || J->lexchar == '\n')
 440:Source/js/jslex.c **** 			jsY_error(J, "string not terminated");
 441:Source/js/jslex.c **** 		if (jsY_accept(J, '\\')) {
 442:Source/js/jslex.c **** 			if (lexescape(J))
 443:Source/js/jslex.c **** 				jsY_error(J, "malformed escape sequence");
 444:Source/js/jslex.c **** 		} else {
 445:Source/js/jslex.c **** 			textpush(J, J->lexchar);
 446:Source/js/jslex.c **** 			jsY_next(J);
 447:Source/js/jslex.c **** 		}
 448:Source/js/jslex.c **** 	}
 449:Source/js/jslex.c **** 	jsY_expect(J, q);
 450:Source/js/jslex.c **** 
 451:Source/js/jslex.c **** 	s = textend(J);
 452:Source/js/jslex.c **** 
 453:Source/js/jslex.c **** 	J->text = s;
 454:Source/js/jslex.c **** 	return TK_STRING;
 455:Source/js/jslex.c **** }
