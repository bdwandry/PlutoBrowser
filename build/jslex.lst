 812:Source/js/jslex.c **** static int lexjsonstring(js_State *J)
 813:Source/js/jslex.c **** {
 814:Source/js/jslex.c **** 	const char *s;
 815:Source/js/jslex.c **** 
 816:Source/js/jslex.c **** 	textinit(J);
 817:Source/js/jslex.c **** 
 818:Source/js/jslex.c **** 	while (J->lexchar != '"') {
 819:Source/js/jslex.c **** 		if (J->lexchar == EOF)
 820:Source/js/jslex.c **** 			jsY_error(J, "unterminated string");
 821:Source/js/jslex.c **** 		else if (J->lexchar < 32)
 822:Source/js/jslex.c **** 			jsY_error(J, "invalid control character in string");
 823:Source/js/jslex.c **** 		else if (jsY_accept(J, '\\'))
 824:Source/js/jslex.c **** 			lexjsonescape(J);
 825:Source/js/jslex.c **** 		else {
 826:Source/js/jslex.c **** 			textpush(J, J->lexchar);
 827:Source/js/jslex.c **** 			jsY_next(J);
 828:Source/js/jslex.c **** 		}
 829:Source/js/jslex.c **** 	}
 830:Source/js/jslex.c **** 	jsY_expect(J, '"');
 831:Source/js/jslex.c **** 
 832:Source/js/jslex.c **** 	s = textend(J);
 833:Source/js/jslex.c **** 
 834:Source/js/jslex.c **** 	J->text = s;
 835:Source/js/jslex.c **** 	return TK_STRING;
 836:Source/js/jslex.c **** }
