 457:Source/js/jslex.c **** /* the ugliest language wart ever... */
 458:Source/js/jslex.c **** static int isregexpcontext(int last)
 459:Source/js/jslex.c **** {
 460:Source/js/jslex.c **** 	switch (last) {
 461:Source/js/jslex.c **** 	case ']':
 462:Source/js/jslex.c **** 	case ')':
 463:Source/js/jslex.c **** 	case '}':
 464:Source/js/jslex.c **** 	case TK_IDENTIFIER:
 465:Source/js/jslex.c **** 	case TK_NUMBER:
 466:Source/js/jslex.c **** 	case TK_STRING:
 467:Source/js/jslex.c **** 	case TK_FALSE:
 468:Source/js/jslex.c **** 	case TK_NULL:
 469:Source/js/jslex.c **** 	case TK_THIS:
 470:Source/js/jslex.c **** 	case TK_TRUE:
 471:Source/js/jslex.c **** 		return 0;
 472:Source/js/jslex.c **** 	default:
 473:Source/js/jslex.c **** 		return 1;
 474:Source/js/jslex.c **** 	}
 475:Source/js/jslex.c **** }
