 179:Source/js/jslex.c **** static void jsY_unescape(js_State *J)
 180:Source/js/jslex.c **** {
 181:Source/js/jslex.c **** 	if (jsY_accept(J, '\\')) {
 182:Source/js/jslex.c **** 		if (jsY_accept(J, 'u')) {
 183:Source/js/jslex.c **** 			int x = 0;
 184:Source/js/jslex.c **** 			if (!jsY_ishex(J->lexchar)) { goto error; } x |= jsY_tohex(J->lexchar) << 12; jsY_next(J);
 185:Source/js/jslex.c **** 			if (!jsY_ishex(J->lexchar)) { goto error; } x |= jsY_tohex(J->lexchar) << 8; jsY_next(J);
 186:Source/js/jslex.c **** 			if (!jsY_ishex(J->lexchar)) { goto error; } x |= jsY_tohex(J->lexchar) << 4; jsY_next(J);
 187:Source/js/jslex.c **** 			if (!jsY_ishex(J->lexchar)) { goto error; } x |= jsY_tohex(J->lexchar);
 188:Source/js/jslex.c **** 			J->lexchar = x;
 189:Source/js/jslex.c **** 			return;
