 234:Source/js/jslex.c **** 
 235:Source/js/jslex.c **** static int lexcomment(js_State *J)
 236:Source/js/jslex.c **** {
 237:Source/js/jslex.c **** 	/* already consumed initial '/' '*' sequence */
 238:Source/js/jslex.c **** 	while (J->lexchar != EOF) {
 239:Source/js/jslex.c **** 		if (jsY_accept(J, '*')) {
 240:Source/js/jslex.c **** 			while (J->lexchar == '*')
 241:Source/js/jslex.c **** 				jsY_next(J);
 242:Source/js/jslex.c **** 			if (jsY_accept(J, '/'))
 243:Source/js/jslex.c **** 				return 0;
 244:Source/js/jslex.c **** 		}
 245:Source/js/jslex.c **** 		else
 246:Source/js/jslex.c **** 			jsY_next(J);
 247:Source/js/jslex.c **** 	}
 248:Source/js/jslex.c **** 	return -1;
 249:Source/js/jslex.c **** }
 250:Source/js/jslex.c **** 
 251:Source/js/jslex.c **** static double lexhex(js_State *J)
 252:Source/js/jslex.c **** {
 253:Source/js/jslex.c **** 	double n = 0;
 254:Source/js/jslex.c **** 	if (!jsY_ishex(J->lexchar))
 255:Source/js/jslex.c **** 		jsY_error(J, "malformed hexadecimal number");
 256:Source/js/jslex.c **** 	while (jsY_ishex(J->lexchar)) {
 257:Source/js/jslex.c **** 		n = n * 16 + jsY_tohex(J->lexchar);
 258:Source/js/jslex.c **** 		jsY_next(J);
 259:Source/js/jslex.c **** 	}
 260:Source/js/jslex.c **** 	return n;
 261:Source/js/jslex.c **** }
 262:Source/js/jslex.c **** 
 263:Source/js/jslex.c **** #if 0
 264:Source/js/jslex.c **** 
 265:Source/js/jslex.c **** static double lexinteger(js_State *J)
 266:Source/js/jslex.c **** {
 267:Source/js/jslex.c **** 	double n = 0;
 268:Source/js/jslex.c **** 	if (!jsY_isdec(J->lexchar))
 269:Source/js/jslex.c **** 		jsY_error(J, "malformed number");
 270:Source/js/jslex.c **** 	while (jsY_isdec(J->lexchar)) {
 271:Source/js/jslex.c **** 		n = n * 10 + (J->lexchar - '0');
 272:Source/js/jslex.c **** 		jsY_next(J);
 273:Source/js/jslex.c **** 	}
 274:Source/js/jslex.c **** 	return n;
 275:Source/js/jslex.c **** }
 276:Source/js/jslex.c **** 
 277:Source/js/jslex.c **** static double lexfraction(js_State *J)
 278:Source/js/jslex.c **** {
 279:Source/js/jslex.c **** 	double n = 0;
 280:Source/js/jslex.c **** 	double d = 1;
 281:Source/js/jslex.c **** 	while (jsY_isdec(J->lexchar)) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc4VxbgK.s 			page 29


 282:Source/js/jslex.c **** 		n = n * 10 + (J->lexchar - '0');
 283:Source/js/jslex.c **** 		d = d * 10;
 284:Source/js/jslex.c **** 		jsY_next(J);
 285:Source/js/jslex.c **** 	}
 286:Source/js/jslex.c **** 	return n / d;
 287:Source/js/jslex.c **** }
 288:Source/js/jslex.c **** 
 289:Source/js/jslex.c **** static double lexexponent(js_State *J)
 290:Source/js/jslex.c **** {
 291:Source/js/jslex.c **** 	double sign;
 292:Source/js/jslex.c **** 	if (jsY_accept(J, 'e') || jsY_accept(J, 'E')) {
 293:Source/js/jslex.c **** 		if (jsY_accept(J, '-')) sign = -1;
 294:Source/js/jslex.c **** 		else if (jsY_accept(J, '+')) sign = 1;
 295:Source/js/jslex.c **** 		else sign = 1;
 296:Source/js/jslex.c **** 		return sign * lexinteger(J);
 297:Source/js/jslex.c **** 	}
 298:Source/js/jslex.c **** 	return 0;
 299:Source/js/jslex.c **** }
 300:Source/js/jslex.c **** 
 301:Source/js/jslex.c **** static int lexnumber(js_State *J)
 302:Source/js/jslex.c **** {
 303:Source/js/jslex.c **** 	double n;
 304:Source/js/jslex.c **** 	double e;
 305:Source/js/jslex.c **** 
 306:Source/js/jslex.c **** 	if (jsY_accept(J, '0')) {
 307:Source/js/jslex.c **** 		if (jsY_accept(J, 'x') || jsY_accept(J, 'X')) {
 308:Source/js/jslex.c **** 			J->number = lexhex(J);
 309:Source/js/jslex.c **** 			return TK_NUMBER;
 310:Source/js/jslex.c **** 		}
 311:Source/js/jslex.c **** 		if (jsY_isdec(J->lexchar))
 312:Source/js/jslex.c **** 			jsY_error(J, "number with leading zero");
 313:Source/js/jslex.c **** 		n = 0;
 314:Source/js/jslex.c **** 		if (jsY_accept(J, '.'))
 315:Source/js/jslex.c **** 			n += lexfraction(J);
 316:Source/js/jslex.c **** 	} else if (jsY_accept(J, '.')) {
 317:Source/js/jslex.c **** 		if (!jsY_isdec(J->lexchar))
 318:Source/js/jslex.c **** 			return '.';
 319:Source/js/jslex.c **** 		n = lexfraction(J);
 320:Source/js/jslex.c **** 	} else {
 321:Source/js/jslex.c **** 		n = lexinteger(J);
 322:Source/js/jslex.c **** 		if (jsY_accept(J, '.'))
 323:Source/js/jslex.c **** 			n += lexfraction(J);
 324:Source/js/jslex.c **** 	}
 325:Source/js/jslex.c **** 
 326:Source/js/jslex.c **** 	e = lexexponent(J);
 327:Source/js/jslex.c **** 	if (e < 0)
 328:Source/js/jslex.c **** 		n /= pow(10, -e);
 329:Source/js/jslex.c **** 	else if (e > 0)
 330:Source/js/jslex.c **** 		n *= pow(10, e);
 331:Source/js/jslex.c **** 
 332:Source/js/jslex.c **** 	if (jsY_isidentifierstart(J->lexchar))
 333:Source/js/jslex.c **** 		jsY_error(J, "number with letter suffix");
 334:Source/js/jslex.c **** 
 335:Source/js/jslex.c **** 	J->number = n;
 336:Source/js/jslex.c **** 	return TK_NUMBER;
 337:Source/js/jslex.c **** }
