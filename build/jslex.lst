 389:Source/js/jslex.c **** static int lexescape(js_State *J)
 390:Source/js/jslex.c **** {
 391:Source/js/jslex.c **** 	int x = 0;
 392:Source/js/jslex.c **** 
 393:Source/js/jslex.c **** 	/* already consumed '\' */
 394:Source/js/jslex.c **** 
 395:Source/js/jslex.c **** 	if (jsY_accept(J, '\n'))
 396:Source/js/jslex.c **** 		return 0;
 397:Source/js/jslex.c **** 
 398:Source/js/jslex.c **** 	switch (J->lexchar) {
 399:Source/js/jslex.c **** 	case EOF: jsY_error(J, "unterminated escape sequence");
 400:Source/js/jslex.c **** 	case 'u':
 401:Source/js/jslex.c **** 		jsY_next(J);
 402:Source/js/jslex.c **** 		if (!jsY_ishex(J->lexchar)) return 1; else { x |= jsY_tohex(J->lexchar) << 12; jsY_next(J); }
 403:Source/js/jslex.c **** 		if (!jsY_ishex(J->lexchar)) return 1; else { x |= jsY_tohex(J->lexchar) << 8; jsY_next(J); }
 404:Source/js/jslex.c **** 		if (!jsY_ishex(J->lexchar)) return 1; else { x |= jsY_tohex(J->lexchar) << 4; jsY_next(J); }
 405:Source/js/jslex.c **** 		if (!jsY_ishex(J->lexchar)) return 1; else { x |= jsY_tohex(J->lexchar); jsY_next(J); }
 406:Source/js/jslex.c **** 		textpush(J, x);
 407:Source/js/jslex.c **** 		break;
 408:Source/js/jslex.c **** 	case 'x':
 409:Source/js/jslex.c **** 		jsY_next(J);
