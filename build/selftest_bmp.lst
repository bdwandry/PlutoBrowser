  67:Source/render/decoders/selftest_bmp.c ****         }
  68:Source/render/decoders/selftest_bmp.c ****         int dimsOk = (w == f->tw && hgt == f->th);
  69:Source/render/decoders/selftest_bmp.c ****         int probesOk = 1;
  70:Source/render/decoders/selftest_bmp.c ****         for (int pi = 0; pi < BMP_PROBES_LEN && probesOk; pi++) {
  71:Source/render/decoders/selftest_bmp.c ****             const BmpProbe* pr = &bmp_probes[pi];
  72:Source/render/decoders/selftest_bmp.c ****             if (pr->img != (int)i) continue;
