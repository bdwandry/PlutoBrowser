  80:Source/render/decoders/selftest_bmp.c ****                                 pr->p[k].g);
  81:Source/render/decoders/selftest_bmp.c ****                     probesOk = 0;
  82:Source/render/decoders/selftest_bmp.c ****                     break;
  83:Source/render/decoders/selftest_bmp.c ****                 }
  84:Source/render/decoders/selftest_bmp.c ****             }
  85:Source/render/decoders/selftest_bmp.c ****         }
  86:Source/render/decoders/selftest_bmp.c ****         char nm[64];
  87:Source/render/decoders/selftest_bmp.c ****         snprintf(nm, sizeof(nm), "D.%s_%dx%d%s", f->name, w, hgt,
  88:Source/render/decoders/selftest_bmp.c ****                  dimsOk ? "" : "_BAD_DIMS");
