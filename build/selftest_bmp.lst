 105:Source/render/decoders/selftest_bmp.c **** static void case_benchmark(void) {
 106:Source/render/decoders/selftest_bmp.c ****     double ms = -1.0;
 107:Source/render/decoders/selftest_bmp.c **** #if defined(TARGET_PLAYDATE)
 108:Source/render/decoders/selftest_bmp.c ****     struct PlaydateAPI* pd = s_pd;   /* installed via selftest_bmp_set_pd */
 109:Source/render/decoders/selftest_bmp.c ****     if (pd != NULL) {
 110:Source/render/decoders/selftest_bmp.c ****         float t0 = pd->system->getElapsedTime();
 111:Source/render/decoders/selftest_bmp.c ****         uint8_t** rows = NULL;
 112:Source/render/decoders/selftest_bmp.c ****         int w, hgt;
 113:Source/render/decoders/selftest_bmp.c ****         bmp_decode_gray(fx_bmp_bench, FX_BMP_BENCH_LEN,
 114:Source/render/decoders/selftest_bmp.c ****                         &rows, &w, &hgt);
 115:Source/render/decoders/selftest_bmp.c ****         bmp_free_rows(rows, hgt);
 116:Source/render/decoders/selftest_bmp.c ****         ms = (double)(pd->system->getElapsedTime() - t0) * 1000.0;
 117:Source/render/decoders/selftest_bmp.c ****     }
 118:Source/render/decoders/selftest_bmp.c **** #else
 119:Source/render/decoders/selftest_bmp.c ****     struct timespec t0, t1;
 120:Source/render/decoders/selftest_bmp.c ****     clock_gettime(CLOCK_MONOTONIC, &t0);
 121:Source/render/decoders/selftest_bmp.c ****     uint8_t** rows = NULL;
 122:Source/render/decoders/selftest_bmp.c ****     int w, hgt;
 123:Source/render/decoders/selftest_bmp.c ****     bmp_decode_gray(fx_bmp_bench, FX_BMP_BENCH_LEN,
 124:Source/render/decoders/selftest_bmp.c ****                         &rows, &w, &hgt);
 125:Source/render/decoders/selftest_bmp.c ****     clock_gettime(CLOCK_MONOTONIC, &t1);
 126:Source/render/decoders/selftest_bmp.c ****     ms = (t1.tv_sec - t0.tv_sec) * 1000.0 +
 127:Source/render/decoders/selftest_bmp.c ****          (t1.tv_nsec - t0.tv_nsec) / 1e6;
 128:Source/render/decoders/selftest_bmp.c ****     bmp_free_rows(rows, hgt);
 129:Source/render/decoders/selftest_bmp.c **** #endif
 130:Source/render/decoders/selftest_bmp.c ****     PLUTO_LOG("[P18] bench 600x400 -> %dx%d in %.1f ms", 300, 200, ms);
 131:Source/render/decoders/selftest_bmp.c ****     ck("B.bench_ran", ms >= 0.0);
 132:Source/render/decoders/selftest_bmp.c **** }
