  74:Source/render/decoders/selftest_bmp.c ****                 int x = pr->p[k].x, y = pr->p[k].y;
  75:Source/render/decoders/selftest_bmp.c ****                 if (x >= w || y >= hgt ||
  76:Source/render/decoders/selftest_bmp.c ****                     rows[y][x] != (uint8_t)pr->p[k].g) {
