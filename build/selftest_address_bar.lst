 119:Source/ui/selftest_address_bar.c **** static void case_open_cancel(void) {
 120:Source/ui/selftest_address_bar.c ****     /* about: URLs are not prefilled */
 121:Source/ui/selftest_address_bar.c ****     ab_open("about:blank", submit_cb, NULL);
 122:Source/ui/selftest_address_bar.c ****     ck("O.about_not_prefilled", strcmp(ab_input_text(), "") == 0);
 123:Source/ui/selftest_address_bar.c ****     ck("O.open_state", ab_is_open() == 1 && ab_keyboard_shown() == 0);
 124:Source/ui/selftest_address_bar.c **** 
 125:Source/ui/selftest_address_bar.c ****     /* real URLs are */
 126:Source/ui/selftest_address_bar.c ****     ab_open("https://example.com/x?y=1", submit_cb, NULL);
 127:Source/ui/selftest_address_bar.c ****     ck("O.url_prefilled",
 128:Source/ui/selftest_address_bar.c ****        strcmp(ab_input_text(), "https://example.com/x?y=1") == 0);
 129:Source/ui/selftest_address_bar.c **** 
 130:Source/ui/selftest_address_bar.c ****     /* NULL currentUrl -> empty prefill */
 131:Source/ui/selftest_address_bar.c ****     ab_open(NULL, submit_cb, NULL);
 132:Source/ui/selftest_address_bar.c ****     ck("O.null_empty", strcmp(ab_input_text(), "") == 0);
 133:Source/ui/selftest_address_bar.c **** 
 134:Source/ui/selftest_address_bar.c ****     /* cancel clears state + callback without firing it */
 135:Source/ui/selftest_address_bar.c ****     s_submitted = 0;
 136:Source/ui/selftest_address_bar.c ****     ab_cancel();
 137:Source/ui/selftest_address_bar.c ****     ck("C.closed", ab_is_open() == 0 && ab_keyboard_shown() == 0);
 138:Source/ui/selftest_address_bar.c ****     ck("C.no_submit_fired", s_submitted == 0);
 139:Source/ui/selftest_address_bar.c ****     ck("C.no_skip_set", ab_input_skip_remaining() == 0);
 140:Source/ui/selftest_address_bar.c **** 
 141:Source/ui/selftest_address_bar.c ****     /* after cancel the callback is gone: re-open with NULL cb and make
 142:Source/ui/selftest_address_bar.c ****      * sure nothing dangles (state-level guarantee) */
 143:Source/ui/selftest_address_bar.c ****     ab_open(NULL, NULL, NULL);
 144:Source/ui/selftest_address_bar.c ****     ab_cancel();
 145:Source/ui/selftest_address_bar.c **** }
