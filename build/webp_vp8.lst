 148:Source/render/decoders/webp_vp8.c ****     if (method == 0)
 149:Source/render/decoders/webp_vp8.c ****     {
 150:Source/render/decoders/webp_vp8.c ****         if ((int)alphaLen - 1 < total) return NULL;
 151:Source/render/decoders/webp_vp8.c ****         alpha = (uint8_t *)PLUTO_MALLOC((size_t)total);
 152:Source/render/decoders/webp_vp8.c ****         if (!alpha) return NULL;
 153:Source/render/decoders/webp_vp8.c ****         for (int i = 0; i < total; i++)
 154:Source/render/decoders/webp_vp8.c ****             alpha[i] = alphaPayload[1 + i];
 155:Source/render/decoders/webp_vp8.c ****     }
 156:Source/render/decoders/webp_vp8.c ****     else
 157:Source/render/decoders/webp_vp8.c ****     {
