1369:Source/render/decoders/webp_vp8.c **** static int vp8_get_large_value(VP8BoolBr *br, const uint8_t *proba, int p)
1370:Source/render/decoders/webp_vp8.c **** {
1371:Source/render/decoders/webp_vp8.c ****     int v;
1372:Source/render/decoders/webp_vp8.c ****     if (vp8_get_bit(br, proba[p + 3]) == 0)
1373:Source/render/decoders/webp_vp8.c ****     {
1374:Source/render/decoders/webp_vp8.c ****         if (vp8_get_bit(br, proba[p + 4]) == 0)
1375:Source/render/decoders/webp_vp8.c ****             v = 2;
1376:Source/render/decoders/webp_vp8.c ****         else
1377:Source/render/decoders/webp_vp8.c ****             v = 3 + vp8_get_bit(br, proba[p + 5]);
1378:Source/render/decoders/webp_vp8.c ****     }
1379:Source/render/decoders/webp_vp8.c ****     else if (vp8_get_bit(br, proba[p + 6]) == 0)
1380:Source/render/decoders/webp_vp8.c ****     {
1381:Source/render/decoders/webp_vp8.c ****         if (vp8_get_bit(br, proba[p + 7]) == 0)
1382:Source/render/decoders/webp_vp8.c ****             v = 5 + vp8_get_bit(br, 159);
1383:Source/render/decoders/webp_vp8.c ****         else
1384:Source/render/decoders/webp_vp8.c ****         {
1385:Source/render/decoders/webp_vp8.c ****             v = 7 + 2 * vp8_get_bit(br, 165);
1386:Source/render/decoders/webp_vp8.c ****             v += vp8_get_bit(br, 145);
1387:Source/render/decoders/webp_vp8.c ****         }
1388:Source/render/decoders/webp_vp8.c ****     }
1389:Source/render/decoders/webp_vp8.c ****     else
1390:Source/render/decoders/webp_vp8.c ****     {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccpAw5LN.s 			page 173


1391:Source/render/decoders/webp_vp8.c ****         int bit1 = vp8_get_bit(br, proba[p + 8]);
1392:Source/render/decoders/webp_vp8.c ****         int bit0 = vp8_get_bit(br, proba[p + 9 + bit1]);
1393:Source/render/decoders/webp_vp8.c ****         int cat = 2 * bit1 + bit0;
1394:Source/render/decoders/webp_vp8.c ****         v = 0;
1395:Source/render/decoders/webp_vp8.c ****         const uint8_t *tab = vp8_cat3456[cat];
1396:Source/render/decoders/webp_vp8.c ****         for (int i = 0; i < VP8_CAT3456_ROW; i++)
1397:Source/render/decoders/webp_vp8.c ****         {
1398:Source/render/decoders/webp_vp8.c ****             int prob = tab[i];
1399:Source/render/decoders/webp_vp8.c ****             if (prob == 0) break;
1400:Source/render/decoders/webp_vp8.c ****             v = v + v + vp8_get_bit(br, prob);
1401:Source/render/decoders/webp_vp8.c ****         }
1402:Source/render/decoders/webp_vp8.c ****         v = v + 3 + (8 << cat);
1403:Source/render/decoders/webp_vp8.c ****     }
1404:Source/render/decoders/webp_vp8.c ****     return v;
1405:Source/render/decoders/webp_vp8.c **** }
