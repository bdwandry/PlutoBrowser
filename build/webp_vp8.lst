 135:Source/render/decoders/webp_vp8.c **** uint8_t *alpha_decode_plane(const uint8_t *alphaPayload, size_t alphaLen,
 136:Source/render/decoders/webp_vp8.c ****                             int width, int height)
 137:Source/render/decoders/webp_vp8.c **** {
 138:Source/render/decoders/webp_vp8.c ****     if (!alphaPayload || alphaLen < 2) return NULL;
 139:Source/render/decoders/webp_vp8.c ****     int h0 = alphaPayload[0];
 140:Source/render/decoders/webp_vp8.c ****     int method = h0 & 0x03;
 141:Source/render/decoders/webp_vp8.c ****     int filter = (h0 >> 2) & 0x03;
 142:Source/render/decoders/webp_vp8.c ****     if (filter > 3) return NULL;
 143:Source/render/decoders/webp_vp8.c ****     if (method > 1 || ((h0 >> 4) & 0x03) > 1 || ((h0 >> 6) & 0x03) != 0) return NULL;
 144:Source/render/decoders/webp_vp8.c ****     int total = width * height;
 145:Source/render/decoders/webp_vp8.c ****     if (total < 1 || total > WEBP_MAX_PIXELS) return NULL;
 146:Source/render/decoders/webp_vp8.c **** 
