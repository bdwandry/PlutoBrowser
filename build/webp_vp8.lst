  93:Source/render/decoders/webp_vp8.c ****                 pred = v;
  94:Source/render/decoders/webp_vp8.c ****             }
  95:Source/render/decoders/webp_vp8.c ****         }
  96:Source/render/decoders/webp_vp8.c ****         else if (filter == 1)
  97:Source/render/decoders/webp_vp8.c ****         {
