  99:Source/render/decoders/webp_vp8.c ****             for (int x = 0; x < width; x++)
 100:Source/render/decoders/webp_vp8.c ****             {
 101:Source/render/decoders/webp_vp8.c ****                 uint8_t v = (uint8_t)((pred + alpha[o + x]) & 0xFF);
 102:Source/render/decoders/webp_vp8.c ****                 alpha[o + x] = v;
 103:Source/render/decoders/webp_vp8.c ****                 pred = v;
 104:Source/render/decoders/webp_vp8.c ****             }
 105:Source/render/decoders/webp_vp8.c ****         }
 106:Source/render/decoders/webp_vp8.c ****         else if (filter == 2)
 107:Source/render/decoders/webp_vp8.c ****         {
 108:Source/render/decoders/webp_vp8.c ****             int prev = o - width;
 109:Source/render/decoders/webp_vp8.c ****             for (int x = 0; x < width; x++)
