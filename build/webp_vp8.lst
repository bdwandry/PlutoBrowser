 641:Source/render/decoders/webp_vp8.c **** static void vp8_do_uv_transform(uint32_t bits, const int16_t *coeffs, int inOff,
 642:Source/render/decoders/webp_vp8.c ****                                 uint8_t *buf, int dst)
 643:Source/render/decoders/webp_vp8.c **** {
 644:Source/render/decoders/webp_vp8.c ****     if ((bits & 0xff) != 0)
 645:Source/render/decoders/webp_vp8.c ****     {
 646:Source/render/decoders/webp_vp8.c ****         if ((bits & 0xaa) != 0)
 647:Source/render/decoders/webp_vp8.c ****             vp8_transform_uv(coeffs, inOff, buf, dst);
 648:Source/render/decoders/webp_vp8.c ****         else
 649:Source/render/decoders/webp_vp8.c ****             vp8_transform_dcuv(coeffs, inOff, buf, dst);
 650:Source/render/decoders/webp_vp8.c ****     }
