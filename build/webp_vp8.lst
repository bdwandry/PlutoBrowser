 552:Source/render/decoders/webp_vp8.c ****     int d1 = vp8_mul1(in_[inOff + 1]);
 553:Source/render/decoders/webp_vp8.c **** #define VP8_STORE2(y, dcval)                                                    \
 554:Source/render/decoders/webp_vp8.c ****     do                                                                          \
 555:Source/render/decoders/webp_vp8.c ****     {                                                                           \
