 444:Source/render/decoders/webp_vp8.c ****         m->y1[1] = vp8_ac_table[vp8_clip_q(q, 127)];
 445:Source/render/decoders/webp_vp8.c ****         m->y2[0] = vp8_dc_table[vp8_clip_q(q + dqy2dc, 127)] * 2;
