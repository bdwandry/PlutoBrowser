 600:Source/render/decoders/webp_vp8.c **** static void vp8_transform_wht(const int16_t *in_, int inOff, int16_t *out, int outOff)
 601:Source/render/decoders/webp_vp8.c **** {
 602:Source/render/decoders/webp_vp8.c ****     int32_t *t = vp8_wht_tmp;
 603:Source/render/decoders/webp_vp8.c ****     for (int i = 0; i < 4; i++)
 604:Source/render/decoders/webp_vp8.c ****     {
 605:Source/render/decoders/webp_vp8.c ****         int32_t a0 = in_[inOff + i] + in_[inOff + 12 + i];
 606:Source/render/decoders/webp_vp8.c ****         int32_t a1 = in_[inOff + 4 + i] + in_[inOff + 8 + i];
 607:Source/render/decoders/webp_vp8.c ****         int32_t a2 = in_[inOff + 4 + i] - in_[inOff + 8 + i];
 608:Source/render/decoders/webp_vp8.c ****         int32_t a3 = in_[inOff + i] - in_[inOff + 12 + i];
 609:Source/render/decoders/webp_vp8.c ****         t[i] = a0 + a1;
 610:Source/render/decoders/webp_vp8.c ****         t[8 + i] = a0 - a1;
 611:Source/render/decoders/webp_vp8.c ****         t[4 + i] = a3 + a2;
 612:Source/render/decoders/webp_vp8.c ****         t[12 + i] = a3 - a2;
 613:Source/render/decoders/webp_vp8.c ****     }
 614:Source/render/decoders/webp_vp8.c ****     for (int i = 0; i < 4; i++)
 615:Source/render/decoders/webp_vp8.c ****     {
 616:Source/render/decoders/webp_vp8.c ****         int32_t dc = t[i * 4] + 3;
 617:Source/render/decoders/webp_vp8.c ****         int32_t a0 = dc + t[i * 4 + 3];
 618:Source/render/decoders/webp_vp8.c ****         int32_t a1 = t[i * 4 + 1] + t[i * 4 + 2];
 619:Source/render/decoders/webp_vp8.c ****         int32_t a2 = t[i * 4 + 1] - t[i * 4 + 2];
 620:Source/render/decoders/webp_vp8.c ****         int32_t a3 = dc - t[i * 4 + 3];
 621:Source/render/decoders/webp_vp8.c ****         out[outOff] = (int16_t)vp8_sar((int)a0 + (int)a1, 3);
 622:Source/render/decoders/webp_vp8.c ****         out[outOff + 16] = (int16_t)vp8_sar((int)a3 + (int)a2, 3);
 623:Source/render/decoders/webp_vp8.c ****         out[outOff + 32] = (int16_t)vp8_sar((int)a0 - (int)a1, 3);
 624:Source/render/decoders/webp_vp8.c ****         out[outOff + 48] = (int16_t)vp8_sar((int)a3 - (int)a2, 3);
 625:Source/render/decoders/webp_vp8.c ****         outOff += 64;
 626:Source/render/decoders/webp_vp8.c ****     }
 627:Source/render/decoders/webp_vp8.c **** }
