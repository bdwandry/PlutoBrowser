 222:Source/render/decoders/webp_vp8.c **** static void vp8_log2_init(void)
 223:Source/render/decoders/webp_vp8.c **** {
 224:Source/render/decoders/webp_vp8.c ****     static int inited = 0;
 225:Source/render/decoders/webp_vp8.c ****     if (inited) return;
