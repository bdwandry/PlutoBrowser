 481:Source/render/decoders/webp_vp8.c **** static int vp8_sar(int v, int n)
 482:Source/render/decoders/webp_vp8.c **** {
 483:Source/render/decoders/webp_vp8.c ****     if (v >= 0) return v >> n;
 484:Source/render/decoders/webp_vp8.c ****     return ~((~v) >> n);
 485:Source/render/decoders/webp_vp8.c **** }
 486:Source/render/decoders/webp_vp8.c **** 
