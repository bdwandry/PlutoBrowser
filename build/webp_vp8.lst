 228:Source/render/decoders/webp_vp8.c ****         int v = i, n = 0;
 229:Source/render/decoders/webp_vp8.c ****         while (v > 1) { v >>= 1; n++; }
 230:Source/render/decoders/webp_vp8.c ****         VP8_LOG2[i] = n;
 231:Source/render/decoders/webp_vp8.c ****     }
 232:Source/render/decoders/webp_vp8.c ****     inited = 1;
 233:Source/render/decoders/webp_vp8.c **** }
