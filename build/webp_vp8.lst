 471:Source/render/decoders/webp_vp8.c ****     }
 472:Source/render/decoders/webp_vp8.c ****     dec->useSkipProba = vp8_get_bit(br, 128);
 473:Source/render/decoders/webp_vp8.c ****     if (dec->useSkipProba != 0)
 474:Source/render/decoders/webp_vp8.c ****         dec->skipP = vp8_get_value(br, 8);
 475:Source/render/decoders/webp_vp8.c **** }
