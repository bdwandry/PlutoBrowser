 303:Source/render/decoders/webp_vp8.c **** static int vp8_get_signed(VP8BoolBr *br, int v)
 304:Source/render/decoders/webp_vp8.c **** {
 305:Source/render/decoders/webp_vp8.c ****     if (br->bits < 0) vp8_load_new(br);
 306:Source/render/decoders/webp_vp8.c ****     int pos = br->bits;
 307:Source/render/decoders/webp_vp8.c ****     int split = br->range >> 1;
 308:Source/render/decoders/webp_vp8.c ****     uint32_t value = br->value >> pos;
 309:Source/render/decoders/webp_vp8.c ****     int mask;
 310:Source/render/decoders/webp_vp8.c ****     if (value > (uint32_t)split) mask = -1; else mask = 0;
 311:Source/render/decoders/webp_vp8.c ****     br->bits -= 1;
 312:Source/render/decoders/webp_vp8.c ****     br->range = (br->range + mask) | 1;
 313:Source/render/decoders/webp_vp8.c ****     br->value = (br->value - ((((uint32_t)split + 1u) & (uint32_t)mask) << pos)) & 0xFFFFFFFFu;
 314:Source/render/decoders/webp_vp8.c ****     return (v ^ mask) - mask;
 315:Source/render/decoders/webp_vp8.c **** }
