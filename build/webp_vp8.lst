 629:Source/render/decoders/webp_vp8.c **** static void vp8_do_transform(uint32_t bits, const int16_t *coeffs, int inOff,
 630:Source/render/decoders/webp_vp8.c ****                              uint8_t *buf, int dst)
 631:Source/render/decoders/webp_vp8.c **** {
 632:Source/render/decoders/webp_vp8.c ****     int top = (int)(bits >> 30);
 633:Source/render/decoders/webp_vp8.c ****     if (top == 3)
 634:Source/render/decoders/webp_vp8.c ****         vp8_transform_one(coeffs, inOff, buf, dst);
 635:Source/render/decoders/webp_vp8.c ****     else if (top == 2)
 636:Source/render/decoders/webp_vp8.c ****         vp8_transform_ac3(coeffs, inOff, buf, dst);
 637:Source/render/decoders/webp_vp8.c ****     else if (top == 1)
 638:Source/render/decoders/webp_vp8.c ****         vp8_transform_dc(coeffs, inOff, buf, dst);
 639:Source/render/decoders/webp_vp8.c **** }
