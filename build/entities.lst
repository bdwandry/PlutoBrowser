 520:Source/html/entities.c **** // Final sanitize pass. Runs ONLY when the original text had high bytes.
 521:Source/html/entities.c **** // Mirrors the Lua byte loop exactly, including its index conditions:
 522:Source/html/entities.c **** //   b 192..223 needs ONE more byte; b 224..239 needs TWO more bytes;
 523:Source/html/entities.c **** //   truncated leads fall into the catch-all " " and the leftover
 524:Source/html/entities.c **** //   continuation bytes become separate " " entries.
 525:Source/html/entities.c **** static void utf8_cleanup_pass(char** ptext, size_t* plen)
 526:Source/html/entities.c **** {
 527:Source/html/entities.c ****     StrBuf out;
 528:Source/html/entities.c ****     const char* text = *ptext;
 529:Source/html/entities.c ****     size_t len = *plen;
 530:Source/html/entities.c ****     size_t i = 0;
 531:Source/html/entities.c **** 
 532:Source/html/entities.c ****     sb_init(&out);
 533:Source/html/entities.c ****     while (i < len) {
 534:Source/html/entities.c ****         unsigned char b = (unsigned char)text[i];
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccxuersq.s 			page 43


 535:Source/html/entities.c **** 
 536:Source/html/entities.c ****         tasks_yield_check();
 537:Source/html/entities.c **** 
 538:Source/html/entities.c ****         if ((b >= 32 && b <= 126) || b == 10 || b == 13 || b == 9) {
 539:Source/html/entities.c ****             sb_append_char(&out, (char)b);
 540:Source/html/entities.c ****             i += 1;
 541:Source/html/entities.c ****         } else if (b >= 192 && b <= 223 && i + 1 < len) {
 542:Source/html/entities.c ****             unsigned char cb = (unsigned char)text[i + 1];
 543:Source/html/entities.c ****             unsigned cp = ((b % 0x20) * 64) + (cb % 0x40);
 544:Source/html/entities.c ****             const char* t = translit_lookup(cp);
 545:Source/html/entities.c ****             if (t != NULL) {
 546:Source/html/entities.c ****                 sb_append_str(&out, t);
 547:Source/html/entities.c ****             } else {
 548:Source/html/entities.c ****                 sb_append_char(&out, ' ');
 549:Source/html/entities.c ****             }
 550:Source/html/entities.c ****             i += 2;
 551:Source/html/entities.c ****         } else if (b >= 224 && b <= 239 && i + 2 < len) {
 552:Source/html/entities.c ****             sb_append_char(&out, ' ');
 553:Source/html/entities.c ****             i += 3;
 554:Source/html/entities.c ****         } else {
 555:Source/html/entities.c ****             sb_append_char(&out, ' ');
 556:Source/html/entities.c ****             i += 1;
 557:Source/html/entities.c ****         }
 558:Source/html/entities.c ****     }
 559:Source/html/entities.c **** 
 560:Source/html/entities.c ****     pluto_free(*ptext);
 561:Source/html/entities.c ****     *ptext = sb_detach(&out);
 562:Source/html/entities.c ****     *plen = strlen(*ptext);
 563:Source/html/entities.c **** }
