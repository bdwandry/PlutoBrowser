 327:Source/html/entities.c **** static int decode_named_pass(StrBuf *out, const char *text)
 328:Source/html/entities.c **** {
 329:Source/html/entities.c ****     const char *p = text;
 330:Source/html/entities.c ****     while (*p)
 331:Source/html/entities.c ****     {
 332:Source/html/entities.c ****         const char *amp = strchr(p, '&');
 333:Source/html/entities.c ****         if (!amp)
 334:Source/html/entities.c ****         {
 335:Source/html/entities.c ****             if (strbuf_append(out, p) != 0)
 336:Source/html/entities.c ****             {
 337:Source/html/entities.c ****                 return -1;
 338:Source/html/entities.c ****             }
 339:Source/html/entities.c ****             break;
 340:Source/html/entities.c ****         }
 341:Source/html/entities.c ****         if (amp > p && strbuf_append_n(out, p, (size_t)(amp - p)) != 0)
 342:Source/html/entities.c ****         {
 343:Source/html/entities.c ****             return -1;
 344:Source/html/entities.c ****         }
 345:Source/html/entities.c ****         p = amp;
 346:Source/html/entities.c ****         const char *q = p + 1;
 347:Source/html/entities.c ****         const char *n = q;
 348:Source/html/entities.c ****         while (isalpha((unsigned char)*q))
 349:Source/html/entities.c ****         {
 350:Source/html/entities.c ****             q++;
 351:Source/html/entities.c ****         }
 352:Source/html/entities.c ****         if (q == n || *q != ';' || (q - n) > 24)
 353:Source/html/entities.c ****         {
 354:Source/html/entities.c ****             if (strbuf_append_char(out, '&') != 0)
 355:Source/html/entities.c ****             {
 356:Source/html/entities.c ****                 return -1;
 357:Source/html/entities.c ****             }
 358:Source/html/entities.c ****             p++;
 359:Source/html/entities.c ****             continue;
 360:Source/html/entities.c ****         }
 361:Source/html/entities.c ****         const char *repl = named_lookup(n, (size_t)(q - n));
 362:Source/html/entities.c ****         /* Lua: return NAMED_ENTITIES[name] or (" " .. name .. " ") — the
 363:Source/html/entities.c ****          * unknown replacement is a single " name " token (no extra space). */
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccvW1kwb.s 			page 26


 364:Source/html/entities.c ****         if (repl)
 365:Source/html/entities.c ****         {
 366:Source/html/entities.c ****             if (strbuf_append(out, repl) != 0)
 367:Source/html/entities.c ****             {
 368:Source/html/entities.c ****                 return -1;
 369:Source/html/entities.c ****             }
 370:Source/html/entities.c ****         }
 371:Source/html/entities.c ****         else if (strbuf_appendf(out, " %.*s ", (int)(q - n), n) != 0)
 372:Source/html/entities.c ****         {
 373:Source/html/entities.c ****             return -1;
 374:Source/html/entities.c ****         }
 375:Source/html/entities.c ****         p = q + 1;
 376:Source/html/entities.c ****     }
 377:Source/html/entities.c ****     return 0;
 378:Source/html/entities.c **** }
