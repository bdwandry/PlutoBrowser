 104:Source/html/entities.c **** /* Lua tables silently overwrite duplicate keys; resolve "not" (defined with
 105:Source/html/entities.c ****  * '~' then later with 'not ') the same way — last assignment wins. */
 106:Source/html/entities.c **** static const char *named_lookup(const char *name, size_t len)
 107:Source/html/entities.c **** {
 108:Source/html/entities.c ****     if (len == 3 && strncmp(name, "not", 3) == 0)
 109:Source/html/entities.c ****     {
 110:Source/html/entities.c ****         return "not "; /* duplicate-key overwrite parity */
 111:Source/html/entities.c ****     }
 112:Source/html/entities.c ****     for (size_t i = 0; i < NAMED_ENTITY_COUNT; i++)
 113:Source/html/entities.c ****     {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccvW1kwb.s 			page 5


 114:Source/html/entities.c ****         if (strlen(NAMED_ENTITIES[i].name) == len &&
 115:Source/html/entities.c ****             strncmp(NAMED_ENTITIES[i].name, name, len) == 0)
 116:Source/html/entities.c ****         {
 117:Source/html/entities.c ****             return NAMED_ENTITIES[i].repl;
 118:Source/html/entities.c ****         }
 119:Source/html/entities.c ****     }
 120:Source/html/entities.c ****     return NULL;
 121:Source/html/entities.c **** }
