 380:Source/html/entities.c **** /* ════════════════════════════════
 381:Source/html/entities.c ****  * Pass 4: UTF-8 multi-byte sequence cleanup (Lua's ordered gsub list).
 382:Source/html/entities.c ****  */
 383:Source/html/entities.c **** typedef struct
 384:Source/html/entities.c **** {
 385:Source/html/entities.c ****     const char *seq;
 386:Source/html/entities.c ****     const char *repl;
 387:Source/html/entities.c **** } ByteSeq;
 388:Source/html/entities.c **** 
 389:Source/html/entities.c **** static const ByteSeq UTF8_CLEANUP[] = {
 390:Source/html/entities.c ****     { "\xef\xbb\xbf", "" },
 391:Source/html/entities.c ****     { "\xc2\xa0", " " },
 392:Source/html/entities.c ****     { "\xe2\x80\x93", " - " },
 393:Source/html/entities.c ****     { "\xe2\x80\x94", " -- " },
 394:Source/html/entities.c ****     { "\xe2\x80\x98", "'" },
 395:Source/html/entities.c ****     { "\xe2\x80\x99", "'" },
 396:Source/html/entities.c ****     { "\xe2\x80\x9c", "\"" },
 397:Source/html/entities.c ****     { "\xe2\x80\x9d", "\"" },
 398:Source/html/entities.c ****     { "\xe2\x80\xa6", "..." },
 399:Source/html/entities.c ****     { "\xe2\x80\xa2", "*" },
 400:Source/html/entities.c ****     { "\xc2\xb7", "*" },
 401:Source/html/entities.c ****     { "\xe2\x88\x92", "-" },
 402:Source/html/entities.c ****     { "\xc2\xb1", "+/-" },
 403:Source/html/entities.c ****     { "\xe2\x88\x9a", "sqrt" },
 404:Source/html/entities.c ****     { "\xe2\x88\x9e", "inf" },
 405:Source/html/entities.c ****     { "\xe2\x89\xa4", "<=" },
 406:Source/html/entities.c ****     { "\xe2\x89\xa5", ">=" },
 407:Source/html/entities.c ****     { "\xe2\x89\xa0", "!=" },
 408:Source/html/entities.c ****     { "\xe2\x89\x88", "~" },
 409:Source/html/entities.c ****     { "\xe2\x88\x91", "sum " },
 410:Source/html/entities.c ****     { "\xe2\x88\x8f", "prod " },
 411:Source/html/entities.c ****     { "\xe2\x88\x88", "in " },
 412:Source/html/entities.c ****     { "\xe2\x88\xa3", "|" },
 413:Source/html/entities.c ****     { "\xe2\x86\x92", "->" },
 414:Source/html/entities.c ****     { "\xe2\x86\x90", "<-" },
 415:Source/html/entities.c ****     { "\xe2\x86\x91", "^" },
 416:Source/html/entities.c ****     { "\xe2\x86\x93", "v" },
 417:Source/html/entities.c **** };
 418:Source/html/entities.c **** #define UTF8_CLEANUP_COUNT (sizeof(UTF8_CLEANUP) / sizeof(UTF8_CLEANUP[0]))
 419:Source/html/entities.c **** 
 420:Source/html/entities.c **** static int utf8_cleanup_pass(StrBuf *out, const char *text)
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccvW1kwb.s 			page 27


 421:Source/html/entities.c **** {
 422:Source/html/entities.c ****     size_t n = strlen(text);
 423:Source/html/entities.c ****     size_t i = 0;
 424:Source/html/entities.c ****     while (i < n)
 425:Source/html/entities.c ****     {
 426:Source/html/entities.c ****         int matched = 0;
 427:Source/html/entities.c ****         for (size_t s = 0; s < UTF8_CLEANUP_COUNT && !matched; s++)
 428:Source/html/entities.c ****         {
 429:Source/html/entities.c ****             size_t sl = strlen(UTF8_CLEANUP[s].seq);
 430:Source/html/entities.c ****             if (i + sl <= n && memcmp(text + i, UTF8_CLEANUP[s].seq, sl) == 0)
 431:Source/html/entities.c ****             {
 432:Source/html/entities.c ****                 if (strbuf_append(out, UTF8_CLEANUP[s].repl) != 0)
 433:Source/html/entities.c ****                 {
 434:Source/html/entities.c ****                     return -1;
 435:Source/html/entities.c ****                 }
