 539:Source/html/entities.c **** static int translit_clean_pass(StrBuf *out, const char *text)
 540:Source/html/entities.c **** {
 541:Source/html/entities.c ****     size_t n = strlen(text);
 542:Source/html/entities.c ****     size_t i = 0;
 543:Source/html/entities.c ****     while (i < n)
 544:Source/html/entities.c ****     {
 545:Source/html/entities.c ****         unsigned char b = (unsigned char)text[i];
 546:Source/html/entities.c ****         if ((b >= 32 && b <= 126) || b == 10 || b == 13 || b == 9)
 547:Source/html/entities.c ****         {
 548:Source/html/entities.c ****             if (strbuf_append_char(out, (char)b) != 0)
 549:Source/html/entities.c ****             {
 550:Source/html/entities.c ****                 return -1;
 551:Source/html/entities.c ****             }
 552:Source/html/entities.c ****             i++;
 553:Source/html/entities.c ****         }
 554:Source/html/entities.c ****         else if (b >= 192 && b <= 223 && i < n - 1)
 555:Source/html/entities.c ****         {
 556:Source/html/entities.c ****             unsigned char c = (unsigned char)text[i + 1];
 557:Source/html/entities.c ****             unsigned int cp = ((b % 0x20) * 64) + (c % 0x40);
 558:Source/html/entities.c ****             const char *t = translit_lookup(cp);
 559:Source/html/entities.c ****             if (strbuf_append(out, t ? t : " ") != 0)
 560:Source/html/entities.c ****             {
 561:Source/html/entities.c ****                 return -1;
 562:Source/html/entities.c ****             }
 563:Source/html/entities.c ****             i += 2;
 564:Source/html/entities.c ****         }
 565:Source/html/entities.c ****         else if (b >= 224 && b <= 239 && i + 1 < n - 1)
 566:Source/html/entities.c ****         {
 567:Source/html/entities.c ****             if (strbuf_append_char(out, ' ') != 0)
 568:Source/html/entities.c ****             {
 569:Source/html/entities.c ****                 return -1;
 570:Source/html/entities.c ****             }
 571:Source/html/entities.c ****             i += 3;
 572:Source/html/entities.c ****         }
 573:Source/html/entities.c ****         else
 574:Source/html/entities.c ****         {
 575:Source/html/entities.c ****             if (strbuf_append_char(out, ' ') != 0)
 576:Source/html/entities.c ****             {
 577:Source/html/entities.c ****                 return -1;
 578:Source/html/entities.c ****             }
 579:Source/html/entities.c ****             i++;
 580:Source/html/entities.c ****         }
 581:Source/html/entities.c ****     }
 582:Source/html/entities.c ****     return 0;
 583:Source/html/entities.c **** }
