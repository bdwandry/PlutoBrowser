 364:Source/html/entities.c **** 
 365:Source/html/entities.c **** typedef struct SeqRepl {
 366:Source/html/entities.c ****     const char* seq;   // raw bytes
 367:Source/html/entities.c ****     size_t seqLen;
 368:Source/html/entities.c ****     const char* repl;
 369:Source/html/entities.c **** } SeqRepl;
 370:Source/html/entities.c **** 
 371:Source/html/entities.c **** #define S3(a, b, c) ((const char[]) {(char)a, (char)b, (char)c})
 372:Source/html/entities.c **** #define S2(a, b) ((const char[]) {(char)a, (char)b})
 373:Source/html/entities.c **** 
 374:Source/html/entities.c **** static const SeqRepl FIXED_SEQS[] = {
 375:Source/html/entities.c ****     {S3(0xEF, 0xBB, 0xBF), 3, ""},        // BOM
 376:Source/html/entities.c ****     {S2(0xC2, 0xA0), 2, " "},             // NBSP
 377:Source/html/entities.c ****     {S3(0xE2, 0x80, 0x93), 3, " - "},     // en dash
 378:Source/html/entities.c ****     {S3(0xE2, 0x80, 0x94), 3, " -- "},    // em dash
 379:Source/html/entities.c ****     {S3(0xE2, 0x80, 0x98), 3, "'"},       // left single quote
 380:Source/html/entities.c ****     {S3(0xE2, 0x80, 0x99), 3, "'"},       // right single quote
 381:Source/html/entities.c ****     {S3(0xE2, 0x80, 0x9C), 3, "\""},      // left double quote
 382:Source/html/entities.c ****     {S3(0xE2, 0x80, 0x9D), 3, "\""},      // right double quote
 383:Source/html/entities.c ****     {S3(0xE2, 0x80, 0xA6), 3, "..."},     // ellipsis
 384:Source/html/entities.c ****     {S3(0xE2, 0x80, 0xA2), 3, "*"},       // bullet
 385:Source/html/entities.c ****     {S2(0xC2, 0xB7), 2, "*"},             // middle dot
 386:Source/html/entities.c ****     {S3(0xE2, 0x88, 0x92), 3, "-"},       // minus sign
 387:Source/html/entities.c ****     {S2(0xC2, 0xB1), 2, "+/-"},           // plus-minus
 388:Source/html/entities.c ****     {S3(0xE2, 0x88, 0x9A), 3, "sqrt"},    // square root
 389:Source/html/entities.c ****     {S3(0xE2, 0x88, 0x9E), 3, "inf"},     // infinity
 390:Source/html/entities.c ****     {S3(0xE2, 0x89, 0xA4), 3, "<="},      // less-equal
 391:Source/html/entities.c ****     {S3(0xE2, 0x89, 0xA5), 3, ">="},      // greater-equal
 392:Source/html/entities.c ****     {S3(0xE2, 0x89, 0xA0), 3, "!="},      // not-equal
 393:Source/html/entities.c ****     {S3(0xE2, 0x89, 0x88), 3, "~"},       // almost-equal
 394:Source/html/entities.c ****     {S3(0xE2, 0x88, 0x91), 3, "sum "},    // n-ary summation
 395:Source/html/entities.c ****     {S3(0xE2, 0x88, 0x8F), 3, "prod "},   // n-ary product
 396:Source/html/entities.c ****     {S3(0xE2, 0x88, 0x88), 3, "in "},     // element-of
