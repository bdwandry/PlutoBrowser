 110:Source/html/entities.c **** static const char* named_lookup(const char* name, size_t len)
 111:Source/html/entities.c **** {
 112:Source/html/entities.c ****     size_t i;
 113:Source/html/entities.c ****     for (i = 0; i < sizeof(NAMED) / sizeof(NAMED[0]); i++) {
 114:Source/html/entities.c ****         if (strlen(NAMED[i].name) == len &&
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccxuersq.s 			page 5


 115:Source/html/entities.c ****             memcmp(NAMED[i].name, name, len) == 0) {
 116:Source/html/entities.c ****             return NAMED[i].value;
 117:Source/html/entities.c ****         }
 118:Source/html/entities.c ****     }
 119:Source/html/entities.c ****     return NULL;
 120:Source/html/entities.c **** }
