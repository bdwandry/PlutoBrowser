   1:Source/html/entities.c **** // entities.c — HTML entity decoder & UTF-8 sanitizer
   2:Source/html/entities.c **** // (C port of html/entities.lua).
   3:Source/html/entities.c **** //
   4:Source/html/entities.c **** // Ground truth: host-Lua oracle p06_oracle.lua on the REAL entities.lua.
   5:Source/html/entities.c **** // Verified quirks preserved:
   6:Source/html/entities.c **** //   - fast path: text without '&' and without bytes >=0x80 is returned
   7:Source/html/entities.c **** //     VERBATIM (raw control bytes included)
   8:Source/html/entities.c **** //   - numeric/named passes only run when '&' present; fixed UTF-8 cleanup +
   9:Source/html/entities.c **** //     transliteration only run when a high byte was present
  10:Source/html/entities.c **** //   - NAMED table: Lua constructor duplicate keys resolve LAST-WINS
  11:Source/html/entities.c **** //     ("not" -> "not "); values like " deg"/"in "/"not " keep exact spacing;
  12:Source/html/entities.c **** //     &frac12; etc. contain digits and NEVER match %a+ -> stay verbatim
  13:Source/html/entities.c **** //   - unknown names become " name "; case-sensitive (&AMP; -> " AMP ")
  14:Source/html/entities.c **** //   - decimal branch specials include 0x201A/0x201E; hex branch does NOT
  15:Source/html/entities.c **** //     (source asymmetry): &#x201a; -> " "
  16:Source/html/entities.c **** //   - step 4: literal UTF-8 sequence rewrites applied sequentially
  17:Source/html/entities.c **** //   - step 5 final loop: printable 32..126 + \n\r\t kept; lead C2..DF with a
  18:Source/html/entities.c **** //     following byte decodes cp=((b%0x20)*64)+(c%0x40) through T (or " ");
  19:Source/html/entities.c **** //     lead E0..EF with two more bytes -> " " advance 3; anything else ->
  20:Source/html/entities.c **** //     " " advance 1 (truncated tails therefore widen)
  21:Source/html/entities.c **** //   - Tasks.yieldCheck() once per input byte of the final loop
  22:Source/html/entities.c **** #include <stdio.h>
  23:Source/html/entities.c **** #include <string.h>
