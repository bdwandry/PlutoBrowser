 404:Source/html/entities.c **** static void apply_fixed_sequences(StrBuf* out, const char* text, size_t len)
 405:Source/html/entities.c **** {
 406:Source/html/entities.c ****     size_t nSeq = sizeof(FIXED_SEQS) / sizeof(FIXED_SEQS[0]);
 407:Source/html/entities.c ****     StrBuf cur;
 408:Source/html/entities.c ****     size_t s;
 409:Source/html/entities.c **** 
 410:Source/html/entities.c ****     sb_init(&cur);
 411:Source/html/entities.c ****     sb_append(&cur, text, len);
 412:Source/html/entities.c **** 
 413:Source/html/entities.c ****     for (s = 0; s < nSeq; s++) {
 414:Source/html/entities.c ****         const SeqRepl* r = &FIXED_SEQS[s];
 415:Source/html/entities.c ****         StrBuf next;
 416:Source/html/entities.c ****         size_t i = 0;
 417:Source/html/entities.c ****         sb_init(&next);
 418:Source/html/entities.c ****         while (i < cur.len) {
 419:Source/html/entities.c ****             if (cur.len - i >= r->seqLen &&
 420:Source/html/entities.c ****                 memcmp(cur.data + i, r->seq, r->seqLen) == 0) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccxuersq.s 			page 41


 421:Source/html/entities.c ****                 sb_append_str(&next, r->repl);
 422:Source/html/entities.c ****                 i += r->seqLen;
 423:Source/html/entities.c ****             } else {
 424:Source/html/entities.c ****                 sb_append_char(&next, cur.data[i]);
 425:Source/html/entities.c ****                 i++;
 426:Source/html/entities.c ****             }
 427:Source/html/entities.c ****         }
 428:Source/html/entities.c ****         pluto_free(cur.data);
 429:Source/html/entities.c ****         cur = next;
 430:Source/html/entities.c ****     }
 431:Source/html/entities.c ****     sb_append_buf(out, &cur); // may alias? no — must differ
 432:Source/html/entities.c ****     pluto_free(cur.data);
 433:Source/html/entities.c **** }
