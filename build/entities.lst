 185:Source/html/entities.c **** 
 186:Source/html/entities.c **** // numeric entity body shared by both branches
 187:Source/html/entities.c **** static void append_num_entity(StrBuf* out, unsigned long long num,
 188:Source/html/entities.c ****                               const char* (*special)(unsigned))
 189:Source/html/entities.c **** {
 190:Source/html/entities.c ****     const char* m;
 191:Source/html/entities.c ****     if (num > 0xFFFFFFFFull) {
 192:Source/html/entities.c ****         sb_append_char(out, ' '); // huge values land here like Lua floats
 193:Source/html/entities.c ****         return;
 194:Source/html/entities.c ****     }
 195:Source/html/entities.c ****     m = special((unsigned)num);
 196:Source/html/entities.c ****     if (m != NULL) {
 197:Source/html/entities.c ****         sb_append_str(out, m);
 198:Source/html/entities.c ****         return;
 199:Source/html/entities.c ****     }
 200:Source/html/entities.c ****     m = math_cp_lookup((unsigned)num);
 201:Source/html/entities.c ****     if (m != NULL) {
 202:Source/html/entities.c ****         sb_append_str(out, m);
 203:Source/html/entities.c ****         return;
 204:Source/html/entities.c ****     }
 205:Source/html/entities.c ****     if (num >= 32 && num <= 126) {
 206:Source/html/entities.c ****         sb_append_char(out, (char)(unsigned char)num);
 207:Source/html/entities.c ****         return;
 208:Source/html/entities.c ****     }
 209:Source/html/entities.c ****     sb_append_char(out, ' ');
 210:Source/html/entities.c **** }
