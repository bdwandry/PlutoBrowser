 309:Source/html/entities.c **** 
 310:Source/html/entities.c **** // ------------------------------------------------ named pass ----
 311:Source/html/entities.c **** 
 312:Source/html/entities.c **** static int replace_named(char** ptext, size_t* plen)
 313:Source/html/entities.c **** {
 314:Source/html/entities.c ****     StrBuf out;
 315:Source/html/entities.c ****     const char* text = *ptext;
 316:Source/html/entities.c ****     size_t len = *plen;
 317:Source/html/entities.c ****     size_t i = 0;
 318:Source/html/entities.c ****     int changed = 0;
 319:Source/html/entities.c **** 
 320:Source/html/entities.c ****     sb_init(&out);
 321:Source/html/entities.c ****     while (i < len) {
 322:Source/html/entities.c ****         char c = text[i];
 323:Source/html/entities.c ****         if (c != '&') {
 324:Source/html/entities.c ****             sb_append_char(&out, c);
 325:Source/html/entities.c ****             i++;
 326:Source/html/entities.c ****             continue;
 327:Source/html/entities.c ****         }
 328:Source/html/entities.c ****         {
 329:Source/html/entities.c ****             size_t p = i + 1;
 330:Source/html/entities.c ****             size_t start = p;
 331:Source/html/entities.c ****             while (p < len && ((text[p] >= 'a' && text[p] <= 'z') ||
 332:Source/html/entities.c ****                                (text[p] >= 'A' && text[p] <= 'Z'))) {
 333:Source/html/entities.c ****                 p++;
 334:Source/html/entities.c ****             }
 335:Source/html/entities.c ****             if (p > start && p < len && text[p] == ';') {
 336:Source/html/entities.c ****                 const char* v = named_lookup(text + start, p - start);
 337:Source/html/entities.c ****                 if (v != NULL) {
 338:Source/html/entities.c ****                     sb_append_str(&out, v);
 339:Source/html/entities.c ****                 } else {
 340:Source/html/entities.c ****                     sb_append_char(&out, ' ');
 341:Source/html/entities.c ****                     sb_append(&out, text + start, p - start);
 342:Source/html/entities.c ****                     sb_append_char(&out, ' ');
 343:Source/html/entities.c ****                 }
 344:Source/html/entities.c ****                 i = p + 1;
 345:Source/html/entities.c ****                 changed = 1;
 346:Source/html/entities.c ****                 continue;
 347:Source/html/entities.c ****             }
 348:Source/html/entities.c ****         }
 349:Source/html/entities.c ****         sb_append_char(&out, '&');
 350:Source/html/entities.c ****         i++;
 351:Source/html/entities.c ****     }
 352:Source/html/entities.c **** 
 353:Source/html/entities.c ****     if (changed) {
 354:Source/html/entities.c ****         pluto_free(*ptext);
 355:Source/html/entities.c ****         *ptext = sb_detach(&out);
 356:Source/html/entities.c ****         *plen = strlen(*ptext);
 357:Source/html/entities.c ****         return 1;
 358:Source/html/entities.c ****     }
 359:Source/html/entities.c ****     sb_free(&out);
 360:Source/html/entities.c ****     return 0;
 361:Source/html/entities.c **** }
