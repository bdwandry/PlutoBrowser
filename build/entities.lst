 128:Source/html/entities.c ****     case 178: return "^2";    case 179: return "^3";
 129:Source/html/entities.c ****     case 183: return "*";     case 215: return "x";
 130:Source/html/entities.c ****     case 247: return "/";     case 960: return "pi";
 131:Source/html/entities.c ****     case 916: return "D";
 132:Source/html/entities.c ****     case 8706: return "d";    case 8712: return "in ";
 133:Source/html/entities.c ****     case 8719: return "prod ";
 134:Source/html/entities.c ****     case 8721: return "sum "; case 8722: return "-";
 135:Source/html/entities.c ****     case 8730: return "sqrt"; case 8734: return "inf";
 136:Source/html/entities.c ****     case 8747: return "int ";
 137:Source/html/entities.c ****     case 8776: return "~";    case 8800: return "!=";
 138:Source/html/entities.c ****     case 8804: return "<=";   case 8805: return ">=";
 139:Source/html/entities.c ****     case 8592: return "<-";   case 8593: return "^";
 140:Source/html/entities.c ****     case 8594: return "->";   case 8595: return "v";
 141:Source/html/entities.c ****     default: return NULL;
 142:Source/html/entities.c ****     }
 143:Source/html/entities.c **** }
