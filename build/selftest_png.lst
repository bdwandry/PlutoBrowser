  73:Source/render/decoders/selftest_png.c ****                                  i == NFIX - 1 ? 50 : 360,   /* down */
  74:Source/render/decoders/selftest_png.c ****                                  i == NFIX - 1 ? 40 : 200,
  75:Source/render/decoders/selftest_png.c ****                                  &rows, &w, &hgt);
  76:Source/render/decoders/selftest_png.c ****         if (rc != 0 || rows == NULL) {
  77:Source/render/decoders/selftest_png.c ****             char nm[64];
  78:Source/render/decoders/selftest_png.c ****             snprintf(nm, sizeof(nm), "D.%s_decode", f->name);
  79:Source/render/decoders/selftest_png.c ****             ck(nm, 0);
  80:Source/render/decoders/selftest_png.c ****             continue;
  81:Source/render/decoders/selftest_png.c ****         }
  82:Source/render/decoders/selftest_png.c ****         int dimsOk = (w == f->tw && hgt == f->th);
  83:Source/render/decoders/selftest_png.c ****         int probesOk = 1;
  84:Source/render/decoders/selftest_png.c ****         for (int pi = 0; pi < PNG_PROBES_LEN && probesOk; pi++) {
  85:Source/render/decoders/selftest_png.c ****             const PngProbe* pr = &png_probes[pi];
  86:Source/render/decoders/selftest_png.c ****             if (pr->img != (int)i) continue;
  87:Source/render/decoders/selftest_png.c ****             for (int k = 0; k < pr->nProbes; k++) {
  88:Source/render/decoders/selftest_png.c ****                 int x = pr->p[k].x, y = pr->p[k].y;
  89:Source/render/decoders/selftest_png.c ****                 if (x >= w || y >= hgt ||
  90:Source/render/decoders/selftest_png.c ****                     rows[y][x] != (uint8_t)pr->p[k].g) {
  91:Source/render/decoders/selftest_png.c ****                     PLUTO_ERROR("[P17] probe %s(%d,%d): got %d want %d",
  92:Source/render/decoders/selftest_png.c ****                                 f->name, x, y,
  93:Source/render/decoders/selftest_png.c ****                                 x < w && y < hgt ? rows[y][x] : -1,
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccdxnmvY.s 			page 9


  94:Source/render/decoders/selftest_png.c ****                                 pr->p[k].g);
  95:Source/render/decoders/selftest_png.c ****                     probesOk = 0;
  96:Source/render/decoders/selftest_png.c ****                     break;
  97:Source/render/decoders/selftest_png.c ****                 }
  98:Source/render/decoders/selftest_png.c ****             }
  99:Source/render/decoders/selftest_png.c ****         }
 100:Source/render/decoders/selftest_png.c ****         char nm[64];
 101:Source/render/decoders/selftest_png.c ****         snprintf(nm, sizeof(nm), "D.%s_%dx%d%s", f->name, w, hgt,
 102:Source/render/decoders/selftest_png.c ****                  dimsOk ? "" : "_BAD_DIMS");
 103:Source/render/decoders/selftest_png.c ****         ck(nm, dimsOk && probesOk);
 104:Source/render/decoders/selftest_png.c **** 
 105:Source/render/decoders/selftest_png.c ****         if (i == NFIX - 2) {           /* keep bench grid for timing */
 106:Source/render/decoders/selftest_png.c ****             g_benchRows = rows;
 107:Source/render/decoders/selftest_png.c ****             g_benchW = w;
 108:Source/render/decoders/selftest_png.c ****             g_benchH = hgt;
 109:Source/render/decoders/selftest_png.c ****             continue;
 110:Source/render/decoders/selftest_png.c ****         }
 111:Source/render/decoders/selftest_png.c ****         png_free_rows(rows, hgt);
 112:Source/render/decoders/selftest_png.c ****     }
