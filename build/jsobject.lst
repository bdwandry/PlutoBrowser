 455:Source/js/jsobject.c **** 
 456:Source/js/jsobject.c **** static void O_isSealed(js_State *J)
 457:Source/js/jsobject.c **** {
 458:Source/js/jsobject.c **** 	js_Object *obj;
 459:Source/js/jsobject.c **** 
 460:Source/js/jsobject.c **** 	if (!js_isobject(J, 1))
 461:Source/js/jsobject.c **** 		js_typeerror(J, "not an object");
 462:Source/js/jsobject.c **** 
 463:Source/js/jsobject.c **** 	obj = js_toobject(J, 1);
 464:Source/js/jsobject.c **** 	if (obj->extensible) {
 465:Source/js/jsobject.c **** 		js_pushboolean(J, 0);
 466:Source/js/jsobject.c **** 		return;
 467:Source/js/jsobject.c **** 	}
 468:Source/js/jsobject.c **** 
 469:Source/js/jsobject.c **** 	if (obj->properties->level)
 470:Source/js/jsobject.c **** 		js_pushboolean(J, O_isSealed_walk(J, obj->properties));
 471:Source/js/jsobject.c **** 	else
 472:Source/js/jsobject.c **** 		js_pushboolean(J, 1);
 473:Source/js/jsobject.c **** }
