 222:src/util/selftest_util.c **** 
 223:src/util/selftest_util.c **** static int gsub_hex_decode(void* ud, const char* subj, size_t subjLen,
 224:src/util/selftest_util.c ****                            const LPCap caps[], int ncaps, StrBuf* out)
 225:src/util/selftest_util.c **** {
 226:src/util/selftest_util.c ****     (void)ud; (void)subjLen;
 227:src/util/selftest_util.c ****     // Lua passes only the explicit captures to the function; with one
 228:src/util/selftest_util.c ****     // capture group, caps[0] is the hex pair.
 229:src/util/selftest_util.c ****     {
 230:src/util/selftest_util.c ****         size_t cs, cl;
 231:src/util/selftest_util.c ****         if (lp_cap_span(subj, caps, ncaps, 0, &cs, &cl) && cl == 2) {
 232:src/util/selftest_util.c ****             int hi = subj[cs], lo = subj[cs + 1];
 233:src/util/selftest_util.c ****             int v = 0;
 234:src/util/selftest_util.c ****             if (hi >= '0' && hi <= '9') v = hi - '0';
 235:src/util/selftest_util.c ****             else if (hi >= 'a' && hi <= 'f') v = hi - 'a' + 10;
 236:src/util/selftest_util.c ****             else if (hi >= 'A' && hi <= 'F') v = hi - 'A' + 10;
 237:src/util/selftest_util.c ****             v <<= 4;
 238:src/util/selftest_util.c ****             if (lo >= '0' && lo <= '9') v |= lo - '0';
 239:src/util/selftest_util.c ****             else if (lo >= 'a' && lo <= 'f') v |= lo - 'a' + 10;
 240:src/util/selftest_util.c ****             else if (lo >= 'A' && lo <= 'F') v |= lo - 'A' + 10;
 241:src/util/selftest_util.c ****             return sb_append_char(out, (char)v);
 242:src/util/selftest_util.c ****         }
 243:src/util/selftest_util.c ****     }
 244:src/util/selftest_util.c ****     return 0;
 245:src/util/selftest_util.c **** }
