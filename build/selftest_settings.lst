 122:src/ui/selftest_settings.c **** /* ── nav clamps ──────────────────────────
 123:src/ui/selftest_settings.c **** 
 124:src/ui/selftest_settings.c **** static void case_nav(void) {
 125:src/ui/selftest_settings.c ****     sp_open(NULL);
 126:src/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_UP);
 127:src/ui/selftest_settings.c ****     ck("N.up_clamps_top", sp_selected_index() == 1);
 128:src/ui/selftest_settings.c ****     for (int i = 0; i < 9; i++) sp_handle_input(SP_BTN_DOWN);
 129:src/ui/selftest_settings.c ****     ck("N.down_clamps_bottom", sp_selected_index() == SP_OPTION_COUNT);
 130:src/ui/selftest_settings.c **** }
 131:src/ui/selftest_settings.c **** 
 132:src/ui/selftest_settings.c **** /* ── Clear Cookies immediate action ───────────────────�
 133:src/ui/selftest_settings.c **** 
 134:src/ui/selftest_settings.c **** static void case_clear_cookies(void) {
 135:src/ui/selftest_settings.c ****     cj_store("cookies.example", "sid=abc123; Path=/");
 136:src/ui/selftest_settings.c ****     size_t seeded = cj_count();
 137:src/ui/selftest_settings.c ****     if (seeded == 0) {
 138:src/ui/selftest_settings.c ****         PLUTO_ERROR("[P31] cookie seed failed; skipping clear test");
 139:src/ui/selftest_settings.c ****         return;
 140:src/ui/selftest_settings.c ****     }
 141:src/ui/selftest_settings.c **** 
 142:src/ui/selftest_settings.c ****     sp_open(NULL);
 143:src/ui/selftest_settings.c ****     for (int i = 0; i < 4; i++) sp_handle_input(SP_BTN_DOWN); /* row 5 */
 144:src/ui/selftest_settings.c ****     s_changeFired = 0;
 145:src/ui/selftest_settings.c ****     SpAction act = sp_handle_input(SP_BTN_A);
 146:src/ui/selftest_settings.c ****     ck("K.cookies_cleared", cj_count() == 0);
 147:src/ui/selftest_settings.c ****     ck("K.stays_open_no_save",
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cck6s6V3.s 			page 14


 148:src/ui/selftest_settings.c ****        act == SP_ACT_NONE && sp_is_open() == 1 && s_changeFired == 0);
 149:src/ui/selftest_settings.c ****     sp_close();
 150:src/ui/selftest_settings.c **** }
 151:src/ui/selftest_settings.c **** 
 152:src/ui/selftest_settings.c **** /* ── Save semantics + persistence ────────────────────
 153:src/ui/selftest_settings.c **** 
 154:src/ui/selftest_settings.c **** static void case_save(void) {
 155:src/ui/selftest_settings.c ****     sp_open(NULL);
 156:src/ui/selftest_settings.c ****     sp_set_on_change(on_change);
 157:src/ui/selftest_settings.c **** 
 158:src/ui/selftest_settings.c ****     /* change engine to slot 2 and save */
 159:src/ui/selftest_settings.c ****     while (strcmp(sp_staged_engine_name(),
 160:src/ui/selftest_settings.c ****                   PLUTO_SEARCH_ENGINES[1].name) != 0) {
 161:src/ui/selftest_settings.c ****         sp_handle_input(SP_BTN_RIGHT);
 162:src/ui/selftest_settings.c ****     }
 163:src/ui/selftest_settings.c ****     s_changeFired = 0;
 164:src/ui/selftest_settings.c ****     SpAction act = sp_handle_input(SP_BTN_A);
 165:src/ui/selftest_settings.c **** 
 166:src/ui/selftest_settings.c ****     PlutoSettings* st = storage_settings();
 167:src/ui/selftest_settings.c ****     ck("S.saved_action", act == SP_ACT_SAVED);
 168:src/ui/selftest_settings.c ****     ck("S.applied_to_storage", st != NULL && st->searchEngine == 2);
 169:src/ui/selftest_settings.c ****     ck("S.onchange_fired_once", s_changeFired == 1);
 170:src/ui/selftest_settings.c ****     ck("S.closed_after_save", sp_is_open() == 0);
 171:src/ui/selftest_settings.c **** 
 172:src/ui/selftest_settings.c ****     /* persistence across reload */
 173:src/ui/selftest_settings.c ****     ck("S.reload_keeps", storage_load() == 1 &&
 174:src/ui/selftest_settings.c ****                              st->searchEngine == 2);
 175:src/ui/selftest_settings.c ****     st = storage_settings();
 176:src/ui/selftest_settings.c ****     ck("S.reload_pointer_same_values", st != NULL && st->searchEngine == 2);
 177:src/ui/selftest_settings.c **** 
 178:src/ui/selftest_settings.c ****     /* restore default engine for other tests/sessions */
