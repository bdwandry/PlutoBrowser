 205:src/ui/selftest_settings.c **** 
 206:src/ui/selftest_settings.c ****     /* reopen snapshots original value (staged copy discarded) */
 207:src/ui/selftest_settings.c ****     sp_open(NULL);
 208:src/ui/selftest_settings.c ****     ck("X.restage_original",
 209:src/ui/selftest_settings.c ****        strcmp(sp_staged_engine_name(),
 210:src/ui/selftest_settings.c ****               PLUTO_SEARCH_ENGINES[engineBefore - 1].name) == 0);
 211:src/ui/selftest_settings.c ****     sp_close();
 212:src/ui/selftest_settings.c **** }
