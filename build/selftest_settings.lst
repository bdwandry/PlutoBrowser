  62:Source/ui/selftest_settings.c **** static void case_cycles(void) {
  63:Source/ui/selftest_settings.c ****     sp_open(NULL);
  64:Source/ui/selftest_settings.c **** 
  65:Source/ui/selftest_settings.c ****     /* engine (row 1): right advances with wrap; left wraps backwards */
  66:Source/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_RIGHT); /* 1 -> 2 */
  67:Source/ui/selftest_settings.c ****     {
  68:Source/ui/selftest_settings.c ****         const char* want = PLUTO_SEARCH_ENGINES[1].name;
  69:Source/ui/selftest_settings.c ****         ck("C.engine_right",
  70:Source/ui/selftest_settings.c ****            strcmp(sp_staged_engine_name(), want) == 0);
  71:Source/ui/selftest_settings.c ****     }
  72:Source/ui/selftest_settings.c ****     for (int i = 0; i < 3; i++) sp_handle_input(SP_BTN_RIGHT);
  73:Source/ui/selftest_settings.c ****     /* from 2: three rights land on 1 (2->3->4->1) */
  74:Source/ui/selftest_settings.c ****     ck("C.engine_wrap_right",
  75:Source/ui/selftest_settings.c ****        strcmp(sp_staged_engine_name(), PLUTO_SEARCH_ENGINES[0].name) == 0);
  76:Source/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_LEFT); /* 1 -> 4 */
  77:Source/ui/selftest_settings.c ****     ck("C.engine_wrap_left",
  78:Source/ui/selftest_settings.c ****        strcmp(sp_staged_engine_name(),
  79:Source/ui/selftest_settings.c ****               PLUTO_SEARCH_ENGINES[PLUTO_SEARCH_ENGINE_COUNT - 1].name)
  80:Source/ui/selftest_settings.c ****            == 0);
  81:Source/ui/selftest_settings.c **** 
  82:Source/ui/selftest_settings.c ****     /* mode (row 2): toggles both directions, round-trips */
  83:Source/ui/selftest_settings.c ****     nav_to_row(2);
  84:Source/ui/selftest_settings.c ****     const char* before = sp_staged_mode_label();
  85:Source/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_LEFT);
  86:Source/ui/selftest_settings.c ****     const char* mid = sp_staged_mode_label();
  87:Source/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_RIGHT);
  88:Source/ui/selftest_settings.c ****     ck("C.mode_toggles",
  89:Source/ui/selftest_settings.c ****        strcmp(before, mid) != 0 &&
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc0qHmok.s 			page 13


  90:Source/ui/selftest_settings.c ****            strcmp(sp_staged_mode_label(), before) == 0);
  91:Source/ui/selftest_settings.c **** 
  92:Source/ui/selftest_settings.c ****     /* invert crank (row 3): toggle flips On/Off */
  93:Source/ui/selftest_settings.c ****     nav_to_row(3);
  94:Source/ui/selftest_settings.c ****     const char* invBefore = sp_staged_invert_label();
  95:Source/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_LEFT);
  96:Source/ui/selftest_settings.c ****     const char* invMid = sp_staged_invert_label();
  97:Source/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_RIGHT);
  98:Source/ui/selftest_settings.c ****     ck("C.invert_toggles",
  99:Source/ui/selftest_settings.c ****        strcmp(invBefore, invMid) != 0 &&
 100:Source/ui/selftest_settings.c ****            strcmp(sp_staged_invert_label(), invBefore) == 0);
 101:Source/ui/selftest_settings.c **** 
 102:Source/ui/selftest_settings.c ****     /* image mode (row 4): cycles in NAMES order, wraps both ways */
 103:Source/ui/selftest_settings.c ****     nav_to_row(4);
 104:Source/ui/selftest_settings.c ****     const char* img0 = sp_staged_image_label();
 105:Source/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_RIGHT);
 106:Source/ui/selftest_settings.c ****     const char* img1 = sp_staged_image_label();
 107:Source/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_LEFT);
 108:Source/ui/selftest_settings.c ****     ck("C.image_cycle_roundtrip",
 109:Source/ui/selftest_settings.c ****        strcmp(img0, img1) != 0 &&
 110:Source/ui/selftest_settings.c ****            strcmp(sp_staged_image_label(), img0) == 0);
 111:Source/ui/selftest_settings.c **** 
 112:Source/ui/selftest_settings.c ****     /* five rights/lefts from any start -> back to start (5 modes) */
 113:Source/ui/selftest_settings.c ****     const char* imgStart = sp_staged_image_label();
 114:Source/ui/selftest_settings.c ****     for (int i = 0; i < 5; i++) sp_handle_input(SP_BTN_RIGHT);
 115:Source/ui/selftest_settings.c ****     ck("C.image_wrap_right",
 116:Source/ui/selftest_settings.c ****        strcmp(sp_staged_image_label(), imgStart) == 0);
 117:Source/ui/selftest_settings.c ****     for (int i = 0; i < 5; i++) sp_handle_input(SP_BTN_LEFT);
 118:Source/ui/selftest_settings.c ****     ck("C.image_wrap_left",
 119:Source/ui/selftest_settings.c ****        strcmp(sp_staged_image_label(), imgStart) == 0);
 120:Source/ui/selftest_settings.c **** }
