 122:Source/ui/selftest_settings.c **** /* ── nav clamps ──────────────────────────
 123:Source/ui/selftest_settings.c **** 
 124:Source/ui/selftest_settings.c **** static void case_nav(void) {
 125:Source/ui/selftest_settings.c ****     sp_open(NULL);
 126:Source/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_UP);
 127:Source/ui/selftest_settings.c ****     ck("N.up_clamps_top", sp_selected_index() == 1);
 128:Source/ui/selftest_settings.c ****     for (int i = 0; i < 9; i++) sp_handle_input(SP_BTN_DOWN);
 129:Source/ui/selftest_settings.c ****     ck("N.down_clamps_bottom", sp_selected_index() == SP_OPTION_COUNT);
 130:Source/ui/selftest_settings.c **** }
 131:Source/ui/selftest_settings.c **** 
 132:Source/ui/selftest_settings.c **** /* ── Clear Cookies immediate action ───────────────────�
 133:Source/ui/selftest_settings.c **** 
 134:Source/ui/selftest_settings.c **** static void case_clear_cookies(void) {
 135:Source/ui/selftest_settings.c ****     cj_store("cookies.example", "sid=abc123; Path=/");
 136:Source/ui/selftest_settings.c ****     size_t seeded = cj_count();
 137:Source/ui/selftest_settings.c ****     if (seeded == 0) {
 138:Source/ui/selftest_settings.c ****         PLUTO_ERROR("[P31] cookie seed failed; skipping clear test");
 139:Source/ui/selftest_settings.c ****         return;
 140:Source/ui/selftest_settings.c ****     }
 141:Source/ui/selftest_settings.c **** 
 142:Source/ui/selftest_settings.c ****     sp_open(NULL);
 143:Source/ui/selftest_settings.c ****     for (int i = 0; i < 4; i++) sp_handle_input(SP_BTN_DOWN); /* row 5 */
 144:Source/ui/selftest_settings.c ****     s_changeFired = 0;
 145:Source/ui/selftest_settings.c ****     SpAction act = sp_handle_input(SP_BTN_A);
 146:Source/ui/selftest_settings.c ****     ck("K.cookies_cleared", cj_count() == 0);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc0qHmok.s 			page 14


 147:Source/ui/selftest_settings.c ****     ck("K.stays_open_no_save",
 148:Source/ui/selftest_settings.c ****        act == SP_ACT_NONE && sp_is_open() == 1 && s_changeFired == 0);
 149:Source/ui/selftest_settings.c ****     sp_close();
 150:Source/ui/selftest_settings.c **** }
 151:Source/ui/selftest_settings.c **** 
 152:Source/ui/selftest_settings.c **** /* ── Save semantics + persistence ────────────────────
 153:Source/ui/selftest_settings.c **** 
 154:Source/ui/selftest_settings.c **** static void case_save(void) {
 155:Source/ui/selftest_settings.c ****     sp_open(NULL);
 156:Source/ui/selftest_settings.c ****     sp_set_on_change(on_change);
 157:Source/ui/selftest_settings.c **** 
 158:Source/ui/selftest_settings.c ****     /* change engine to slot 2 and save */
 159:Source/ui/selftest_settings.c ****     while (strcmp(sp_staged_engine_name(),
 160:Source/ui/selftest_settings.c ****                   PLUTO_SEARCH_ENGINES[1].name) != 0) {
 161:Source/ui/selftest_settings.c ****         sp_handle_input(SP_BTN_RIGHT);
 162:Source/ui/selftest_settings.c ****     }
 163:Source/ui/selftest_settings.c ****     s_changeFired = 0;
 164:Source/ui/selftest_settings.c ****     SpAction act = sp_handle_input(SP_BTN_A);
 165:Source/ui/selftest_settings.c **** 
 166:Source/ui/selftest_settings.c ****     PlutoSettings* st = storage_settings();
 167:Source/ui/selftest_settings.c ****     ck("S.saved_action", act == SP_ACT_SAVED);
 168:Source/ui/selftest_settings.c ****     ck("S.applied_to_storage", st != NULL && st->searchEngine == 2);
 169:Source/ui/selftest_settings.c ****     ck("S.onchange_fired_once", s_changeFired == 1);
 170:Source/ui/selftest_settings.c ****     ck("S.closed_after_save", sp_is_open() == 0);
 171:Source/ui/selftest_settings.c **** 
 172:Source/ui/selftest_settings.c ****     /* persistence across reload */
 173:Source/ui/selftest_settings.c ****     ck("S.reload_keeps", storage_load() == 1 &&
 174:Source/ui/selftest_settings.c ****                              st->searchEngine == 2);
 175:Source/ui/selftest_settings.c ****     st = storage_settings();
 176:Source/ui/selftest_settings.c ****     ck("S.reload_pointer_same_values", st != NULL && st->searchEngine == 2);
 177:Source/ui/selftest_settings.c **** 
 178:Source/ui/selftest_settings.c ****     /* restore default engine for other tests/sessions */
 179:Source/ui/selftest_settings.c ****     sp_open(NULL);
 180:Source/ui/selftest_settings.c ****     while (st != NULL &&
 181:Source/ui/selftest_settings.c ****            strcmp(sp_staged_engine_name(), PLUTO_SEARCH_ENGINES[0].name)
