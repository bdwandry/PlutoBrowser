 191:Source/ui/selftest_settings.c **** 
 192:Source/ui/selftest_settings.c **** static void case_cancel(void) {
 193:Source/ui/selftest_settings.c ****     PlutoSettings* st = storage_settings();
 194:Source/ui/selftest_settings.c ****     int engineBefore = st ? st->searchEngine : 1;
 195:Source/ui/selftest_settings.c **** 
 196:Source/ui/selftest_settings.c ****     sp_open(NULL);
 197:Source/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_RIGHT); /* stage a different engine */
 198:Source/ui/selftest_settings.c ****     s_changeFired = 0;
 199:Source/ui/selftest_settings.c ****     SpAction act = sp_handle_input(SP_BTN_B);
 200:Source/ui/selftest_settings.c **** 
 201:Source/ui/selftest_settings.c ****     ck("X.closed_action", act == SP_ACT_CLOSED && sp_is_open() == 0);
 202:Source/ui/selftest_settings.c ****     ck("X.storage_untouched",
 203:Source/ui/selftest_settings.c ****        st != NULL && st->searchEngine == engineBefore);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc0qHmok.s 			page 15


 204:Source/ui/selftest_settings.c ****     ck("X.no_onchange", s_changeFired == 0);
 205:Source/ui/selftest_settings.c **** 
 206:Source/ui/selftest_settings.c ****     /* reopen snapshots original value (staged copy discarded) */
 207:Source/ui/selftest_settings.c ****     sp_open(NULL);
 208:Source/ui/selftest_settings.c ****     ck("X.restage_original",
 209:Source/ui/selftest_settings.c ****        strcmp(sp_staged_engine_name(),
 210:Source/ui/selftest_settings.c ****               PLUTO_SEARCH_ENGINES[engineBefore - 1].name) == 0);
 211:Source/ui/selftest_settings.c ****     sp_close();
 212:Source/ui/selftest_settings.c **** }
