 132:Source/ui/selftest_settings.c **** /* ── nav clamps ──────────────────────────
 133:Source/ui/selftest_settings.c **** 
 134:Source/ui/selftest_settings.c **** static void case_nav(void) {
 135:Source/ui/selftest_settings.c ****     sp_open(NULL);
 136:Source/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_UP);
 137:Source/ui/selftest_settings.c ****     ck("N.up_clamps_top", sp_selected_index() == 1);
 138:Source/ui/selftest_settings.c ****     for (int i = 0; i < 9; i++) sp_handle_input(SP_BTN_DOWN);
 139:Source/ui/selftest_settings.c ****     ck("N.down_clamps_bottom", sp_selected_index() == SP_OPTION_COUNT);
 140:Source/ui/selftest_settings.c **** }
 141:Source/ui/selftest_settings.c **** 
 142:Source/ui/selftest_settings.c **** /* ── Clear Cookies immediate action ───────────────────�
 143:Source/ui/selftest_settings.c **** 
 144:Source/ui/selftest_settings.c **** static void case_clear_cookies(void) {
 145:Source/ui/selftest_settings.c ****     cj_store("cookies.example", "sid=abc123; Path=/");
 146:Source/ui/selftest_settings.c ****     size_t seeded = cj_count();
 147:Source/ui/selftest_settings.c ****     if (seeded == 0) {
 148:Source/ui/selftest_settings.c ****         PLUTO_ERROR("[P31] cookie seed failed; skipping clear test");
 149:Source/ui/selftest_settings.c ****         return;
 150:Source/ui/selftest_settings.c ****     }
 151:Source/ui/selftest_settings.c **** 
 152:Source/ui/selftest_settings.c ****     sp_open(NULL);
 153:Source/ui/selftest_settings.c ****     for (int i = 0; i < 4; i++) sp_handle_input(SP_BTN_DOWN); /* row 5 */
 154:Source/ui/selftest_settings.c ****     s_changeFired = 0;
 155:Source/ui/selftest_settings.c ****     SpAction act = sp_handle_input(SP_BTN_A);
 156:Source/ui/selftest_settings.c ****     ck("K.cookies_cleared", cj_count() == 0);
 157:Source/ui/selftest_settings.c ****     ck("K.stays_open_no_save",
 158:Source/ui/selftest_settings.c ****        act == SP_ACT_NONE && sp_is_open() == 1 && s_changeFired == 0);
 159:Source/ui/selftest_settings.c ****     sp_close();
 160:Source/ui/selftest_settings.c **** }
 161:Source/ui/selftest_settings.c **** 
 162:Source/ui/selftest_settings.c **** /* ── Save semantics + persistence ────────────────────
 163:Source/ui/selftest_settings.c **** 
 164:Source/ui/selftest_settings.c **** static void case_save(void) {
