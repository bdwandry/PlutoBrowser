 183:Source/ui/selftest_settings.c ****         sp_handle_input(SP_BTN_RIGHT);
 184:Source/ui/selftest_settings.c ****     }
 185:Source/ui/selftest_settings.c ****     s_changeFired = 0;
 186:Source/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_A);
 187:Source/ui/selftest_settings.c ****     ck("S.restore_default", st->searchEngine == 1);
 188:Source/ui/selftest_settings.c **** }
