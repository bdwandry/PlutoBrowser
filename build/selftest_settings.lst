  62:src/ui/selftest_settings.c **** static void case_cycles(void) {
  63:src/ui/selftest_settings.c ****     sp_open(NULL);
  64:src/ui/selftest_settings.c **** 
  65:src/ui/selftest_settings.c ****     /* engine (row 1): right advances with wrap; left wraps backwards */
  66:src/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_RIGHT); /* 1 -> 2 */
  67:src/ui/selftest_settings.c ****     {
  68:src/ui/selftest_settings.c ****         const char* want = PLUTO_SEARCH_ENGINES[1].name;
  69:src/ui/selftest_settings.c ****         ck("C.engine_right",
  70:src/ui/selftest_settings.c ****            strcmp(sp_staged_engine_name(), want) == 0);
  71:src/ui/selftest_settings.c ****     }
  72:src/ui/selftest_settings.c ****     for (int i = 0; i < 3; i++) sp_handle_input(SP_BTN_RIGHT);
  73:src/ui/selftest_settings.c ****     /* from 2: three rights land on 1 (2->3->4->1) */
  74:src/ui/selftest_settings.c ****     ck("C.engine_wrap_right",
  75:src/ui/selftest_settings.c ****        strcmp(sp_staged_engine_name(), PLUTO_SEARCH_ENGINES[0].name) == 0);
  76:src/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_LEFT); /* 1 -> 4 */
  77:src/ui/selftest_settings.c ****     ck("C.engine_wrap_left",
  78:src/ui/selftest_settings.c ****        strcmp(sp_staged_engine_name(),
  79:src/ui/selftest_settings.c ****               PLUTO_SEARCH_ENGINES[PLUTO_SEARCH_ENGINE_COUNT - 1].name)
  80:src/ui/selftest_settings.c ****            == 0);
  81:src/ui/selftest_settings.c **** 
  82:src/ui/selftest_settings.c ****     /* mode (row 2): toggles both directions, round-trips */
  83:src/ui/selftest_settings.c ****     nav_to_row(2);
  84:src/ui/selftest_settings.c ****     const char* before = sp_staged_mode_label();
  85:src/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_LEFT);
  86:src/ui/selftest_settings.c ****     const char* mid = sp_staged_mode_label();
  87:src/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_RIGHT);
  88:src/ui/selftest_settings.c ****     ck("C.mode_toggles",
  89:src/ui/selftest_settings.c ****        strcmp(before, mid) != 0 &&
  90:src/ui/selftest_settings.c ****            strcmp(sp_staged_mode_label(), before) == 0);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cck6s6V3.s 			page 13


  91:src/ui/selftest_settings.c **** 
  92:src/ui/selftest_settings.c ****     /* invert crank (row 3): toggle flips On/Off */
  93:src/ui/selftest_settings.c ****     nav_to_row(3);
  94:src/ui/selftest_settings.c ****     const char* invBefore = sp_staged_invert_label();
  95:src/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_LEFT);
  96:src/ui/selftest_settings.c ****     const char* invMid = sp_staged_invert_label();
  97:src/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_RIGHT);
  98:src/ui/selftest_settings.c ****     ck("C.invert_toggles",
  99:src/ui/selftest_settings.c ****        strcmp(invBefore, invMid) != 0 &&
 100:src/ui/selftest_settings.c ****            strcmp(sp_staged_invert_label(), invBefore) == 0);
 101:src/ui/selftest_settings.c **** 
 102:src/ui/selftest_settings.c ****     /* image mode (row 4): cycles in NAMES order, wraps both ways */
 103:src/ui/selftest_settings.c ****     nav_to_row(4);
 104:src/ui/selftest_settings.c ****     const char* img0 = sp_staged_image_label();
 105:src/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_RIGHT);
 106:src/ui/selftest_settings.c ****     const char* img1 = sp_staged_image_label();
 107:src/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_LEFT);
 108:src/ui/selftest_settings.c ****     ck("C.image_cycle_roundtrip",
 109:src/ui/selftest_settings.c ****        strcmp(img0, img1) != 0 &&
 110:src/ui/selftest_settings.c ****            strcmp(sp_staged_image_label(), img0) == 0);
 111:src/ui/selftest_settings.c **** 
 112:src/ui/selftest_settings.c ****     /* five rights/lefts from any start -> back to start (5 modes) */
 113:src/ui/selftest_settings.c ****     const char* imgStart = sp_staged_image_label();
 114:src/ui/selftest_settings.c ****     for (int i = 0; i < 5; i++) sp_handle_input(SP_BTN_RIGHT);
 115:src/ui/selftest_settings.c ****     ck("C.image_wrap_right",
 116:src/ui/selftest_settings.c ****        strcmp(sp_staged_image_label(), imgStart) == 0);
 117:src/ui/selftest_settings.c ****     for (int i = 0; i < 5; i++) sp_handle_input(SP_BTN_LEFT);
 118:src/ui/selftest_settings.c ****     ck("C.image_wrap_left",
 119:src/ui/selftest_settings.c ****        strcmp(sp_staged_image_label(), imgStart) == 0);
 120:src/ui/selftest_settings.c **** }
