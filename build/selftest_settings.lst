 192:src/ui/selftest_settings.c **** static void case_cancel(void) {
 193:src/ui/selftest_settings.c ****     PlutoSettings* st = storage_settings();
 194:src/ui/selftest_settings.c ****     int engineBefore = st ? st->searchEngine : 1;
 195:src/ui/selftest_settings.c **** 
 196:src/ui/selftest_settings.c ****     sp_open(NULL);
 197:src/ui/selftest_settings.c ****     sp_handle_input(SP_BTN_RIGHT); /* stage a different engine */
 198:src/ui/selftest_settings.c ****     s_changeFired = 0;
 199:src/ui/selftest_settings.c ****     SpAction act = sp_handle_input(SP_BTN_B);
 200:src/ui/selftest_settings.c **** 
 201:src/ui/selftest_settings.c ****     ck("X.closed_action", act == SP_ACT_CLOSED && sp_is_open() == 0);
 202:src/ui/selftest_settings.c ****     ck("X.storage_untouched",
 203:src/ui/selftest_settings.c ****        st != NULL && st->searchEngine == engineBefore);
 204:src/ui/selftest_settings.c ****     ck("X.no_onchange", s_changeFired == 0);
