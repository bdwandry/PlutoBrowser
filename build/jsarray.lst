 202:Source/js/jsarray.c **** static void Ap_reverse(js_State *J)
 203:Source/js/jsarray.c **** {
 204:Source/js/jsarray.c **** 	int len, middle, lower;
 205:Source/js/jsarray.c **** 
 206:Source/js/jsarray.c **** 	len = js_getlength(J, 0);
 207:Source/js/jsarray.c **** 	middle = len / 2;
 208:Source/js/jsarray.c **** 	lower = 0;
 209:Source/js/jsarray.c **** 
 210:Source/js/jsarray.c **** 	while (lower != middle) {
 211:Source/js/jsarray.c **** 		int upper = len - lower - 1;
 212:Source/js/jsarray.c **** 		int haslower = js_hasindex(J, 0, lower);
 213:Source/js/jsarray.c **** 		int hasupper = js_hasindex(J, 0, upper);
 214:Source/js/jsarray.c **** 		if (haslower && hasupper) {
 215:Source/js/jsarray.c **** 			js_setindex(J, 0, lower);
 216:Source/js/jsarray.c **** 			js_setindex(J, 0, upper);
 217:Source/js/jsarray.c **** 		} else if (hasupper) {
 218:Source/js/jsarray.c **** 			js_setindex(J, 0, lower);
 219:Source/js/jsarray.c **** 			js_delindex(J, 0, upper);
 220:Source/js/jsarray.c **** 		} else if (haslower) {
 221:Source/js/jsarray.c **** 			js_setindex(J, 0, upper);
 222:Source/js/jsarray.c **** 			js_delindex(J, 0, lower);
 223:Source/js/jsarray.c **** 		}
 224:Source/js/jsarray.c **** 		++lower;
 225:Source/js/jsarray.c **** 	}
 226:Source/js/jsarray.c **** 
 227:Source/js/jsarray.c **** 	js_copy(J, 0);
 228:Source/js/jsarray.c **** }
