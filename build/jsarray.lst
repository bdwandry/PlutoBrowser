 418:Source/js/jsarray.c **** static void Ap_sort_heapsort(js_State *J, int n)
 419:Source/js/jsarray.c **** {
 420:Source/js/jsarray.c **** 	int i;
 421:Source/js/jsarray.c **** 	for (i = n / 2 - 1; i >= 0; --i)
 422:Source/js/jsarray.c **** 		Ap_sort_sift(J, i, n);
 423:Source/js/jsarray.c **** 	for (i = n - 1; i > 0; --i) {
 424:Source/js/jsarray.c **** 		Ap_sort_swap(J, 0, i);
 425:Source/js/jsarray.c **** 		Ap_sort_sift(J, 0, i);
 426:Source/js/jsarray.c **** 	}
 427:Source/js/jsarray.c **** }
 428:Source/js/jsarray.c **** 
 429:Source/js/jsarray.c **** static void Ap_sort(js_State *J)
 430:Source/js/jsarray.c **** {
 431:Source/js/jsarray.c **** 	int len;
 432:Source/js/jsarray.c **** 
 433:Source/js/jsarray.c **** 	len = js_getlength(J, 0);
 434:Source/js/jsarray.c **** 	if (len <= 1) {
 435:Source/js/jsarray.c **** 		js_copy(J, 0);
 436:Source/js/jsarray.c **** 		return;
 437:Source/js/jsarray.c **** 	}
 438:Source/js/jsarray.c **** 
 439:Source/js/jsarray.c **** 	if (!js_iscallable(J, 1) && !js_isundefined(J, 1))
 440:Source/js/jsarray.c **** 		js_typeerror(J, "comparison function must be a function or undefined");
 441:Source/js/jsarray.c **** 
 442:Source/js/jsarray.c **** 	if (len >= INT_MAX)
 443:Source/js/jsarray.c **** 		js_rangeerror(J, "array is too large to sort");
 444:Source/js/jsarray.c **** 
 445:Source/js/jsarray.c **** 	Ap_sort_heapsort(J, len);
 446:Source/js/jsarray.c **** 
 447:Source/js/jsarray.c **** 	js_copy(J, 0);
 448:Source/js/jsarray.c **** }
