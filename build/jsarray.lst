 449:Source/js/jsarray.c **** 
 450:Source/js/jsarray.c **** static void Ap_splice(js_State *J)
 451:Source/js/jsarray.c **** {
 452:Source/js/jsarray.c **** 	int top = js_gettop(J);
 453:Source/js/jsarray.c **** 	int len, start, del, add, k;
 454:Source/js/jsarray.c **** 
 455:Source/js/jsarray.c **** 	len = js_getlength(J, 0);
 456:Source/js/jsarray.c **** 	start = js_tointeger(J, 1);
 457:Source/js/jsarray.c **** 	if (start < 0)
 458:Source/js/jsarray.c **** 		start = (len + start) > 0 ? len + start : 0;
 459:Source/js/jsarray.c **** 	else if (start > len)
 460:Source/js/jsarray.c **** 		start = len;
 461:Source/js/jsarray.c **** 
 462:Source/js/jsarray.c **** 	if (js_isdefined(J, 2))
 463:Source/js/jsarray.c **** 		del = js_tointeger(J, 2);
 464:Source/js/jsarray.c **** 	else
 465:Source/js/jsarray.c **** 		del = len - start;
 466:Source/js/jsarray.c **** 	if (del > len - start)
 467:Source/js/jsarray.c **** 		del = len - start;
 468:Source/js/jsarray.c **** 	if (del < 0)
 469:Source/js/jsarray.c **** 		del = 0;
 470:Source/js/jsarray.c **** 
 471:Source/js/jsarray.c **** 	js_newarray(J);
 472:Source/js/jsarray.c **** 
 473:Source/js/jsarray.c **** 	/* copy deleted items to return array */
 474:Source/js/jsarray.c **** 	for (k = 0; k < del; ++k)
 475:Source/js/jsarray.c **** 		if (js_hasindex(J, 0, start + k))
 476:Source/js/jsarray.c **** 			js_setindex(J, -2, k);
 477:Source/js/jsarray.c **** 	js_setlength(J, -1, del);
 478:Source/js/jsarray.c **** 
 479:Source/js/jsarray.c **** 	/* shift the tail to resize the hole left by deleted items */
 480:Source/js/jsarray.c **** 	add = top - 3;
 481:Source/js/jsarray.c **** 	if (add < del) {
 482:Source/js/jsarray.c **** 		for (k = start; k < len - del; ++k) {
 483:Source/js/jsarray.c **** 			if (js_hasindex(J, 0, k + del))
 484:Source/js/jsarray.c **** 				js_setindex(J, 0, k + add);
 485:Source/js/jsarray.c **** 			else
 486:Source/js/jsarray.c **** 				js_delindex(J, 0, k + add);
 487:Source/js/jsarray.c **** 		}
 488:Source/js/jsarray.c **** 		for (k = len; k > len - del + add; --k)
 489:Source/js/jsarray.c **** 			js_delindex(J, 0, k - 1);
 490:Source/js/jsarray.c **** 	} else if (add > del) {
 491:Source/js/jsarray.c **** 		for (k = len - del; k > start; --k) {
 492:Source/js/jsarray.c **** 			if (js_hasindex(J, 0, k + del - 1))
 493:Source/js/jsarray.c **** 				js_setindex(J, 0, k + add - 1);
 494:Source/js/jsarray.c **** 			else
 495:Source/js/jsarray.c **** 				js_delindex(J, 0, k + add - 1);
 496:Source/js/jsarray.c **** 		}
 497:Source/js/jsarray.c **** 	}
 498:Source/js/jsarray.c **** 
 499:Source/js/jsarray.c **** 	/* copy new items into the hole */
 500:Source/js/jsarray.c **** 	for (k = 0; k < add; ++k) {
 501:Source/js/jsarray.c **** 		js_copy(J, 3 + k);
 502:Source/js/jsarray.c **** 		js_setindex(J, 0, start + k);
 503:Source/js/jsarray.c **** 	}
 504:Source/js/jsarray.c **** 
 505:Source/js/jsarray.c **** 	js_setlength(J, 0, len - del + add);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccQQsOeW.s 			page 32


 506:Source/js/jsarray.c **** }
 507:Source/js/jsarray.c **** 
 508:Source/js/jsarray.c **** static void Ap_unshift(js_State *J)
 509:Source/js/jsarray.c **** {
 510:Source/js/jsarray.c **** 	int i, top = js_gettop(J);
 511:Source/js/jsarray.c **** 	int k, len;
 512:Source/js/jsarray.c **** 
 513:Source/js/jsarray.c **** 	len = js_getlength(J, 0);
 514:Source/js/jsarray.c **** 
 515:Source/js/jsarray.c **** 	for (k = len; k > 0; --k) {
 516:Source/js/jsarray.c **** 		int from = k - 1;
 517:Source/js/jsarray.c **** 		int to = k + top - 2;
 518:Source/js/jsarray.c **** 		if (js_hasindex(J, 0, from))
 519:Source/js/jsarray.c **** 			js_setindex(J, 0, to);
 520:Source/js/jsarray.c **** 		else
 521:Source/js/jsarray.c **** 			js_delindex(J, 0, to);
 522:Source/js/jsarray.c **** 	}
 523:Source/js/jsarray.c **** 
 524:Source/js/jsarray.c **** 	for (i = 1; i < top; ++i) {
 525:Source/js/jsarray.c **** 		js_copy(J, i);
 526:Source/js/jsarray.c **** 		js_setindex(J, 0, i - 1);
 527:Source/js/jsarray.c **** 	}
 528:Source/js/jsarray.c **** 
 529:Source/js/jsarray.c **** 	js_setlength(J, 0, len + top - 1);
 530:Source/js/jsarray.c **** 
 531:Source/js/jsarray.c **** 	js_pushnumber(J, len + top - 1);
 532:Source/js/jsarray.c **** }
