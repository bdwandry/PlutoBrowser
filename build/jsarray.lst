 385:Source/js/jsarray.c **** 
 386:Source/js/jsarray.c **** /* A bottom-up/bouncing heapsort implementation */
 387:Source/js/jsarray.c **** 
 388:Source/js/jsarray.c **** static int Ap_sort_leaf(js_State *J, int i, int end)
 389:Source/js/jsarray.c **** {
 390:Source/js/jsarray.c **** 	int j = i;
 391:Source/js/jsarray.c **** 	int lc = (j << 1) + 1; /* left child */
 392:Source/js/jsarray.c **** 	int rc = (j << 1) + 2; /* right child */
 393:Source/js/jsarray.c **** 	while (rc < end) {
 394:Source/js/jsarray.c **** 		if (Ap_sort_cmp(J, lc, rc) <= 0)
 395:Source/js/jsarray.c **** 			j = rc;
 396:Source/js/jsarray.c **** 		else
 397:Source/js/jsarray.c **** 			j = lc;
 398:Source/js/jsarray.c **** 		lc = (j << 1) + 1;
 399:Source/js/jsarray.c **** 		rc = (j << 1) + 2;
 400:Source/js/jsarray.c **** 	}
