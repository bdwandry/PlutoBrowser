 689:Source/core/browser.c ****     if ((in->justPressed & BR_BTN_LEFT ||
 690:Source/core/browser.c ****          in->justPressed & BR_BTN_RIGHT) &&
 691:Source/core/browser.c ****         s_menu.viewIndex == s_br.menuSel)
 692:Source/core/browser.c ****         menu_cycle_view(in->justPressed & BR_BTN_RIGHT ? 1 : -1);
 693:Source/core/browser.c ****     if (in->justPressed & BR_BTN_A)
 694:Source/core/browser.c ****         menu_activate(s_br.menuSel);
 695:Source/core/browser.c ****     if (in->justPressed & BR_BTN_B)
 696:Source/core/browser.c ****         s_br.menuOpen = 0;
 697:Source/core/browser.c **** }
