 217:Source/core/browser.c **** static BrDetailsEntry* details_find(const char* key) {
 218:Source/core/browser.c ****     for (size_t i = 0; i < s_br.nDetails; i++)
 219:Source/core/browser.c ****         if (!strcmp(s_br.details[i].key, key)) return &s_br.details[i];
 220:Source/core/browser.c ****     return NULL;
 221:Source/core/browser.c **** }
 222:Source/core/browser.c **** 
 223:Source/core/browser.c **** static int details_toggle(const char* key) {
 224:Source/core/browser.c ****     BrDetailsEntry* e = details_find(key);
 225:Source/core/browser.c ****     if (e) { e->open = !e->open; return e->open; }
 226:Source/core/browser.c ****     if (s_br.nDetails >= sizeof(s_br.details) / sizeof(s_br.details[0]))
 227:Source/core/browser.c ****         return 0;
 228:Source/core/browser.c ****     e = &s_br.details[s_br.nDetails++];
 229:Source/core/browser.c ****     str_copy(e->key, sizeof(e->key), key);
 230:Source/core/browser.c ****     e->open = 1;
 231:Source/core/browser.c ****     return 1;
 232:Source/core/browser.c **** }
 233:Source/core/browser.c **** 
 234:Source/core/browser.c **** static size_t details_build_overrides(const DocDetailsOverride** out) {
