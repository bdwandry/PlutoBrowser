 217:src/core/browser.c **** static BrDetailsEntry* details_find(const char* key) {
 218:src/core/browser.c ****     for (size_t i = 0; i < s_br.nDetails; i++)
 219:src/core/browser.c ****         if (!strcmp(s_br.details[i].key, key)) return &s_br.details[i];
 220:src/core/browser.c ****     return NULL;
 221:src/core/browser.c **** }
 222:src/core/browser.c **** 
 223:src/core/browser.c **** static int details_toggle(const char* key) {
 224:src/core/browser.c ****     BrDetailsEntry* e = details_find(key);
 225:src/core/browser.c ****     if (e) { e->open = !e->open; return e->open; }
 226:src/core/browser.c ****     if (s_br.nDetails >= sizeof(s_br.details) / sizeof(s_br.details[0]))
 227:src/core/browser.c ****         return 0;
 228:src/core/browser.c ****     e = &s_br.details[s_br.nDetails++];
 229:src/core/browser.c ****     str_copy(e->key, sizeof(e->key), key);
 230:src/core/browser.c ****     e->open = 1;
 231:src/core/browser.c ****     return 1;
 232:src/core/browser.c **** }
 233:src/core/browser.c **** 
 234:src/core/browser.c **** static size_t details_build_overrides(const DocDetailsOverride** out) {
 235:src/core/browser.c ****     static DocDetailsOverride ov[32];
 236:src/core/browser.c ****     size_t n = 0;
 237:src/core/browser.c ****     for (size_t i = 0; i < s_br.nDetails && n < 32; i++) {
 238:src/core/browser.c ****         ov[n].key  = s_br.details[i].key;
 239:src/core/browser.c ****         ov[n].open = s_br.details[i].open;
 240:src/core/browser.c ****         n++;
 241:src/core/browser.c ****     }
