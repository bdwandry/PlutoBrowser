 690:Source/core/browser.c ****          in->justPressed & BR_BTN_RIGHT) &&
 691:Source/core/browser.c ****         s_menu.viewIndex == s_br.menuSel)
 692:Source/core/browser.c ****         menu_cycle_view(in->justPressed & BR_BTN_RIGHT ? 1 : -1);
