 172:src/core/browser.c **** /* ── history stack (pushHistory/goBack/goForward, cap 30) ────────────
 173:src/core/browser.c **** 
 174:src/core/browser.c **** static void push_history(const char* urlString) {
 175:src/core/browser.c ****     /* navigating somewhere new clears the future */
 176:src/core/browser.c ****     if (s_br.hIdx < s_br.nHistory - 1) s_br.nHistory = s_br.hIdx + 1;
 177:src/core/browser.c **** 
 178:src/core/browser.c ****     if (s_br.nHistory > 0 &&
 179:src/core/browser.c ****         !strcmp(s_br.navHistory[s_br.nHistory - 1], urlString))
 180:src/core/browser.c ****         return;
 181:src/core/browser.c **** 
 182:src/core/browser.c ****     if (s_br.nHistory < BR_MAX_HISTORY)
 183:src/core/browser.c ****         str_copy(s_br.navHistory[s_br.nHistory++],
 184:src/core/browser.c ****                  PLUTO_URL_NORMALIZED_MAX, urlString);
 185:src/core/browser.c ****     else {
 186:src/core/browser.c ****         memmove(s_br.navHistory, s_br.navHistory + 1,
 187:src/core/browser.c ****                 sizeof(s_br.navHistory[0]) * (BR_MAX_HISTORY - 1));
 188:src/core/browser.c ****         str_copy(s_br.navHistory[BR_MAX_HISTORY - 1],
 189:src/core/browser.c ****                  PLUTO_URL_NORMALIZED_MAX, urlString);
 190:src/core/browser.c ****     }
 191:src/core/browser.c ****     s_br.hIdx = s_br.nHistory - 1;
 192:src/core/browser.c **** }
 193:src/core/browser.c **** 
 194:src/core/browser.c **** static int go_back_url(char* out, size_t cap) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cccCydPC.s 			page 6


 195:src/core/browser.c ****     if (s_br.hIdx <= 0) return 0;
 196:src/core/browser.c ****     s_br.hIdx--;
 197:src/core/browser.c ****     s_br.navigatingHistory = 1;
 198:src/core/browser.c ****     str_copy(out, cap, s_br.navHistory[s_br.hIdx]);
 199:src/core/browser.c ****     return 1;
 200:src/core/browser.c **** }
 201:src/core/browser.c **** 
 202:src/core/browser.c **** static int go_forward_url(char* out, size_t cap) {
 203:src/core/browser.c ****     if (s_br.hIdx >= s_br.nHistory - 1) return 0;
 204:src/core/browser.c ****     s_br.hIdx++;
 205:src/core/browser.c ****     s_br.navigatingHistory = 1;
 206:src/core/browser.c ****     str_copy(out, cap, s_br.navHistory[s_br.hIdx]);
 207:src/core/browser.c ****     return 1;
 208:src/core/browser.c **** }
 209:src/core/browser.c **** 
 210:src/core/browser.c **** int br_go_back(void)    { char u[PLUTO_URL_NORMALIZED_MAX];
 211:src/core/browser.c ****                           return go_back_url(u, sizeof(u)); }
 212:src/core/browser.c **** int br_go_forward(void) { char u[PLUTO_URL_NORMALIZED_MAX];
 213:src/core/browser.c ****                           return go_forward_url(u, sizeof(u)); }
