 594:Source/core/browser.c **** /* ── Native system menu (Lua main.lua parity) ────────────────
 595:Source/core/browser.c ****  * The C_API DOES expose playdate->system menu items (the old custom
 596:Source/core/browser.c ****  * overlay premise was wrong): Home-Page / View(Reader|HTML) / Settings /
 597:Source/core/browser.c ****  * History / Clear Cookies, rebuilt whenever the View row's presence or
 598:Source/core/browser.c ****  * the current mode changes. Callbacks only stage work; it executes in
 599:Source/core/browser.c ****  * the next br_frame() after the system menu resumes the game. */
 600:Source/core/browser.c **** 
 601:Source/core/browser.c **** static PDMenuItem* s_viewItem = NULL;
 602:Source/core/browser.c **** 
 603:Source/core/browser.c **** static void mi_home_cb(void* ud)    { (void)ud; menu_action_home(); }
 604:Source/core/browser.c **** static void mi_settings_cb(void* ud){ (void)ud; menu_action_settings();
 605:Source/core/browser.c ****                                       br_system_menu_refresh(); }
 606:Source/core/browser.c **** static void mi_history_cb(void* ud) { (void)ud; menu_action_history();
 607:Source/core/browser.c ****                                       br_system_menu_refresh(); }
 608:Source/core/browser.c **** static void mi_cookies_cb(void* ud) { (void)ud; cj_clear(); }
 609:Source/core/browser.c **** 
 610:Source/core/browser.c **** static void mi_view_cb(void* ud) {
 611:Source/core/browser.c ****     (void)ud;
 612:Source/core/browser.c ****     int v = s_pd->system->getMenuItemValue(s_viewItem);
 613:Source/core/browser.c ****     /* Lua: options are { "Reader", "HTML" } */
 614:Source/core/browser.c ****     apply_view_mode(v == 0 ? PLUTO_MODE_READER : PLUTO_MODE_RAW_HTML);
 615:Source/core/browser.c **** }
 616:Source/core/browser.c **** 
 617:Source/core/browser.c **** void br_system_menu_refresh(void) {
 618:Source/core/browser.c ****     if (s_pd == NULL) return;
 619:Source/core/browser.c ****     s_pd->system->removeAllMenuItems();
 620:Source/core/browser.c ****     s_pd->system->addMenuItem("Home-Page", mi_home_cb, NULL);
 621:Source/core/browser.c ****     s_viewItem = NULL;
 622:Source/core/browser.c ****     if (s_br.state == PLUTO_STATE_PAGE && s_br.hasUrl &&
 623:Source/core/browser.c ****         strcmp(s_br.curUrl.scheme, "about") != 0) {
 624:Source/core/browser.c ****         static const char* opts[2] = { "Reader", "HTML" };
 625:Source/core/browser.c ****         s_viewItem = s_pd->system->addOptionsMenuItem(
 626:Source/core/browser.c ****             "View", opts, 2, mi_view_cb, NULL);
 627:Source/core/browser.c ****         /* Lua: initial selection reflects the active browse mode */
 628:Source/core/browser.c ****         s_pd->system->setMenuItemValue(
 629:Source/core/browser.c ****             s_viewItem,
 630:Source/core/browser.c ****             s_br.browseMode == PLUTO_MODE_READER ? 0 : 1);
 631:Source/core/browser.c ****     }
 632:Source/core/browser.c ****     s_pd->system->addMenuItem("Settings", mi_settings_cb, NULL);
 633:Source/core/browser.c ****     s_pd->system->addMenuItem("History", mi_history_cb, NULL);
 634:Source/core/browser.c ****     s_pd->system->addMenuItem("Clear Cookies", mi_cookies_cb, NULL);
 635:Source/core/browser.c **** }
