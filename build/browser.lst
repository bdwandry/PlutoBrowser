 830:Source/core/browser.c **** static int render_step(void* ctx) {
 831:Source/core/browser.c ****     BrRenderCtx* c = (BrRenderCtx*)ctx;
 832:Source/core/browser.c ****     if (c->stage == 0) {
 833:Source/core/browser.c ****         c->doc = doc_parse_opts(c->body, c->url, s_br.browseMode, NULL);
 834:Source/core/browser.c ****         if (c->doc == NULL) {
 835:Source/core/browser.c ****             tasks_set_error("Parse Error: document unavailable");
 836:Source/core/browser.c ****             return PLUTO_TASK_ERROR;
 837:Source/core/browser.c ****         }
 838:Source/core/browser.c ****         tasks_report_progress(0.5);
 839:Source/core/browser.c ****         c->stage = 1;
 840:Source/core/browser.c ****         return PLUTO_TASK_YIELD;   /* yield: layout next slice */
 841:Source/core/browser.c ****     }
 842:Source/core/browser.c ****     layout_build(c->doc);
 843:Source/core/browser.c ****     tasks_report_progress(1.0);
 844:Source/core/browser.c ****     return PLUTO_TASK_DONE;
 845:Source/core/browser.c **** }
 846:Source/core/browser.c **** 
 847:Source/core/browser.c **** static void render_done(void* ctx, void* ud) {
 848:Source/core/browser.c ****     (void)ud;
 849:Source/core/browser.c ****     BrRenderCtx* c = (BrRenderCtx*)ctx;
 850:Source/core/browser.c ****     s_br.isRendering = 0;
 851:Source/core/browser.c ****     s_br.currentDoc  = c->doc;
 852:Source/core/browser.c ****     const char* t = c->doc->title;
 853:Source/core/browser.c ****     if (t == NULL || t[0] == '\0')
 854:Source/core/browser.c ****         t = (s_br.curUrl.host[0] != '\0') ? s_br.curUrl.host : "Web Page";
 855:Source/core/browser.c ****     str_copy(s_br.pageTitle, sizeof(s_br.pageTitle), t);
 856:Source/core/browser.c ****     s_br.scrollY = s_br.targetScrollY = s_br.crankVelocity = 0;
 857:Source/core/browser.c ****     s_br.state = PLUTO_STATE_PAGE;
 858:Source/core/browser.c ****     if (c->addHist) storage_add_history(s_br.pageTitle, c->url);
 859:Source/core/browser.c ****     menu_rebuild();
 860:Source/core/browser.c ****     br_system_menu_refresh();   /* View row tracks PAGE+hasUrl */
 861:Source/core/browser.c **** 
 862:Source/core/browser.c ****     /* enqueue images per image mode setting */
 863:Source/core/browser.c ****     if ((storage_settings()->imageMode) == PLUTO_IMAGE_MODE_ALL) {
 864:Source/core/browser.c ****         for (size_t i = 0; i < c->doc->nBlocks; i++) {
 865:Source/core/browser.c ****             const DocBlock* b = &c->doc->blocks[i];
 866:Source/core/browser.c ****             if (b->type == DB_IMAGE && b->src && b->src[0])
 867:Source/core/browser.c ****                 id_enqueue(b->src);
 868:Source/core/browser.c ****         }
 869:Source/core/browser.c ****     }
 870:Source/core/browser.c **** 
 871:Source/core/browser.c ****     /* <meta http-equiv=refresh> auto-redirect */
 872:Source/core/browser.c ****     if (c->doc->metaDelay > 0 || c->doc->metaUrl != NULL) {
 873:Source/core/browser.c ****         double delaySec = c->doc->metaDelay > 0 ? c->doc->metaDelay : 0;
 874:Source/core/browser.c ****         str_copy(s_br.metaUrl, sizeof(s_br.metaUrl),
 875:Source/core/browser.c ****                  c->doc->metaUrl ? c->doc->metaUrl : c->url);
 876:Source/core/browser.c ****         s_br.metaDeadlineMs =
 877:Source/core/browser.c ****             (double)br_now_ms() + delaySec * 1000.0;
 878:Source/core/browser.c ****         s_br.hasMetaRefresh = 1;
