 546:src/core/browser.c **** static void menu_activate(int row) {
 547:src/core/browser.c ****     /* Lua parity: picking a system-menu item dismisses the menu (the SDK
 548:src/core/browser.c ****      * closes it and a kEventResume follows); our custom overlay mirrors
 549:src/core/browser.c ****      * the observable result */
 550:src/core/browser.c ****     s_br.menuOpen = 0;
 551:src/core/browser.c ****     int idx = 0;
 552:src/core/browser.c ****     for (int kind = 0; kind < 5; kind++) {
 553:src/core/browser.c ****         if (!s_menu.present[kind]) continue;
 554:src/core/browser.c ****         if (idx == row) {
 555:src/core/browser.c ****             switch (kind) {
 556:src/core/browser.c ****             case BR_MI_HOME:     menu_action_home(); break;
 557:src/core/browser.c ****             case BR_MI_SETTINGS: menu_action_settings(); break;
 558:src/core/browser.c ****             case BR_MI_HISTORY:  menu_action_history(); break;
 559:src/core/browser.c ****             case BR_MI_COOKIES:  menu_action_cookies(); break;
 560:src/core/browser.c ****             case BR_MI_VIEW: {
 561:src/core/browser.c ****                 int next = (s_br.browseMode == PLUTO_MODE_READER)
 562:src/core/browser.c ****                                ? PLUTO_MODE_RAW_HTML
 563:src/core/browser.c ****                                : PLUTO_MODE_READER;
 564:src/core/browser.c ****                 apply_view_mode(next);
 565:src/core/browser.c ****                 break;
 566:src/core/browser.c ****             }
 567:src/core/browser.c ****             default: break;
 568:src/core/browser.c ****             }
 569:src/core/browser.c ****             return;
 570:src/core/browser.c ****         }
 571:src/core/browser.c ****         idx++;
 572:src/core/browser.c ****     }
 573:src/core/browser.c **** }
