 506:Source/core/browser.c **** static void menu_rebuild(void) {
 507:Source/core/browser.c ****     /* rows are frozen while the popup is open: a page landing underneath
 508:Source/core/browser.c ****      * (br_boot's auto-launch, background loads) must not shift indices */
 509:Source/core/browser.c ****     if (s_br.menuOpen) return;
 510:Source/core/browser.c ****     memset(s_menu.present, 0, sizeof(s_menu.present));
 511:Source/core/browser.c ****     s_menu.count = 0;
 512:Source/core/browser.c ****     s_menu.present[BR_MI_HOME]     = 1;
 513:Source/core/browser.c ****     s_menu.present[BR_MI_SETTINGS] = 1;   /* Lua: always-added entries */
 514:Source/core/browser.c ****     s_menu.present[BR_MI_HISTORY]  = 1;
 515:Source/core/browser.c ****     s_menu.present[BR_MI_COOKIES]  = 1;
 516:Source/core/browser.c ****     s_menu.viewIndex = -1;
 517:Source/core/browser.c ****     int row = 0;
 518:Source/core/browser.c ****     for (int kind = 0; kind < 5; kind++) {
 519:Source/core/browser.c ****         if (!s_menu.present[kind]) continue;
 520:Source/core/browser.c ****         if (kind == BR_MI_VIEW) continue;          /* counted below */
 521:Source/core/browser.c ****         row++;
 522:Source/core/browser.c ****     }
 523:Source/core/browser.c ****     if (s_br.state == PLUTO_STATE_PAGE && s_br.hasUrl &&
 524:Source/core/browser.c ****         strcmp(s_br.curUrl.scheme, "about") != 0) {
 525:Source/core/browser.c ****         s_menu.present[BR_MI_VIEW] = 1;
 526:Source/core/browser.c ****         s_menu.viewIndex = 1;                      /* right after Home */
 527:Source/core/browser.c ****         row++;
 528:Source/core/browser.c ****     }
 529:Source/core/browser.c ****     s_menu.count = row;
 530:Source/core/browser.c **** }
