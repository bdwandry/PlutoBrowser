 640:Source/core/browser.c **** static void menu_draw(void) {
 641:Source/core/browser.c ****     if (!s_br.menuOpen) return;
 642:Source/core/browser.c ****     const char* viewLabel =
 643:Source/core/browser.c ****         (s_br.browseMode == PLUTO_MODE_READER) ? "Reader" : "HTML";
 644:Source/core/browser.c **** 
 645:Source/core/browser.c ****     int rowH = 26;
 646:Source/core/browser.c ****     int w = 190;
 647:Source/core/browser.c ****     int x = PLUTO_SCREEN_WIDTH - w - 6;
 648:Source/core/browser.c ****     int y = 6;
 649:Source/core/browser.c ****     int h = s_menu.count * rowH + 12;
 650:Source/core/browser.c ****     s_pd->graphics->fillRect(x, y, w, h, kColorWhite);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccWrJpmS.s 			page 14


 651:Source/core/browser.c ****     s_pd->graphics->drawRect(x, y, w, h, kColorBlack);
 652:Source/core/browser.c **** 
 653:Source/core/browser.c ****     PlutoFont* body = style_get_body_font(0, 0, NULL);
 654:Source/core/browser.c ****     s_pd->graphics->setFont((LCDFont*)body);
 655:Source/core/browser.c **** 
 656:Source/core/browser.c ****     int row = 0;
 657:Source/core/browser.c ****     for (int kind = 0; kind < 5; kind++) {
 658:Source/core/browser.c ****         if (!s_menu.present[kind]) continue;
 659:Source/core/browser.c ****         int ry = y + 6 + row * rowH;
 660:Source/core/browser.c ****         int selected = (row == s_br.menuSel);
 661:Source/core/browser.c ****         if (selected) {
 662:Source/core/browser.c ****             s_pd->graphics->fillRect(x + 2, ry, w - 4, rowH - 2,
 663:Source/core/browser.c ****                                      kColorBlack);
 664:Source/core/browser.c ****             s_pd->graphics->setDrawMode(kDrawModeFillWhite);
 665:Source/core/browser.c ****         }
 666:Source/core/browser.c ****         const char* label = "";
 667:Source/core/browser.c ****         switch (kind) {
 668:Source/core/browser.c ****         case BR_MI_HOME:     label = "Home-Page"; break;
 669:Source/core/browser.c ****         case BR_MI_VIEW:     label = "View"; break;
 670:Source/core/browser.c ****         case BR_MI_SETTINGS: label = "Settings"; break;
 671:Source/core/browser.c ****         case BR_MI_HISTORY:  label = "History"; break;
 672:Source/core/browser.c ****         case BR_MI_COOKIES:  label = "Clear Cookies"; break;
 673:Source/core/browser.c ****         default: break;
 674:Source/core/browser.c ****         }
 675:Source/core/browser.c ****         s_pd->graphics->drawText(label, strlen(label), kUTF8Encoding,
 676:Source/core/browser.c ****                                  x + 10, ry + 5);
 677:Source/core/browser.c ****         if (kind == BR_MI_VIEW) {
 678:Source/core/browser.c ****             s_pd->graphics->drawText(viewLabel, strlen(viewLabel),
 679:Source/core/browser.c ****                                      kUTF8Encoding, x + w - 70, ry + 5);
 680:Source/core/browser.c ****         }
 681:Source/core/browser.c ****         if (selected) s_pd->graphics->setDrawMode(kDrawModeCopy);
 682:Source/core/browser.c ****         row++;
 683:Source/core/browser.c ****     }
 684:Source/core/browser.c **** }
