 660:Source/core/browser.c ****                                      kColorBlack);
 661:Source/core/browser.c ****             s_pd->graphics->setDrawMode(kDrawModeFillWhite);
 662:Source/core/browser.c ****         }
 663:Source/core/browser.c ****         const char* label = "";
 664:Source/core/browser.c ****         switch (kind) {
 665:Source/core/browser.c ****         case BR_MI_HOME:     label = "Home-Page"; break;
 666:Source/core/browser.c ****         case BR_MI_VIEW:     label = "View"; break;
 667:Source/core/browser.c ****         case BR_MI_SETTINGS: label = "Settings"; break;
 668:Source/core/browser.c ****         case BR_MI_HISTORY:  label = "History"; break;
 669:Source/core/browser.c ****         case BR_MI_COOKIES:  label = "Clear Cookies"; break;
 670:Source/core/browser.c ****         default: break;
 671:Source/core/browser.c ****         }
 672:Source/core/browser.c ****         s_pd->graphics->drawText(label, strlen(label), kUTF8Encoding,
 673:Source/core/browser.c ****                                  x + 10, ry + 5);
 674:Source/core/browser.c ****         if (kind == BR_MI_VIEW) {
 675:Source/core/browser.c ****             s_pd->graphics->drawText(viewLabel, strlen(viewLabel),
 676:Source/core/browser.c ****                                      kUTF8Encoding, x + w - 70, ry + 5);
 677:Source/core/browser.c ****         }
 678:Source/core/browser.c ****         if (selected) s_pd->graphics->setDrawMode(kDrawModeCopy);
 679:Source/core/browser.c ****         row++;
 680:Source/core/browser.c ****     }
 681:Source/core/browser.c **** }
