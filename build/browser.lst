 331:src/core/browser.c **** static void add_pair(StrBuf* pairs, const char** seen, int* nSeen,
 332:src/core/browser.c ****                      const char* k, const char* v) {
 333:src/core/browser.c ****     if (k == NULL || k[0] == '\0') return;
 334:src/core/browser.c ****     for (int i = 0; i < *nSeen; i++)
 335:src/core/browser.c ****         if (!strcmp(seen[i], k)) return;
 336:src/core/browser.c ****     if (*nSeen < 64) seen[(*nSeen)++] = k;
 337:src/core/browser.c ****     StrBuf ek, ev;
 338:src/core/browser.c ****     sb_init(&ek); sb_init(&ev);
 339:src/core/browser.c ****     url_encode(k, &ek);
 340:src/core/browser.c ****     url_encode(v ? v : "", &ev);
 341:src/core/browser.c ****     if (pairs->len > 0) sb_append_str(pairs, "&");
 342:src/core/browser.c ****     sb_append_str(pairs, ek.data ? ek.data : "");
 343:src/core/browser.c ****     sb_append_str(pairs, "=");
 344:src/core/browser.c ****     sb_append_str(pairs, ev.data ? ev.data : "");
 345:src/core/browser.c ****     sb_free(&ek); sb_free(&ev);
 346:src/core/browser.c **** }
