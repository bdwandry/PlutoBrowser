 234:Source/core/browser.c **** static size_t details_build_overrides(const DocDetailsOverride** out) {
 235:Source/core/browser.c ****     static DocDetailsOverride ov[32];
 236:Source/core/browser.c ****     size_t n = 0;
 237:Source/core/browser.c ****     for (size_t i = 0; i < s_br.nDetails && n < 32; i++) {
 238:Source/core/browser.c ****         ov[n].key  = s_br.details[i].key;
 239:Source/core/browser.c ****         ov[n].open = s_br.details[i].open;
 240:Source/core/browser.c ****         n++;
