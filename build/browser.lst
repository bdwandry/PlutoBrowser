 882:src/core/browser.c **** static void render_fail(const char* msg, void* ud) {
 883:src/core/browser.c ****     (void)msg;
 884:src/core/browser.c ****     BrRenderCtx* c = (BrRenderCtx*)ud;
 885:src/core/browser.c ****     if (c != NULL) {
 886:src/core/browser.c ****         s_br.isRendering = 0;
 887:src/core/browser.c ****         ep_show(msg, c->url);
 888:src/core/browser.c ****         s_br.state = PLUTO_STATE_ERROR;
 889:src/core/browser.c ****         str_copy(s_br.pageTitle, sizeof(s_br.pageTitle), "Render Error");
 890:src/core/browser.c ****         menu_rebuild();
 891:src/core/browser.c ****     }
 892:src/core/browser.c **** }
