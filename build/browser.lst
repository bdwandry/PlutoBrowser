 691:src/core/browser.c ****         s_menu.viewIndex == s_br.menuSel)
 692:src/core/browser.c ****         menu_cycle_view(in->justPressed & BR_BTN_RIGHT ? 1 : -1);
 693:src/core/browser.c ****     if (in->justPressed & BR_BTN_A)
 694:src/core/browser.c ****         menu_activate(s_br.menuSel);
 695:src/core/browser.c ****     if (in->justPressed & BR_BTN_B)
 696:src/core/browser.c ****         s_br.menuOpen = 0;
 697:src/core/browser.c **** }
