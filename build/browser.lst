 900:src/core/browser.c **** 
 901:src/core/browser.c ****     BrRenderCtx* c = (BrRenderCtx*)pluto_malloc(sizeof(BrRenderCtx));
 902:src/core/browser.c ****     memset(c, 0, sizeof(*c));
 903:src/core/browser.c ****     c->body    = pluto_strdup(body ? body : "");
 904:src/core/browser.c ****     c->url     = pluto_strdup(url ? url : "");
 905:src/core/browser.c ****     c->addHist = addToHistory;
 906:src/core/browser.c ****     c->stage   = 0;
 907:src/core/browser.c ****     tasks_run(render_step, c, render_ctx_free, render_done, render_fail,
 908:src/core/browser.c ****               c);   /* ctx rides as ud so fail() keeps context */
 909:src/core/browser.c **** }
