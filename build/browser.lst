 894:src/core/browser.c **** static void render_body(const char* body, const char* url, int addToHistory) {
 895:src/core/browser.c ****     s_br.isRendering = 1;
 896:src/core/browser.c ****     s_br.progressCur = 0;
 897:src/core/browser.c ****     s_br.progressTot = 0;
 898:src/core/browser.c ****     str_copy(s_br.pageTitle, sizeof(s_br.pageTitle), "Rendering...");
