 597:Source/core/browser.c **** /* ── Native system menu (Lua main.lua parity) ────────────────
 598:Source/core/browser.c ****  * The C_API DOES expose playdate->system menu items (the old custom
 599:Source/core/browser.c ****  * overlay premise was wrong): Home-Page / View(Reader|HTML) / Settings /
 600:Source/core/browser.c ****  * History / Clear Cookies, rebuilt whenever the View row's presence or
 601:Source/core/browser.c ****  * the current mode changes. Callbacks only stage work; it executes in
 602:Source/core/browser.c ****  * the next br_frame() after the system menu resumes the game. */
 603:Source/core/browser.c **** 
 604:Source/core/browser.c **** static PDMenuItem* s_viewItem = NULL;
 605:Source/core/browser.c **** 
 606:Source/core/browser.c **** static void mi_home_cb(void* ud)    { (void)ud; menu_action_home(); }
 607:Source/core/browser.c **** static void mi_settings_cb(void* ud){ (void)ud; menu_action_settings();
 608:Source/core/browser.c ****                                       br_system_menu_refresh(); }
 609:Source/core/browser.c **** static void mi_history_cb(void* ud) { (void)ud; menu_action_history();
 610:Source/core/browser.c ****                                       br_system_menu_refresh(); }
 611:Source/core/browser.c **** static void mi_cookies_cb(void* ud) { (void)ud; cj_clear(); }
 612:Source/core/browser.c **** 
 613:Source/core/browser.c **** static void mi_view_cb(void* ud) {
 614:Source/core/browser.c ****     (void)ud;
 615:Source/core/browser.c ****     int v = s_pd->system->getMenuItemValue(s_viewItem);
 616:Source/core/browser.c ****     /* Lua: options are { "Reader", "HTML" } */
 617:Source/core/browser.c ****     apply_view_mode(v == 0 ? PLUTO_MODE_READER : PLUTO_MODE_RAW_HTML);
 618:Source/core/browser.c **** }
 619:Source/core/browser.c **** 
 620:Source/core/browser.c **** void br_system_menu_refresh(void) {
 621:Source/core/browser.c ****     if (s_pd == NULL) return;
 622:Source/core/browser.c ****     s_pd->system->removeAllMenuItems();
 623:Source/core/browser.c ****     s_pd->system->addMenuItem("Home-Page", mi_home_cb, NULL);
 624:Source/core/browser.c ****     s_viewItem = NULL;
 625:Source/core/browser.c ****     if (s_br.state == PLUTO_STATE_PAGE && s_br.hasUrl &&
 626:Source/core/browser.c ****         strcmp(s_br.curUrl.scheme, "about") != 0) {
 627:Source/core/browser.c ****         static const char* opts[2] = { "Reader", "HTML" };
 628:Source/core/browser.c ****         s_viewItem = s_pd->system->addOptionsMenuItem(
 629:Source/core/browser.c ****             "View", opts, 2, mi_view_cb, NULL);
 630:Source/core/browser.c ****         /* Lua: initial selection reflects the active browse mode */
 631:Source/core/browser.c ****         s_pd->system->setMenuItemValue(
 632:Source/core/browser.c ****             s_viewItem,
 633:Source/core/browser.c ****             s_br.browseMode == PLUTO_MODE_READER ? 0 : 1);
 634:Source/core/browser.c ****     }
 635:Source/core/browser.c ****     s_pd->system->addMenuItem("Settings", mi_settings_cb, NULL);
 636:Source/core/browser.c ****     s_pd->system->addMenuItem("History", mi_history_cb, NULL);
 637:Source/core/browser.c ****     s_pd->system->addMenuItem("Clear Cookies", mi_cookies_cb, NULL);
 638:Source/core/browser.c **** }
