 521:src/core/browser.c ****         strcmp(s_br.curUrl.scheme, "about") != 0) {
 522:src/core/browser.c ****         s_menu.present[BR_MI_VIEW] = 1;
 523:src/core/browser.c ****         s_menu.viewIndex = 1;                      /* right after Home */
 524:src/core/browser.c ****         row++;
 525:src/core/browser.c ****     }
 526:src/core/browser.c ****     s_menu.count = row;
 527:src/core/browser.c **** }
