 847:src/core/browser.c **** static void render_done(void* ctx, void* ud) {
 848:src/core/browser.c ****     (void)ud;
 849:src/core/browser.c ****     BrRenderCtx* c = (BrRenderCtx*)ctx;
 850:src/core/browser.c ****     s_br.isRendering = 0;
 851:src/core/browser.c ****     s_br.currentDoc  = c->doc;
 852:src/core/browser.c ****     const char* t = c->doc->title;
 853:src/core/browser.c ****     if (t == NULL || t[0] == '\0')
 854:src/core/browser.c ****         t = (s_br.curUrl.host[0] != '\0') ? s_br.curUrl.host : "Web Page";
 855:src/core/browser.c ****     str_copy(s_br.pageTitle, sizeof(s_br.pageTitle), t);
 856:src/core/browser.c ****     s_br.scrollY = s_br.targetScrollY = s_br.crankVelocity = 0;
 857:src/core/browser.c ****     s_br.state = PLUTO_STATE_PAGE;
 858:src/core/browser.c ****     if (c->addHist) storage_add_history(s_br.pageTitle, c->url);
 859:src/core/browser.c ****     menu_rebuild();
