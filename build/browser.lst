   1:src/core/browser.c **** // browser.c -- [P32] C port of CometBrowser Source/main.lua.
   2:src/core/browser.c **** //
   3:src/core/browser.c **** // Application state machine: home/loading/page/error/bookmarks/history/
   4:src/core/browser.c **** // settings, the navigateTo -> executeNavigation -> runNavigation flow,
   5:src/core/browser.c **** // cooperative renderBody task, history stack (cap 30), <details> toggling,
   6:src/core/browser.c **** // form activation/submission, reader-mode input with crank physics,
   7:src/core/browser.c **** // loading/error/list/settings branches and the updateFrame composition
   8:src/core/browser.c **** // order. The Lua playdate.system menu is rendered as a custom pause
   9:src/core/browser.c **** // overlay (the C SDK has no menu-items API); kEventPause/kEventResume map
  10:src/core/browser.c **** // to the hardware Menu button. HTML-mode virtual mouse cursor lands in
  11:src/core/browser.c **** // P33 -- until then HTML mode scrolls by crank exactly like reader mode.
