 863:src/core/browser.c ****         }
 864:src/core/browser.c ****     }
 865:src/core/browser.c **** 
 866:src/core/browser.c ****     /* <meta http-equiv=refresh> auto-redirect */
 867:src/core/browser.c ****     if (c->doc->metaDelay > 0 || c->doc->metaUrl != NULL) {
 868:src/core/browser.c ****         double delaySec = c->doc->metaDelay > 0 ? c->doc->metaDelay : 0;
 869:src/core/browser.c ****         str_copy(s_br.metaUrl, sizeof(s_br.metaUrl),
 870:src/core/browser.c ****                  c->doc->metaUrl ? c->doc->metaUrl : c->url);
 871:src/core/browser.c ****         s_br.metaDeadlineMs =
 872:src/core/browser.c ****             (double)br_now_ms() + delaySec * 1000.0;
 873:src/core/browser.c ****         s_br.hasMetaRefresh = 1;
 874:src/core/browser.c ****     }
 875:src/core/browser.c **** }
