 833:Source/core/browser.c **** static int render_step(void* ctx) {
 834:Source/core/browser.c ****     BrRenderCtx* c = (BrRenderCtx*)ctx;
 835:Source/core/browser.c ****     if (c->stage == 0) {
 836:Source/core/browser.c ****         c->doc = doc_parse_opts(c->body, c->url, s_br.browseMode, NULL);
 837:Source/core/browser.c ****         if (c->doc == NULL) {
 838:Source/core/browser.c ****             tasks_set_error("Parse Error: document unavailable");
 839:Source/core/browser.c ****             return PLUTO_TASK_ERROR;
 840:Source/core/browser.c ****         }
 841:Source/core/browser.c ****         tasks_report_progress(0.5);
 842:Source/core/browser.c ****         c->stage = 1;
 843:Source/core/browser.c ****         return PLUTO_TASK_YIELD;   /* yield: layout next slice */
 844:Source/core/browser.c ****     }
 845:Source/core/browser.c ****     layout_build(c->doc);
 846:Source/core/browser.c ****     tasks_report_progress(1.0);
 847:Source/core/browser.c ****     return PLUTO_TASK_DONE;
 848:Source/core/browser.c **** }
 849:Source/core/browser.c **** 
 850:Source/core/browser.c **** static void render_done(void* ctx, void* ud) {
 851:Source/core/browser.c ****     (void)ud;
 852:Source/core/browser.c ****     BrRenderCtx* c = (BrRenderCtx*)ctx;
 853:Source/core/browser.c ****     s_br.isRendering = 0;
 854:Source/core/browser.c ****     s_br.currentDoc  = c->doc;
 855:Source/core/browser.c ****     const char* t = c->doc->title;
 856:Source/core/browser.c ****     if (t == NULL || t[0] == '\0')
 857:Source/core/browser.c ****         t = (s_br.curUrl.host[0] != '\0') ? s_br.curUrl.host : "Web Page";
 858:Source/core/browser.c ****     str_copy(s_br.pageTitle, sizeof(s_br.pageTitle), t);
 859:Source/core/browser.c ****     s_br.scrollY = s_br.targetScrollY = s_br.crankVelocity = 0;
 860:Source/core/browser.c ****     s_br.state = PLUTO_STATE_PAGE;
 861:Source/core/browser.c ****     if (c->addHist) storage_add_history(s_br.pageTitle, c->url);
 862:Source/core/browser.c ****     menu_rebuild();
 863:Source/core/browser.c ****     br_system_menu_refresh();   /* View row tracks PAGE+hasUrl */
 864:Source/core/browser.c **** 
 865:Source/core/browser.c ****     /* enqueue images per image mode setting */
 866:Source/core/browser.c ****     if ((storage_settings()->imageMode) == PLUTO_IMAGE_MODE_ALL) {
 867:Source/core/browser.c ****         for (size_t i = 0; i < c->doc->nBlocks; i++) {
 868:Source/core/browser.c ****             const DocBlock* b = &c->doc->blocks[i];
 869:Source/core/browser.c ****             if (b->type == DB_IMAGE && b->src && b->src[0])
 870:Source/core/browser.c ****                 id_enqueue(b->src);
 871:Source/core/browser.c ****         }
 872:Source/core/browser.c ****     }
 873:Source/core/browser.c **** 
 874:Source/core/browser.c ****     /* <meta http-equiv=refresh> auto-redirect */
 875:Source/core/browser.c ****     if (c->doc->metaDelay > 0 || c->doc->metaUrl != NULL) {
 876:Source/core/browser.c ****         double delaySec = c->doc->metaDelay > 0 ? c->doc->metaDelay : 0;
 877:Source/core/browser.c ****         str_copy(s_br.metaUrl, sizeof(s_br.metaUrl),
 878:Source/core/browser.c ****                  c->doc->metaUrl ? c->doc->metaUrl : c->url);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccWrJpmS.s 			page 20


 879:Source/core/browser.c ****         s_br.metaDeadlineMs =
 880:Source/core/browser.c ****             (double)br_now_ms() + delaySec * 1000.0;
 881:Source/core/browser.c ****         s_br.hasMetaRefresh = 1;
 882:Source/core/browser.c ****     }
 883:Source/core/browser.c **** }
 884:Source/core/browser.c **** 
 885:Source/core/browser.c **** static void render_fail(const char* msg, void* ud) {
 886:Source/core/browser.c ****     (void)msg;
 887:Source/core/browser.c ****     BrRenderCtx* c = (BrRenderCtx*)ud;
 888:Source/core/browser.c ****     if (c != NULL) {
 889:Source/core/browser.c ****         s_br.isRendering = 0;
 890:Source/core/browser.c ****         ep_show(msg, c->url);
 891:Source/core/browser.c ****         s_br.state = PLUTO_STATE_ERROR;
 892:Source/core/browser.c ****         str_copy(s_br.pageTitle, sizeof(s_br.pageTitle), "Render Error");
 893:Source/core/browser.c ****         menu_rebuild();
 894:Source/core/browser.c ****     }
 895:Source/core/browser.c **** }
 896:Source/core/browser.c **** 
 897:Source/core/browser.c **** static void render_body(const char* body, const char* url, int addToHistory) {
 898:Source/core/browser.c ****     s_br.isRendering = 1;
 899:Source/core/browser.c ****     s_br.progressCur = 0;
 900:Source/core/browser.c ****     s_br.progressTot = 0;
 901:Source/core/browser.c ****     str_copy(s_br.pageTitle, sizeof(s_br.pageTitle), "Rendering...");
 902:Source/core/browser.c ****     s_br.state = PLUTO_STATE_LOADING;
 903:Source/core/browser.c **** 
 904:Source/core/browser.c ****     BrRenderCtx* c = (BrRenderCtx*)pluto_malloc(sizeof(BrRenderCtx));
 905:Source/core/browser.c ****     memset(c, 0, sizeof(*c));
 906:Source/core/browser.c ****     c->body    = pluto_strdup(body ? body : "");
 907:Source/core/browser.c ****     c->url     = pluto_strdup(url ? url : "");
 908:Source/core/browser.c ****     c->addHist = addToHistory;
 909:Source/core/browser.c ****     c->stage   = 0;
 910:Source/core/browser.c ****     tasks_run(render_step, c, render_ctx_free, render_done, render_fail,
 911:Source/core/browser.c ****               c);   /* ctx rides as ud so fail() keeps context */
 912:Source/core/browser.c **** }
