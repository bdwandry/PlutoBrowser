 675:Source/core/browser.c ****             s_pd->graphics->drawText(viewLabel, strlen(viewLabel),
 676:Source/core/browser.c ****                                      kUTF8Encoding, x + w - 70, ry + 5);
 677:Source/core/browser.c ****         }
 678:Source/core/browser.c ****         if (selected) s_pd->graphics->setDrawMode(kDrawModeCopy);
 679:Source/core/browser.c ****         row++;
 680:Source/core/browser.c ****     }
