 331:Source/core/browser.c **** static void add_pair(StrBuf* pairs, const char** seen, int* nSeen,
 332:Source/core/browser.c ****                      const char* k, const char* v) {
 333:Source/core/browser.c ****     if (k == NULL || k[0] == '\0') return;
 334:Source/core/browser.c ****     for (int i = 0; i < *nSeen; i++)
 335:Source/core/browser.c ****         if (!strcmp(seen[i], k)) return;
 336:Source/core/browser.c ****     if (*nSeen < 64) seen[(*nSeen)++] = k;
 337:Source/core/browser.c ****     StrBuf ek, ev;
 338:Source/core/browser.c ****     sb_init(&ek); sb_init(&ev);
 339:Source/core/browser.c ****     url_encode(k, &ek);
 340:Source/core/browser.c ****     url_encode(v ? v : "", &ev);
 341:Source/core/browser.c ****     if (pairs->len > 0) sb_append_str(pairs, "&");
 342:Source/core/browser.c ****     sb_append_str(pairs, ek.data ? ek.data : "");
 343:Source/core/browser.c ****     sb_append_str(pairs, "=");
 344:Source/core/browser.c ****     sb_append_str(pairs, ev.data ? ev.data : "");
 345:Source/core/browser.c ****     sb_free(&ek); sb_free(&ev);
 346:Source/core/browser.c **** }
 347:Source/core/browser.c **** 
 348:Source/core/browser.c **** /* submitForm(formAction, inputBlock): query built from the CURRENT render
 349:Source/core/browser.c ****  * items exactly as the Lua version does (hidden/text match by formAction,
 350:Source/core/browser.c ****  * checked checkboxes send value-or-"on", selects send the active option,
 351:Source/core/browser.c ****  * dedupe by name, clicked submit button appended per HTML spec, GET
 352:Source/core/browser.c ****  * assembly onto formAction with ?/& separator). */
 353:Source/core/browser.c **** static void submit_form(const char* formActionIn, struct LItem* submitBtn) {
 354:Source/core/browser.c ****     const char* fallback = s_br.hasUrl ? s_br.curUrl.normalized : "";
 355:Source/core/browser.c ****     const char* formAction =
 356:Source/core/browser.c ****         (formActionIn && formActionIn[0] != '\0') ? formActionIn : fallback;
 357:Source/core/browser.c ****     if (!strcmp(formAction, "#")) return;
 358:Source/core/browser.c **** 
 359:Source/core/browser.c ****     const char* seen[64];
 360:Source/core/browser.c ****     int nSeen = 0;
 361:Source/core/browser.c ****     StrBuf q;
 362:Source/core/browser.c ****     sb_init(&q);
 363:Source/core/browser.c **** 
 364:Source/core/browser.c ****     for (int i = 0; i < layout_item_count(); i++) {
 365:Source/core/browser.c ****         const LItem* it = layout_item_at(i);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccWrJpmS.s 			page 9


 366:Source/core/browser.c ****         if (it->disabled) continue;          /* never submitted */
 367:Source/core/browser.c ****         int actionMatch = it->formAction &&
 368:Source/core/browser.c ****                           !strcmp(it->formAction, formAction);
 369:Source/core/browser.c ****         switch (it->type) {
 370:Source/core/browser.c ****         case LIT_HIDDEN_FIELD:
 371:Source/core/browser.c ****         case LIT_INPUT_FIELD:
 372:Source/core/browser.c ****             if (actionMatch) add_pair(&q, seen, &nSeen, it->name, it->value);
 373:Source/core/browser.c ****             break;
 374:Source/core/browser.c ****         case LIT_CHECKBOX_FIELD:
 375:Source/core/browser.c ****             if (actionMatch && it->checked)
 376:Source/core/browser.c ****                 add_pair(&q, seen, &nSeen, it->name,
 377:Source/core/browser.c ****                          (it->value && it->value[0]) ? it->value : "on");
 378:Source/core/browser.c ****             break;
 379:Source/core/browser.c ****         case LIT_SELECT_FIELD: {
 380:Source/core/browser.c ****             if (!actionMatch) break;
 381:Source/core/browser.c ****             const DocSelectOpt* opts = (const DocSelectOpt*)it->options;
 382:Source/core/browser.c ****             if (it->selectedIndex >= 1 &&
 383:Source/core/browser.c ****                 (size_t)it->selectedIndex <= it->nOptions) {
 384:Source/core/browser.c ****                 const DocSelectOpt* opt =
 385:Source/core/browser.c ****                     &opts[it->selectedIndex - 1];
 386:Source/core/browser.c ****                 if (!opt->disabled && !opt->group)
 387:Source/core/browser.c ****                     add_pair(&q, seen, &nSeen, it->name,
 388:Source/core/browser.c ****                              (opt->value && opt->value[0]) ? opt->value
 389:Source/core/browser.c ****                                                            : opt->text);
 390:Source/core/browser.c ****             }
 391:Source/core/browser.c ****             break;
 392:Source/core/browser.c ****         }
 393:Source/core/browser.c ****         default:
 394:Source/core/browser.c ****             break;
 395:Source/core/browser.c ****         }
 396:Source/core/browser.c ****     }
 397:Source/core/browser.c **** 
 398:Source/core/browser.c ****     /* no fields matched by formAction: collect all named visible inputs */
 399:Source/core/browser.c ****     if (q.len == 0) {
 400:Source/core/browser.c ****         for (int i = 0; i < layout_item_count(); i++) {
 401:Source/core/browser.c ****             const LItem* it = layout_item_at(i);
 402:Source/core/browser.c ****             if (it->disabled) continue;
 403:Source/core/browser.c ****             if ((it->type == LIT_HIDDEN_FIELD ||
 404:Source/core/browser.c ****                  it->type == LIT_INPUT_FIELD) &&
 405:Source/core/browser.c ****                 it->name && it->name[0])
 406:Source/core/browser.c ****                 add_pair(&q, seen, &nSeen, it->name, it->value);
 407:Source/core/browser.c ****         }
 408:Source/core/browser.c ****     }
 409:Source/core/browser.c **** 
 410:Source/core/browser.c ****     /* the clicked submit button's name=value always rides along */
 411:Source/core/browser.c ****     if (submitBtn && !submitBtn->disabled &&
 412:Source/core/browser.c ****         submitBtn->name && submitBtn->name[0])
 413:Source/core/browser.c ****         add_pair(&q, seen, &nSeen, submitBtn->name, submitBtn->value);
 414:Source/core/browser.c **** 
 415:Source/core/browser.c ****     const char* sep = strchr(formAction, '?') ? "&" : "?";
 416:Source/core/browser.c ****     char target[2 * PLUTO_URL_NORMALIZED_MAX];
 417:Source/core/browser.c ****     snprintf(target, sizeof(target), "%s%s%s", formAction,
 418:Source/core/browser.c ****              q.len > 0 ? sep : "", q.len > 0 ? (q.data ? q.data : "") : "");
 419:Source/core/browser.c ****     sb_free(&q);
 420:Source/core/browser.c ****     navigate_to(target);
 421:Source/core/browser.c **** }
 422:Source/core/browser.c **** 
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccWrJpmS.s 			page 10


 423:Source/core/browser.c **** /* activateFormBlock(block): text input / submit / checkbox-radio toggle /
 424:Source/core/browser.c ****  * dropdown cycle. `block` is a live render item (Layout.renderItems in
 425:Source/core/browser.c ****  * Lua; LItem copies here -- mutations persist until the next build). */
 426:Source/core/browser.c **** static void activate_form_block(struct LItem* blk) {
 427:Source/core/browser.c ****     if (blk == NULL || blk->disabled) return;
 428:Source/core/browser.c **** 
 429:Source/core/browser.c ****     switch (blk->type) {
 430:Source/core/browser.c ****     case LIT_INPUT_FIELD:
 431:Source/core/browser.c ****         layout_set_selected_input(blk);
 432:Source/core/browser.c ****         open_keyboard_for_input(blk);
 433:Source/core/browser.c ****         break;
 434:Source/core/browser.c **** 
 435:Source/core/browser.c ****     case LIT_INPUT_SUBMIT:
 436:Source/core/browser.c ****         submit_form(blk->formAction, blk);
 437:Source/core/browser.c ****         break;
 438:Source/core/browser.c **** 
 439:Source/core/browser.c ****     case LIT_CHECKBOX_FIELD:
 440:Source/core/browser.c ****         if (blk->radio) {
 441:Source/core/browser.c ****             for (int i = 0; i < layout_item_count(); i++) {
 442:Source/core/browser.c ****                 LItem* it = layout_item_mutable(i);
 443:Source/core/browser.c ****                 if (it != blk && it->type == LIT_CHECKBOX_FIELD &&
 444:Source/core/browser.c ****                     it->radio && it->name && blk->name &&
 445:Source/core/browser.c ****                     !strcmp(it->name, blk->name))
 446:Source/core/browser.c ****                     it->checked = 0;
 447:Source/core/browser.c ****             }
 448:Source/core/browser.c ****             blk->checked = 1;
 449:Source/core/browser.c ****         } else {
 450:Source/core/browser.c ****             blk->checked = !blk->checked;
 451:Source/core/browser.c ****         }
 452:Source/core/browser.c ****         layout_set_selected_input(blk);
 453:Source/core/browser.c ****         break;
 454:Source/core/browser.c **** 
 455:Source/core/browser.c ****     case LIT_SELECT_FIELD: {
 456:Source/core/browser.c ****         size_t n = blk->nOptions;
 457:Source/core/browser.c ****         if (n > 0) {
 458:Source/core/browser.c ****             const DocSelectOpt* opts = (const DocSelectOpt*)blk->options;
 459:Source/core/browser.c ****             int tries = (int)n + 1;
 460:Source/core/browser.c ****             while (tries > 0) {
 461:Source/core/browser.c ****                 blk->selectedIndex = (blk->selectedIndex % (int)n) + 1;
 462:Source/core/browser.c ****                 const DocSelectOpt* opt =
 463:Source/core/browser.c ****                     &opts[blk->selectedIndex - 1];
 464:Source/core/browser.c ****                 if (!opt->disabled && !opt->group) break;
 465:Source/core/browser.c ****                 tries--;
 466:Source/core/browser.c ****             }
 467:Source/core/browser.c ****         }
 468:Source/core/browser.c ****         layout_set_selected_input(blk);
 469:Source/core/browser.c ****         break;
 470:Source/core/browser.c ****     }
 471:Source/core/browser.c **** 
 472:Source/core/browser.c ****     default:
 473:Source/core/browser.c ****         break;
 474:Source/core/browser.c ****     }
 475:Source/core/browser.c **** }
 476:Source/core/browser.c **** 
 477:Source/core/browser.c **** void br_activate_item(struct LItem* it) { activate_form_block(it); }
