 667:src/core/browser.c ****         case BR_MI_SETTINGS: label = "Settings"; break;
 668:src/core/browser.c ****         case BR_MI_HISTORY:  label = "History"; break;
 669:src/core/browser.c ****         case BR_MI_COOKIES:  label = "Clear Cookies"; break;
 670:src/core/browser.c ****         default: break;
