 423:src/core/browser.c **** /* activateFormBlock(block): text input / submit / checkbox-radio toggle /
 424:src/core/browser.c ****  * dropdown cycle. `block` is a live render item (Layout.renderItems in
 425:src/core/browser.c ****  * Lua; LItem copies here -- mutations persist until the next build). */
 426:src/core/browser.c **** static void activate_form_block(struct LItem* blk) {
 427:src/core/browser.c ****     if (blk == NULL || blk->disabled) return;
 428:src/core/browser.c **** 
 429:src/core/browser.c ****     switch (blk->type) {
 430:src/core/browser.c ****     case LIT_INPUT_FIELD:
 431:src/core/browser.c ****         layout_set_selected_input(blk);
 432:src/core/browser.c ****         open_keyboard_for_input(blk);
 433:src/core/browser.c ****         break;
 434:src/core/browser.c **** 
 435:src/core/browser.c ****     case LIT_INPUT_SUBMIT:
 436:src/core/browser.c ****         submit_form(blk->formAction, blk);
 437:src/core/browser.c ****         break;
 438:src/core/browser.c **** 
 439:src/core/browser.c ****     case LIT_CHECKBOX_FIELD:
 440:src/core/browser.c ****         if (blk->radio) {
 441:src/core/browser.c ****             for (int i = 0; i < layout_item_count(); i++) {
 442:src/core/browser.c ****                 LItem* it = layout_item_mutable(i);
 443:src/core/browser.c ****                 if (it != blk && it->type == LIT_CHECKBOX_FIELD &&
 444:src/core/browser.c ****                     it->radio && it->name && blk->name &&
 445:src/core/browser.c ****                     !strcmp(it->name, blk->name))
 446:src/core/browser.c ****                     it->checked = 0;
 447:src/core/browser.c ****             }
 448:src/core/browser.c ****             blk->checked = 1;
 449:src/core/browser.c ****         } else {
 450:src/core/browser.c ****             blk->checked = !blk->checked;
 451:src/core/browser.c ****         }
 452:src/core/browser.c ****         layout_set_selected_input(blk);
 453:src/core/browser.c ****         break;
 454:src/core/browser.c **** 
 455:src/core/browser.c ****     case LIT_SELECT_FIELD: {
 456:src/core/browser.c ****         size_t n = blk->nOptions;
 457:src/core/browser.c ****         if (n > 0) {
 458:src/core/browser.c ****             const DocSelectOpt* opts = (const DocSelectOpt*)blk->options;
 459:src/core/browser.c ****             int tries = (int)n + 1;
 460:src/core/browser.c ****             while (tries > 0) {
 461:src/core/browser.c ****                 blk->selectedIndex = (blk->selectedIndex % (int)n) + 1;
 462:src/core/browser.c ****                 const DocSelectOpt* opt =
 463:src/core/browser.c ****                     &opts[blk->selectedIndex - 1];
 464:src/core/browser.c ****                 if (!opt->disabled && !opt->group) break;
 465:src/core/browser.c ****                 tries--;
 466:src/core/browser.c ****             }
 467:src/core/browser.c ****         }
 468:src/core/browser.c ****         layout_set_selected_input(blk);
 469:src/core/browser.c ****         break;
 470:src/core/browser.c ****     }
 471:src/core/browser.c **** 
 472:src/core/browser.c ****     default:
 473:src/core/browser.c ****         break;
 474:src/core/browser.c ****     }
 475:src/core/browser.c **** }
 476:src/core/browser.c **** 
 477:src/core/browser.c **** void br_activate_item(struct LItem* it) { activate_form_block(it); }
