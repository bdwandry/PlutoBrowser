 683:Source/core/browser.c **** static void menu_handle_input(const BrInput* in) {
 684:Source/core/browser.c ****     if (in->justPressed & BR_BTN_UP && s_br.menuSel > 0)
 685:Source/core/browser.c ****         s_br.menuSel--;
