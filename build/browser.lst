 578:Source/core/browser.c **** static void menu_cycle_view(int dir) {
 579:Source/core/browser.c ****     int next = s_br.browseMode +
 580:Source/core/browser.c ****                (dir > 0 ? 1 : -1);
 581:Source/core/browser.c ****     if (next < 0) next = PLUTO_MODE_RAW_HTML;
 582:Source/core/browser.c ****     if (next > PLUTO_MODE_RAW_HTML) next = PLUTO_MODE_READER;
 583:Source/core/browser.c ****     apply_view_mode(next);
 584:Source/core/browser.c **** }
