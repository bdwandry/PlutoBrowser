 146:src/core/browser.c **** static void str_copy(char* dst, size_t cap, const char* src) {
 147:src/core/browser.c ****     if (dst == NULL || cap == 0) return;
 148:src/core/browser.c ****     size_t i = 0;
 149:src/core/browser.c ****     if (src != NULL)
 150:src/core/browser.c ****         while (i + 1 < cap && src[i] != '\0') { dst[i] = src[i]; i++; }
 151:src/core/browser.c ****     dst[i] = '\0';
 152:src/core/browser.c **** }
 153:src/core/browser.c **** 
 154:src/core/browser.c **** static void trim_in_place(char* s) {
 155:src/core/browser.c ****     size_t n = strlen(s);
 156:src/core/browser.c ****     while (n > 0 && (s[n - 1] == ' ' || s[n - 1] == '\t' ||
 157:src/core/browser.c ****                      s[n - 1] == '\r' || s[n - 1] == '\n'))
 158:src/core/browser.c ****         s[--n] = '\0';
 159:src/core/browser.c ****     size_t start = 0;
 160:src/core/browser.c ****     while (s[start] == ' ' || s[start] == '\t' ||
 161:src/core/browser.c ****            s[start] == '\r' || s[start] == '\n')
 162:src/core/browser.c ****         start++;
 163:src/core/browser.c ****     if (start > 0) memmove(s, s + start, n - start + 1);
 164:src/core/browser.c **** }
 165:src/core/browser.c **** 
 166:src/core/browser.c **** static void item_set_value(struct LItem* it, const char* v) {
 167:src/core/browser.c ****     if (!it) return;
 168:src/core/browser.c ****     pluto_free(it->value);
 169:src/core/browser.c ****     it->value = pluto_strdup(v ? v : "");
 170:src/core/browser.c **** }
