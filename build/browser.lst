 594:src/core/browser.c **** /* ── Native system menu (Lua main.lua parity) ────────────────
 595:src/core/browser.c ****  * The C_API DOES expose playdate->system menu items (the old custom
 596:src/core/browser.c ****  * overlay premise was wrong): Home-Page / View(Reader|HTML) / Settings /
 597:src/core/browser.c ****  * History / Clear Cookies, rebuilt whenever the View row's presence or
 598:src/core/browser.c ****  * the current mode changes. Callbacks only stage work; it executes in
 599:src/core/browser.c ****  * the next br_frame() after the system menu resumes the game. */
 600:src/core/browser.c **** 
 601:src/core/browser.c **** static PDMenuItem* s_viewItem = NULL;
 602:src/core/browser.c **** 
 603:src/core/browser.c **** static void mi_home_cb(void* ud)    { (void)ud; menu_action_home(); }
 604:src/core/browser.c **** static void mi_settings_cb(void* ud){ (void)ud; menu_action_settings();
 605:src/core/browser.c ****                                       br_system_menu_refresh(); }
 606:src/core/browser.c **** static void mi_history_cb(void* ud) { (void)ud; menu_action_history();
 607:src/core/browser.c ****                                       br_system_menu_refresh(); }
 608:src/core/browser.c **** static void mi_cookies_cb(void* ud) { (void)ud; cj_clear(); }
 609:src/core/browser.c **** 
 610:src/core/browser.c **** static void mi_view_cb(void* ud) {
 611:src/core/browser.c ****     (void)ud;
 612:src/core/browser.c ****     int v = s_pd->system->getMenuItemValue(s_viewItem);
 613:src/core/browser.c ****     /* Lua: options are { "Reader", "HTML" } */
 614:src/core/browser.c ****     apply_view_mode(v == 0 ? PLUTO_MODE_READER : PLUTO_MODE_RAW_HTML);
 615:src/core/browser.c **** }
 616:src/core/browser.c **** 
 617:src/core/browser.c **** void br_system_menu_refresh(void) {
 618:src/core/browser.c ****     if (s_pd == NULL) return;
 619:src/core/browser.c ****     s_pd->system->removeAllMenuItems();
 620:src/core/browser.c ****     s_pd->system->addMenuItem("Home-Page", mi_home_cb, NULL);
 621:src/core/browser.c ****     s_viewItem = NULL;
 622:src/core/browser.c ****     if (s_br.state == PLUTO_STATE_PAGE && s_br.hasUrl &&
 623:src/core/browser.c ****         strcmp(s_br.curUrl.scheme, "about") != 0) {
 624:src/core/browser.c ****         static const char* opts[2] = { "Reader", "HTML" };
 625:src/core/browser.c ****         s_viewItem = s_pd->system->addOptionsMenuItem(
 626:src/core/browser.c ****             "View", opts, 2, mi_view_cb, NULL);
 627:src/core/browser.c ****         /* Lua: initial selection reflects the active browse mode */
 628:src/core/browser.c ****         s_pd->system->setMenuItemValue(
 629:src/core/browser.c ****             s_viewItem,
 630:src/core/browser.c ****             s_br.browseMode == PLUTO_MODE_READER ? 0 : 1);
 631:src/core/browser.c ****     }
 632:src/core/browser.c ****     s_pd->system->addMenuItem("Settings", mi_settings_cb, NULL);
 633:src/core/browser.c ****     s_pd->system->addMenuItem("History", mi_history_cb, NULL);
 634:src/core/browser.c ****     s_pd->system->addMenuItem("Clear Cookies", mi_cookies_cb, NULL);
 635:src/core/browser.c **** }
