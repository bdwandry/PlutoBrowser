 863:src/core/browser.c ****     if ((storage_settings()->imageMode) == PLUTO_IMAGE_MODE_ALL) {
 864:src/core/browser.c ****         for (size_t i = 0; i < c->doc->nBlocks; i++) {
 865:src/core/browser.c ****             const DocBlock* b = &c->doc->blocks[i];
 866:src/core/browser.c ****             if (b->type == DB_IMAGE && b->src && b->src[0])
 867:src/core/browser.c ****                 id_enqueue(b->src);
 868:src/core/browser.c ****         }
 869:src/core/browser.c ****     }
