 686:src/core/browser.c ****         s_menu.viewIndex == s_br.menuSel)
 687:src/core/browser.c ****         menu_cycle_view(in->justPressed & BR_BTN_RIGHT ? 1 : -1);
 688:src/core/browser.c ****     if (in->justPressed & BR_BTN_A)
 689:src/core/browser.c ****         menu_activate(s_br.menuSel);
 690:src/core/browser.c ****     if (in->justPressed & BR_BTN_B)
 691:src/core/browser.c ****         s_br.menuOpen = 0;
