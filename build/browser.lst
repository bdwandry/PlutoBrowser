 873:src/core/browser.c ****         double delaySec = c->doc->metaDelay > 0 ? c->doc->metaDelay : 0;
 874:src/core/browser.c ****         str_copy(s_br.metaUrl, sizeof(s_br.metaUrl),
 875:src/core/browser.c ****                  c->doc->metaUrl ? c->doc->metaUrl : c->url);
 876:src/core/browser.c ****         s_br.metaDeadlineMs =
