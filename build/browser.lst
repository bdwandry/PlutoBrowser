 686:Source/core/browser.c **** static void menu_handle_input(const BrInput* in) {
 687:Source/core/browser.c ****     if (in->justPressed & BR_BTN_UP && s_br.menuSel > 0)
 688:Source/core/browser.c ****         s_br.menuSel--;
 689:Source/core/browser.c ****     if (in->justPressed & BR_BTN_DOWN &&
 690:Source/core/browser.c ****         s_br.menuSel < s_menu.count - 1)
 691:Source/core/browser.c ****         s_br.menuSel++;
 692:Source/core/browser.c ****     if ((in->justPressed & BR_BTN_LEFT ||
 693:Source/core/browser.c ****          in->justPressed & BR_BTN_RIGHT) &&
 694:Source/core/browser.c ****         s_menu.viewIndex == s_br.menuSel)
 695:Source/core/browser.c ****         menu_cycle_view(in->justPressed & BR_BTN_RIGHT ? 1 : -1);
 696:Source/core/browser.c ****     if (in->justPressed & BR_BTN_A)
 697:Source/core/browser.c ****         menu_activate(s_br.menuSel);
 698:Source/core/browser.c ****     if (in->justPressed & BR_BTN_B)
 699:Source/core/browser.c ****         s_br.menuOpen = 0;
 700:Source/core/browser.c **** }
