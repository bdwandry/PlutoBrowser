 849:src/core/browser.c ****         t = (s_br.curUrl.host[0] != '\0') ? s_br.curUrl.host : "Web Page";
 850:src/core/browser.c ****     str_copy(s_br.pageTitle, sizeof(s_br.pageTitle), t);
 851:src/core/browser.c ****     s_br.scrollY = s_br.targetScrollY = s_br.crankVelocity = 0;
 852:src/core/browser.c ****     s_br.state = PLUTO_STATE_PAGE;
 853:src/core/browser.c ****     if (c->addHist) storage_add_history(s_br.pageTitle, c->url);
