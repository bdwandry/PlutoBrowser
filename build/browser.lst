 348:src/core/browser.c **** /* submitForm(formAction, inputBlock): query built from the CURRENT render
 349:src/core/browser.c ****  * items exactly as the Lua version does (hidden/text match by formAction,
 350:src/core/browser.c ****  * checked checkboxes send value-or-"on", selects send the active option,
 351:src/core/browser.c ****  * dedupe by name, clicked submit button appended per HTML spec, GET
 352:src/core/browser.c ****  * assembly onto formAction with ?/& separator). */
 353:src/core/browser.c **** static void submit_form(const char* formActionIn, struct LItem* submitBtn) {
 354:src/core/browser.c ****     const char* fallback = s_br.hasUrl ? s_br.curUrl.normalized : "";
 355:src/core/browser.c ****     const char* formAction =
 356:src/core/browser.c ****         (formActionIn && formActionIn[0] != '\0') ? formActionIn : fallback;
 357:src/core/browser.c ****     if (!strcmp(formAction, "#")) return;
 358:src/core/browser.c **** 
 359:src/core/browser.c ****     const char* seen[64];
 360:src/core/browser.c ****     int nSeen = 0;
 361:src/core/browser.c ****     StrBuf q;
 362:src/core/browser.c ****     sb_init(&q);
 363:src/core/browser.c **** 
 364:src/core/browser.c ****     for (int i = 0; i < layout_item_count(); i++) {
 365:src/core/browser.c ****         const LItem* it = layout_item_at(i);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cclw0F3k.s 			page 9


 366:src/core/browser.c ****         if (it->disabled) continue;          /* never submitted */
 367:src/core/browser.c ****         int actionMatch = it->formAction &&
 368:src/core/browser.c ****                           !strcmp(it->formAction, formAction);
 369:src/core/browser.c ****         switch (it->type) {
 370:src/core/browser.c ****         case LIT_HIDDEN_FIELD:
 371:src/core/browser.c ****         case LIT_INPUT_FIELD:
 372:src/core/browser.c ****             if (actionMatch) add_pair(&q, seen, &nSeen, it->name, it->value);
 373:src/core/browser.c ****             break;
 374:src/core/browser.c ****         case LIT_CHECKBOX_FIELD:
 375:src/core/browser.c ****             if (actionMatch && it->checked)
 376:src/core/browser.c ****                 add_pair(&q, seen, &nSeen, it->name,
 377:src/core/browser.c ****                          (it->value && it->value[0]) ? it->value : "on");
 378:src/core/browser.c ****             break;
 379:src/core/browser.c ****         case LIT_SELECT_FIELD: {
 380:src/core/browser.c ****             if (!actionMatch) break;
 381:src/core/browser.c ****             const DocSelectOpt* opts = (const DocSelectOpt*)it->options;
 382:src/core/browser.c ****             if (it->selectedIndex >= 1 &&
 383:src/core/browser.c ****                 (size_t)it->selectedIndex <= it->nOptions) {
 384:src/core/browser.c ****                 const DocSelectOpt* opt =
 385:src/core/browser.c ****                     &opts[it->selectedIndex - 1];
 386:src/core/browser.c ****                 if (!opt->disabled && !opt->group)
 387:src/core/browser.c ****                     add_pair(&q, seen, &nSeen, it->name,
 388:src/core/browser.c ****                              (opt->value && opt->value[0]) ? opt->value
 389:src/core/browser.c ****                                                            : opt->text);
 390:src/core/browser.c ****             }
 391:src/core/browser.c ****             break;
 392:src/core/browser.c ****         }
 393:src/core/browser.c ****         default:
 394:src/core/browser.c ****             break;
 395:src/core/browser.c ****         }
 396:src/core/browser.c ****     }
 397:src/core/browser.c **** 
 398:src/core/browser.c ****     /* no fields matched by formAction: collect all named visible inputs */
 399:src/core/browser.c ****     if (q.len == 0) {
 400:src/core/browser.c ****         for (int i = 0; i < layout_item_count(); i++) {
 401:src/core/browser.c ****             const LItem* it = layout_item_at(i);
 402:src/core/browser.c ****             if (it->disabled) continue;
 403:src/core/browser.c ****             if ((it->type == LIT_HIDDEN_FIELD ||
 404:src/core/browser.c ****                  it->type == LIT_INPUT_FIELD) &&
 405:src/core/browser.c ****                 it->name && it->name[0])
 406:src/core/browser.c ****                 add_pair(&q, seen, &nSeen, it->name, it->value);
 407:src/core/browser.c ****         }
 408:src/core/browser.c ****     }
 409:src/core/browser.c **** 
 410:src/core/browser.c ****     /* the clicked submit button's name=value always rides along */
 411:src/core/browser.c ****     if (submitBtn && !submitBtn->disabled &&
 412:src/core/browser.c ****         submitBtn->name && submitBtn->name[0])
 413:src/core/browser.c ****         add_pair(&q, seen, &nSeen, submitBtn->name, submitBtn->value);
 414:src/core/browser.c **** 
 415:src/core/browser.c ****     const char* sep = strchr(formAction, '?') ? "&" : "?";
 416:src/core/browser.c ****     char target[2 * PLUTO_URL_NORMALIZED_MAX];
 417:src/core/browser.c ****     snprintf(target, sizeof(target), "%s%s%s", formAction,
 418:src/core/browser.c ****              q.len > 0 ? sep : "", q.len > 0 ? (q.data ? q.data : "") : "");
 419:src/core/browser.c ****     sb_free(&q);
 420:src/core/browser.c ****     navigate_to(target);
 421:src/core/browser.c **** }
