 194:Source/core/browser.c **** static int go_back_url(char* out, size_t cap) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc8JP6R2.s 			page 6


 195:Source/core/browser.c ****     if (s_br.hIdx <= 0) return 0;
 196:Source/core/browser.c ****     s_br.hIdx--;
 197:Source/core/browser.c ****     s_br.navigatingHistory = 1;
 198:Source/core/browser.c ****     str_copy(out, cap, s_br.navHistory[s_br.hIdx]);
 199:Source/core/browser.c ****     return 1;
 200:Source/core/browser.c **** }
 201:Source/core/browser.c **** 
 202:Source/core/browser.c **** static int go_forward_url(char* out, size_t cap) {
 203:Source/core/browser.c ****     if (s_br.hIdx >= s_br.nHistory - 1) return 0;
 204:Source/core/browser.c ****     s_br.hIdx++;
