 549:Source/core/browser.c **** static void menu_activate(int row) {
 550:Source/core/browser.c ****     /* Lua parity: picking a system-menu item dismisses the menu (the SDK
 551:Source/core/browser.c ****      * closes it and a kEventResume follows); our custom overlay mirrors
 552:Source/core/browser.c ****      * the observable result */
 553:Source/core/browser.c ****     s_br.menuOpen = 0;
 554:Source/core/browser.c ****     int idx = 0;
 555:Source/core/browser.c ****     for (int kind = 0; kind < 5; kind++) {
 556:Source/core/browser.c ****         if (!s_menu.present[kind]) continue;
 557:Source/core/browser.c ****         if (idx == row) {
 558:Source/core/browser.c ****             switch (kind) {
 559:Source/core/browser.c ****             case BR_MI_HOME:     menu_action_home(); break;
 560:Source/core/browser.c ****             case BR_MI_SETTINGS: menu_action_settings(); break;
 561:Source/core/browser.c ****             case BR_MI_HISTORY:  menu_action_history(); break;
 562:Source/core/browser.c ****             case BR_MI_COOKIES:  menu_action_cookies(); break;
 563:Source/core/browser.c ****             case BR_MI_VIEW: {
 564:Source/core/browser.c ****                 int next = (s_br.browseMode == PLUTO_MODE_READER)
 565:Source/core/browser.c ****                                ? PLUTO_MODE_RAW_HTML
 566:Source/core/browser.c ****                                : PLUTO_MODE_READER;
 567:Source/core/browser.c ****                 apply_view_mode(next);
 568:Source/core/browser.c ****                 break;
 569:Source/core/browser.c ****             }
 570:Source/core/browser.c ****             default: break;
 571:Source/core/browser.c ****             }
 572:Source/core/browser.c ****             return;
 573:Source/core/browser.c ****         }
 574:Source/core/browser.c ****         idx++;
 575:Source/core/browser.c ****     }
 576:Source/core/browser.c **** }
