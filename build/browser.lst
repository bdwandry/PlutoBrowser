 173:Source/core/browser.c **** 
 174:Source/core/browser.c **** static void push_history(const char* urlString) {
 175:Source/core/browser.c ****     /* navigating somewhere new clears the future */
 176:Source/core/browser.c ****     if (s_br.hIdx < s_br.nHistory - 1) s_br.nHistory = s_br.hIdx + 1;
 177:Source/core/browser.c **** 
 178:Source/core/browser.c ****     if (s_br.nHistory > 0 &&
 179:Source/core/browser.c ****         !strcmp(s_br.navHistory[s_br.nHistory - 1], urlString))
 180:Source/core/browser.c ****         return;
 181:Source/core/browser.c **** 
 182:Source/core/browser.c ****     if (s_br.nHistory < BR_MAX_HISTORY)
 183:Source/core/browser.c ****         str_copy(s_br.navHistory[s_br.nHistory++],
 184:Source/core/browser.c ****                  PLUTO_URL_NORMALIZED_MAX, urlString);
 185:Source/core/browser.c ****     else {
 186:Source/core/browser.c ****         memmove(s_br.navHistory, s_br.navHistory + 1,
 187:Source/core/browser.c ****                 sizeof(s_br.navHistory[0]) * (BR_MAX_HISTORY - 1));
 188:Source/core/browser.c ****         str_copy(s_br.navHistory[BR_MAX_HISTORY - 1],
 189:Source/core/browser.c ****                  PLUTO_URL_NORMALIZED_MAX, urlString);
 190:Source/core/browser.c ****     }
 191:Source/core/browser.c ****     s_br.hIdx = s_br.nHistory - 1;
 192:Source/core/browser.c **** }
