 830:src/core/browser.c **** static int render_step(void* ctx) {
 831:src/core/browser.c ****     BrRenderCtx* c = (BrRenderCtx*)ctx;
 832:src/core/browser.c ****     if (c->stage == 0) {
 833:src/core/browser.c ****         c->doc = doc_parse_opts(c->body, c->url, s_br.browseMode, NULL);
 834:src/core/browser.c ****         if (c->doc == NULL) {
 835:src/core/browser.c ****             tasks_set_error("Parse Error: document unavailable");
 836:src/core/browser.c ****             return PLUTO_TASK_ERROR;
 837:src/core/browser.c ****         }
 838:src/core/browser.c ****         tasks_report_progress(0.5);
 839:src/core/browser.c ****         c->stage = 1;
 840:src/core/browser.c ****         return PLUTO_TASK_YIELD;   /* yield: layout next slice */
 841:src/core/browser.c ****     }
 842:src/core/browser.c ****     layout_build(c->doc);
 843:src/core/browser.c ****     tasks_report_progress(1.0);
 844:src/core/browser.c ****     return PLUTO_TASK_DONE;
 845:src/core/browser.c **** }
