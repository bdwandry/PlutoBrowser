 882:Source/core/browser.c **** static void render_fail(const char* msg, void* ud) {
 883:Source/core/browser.c ****     (void)msg;
 884:Source/core/browser.c ****     BrRenderCtx* c = (BrRenderCtx*)ud;
 885:Source/core/browser.c ****     if (c != NULL) {
 886:Source/core/browser.c ****         s_br.isRendering = 0;
 887:Source/core/browser.c ****         ep_show(msg, c->url);
 888:Source/core/browser.c ****         s_br.state = PLUTO_STATE_ERROR;
 889:Source/core/browser.c ****         str_copy(s_br.pageTitle, sizeof(s_br.pageTitle), "Render Error");
 890:Source/core/browser.c ****         menu_rebuild();
 891:Source/core/browser.c ****     }
 892:Source/core/browser.c **** }
 893:Source/core/browser.c **** 
 894:Source/core/browser.c **** static void render_body(const char* body, const char* url, int addToHistory) {
 895:Source/core/browser.c ****     s_br.isRendering = 1;
 896:Source/core/browser.c ****     s_br.progressCur = 0;
 897:Source/core/browser.c ****     s_br.progressTot = 0;
 898:Source/core/browser.c ****     str_copy(s_br.pageTitle, sizeof(s_br.pageTitle), "Rendering...");
 899:Source/core/browser.c ****     s_br.state = PLUTO_STATE_LOADING;
 900:Source/core/browser.c **** 
 901:Source/core/browser.c ****     BrRenderCtx* c = (BrRenderCtx*)pluto_malloc(sizeof(BrRenderCtx));
 902:Source/core/browser.c ****     memset(c, 0, sizeof(*c));
 903:Source/core/browser.c ****     c->body    = pluto_strdup(body ? body : "");
 904:Source/core/browser.c ****     c->url     = pluto_strdup(url ? url : "");
 905:Source/core/browser.c ****     c->addHist = addToHistory;
 906:Source/core/browser.c ****     c->stage   = 0;
 907:Source/core/browser.c ****     tasks_run(render_step, c, render_ctx_free, render_done, render_fail,
 908:Source/core/browser.c ****               c);   /* ctx rides as ud so fail() keeps context */
 909:Source/core/browser.c **** }
