 850:src/render/decoders/webp.c **** static void predictor_add(int mode, const uint32_t* in, int iIn,
 851:src/render/decoders/webp.c ****                           uint32_t* out, int oOut, int x, int count,
 852:src/render/decoders/webp.c ****                           int width) {
 853:src/render/decoders/webp.c ****     int i;
 854:src/render/decoders/webp.c ****     int baseIn = iIn + x;
 855:src/render/decoders/webp.c ****     int baseOut = oOut + x;
 856:src/render/decoders/webp.c ****     for (i = 0; i < count; i++) {
 857:src/render/decoders/webp.c ****         int px = baseOut + i;
 858:src/render/decoders/webp.c ****         uint32_t pred = predictor_value(mode, out[px - 1], out[px - width],
 859:src/render/decoders/webp.c ****                                         out[px - width + 1],
 860:src/render/decoders/webp.c ****                                         out[px - width - 1]);
 861:src/render/decoders/webp.c ****         out[px] = add_pixels(in[baseIn + i], pred);
 862:src/render/decoders/webp.c ****     }
 863:src/render/decoders/webp.c **** }
