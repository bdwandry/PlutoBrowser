 869:Source/render/decoders/webp.c **** static void predictor_inverse(const Transform* t, const uint32_t* in,
 870:Source/render/decoders/webp.c ****                               uint32_t* out, int rows) {
 871:Source/render/decoders/webp.c ****     int width = t->xsize;
 872:Source/render/decoders/webp.c ****     int tileWidth = 1 << t->bits;
 873:Source/render/decoders/webp.c ****     int tilesPerRow = sub_sample_size(width, t->bits);
 874:Source/render/decoders/webp.c ****     const uint32_t* tdata = t->data;
 875:Source/render/decoders/webp.c ****     int iIn = width, oOut = width, y;
 876:Source/render/decoders/webp.c **** 
 877:Source/render/decoders/webp.c ****     out[0] = add_pixels(in[0], ARGB_BLACK);
 878:Source/render/decoders/webp.c ****     for (y = 1; y < width; y++) out[y] = add_pixels(in[y], out[y - 1]);
 879:Source/render/decoders/webp.c **** 
 880:Source/render/decoders/webp.c ****     y = 1;
 881:Source/render/decoders/webp.c ****     while (y < rows) {
 882:Source/render/decoders/webp.c ****         int predModeBase = (y >> t->bits) * tilesPerRow;
 883:Source/render/decoders/webp.c ****         int predModeSrc = predModeBase;
 884:Source/render/decoders/webp.c ****         int x = 1;
 885:Source/render/decoders/webp.c ****         tasks_yield_check();
 886:Source/render/decoders/webp.c ****         out[oOut] = add_pixels(in[iIn], out[oOut - width]);
 887:Source/render/decoders/webp.c ****         while (x < width) {
 888:Source/render/decoders/webp.c ****             int mode = (int)((tdata[predModeSrc] >> 8) & 0xF);
 889:Source/render/decoders/webp.c ****             int xEnd = (x & ~(tileWidth - 1)) + tileWidth;
 890:Source/render/decoders/webp.c ****             predModeSrc++;
 891:Source/render/decoders/webp.c ****             if (xEnd > width) xEnd = width;
 892:Source/render/decoders/webp.c ****             predictor_add(mode, in, iIn, out, oOut, x, xEnd - x, width);
 893:Source/render/decoders/webp.c ****             x = xEnd;
 894:Source/render/decoders/webp.c ****         }
 895:Source/render/decoders/webp.c ****         iIn += width;
 896:Source/render/decoders/webp.c ****         oOut += width;
 897:Source/render/decoders/webp.c ****         y++;
 898:Source/render/decoders/webp.c ****     }
 899:Source/render/decoders/webp.c **** }
