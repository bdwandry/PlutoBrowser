1559:Source/render/decoders/webp.c **** static int vp8_parse_segment_header(Vp8Br* br, Vp8Dec* dec) {
1560:Source/render/decoders/webp.c ****     Vp8SegmentHdr* hdr = &dec->segmentHdr;
1561:Source/render/decoders/webp.c ****     int s;
1562:Source/render/decoders/webp.c ****     hdr->useSegment = vp8_get_bit(br, 128);
1563:Source/render/decoders/webp.c ****     if (hdr->useSegment != 0) {
1564:Source/render/decoders/webp.c ****         hdr->updateMap = vp8_get_bit(br, 128);
1565:Source/render/decoders/webp.c ****         if (vp8_get_bit(br, 128) != 0) {
1566:Source/render/decoders/webp.c ****             hdr->absoluteDelta = vp8_get_bit(br, 128);
1567:Source/render/decoders/webp.c ****             for (s = 0; s < 4; s++)
1568:Source/render/decoders/webp.c ****                 hdr->quantizer[s] =
1569:Source/render/decoders/webp.c ****                     (vp8_get_bit(br, 128) != 0) ? vp8_get_signed_value(br, 7) : 0;
1570:Source/render/decoders/webp.c ****             for (s = 0; s < 4; s++)
1571:Source/render/decoders/webp.c ****                 hdr->filterStrength[s] =
1572:Source/render/decoders/webp.c ****                     (vp8_get_bit(br, 128) != 0) ? vp8_get_signed_value(br, 6) : 0;
1573:Source/render/decoders/webp.c ****         }
1574:Source/render/decoders/webp.c ****         if (hdr->updateMap != 0) {
1575:Source/render/decoders/webp.c ****             for (s = 0; s < 3; s++)
1576:Source/render/decoders/webp.c ****                 dec->probaSegments[s] =
1577:Source/render/decoders/webp.c ****                     (vp8_get_bit(br, 128) != 0) ? vp8_get_value(br, 8) : 255;
1578:Source/render/decoders/webp.c ****         }
1579:Source/render/decoders/webp.c ****     } else {
1580:Source/render/decoders/webp.c ****         hdr->updateMap = 0;
1581:Source/render/decoders/webp.c ****     }
1582:Source/render/decoders/webp.c ****     return br->eof == 0;
1583:Source/render/decoders/webp.c **** }
