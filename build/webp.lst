 289:src/render/decoders/webp.c **** /* ------------------------------------------------------------------ */
 290:src/render/decoders/webp.c **** /* Code-length codes / Huffman code reading                            */
 291:src/render/decoders/webp.c **** 
 292:src/render/decoders/webp.c **** static int read_huffman_code_lengths(Br* br,
 293:src/render/decoders/webp.c ****                                      const uint8_t* codeLengthCodeLengths,
 294:src/render/decoders/webp.c ****                                      int numSymbols, uint8_t* codeLengths) {
 295:src/render/decoders/webp.c ****     uint32_t* table =
 296:src/render/decoders/webp.c ****         build_huffman_table(codeLengthCodeLengths, NUM_CODE_LENGTH_CODES,
 297:src/render/decoders/webp.c ****                             LENGTHS_TABLE_BITS);
 298:src/render/decoders/webp.c ****     int maxSymbol, symbol, prevCodeLen;
 299:src/render/decoders/webp.c ****     if (!table) return 0;
 300:src/render/decoders/webp.c ****     if (br_read_bits(br, 1) == 1) {
 301:src/render/decoders/webp.c ****         int lengthNbits = 2 + 2 * br_read_bits(br, 3);
 302:src/render/decoders/webp.c ****         maxSymbol = 2 + br_read_bits(br, lengthNbits);
 303:src/render/decoders/webp.c ****         if (maxSymbol > numSymbols) {
 304:src/render/decoders/webp.c ****             pluto_free(table);
 305:src/render/decoders/webp.c ****             return 0;
 306:src/render/decoders/webp.c ****         }
 307:src/render/decoders/webp.c ****     } else {
 308:src/render/decoders/webp.c ****         maxSymbol = numSymbols;
 309:src/render/decoders/webp.c ****     }
 310:src/render/decoders/webp.c **** 
 311:src/render/decoders/webp.c ****     symbol = 0;
 312:src/render/decoders/webp.c ****     prevCodeLen = DEFAULT_CODE_LENGTH;
 313:src/render/decoders/webp.c ****     while (symbol < numSymbols) {
 314:src/render/decoders/webp.c ****         int val, codeLen;
 315:src/render/decoders/webp.c ****         if (maxSymbol == 0) break;
 316:src/render/decoders/webp.c ****         maxSymbol--;
 317:src/render/decoders/webp.c ****         val = br_prefetch(br, LENGTHS_TABLE_BITS * 2 + 1);
 318:src/render/decoders/webp.c ****         if (br->nbits < LENGTHS_TABLE_BITS) {
 319:src/render/decoders/webp.c ****             br->eos = 1;
 320:src/render/decoders/webp.c ****             pluto_free(table);
 321:src/render/decoders/webp.c ****             return 0;
 322:src/render/decoders/webp.c ****         }
 323:src/render/decoders/webp.c ****         {
 324:src/render/decoders/webp.c ****             uint32_t p = table[val & LENGTHS_TABLE_MASK];
 325:src/render/decoders/webp.c ****             br_advance(br, (int)(p >> 16));
 326:src/render/decoders/webp.c ****             codeLen = (int)(p & 0xFFFF);
 327:src/render/decoders/webp.c ****         }
 328:src/render/decoders/webp.c ****         if (codeLen < 16) {
 329:src/render/decoders/webp.c ****             codeLengths[symbol++] = (uint8_t)codeLen;
 330:src/render/decoders/webp.c ****             if (codeLen != 0) prevCodeLen = codeLen;
 331:src/render/decoders/webp.c ****         } else {
 332:src/render/decoders/webp.c ****             int usePrev = (codeLen == 16);
 333:src/render/decoders/webp.c ****             int slot = codeLen - 16;
 334:src/render/decoders/webp.c ****             int repeatCount = br_read_bits(br, kCodeLengthExtraBits[slot]) +
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccQjXwFz.s 			page 17


 335:src/render/decoders/webp.c ****                               kCodeLengthRepeatOffsets[slot];
 336:src/render/decoders/webp.c ****             int length = usePrev ? prevCodeLen : 0;
 337:src/render/decoders/webp.c ****             if (symbol + repeatCount > numSymbols) {
 338:src/render/decoders/webp.c ****                 pluto_free(table);
 339:src/render/decoders/webp.c ****                 return 0;
 340:src/render/decoders/webp.c ****             }
 341:src/render/decoders/webp.c ****             while (repeatCount-- > 0) codeLengths[symbol++] = (uint8_t)length;
 342:src/render/decoders/webp.c ****         }
 343:src/render/decoders/webp.c ****     }
 344:src/render/decoders/webp.c ****     pluto_free(table);
 345:src/render/decoders/webp.c ****     return 1;
 346:src/render/decoders/webp.c **** }
 347:src/render/decoders/webp.c **** 
 348:src/render/decoders/webp.c **** static uint32_t* read_huffman_code(int alphabetSize, Br* br,
 349:src/render/decoders/webp.c ****                                    uint8_t* codeLengths,
 350:src/render/decoders/webp.c ****                                    uint8_t* codeLengthCodeLengths) {
 351:src/render/decoders/webp.c ****     memset(codeLengths, 0, (size_t)alphabetSize);
 352:src/render/decoders/webp.c ****     if (br_read_bits(br, 1) == 1) {
 353:src/render/decoders/webp.c ****         int numSymbols = br_read_bits(br, 1) + 1;
 354:src/render/decoders/webp.c ****         int firstSymbolLenCode = br_read_bits(br, 1);
