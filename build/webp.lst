 865:src/render/decoders/webp.c **** static void predictor_inverse(const Transform* t, const uint32_t* in,
 866:src/render/decoders/webp.c ****                               uint32_t* out, int rows) {
 867:src/render/decoders/webp.c ****     int width = t->xsize;
 868:src/render/decoders/webp.c ****     int tileWidth = 1 << t->bits;
 869:src/render/decoders/webp.c ****     int tilesPerRow = sub_sample_size(width, t->bits);
 870:src/render/decoders/webp.c ****     const uint32_t* tdata = t->data;
 871:src/render/decoders/webp.c ****     int iIn = width, oOut = width, y;
 872:src/render/decoders/webp.c **** 
 873:src/render/decoders/webp.c ****     out[0] = add_pixels(in[0], ARGB_BLACK);
 874:src/render/decoders/webp.c ****     for (y = 1; y < width; y++) out[y] = add_pixels(in[y], out[y - 1]);
 875:src/render/decoders/webp.c **** 
 876:src/render/decoders/webp.c ****     y = 1;
 877:src/render/decoders/webp.c ****     while (y < rows) {
 878:src/render/decoders/webp.c ****         int predModeBase = (y >> t->bits) * tilesPerRow;
 879:src/render/decoders/webp.c ****         int predModeSrc = predModeBase;
 880:src/render/decoders/webp.c ****         int x = 1;
 881:src/render/decoders/webp.c ****         tasks_yield_check();
 882:src/render/decoders/webp.c ****         out[oOut] = add_pixels(in[iIn], out[oOut - width]);
 883:src/render/decoders/webp.c ****         while (x < width) {
 884:src/render/decoders/webp.c ****             int mode = (int)((tdata[predModeSrc] >> 8) & 0xF);
 885:src/render/decoders/webp.c ****             int xEnd = (x & ~(tileWidth - 1)) + tileWidth;
 886:src/render/decoders/webp.c ****             predModeSrc++;
 887:src/render/decoders/webp.c ****             if (xEnd > width) xEnd = width;
 888:src/render/decoders/webp.c ****             predictor_add(mode, in, iIn, out, oOut, x, xEnd - x, width);
 889:src/render/decoders/webp.c ****             x = xEnd;
 890:src/render/decoders/webp.c ****         }
 891:src/render/decoders/webp.c ****         iIn += width;
 892:src/render/decoders/webp.c ****         oOut += width;
 893:src/render/decoders/webp.c ****         y++;
 894:src/render/decoders/webp.c ****     }
 895:src/render/decoders/webp.c **** }
 896:src/render/decoders/webp.c **** 
 897:src/render/decoders/webp.c **** static int to_int8(int v) {
 898:src/render/decoders/webp.c ****     return v >= 128 ? v - 256 : v;
 899:src/render/decoders/webp.c **** }
 900:src/render/decoders/webp.c **** 
 901:src/render/decoders/webp.c **** static int color_transform_delta(int colorPred, int color) {
 902:src/render/decoders/webp.c ****     return (colorPred * color) >> 5;
 903:src/render/decoders/webp.c **** }
