 294:Source/render/decoders/webp.c **** /* Code-length codes / Huffman code reading                            */
 295:Source/render/decoders/webp.c **** 
 296:Source/render/decoders/webp.c **** static int read_huffman_code_lengths(Br* br,
 297:Source/render/decoders/webp.c ****                                      const uint8_t* codeLengthCodeLengths,
 298:Source/render/decoders/webp.c ****                                      int numSymbols, uint8_t* codeLengths) {
 299:Source/render/decoders/webp.c ****     uint32_t* table =
 300:Source/render/decoders/webp.c ****         build_huffman_table(codeLengthCodeLengths, NUM_CODE_LENGTH_CODES,
 301:Source/render/decoders/webp.c ****                             LENGTHS_TABLE_BITS);
 302:Source/render/decoders/webp.c ****     int maxSymbol, symbol, prevCodeLen;
 303:Source/render/decoders/webp.c ****     if (!table) return 0;
 304:Source/render/decoders/webp.c ****     if (br_read_bits(br, 1) == 1) {
 305:Source/render/decoders/webp.c ****         int lengthNbits = 2 + 2 * br_read_bits(br, 3);
 306:Source/render/decoders/webp.c ****         maxSymbol = 2 + br_read_bits(br, lengthNbits);
 307:Source/render/decoders/webp.c ****         if (maxSymbol > numSymbols) {
 308:Source/render/decoders/webp.c ****             pluto_free(table);
 309:Source/render/decoders/webp.c ****             return 0;
 310:Source/render/decoders/webp.c ****         }
 311:Source/render/decoders/webp.c ****     } else {
 312:Source/render/decoders/webp.c ****         maxSymbol = numSymbols;
 313:Source/render/decoders/webp.c ****     }
 314:Source/render/decoders/webp.c **** 
 315:Source/render/decoders/webp.c ****     symbol = 0;
 316:Source/render/decoders/webp.c ****     prevCodeLen = DEFAULT_CODE_LENGTH;
 317:Source/render/decoders/webp.c ****     while (symbol < numSymbols) {
 318:Source/render/decoders/webp.c ****         int val, codeLen;
 319:Source/render/decoders/webp.c ****         if (maxSymbol == 0) break;
 320:Source/render/decoders/webp.c ****         maxSymbol--;
 321:Source/render/decoders/webp.c ****         val = br_prefetch(br, LENGTHS_TABLE_BITS * 2 + 1);
 322:Source/render/decoders/webp.c ****         if (br->nbits < LENGTHS_TABLE_BITS) {
 323:Source/render/decoders/webp.c ****             br->eos = 1;
 324:Source/render/decoders/webp.c ****             pluto_free(table);
 325:Source/render/decoders/webp.c ****             return 0;
 326:Source/render/decoders/webp.c ****         }
 327:Source/render/decoders/webp.c ****         {
 328:Source/render/decoders/webp.c ****             uint32_t p = table[val & LENGTHS_TABLE_MASK];
 329:Source/render/decoders/webp.c ****             br_advance(br, (int)(p >> 16));
 330:Source/render/decoders/webp.c ****             codeLen = (int)(p & 0xFFFF);
 331:Source/render/decoders/webp.c ****         }
 332:Source/render/decoders/webp.c ****         if (codeLen < 16) {
 333:Source/render/decoders/webp.c ****             codeLengths[symbol++] = (uint8_t)codeLen;
 334:Source/render/decoders/webp.c ****             if (codeLen != 0) prevCodeLen = codeLen;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 17


 335:Source/render/decoders/webp.c ****         } else {
 336:Source/render/decoders/webp.c ****             int usePrev = (codeLen == 16);
 337:Source/render/decoders/webp.c ****             int slot = codeLen - 16;
 338:Source/render/decoders/webp.c ****             int repeatCount = br_read_bits(br, kCodeLengthExtraBits[slot]) +
 339:Source/render/decoders/webp.c ****                               kCodeLengthRepeatOffsets[slot];
 340:Source/render/decoders/webp.c ****             int length = usePrev ? prevCodeLen : 0;
 341:Source/render/decoders/webp.c ****             if (symbol + repeatCount > numSymbols) {
 342:Source/render/decoders/webp.c ****                 pluto_free(table);
 343:Source/render/decoders/webp.c ****                 return 0;
 344:Source/render/decoders/webp.c ****             }
 345:Source/render/decoders/webp.c ****             while (repeatCount-- > 0) codeLengths[symbol++] = (uint8_t)length;
 346:Source/render/decoders/webp.c ****         }
 347:Source/render/decoders/webp.c ****     }
 348:Source/render/decoders/webp.c ****     pluto_free(table);
 349:Source/render/decoders/webp.c ****     return 1;
 350:Source/render/decoders/webp.c **** }
 351:Source/render/decoders/webp.c **** 
 352:Source/render/decoders/webp.c **** static uint32_t* read_huffman_code(int alphabetSize, Br* br,
 353:Source/render/decoders/webp.c ****                                    uint8_t* codeLengths,
 354:Source/render/decoders/webp.c ****                                    uint8_t* codeLengthCodeLengths) {
 355:Source/render/decoders/webp.c ****     memset(codeLengths, 0, (size_t)alphabetSize);
 356:Source/render/decoders/webp.c ****     if (br_read_bits(br, 1) == 1) {
 357:Source/render/decoders/webp.c ****         int numSymbols = br_read_bits(br, 1) + 1;
 358:Source/render/decoders/webp.c ****         int firstSymbolLenCode = br_read_bits(br, 1);
 359:Source/render/decoders/webp.c ****         int symbol = br_read_bits(br, firstSymbolLenCode == 0 ? 1 : 8);
 360:Source/render/decoders/webp.c ****         if (symbol >= alphabetSize) return NULL;
 361:Source/render/decoders/webp.c ****         codeLengths[symbol] = 1;
 362:Source/render/decoders/webp.c ****         if (numSymbols == 2) {
 363:Source/render/decoders/webp.c ****             symbol = br_read_bits(br, 8);
 364:Source/render/decoders/webp.c ****             if (symbol >= alphabetSize) return NULL;
 365:Source/render/decoders/webp.c ****             codeLengths[symbol] = 1;
 366:Source/render/decoders/webp.c ****         }
 367:Source/render/decoders/webp.c ****     } else {
 368:Source/render/decoders/webp.c ****         int numCodes = br_read_bits(br, 4) + 4;
 369:Source/render/decoders/webp.c ****         int i;
 370:Source/render/decoders/webp.c ****         memset(codeLengthCodeLengths, 0, NUM_CODE_LENGTH_CODES);
 371:Source/render/decoders/webp.c ****         for (i = 0; i < numCodes; i++) {
 372:Source/render/decoders/webp.c ****             codeLengthCodeLengths[kCodeLengthCodeOrder[i]] =
 373:Source/render/decoders/webp.c ****                 (uint8_t)br_read_bits(br, 3);
 374:Source/render/decoders/webp.c ****         }
 375:Source/render/decoders/webp.c ****         if (!read_huffman_code_lengths(br, codeLengthCodeLengths, alphabetSize,
 376:Source/render/decoders/webp.c ****                                        codeLengths)) {
 377:Source/render/decoders/webp.c ****             return NULL;
 378:Source/render/decoders/webp.c ****         }
 379:Source/render/decoders/webp.c ****     }
 380:Source/render/decoders/webp.c ****     if (br->eos) return NULL;
 381:Source/render/decoders/webp.c ****     return build_huffman_table(codeLengths, alphabetSize, HUFFMAN_TABLE_BITS);
 382:Source/render/decoders/webp.c **** }
