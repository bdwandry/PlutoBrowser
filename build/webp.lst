 725:Source/render/decoders/webp.c ****                         metaIndex =
 726:Source/render/decoders/webp.c ****                             huffmanImage[huffmanXsize * (row >> huffmanBits) +
 727:Source/render/decoders/webp.c ****                                          (col >> huffmanBits)];
