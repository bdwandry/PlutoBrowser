 621:src/render/decoders/webp.c ****     if (!cc->colors) {
 622:src/render/decoders/webp.c ****         pluto_free(cc);
 623:src/render/decoders/webp.c ****         return NULL;
 624:src/render/decoders/webp.c ****     }
 625:src/render/decoders/webp.c ****     cc->hashShift = 32 - bits;
 626:src/render/decoders/webp.c ****     return cc;
 627:src/render/decoders/webp.c **** }
