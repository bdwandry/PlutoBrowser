 742:Source/render/decoders/webp.c ****                     col = 0;
 743:Source/render/decoders/webp.c ****                     row++;
 744:Source/render/decoders/webp.c ****                 }
 745:Source/render/decoders/webp.c ****                 if (colorCache) {
 746:Source/render/decoders/webp.c ****                     while (lastCached < src)
 747:Source/render/decoders/webp.c ****                         color_cache_insert(colorCache, data[lastCached++]);
 748:Source/render/decoders/webp.c ****                 }
 749:Source/render/decoders/webp.c ****             } else {
 750:Source/render/decoders/webp.c ****                 return 0;
 751:Source/render/decoders/webp.c ****             }
 752:Source/render/decoders/webp.c ****         }
 753:Source/render/decoders/webp.c ****         if (br->eos) return 0;
 754:Source/render/decoders/webp.c ****     }
 755:Source/render/decoders/webp.c ****     if (br->eos) return 0;
