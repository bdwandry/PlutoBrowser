  63:Source/render/decoders/webp.c ****     br->len = len;
  64:Source/render/decoders/webp.c ****     br->pos = startPos; /* 1-based, exactly like Lua */
  65:Source/render/decoders/webp.c ****     br->window = 0;
  66:Source/render/decoders/webp.c ****     br->nbits = 0;
  67:Source/render/decoders/webp.c ****     br->eos = 0;
  68:Source/render/decoders/webp.c **** }
