1174:Source/render/decoders/webp.c **** /* ── colorSpaceInverse (webp.lua 765-803) ─────────────────�
1175:Source/render/decoders/webp.c **** static void vp8l_color_space_inverse(const WebPTransform *t, const uint32_t *in_,
1176:Source/render/decoders/webp.c ****                                      uint32_t *out, int rows)
1177:Source/render/decoders/webp.c **** {
1178:Source/render/decoders/webp.c ****     int width = t->xsize;
1179:Source/render/decoders/webp.c ****     int tileWidth = 1 << t->bits;
1180:Source/render/decoders/webp.c ****     int mask = tileWidth - 1;
1181:Source/render/decoders/webp.c ****     int safeWidth = width & ~mask;
1182:Source/render/decoders/webp.c ****     int remainingWidth = width - safeWidth;
1183:Source/render/decoders/webp.c ****     int tilesPerRow = vp8l_sub_sample_size(width, t->bits);
1184:Source/render/decoders/webp.c ****     const uint32_t *tdata = t->data;
1185:Source/render/decoders/webp.c ****     int predRow = 0;
1186:Source/render/decoders/webp.c ****     int y = 0;
1187:Source/render/decoders/webp.c ****     while (y < rows)
1188:Source/render/decoders/webp.c ****     {
1189:Source/render/decoders/webp.c ****         /* Tasks.yieldCheck() call site (task layer owns the frame budget) */
1190:Source/render/decoders/webp.c ****         int predIdx = predRow;
1191:Source/render/decoders/webp.c ****         int m[3] = { 0, 0, 0 };
1192:Source/render/decoders/webp.c ****         int srcPos = y * width;
1193:Source/render/decoders/webp.c ****         int dstPos = y * width;
1194:Source/render/decoders/webp.c ****         int safeEnd = srcPos + safeWidth;
1195:Source/render/decoders/webp.c ****         int endPos = srcPos + width;
1196:Source/render/decoders/webp.c ****         while (srcPos < safeEnd)
1197:Source/render/decoders/webp.c ****         {
1198:Source/render/decoders/webp.c ****             uint32_t code = tdata[predIdx++];
1199:Source/render/decoders/webp.c ****             m[0] = vp8l_to_int8((int)(code & 0xFF));
1200:Source/render/decoders/webp.c ****             m[1] = vp8l_to_int8((int)((code >> 8) & 0xFF));
1201:Source/render/decoders/webp.c ****             m[2] = vp8l_to_int8((int)((code >> 16) & 0xFF));
1202:Source/render/decoders/webp.c ****             vp8l_transform_color_inverse(m, in_, srcPos, tileWidth, out, dstPos);
1203:Source/render/decoders/webp.c ****             srcPos += tileWidth;
1204:Source/render/decoders/webp.c ****             dstPos += tileWidth;
1205:Source/render/decoders/webp.c ****         }
