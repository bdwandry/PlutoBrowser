2158:Source/render/decoders/webp.c **** static int vp8_check_mode(int mbX, int mbY, int mode) {
2159:Source/render/decoders/webp.c ****     if (mode == VP8_DC_PRED) {
2160:Source/render/decoders/webp.c ****         if (mbX == 0) {
2161:Source/render/decoders/webp.c ****             if (mbY == 0) return 6;
2162:Source/render/decoders/webp.c ****             return 5;
2163:Source/render/decoders/webp.c ****         }
2164:Source/render/decoders/webp.c ****         if (mbY == 0) return 4;
2165:Source/render/decoders/webp.c ****         return 0;
2166:Source/render/decoders/webp.c ****     }
2167:Source/render/decoders/webp.c ****     return mode;
2168:Source/render/decoders/webp.c **** }
