3087:Source/render/decoders/webp.c ****     if (len < 11) return 0;
3088:Source/render/decoders/webp.c ****     bits = (unsigned int)payload[0] | ((unsigned int)payload[1] << 8) |
3089:Source/render/decoders/webp.c ****            ((unsigned int)payload[2] << 16);
