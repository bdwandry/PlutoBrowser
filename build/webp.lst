1027:Source/render/decoders/webp.c **** static uint32_t* expand_color_map(int numColors, const Transform* t) {
1028:Source/render/decoders/webp.c ****     int finalNum = 1 << (8 >> t->bits);
1029:Source/render/decoders/webp.c ****     const uint32_t* oldData = t->data;
1030:Source/render/decoders/webp.c ****     uint32_t* newData =
1031:Source/render/decoders/webp.c ****         (uint32_t*)pluto_calloc((size_t)finalNum, sizeof(uint32_t));
1032:Source/render/decoders/webp.c ****     int i;
1033:Source/render/decoders/webp.c ****     if (!newData) return NULL;
1034:Source/render/decoders/webp.c ****     newData[0] = oldData[0];
1035:Source/render/decoders/webp.c ****     for (i = 1; i < numColors; i++) {
1036:Source/render/decoders/webp.c ****         uint32_t prev = newData[i - 1];
1037:Source/render/decoders/webp.c ****         uint32_t cur = oldData[i];
1038:Source/render/decoders/webp.c ****         uint32_t a = ((prev >> 24) & 0xFF) + ((cur >> 24) & 0xFF);
1039:Source/render/decoders/webp.c ****         uint32_t r = ((prev >> 16) & 0xFF) + ((cur >> 16) & 0xFF);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 34


1040:Source/render/decoders/webp.c ****         uint32_t g = ((prev >> 8) & 0xFF) + ((cur >> 8) & 0xFF);
1041:Source/render/decoders/webp.c ****         uint32_t b = (prev & 0xFF) + (cur & 0xFF);
1042:Source/render/decoders/webp.c ****         newData[i] = ((a & 0xFF) << 24) | ((r & 0xFF) << 16) |
1043:Source/render/decoders/webp.c ****                      ((g & 0xFF) << 8) | (b & 0xFF);
1044:Source/render/decoders/webp.c ****     }
1045:Source/render/decoders/webp.c ****     return newData;
1046:Source/render/decoders/webp.c **** }
