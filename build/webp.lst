 493:Source/render/decoders/webp.c ****                 return 0;
 494:Source/render/decoders/webp.c ****             }
 495:Source/render/decoders/webp.c ****             for (i = 0; i < numHtreeGroupsMax; i++) mapping[i] = -1;
 496:Source/render/decoders/webp.c ****             numHtreeGroups = 0;
