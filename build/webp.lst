1617:Source/render/decoders/webp.c **** static void vp8_parse_quant(Vp8Br* br, Vp8Dec* dec) {
1618:Source/render/decoders/webp.c ****     const Vp8SegmentHdr* hdr = &dec->segmentHdr;
1619:Source/render/decoders/webp.c ****     int baseQ0 = vp8_get_value(br, 7);
1620:Source/render/decoders/webp.c ****     int dqy1dc = (vp8_get_bit(br, 128) != 0) ? vp8_get_signed_value(br, 4) : 0;
1621:Source/render/decoders/webp.c ****     int dqy2dc = (vp8_get_bit(br, 128) != 0) ? vp8_get_signed_value(br, 4) : 0;
1622:Source/render/decoders/webp.c ****     int dqy2ac = (vp8_get_bit(br, 128) != 0) ? vp8_get_signed_value(br, 4) : 0;
1623:Source/render/decoders/webp.c ****     int dquvdc = (vp8_get_bit(br, 128) != 0) ? vp8_get_signed_value(br, 4) : 0;
1624:Source/render/decoders/webp.c ****     int dquvac = (vp8_get_bit(br, 128) != 0) ? vp8_get_signed_value(br, 4) : 0;
1625:Source/render/decoders/webp.c ****     int i;
1626:Source/render/decoders/webp.c ****     for (i = 0; i < 4; i++) {
1627:Source/render/decoders/webp.c ****         int q, t;
1628:Source/render/decoders/webp.c ****         if (hdr->useSegment == 0 && i > 0) {
1629:Source/render/decoders/webp.c ****             dec->dqm[i] = dec->dqm[0];
1630:Source/render/decoders/webp.c ****             continue;
1631:Source/render/decoders/webp.c ****         }
1632:Source/render/decoders/webp.c ****         if (hdr->useSegment != 0) {
1633:Source/render/decoders/webp.c ****             q = hdr->quantizer[i];
1634:Source/render/decoders/webp.c ****             if (hdr->absoluteDelta == 0) q += baseQ0;
1635:Source/render/decoders/webp.c ****         } else {
1636:Source/render/decoders/webp.c ****             q = baseQ0;
1637:Source/render/decoders/webp.c ****         }
1638:Source/render/decoders/webp.c ****         dec->dqm[i].y1[0] = kDcTable[vp8_clip_q(q + dqy1dc, 127)];
1639:Source/render/decoders/webp.c ****         dec->dqm[i].y1[1] = kAcTable[vp8_clip_q(q, 127)];
1640:Source/render/decoders/webp.c ****         dec->dqm[i].y2[0] = kDcTable[vp8_clip_q(q + dqy2dc, 127)] * 2;
1641:Source/render/decoders/webp.c ****         t = kAcTable[vp8_clip_q(q + dqy2ac, 127)];
1642:Source/render/decoders/webp.c ****         dec->dqm[i].y2[1] = (t * 101581) >> 16;
1643:Source/render/decoders/webp.c ****         if (dec->dqm[i].y2[1] < 8) dec->dqm[i].y2[1] = 8;
1644:Source/render/decoders/webp.c ****         dec->dqm[i].uv[0] = kDcTable[vp8_clip_q(q + dquvdc, 117)];
1645:Source/render/decoders/webp.c ****         dec->dqm[i].uv[1] = kAcTable[vp8_clip_q(q + dquvac, 127)];
1646:Source/render/decoders/webp.c ****     }
1647:Source/render/decoders/webp.c **** }
