 795:Source/render/decoders/webp.c **** static uint32_t select_p(uint32_t a, uint32_t b, uint32_t c) {
 796:Source/render/decoders/webp.c ****     int paMinusPb =
 797:Source/render/decoders/webp.c ****         sub3((int)(a >> 24), (int)(b >> 24), (int)(c >> 24)) +
 798:Source/render/decoders/webp.c ****         sub3((int)((a >> 16) & 0xFF), (int)((b >> 16) & 0xFF),
 799:Source/render/decoders/webp.c ****              (int)((c >> 16) & 0xFF)) +
 800:Source/render/decoders/webp.c ****         sub3((int)((a >> 8) & 0xFF), (int)((b >> 8) & 0xFF),
 801:Source/render/decoders/webp.c ****              (int)((c >> 8) & 0xFF)) +
 802:Source/render/decoders/webp.c ****         sub3((int)(a & 0xFF), (int)(b & 0xFF), (int)(c & 0xFF));
 803:Source/render/decoders/webp.c ****     if (paMinusPb <= 0) return a;
 804:Source/render/decoders/webp.c ****     return b;
 805:Source/render/decoders/webp.c **** }
