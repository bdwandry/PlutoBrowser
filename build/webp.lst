2375:Source/render/decoders/webp.c **** static void vp8_precompute_filter_strengths(Vp8Dec* dec) {
2376:Source/render/decoders/webp.c ****     const Vp8FilterHdr* hdr = &dec->filterHdr;
2377:Source/render/decoders/webp.c ****     const Vp8SegmentHdr* segHdr = &dec->segmentHdr;
2378:Source/render/decoders/webp.c ****     int s, i4x4;
2379:Source/render/decoders/webp.c ****     if (dec->filterType <= 0) return;
2380:Source/render/decoders/webp.c ****     for (s = 0; s < 4; s++) {
2381:Source/render/decoders/webp.c ****         int baseLevel;
2382:Source/render/decoders/webp.c ****         if (segHdr->useSegment != 0) {
2383:Source/render/decoders/webp.c ****             baseLevel = segHdr->filterStrength[s];
2384:Source/render/decoders/webp.c ****             if (segHdr->absoluteDelta == 0) baseLevel += hdr->level;
2385:Source/render/decoders/webp.c ****         } else {
2386:Source/render/decoders/webp.c ****             baseLevel = hdr->level;
2387:Source/render/decoders/webp.c ****         }
2388:Source/render/decoders/webp.c ****         for (i4x4 = 0; i4x4 <= 1; i4x4++) {
2389:Source/render/decoders/webp.c ****             Vp8FStrength* fs = &dec->fstrengths[s][i4x4];
2390:Source/render/decoders/webp.c ****             int level = baseLevel;
2391:Source/render/decoders/webp.c ****             if (hdr->useLfDelta != 0) {
2392:Source/render/decoders/webp.c ****                 level += hdr->refLfDelta[0];
2393:Source/render/decoders/webp.c ****                 if (i4x4 == 1) level += hdr->modeLfDelta[0];
2394:Source/render/decoders/webp.c ****             }
2395:Source/render/decoders/webp.c ****             if (level < 0) level = 0;
2396:Source/render/decoders/webp.c ****             if (level > 63) level = 63;
2397:Source/render/decoders/webp.c ****             fs->fLimit = 0;
2398:Source/render/decoders/webp.c ****             fs->fIlevel = 0;
2399:Source/render/decoders/webp.c ****             fs->fInner = i4x4;
2400:Source/render/decoders/webp.c ****             fs->hevThresh = 0;
2401:Source/render/decoders/webp.c ****             if (level > 0) {
2402:Source/render/decoders/webp.c ****                 int ilevel = level;
2403:Source/render/decoders/webp.c ****                 if (hdr->sharpness > 0) {
2404:Source/render/decoders/webp.c ****                     ilevel >>= (hdr->sharpness > 4) ? 2 : 1;
2405:Source/render/decoders/webp.c ****                     if (ilevel > 9 - hdr->sharpness)
2406:Source/render/decoders/webp.c ****                         ilevel = 9 - hdr->sharpness;
2407:Source/render/decoders/webp.c ****                 }
2408:Source/render/decoders/webp.c ****                 if (ilevel < 1) ilevel = 1;
2409:Source/render/decoders/webp.c ****                 fs->fIlevel = ilevel;
2410:Source/render/decoders/webp.c ****                 fs->fLimit = 2 * level + ilevel;
2411:Source/render/decoders/webp.c ****                 if (level >= 40)
2412:Source/render/decoders/webp.c ****                     fs->hevThresh = 2;
2413:Source/render/decoders/webp.c ****                 else if (level >= 15)
2414:Source/render/decoders/webp.c ****                     fs->hevThresh = 1;
2415:Source/render/decoders/webp.c ****             }
2416:Source/render/decoders/webp.c ****         }
2417:Source/render/decoders/webp.c ****     }
2418:Source/render/decoders/webp.c **** }
