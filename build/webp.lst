 593:src/render/decoders/webp.c **** static int get_copy_distance(int distanceSymbol, Br* br) {
 594:src/render/decoders/webp.c ****     int extraBits, offset;
 595:src/render/decoders/webp.c ****     if (distanceSymbol < 4) return distanceSymbol + 1;
 596:src/render/decoders/webp.c ****     extraBits = (distanceSymbol - 2) >> 1;
 597:src/render/decoders/webp.c ****     offset = (2 + (distanceSymbol & 1)) << extraBits;
 598:src/render/decoders/webp.c ****     return offset + br_read_bits(br, extraBits) + 1;
 599:src/render/decoders/webp.c **** }
 600:src/render/decoders/webp.c **** 
 601:src/render/decoders/webp.c **** static int plane_code_to_distance(int xsize, int planeCode) {
 602:src/render/decoders/webp.c ****     int distCode, yoffset, xoffset, dist;
 603:src/render/decoders/webp.c ****     if (planeCode > CODE_TO_PLANE_CODES) return planeCode - CODE_TO_PLANE_CODES;
 604:src/render/decoders/webp.c ****     distCode = kCodeToPlane[planeCode - 1];
 605:src/render/decoders/webp.c ****     yoffset = distCode >> 4;
 606:src/render/decoders/webp.c ****     xoffset = 8 - (distCode & 0xF);
 607:src/render/decoders/webp.c ****     dist = yoffset * xsize + xoffset;
 608:src/render/decoders/webp.c ****     if (dist < 1) return 1;
 609:src/render/decoders/webp.c ****     return dist;
 610:src/render/decoders/webp.c **** }
 611:src/render/decoders/webp.c **** 
