1167:src/render/decoders/webp.c **** static uint32_t* apply_inverse_transforms(VP8LCtx* ctx, uint32_t* data,
1168:src/render/decoders/webp.c ****                                           int rows) {
1169:src/render/decoders/webp.c ****     uint32_t* in_ = data;
