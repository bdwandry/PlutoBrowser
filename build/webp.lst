 833:Source/render/decoders/webp.c **** /* Predictor modes 0..13; args are (left, top, top1, topm1). */
 834:Source/render/decoders/webp.c **** static uint32_t predictor_value(int mode, uint32_t left, uint32_t top,
 835:Source/render/decoders/webp.c ****                                 uint32_t top1, uint32_t topm1) {
 836:Source/render/decoders/webp.c ****     switch (mode) {
 837:Source/render/decoders/webp.c ****         case 0:  return ARGB_BLACK;
 838:Source/render/decoders/webp.c ****         case 1:  return left;
 839:Source/render/decoders/webp.c ****         case 2:  return top;
 840:Source/render/decoders/webp.c ****         case 3:  return top1;
 841:Source/render/decoders/webp.c ****         case 4:  return topm1;
 842:Source/render/decoders/webp.c ****         case 5:  return average3(left, top, top1);
 843:Source/render/decoders/webp.c ****         case 6:  return average2(left, topm1);
 844:Source/render/decoders/webp.c ****         case 7:  return average2(left, top);
 845:Source/render/decoders/webp.c ****         case 8:  return average2(topm1, top);
 846:Source/render/decoders/webp.c ****         case 9:  return average2(top, top1);
 847:Source/render/decoders/webp.c ****         case 10: return average4(left, topm1, top, top1);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 26


 848:Source/render/decoders/webp.c ****         case 11: return select_p(top, left, topm1);
 849:Source/render/decoders/webp.c ****         case 12: return clamped_add_subtract_full(left, top, topm1);
 850:Source/render/decoders/webp.c ****         default: return clamped_add_subtract_half(left, top, topm1);
 851:Source/render/decoders/webp.c ****     }
 852:Source/render/decoders/webp.c **** }
 853:Source/render/decoders/webp.c **** 
 854:Source/render/decoders/webp.c **** static void predictor_add(int mode, const uint32_t* in, int iIn,
 855:Source/render/decoders/webp.c ****                           uint32_t* out, int oOut, int x, int count,
 856:Source/render/decoders/webp.c ****                           int width) {
 857:Source/render/decoders/webp.c ****     int i;
 858:Source/render/decoders/webp.c ****     int baseIn = iIn + x;
 859:Source/render/decoders/webp.c ****     int baseOut = oOut + x;
 860:Source/render/decoders/webp.c ****     for (i = 0; i < count; i++) {
 861:Source/render/decoders/webp.c ****         int px = baseOut + i;
 862:Source/render/decoders/webp.c ****         uint32_t pred = predictor_value(mode, out[px - 1], out[px - width],
 863:Source/render/decoders/webp.c ****                                         out[px - width + 1],
 864:Source/render/decoders/webp.c ****                                         out[px - width - 1]);
 865:Source/render/decoders/webp.c ****         out[px] = add_pixels(in[baseIn + i], pred);
 866:Source/render/decoders/webp.c ****     }
 867:Source/render/decoders/webp.c **** }
