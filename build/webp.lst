 142:Source/render/decoders/webp.c **** 
 143:Source/render/decoders/webp.c **** static void replicate_value(uint32_t* table, int base, int step, int end,
 144:Source/render/decoders/webp.c ****                             uint32_t code) {
 145:Source/render/decoders/webp.c ****     int i;
 146:Source/render/decoders/webp.c ****     for (i = end - step; i >= 0; i -= step) table[base + i] = code;
 147:Source/render/decoders/webp.c **** }
 148:Source/render/decoders/webp.c **** 
 149:Source/render/decoders/webp.c **** static int get_next_key(int key, int len) {
 150:Source/render/decoders/webp.c ****     int step = 1 << (len - 1);
 151:Source/render/decoders/webp.c ****     while ((key & step) != 0) step >>= 1;
 152:Source/render/decoders/webp.c ****     if (step == 0) return key;
 153:Source/render/decoders/webp.c ****     return (key & (step - 1)) + step;
 154:Source/render/decoders/webp.c **** }
 155:Source/render/decoders/webp.c **** 
 156:Source/render/decoders/webp.c **** static int next_table_bit_size(const int* count, int len, int rootBits) {
 157:Source/render/decoders/webp.c ****     int left = 1 << (len - rootBits);
 158:Source/render/decoders/webp.c ****     while (len < MAX_ALLOWED_CODE_LENGTH) {
 159:Source/render/decoders/webp.c ****         left -= count[len];
 160:Source/render/decoders/webp.c ****         if (left <= 0) break;
 161:Source/render/decoders/webp.c ****         len++;
 162:Source/render/decoders/webp.c ****         left <<= 1;
 163:Source/render/decoders/webp.c ****     }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 14


 164:Source/render/decoders/webp.c ****     return len - rootBits;
 165:Source/render/decoders/webp.c **** }
