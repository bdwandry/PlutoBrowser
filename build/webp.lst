 167:Source/render/decoders/webp.c **** /* Returns a malloc'd flat lookup table, NULL on invalid code lengths. */
 168:Source/render/decoders/webp.c **** static uint32_t* build_huffman_table(const uint8_t* codeLengths,
 169:Source/render/decoders/webp.c ****                                      int codeLengthsSize, int rootBits) {
 170:Source/render/decoders/webp.c ****     int totalSize = 1 << rootBits;
 171:Source/render/decoders/webp.c ****     int cap = totalSize;
 172:Source/render/decoders/webp.c ****     uint32_t* table;
 173:Source/render/decoders/webp.c ****     int count[MAX_ALLOWED_CODE_LENGTH + 1];
 174:Source/render/decoders/webp.c ****     int offset[MAX_ALLOWED_CODE_LENGTH + 1];
 175:Source/render/decoders/webp.c ****     int* sorted;
 176:Source/render/decoders/webp.c ****     int len, symbol;
 177:Source/render/decoders/webp.c ****     long long low = 0xFFFFFFFFLL;
 178:Source/render/decoders/webp.c ****     uint32_t mask;
 179:Source/render/decoders/webp.c ****     int key = 0, numNodes = 1, numOpen = 1;
 180:Source/render/decoders/webp.c ****     int sortedPos = 0;
 181:Source/render/decoders/webp.c ****     int tableBits = rootBits, tableSize = 1 << tableBits;
 182:Source/render/decoders/webp.c ****     int tablePos = 0;
 183:Source/render/decoders/webp.c **** 
 184:Source/render/decoders/webp.c ****     memset(count, 0, sizeof(count));
 185:Source/render/decoders/webp.c ****     memset(offset, 0, sizeof(offset));
 186:Source/render/decoders/webp.c ****     for (symbol = 0; symbol < codeLengthsSize; symbol++) {
 187:Source/render/decoders/webp.c ****         int cl = codeLengths[symbol];
 188:Source/render/decoders/webp.c ****         if (cl > MAX_ALLOWED_CODE_LENGTH) return NULL;
 189:Source/render/decoders/webp.c ****         count[cl]++;
 190:Source/render/decoders/webp.c ****     }
 191:Source/render/decoders/webp.c ****     if (count[0] == codeLengthsSize) return NULL;
 192:Source/render/decoders/webp.c **** 
 193:Source/render/decoders/webp.c ****     offset[1] = 0;
 194:Source/render/decoders/webp.c ****     for (len = 1; len < MAX_ALLOWED_CODE_LENGTH; len++) {
 195:Source/render/decoders/webp.c ****         if (count[len] > (1 << len)) return NULL;
 196:Source/render/decoders/webp.c ****         offset[len + 1] = offset[len] + count[len];
 197:Source/render/decoders/webp.c ****     }
 198:Source/render/decoders/webp.c **** 
 199:Source/render/decoders/webp.c ****     sorted = (int*)pluto_malloc(
 200:Source/render/decoders/webp.c ****         sizeof(int) * (size_t)(codeLengthsSize > 0 ? codeLengthsSize : 1));
 201:Source/render/decoders/webp.c ****     if (!sorted) return NULL;
 202:Source/render/decoders/webp.c ****     for (symbol = 0; symbol < codeLengthsSize; symbol++) {
 203:Source/render/decoders/webp.c ****         int cl = codeLengths[symbol];
 204:Source/render/decoders/webp.c ****         if (cl > 0) {
 205:Source/render/decoders/webp.c ****             if (offset[cl] >= codeLengthsSize) {
 206:Source/render/decoders/webp.c ****                 pluto_free(sorted);
 207:Source/render/decoders/webp.c ****                 return NULL;
 208:Source/render/decoders/webp.c ****             }
 209:Source/render/decoders/webp.c ****             sorted[offset[cl]] = symbol;
 210:Source/render/decoders/webp.c ****             offset[cl]++;
 211:Source/render/decoders/webp.c ****         }
 212:Source/render/decoders/webp.c ****     }
 213:Source/render/decoders/webp.c **** 
 214:Source/render/decoders/webp.c ****     if (offset[MAX_ALLOWED_CODE_LENGTH] == 1) {
 215:Source/render/decoders/webp.c ****         /* Single-symbol tree: value repeats, no bits consumed. */
 216:Source/render/decoders/webp.c ****         table = (uint32_t*)pluto_malloc(sizeof(uint32_t) * (size_t)totalSize);
 217:Source/render/decoders/webp.c ****         if (!table) {
 218:Source/render/decoders/webp.c ****             pluto_free(sorted);
 219:Source/render/decoders/webp.c ****             return NULL;
 220:Source/render/decoders/webp.c ****         }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 15


 221:Source/render/decoders/webp.c ****         replicate_value(table, 0, 1, totalSize, (uint32_t)sorted[0]);
 222:Source/render/decoders/webp.c ****         pluto_free(sorted);
 223:Source/render/decoders/webp.c ****         return table;
 224:Source/render/decoders/webp.c ****     }
 225:Source/render/decoders/webp.c **** 
 226:Source/render/decoders/webp.c ****     table = (uint32_t*)pluto_malloc(sizeof(uint32_t) * (size_t)cap);
 227:Source/render/decoders/webp.c ****     if (!table) {
 228:Source/render/decoders/webp.c ****         pluto_free(sorted);
 229:Source/render/decoders/webp.c ****         return NULL;
 230:Source/render/decoders/webp.c ****     }
 231:Source/render/decoders/webp.c ****     mask = (uint32_t)totalSize - 1;
 232:Source/render/decoders/webp.c **** 
 233:Source/render/decoders/webp.c ****     /* Root table. */
 234:Source/render/decoders/webp.c ****     for (len = 1; len <= rootBits; len++) {
 235:Source/render/decoders/webp.c ****         int step = 2 << (len - 1);
 236:Source/render/decoders/webp.c ****         numOpen <<= 1;
 237:Source/render/decoders/webp.c ****         numNodes += numOpen;
 238:Source/render/decoders/webp.c ****         numOpen -= count[len];
 239:Source/render/decoders/webp.c ****         if (numOpen < 0) goto fail;
 240:Source/render/decoders/webp.c ****         while (count[len] > 0) {
 241:Source/render/decoders/webp.c ****             uint32_t code =
 242:Source/render/decoders/webp.c ****                 ((uint32_t)len << 16) | (uint32_t)sorted[sortedPos++];
 243:Source/render/decoders/webp.c ****             count[len]--;
 244:Source/render/decoders/webp.c ****             replicate_value(table, key, step, tableSize, code);
 245:Source/render/decoders/webp.c ****             key = get_next_key(key, len);
 246:Source/render/decoders/webp.c ****         }
 247:Source/render/decoders/webp.c ****     }
 248:Source/render/decoders/webp.c **** 
 249:Source/render/decoders/webp.c ****     /* Second-level tables + pointers stored in the root table. */
 250:Source/render/decoders/webp.c ****     for (len = rootBits + 1; len <= MAX_ALLOWED_CODE_LENGTH; len++) {
 251:Source/render/decoders/webp.c ****         int step = 2 << (len - rootBits - 1);
 252:Source/render/decoders/webp.c ****         numOpen <<= 1;
 253:Source/render/decoders/webp.c ****         numNodes += numOpen;
 254:Source/render/decoders/webp.c ****         numOpen -= count[len];
 255:Source/render/decoders/webp.c ****         if (numOpen < 0) goto fail;
 256:Source/render/decoders/webp.c ****         while (count[len] > 0) {
 257:Source/render/decoders/webp.c ****             uint32_t* grown;
 258:Source/render/decoders/webp.c ****             count[len]--;
 259:Source/render/decoders/webp.c ****             if ((key & (int)mask) != (int)low) {
 260:Source/render/decoders/webp.c ****                 tablePos += tableSize;
 261:Source/render/decoders/webp.c ****                 tableBits = next_table_bit_size(count, len, rootBits);
 262:Source/render/decoders/webp.c ****                 tableSize = 1 << tableBits;
 263:Source/render/decoders/webp.c ****                 totalSize += tableSize;
 264:Source/render/decoders/webp.c ****                 low = key & (int)mask;
 265:Source/render/decoders/webp.c ****                 if (totalSize > cap) {
 266:Source/render/decoders/webp.c ****                     grown = (uint32_t*)pluto_realloc(
 267:Source/render/decoders/webp.c ****                         table, sizeof(uint32_t) * (size_t)totalSize);
 268:Source/render/decoders/webp.c ****                     if (!grown) goto fail;
 269:Source/render/decoders/webp.c ****                     table = grown;
 270:Source/render/decoders/webp.c ****                     cap = totalSize;
 271:Source/render/decoders/webp.c ****                 }
 272:Source/render/decoders/webp.c ****                 table[low] = ((uint32_t)(tableBits + rootBits) << 16) |
 273:Source/render/decoders/webp.c ****                              (uint32_t)(tablePos - low);
 274:Source/render/decoders/webp.c ****             }
 275:Source/render/decoders/webp.c ****             replicate_value(table, tablePos + (key >> rootBits), step,
 276:Source/render/decoders/webp.c ****                             tableSize,
 277:Source/render/decoders/webp.c ****                             ((uint32_t)(len - rootBits) << 16) |
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 16


 278:Source/render/decoders/webp.c ****                                 (uint32_t)sorted[sortedPos++]);
 279:Source/render/decoders/webp.c ****             key = get_next_key(key, len);
 280:Source/render/decoders/webp.c ****         }
 281:Source/render/decoders/webp.c ****     }
 282:Source/render/decoders/webp.c **** 
 283:Source/render/decoders/webp.c ****     if (numNodes != 2 * offset[MAX_ALLOWED_CODE_LENGTH] - 1) goto fail;
 284:Source/render/decoders/webp.c ****     pluto_free(sorted);
 285:Source/render/decoders/webp.c ****     return table;
 286:Source/render/decoders/webp.c **** 
 287:Source/render/decoders/webp.c **** fail:
 288:Source/render/decoders/webp.c ****     pluto_free(sorted);
 289:Source/render/decoders/webp.c ****     pluto_free(table);
 290:Source/render/decoders/webp.c ****     return NULL;
 291:Source/render/decoders/webp.c **** }
