 621:Source/render/decoders/webp.c **** static ColorCache* new_color_cache(int bits) {
 622:Source/render/decoders/webp.c ****     ColorCache* cc = (ColorCache*)pluto_malloc(sizeof(ColorCache));
 623:Source/render/decoders/webp.c ****     if (!cc) return NULL;
 624:Source/render/decoders/webp.c ****     cc->colors = (uint32_t*)pluto_calloc((size_t)1 << bits, sizeof(uint32_t));
 625:Source/render/decoders/webp.c ****     if (!cc->colors) {
 626:Source/render/decoders/webp.c ****         pluto_free(cc);
 627:Source/render/decoders/webp.c ****         return NULL;
 628:Source/render/decoders/webp.c ****     }
 629:Source/render/decoders/webp.c ****     cc->hashShift = 32 - bits;
 630:Source/render/decoders/webp.c ****     return cc;
 631:Source/render/decoders/webp.c **** }
 632:Source/render/decoders/webp.c **** 
 633:Source/render/decoders/webp.c **** static void free_color_cache(ColorCache* cc) {
 634:Source/render/decoders/webp.c ****     if (!cc) return;
 635:Source/render/decoders/webp.c ****     pluto_free(cc->colors);
 636:Source/render/decoders/webp.c ****     pluto_free(cc);
 637:Source/render/decoders/webp.c **** }
