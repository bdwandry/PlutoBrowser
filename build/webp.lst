2147:Source/render/decoders/webp.c ****         case 2: vp8_ve4(buf, dst); break;
2148:Source/render/decoders/webp.c ****         case 3: vp8_he4(buf, dst); break;
2149:Source/render/decoders/webp.c ****         case 4: vp8_rd4(buf, dst); break;
2150:Source/render/decoders/webp.c ****         case 5: vp8_vr4(buf, dst); break;
2151:Source/render/decoders/webp.c ****         case 6: vp8_ld4(buf, dst); break;
2152:Source/render/decoders/webp.c ****         case 7: vp8_vl4(buf, dst); break;
2153:Source/render/decoders/webp.c ****         case 8: vp8_hd4(buf, dst); break;
2154:Source/render/decoders/webp.c ****         default: vp8_hu4(buf, dst); break;
2155:Source/render/decoders/webp.c ****     }
