 137:src/render/decoders/webp.c **** /* Huffman table construction (BuildHuffmanTable from huffman_utils.c) */
 138:src/render/decoders/webp.c **** 
 139:src/render/decoders/webp.c **** static void replicate_value(uint32_t* table, int base, int step, int end,
 140:src/render/decoders/webp.c ****                             uint32_t code) {
 141:src/render/decoders/webp.c ****     int i;
 142:src/render/decoders/webp.c ****     for (i = end - step; i >= 0; i -= step) table[base + i] = code;
 143:src/render/decoders/webp.c **** }
 144:src/render/decoders/webp.c **** 
 145:src/render/decoders/webp.c **** static int get_next_key(int key, int len) {
 146:src/render/decoders/webp.c ****     int step = 1 << (len - 1);
 147:src/render/decoders/webp.c ****     while ((key & step) != 0) step >>= 1;
 148:src/render/decoders/webp.c ****     if (step == 0) return key;
 149:src/render/decoders/webp.c ****     return (key & (step - 1)) + step;
 150:src/render/decoders/webp.c **** }
 151:src/render/decoders/webp.c **** 
 152:src/render/decoders/webp.c **** static int next_table_bit_size(const int* count, int len, int rootBits) {
 153:src/render/decoders/webp.c ****     int left = 1 << (len - rootBits);
 154:src/render/decoders/webp.c ****     while (len < MAX_ALLOWED_CODE_LENGTH) {
 155:src/render/decoders/webp.c ****         left -= count[len];
 156:src/render/decoders/webp.c ****         if (left <= 0) break;
 157:src/render/decoders/webp.c ****         len++;
 158:src/render/decoders/webp.c ****         left <<= 1;
 159:src/render/decoders/webp.c ****     }
 160:src/render/decoders/webp.c ****     return len - rootBits;
 161:src/render/decoders/webp.c **** }
 162:src/render/decoders/webp.c **** 
 163:src/render/decoders/webp.c **** /* Returns a malloc'd flat lookup table, NULL on invalid code lengths. */
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccQjXwFz.s 			page 14


 164:src/render/decoders/webp.c **** static uint32_t* build_huffman_table(const uint8_t* codeLengths,
 165:src/render/decoders/webp.c ****                                      int codeLengthsSize, int rootBits) {
 166:src/render/decoders/webp.c ****     int totalSize = 1 << rootBits;
 167:src/render/decoders/webp.c ****     int cap = totalSize;
 168:src/render/decoders/webp.c ****     uint32_t* table;
 169:src/render/decoders/webp.c ****     int count[MAX_ALLOWED_CODE_LENGTH + 1];
 170:src/render/decoders/webp.c ****     int offset[MAX_ALLOWED_CODE_LENGTH + 1];
 171:src/render/decoders/webp.c ****     int* sorted;
 172:src/render/decoders/webp.c ****     int len, symbol;
 173:src/render/decoders/webp.c ****     long long low = 0xFFFFFFFFLL;
 174:src/render/decoders/webp.c ****     uint32_t mask;
 175:src/render/decoders/webp.c ****     int key = 0, numNodes = 1, numOpen = 1;
 176:src/render/decoders/webp.c ****     int sortedPos = 0;
 177:src/render/decoders/webp.c ****     int tableBits = rootBits, tableSize = 1 << tableBits;
 178:src/render/decoders/webp.c ****     int tablePos = 0;
 179:src/render/decoders/webp.c **** 
 180:src/render/decoders/webp.c ****     memset(count, 0, sizeof(count));
 181:src/render/decoders/webp.c ****     memset(offset, 0, sizeof(offset));
 182:src/render/decoders/webp.c ****     for (symbol = 0; symbol < codeLengthsSize; symbol++) {
 183:src/render/decoders/webp.c ****         int cl = codeLengths[symbol];
 184:src/render/decoders/webp.c ****         if (cl > MAX_ALLOWED_CODE_LENGTH) return NULL;
 185:src/render/decoders/webp.c ****         count[cl]++;
 186:src/render/decoders/webp.c ****     }
 187:src/render/decoders/webp.c ****     if (count[0] == codeLengthsSize) return NULL;
 188:src/render/decoders/webp.c **** 
 189:src/render/decoders/webp.c ****     offset[1] = 0;
 190:src/render/decoders/webp.c ****     for (len = 1; len < MAX_ALLOWED_CODE_LENGTH; len++) {
 191:src/render/decoders/webp.c ****         if (count[len] > (1 << len)) return NULL;
 192:src/render/decoders/webp.c ****         offset[len + 1] = offset[len] + count[len];
 193:src/render/decoders/webp.c ****     }
 194:src/render/decoders/webp.c **** 
 195:src/render/decoders/webp.c ****     sorted = (int*)pluto_malloc(
 196:src/render/decoders/webp.c ****         sizeof(int) * (size_t)(codeLengthsSize > 0 ? codeLengthsSize : 1));
 197:src/render/decoders/webp.c ****     if (!sorted) return NULL;
 198:src/render/decoders/webp.c ****     for (symbol = 0; symbol < codeLengthsSize; symbol++) {
 199:src/render/decoders/webp.c ****         int cl = codeLengths[symbol];
 200:src/render/decoders/webp.c ****         if (cl > 0) {
 201:src/render/decoders/webp.c ****             if (offset[cl] >= codeLengthsSize) {
 202:src/render/decoders/webp.c ****                 pluto_free(sorted);
 203:src/render/decoders/webp.c ****                 return NULL;
 204:src/render/decoders/webp.c ****             }
 205:src/render/decoders/webp.c ****             sorted[offset[cl]] = symbol;
 206:src/render/decoders/webp.c ****             offset[cl]++;
 207:src/render/decoders/webp.c ****         }
 208:src/render/decoders/webp.c ****     }
 209:src/render/decoders/webp.c **** 
 210:src/render/decoders/webp.c ****     if (offset[MAX_ALLOWED_CODE_LENGTH] == 1) {
 211:src/render/decoders/webp.c ****         /* Single-symbol tree: value repeats, no bits consumed. */
 212:src/render/decoders/webp.c ****         table = (uint32_t*)pluto_malloc(sizeof(uint32_t) * (size_t)totalSize);
 213:src/render/decoders/webp.c ****         if (!table) {
 214:src/render/decoders/webp.c ****             pluto_free(sorted);
 215:src/render/decoders/webp.c ****             return NULL;
 216:src/render/decoders/webp.c ****         }
 217:src/render/decoders/webp.c ****         replicate_value(table, 0, 1, totalSize, (uint32_t)sorted[0]);
 218:src/render/decoders/webp.c ****         pluto_free(sorted);
 219:src/render/decoders/webp.c ****         return table;
 220:src/render/decoders/webp.c ****     }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccQjXwFz.s 			page 15


 221:src/render/decoders/webp.c **** 
 222:src/render/decoders/webp.c ****     table = (uint32_t*)pluto_malloc(sizeof(uint32_t) * (size_t)cap);
 223:src/render/decoders/webp.c ****     if (!table) {
 224:src/render/decoders/webp.c ****         pluto_free(sorted);
 225:src/render/decoders/webp.c ****         return NULL;
 226:src/render/decoders/webp.c ****     }
 227:src/render/decoders/webp.c ****     mask = (uint32_t)totalSize - 1;
 228:src/render/decoders/webp.c **** 
 229:src/render/decoders/webp.c ****     /* Root table. */
 230:src/render/decoders/webp.c ****     for (len = 1; len <= rootBits; len++) {
 231:src/render/decoders/webp.c ****         int step = 2 << (len - 1);
 232:src/render/decoders/webp.c ****         numOpen <<= 1;
 233:src/render/decoders/webp.c ****         numNodes += numOpen;
 234:src/render/decoders/webp.c ****         numOpen -= count[len];
 235:src/render/decoders/webp.c ****         if (numOpen < 0) goto fail;
 236:src/render/decoders/webp.c ****         while (count[len] > 0) {
 237:src/render/decoders/webp.c ****             uint32_t code =
 238:src/render/decoders/webp.c ****                 ((uint32_t)len << 16) | (uint32_t)sorted[sortedPos++];
 239:src/render/decoders/webp.c ****             count[len]--;
 240:src/render/decoders/webp.c ****             replicate_value(table, key, step, tableSize, code);
 241:src/render/decoders/webp.c ****             key = get_next_key(key, len);
 242:src/render/decoders/webp.c ****         }
 243:src/render/decoders/webp.c ****     }
 244:src/render/decoders/webp.c **** 
 245:src/render/decoders/webp.c ****     /* Second-level tables + pointers stored in the root table. */
 246:src/render/decoders/webp.c ****     for (len = rootBits + 1; len <= MAX_ALLOWED_CODE_LENGTH; len++) {
 247:src/render/decoders/webp.c ****         int step = 2 << (len - rootBits - 1);
 248:src/render/decoders/webp.c ****         numOpen <<= 1;
 249:src/render/decoders/webp.c ****         numNodes += numOpen;
 250:src/render/decoders/webp.c ****         numOpen -= count[len];
 251:src/render/decoders/webp.c ****         if (numOpen < 0) goto fail;
 252:src/render/decoders/webp.c ****         while (count[len] > 0) {
 253:src/render/decoders/webp.c ****             uint32_t* grown;
 254:src/render/decoders/webp.c ****             count[len]--;
 255:src/render/decoders/webp.c ****             if ((key & (int)mask) != (int)low) {
 256:src/render/decoders/webp.c ****                 tablePos += tableSize;
 257:src/render/decoders/webp.c ****                 tableBits = next_table_bit_size(count, len, rootBits);
 258:src/render/decoders/webp.c ****                 tableSize = 1 << tableBits;
 259:src/render/decoders/webp.c ****                 totalSize += tableSize;
 260:src/render/decoders/webp.c ****                 low = key & (int)mask;
 261:src/render/decoders/webp.c ****                 if (totalSize > cap) {
 262:src/render/decoders/webp.c ****                     grown = (uint32_t*)pluto_realloc(
 263:src/render/decoders/webp.c ****                         table, sizeof(uint32_t) * (size_t)totalSize);
 264:src/render/decoders/webp.c ****                     if (!grown) goto fail;
 265:src/render/decoders/webp.c ****                     table = grown;
 266:src/render/decoders/webp.c ****                     cap = totalSize;
 267:src/render/decoders/webp.c ****                 }
 268:src/render/decoders/webp.c ****                 table[low] = ((uint32_t)(tableBits + rootBits) << 16) |
 269:src/render/decoders/webp.c ****                              (uint32_t)(tablePos - low);
 270:src/render/decoders/webp.c ****             }
 271:src/render/decoders/webp.c ****             replicate_value(table, tablePos + (key >> rootBits), step,
 272:src/render/decoders/webp.c ****                             tableSize,
 273:src/render/decoders/webp.c ****                             ((uint32_t)(len - rootBits) << 16) |
 274:src/render/decoders/webp.c ****                                 (uint32_t)sorted[sortedPos++]);
 275:src/render/decoders/webp.c ****             key = get_next_key(key, len);
 276:src/render/decoders/webp.c ****         }
 277:src/render/decoders/webp.c ****     }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccQjXwFz.s 			page 16


 278:src/render/decoders/webp.c **** 
 279:src/render/decoders/webp.c ****     if (numNodes != 2 * offset[MAX_ALLOWED_CODE_LENGTH] - 1) goto fail;
 280:src/render/decoders/webp.c ****     pluto_free(sorted);
 281:src/render/decoders/webp.c ****     return table;
 282:src/render/decoders/webp.c **** 
 283:src/render/decoders/webp.c **** fail:
 284:src/render/decoders/webp.c ****     pluto_free(sorted);
 285:src/render/decoders/webp.c ****     pluto_free(table);
 286:src/render/decoders/webp.c ****     return NULL;
 287:src/render/decoders/webp.c **** }
