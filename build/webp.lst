 596:Source/render/decoders/webp.c **** 
 597:Source/render/decoders/webp.c **** static int get_copy_distance(int distanceSymbol, Br* br) {
 598:Source/render/decoders/webp.c ****     int extraBits, offset;
 599:Source/render/decoders/webp.c ****     if (distanceSymbol < 4) return distanceSymbol + 1;
 600:Source/render/decoders/webp.c ****     extraBits = (distanceSymbol - 2) >> 1;
 601:Source/render/decoders/webp.c ****     offset = (2 + (distanceSymbol & 1)) << extraBits;
 602:Source/render/decoders/webp.c ****     return offset + br_read_bits(br, extraBits) + 1;
 603:Source/render/decoders/webp.c **** }
 604:Source/render/decoders/webp.c **** 
 605:Source/render/decoders/webp.c **** static int plane_code_to_distance(int xsize, int planeCode) {
 606:Source/render/decoders/webp.c ****     int distCode, yoffset, xoffset, dist;
 607:Source/render/decoders/webp.c ****     if (planeCode > CODE_TO_PLANE_CODES) return planeCode - CODE_TO_PLANE_CODES;
 608:Source/render/decoders/webp.c ****     distCode = kCodeToPlane[planeCode - 1];
 609:Source/render/decoders/webp.c ****     yoffset = distCode >> 4;
 610:Source/render/decoders/webp.c ****     xoffset = 8 - (distCode & 0xF);
 611:Source/render/decoders/webp.c ****     dist = yoffset * xsize + xoffset;
 612:Source/render/decoders/webp.c ****     if (dist < 1) return 1;
 613:Source/render/decoders/webp.c ****     return dist;
 614:Source/render/decoders/webp.c **** }
