2647:Source/render/decoders/webp.c ****             for (i = 0; i < 4; i++) {
2648:Source/render/decoders/webp.c ****                 dec->intraT[topBase + i] = ymode;
2649:Source/render/decoders/webp.c ****                 dec->intraL[i] = ymode;
