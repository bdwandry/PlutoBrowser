3648:Source/render/decoders/webp.c **** 
3649:Source/render/decoders/webp.c **** /* Locates the primary image chunk of a simple or extended WebP file
3650:Source/render/decoders/webp.c ****  * plus an optional sibling ALPH chunk. Animation chunks (ANIM/ANMF)
3651:Source/render/decoders/webp.c ****  * are skipped: animated decoding goes through webp_decode_anim(). */
3652:Source/render/decoders/webp.c **** static int parse_webp(const uint8_t* data, size_t len,
3653:Source/render/decoders/webp.c ****                       const uint8_t** outPayload, size_t* outLen,
3654:Source/render/decoders/webp.c ****                       const uint8_t** outAlpha, size_t* outAlphaLen,
3655:Source/render/decoders/webp.c ****                       int* outKind) {
3656:Source/render/decoders/webp.c ****     size_t pos;
3657:Source/render/decoders/webp.c ****     if (len < 20) return 0;
3658:Source/render/decoders/webp.c ****     if (memcmp(data, "RIFF", 4) != 0 || memcmp(data + 8, "WEBP", 4) != 0)
3659:Source/render/decoders/webp.c ****         return 0;
3660:Source/render/decoders/webp.c ****     *outPayload = NULL;
3661:Source/render/decoders/webp.c ****     *outLen = 0;
3662:Source/render/decoders/webp.c ****     *outAlpha = NULL;
3663:Source/render/decoders/webp.c ****     *outAlphaLen = 0;
3664:Source/render/decoders/webp.c ****     *outKind = WEBP_CHUNK_NONE;
3665:Source/render/decoders/webp.c ****     pos = 12;
3666:Source/render/decoders/webp.c ****     while (pos + 8 <= len) {
3667:Source/render/decoders/webp.c ****         uint32_t size = (uint32_t)data[pos + 4] |
3668:Source/render/decoders/webp.c ****                         ((uint32_t)data[pos + 5] << 8) |
3669:Source/render/decoders/webp.c ****                         ((uint32_t)data[pos + 6] << 16) |
3670:Source/render/decoders/webp.c ****                         ((uint32_t)data[pos + 7] << 24);
3671:Source/render/decoders/webp.c ****         size_t avail = len - (pos + 8);
3672:Source/render/decoders/webp.c ****         size_t clen = size < avail ? size : avail;
3673:Source/render/decoders/webp.c ****         if (memcmp(data + pos, "VP8L", 4) == 0 ||
3674:Source/render/decoders/webp.c ****             memcmp(data + pos, "VP8 ", 4) == 0) {
3675:Source/render/decoders/webp.c ****             if (*outPayload == NULL) {
3676:Source/render/decoders/webp.c ****                 *outKind = (data[pos + 3] == 'L') ? WEBP_CHUNK_VP8L
3677:Source/render/decoders/webp.c ****                                                   : WEBP_CHUNK_VP8;
3678:Source/render/decoders/webp.c ****                 *outPayload = data + pos + 8;
3679:Source/render/decoders/webp.c ****                 *outLen = clen;
3680:Source/render/decoders/webp.c ****             }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 297


3681:Source/render/decoders/webp.c ****         } else if (memcmp(data + pos, "ALPH", 4) == 0 &&
3682:Source/render/decoders/webp.c ****                    *outAlpha == NULL) {
3683:Source/render/decoders/webp.c ****             *outAlpha = data + pos + 8;
3684:Source/render/decoders/webp.c ****             *outAlphaLen = clen;
3685:Source/render/decoders/webp.c ****         }
3686:Source/render/decoders/webp.c ****         pos += 8 + size + (size & 1);
3687:Source/render/decoders/webp.c ****     }
3688:Source/render/decoders/webp.c ****     return (*outPayload != NULL) ? 1 : 0;
3689:Source/render/decoders/webp.c **** }
