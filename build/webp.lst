   1:Source/render/decoders/webp.c **** // webp.c — C port of Source/render/decoders/webp.lua.
   2:Source/render/decoders/webp.c **** //
   3:Source/render/decoders/webp.c **** // Parses the RIFF container and decodes VP8L (lossless), VP8 (lossy)
   4:Source/render/decoders/webp.c **** // and animated payloads into a full-resolution ARGB grid (0xAARRGGBB).
   5:Source/render/decoders/webp.c **** // Lossless: little-endian bit reader, two-level Huffman tables (rootBits
   6:Source/render/decoders/webp.c **** // 8, code-length table 7), meta Huffman groups, LZ77 with distance
   7:Source/render/decoders/webp.c **** // mapping, color cache, and all four inverse transforms. Lossy:
   8:Source/render/decoders/webp.c **** // boolean decoder (BITS=24), segment/filter/quant/probability headers,
   9:Source/render/decoders/webp.c **** // residual tokens, intra predictions, DCT/WHT transforms, loop filter,
  10:Source/render/decoders/webp.c **** // and fancy chroma upsampling byte-compatible with `dwebp -ppm`.
  11:Source/render/decoders/webp.c **** // Animation: VP8X/ANIM/ANMF demux + non-premultiplied blender.
  12:Source/render/decoders/webp.c **** 
