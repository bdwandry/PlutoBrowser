 807:Source/render/decoders/webp.c **** static uint32_t clamped_add_subtract_full(uint32_t c0, uint32_t c1,
 808:Source/render/decoders/webp.c ****                                           uint32_t c2) {
 809:Source/render/decoders/webp.c ****     uint32_t a = clip255(((c0 >> 24) & 0xFF) + ((c1 >> 24) & 0xFF) -
 810:Source/render/decoders/webp.c ****                          ((c2 >> 24) & 0xFF));
 811:Source/render/decoders/webp.c ****     uint32_t r = clip255(((c0 >> 16) & 0xFF) + ((c1 >> 16) & 0xFF) -
 812:Source/render/decoders/webp.c ****                          ((c2 >> 16) & 0xFF));
 813:Source/render/decoders/webp.c ****     uint32_t g = clip255(((c0 >> 8) & 0xFF) + ((c1 >> 8) & 0xFF) -
 814:Source/render/decoders/webp.c ****                          ((c2 >> 8) & 0xFF));
 815:Source/render/decoders/webp.c ****     uint32_t b = clip255((c0 & 0xFF) + (c1 & 0xFF) - (c2 & 0xFF));
 816:Source/render/decoders/webp.c ****     return (a << 24) | (r << 16) | (g << 8) | b;
 817:Source/render/decoders/webp.c **** }
 818:Source/render/decoders/webp.c **** 
 819:Source/render/decoders/webp.c **** static uint32_t add_sub_half(uint32_t a, uint32_t b) {
 820:Source/render/decoders/webp.c ****     return clip255((uint32_t)((int)a + div2trunc((int)a - (int)b)));
 821:Source/render/decoders/webp.c **** }
 822:Source/render/decoders/webp.c **** 
 823:Source/render/decoders/webp.c **** static uint32_t clamped_add_subtract_half(uint32_t c0, uint32_t c1,
 824:Source/render/decoders/webp.c ****                                           uint32_t c2) {
 825:Source/render/decoders/webp.c ****     uint32_t ave = average2(c0, c1);
 826:Source/render/decoders/webp.c ****     uint32_t a = add_sub_half((ave >> 24) & 0xFF, (c2 >> 24) & 0xFF);
 827:Source/render/decoders/webp.c ****     uint32_t r = add_sub_half((ave >> 16) & 0xFF, (c2 >> 16) & 0xFF);
 828:Source/render/decoders/webp.c ****     uint32_t g = add_sub_half((ave >> 8) & 0xFF, (c2 >> 8) & 0xFF);
 829:Source/render/decoders/webp.c ****     uint32_t b = add_sub_half(ave & 0xFF, c2 & 0xFF);
 830:Source/render/decoders/webp.c ****     return (a << 24) | (r << 16) | (g << 8) | b;
 831:Source/render/decoders/webp.c **** }
