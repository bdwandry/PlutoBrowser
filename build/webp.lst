 929:Source/render/decoders/webp.c **** static void color_space_inverse(const Transform* t, const uint32_t* in,
 930:Source/render/decoders/webp.c ****                                 uint32_t* out, int rows) {
 931:Source/render/decoders/webp.c ****     int width = t->xsize;
 932:Source/render/decoders/webp.c ****     int tileWidth = 1 << t->bits;
 933:Source/render/decoders/webp.c ****     int mask = tileWidth - 1;
 934:Source/render/decoders/webp.c ****     int safeWidth = width & ~mask;
 935:Source/render/decoders/webp.c ****     int remainingWidth = width - safeWidth;
 936:Source/render/decoders/webp.c ****     int tilesPerRow = sub_sample_size(width, t->bits);
 937:Source/render/decoders/webp.c ****     const uint32_t* tdata = t->data;
 938:Source/render/decoders/webp.c ****     int predRow = 0;
 939:Source/render/decoders/webp.c ****     int y = 0;
 940:Source/render/decoders/webp.c ****     while (y < rows) {
 941:Source/render/decoders/webp.c ****         int m[3];
 942:Source/render/decoders/webp.c ****         int predIdx = predRow;
 943:Source/render/decoders/webp.c ****         int srcPos = y * width;
 944:Source/render/decoders/webp.c ****         int dstPos = y * width;
 945:Source/render/decoders/webp.c ****         int safeEnd = srcPos + safeWidth;
 946:Source/render/decoders/webp.c ****         int endPos = srcPos + width;
 947:Source/render/decoders/webp.c ****         tasks_yield_check();
 948:Source/render/decoders/webp.c ****         while (srcPos < safeEnd) {
 949:Source/render/decoders/webp.c ****             uint32_t code = tdata[predIdx];
 950:Source/render/decoders/webp.c ****             predIdx++;
 951:Source/render/decoders/webp.c ****             m[0] = to_int8((int)(code & 0xFF));
 952:Source/render/decoders/webp.c ****             m[1] = to_int8((int)((code >> 8) & 0xFF));
 953:Source/render/decoders/webp.c ****             m[2] = to_int8((int)((code >> 16) & 0xFF));
 954:Source/render/decoders/webp.c ****             transform_color_inverse(m, in, srcPos, tileWidth, out, dstPos);
 955:Source/render/decoders/webp.c ****             srcPos += tileWidth;
 956:Source/render/decoders/webp.c ****             dstPos += tileWidth;
 957:Source/render/decoders/webp.c ****         }
 958:Source/render/decoders/webp.c ****         if (srcPos < endPos) {
 959:Source/render/decoders/webp.c ****             uint32_t code = tdata[predIdx];
 960:Source/render/decoders/webp.c ****             m[0] = to_int8((int)(code & 0xFF));
 961:Source/render/decoders/webp.c ****             m[1] = to_int8((int)((code >> 8) & 0xFF));
 962:Source/render/decoders/webp.c ****             m[2] = to_int8((int)((code >> 16) & 0xFF));
 963:Source/render/decoders/webp.c ****             transform_color_inverse(m, in, srcPos, remainingWidth, out, dstPos);
 964:Source/render/decoders/webp.c ****         }
 965:Source/render/decoders/webp.c ****         y++;
 966:Source/render/decoders/webp.c ****         if ((y & mask) == 0) predRow += tilesPerRow;
 967:Source/render/decoders/webp.c ****     }
 968:Source/render/decoders/webp.c **** }
 969:Source/render/decoders/webp.c **** 
 970:Source/render/decoders/webp.c **** static void add_green_to_blue_and_red(const uint32_t* src, int num,
 971:Source/render/decoders/webp.c ****                                       uint32_t* dst) {
 972:Source/render/decoders/webp.c ****     int i;
 973:Source/render/decoders/webp.c ****     for (i = 0; i < num; i++) {
 974:Source/render/decoders/webp.c ****         uint32_t argb = src[i];
 975:Source/render/decoders/webp.c ****         uint32_t green = (argb >> 8) & 0xFF;
 976:Source/render/decoders/webp.c ****         uint32_t redBlue =
 977:Source/render/decoders/webp.c ****             (argb & 0x00FF00FFu) + ((green << 16) | green);
 978:Source/render/decoders/webp.c ****         redBlue &= 0x00FF00FFu;
 979:Source/render/decoders/webp.c ****         dst[i] = (argb & 0xFF00FF00u) | redBlue;
 980:Source/render/decoders/webp.c ****     }
 981:Source/render/decoders/webp.c **** }
 982:Source/render/decoders/webp.c **** 
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 33


 983:Source/render/decoders/webp.c **** static void color_index_inverse(const Transform* t, const uint32_t* in,
 984:Source/render/decoders/webp.c ****                                 uint32_t* out, int rows) {
 985:Source/render/decoders/webp.c ****     int bitsPerPixel = 8 >> t->bits;
 986:Source/render/decoders/webp.c ****     int width = t->xsize;
