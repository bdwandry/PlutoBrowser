1595:Source/render/decoders/webp.c ****                 if (vp8_get_bit(br, 128) != 0)
1596:Source/render/decoders/webp.c ****                     hdr->refLfDelta[i] = vp8_get_signed_value(br, 6);
1597:Source/render/decoders/webp.c ****             for (i = 0; i < 4; i++)
