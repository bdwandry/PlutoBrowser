 829:src/render/decoders/webp.c **** /* Predictor modes 0..13; args are (left, top, top1, topm1). */
 830:src/render/decoders/webp.c **** static uint32_t predictor_value(int mode, uint32_t left, uint32_t top,
 831:src/render/decoders/webp.c ****                                 uint32_t top1, uint32_t topm1) {
 832:src/render/decoders/webp.c ****     switch (mode) {
 833:src/render/decoders/webp.c ****         case 0:  return ARGB_BLACK;
 834:src/render/decoders/webp.c ****         case 1:  return left;
 835:src/render/decoders/webp.c ****         case 2:  return top;
 836:src/render/decoders/webp.c ****         case 3:  return top1;
 837:src/render/decoders/webp.c ****         case 4:  return topm1;
 838:src/render/decoders/webp.c ****         case 5:  return average3(left, top, top1);
 839:src/render/decoders/webp.c ****         case 6:  return average2(left, topm1);
 840:src/render/decoders/webp.c ****         case 7:  return average2(left, top);
 841:src/render/decoders/webp.c ****         case 8:  return average2(topm1, top);
 842:src/render/decoders/webp.c ****         case 9:  return average2(top, top1);
 843:src/render/decoders/webp.c ****         case 10: return average4(left, topm1, top, top1);
 844:src/render/decoders/webp.c ****         case 11: return select_p(top, left, topm1);
 845:src/render/decoders/webp.c ****         case 12: return clamped_add_subtract_full(left, top, topm1);
 846:src/render/decoders/webp.c ****         default: return clamped_add_subtract_half(left, top, topm1);
 847:src/render/decoders/webp.c ****     }
