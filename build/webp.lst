 814:src/render/decoders/webp.c **** 
 815:src/render/decoders/webp.c **** static uint32_t add_sub_half(uint32_t a, uint32_t b) {
 816:src/render/decoders/webp.c ****     return clip255((uint32_t)((int)a + div2trunc((int)a - (int)b)));
 817:src/render/decoders/webp.c **** }
 818:src/render/decoders/webp.c **** 
 819:src/render/decoders/webp.c **** static uint32_t clamped_add_subtract_half(uint32_t c0, uint32_t c1,
 820:src/render/decoders/webp.c ****                                           uint32_t c2) {
 821:src/render/decoders/webp.c ****     uint32_t ave = average2(c0, c1);
 822:src/render/decoders/webp.c ****     uint32_t a = add_sub_half((ave >> 24) & 0xFF, (c2 >> 24) & 0xFF);
 823:src/render/decoders/webp.c ****     uint32_t r = add_sub_half((ave >> 16) & 0xFF, (c2 >> 16) & 0xFF);
 824:src/render/decoders/webp.c ****     uint32_t g = add_sub_half((ave >> 8) & 0xFF, (c2 >> 8) & 0xFF);
 825:src/render/decoders/webp.c ****     uint32_t b = add_sub_half(ave & 0xFF, c2 & 0xFF);
 826:src/render/decoders/webp.c ****     return (a << 24) | (r << 16) | (g << 8) | b;
 827:src/render/decoders/webp.c **** }
