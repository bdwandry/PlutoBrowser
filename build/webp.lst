1171:src/render/decoders/webp.c ****     if (ctx->numTransforms == 0) return data;
1172:src/render/decoders/webp.c ****     for (i = ctx->numTransforms - 1; i >= 0; i--) {
1173:src/render/decoders/webp.c ****         const Transform* t = &ctx->transforms[i];
1174:src/render/decoders/webp.c ****         uint32_t* out =
1175:src/render/decoders/webp.c ****             (uint32_t*)pluto_calloc((size_t)t->xsize * (size_t)rows,
1176:src/render/decoders/webp.c ****                                     sizeof(uint32_t));
1177:src/render/decoders/webp.c ****         if (!out) {
1178:src/render/decoders/webp.c ****             pluto_free(in_);
1179:src/render/decoders/webp.c ****             return NULL;
1180:src/render/decoders/webp.c ****         }
1181:src/render/decoders/webp.c ****         if (t->type == COLOR_INDEXING_TRANSFORM) {
1182:src/render/decoders/webp.c ****             color_index_inverse(t, in_, out, rows);
1183:src/render/decoders/webp.c ****         } else if (t->type == SUBTRACT_GREEN_TRANSFORM) {
1184:src/render/decoders/webp.c ****             add_green_to_blue_and_red(in_, t->xsize * rows, out);
1185:src/render/decoders/webp.c ****         } else if (t->type == PREDICTOR_TRANSFORM) {
1186:src/render/decoders/webp.c ****             predictor_inverse(t, in_, out, rows);
1187:src/render/decoders/webp.c ****         } else {
1188:src/render/decoders/webp.c ****             color_space_inverse(t, in_, out, rows);
1189:src/render/decoders/webp.c ****         }
1190:src/render/decoders/webp.c ****         pluto_free(in_);
1191:src/render/decoders/webp.c ****         in_ = out;
1192:src/render/decoders/webp.c ****     }
1193:src/render/decoders/webp.c ****     return in_;
1194:src/render/decoders/webp.c **** }
