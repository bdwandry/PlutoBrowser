 458:Source/render/decoders/webp.c **** 
 459:Source/render/decoders/webp.c ****     if (allowRecursion && br_read_bits(br, 1) == 1) {
 460:Source/render/decoders/webp.c ****         int huffmanPrecision =
 461:Source/render/decoders/webp.c ****             MIN_HUFFMAN_BITS + br_read_bits(br, NUM_HUFFMAN_BITS);
