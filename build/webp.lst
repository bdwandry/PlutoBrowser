2522:Source/render/decoders/webp.c **** static int vp8_parse_residuals(Vp8Dec* dec, Vp8Br* tokenBr) {
2523:Source/render/decoders/webp.c ****     int mbX = dec->mbX;
2524:Source/render/decoders/webp.c ****     Vp8MbInfo* mb = &dec->mbInfo[mbX + 1];
2525:Source/render/decoders/webp.c ****     Vp8MbInfo* leftMb = &dec->mbInfo[0];
2526:Source/render/decoders/webp.c ****     Vp8Block* block = &dec->mbData[mbX];
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 154


2527:Source/render/decoders/webp.c ****     const int* q = dec->dqm[block->segment].y1; /* luma AC quantizer pair */
2528:Source/render/decoders/webp.c ****     const int* qy2 = dec->dqm[block->segment].y2;
2529:Source/render/decoders/webp.c ****     const int* quv = dec->dqm[block->segment].uv;
2530:Source/render/decoders/webp.c ****     int* dst = block->coeffs;
2531:Source/render/decoders/webp.c ****     unsigned int nonZeroY = 0, nonZeroUv = 0;
2532:Source/render/decoders/webp.c ****     int first, outOff = 0;
2533:Source/render/decoders/webp.c ****     int acT, tnz, lnz, outTNz, outLNz;
2534:Source/render/decoders/webp.c ****     int y, x, ch;
2535:Source/render/decoders/webp.c ****     memset(dst, 0, sizeof(int) * 384);
2536:Source/render/decoders/webp.c ****     if (block->isI4x4 == 0) {
2537:Source/render/decoders/webp.c ****         int dc[16];
2538:Source/render/decoders/webp.c ****         int ctxIdx = mb->nzDc + leftMb->nzDc;
2539:Source/render/decoders/webp.c ****         int nz;
2540:Source/render/decoders/webp.c ****         memset(dc, 0, sizeof(dc));
2541:Source/render/decoders/webp.c ****         nz = vp8_get_coeffs(tokenBr, dec->proba, 1, 0, ctxIdx, qy2[0], qy2[1],
2542:Source/render/decoders/webp.c ****                             dc, 0);
2543:Source/render/decoders/webp.c ****         mb->nzDc = (nz > 0) ? 1 : 0;
2544:Source/render/decoders/webp.c ****         leftMb->nzDc = mb->nzDc;
2545:Source/render/decoders/webp.c ****         if (nz > 1) {
2546:Source/render/decoders/webp.c ****             vp8_transform_wht(dc, 0, dst, 0);
2547:Source/render/decoders/webp.c ****         } else {
2548:Source/render/decoders/webp.c ****             int dc0 = vp8_sar(dc[0] + 3, 3);
2549:Source/render/decoders/webp.c ****             int i;
2550:Source/render/decoders/webp.c ****             for (i = 0; i < 16; i++) dst[i * 16] = dc0;
2551:Source/render/decoders/webp.c ****         }
2552:Source/render/decoders/webp.c ****         first = 1;
2553:Source/render/decoders/webp.c ****     } else {
2554:Source/render/decoders/webp.c ****         first = 0;
2555:Source/render/decoders/webp.c ****     }
2556:Source/render/decoders/webp.c ****     acT = (block->isI4x4 == 0) ? 0 : 3;
2557:Source/render/decoders/webp.c ****     tnz = mb->nz & 0x0f;
2558:Source/render/decoders/webp.c ****     lnz = leftMb->nz & 0x0f;
2559:Source/render/decoders/webp.c ****     for (y = 0; y < 4; y++) {
2560:Source/render/decoders/webp.c ****         int l = lnz & 1;
2561:Source/render/decoders/webp.c ****         int nzCoeffs = 0;
2562:Source/render/decoders/webp.c ****         for (x = 0; x < 4; x++) {
2563:Source/render/decoders/webp.c ****             int ctxIdx = l + (tnz & 1);
2564:Source/render/decoders/webp.c ****             int nz = vp8_get_coeffs(tokenBr, dec->proba, acT, first, ctxIdx,
2565:Source/render/decoders/webp.c ****                                     q[0], q[1], dst, outOff);
2566:Source/render/decoders/webp.c ****             l = (nz > first) ? 1 : 0;
2567:Source/render/decoders/webp.c ****             tnz = ((tnz >> 1) | (l << 7)) & 0xff;
2568:Source/render/decoders/webp.c ****             {
2569:Source/render/decoders/webp.c ****                 int code = 0;
2570:Source/render/decoders/webp.c ****                 if (nz > 3)
2571:Source/render/decoders/webp.c ****                     code = 3;
2572:Source/render/decoders/webp.c ****                 else if (nz > 1)
2573:Source/render/decoders/webp.c ****                     code = 2;
2574:Source/render/decoders/webp.c ****                 else if (dst[outOff] != 0)
2575:Source/render/decoders/webp.c ****                     code = 1;
2576:Source/render/decoders/webp.c ****                 nzCoeffs = ((nzCoeffs << 2) | code) & 0xff;
2577:Source/render/decoders/webp.c ****             }
2578:Source/render/decoders/webp.c ****             outOff += 16;
2579:Source/render/decoders/webp.c ****         }
2580:Source/render/decoders/webp.c ****         tnz >>= 4;
2581:Source/render/decoders/webp.c ****         lnz = ((lnz >> 1) | (l << 7)) & 0xff;
2582:Source/render/decoders/webp.c ****         nonZeroY = ((nonZeroY << 8) | (unsigned int)nzCoeffs);
2583:Source/render/decoders/webp.c ****     }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 155


2584:Source/render/decoders/webp.c ****     outTNz = tnz;
2585:Source/render/decoders/webp.c ****     outLNz = lnz >> 4;
2586:Source/render/decoders/webp.c ****     for (ch = 0; ch <= 2; ch += 2) {
2587:Source/render/decoders/webp.c ****         int nzCoeffs = 0;
2588:Source/render/decoders/webp.c ****         tnz = (mb->nz >> (4 + ch)) & 0xff;
2589:Source/render/decoders/webp.c ****         lnz = (leftMb->nz >> (4 + ch)) & 0xff;
2590:Source/render/decoders/webp.c ****         for (y = 0; y < 2; y++) {
2591:Source/render/decoders/webp.c ****             int l = lnz & 1;
2592:Source/render/decoders/webp.c ****             for (x = 0; x < 2; x++) {
2593:Source/render/decoders/webp.c ****                 int ctxIdx = l + (tnz & 1);
2594:Source/render/decoders/webp.c ****                 int nz = vp8_get_coeffs(tokenBr, dec->proba, 2, 0, ctxIdx,
2595:Source/render/decoders/webp.c ****                                         quv[0], quv[1], dst, outOff);
2596:Source/render/decoders/webp.c ****                 l = (nz > 0) ? 1 : 0;
2597:Source/render/decoders/webp.c ****                 tnz = ((tnz >> 1) | (l << 3)) & 0xff;
2598:Source/render/decoders/webp.c ****                 {
2599:Source/render/decoders/webp.c ****                     int code = 0;
2600:Source/render/decoders/webp.c ****                     if (nz > 3)
2601:Source/render/decoders/webp.c ****                         code = 3;
2602:Source/render/decoders/webp.c ****                     else if (nz > 1)
2603:Source/render/decoders/webp.c ****                         code = 2;
2604:Source/render/decoders/webp.c ****                     else if (dst[outOff] != 0)
2605:Source/render/decoders/webp.c ****                         code = 1;
2606:Source/render/decoders/webp.c ****                     nzCoeffs = ((nzCoeffs << 2) | code) & 0xff;
2607:Source/render/decoders/webp.c ****                 }
2608:Source/render/decoders/webp.c ****                 outOff += 16;
2609:Source/render/decoders/webp.c ****             }
2610:Source/render/decoders/webp.c ****             tnz >>= 2;
2611:Source/render/decoders/webp.c ****             lnz = ((lnz >> 1) | (l << 5)) & 0xff;
2612:Source/render/decoders/webp.c ****         }
2613:Source/render/decoders/webp.c ****         nonZeroUv |= (unsigned int)nzCoeffs << (4 * ch);
2614:Source/render/decoders/webp.c ****         outTNz |= (tnz << 4) << ch;
2615:Source/render/decoders/webp.c ****         outLNz |= (lnz & 0xf0) << ch;
2616:Source/render/decoders/webp.c ****     }
2617:Source/render/decoders/webp.c ****     mb->nz = outTNz & 0xff;
2618:Source/render/decoders/webp.c ****     leftMb->nz = outLNz & 0xff;
2619:Source/render/decoders/webp.c ****     block->nonZeroY = nonZeroY;
2620:Source/render/decoders/webp.c ****     block->nonZeroUv = nonZeroUv;
2621:Source/render/decoders/webp.c ****     block->dither = 0;
2622:Source/render/decoders/webp.c ****     return (nonZeroY | nonZeroUv) == 0;
2623:Source/render/decoders/webp.c **** }
