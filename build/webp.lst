  80:Source/render/decoders/webp.c **** /* Little-endian bit reader (VP8L reads bits LSB-first)                */
  81:Source/render/decoders/webp.c **** 
  82:Source/render/decoders/webp.c **** typedef struct {
  83:Source/render/decoders/webp.c ****     const uint8_t* data;
  84:Source/render/decoders/webp.c ****     size_t len;
  85:Source/render/decoders/webp.c ****     size_t pos;      /* next byte to load (0-based) */
  86:Source/render/decoders/webp.c ****     uint32_t window;
  87:Source/render/decoders/webp.c ****     int nbits;
  88:Source/render/decoders/webp.c ****     int eos;
  89:Source/render/decoders/webp.c **** } Br;
  90:Source/render/decoders/webp.c **** 
  91:Source/render/decoders/webp.c **** static int br_prefetch(Br* br, int want) {
  92:Source/render/decoders/webp.c ****     while (br->nbits < want && br->pos < br->len) {
  93:Source/render/decoders/webp.c ****         br->window |= (uint32_t)br->data[br->pos] << br->nbits;
  94:Source/render/decoders/webp.c ****         br->pos++;
  95:Source/render/decoders/webp.c ****         br->nbits += 8;
  96:Source/render/decoders/webp.c ****     }
  97:Source/render/decoders/webp.c ****     return (int)(br->window & (((uint32_t)1 << want) - 1));
  98:Source/render/decoders/webp.c **** }
  99:Source/render/decoders/webp.c **** 
 100:Source/render/decoders/webp.c **** static void br_advance(Br* br, int n) {
 101:Source/render/decoders/webp.c ****     br->nbits -= n;
 102:Source/render/decoders/webp.c ****     br->window >>= n;
 103:Source/render/decoders/webp.c ****     if (br->nbits < 0) {
 104:Source/render/decoders/webp.c ****         br->eos = 1;
 105:Source/render/decoders/webp.c ****         br->nbits = 0;
 106:Source/render/decoders/webp.c ****     }
 107:Source/render/decoders/webp.c **** }
 108:Source/render/decoders/webp.c **** 
 109:Source/render/decoders/webp.c **** static int br_read_bits(Br* br, int n) {
 110:Source/render/decoders/webp.c ****     int v;
 111:Source/render/decoders/webp.c ****     if (n == 0) return 0;
 112:Source/render/decoders/webp.c ****     v = br_prefetch(br, n);
 113:Source/render/decoders/webp.c ****     if (br->nbits < n) {
 114:Source/render/decoders/webp.c ****         br->eos = 1;
 115:Source/render/decoders/webp.c ****         return 0;
 116:Source/render/decoders/webp.c ****     }
 117:Source/render/decoders/webp.c ****     br_advance(br, n);
 118:Source/render/decoders/webp.c ****     return v;
 119:Source/render/decoders/webp.c **** }
