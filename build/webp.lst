1023:src/render/decoders/webp.c **** static uint32_t* expand_color_map(int numColors, const Transform* t) {
1024:src/render/decoders/webp.c ****     int finalNum = 1 << (8 >> t->bits);
1025:src/render/decoders/webp.c ****     const uint32_t* oldData = t->data;
1026:src/render/decoders/webp.c ****     uint32_t* newData =
1027:src/render/decoders/webp.c ****         (uint32_t*)pluto_calloc((size_t)finalNum, sizeof(uint32_t));
1028:src/render/decoders/webp.c ****     int i;
1029:src/render/decoders/webp.c ****     if (!newData) return NULL;
1030:src/render/decoders/webp.c ****     newData[0] = oldData[0];
1031:src/render/decoders/webp.c ****     for (i = 1; i < numColors; i++) {
1032:src/render/decoders/webp.c ****         uint32_t prev = newData[i - 1];
1033:src/render/decoders/webp.c ****         uint32_t cur = oldData[i];
1034:src/render/decoders/webp.c ****         uint32_t a = ((prev >> 24) & 0xFF) + ((cur >> 24) & 0xFF);
1035:src/render/decoders/webp.c ****         uint32_t r = ((prev >> 16) & 0xFF) + ((cur >> 16) & 0xFF);
1036:src/render/decoders/webp.c ****         uint32_t g = ((prev >> 8) & 0xFF) + ((cur >> 8) & 0xFF);
1037:src/render/decoders/webp.c ****         uint32_t b = (prev & 0xFF) + (cur & 0xFF);
1038:src/render/decoders/webp.c ****         newData[i] = ((a & 0xFF) << 24) | ((r & 0xFF) << 16) |
1039:src/render/decoders/webp.c ****                      ((g & 0xFF) << 8) | (b & 0xFF);
1040:src/render/decoders/webp.c ****     }
1041:src/render/decoders/webp.c ****     return newData;
1042:src/render/decoders/webp.c **** }
