3017:Source/render/decoders/webp.c ****             for (i = 0; i < uvWidth; i++) {
3018:Source/render/decoders/webp.c ****                 dec->tmpU[i] = cacheU[uvBase + i];
3019:Source/render/decoders/webp.c ****                 dec->tmpV[i] = cacheV[uvBase + i];
3020:Source/render/decoders/webp.c ****             }
3021:Source/render/decoders/webp.c ****         } else if ((yEnd & 1) == 0) {
3022:Source/render/decoders/webp.c ****             /* Very last row of an even-sized picture. */
3023:Source/render/decoders/webp.c ****             int yBase = (rowOff + yEnd - 1 - yStart) * yBps;
3024:Source/render/decoders/webp.c ****             int uvBase = (uvOff + ((yEnd - 1 - yStart) >> 1)) * uvBps;
3025:Source/render/decoders/webp.c ****             vp8_upsample_line_pair(cacheY, yBase, NULL, 0,
3026:Source/render/decoders/webp.c ****                                    cacheU, uvBase, cacheV, uvBase,
3027:Source/render/decoders/webp.c ****                                    cacheU, uvBase, cacheV, uvBase,
3028:Source/render/decoders/webp.c ****                                    rgb, width, yEnd - 1, 0);
3029:Source/render/decoders/webp.c ****         }
3030:Source/render/decoders/webp.c ****     }
3031:Source/render/decoders/webp.c ****     if (!isLast) {
3032:Source/render/decoders/webp.c ****         int yBps = dec->cacheYStride;
3033:Source/render/decoders/webp.c ****         int uvBps = dec->cacheUvStride;
3034:Source/render/decoders/webp.c ****         uint8_t* cacheY = dec->cacheY;
3035:Source/render/decoders/webp.c ****         uint8_t* cacheU = dec->cacheU;
3036:Source/render/decoders/webp.c ****         uint8_t* cacheV = dec->cacheV;
3037:Source/render/decoders/webp.c ****         int kk, i;
3038:Source/render/decoders/webp.c ****         for (kk = 0; kk < dec->extra; kk++) {
3039:Source/render/decoders/webp.c ****             int src = (16 + kk) * yBps;
3040:Source/render/decoders/webp.c ****             int dst = kk * yBps;
3041:Source/render/decoders/webp.c ****             for (i = 0; i < yBps; i++) cacheY[dst + i] = cacheY[src + i];
3042:Source/render/decoders/webp.c ****         }
3043:Source/render/decoders/webp.c ****         for (kk = 0; kk < dec->extraUV; kk++) {
3044:Source/render/decoders/webp.c ****             int src = (8 + kk) * uvBps;
3045:Source/render/decoders/webp.c ****             int dst = kk * uvBps;
3046:Source/render/decoders/webp.c ****             for (i = 0; i < uvBps; i++) {
3047:Source/render/decoders/webp.c ****                 cacheU[dst + i] = cacheU[src + i];
3048:Source/render/decoders/webp.c ****                 cacheV[dst + i] = cacheV[src + i];
3049:Source/render/decoders/webp.c ****             }
3050:Source/render/decoders/webp.c ****         }
3051:Source/render/decoders/webp.c ****     }
3052:Source/render/decoders/webp.c **** }
