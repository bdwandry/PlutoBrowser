 115:Source/render/decoders/webp.c **** /* ── Symbol reading (webp.lua 117-150) ──────────────────�
 116:Source/render/decoders/webp.c ****  * Tables are flat arrays of (bits << 16) | value, two-level like libwebp. */
 117:Source/render/decoders/webp.c **** uint32_t webp_read_symbol(const uint32_t *table, WebPBitReader *br)
 118:Source/render/decoders/webp.c **** {
 119:Source/render/decoders/webp.c ****     uint32_t val = webp_br_prefetch(br, 16);
 120:Source/render/decoders/webp.c ****     uint32_t low = val & WEBP_HUFFMAN_TABLE_MASK;
 121:Source/render/decoders/webp.c ****     uint32_t entry = table[low];
 122:Source/render/decoders/webp.c ****     int nbits = (int)(entry >> 16) - WEBP_HUFFMAN_TABLE_BITS;
 123:Source/render/decoders/webp.c ****     if (nbits > 0)
 124:Source/render/decoders/webp.c ****     {
 125:Source/render/decoders/webp.c ****         webp_br_advance(br, WEBP_HUFFMAN_TABLE_BITS);
 126:Source/render/decoders/webp.c ****         uint32_t val2 = webp_br_prefetch(br, nbits);
 127:Source/render/decoders/webp.c ****         entry = table[low + (entry & 0xFFFFu) + (val2 & ((1u << nbits) - 1u))];
 128:Source/render/decoders/webp.c ****         webp_br_advance(br, (int)(entry >> 16));
 129:Source/render/decoders/webp.c ****     }
 130:Source/render/decoders/webp.c ****     else
 131:Source/render/decoders/webp.c ****     {
 132:Source/render/decoders/webp.c ****         webp_br_advance(br, (int)(entry >> 16));
 133:Source/render/decoders/webp.c ****     }
 134:Source/render/decoders/webp.c ****     return entry & 0xFFFFu;
 135:Source/render/decoders/webp.c **** }
