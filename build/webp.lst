 803:src/render/decoders/webp.c **** static uint32_t clamped_add_subtract_full(uint32_t c0, uint32_t c1,
 804:src/render/decoders/webp.c ****                                           uint32_t c2) {
 805:src/render/decoders/webp.c ****     uint32_t a = clip255(((c0 >> 24) & 0xFF) + ((c1 >> 24) & 0xFF) -
 806:src/render/decoders/webp.c ****                          ((c2 >> 24) & 0xFF));
 807:src/render/decoders/webp.c ****     uint32_t r = clip255(((c0 >> 16) & 0xFF) + ((c1 >> 16) & 0xFF) -
 808:src/render/decoders/webp.c ****                          ((c2 >> 16) & 0xFF));
 809:src/render/decoders/webp.c ****     uint32_t g = clip255(((c0 >> 8) & 0xFF) + ((c1 >> 8) & 0xFF) -
 810:src/render/decoders/webp.c ****                          ((c2 >> 8) & 0xFF));
 811:src/render/decoders/webp.c ****     uint32_t b = clip255((c0 & 0xFF) + (c1 & 0xFF) - (c2 & 0xFF));
 812:src/render/decoders/webp.c ****     return (a << 24) | (r << 16) | (g << 8) | b;
