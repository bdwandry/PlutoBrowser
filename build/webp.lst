3426:Source/render/decoders/webp.c **** /* Non-premultiplied alpha blending (libwebp AnimDecoder blend_func).
3427:Source/render/decoders/webp.c ****  * Returns src over dst in ARGB. */
3428:Source/render/decoders/webp.c **** static uint32_t anim_blend_pixel(uint32_t src, uint32_t dst) {
3429:Source/render/decoders/webp.c ****     unsigned int srcA = (src >> 24) & 0xFFu;
3430:Source/render/decoders/webp.c ****     unsigned int dstFactorA, blendA, scale, out;
3431:Source/render/decoders/webp.c ****     int shift;
3432:Source/render/decoders/webp.c ****     if (srcA == 0) return dst;
3433:Source/render/decoders/webp.c ****     dstFactorA = (((dst >> 24) & 0xFFu) * (256u - srcA)) >> 8;
3434:Source/render/decoders/webp.c ****     blendA = srcA + dstFactorA;
3435:Source/render/decoders/webp.c ****     scale = 16777216u / blendA;
3436:Source/render/decoders/webp.c ****     out = blendA << 24;
3437:Source/render/decoders/webp.c ****     for (shift = 0; shift <= 16; shift += 8) {
3438:Source/render/decoders/webp.c ****         uint64_t sc = (src >> shift) & 0xFFu;
3439:Source/render/decoders/webp.c ****         uint64_t dc = (dst >> shift) & 0xFFu;
3440:Source/render/decoders/webp.c ****         unsigned int c =
3441:Source/render/decoders/webp.c ****             (unsigned)(((sc * srcA + dc * dstFactorA) * scale) / 16777216u);
3442:Source/render/decoders/webp.c ****         out |= c << shift;
3443:Source/render/decoders/webp.c ****     }
3444:Source/render/decoders/webp.c ****     return out;
3445:Source/render/decoders/webp.c **** }
