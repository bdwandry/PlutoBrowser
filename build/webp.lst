 758:src/render/decoders/webp.c **** static uint32_t add_pixels(uint32_t a, uint32_t b) {
 759:src/render/decoders/webp.c ****     uint32_t ag = (a & 0xFF00FF00u) + (b & 0xFF00FF00u);
 760:src/render/decoders/webp.c ****     uint32_t rb = (a & 0x00FF00FFu) + (b & 0x00FF00FFu);
 761:src/render/decoders/webp.c ****     return (ag & 0xFF00FF00u) | (rb & 0x00FF00FFu);
 762:src/render/decoders/webp.c **** }
 763:src/render/decoders/webp.c **** 
 764:src/render/decoders/webp.c **** static uint32_t average2(uint32_t a0, uint32_t a1) {
 765:src/render/decoders/webp.c ****     return (((a0 ^ a1) & 0xFEFEFEFEu) >> 1) + (a0 & a1);
 766:src/render/decoders/webp.c **** }
 767:src/render/decoders/webp.c **** 
 768:src/render/decoders/webp.c **** static uint32_t average3(uint32_t a0, uint32_t a1, uint32_t a2) {
 769:src/render/decoders/webp.c ****     return average2(average2(a0, a2), a1);
 770:src/render/decoders/webp.c **** }
 771:src/render/decoders/webp.c **** 
 772:src/render/decoders/webp.c **** static uint32_t average4(uint32_t a0, uint32_t a1, uint32_t a2, uint32_t a3) {
 773:src/render/decoders/webp.c ****     return average2(average2(a0, a1), average2(a2, a3));
 774:src/render/decoders/webp.c **** }
 775:src/render/decoders/webp.c **** 
 776:src/render/decoders/webp.c **** static uint32_t clip255(uint32_t a) {
 777:src/render/decoders/webp.c ****     if (a < 256u) return a;
 778:src/render/decoders/webp.c ****     return (~a >> 24) & 0xFFu;
 779:src/render/decoders/webp.c **** }
 780:src/render/decoders/webp.c **** 
 781:src/render/decoders/webp.c **** static int div2trunc(int x) {
 782:src/render/decoders/webp.c ****     if (x >= 0) return x >> 1;
 783:src/render/decoders/webp.c ****     return -((-x) >> 1);
 784:src/render/decoders/webp.c **** }
 785:src/render/decoders/webp.c **** 
 786:src/render/decoders/webp.c **** static int sub3(int a, int b, int c) {
 787:src/render/decoders/webp.c ****     int bc = b - c; int ac = a - c;
 788:src/render/decoders/webp.c ****     return (bc < 0 ? -bc : bc) - (ac < 0 ? -ac : ac);
 789:src/render/decoders/webp.c **** }
 790:src/render/decoders/webp.c **** 
