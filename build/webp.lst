3068:Source/render/decoders/webp.c ****  * ALPH chunk is present). Caller frees both buffers. */
3069:Source/render/decoders/webp.c **** static int vp8_decode_payload(const uint8_t* payload, size_t len,
3070:Source/render/decoders/webp.c ****                               const uint8_t* alphaPayload, size_t alphaLen,
