 729:Source/render/decoders/webp.c ****                 }
 730:Source/render/decoders/webp.c ****                 if (colorCache) {
 731:Source/render/decoders/webp.c ****                     while (lastCached < src)
 732:Source/render/decoders/webp.c ****                         color_cache_insert(colorCache, data[lastCached++]);
 733:Source/render/decoders/webp.c ****                 }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 24


 734:Source/render/decoders/webp.c ****             } else if (code < colorCacheLimit) {
 735:Source/render/decoders/webp.c ****                 uint32_t cached;
 736:Source/render/decoders/webp.c ****                 while (lastCached < src)
 737:Source/render/decoders/webp.c ****                     color_cache_insert(colorCache, data[lastCached++]);
 738:Source/render/decoders/webp.c ****                 cached = colorCache->colors[code - lenCodeLimit];
 739:Source/render/decoders/webp.c ****                 data[src++] = cached;
 740:Source/render/decoders/webp.c ****                 col++;
