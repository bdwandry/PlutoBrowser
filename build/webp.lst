 925:src/render/decoders/webp.c **** static void color_space_inverse(const Transform* t, const uint32_t* in,
 926:src/render/decoders/webp.c ****                                 uint32_t* out, int rows) {
 927:src/render/decoders/webp.c ****     int width = t->xsize;
 928:src/render/decoders/webp.c ****     int tileWidth = 1 << t->bits;
 929:src/render/decoders/webp.c ****     int mask = tileWidth - 1;
 930:src/render/decoders/webp.c ****     int safeWidth = width & ~mask;
 931:src/render/decoders/webp.c ****     int remainingWidth = width - safeWidth;
 932:src/render/decoders/webp.c ****     int tilesPerRow = sub_sample_size(width, t->bits);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccQjXwFz.s 			page 64


 933:src/render/decoders/webp.c ****     const uint32_t* tdata = t->data;
 934:src/render/decoders/webp.c ****     int predRow = 0;
 935:src/render/decoders/webp.c ****     int y = 0;
 936:src/render/decoders/webp.c ****     while (y < rows) {
 937:src/render/decoders/webp.c ****         int m[3];
 938:src/render/decoders/webp.c ****         int predIdx = predRow;
 939:src/render/decoders/webp.c ****         int srcPos = y * width;
 940:src/render/decoders/webp.c ****         int dstPos = y * width;
 941:src/render/decoders/webp.c ****         int safeEnd = srcPos + safeWidth;
 942:src/render/decoders/webp.c ****         int endPos = srcPos + width;
 943:src/render/decoders/webp.c ****         tasks_yield_check();
 944:src/render/decoders/webp.c ****         while (srcPos < safeEnd) {
 945:src/render/decoders/webp.c ****             uint32_t code = tdata[predIdx];
 946:src/render/decoders/webp.c ****             predIdx++;
 947:src/render/decoders/webp.c ****             m[0] = to_int8((int)(code & 0xFF));
 948:src/render/decoders/webp.c ****             m[1] = to_int8((int)((code >> 8) & 0xFF));
 949:src/render/decoders/webp.c ****             m[2] = to_int8((int)((code >> 16) & 0xFF));
 950:src/render/decoders/webp.c ****             transform_color_inverse(m, in, srcPos, tileWidth, out, dstPos);
 951:src/render/decoders/webp.c ****             srcPos += tileWidth;
 952:src/render/decoders/webp.c ****             dstPos += tileWidth;
 953:src/render/decoders/webp.c ****         }
 954:src/render/decoders/webp.c ****         if (srcPos < endPos) {
 955:src/render/decoders/webp.c ****             uint32_t code = tdata[predIdx];
 956:src/render/decoders/webp.c ****             m[0] = to_int8((int)(code & 0xFF));
 957:src/render/decoders/webp.c ****             m[1] = to_int8((int)((code >> 8) & 0xFF));
 958:src/render/decoders/webp.c ****             m[2] = to_int8((int)((code >> 16) & 0xFF));
 959:src/render/decoders/webp.c ****             transform_color_inverse(m, in, srcPos, remainingWidth, out, dstPos);
 960:src/render/decoders/webp.c ****         }
 961:src/render/decoders/webp.c ****         y++;
 962:src/render/decoders/webp.c ****         if ((y & mask) == 0) predRow += tilesPerRow;
 963:src/render/decoders/webp.c ****     }
 964:src/render/decoders/webp.c **** }
