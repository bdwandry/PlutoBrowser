 762:Source/render/decoders/webp.c **** static uint32_t add_pixels(uint32_t a, uint32_t b) {
 763:Source/render/decoders/webp.c ****     uint32_t ag = (a & 0xFF00FF00u) + (b & 0xFF00FF00u);
 764:Source/render/decoders/webp.c ****     uint32_t rb = (a & 0x00FF00FFu) + (b & 0x00FF00FFu);
 765:Source/render/decoders/webp.c ****     return (ag & 0xFF00FF00u) | (rb & 0x00FF00FFu);
 766:Source/render/decoders/webp.c **** }
 767:Source/render/decoders/webp.c **** 
 768:Source/render/decoders/webp.c **** static uint32_t average2(uint32_t a0, uint32_t a1) {
 769:Source/render/decoders/webp.c ****     return (((a0 ^ a1) & 0xFEFEFEFEu) >> 1) + (a0 & a1);
 770:Source/render/decoders/webp.c **** }
 771:Source/render/decoders/webp.c **** 
 772:Source/render/decoders/webp.c **** static uint32_t average3(uint32_t a0, uint32_t a1, uint32_t a2) {
 773:Source/render/decoders/webp.c ****     return average2(average2(a0, a2), a1);
 774:Source/render/decoders/webp.c **** }
 775:Source/render/decoders/webp.c **** 
 776:Source/render/decoders/webp.c **** static uint32_t average4(uint32_t a0, uint32_t a1, uint32_t a2, uint32_t a3) {
 777:Source/render/decoders/webp.c ****     return average2(average2(a0, a1), average2(a2, a3));
 778:Source/render/decoders/webp.c **** }
 779:Source/render/decoders/webp.c **** 
 780:Source/render/decoders/webp.c **** static uint32_t clip255(uint32_t a) {
 781:Source/render/decoders/webp.c ****     if (a < 256u) return a;
 782:Source/render/decoders/webp.c ****     return (~a >> 24) & 0xFFu;
 783:Source/render/decoders/webp.c **** }
 784:Source/render/decoders/webp.c **** 
 785:Source/render/decoders/webp.c **** static int div2trunc(int x) {
 786:Source/render/decoders/webp.c ****     if (x >= 0) return x >> 1;
 787:Source/render/decoders/webp.c ****     return -((-x) >> 1);
 788:Source/render/decoders/webp.c **** }
 789:Source/render/decoders/webp.c **** 
 790:Source/render/decoders/webp.c **** static int sub3(int a, int b, int c) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 25


 791:Source/render/decoders/webp.c ****     int bc = b - c; int ac = a - c;
 792:Source/render/decoders/webp.c ****     return (bc < 0 ? -bc : bc) - (ac < 0 ? -ac : ac);
 793:Source/render/decoders/webp.c **** }
