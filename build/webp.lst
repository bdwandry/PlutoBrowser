 966:src/render/decoders/webp.c **** static void add_green_to_blue_and_red(const uint32_t* src, int num,
 967:src/render/decoders/webp.c ****                                       uint32_t* dst) {
 968:src/render/decoders/webp.c ****     int i;
 969:src/render/decoders/webp.c ****     for (i = 0; i < num; i++) {
 970:src/render/decoders/webp.c ****         uint32_t argb = src[i];
 971:src/render/decoders/webp.c ****         uint32_t green = (argb >> 8) & 0xFF;
 972:src/render/decoders/webp.c ****         uint32_t redBlue =
 973:src/render/decoders/webp.c ****             (argb & 0x00FF00FFu) + ((green << 16) | green);
 974:src/render/decoders/webp.c ****         redBlue &= 0x00FF00FFu;
 975:src/render/decoders/webp.c ****         dst[i] = (argb & 0xFF00FF00u) | redBlue;
 976:src/render/decoders/webp.c ****     }
 977:src/render/decoders/webp.c **** }
