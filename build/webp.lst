2960:Source/render/decoders/webp.c **** static void vp8_finish_row(Vp8Dec* dec, int isFirst, int isLast) {
2961:Source/render/decoders/webp.c ****     int width = dec->width;
2962:Source/render/decoders/webp.c ****     int height = dec->height;
2963:Source/render/decoders/webp.c ****     int mbY = dec->mbY;
2964:Source/render/decoders/webp.c ****     int yStart = mbY * 16;
2965:Source/render/decoders/webp.c ****     int yEnd = yStart + 16;
2966:Source/render/decoders/webp.c ****     int k = 1;
2967:Source/render/decoders/webp.c ****     int curY;
2968:Source/render/decoders/webp.c ****     if (!isFirst) yStart -= dec->extra;
2969:Source/render/decoders/webp.c ****     if (!isLast) yEnd -= dec->extra;
2970:Source/render/decoders/webp.c ****     if (yEnd > height) yEnd = height;
2971:Source/render/decoders/webp.c ****     if (yStart < yEnd) {
2972:Source/render/decoders/webp.c ****         int rowOff = isFirst ? dec->extra : 0;
2973:Source/render/decoders/webp.c ****         int uvOff = isFirst ? dec->extraUV : 0;
2974:Source/render/decoders/webp.c ****         int yBps = dec->cacheYStride;
2975:Source/render/decoders/webp.c ****         int uvBps = dec->cacheUvStride;
2976:Source/render/decoders/webp.c ****         uint8_t* cacheY = dec->cacheY;
2977:Source/render/decoders/webp.c ****         uint8_t* cacheU = dec->cacheU;
2978:Source/render/decoders/webp.c ****         uint8_t* cacheV = dec->cacheV;
2979:Source/render/decoders/webp.c ****         uint8_t* rgb = dec->rgb;
2980:Source/render/decoders/webp.c ****         if (yStart == 0) {
2981:Source/render/decoders/webp.c ****             /* First line is special-cased: mirror u/v at the boundary. */
2982:Source/render/decoders/webp.c ****             int yBase = rowOff * yBps;
2983:Source/render/decoders/webp.c ****             int uvBase = uvOff * uvBps;
2984:Source/render/decoders/webp.c ****             vp8_upsample_line_pair(cacheY, yBase, NULL, 0,
2985:Source/render/decoders/webp.c ****                                    cacheU, uvBase, cacheV, uvBase,
2986:Source/render/decoders/webp.c ****                                    cacheU, uvBase, cacheV, uvBase,
2987:Source/render/decoders/webp.c ****                                    rgb, width, 0, 0);
2988:Source/render/decoders/webp.c ****         } else {
2989:Source/render/decoders/webp.c ****             /* Finish the left-over row from the previous call. */
2990:Source/render/decoders/webp.c ****             int uvBase = uvOff * uvBps;
2991:Source/render/decoders/webp.c ****             vp8_upsample_line_pair(dec->tmpY, 0, cacheY, rowOff * yBps,
2992:Source/render/decoders/webp.c ****                                    dec->tmpU, 0, dec->tmpV, 0,
2993:Source/render/decoders/webp.c ****                                    cacheU, uvBase, cacheV, uvBase,
2994:Source/render/decoders/webp.c ****                                    rgb, width, yStart - 1, yStart);
2995:Source/render/decoders/webp.c ****         }
2996:Source/render/decoders/webp.c ****         while (yStart + 2 * k < yEnd) {
2997:Source/render/decoders/webp.c ****             int yRow = rowOff + 2 * k - 1;
2998:Source/render/decoders/webp.c ****             int uvRow = uvOff + k - 1;
2999:Source/render/decoders/webp.c ****             vp8_upsample_line_pair(cacheY, yRow * yBps, cacheY,
3000:Source/render/decoders/webp.c ****                                    (yRow + 1) * yBps,
3001:Source/render/decoders/webp.c ****                                    cacheU, uvRow * uvBps, cacheV,
3002:Source/render/decoders/webp.c ****                                    uvRow * uvBps,
3003:Source/render/decoders/webp.c ****                                    cacheU, (uvRow + 1) * uvBps, cacheV,
3004:Source/render/decoders/webp.c ****                                    (uvRow + 1) * uvBps,
3005:Source/render/decoders/webp.c ****                                    rgb, width, yStart + 2 * k - 1,
3006:Source/render/decoders/webp.c ****                                    yStart + 2 * k);
3007:Source/render/decoders/webp.c ****             k++;
3008:Source/render/decoders/webp.c ****         }
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 184


3009:Source/render/decoders/webp.c ****         curY = yStart + 2 * (k - 1) + 1;
3010:Source/render/decoders/webp.c ****         if (yEnd < height) {
3011:Source/render/decoders/webp.c ****             /* Save the unfinished samples for the next call. */
3012:Source/render/decoders/webp.c ****             int yBase = (rowOff + curY - yStart) * yBps;
3013:Source/render/decoders/webp.c ****             int uvBase = (uvOff + ((curY >> 1) - (yStart >> 1))) * uvBps;
3014:Source/render/decoders/webp.c ****             int uvWidth = (width + 1) >> 1;
3015:Source/render/decoders/webp.c ****             int i;
