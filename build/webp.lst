 647:Source/render/decoders/webp.c **** static int decode_image_data(Br* br, VP8LCtx* ctx, uint32_t* data,
 648:Source/render/decoders/webp.c ****                              int width, int height) {
 649:Source/render/decoders/webp.c ****     int row = 0, col = 0, src = 0;
 650:Source/render/decoders/webp.c ****     int lenCodeLimit = NUM_LITERAL_CODES + NUM_LENGTH_CODES;
 651:Source/render/decoders/webp.c ****     int colorCacheLimit = lenCodeLimit + ctx->colorCacheSize;
 652:Source/render/decoders/webp.c ****     int srcEnd = width * height;
 653:Source/render/decoders/webp.c ****     int huffmanBits = ctx->huffmanSubsampleBits;
 654:Source/render/decoders/webp.c ****     const int* huffmanImage = ctx->huffmanImage;
 655:Source/render/decoders/webp.c ****     int huffmanXsize = ctx->huffmanXsize;
 656:Source/render/decoders/webp.c ****     HTreeGroup* htreeGroups = ctx->htreeGroups;
 657:Source/render/decoders/webp.c ****     ColorCache* colorCache = ctx->colorCache;
 658:Source/render/decoders/webp.c ****     unsigned mask =
 659:Source/render/decoders/webp.c ****         (huffmanBits == 0) ? 0xFFFFFFFFu : ((1u << huffmanBits) - 1);
 660:Source/render/decoders/webp.c ****     HTreeGroup* group = NULL;
 661:Source/render/decoders/webp.c ****     int lastCached = 0;
 662:Source/render/decoders/webp.c **** 
 663:Source/render/decoders/webp.c ****     while (src < srcEnd) {
 664:Source/render/decoders/webp.c ****         tasks_yield_check();
 665:Source/render/decoders/webp.c ****         if ((col & mask) == 0) {
 666:Source/render/decoders/webp.c ****             int metaIndex = 0;
 667:Source/render/decoders/webp.c ****             if (huffmanBits != 0)
 668:Source/render/decoders/webp.c ****                 metaIndex = huffmanImage[huffmanXsize * (row >> huffmanBits) +
 669:Source/render/decoders/webp.c ****                                          (col >> huffmanBits)];
 670:Source/render/decoders/webp.c ****             group = &htreeGroups[metaIndex];
 671:Source/render/decoders/webp.c ****         }
 672:Source/render/decoders/webp.c ****         if (!group || !group->htrees[0]) return 0;
 673:Source/render/decoders/webp.c ****         if (group->isTrivialCode) {
 674:Source/render/decoders/webp.c ****             data[src++] = group->literalArgb;
 675:Source/render/decoders/webp.c ****             col++;
 676:Source/render/decoders/webp.c ****             if (col >= width) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 23


 677:Source/render/decoders/webp.c ****                 col = 0;
 678:Source/render/decoders/webp.c ****                 row++;
 679:Source/render/decoders/webp.c ****             }
 680:Source/render/decoders/webp.c ****             if (colorCache) {
 681:Source/render/decoders/webp.c ****                 while (lastCached < src)
 682:Source/render/decoders/webp.c ****                     color_cache_insert(colorCache, data[lastCached++]);
 683:Source/render/decoders/webp.c ****             }
 684:Source/render/decoders/webp.c ****         } else {
 685:Source/render/decoders/webp.c ****             int code = read_symbol(group->htrees[0], br);
 686:Source/render/decoders/webp.c ****             if (code < NUM_LITERAL_CODES) {
 687:Source/render/decoders/webp.c ****                 uint32_t pixel;
 688:Source/render/decoders/webp.c ****                 if (group->isTrivialLiteral) {
 689:Source/render/decoders/webp.c ****                     pixel = group->literalArb | ((uint32_t)code << 8);
 690:Source/render/decoders/webp.c ****                 } else {
 691:Source/render/decoders/webp.c ****                     int red = read_symbol(group->htrees[1], br);
 692:Source/render/decoders/webp.c ****                     int blue = read_symbol(group->htrees[2], br);
 693:Source/render/decoders/webp.c ****                     int alpha = read_symbol(group->htrees[3], br);
