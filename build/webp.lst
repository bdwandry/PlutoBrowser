1348:Source/render/decoders/webp.c **** static void vp8_init_log2(void) {
1349:Source/render/decoders/webp.c ****     int i;
1350:Source/render/decoders/webp.c ****     if (s_vp8Log2Init) return;
1351:Source/render/decoders/webp.c ****     for (i = 1; i <= 255; i++) {
1352:Source/render/decoders/webp.c ****         int v = i, n = 0;
1353:Source/render/decoders/webp.c ****         while (v > 1) {
1354:Source/render/decoders/webp.c ****             v >>= 1;
1355:Source/render/decoders/webp.c ****             n++;
1356:Source/render/decoders/webp.c ****         }
1357:Source/render/decoders/webp.c ****         s_vp8Log2[i] = n;
1358:Source/render/decoders/webp.c ****     }
1359:Source/render/decoders/webp.c ****     s_vp8Log2Init = 1;
1360:Source/render/decoders/webp.c **** }
