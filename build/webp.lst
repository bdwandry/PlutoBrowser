2643:Source/render/decoders/webp.c ****             ymode = (vp8_get_bit(br, 163) != 0) ? VP8_V_PRED : VP8_DC_PRED;
2644:Source/render/decoders/webp.c ****         block->imodes[0] = ymode;
2645:Source/render/decoders/webp.c ****         {
