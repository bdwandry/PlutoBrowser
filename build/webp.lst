 639:Source/render/decoders/webp.c **** static void color_cache_insert(ColorCache* cc, uint32_t argb) {
 640:Source/render/decoders/webp.c ****     uint32_t key = (argb * K_HASH_MUL) >> cc->hashShift;
 641:Source/render/decoders/webp.c ****     cc->colors[key] = argb;
 642:Source/render/decoders/webp.c **** }
