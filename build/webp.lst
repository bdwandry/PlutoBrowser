 566:Source/render/decoders/webp.c **** /* Build a Huffman table for one meta-code stream. Returns a heap table
 567:Source/render/decoders/webp.c ****  * sized to the exact used entry count (0 on error). buildHuffmanTable
 568:Source/render/decoders/webp.c ****  * writes [0..totalSize); the buffer is shrunk to actual usage. */
 569:Source/render/decoders/webp.c **** static uint32_t *vp8l_read_huffman_code_table(int alphabetSize, WebPBitReader *br,
 570:Source/render/decoders/webp.c ****                                               uint8_t *scratch_code_lengths)
 571:Source/render/decoders/webp.c **** {
 572:Source/render/decoders/webp.c ****     static uint32_t big[WEBP_HUFFMAN_TABLE_MAX]; /* 128KB static, not stack */
 573:Source/render/decoders/webp.c ****     memset(big, 0, sizeof(big));
 574:Source/render/decoders/webp.c ****     /* buildHuffmanTable writes exactly [0, totalSize) entries and returns
 575:Source/render/decoders/webp.c ****      * totalSize (>0) — or 0 on error. Use the returned size directly; a
 576:Source/render/decoders/webp.c ****      * valid table may be all zeros (single-symbol code for symbol 0), so a
 577:Source/render/decoders/webp.c ****      * nonzero-entry scan would wrongly reject it. */
 578:Source/render/decoders/webp.c ****     int used = webp_read_huffman_code(alphabetSize, br, scratch_code_lengths, big);
 579:Source/render/decoders/webp.c ****     if (used <= 0)
 580:Source/render/decoders/webp.c ****     {
 581:Source/render/decoders/webp.c ****         return NULL;
 582:Source/render/decoders/webp.c ****     }
 583:Source/render/decoders/webp.c ****     uint32_t *out = (uint32_t *)PLUTO_MALLOC(sizeof(uint32_t) * (size_t)used);
 584:Source/render/decoders/webp.c ****     if (!out)
 585:Source/render/decoders/webp.c ****     {
 586:Source/render/decoders/webp.c ****         return NULL;
 587:Source/render/decoders/webp.c ****     }
 588:Source/render/decoders/webp.c ****     memcpy(out, big, sizeof(uint32_t) * (size_t)used);
 589:Source/render/decoders/webp.c ****     return out;
 590:Source/render/decoders/webp.c **** }
