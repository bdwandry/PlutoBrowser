2468:Source/render/decoders/webp.c **** static int vp8_get_large_value(Vp8Br* br, const uint8_t* proba, int p) {
2469:Source/render/decoders/webp.c ****     int v;
2470:Source/render/decoders/webp.c ****     if (vp8_get_bit(br, proba[p + 3]) == 0) {
2471:Source/render/decoders/webp.c ****         if (vp8_get_bit(br, proba[p + 4]) == 0)
2472:Source/render/decoders/webp.c ****             v = 2;
2473:Source/render/decoders/webp.c ****         else
2474:Source/render/decoders/webp.c ****             v = 3 + vp8_get_bit(br, proba[p + 5]);
2475:Source/render/decoders/webp.c ****     } else if (vp8_get_bit(br, proba[p + 6]) == 0) {
2476:Source/render/decoders/webp.c ****         if (vp8_get_bit(br, proba[p + 7]) == 0) {
2477:Source/render/decoders/webp.c ****             v = 5 + vp8_get_bit(br, 159);
2478:Source/render/decoders/webp.c ****         } else {
2479:Source/render/decoders/webp.c ****             v = 7 + 2 * vp8_get_bit(br, 165);
2480:Source/render/decoders/webp.c ****             v += vp8_get_bit(br, 145);
2481:Source/render/decoders/webp.c ****         }
2482:Source/render/decoders/webp.c ****     } else {
2483:Source/render/decoders/webp.c ****         int bit1 = vp8_get_bit(br, proba[p + 8]);
2484:Source/render/decoders/webp.c ****         int bit0 = vp8_get_bit(br, proba[p + 9 + bit1]);
2485:Source/render/decoders/webp.c ****         int cat = 2 * bit1 + bit0;
2486:Source/render/decoders/webp.c ****         const uint8_t* tab = kCat3456[cat];
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 139


2487:Source/render/decoders/webp.c ****         int i;
2488:Source/render/decoders/webp.c ****         v = 0;
2489:Source/render/decoders/webp.c ****         for (i = 0; tab[i] != 0; i++)
2490:Source/render/decoders/webp.c ****             v = v + v + vp8_get_bit(br, tab[i]);
2491:Source/render/decoders/webp.c ****         v += 3 + (8 << cat);
2492:Source/render/decoders/webp.c ****     }
2493:Source/render/decoders/webp.c ****     return v;
2494:Source/render/decoders/webp.c **** }
