 979:src/render/decoders/webp.c **** static void color_index_inverse(const Transform* t, const uint32_t* in,
 980:src/render/decoders/webp.c ****                                 uint32_t* out, int rows) {
 981:src/render/decoders/webp.c ****     int bitsPerPixel = 8 >> t->bits;
 982:src/render/decoders/webp.c ****     int width = t->xsize;
 983:src/render/decoders/webp.c ****     const uint32_t* colorMap = t->data;
 984:src/render/decoders/webp.c ****     if (bitsPerPixel < 8) {
 985:src/render/decoders/webp.c ****         int ppb = 1 << t->bits;
 986:src/render/decoders/webp.c ****         uint32_t bitMask = ((uint32_t)1 << bitsPerPixel) - 1;
 987:src/render/decoders/webp.c ****         int idx = 0;
 988:src/render/decoders/webp.c ****         int y;
 989:src/render/decoders/webp.c ****         for (y = 0; y < rows; y++) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccQjXwFz.s 			page 65


 990:src/render/decoders/webp.c ****             int x = 0;
 991:src/render/decoders/webp.c ****             int oBase = y * width;
 992:src/render/decoders/webp.c ****             tasks_yield_check();
 993:src/render/decoders/webp.c ****             while (x + ppb <= width) {
 994:src/render/decoders/webp.c ****                 uint32_t packed = (in[idx] >> 8) & 0xFF;
 995:src/render/decoders/webp.c ****                 int p;
 996:src/render/decoders/webp.c ****                 idx++;
 997:src/render/decoders/webp.c ****                 for (p = 0; p < ppb; p++) {
 998:src/render/decoders/webp.c ****                     out[oBase + x] = colorMap[packed & bitMask];
 999:src/render/decoders/webp.c ****                     packed >>= bitsPerPixel;
1000:src/render/decoders/webp.c ****                     x++;
1001:src/render/decoders/webp.c ****                 }
1002:src/render/decoders/webp.c ****             }
1003:src/render/decoders/webp.c ****             if (x < width) {
1004:src/render/decoders/webp.c ****                 uint32_t packed = (in[idx] >> 8) & 0xFF;
1005:src/render/decoders/webp.c ****                 idx++;
1006:src/render/decoders/webp.c ****                 while (x < width) {
1007:src/render/decoders/webp.c ****                     out[oBase + x] = colorMap[packed & bitMask];
1008:src/render/decoders/webp.c ****                     packed >>= bitsPerPixel;
1009:src/render/decoders/webp.c ****                     x++;
1010:src/render/decoders/webp.c ****                 }
1011:src/render/decoders/webp.c ****             }
1012:src/render/decoders/webp.c ****         }
1013:src/render/decoders/webp.c ****     } else {
1014:src/render/decoders/webp.c ****         int total = rows * width;
1015:src/render/decoders/webp.c ****         int i;
1016:src/render/decoders/webp.c ****         for (i = 0; i < total; i++) {
1017:src/render/decoders/webp.c ****             tasks_yield_check();
1018:src/render/decoders/webp.c ****             out[i] = colorMap[(in[i] >> 8) & 0xFF];
1019:src/render/decoders/webp.c ****         }
1020:src/render/decoders/webp.c ****     }
1021:src/render/decoders/webp.c **** }
