   1:src/render/decoders/webp.c **** // webp.c — C port of Source/render/decoders/webp.lua (P21: lossless VP8L).
   2:src/render/decoders/webp.c **** //
   3:src/render/decoders/webp.c **** // Parses the RIFF container and decodes a VP8L payload into a full-
   4:src/render/decoders/webp.c **** // resolution ARGB grid (0xAARRGGBB). Covers the little-endian bit reader,
   5:src/render/decoders/webp.c **** // two-level Huffman tables (rootBits 8, code-length table 7), meta
   6:src/render/decoders/webp.c **** // Huffman groups, LZ77 with distance mapping, the color cache, and all
   7:src/render/decoders/webp.c **** // four inverse transforms (predictor, cross-color, subtract-green,
   8:src/render/decoders/webp.c **** // color-indexing). Lossy VP8 and animation arrive in P22/P23.
   9:src/render/decoders/webp.c **** 
