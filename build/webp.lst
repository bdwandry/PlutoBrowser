3057:Source/render/decoders/webp.c **** /* Guarded little-endian read: bytes beyond len yield 0 (`or 0`). */
3058:Source/render/decoders/webp.c **** static unsigned int webp_read_le24(const uint8_t* data, size_t len,
3059:Source/render/decoders/webp.c ****                                    size_t pos) {
3060:Source/render/decoders/webp.c ****     unsigned int b1 = (pos < len) ? data[pos] : 0;
3061:Source/render/decoders/webp.c ****     unsigned int b2 = (pos + 1 < len) ? data[pos + 1] : 0;
3062:Source/render/decoders/webp.c ****     unsigned int b3 = (pos + 2 < len) ? data[pos + 2] : 0;
3063:Source/render/decoders/webp.c ****     return b1 | (b2 << 8) | (b3 << 16);
3064:Source/render/decoders/webp.c **** }
3065:Source/render/decoders/webp.c **** 
