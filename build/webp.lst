 794:src/render/decoders/webp.c ****         sub3((int)((a >> 16) & 0xFF), (int)((b >> 16) & 0xFF),
 795:src/render/decoders/webp.c ****              (int)((c >> 16) & 0xFF)) +
 796:src/render/decoders/webp.c ****         sub3((int)((a >> 8) & 0xFF), (int)((b >> 8) & 0xFF),
 797:src/render/decoders/webp.c ****              (int)((c >> 8) & 0xFF)) +
 798:src/render/decoders/webp.c ****         sub3((int)(a & 0xFF), (int)(b & 0xFF), (int)(c & 0xFF));
 799:src/render/decoders/webp.c ****     if (paMinusPb <= 0) return a;
