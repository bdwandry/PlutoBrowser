1761:Source/render/decoders/webp.c **** static void vp8_transform_wht(const int* in_, int inOff, int* out,
1762:Source/render/decoders/webp.c ****                               int outOff) {
1763:Source/render/decoders/webp.c ****     int t[16];
1764:Source/render/decoders/webp.c ****     int i;
1765:Source/render/decoders/webp.c ****     for (i = 0; i < 4; i++) {
1766:Source/render/decoders/webp.c ****         int a0 = in_[inOff + i] + in_[inOff + 12 + i];
1767:Source/render/decoders/webp.c ****         int a1 = in_[inOff + 4 + i] + in_[inOff + 8 + i];
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccU10y0s.s 			page 77


1768:Source/render/decoders/webp.c ****         int a2 = in_[inOff + 4 + i] - in_[inOff + 8 + i];
1769:Source/render/decoders/webp.c ****         int a3 = in_[inOff + i] - in_[inOff + 12 + i];
1770:Source/render/decoders/webp.c ****         t[i] = a0 + a1;
1771:Source/render/decoders/webp.c ****         t[8 + i] = a0 - a1;
1772:Source/render/decoders/webp.c ****         t[4 + i] = a3 + a2;
1773:Source/render/decoders/webp.c ****         t[12 + i] = a3 - a2;
1774:Source/render/decoders/webp.c ****     }
1775:Source/render/decoders/webp.c ****     for (i = 0; i < 4; i++) {
1776:Source/render/decoders/webp.c ****         int dc = t[i * 4] + 3;
1777:Source/render/decoders/webp.c ****         int a0 = dc + t[i * 4 + 3];
1778:Source/render/decoders/webp.c ****         int a1 = t[i * 4 + 1] + t[i * 4 + 2];
1779:Source/render/decoders/webp.c ****         int a2 = t[i * 4 + 1] - t[i * 4 + 2];
1780:Source/render/decoders/webp.c ****         int a3 = dc - t[i * 4 + 3];
1781:Source/render/decoders/webp.c ****         out[outOff]      = vp8_sar(a0 + a1, 3);
1782:Source/render/decoders/webp.c ****         out[outOff + 16] = vp8_sar(a3 + a2, 3);
1783:Source/render/decoders/webp.c ****         out[outOff + 32] = vp8_sar(a0 - a1, 3);
