  24:Source/core/url.c **** extern void pluto_free(void *p);
  25:Source/core/url.c **** extern void *pluto_realloc(void *p, size_t n);
  26:Source/core/url.c **** 
  27:Source/core/url.c **** /* url.c-returned buffers (encode/decode/resolve/unwrap) are freed by callers
  28:Source/core/url.c ****  * with pluto_free() (main.c, document.c, readability.c, http_client.c). All
  29:Source/core/url.c ****  * allocations here MUST therefore use the same SDK allocator — newlib malloc
  30:Source/core/url.c ****  * lives in a different heap on device, and cross-allocator frees corrupt the
  31:Source/core/url.c ****  * heap (observed as garbage bytes injected into submitted form URLs). */
  32:Source/core/url.c **** #define URL_MALLOC(n) pluto_realloc(NULL, (n))
  33:Source/core/url.c **** 
