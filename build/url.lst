 531:Source/core/url.c ****     char *out = NULL;
 532:Source/core/url.c **** 
 533:Source/core/url.c ****     /* Protocol-relative: //host/path */
 534:Source/core/url.c ****     if (rel[0] == '/' && rel[1] == '/')
 535:Source/core/url.c ****     {
 536:Source/core/url.c ****         size_t need = strlen(base.scheme) + 1 + strlen(rel) + 1;
 537:Source/core/url.c ****         out = (char *)URL_MALLOC(need);
 538:Source/core/url.c ****         if (out)
 539:Source/core/url.c ****         {
