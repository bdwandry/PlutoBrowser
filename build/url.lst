 248:src/core/url.c ****                          raw + caps[0].start, caps[0].len, "scheme");
 249:src/core/url.c ****             restLen = caps[1].len;
 250:src/core/url.c ****             copy_bounded(rest, sizeof(rest), raw + caps[1].start, restLen, "rest");
 251:src/core/url.c ****         } else {
