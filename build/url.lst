 512:Source/core/url.c ****     if (base.port != 80 && base.port != 443)
 513:Source/core/url.c ****     {
 514:Source/core/url.c ****         snprintf(portStr, sizeof(portStr), ":%d", base.port);
 515:Source/core/url.c ****     }
 516:Source/core/url.c **** 
 517:Source/core/url.c ****     char *out = NULL;
 518:Source/core/url.c **** 
 519:Source/core/url.c ****     /* Protocol-relative: //host/path */
 520:Source/core/url.c ****     if (rel[0] == '/' && rel[1] == '/')
 521:Source/core/url.c ****     {
 522:Source/core/url.c ****         size_t need = strlen(base.scheme) + 1 + strlen(rel) + 1;
 523:Source/core/url.c ****         out = (char *)malloc(need);
 524:Source/core/url.c ****         if (out)
 525:Source/core/url.c ****         {
