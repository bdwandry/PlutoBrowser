 527:Source/core/url.c ****         }
 528:Source/core/url.c ****         url_free(rel);
 529:Source/core/url.c ****         return out;
 530:Source/core/url.c ****     }
 531:Source/core/url.c **** 
 532:Source/core/url.c ****     /* Anchor-only: #section — note the Lua builds this WITHOUT portStr when
 533:Source/core/url.c ****      * port is 80/443 but the expression differs slightly; mirror Lua exactly:
 534:Source/core/url.c ****      * scheme://host[:port-if-not-80/443]path[?query]rel  */
