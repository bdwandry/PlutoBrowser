 586:Source/core/url.c ****     /* Path-relative: resolve '.'/'..' segments against the base directory */
 587:Source/core/url.c ****     const char *basePath = base.path;
 588:Source/core/url.c ****     const char *lastSlash = strrchr(basePath, '/');
 589:Source/core/url.c ****     size_t dirLen = lastSlash ? (size_t)(lastSlash - basePath) + 1 : 1;
