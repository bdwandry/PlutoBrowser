 195:src/core/url.c ****     // Empty input -> internal about:blank record (Lua parity).
 196:src/core/url.c ****     if (urlString == NULL || urlString[0] == '\0') {
 197:src/core/url.c ****         copy_z(out->normalized, sizeof(out->normalized), "about:blank", "norm");
 198:src/core/url.c ****         copy_z(out->scheme, sizeof(out->scheme), "about", "scheme");
 199:src/core/url.c ****         copy_z(out->host, sizeof(out->host), "blank", "host");
 200:src/core/url.c ****         out->port = 0;
