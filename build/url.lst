 378:src/core/url.c **** int url_unwrap_redirect(const char* urlString, StrBuf* out)
 379:src/core/url.c **** {
 380:src/core/url.c ****     LPCap caps[LP_MAXCAPTURES];
 381:src/core/url.c ****     int ncaps;
 382:src/core/url.c ****     size_t uLen;
 383:src/core/url.c ****     char uddg[PLUTO_URL_INPUT_MAX];
 384:src/core/url.c **** 
 385:src/core/url.c ****     if (urlString == NULL || urlString[0] == '\0' || out == NULL) {
 386:src/core/url.c ****         return 0;
 387:src/core/url.c ****     }
 388:src/core/url.c ****     uLen = strlen(urlString);
 389:src/core/url.c ****     if (!pat_find(urlString, uLen, PLIT("duckduckgo%.com/l/"))) {
 390:src/core/url.c ****         return 0;
