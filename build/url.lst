 202:src/core/url.c ****         copy_z(out->query, sizeof(out->query), "", "query");
 203:src/core/url.c ****         copy_z(out->hash, sizeof(out->hash), "", "hash");
 204:src/core/url.c ****         copy_z(out->fullPath, sizeof(out->fullPath), "/", "fullPath");
 205:src/core/url.c ****         out->isSsl = 1;
 206:src/core/url.c ****         return;
 207:src/core/url.c ****     }
 208:src/core/url.c **** 
 209:src/core/url.c ****     // Trimmed raw.
 210:src/core/url.c ****     rawLen = strlen(urlString);
 211:src/core/url.c ****     if (rawLen >= sizeof(raw)) {
 212:src/core/url.c ****         PLUTO_ERROR("url: input over %u bytes truncated",
 213:src/core/url.c ****                     (unsigned)sizeof(raw) - 1);
 214:src/core/url.c ****         rawLen = sizeof(raw) - 1;
 215:src/core/url.c ****     }
 216:src/core/url.c ****     memcpy(work, urlString, rawLen);
 217:src/core/url.c ****     work[rawLen] = '\0';
 218:src/core/url.c ****     rawLen = trim_in_place(work, rawLen);
 219:src/core/url.c ****     memcpy(raw, work, rawLen + 1);
 220:src/core/url.c ****     copy_bounded(out->raw, sizeof(out->raw), raw, rawLen, "raw");
 221:src/core/url.c **** 
 222:src/core/url.c ****     // about: scheme record
 223:src/core/url.c ****     if (pat_find(raw, rawLen, PLIT("^about:"))) {
 224:src/core/url.c ****         const char* sub = raw + 6;
 225:src/core/url.c ****         size_t subLen = rawLen - 6;
 226:src/core/url.c ****         copy_z(out->scheme, sizeof(out->scheme), "about", "scheme");
 227:src/core/url.c ****         copy_bounded(out->host, sizeof(out->host), sub, subLen, "host");
 228:src/core/url.c ****         out->port = 0;
 229:src/core/url.c ****         out->path[0] = '/';
 230:src/core/url.c ****         copy_bounded(out->path + 1, sizeof(out->path) - 1, sub, subLen, "path");
 231:src/core/url.c ****         copy_z(out->query, sizeof(out->query), "", "query");
 232:src/core/url.c ****         copy_z(out->hash, sizeof(out->hash), "", "hash");
 233:src/core/url.c ****         copy_z(out->fullPath, sizeof(out->fullPath), out->path, "fullPath");
 234:src/core/url.c ****         copy_bounded(out->normalized, sizeof(out->normalized), raw, rawLen, "norm");
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc92wK2L.s 			page 9


 235:src/core/url.c ****         out->isSsl = 1;
 236:src/core/url.c ****         return;
 237:src/core/url.c ****     }
 238:src/core/url.c **** 
 239:src/core/url.c ****     // Scheme split: default https when no scheme present.
 240:src/core/url.c ****     {
 241:src/core/url.c ****         char rest[PLUTO_URL_INPUT_MAX];
