   1:Source/core/url.c **** /*
   2:Source/core/url.c ****  * PlutoBrowser — url.c
   3:Source/core/url.c ****  * Port of Source/core/url.lua. Every function mirrors the Lua reference's
   4:Source/core/url.c ****  * observable behavior, including its quirks:
   5:Source/core/url.c ****  *   - encode maps newline → \r\n first, then percent-encodes non [A-Za-z0-9 -_.~ ]
   6:Source/core/url.c ****  *     bytes, then maps ' ' → '+'.
   7:Source/core/url.c ****  *   - decode maps '+' → ' ' first, then %XX.
   8:Source/core/url.c ****  *   - isSearchQuery: protocol/about/file prefixes are URLs; whitespace means
   9:Source/core/url.c ****  *     search; localhost/IP are URLs; a dot with non-leading/non-trailing dot
  10:Source/core/url.c ****  *     (i.e. contains a domain-ish token) is a URL; otherwise search.
  11:Source/core/url.c ****  *   - parse defaults missing scheme to https; port defaults 443/80; about:
  12:Source/core/url.c ****  *     pages get host = sub, path = "/" .. sub.
  13:Source/core/url.c ****  *   - resolve handles absolute, protocol-relative, #-only, ?-only, /-rooted and
  14:Source/core/url.c ****  *     path-relative (with '.'/'..' segment normalization) forms.
  15:Source/core/url.c ****  */
  16:Source/core/url.c **** #include <ctype.h>
  17:Source/core/url.c **** #include <stdio.h>
  18:Source/core/url.c **** #include <stdlib.h>
  19:Source/core/url.c **** #include <string.h>
  20:Source/core/url.c **** 
  21:Source/core/url.c **** #include "core/url.h"
  22:Source/core/url.c **** #include "util/strutil.h"
