 504:Source/core/url.c ****     url_parse(baseUrlStr ? baseUrlStr : "", &base);
 505:Source/core/url.c ****     if (strcmp(base.scheme, "about") == 0)
 506:Source/core/url.c ****     {
 507:Source/core/url.c ****         return rel;
 508:Source/core/url.c ****     }
 509:Source/core/url.c **** 
 510:Source/core/url.c ****     /* Port suffix helper value */
