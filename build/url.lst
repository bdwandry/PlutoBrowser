 496:Source/core/url.c ****     /* Absolute scheme, about:, data: or javascript: → as-is */
 497:Source/core/url.c ****     if (scheme_prefix_len(rel) > 0 || strutil_istarts_with(rel, "about:") ||
 498:Source/core/url.c ****         strutil_istarts_with(rel, "data:") || strutil_istarts_with(rel, "javascript:"))
 499:Source/core/url.c ****     {
