 140:src/core/url.c **** int url_is_search_query(const char* input)
 141:src/core/url.c **** {
 142:src/core/url.c ****     char buf[PLUTO_URL_INPUT_MAX];
 143:src/core/url.c ****     size_t len, tl;
 144:src/core/url.c **** 
 145:src/core/url.c ****     if (input == NULL || input[0] == '\0') {
 146:src/core/url.c ****         return 0;
 147:src/core/url.c ****     }
 148:src/core/url.c ****     len = strlen(input);
 149:src/core/url.c ****     if (len >= sizeof(buf)) {
 150:src/core/url.c ****         len = sizeof(buf) - 1;
 151:src/core/url.c ****     }
 152:src/core/url.c ****     memcpy(buf, input, len);
 153:src/core/url.c ****     buf[len] = '\0';
 154:src/core/url.c ****     tl = trim_in_place(buf, len);
 155:src/core/url.c **** 
 156:src/core/url.c ****     // Known protocols mean URL.
 157:src/core/url.c ****     if (pat_match(buf, tl, PLIT("^https?://")) ||
 158:src/core/url.c ****         pat_find(buf, tl, PLIT("^about:")) ||
 159:src/core/url.c ****         pat_find(buf, tl, PLIT("^file://"))) {
 160:src/core/url.c ****         return 0;
 161:src/core/url.c ****     }
 162:src/core/url.c **** 
 163:src/core/url.c ****     // Any whitespace -> search query.
 164:src/core/url.c ****     if (pat_find(buf, tl, PLIT("%s"))) {
 165:src/core/url.c ****         return 1;
 166:src/core/url.c ****     }
 167:src/core/url.c **** 
 168:src/core/url.c ****     // localhost / bare IP prefix -> URL.
 169:src/core/url.c ****     if (pat_find(buf, tl, PLIT("^localhost")) ||
 170:src/core/url.c ****         pat_find(buf, tl, PLIT("^%d+%.%d+%.%d+%.%d+"))) {
 171:src/core/url.c ****         return 0;
 172:src/core/url.c ****     }
 173:src/core/url.c **** 
 174:src/core/url.c ****     // A dot that is neither leading nor trailing -> URL.
 175:src/core/url.c ****     if (pat_find(buf, tl, PLIT("%.")) &&
 176:src/core/url.c ****         !pat_find(buf, tl, PLIT("^%.")) &&
 177:src/core/url.c ****         !pat_find(buf, tl, PLIT("%.$"))) {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc92wK2L.s 			page 8


 178:src/core/url.c ****         return 0;
 179:src/core/url.c ****     }
 180:src/core/url.c **** 
 181:src/core/url.c ****     return 1;
 182:src/core/url.c **** }
