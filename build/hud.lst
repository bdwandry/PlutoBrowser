  37:Source/ui/hud.c **** 
  38:Source/ui/hud.c **** void hd_scrollbar_thumb(double totalHeight, int scrollY,
  39:Source/ui/hud.c ****                         int* thumbY, int* thumbH) {
  40:Source/ui/hud.c ****     int trackX = PLUTO_SCREEN_WIDTH - PLUTO_SCROLLBAR_WIDTH - 2;
  41:Source/ui/hud.c ****     int trackY = PLUTO_CONTENT_Y + 2;
  42:Source/ui/hud.c ****     int trackH = PLUTO_CONTENT_HEIGHT - 4;
  43:Source/ui/hud.c ****     (void)trackX;
  44:Source/ui/hud.c **** 
  45:Source/ui/hud.c ****     if (!(totalHeight > (double)PLUTO_CONTENT_HEIGHT)) {
  46:Source/ui/hud.c ****         *thumbY = -1;
  47:Source/ui/hud.c ****         *thumbH = -1;
  48:Source/ui/hud.c ****         return;
  49:Source/ui/hud.c ****     }
  50:Source/ui/hud.c ****     int th = (int)(trackH *
  51:Source/ui/hud.c ****                    ((double)PLUTO_CONTENT_HEIGHT / totalHeight));
  52:Source/ui/hud.c ****     if (th < 12) th = 12;
  53:Source/ui/hud.c ****     double maxScroll = totalHeight - (double)PLUTO_CONTENT_HEIGHT;
  54:Source/ui/hud.c ****     double ratio = (double)scrollY / maxScroll;
  55:Source/ui/hud.c ****     if (ratio < 0.0) ratio = 0.0;
  56:Source/ui/hud.c ****     if (ratio > 1.0) ratio = 1.0;
  57:Source/ui/hud.c ****     *thumbY = trackY + (int)((double)(trackH - th) * ratio);
  58:Source/ui/hud.c ****     *thumbH = th;
  59:Source/ui/hud.c **** }
