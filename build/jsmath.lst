  12:Source/js/jsmath.c **** static double jsM_round(double x)
  13:Source/js/jsmath.c **** {
  14:Source/js/jsmath.c **** 	if (isnan(x)) return x;
  15:Source/js/jsmath.c **** 	if (isinf(x)) return x;
  16:Source/js/jsmath.c **** 	if (x == 0) return x;
  17:Source/js/jsmath.c **** 	if (x > 0 && x < 0.5) return 0;
  18:Source/js/jsmath.c **** 	if (x < 0 && x >= -0.5) return -0;
  19:Source/js/jsmath.c **** 	return floor(x + 0.5);
  20:Source/js/jsmath.c **** }
