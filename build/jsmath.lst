  84:Source/js/jsmath.c **** static void Math_random(js_State *J)
  85:Source/js/jsmath.c **** {
  86:Source/js/jsmath.c **** 	/* Lehmer generator with a=48271 and m=2^31-1 */
  87:Source/js/jsmath.c **** 	/* Park & Miller (1988). Random Number Generators: Good ones are hard to find. */
  88:Source/js/jsmath.c **** 	J->seed = (uint64_t) J->seed * 48271 % 0x7fffffff;
  89:Source/js/jsmath.c **** 	js_pushnumber(J, (double) J->seed / 0x7fffffff);
  90:Source/js/jsmath.c **** }
  91:Source/js/jsmath.c **** 
  92:Source/js/jsmath.c **** static void Math_init_random(js_State *J)
  93:Source/js/jsmath.c **** {
  94:Source/js/jsmath.c **** 	/* Pick initial seed by scrambling current time with Xorshift. */
  95:Source/js/jsmath.c **** 	/* Marsaglia (2003). Xorshift RNGs. */
  96:Source/js/jsmath.c **** 	J->seed = time(0) + 123;
  97:Source/js/jsmath.c **** 	J->seed ^= J->seed << 13;
  98:Source/js/jsmath.c **** 	J->seed ^= J->seed >> 17;
  99:Source/js/jsmath.c **** 	J->seed ^= J->seed << 5;
 100:Source/js/jsmath.c **** 	J->seed %= 0x7fffffff;
 101:Source/js/jsmath.c **** }
