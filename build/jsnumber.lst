  88:Source/js/jsnumber.c **** 
  89:Source/js/jsnumber.c **** 		if (point <= 0) {
  90:Source/js/jsnumber.c **** 			js_putc(J, &sb, '0');
  91:Source/js/jsnumber.c **** 			js_putc(J, &sb, '.');
  92:Source/js/jsnumber.c **** 			while (point++ < 0)
