  51:Source/js/jsnumber.c **** 
  52:Source/js/jsnumber.c **** 		if (number == 0) { js_pushstring(J, "0"); return; }
  53:Source/js/jsnumber.c **** 		if (isnan(number)) { js_pushstring(J, "NaN"); return; }
  54:Source/js/jsnumber.c **** 		if (isinf(number)) { js_pushstring(J, sign ? "-Infinity" : "Infinity"); return; }
  55:Source/js/jsnumber.c **** 
  56:Source/js/jsnumber.c **** 		if (sign)
  57:Source/js/jsnumber.c **** 			number = -number;
  58:Source/js/jsnumber.c **** 
