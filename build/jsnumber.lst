  41:Source/js/jsnumber.c **** 
  42:Source/js/jsnumber.c **** 	/* lame number to string conversion for any radix from 2 to 36 */
  43:Source/js/jsnumber.c **** 	{
  44:Source/js/jsnumber.c **** 		static const char digits[] = "0123456789abcdefghijklmnopqrstuvwxyz";
  45:Source/js/jsnumber.c **** 		double number = x;
  46:Source/js/jsnumber.c **** 		int sign = x < 0;
  47:Source/js/jsnumber.c **** 		js_Buffer *sb = NULL;
  48:Source/js/jsnumber.c **** 		uint64_t u, limit = ((uint64_t)1<<52);
  49:Source/js/jsnumber.c **** 
