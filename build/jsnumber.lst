  60:Source/js/jsnumber.c **** 		exp = 0;
  61:Source/js/jsnumber.c **** 		while (number * pow(radix, exp) > limit)
  62:Source/js/jsnumber.c **** 			--exp;
  63:Source/js/jsnumber.c **** 		while (number * pow(radix, exp+1) < limit)
  64:Source/js/jsnumber.c **** 			++exp;
  65:Source/js/jsnumber.c **** 		u = number * pow(radix, exp) + 0.5;
  66:Source/js/jsnumber.c **** 
  67:Source/js/jsnumber.c **** 		/* trim trailing zeros */
  68:Source/js/jsnumber.c **** 		while (u > 0 && (u % radix) == 0) {
  69:Source/js/jsnumber.c **** 			u /= radix;
  70:Source/js/jsnumber.c **** 			--exp;
  71:Source/js/jsnumber.c **** 		}
  72:Source/js/jsnumber.c **** 
  73:Source/js/jsnumber.c **** 		/* serialize digits */
  74:Source/js/jsnumber.c **** 		ndigits = 0;
  75:Source/js/jsnumber.c **** 		while (u > 0) {
