  96:Source/js/jsnumber.c **** 		} else {
  97:Source/js/jsnumber.c **** 			while (ndigits-- > 0) {
  98:Source/js/jsnumber.c **** 				js_putc(J, &sb, buf[ndigits]);
  99:Source/js/jsnumber.c **** 				if (--point == 0 && ndigits > 0)
