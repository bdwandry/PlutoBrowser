   1:src/core/tasks.c **** // tasks.c — cooperative task scheduler (C port of Source/core/tasks.lua).
   2:src/core/tasks.c **** //
   3:src/core/tasks.c **** // Lua ground truth captured on host Lua 5.5 (p05_oracle.lua):
   4:src/core/tasks.c **** //   - run(): isRunning true immediately; progress reset to 0 immediately;
   5:src/core/tasks.c **** //     job first advances on the NEXT update(); callbacks fire during the
   6:src/core/tasks.c **** //     update in which the job finishes.
   7:src/core/tasks.c **** //   - update() resumes ONLY queue[1] (head), at most one job per frame.
   8:src/core/tasks.c **** //   - done path: progress forced to 1, head removed, gc scheduled,
   9:src/core/tasks.c **** //     onComplete(result) via pcall. error path: progress LEFT AS-IS,
  10:src/core/tasks.c **** //     head removed, gc scheduled, onError(tostring(err)) via pcall.
  11:src/core/tasks.c **** //   - yieldCheck(): shared global counter; every 64th call checks
  12:src/core/tasks.c **** //     (inside && now-frameStart >= 500); outside a job it never yields.
  13:src/core/tasks.c **** //     With +20ms per iteration a 1000-iteration loop spans 16 frames.
  14:src/core/tasks.c **** //   - cancelAll(): no-op on empty queue (progress untouched, no GC);
  15:src/core/tasks.c **** //     otherwise drops every job with NO callbacks, zeroes progress,
  16:src/core/tasks.c **** //     schedules GC.
  17:src/core/tasks.c **** //   - scheduleGC(): drains within ONE update regardless of completion
  18:src/core/tasks.c **** //     (pcall quirk clears `done` flag unconditionally).
  19:src/core/tasks.c **** //   - reportProgress clamps to [0,1], monotonic.
