  66:Source/ui/home_page.c **** void hp_grid_nav(HpButton btn, int* selectedIndex, int count) {
  67:Source/ui/home_page.c ****     int sel = *selectedIndex;
  68:Source/ui/home_page.c **** 
  69:Source/ui/home_page.c ****     switch (btn) {
  70:Source/ui/home_page.c ****     case HP_BTN_DOWN:
  71:Source/ui/home_page.c ****         if (sel == 0) {
  72:Source/ui/home_page.c ****             if (count > 0) *selectedIndex = 1;
  73:Source/ui/home_page.c ****         } else if (sel + 2 <= count) {
  74:Source/ui/home_page.c ****             *selectedIndex = sel + 2;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccmQaGRy.s 			page 4


  75:Source/ui/home_page.c ****         } else if (sel < count) {
  76:Source/ui/home_page.c ****             *selectedIndex = sel + 1;
  77:Source/ui/home_page.c ****         }
  78:Source/ui/home_page.c ****         break;
  79:Source/ui/home_page.c ****     case HP_BTN_UP:
  80:Source/ui/home_page.c ****         if (sel == 0) break; /* already at top */
  81:Source/ui/home_page.c ****         if (sel <= 2) *selectedIndex = 0;
  82:Source/ui/home_page.c ****         else if (sel - 2 >= 1) *selectedIndex = sel - 2;
  83:Source/ui/home_page.c ****         break;
  84:Source/ui/home_page.c ****     case HP_BTN_RIGHT:
  85:Source/ui/home_page.c ****         if (sel != 0 && sel % 2 == 1 && sel + 1 <= count)
  86:Source/ui/home_page.c ****             *selectedIndex = sel + 1;
  87:Source/ui/home_page.c ****         break;
  88:Source/ui/home_page.c ****     case HP_BTN_LEFT:
  89:Source/ui/home_page.c ****         if (sel != 0 && sel % 2 == 0 && sel > 1)
  90:Source/ui/home_page.c ****             *selectedIndex = sel - 1;
  91:Source/ui/home_page.c ****         break;
  92:Source/ui/home_page.c ****     default:
  93:Source/ui/home_page.c ****         break;
  94:Source/ui/home_page.c ****     }
  95:Source/ui/home_page.c **** }
