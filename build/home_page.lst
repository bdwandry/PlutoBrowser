 133:Source/ui/home_page.c **** double hp_smooth_scroll(double cur, double target) {
 134:Source/ui/home_page.c ****     cur = cur + (target - cur) * 0.3;
 135:Source/ui/home_page.c ****     if (fabs(target - cur) < 0.5) cur = target;
 136:Source/ui/home_page.c ****     return cur > 0.0 ? cur : 0.0;
 137:Source/ui/home_page.c **** }
