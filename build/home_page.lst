  66:src/ui/home_page.c **** void hp_grid_nav(HpButton btn, int* selectedIndex, int count) {
  67:src/ui/home_page.c ****     int sel = *selectedIndex;
  68:src/ui/home_page.c **** 
  69:src/ui/home_page.c ****     switch (btn) {
  70:src/ui/home_page.c ****     case HP_BTN_DOWN:
  71:src/ui/home_page.c ****         if (sel == 0) {
  72:src/ui/home_page.c ****             if (count > 0) *selectedIndex = 1;
  73:src/ui/home_page.c ****         } else if (sel + 2 <= count) {
  74:src/ui/home_page.c ****             *selectedIndex = sel + 2;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccgRQVcR.s 			page 4


  75:src/ui/home_page.c ****         } else if (sel < count) {
  76:src/ui/home_page.c ****             *selectedIndex = sel + 1;
  77:src/ui/home_page.c ****         }
  78:src/ui/home_page.c ****         break;
  79:src/ui/home_page.c ****     case HP_BTN_UP:
  80:src/ui/home_page.c ****         if (sel == 0) break; /* already at top */
  81:src/ui/home_page.c ****         if (sel <= 2) *selectedIndex = 0;
  82:src/ui/home_page.c ****         else if (sel - 2 >= 1) *selectedIndex = sel - 2;
  83:src/ui/home_page.c ****         break;
  84:src/ui/home_page.c ****     case HP_BTN_RIGHT:
  85:src/ui/home_page.c ****         if (sel != 0 && sel % 2 == 1 && sel + 1 <= count)
  86:src/ui/home_page.c ****             *selectedIndex = sel + 1;
  87:src/ui/home_page.c ****         break;
  88:src/ui/home_page.c ****     case HP_BTN_LEFT:
  89:src/ui/home_page.c ****         if (sel != 0 && sel % 2 == 0 && sel > 1)
  90:src/ui/home_page.c ****             *selectedIndex = sel - 1;
  91:src/ui/home_page.c ****         break;
  92:src/ui/home_page.c ****     default:
  93:src/ui/home_page.c ****         break;
  94:src/ui/home_page.c ****     }
  95:src/ui/home_page.c **** }
