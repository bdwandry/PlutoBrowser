 183:Source/ui/home_page.c **** /* Marquee start timestamp for a key (Lua marqueeState[key]). */
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccmQaGRy.s 			page 24


 184:Source/ui/home_page.c **** static unsigned long marquee_start(const char* key) {
 185:Source/ui/home_page.c ****     for (int i = 0; i < s_nMarquees; i++)
 186:Source/ui/home_page.c ****         if (strcmp(s_marquees[i].key, key) == 0)
 187:Source/ui/home_page.c ****             return s_marquees[i].startMs;
 188:Source/ui/home_page.c ****     if (s_nMarquees < HP_MARQUEE_CAP) {
 189:Source/ui/home_page.c ****         HpMarquee* m = &s_marquees[s_nMarquees++];
 190:Source/ui/home_page.c ****         snprintf(m->key, sizeof(m->key), "%s", key);
 191:Source/ui/home_page.c ****         m->startMs = s_pd->system->getCurrentTimeMilliseconds();
 192:Source/ui/home_page.c ****         return m->startMs;
 193:Source/ui/home_page.c ****     }
 194:Source/ui/home_page.c ****     return s_pd->system->getCurrentTimeMilliseconds(); /* table full */
 195:Source/ui/home_page.c **** }
