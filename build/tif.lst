  87:Source/render/decoders/tif.c ****         int bit = (s->in[byteIdx] >> (7 - (s->bitPos & 7))) & 1;
  88:Source/render/decoders/tif.c ****         acc = (acc << 1) | (uint32_t)bit;
  89:Source/render/decoders/tif.c ****         s->bitPos++;
  90:Source/render/decoders/tif.c ****     }
  91:Source/render/decoders/tif.c ****     return (int)acc;
  92:Source/render/decoders/tif.c **** }
