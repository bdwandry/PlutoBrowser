 300:Source/render/decoders/tif.c **** static int g3_bit(G3Bit *b)
 301:Source/render/decoders/tif.c **** {
 302:Source/render/decoders/tif.c ****     if (b->bitPos >= b->len * 8) return -1;
 303:Source/render/decoders/tif.c ****     int bit = (b->data[b->bitPos >> 3] >> (7 - (b->bitPos & 7))) & 1;
 304:Source/render/decoders/tif.c ****     b->bitPos++;
