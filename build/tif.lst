 731:Source/render/decoders/tif.c ****                         int bit = (r[x >> 3] >> (7 - (x & 7))) & 1;
 732:Source/render/decoders/tif.c ****                         int white = (c.photometric == 0) ? (bit == 0) : (bit == 1);
 733:Source/render/decoders/tif.c ****                         rows[(size_t)y * c.width + x] = white ? 255 : 0;
 734:Source/render/decoders/tif.c ****                     }
 735:Source/render/decoders/tif.c ****                 }
 736:Source/render/decoders/tif.c ****                 else /* 8-bit gray */
 737:Source/render/decoders/tif.c ****                 {
 738:Source/render/decoders/tif.c ****                     for (int x = 0; x < c.width; x++)
 739:Source/render/decoders/tif.c ****                     {
 740:Source/render/decoders/tif.c ****                         int g = r[x];
 741:Source/render/decoders/tif.c ****                         if (c.photometric == 0) g = 255 - g; /* WhiteIsZero */
 742:Source/render/decoders/tif.c ****                         rows[(size_t)y * c.width + x] = (uint8_t)g;
 743:Source/render/decoders/tif.c ****                     }
 744:Source/render/decoders/tif.c ****                 }
 745:Source/render/decoders/tif.c ****             }
 746:Source/render/decoders/tif.c ****             free(exp);
 747:Source/render/decoders/tif.c ****         }
 748:Source/render/decoders/tif.c ****         free(raw);
 749:Source/render/decoders/tif.c ****     }
 750:Source/render/decoders/tif.c **** 
 751:Source/render/decoders/tif.c ****     if (!ok)
 752:Source/render/decoders/tif.c ****     {
 753:Source/render/decoders/tif.c ****         free(rows);
 754:Source/render/decoders/tif.c ****         return NULL;
 755:Source/render/decoders/tif.c ****     }
 756:Source/render/decoders/tif.c **** 
 757:Source/render/decoders/tif.c ****     /* Downscale target (bmp.c conventions). */
 758:Source/render/decoders/tif.c ****     int scaleNum = 1, scaleDen = 1;
 759:Source/render/decoders/tif.c ****     int targetW = c.width, targetH = c.height;
 760:Source/render/decoders/tif.c ****     if (c.width > 360 || c.height > 200)
 761:Source/render/decoders/tif.c ****     {
 762:Source/render/decoders/tif.c ****         if ((long long)c.width * 200 >= (long long)c.height * 360)
 763:Source/render/decoders/tif.c ****         {
 764:Source/render/decoders/tif.c ****             scaleNum = c.width; scaleDen = 360;
 765:Source/render/decoders/tif.c ****         }
 766:Source/render/decoders/tif.c ****         else
 767:Source/render/decoders/tif.c ****         {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cch3Fgsw.s 			page 46


 768:Source/render/decoders/tif.c ****             scaleNum = c.height; scaleDen = 200;
 769:Source/render/decoders/tif.c ****         }
 770:Source/render/decoders/tif.c ****         targetW = (int)((long long)c.width * scaleDen / scaleNum);
 771:Source/render/decoders/tif.c ****         if (targetW < 1) targetW = 1;
 772:Source/render/decoders/tif.c ****         targetH = (int)((long long)c.height * scaleDen / scaleNum);
 773:Source/render/decoders/tif.c ****         if (targetH < 1) targetH = 1;
 774:Source/render/decoders/tif.c ****     }
 775:Source/render/decoders/tif.c ****     c.scaleNum = scaleNum;
 776:Source/render/decoders/tif.c ****     c.scaleDen = scaleDen;
 777:Source/render/decoders/tif.c **** 
 778:Source/render/decoders/tif.c ****     TifPix p;
 779:Source/render/decoders/tif.c ****     p.c = &c;
 780:Source/render/decoders/tif.c ****     p.rows = rows;
 781:Source/render/decoders/tif.c ****     LCDBitmap *img = dither_to_bitmap(targetW, targetH, tif_pixel_gray, &p);
 782:Source/render/decoders/tif.c ****     free(rows);
 783:Source/render/decoders/tif.c ****     if (img)
 784:Source/render/decoders/tif.c ****     {
 785:Source/render/decoders/tif.c ****         logger_log("TIF ok %dx%d", c.width, c.height);
 786:Source/render/decoders/tif.c ****     }
 787:Source/render/decoders/tif.c ****     return img;
 788:Source/render/decoders/tif.c **** }
