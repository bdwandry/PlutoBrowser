 381:Source/render/decoders/tif.c **** /* Decode one 1D line: color starts white. bits = 1 for black. */
 382:Source/render/decoders/tif.c **** static int g3_line(G3Bit *b, uint8_t *outRow, int w)
 383:Source/render/decoders/tif.c **** {
 384:Source/render/decoders/tif.c ****     int x = 0;
 385:Source/render/decoders/tif.c ****     int color = 0; /* 0 white, 1 black */
 386:Source/render/decoders/tif.c ****     memset(outRow, 0, (size_t)w);
 387:Source/render/decoders/tif.c ****     while (x < w)
 388:Source/render/decoders/tif.c ****     {
 389:Source/render/decoders/tif.c ****         const G3Code *tab;
 390:Source/render/decoders/tif.c ****         int ntab;
 391:Source/render/decoders/tif.c ****         if (color == 0)
 392:Source/render/decoders/tif.c ****         {
 393:Source/render/decoders/tif.c ****             tab = G3_WHITE;
 394:Source/render/decoders/tif.c ****             ntab = 104;
 395:Source/render/decoders/tif.c ****         }
 396:Source/render/decoders/tif.c ****         else
 397:Source/render/decoders/tif.c ****         {
 398:Source/render/decoders/tif.c ****             tab = G3_BLACK;
 399:Source/render/decoders/tif.c ****             ntab = 104;
 400:Source/render/decoders/tif.c ****         }
 401:Source/render/decoders/tif.c ****         int run = -1;
 402:Source/render/decoders/tif.c ****         int used = g3_match(b, b->bitPos, tab, ntab, &run);
 403:Source/render/decoders/tif.c ****         if (used == 0)
 404:Source/render/decoders/tif.c ****         {
 405:Source/render/decoders/tif.c ****             used = g3_match(b, b->bitPos, G3_EXT_MAKEUP,
 406:Source/render/decoders/tif.c ****                             (int)(sizeof(G3_EXT_MAKEUP) / sizeof(G3Code)),
 407:Source/render/decoders/tif.c ****                             &run);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cch3Fgsw.s 			page 15


 408:Source/render/decoders/tif.c ****         }
 409:Source/render/decoders/tif.c ****         if (used == 0)
 410:Source/render/decoders/tif.c ****         {
 411:Source/render/decoders/tif.c ****             /* EOL mid-row or dead data: resync */
 412:Source/render/decoders/tif.c ****             if (g3_eol(b, 0) != 0) return -1;
 413:Source/render/decoders/tif.c ****             return 1; /* signal: line aborted, keep what we have */
 414:Source/render/decoders/tif.c ****         }
 415:Source/render/decoders/tif.c ****         for (int i = 0; i < used; i++) g3_bit(b);
 416:Source/render/decoders/tif.c ****         if (run < 0) return -1;
 417:Source/render/decoders/tif.c ****         if (x + run > w) run = w - x;
 418:Source/render/decoders/tif.c ****         if (color == 1)
 419:Source/render/decoders/tif.c ****         {
 420:Source/render/decoders/tif.c ****             memset(outRow + x, 1, (size_t)run);
 421:Source/render/decoders/tif.c ****         }
 422:Source/render/decoders/tif.c ****         x += run;
 423:Source/render/decoders/tif.c ****         /* T.4: a terminating code (run 0..63) ends the run and the color
 424:Source/render/decoders/tif.c ****          * flips; a makeup code (run >= 64) continues with the SAME color's
 425:Source/render/decoders/tif.c ****          * terminating code. */
 426:Source/render/decoders/tif.c ****         if (run < 64) color ^= 1;
 427:Source/render/decoders/tif.c ****     }
 428:Source/render/decoders/tif.c ****     return 0;
 429:Source/render/decoders/tif.c **** }
