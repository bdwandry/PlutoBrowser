   1:Source/render/decoders/tif.c **** /*
   2:Source/render/decoders/tif.c ****  * PlutoBrowser — tif.c
   3:Source/render/decoders/tif.c ****  * Minimal TIFF decoder (see tif.h for the supported matrix).
   4:Source/render/decoders/tif.c ****  *
   5:Source/render/decoders/tif.c ****  * Design notes:
   6:Source/render/decoders/tif.c ****  *   - Tags are parsed into a small table; values are read through
   7:Source/render/decoders/tif.c ****  *     tif_tag_u32 (handles BYTE/SHORT/LONG inline or at offset).
   8:Source/render/decoders/tif.c ****  *   - LZW decoder: standard TIFF variant (early change = 1 code earlier,
   9:Source/render/decoders/tif.c ****  *     code width bumps at 511/1023/2047, clear=256, EOI=257).
  10:Source/render/decoders/tif.c ****  *   - PackBits: per-row Apple RLE (n>=128 -> repeat next byte 257-n times,
  11:Source/render/decoders/tif.c ****  *     n<128 -> copy n+1 literal bytes, n==128 -> noop).
  12:Source/render/decoders/tif.c ****  *   - CCITT G3 1D: white-run/code tables ( terminating + makeup ), black run
  13:Source/render/decoders/tif.c ****  *     codes, EOL tolerance, 1 = black in the decoded bitstream (photometric
  14:Source/render/decoders/tif.c ****  *     0 flips to white-is-zero afterwards).
  15:Source/render/decoders/tif.c ****  *   - Rows expand to 8-bit gray via palette or direct gray, then the usual
  16:Source/render/decoders/tif.c ****  *     dither_to_bitmap finishes.
  17:Source/render/decoders/tif.c ****  */
  18:Source/render/decoders/tif.c **** #include <string.h>
  19:Source/render/decoders/tif.c **** #include <stdlib.h>
  20:Source/render/decoders/tif.c **** #include "tif.h"
  21:Source/render/decoders/tif.c **** #include "dither.h"
