  34:Source/render/decoders/tif.c ****     int bps;             /* bits per sample (1 or 8) */
  35:Source/render/decoders/tif.c ****     int samples;         /* samples per pixel */
  36:Source/render/decoders/tif.c ****     int predictor;       /* 1 none, 2 horizontal differencing (bps 8) */
  37:Source/render/decoders/tif.c ****     uint32_t stripOff;   /* first strip offset */
  38:Source/render/decoders/tif.c ****     uint32_t stripBytes; /* first strip byte count */
  39:Source/render/decoders/tif.c ****     uint16_t pal[256][3];
  40:Source/render/decoders/tif.c ****     int scaleNum, scaleDen;
  41:Source/render/decoders/tif.c **** } TifCtx;
  42:Source/render/decoders/tif.c **** 
  43:Source/render/decoders/tif.c **** static uint32_t tif_u16(const uint8_t *d, size_t off, size_t len, TifCtx *c)
  44:Source/render/decoders/tif.c **** {
  45:Source/render/decoders/tif.c ****     if (off + 2 > len) return 0;
  46:Source/render/decoders/tif.c ****     return c->bo ? (uint32_t)((d[off] << 8) | d[off + 1])
  47:Source/render/decoders/tif.c ****                  : (uint32_t)((d[off + 1] << 8) | d[off]);
  48:Source/render/decoders/tif.c **** }
  49:Source/render/decoders/tif.c **** 
  50:Source/render/decoders/tif.c **** static uint32_t tif_u32(const uint8_t *d, size_t off, size_t len, TifCtx *c)
  51:Source/render/decoders/tif.c **** {
  52:Source/render/decoders/tif.c ****     if (off + 4 > len) return 0;
  53:Source/render/decoders/tif.c ****     if (c->bo)
  54:Source/render/decoders/tif.c ****         return ((uint32_t)d[off] << 24) | ((uint32_t)d[off + 1] << 16) |
  55:Source/render/decoders/tif.c ****                ((uint32_t)d[off + 2] << 8) | (uint32_t)d[off + 3];
  56:Source/render/decoders/tif.c ****     return ((uint32_t)d[off + 3] << 24) | ((uint32_t)d[off + 2] << 16) |
  57:Source/render/decoders/tif.c ****            ((uint32_t)d[off + 1] << 8) | (uint32_t)d[off];
  58:Source/render/decoders/tif.c **** }
