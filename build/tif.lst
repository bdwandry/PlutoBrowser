 200:Source/render/decoders/tif.c **** /* ── PackBits ──────────────────────────�
 201:Source/render/decoders/tif.c **** 
 202:Source/render/decoders/tif.c **** static size_t packbits_decode(const uint8_t *in, size_t inLen, uint8_t *out,
 203:Source/render/decoders/tif.c ****                               size_t outCap)
 204:Source/render/decoders/tif.c **** {
 205:Source/render/decoders/tif.c ****     size_t ip = 0, op = 0;
 206:Source/render/decoders/tif.c ****     while (ip < inLen && op < outCap)
 207:Source/render/decoders/tif.c ****     {
 208:Source/render/decoders/tif.c ****         int n = (int8_t)in[ip++];
 209:Source/render/decoders/tif.c ****         if (n >= 0)
 210:Source/render/decoders/tif.c ****         {
 211:Source/render/decoders/tif.c ****             size_t cnt = (size_t)n + 1;
 212:Source/render/decoders/tif.c ****             if (ip + cnt > inLen || op + cnt > outCap) break;
 213:Source/render/decoders/tif.c ****             memcpy(out + op, in + ip, cnt);
 214:Source/render/decoders/tif.c ****             ip += cnt;
 215:Source/render/decoders/tif.c ****             op += cnt;
 216:Source/render/decoders/tif.c ****         }
 217:Source/render/decoders/tif.c ****         else if (n != -128)
 218:Source/render/decoders/tif.c ****         {
 219:Source/render/decoders/tif.c ****             size_t cnt = (size_t)(257 - (size_t)(n & 0xFF));
 220:Source/render/decoders/tif.c ****             if (ip >= inLen) break;
 221:Source/render/decoders/tif.c ****             uint8_t v = in[ip++];
 222:Source/render/decoders/tif.c ****             if (op + cnt > outCap) cnt = outCap - op;
 223:Source/render/decoders/tif.c ****             memset(out + op, v, cnt);
 224:Source/render/decoders/tif.c ****             op += cnt;
 225:Source/render/decoders/tif.c ****         }
 226:Source/render/decoders/tif.c ****         /* -128: no-op */
 227:Source/render/decoders/tif.c ****     }
 228:Source/render/decoders/tif.c ****     return op;
 229:Source/render/decoders/tif.c **** }
