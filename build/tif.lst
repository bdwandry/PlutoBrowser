  30:Source/render/decoders/tif.c ****     int bo; /* 0 = little (II), 1 = big (MM) */
  31:Source/render/decoders/tif.c ****     int width, height;
  32:Source/render/decoders/tif.c ****     int compression;     /* 1 none, 5 LZW, 32773 PackBits, 2 G3 */
