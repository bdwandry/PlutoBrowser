 101:Source/render/decoders/tif.c **** /* Emit the string for `code` (recursively via stack walk) and set
 102:Source/render/decoders/tif.c ****  * firstByte. Returns length emitted or -1. */
 103:Source/render/decoders/tif.c **** static uint8_t lzw_rev[4096]; /* static: 4KB exceeds the device stack budget */
 104:Source/render/decoders/tif.c **** 
 105:Source/render/decoders/tif.c **** static int lzw_emit(LzwState *s, int code, int *firstByte)
 106:Source/render/decoders/tif.c **** {
 107:Source/render/decoders/tif.c ****     /* max expansion is bounded; walk the prefix chain into a static buffer */
 108:Source/render/decoders/tif.c ****     uint8_t *rev = lzw_rev;
 109:Source/render/decoders/tif.c ****     int n = 0;
 110:Source/render/decoders/tif.c ****     int fb = -1;
 111:Source/render/decoders/tif.c ****     int c = code;
 112:Source/render/decoders/tif.c ****     while (c >= 256)
 113:Source/render/decoders/tif.c ****     {
 114:Source/render/decoders/tif.c ****         if (c >= 4096) return -1;
 115:Source/render/decoders/tif.c ****         if (n >= 4096) return -1;
 116:Source/render/decoders/tif.c ****         rev[n++] = s->dict[c][1];
 117:Source/render/decoders/tif.c ****         c = s->dict[c][0];
 118:Source/render/decoders/tif.c ****         if (c < 0) return -1;
 119:Source/render/decoders/tif.c ****     }
 120:Source/render/decoders/tif.c ****     if (n >= 4096) return -1;
 121:Source/render/decoders/tif.c ****     rev[n++] = (uint8_t)c;
 122:Source/render/decoders/tif.c ****     fb = c;
 123:Source/render/decoders/tif.c ****     while (n > 0)
 124:Source/render/decoders/tif.c ****     {
 125:Source/render/decoders/tif.c ****         if (!lzw_out(s, rev[--n])) return -1;
 126:Source/render/decoders/tif.c ****     }
 127:Source/render/decoders/tif.c ****     if (firstByte) *firstByte = fb;
 128:Source/render/decoders/tif.c ****     return 0;
 129:Source/render/decoders/tif.c **** }
