 308:Source/render/decoders/tif.c **** /* Match a code at bitPos. ffmpeg's table stores plain right-aligned code
 309:Source/render/decoders/tif.c ****  * values (e.g. white 2 = '0111' = 0x07), so compare acc directly. */
 310:Source/render/decoders/tif.c **** static int g3_match(const G3Bit *b, size_t bitPos, const G3Code *tab,
 311:Source/render/decoders/tif.c ****                     int n, int *run)
 312:Source/render/decoders/tif.c **** {
 313:Source/render/decoders/tif.c ****     uint32_t acc = 0;
 314:Source/render/decoders/tif.c ****     size_t maxBits = b->len * 8 - bitPos;
 315:Source/render/decoders/tif.c ****     for (int i = 0; i < 13; i++)
 316:Source/render/decoders/tif.c ****     {
 317:Source/render/decoders/tif.c ****         if ((size_t)i >= maxBits) break;
 318:Source/render/decoders/tif.c ****         int bit = (b->data[(bitPos + (size_t)i) >> 3] >>
 319:Source/render/decoders/tif.c ****                    (7 - ((bitPos + (size_t)i) & 7))) & 1;
 320:Source/render/decoders/tif.c ****         acc = (acc << 1) | (uint32_t)bit;
 321:Source/render/decoders/tif.c ****         for (int j = 0; j < n; j++)
 322:Source/render/decoders/tif.c ****         {
 323:Source/render/decoders/tif.c ****             if (tab[j].bits == i + 1 && (uint32_t)tab[j].code == acc)
 324:Source/render/decoders/tif.c ****             {
 325:Source/render/decoders/tif.c ****                 *run = tab[j].run;
 326:Source/render/decoders/tif.c ****                 return i + 1;
 327:Source/render/decoders/tif.c ****             }
 328:Source/render/decoders/tif.c ****         }
 329:Source/render/decoders/tif.c ****     }
 330:Source/render/decoders/tif.c ****     return 0;
 331:Source/render/decoders/tif.c **** }
