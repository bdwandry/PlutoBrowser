 255:src/core/encoding.c ****         return NULL;
 256:src/core/encoding.c ****     }
 257:src/core/encoding.c ****     {
 258:src/core/encoding.c ****         char* norm = encoding_normalize_charset(tok);
 259:src/core/encoding.c ****         pluto_free(tok);
 260:src/core/encoding.c ****         return norm;
 261:src/core/encoding.c ****     }
 262:src/core/encoding.c **** }
 263:src/core/encoding.c **** 
 264:src/core/encoding.c **** char* encoding_scan_meta_charset(const char* data, size_t len)
 265:src/core/encoding.c **** {
 266:src/core/encoding.c ****     size_t limit = len < 1024 ? len : 1024;
 267:src/core/encoding.c ****     const char* head = data;
 268:src/core/encoding.c ****     size_t i;
 269:src/core/encoding.c **** 
 270:src/core/encoding.c ****     if (limit == 0) {
 271:src/core/encoding.c ****         return NULL;
 272:src/core/encoding.c ****     }
 273:src/core/encoding.c **** 
 274:src/core/encoding.c ****     for (i = 0; i + 5 <= limit; i++) {
 275:src/core/encoding.c ****         size_t spanStart, spanEnd, occ[64];
 276:src/core/encoding.c ****         size_t nOcc = 0, k;
 277:src/core/encoding.c **** 
 278:src/core/encoding.c ****         if (memcmp(head + i, "<meta", 5) != 0) {
 279:src/core/encoding.c ****             continue;
 280:src/core/encoding.c ****         }
 281:src/core/encoding.c ****         spanStart = i + 5;
 282:src/core/encoding.c ****         spanEnd = limit;
 283:src/core/encoding.c ****         for (k = spanStart; k < limit; k++) {
 284:src/core/encoding.c ****             if (head[k] == '>') { // [^>]* cannot cross '>'
 285:src/core/encoding.c ****                 spanEnd = k;
 286:src/core/encoding.c ****                 break;
 287:src/core/encoding.c ****             }
 288:src/core/encoding.c ****         }
 289:src/core/encoding.c **** 
 290:src/core/encoding.c ****         // Collect "charset" occurrences, try RIGHT-to-LEFT (greedy backtrack).
 291:src/core/encoding.c ****         for (k = spanStart; k + 7 <= spanEnd && nOcc < 64; k++) {
 292:src/core/encoding.c ****             if (memcmp(head + k, "charset", 7) == 0) {
 293:src/core/encoding.c ****                 occ[nOcc++] = k;
 294:src/core/encoding.c ****             }
 295:src/core/encoding.c ****         }
 296:src/core/encoding.c ****         while (nOcc > 0) {
 297:src/core/encoding.c ****             size_t next;
 298:src/core/encoding.c ****             char* tok =
 299:src/core/encoding.c ****                 take_charset_value(head, spanEnd, occ[--nOcc] + 7, &next);
 300:src/core/encoding.c ****             if (tok != NULL) {
 301:src/core/encoding.c ****                 char* norm = encoding_normalize_charset(tok);
 302:src/core/encoding.c ****                 pluto_free(tok);
 303:src/core/encoding.c ****                 return norm;
 304:src/core/encoding.c ****             }
 305:src/core/encoding.c ****         }
 306:src/core/encoding.c ****     }
 307:src/core/encoding.c ****     return NULL;
 308:src/core/encoding.c **** }
