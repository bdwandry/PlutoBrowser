 143:src/core/encoding.c **** // ------------------------------------------------- charset naming ----
 144:src/core/encoding.c **** 
 145:src/core/encoding.c **** char* encoding_normalize_charset(const char* name)
 146:src/core/encoding.c **** {
 147:src/core/encoding.c ****     StrBuf out;
 148:src/core/encoding.c ****     const char* p;
 149:src/core/encoding.c ****     char* s;
 150:src/core/encoding.c **** 
 151:src/core/encoding.c ****     if (name == NULL) {
 152:src/core/encoding.c ****         return NULL;
 153:src/core/encoding.c ****     }
 154:src/core/encoding.c ****     sb_init(&out);
 155:src/core/encoding.c ****     for (p = name; *p != '\0'; p++) {
 156:src/core/encoding.c ****         if (ascii_alnum((unsigned char)*p)) {
 157:src/core/encoding.c ****             sb_append_char(&out, (char)tolower((unsigned char)*p));
 158:src/core/encoding.c ****         }
 159:src/core/encoding.c ****     }
 160:src/core/encoding.c ****     s = sb_detach(&out);
 161:src/core/encoding.c ****     if (strcmp(s, "utf8") == 0 || strcmp(s, "utf8mb4") == 0) {
 162:src/core/encoding.c ****         pluto_free(s);
 163:src/core/encoding.c ****         return pluto_strdup("utf-8");
 164:src/core/encoding.c ****     }
 165:src/core/encoding.c ****     if (strcmp(s, "cp1252") == 0 || strcmp(s, "windows1252") == 0 ||
 166:src/core/encoding.c ****         strcmp(s, "latin1") == 0 || strcmp(s, "iso88591") == 0 ||
 167:src/core/encoding.c ****         strcmp(s, "iso8859") == 0) {
 168:src/core/encoding.c ****         pluto_free(s);
 169:src/core/encoding.c ****         return pluto_strdup("cp1252");
 170:src/core/encoding.c ****     }
 171:src/core/encoding.c ****     // utf16 / utf16le / utf16be pass through unchanged
 172:src/core/encoding.c ****     if (strcmp(s, "ascii") == 0 || strcmp(s, "usascii") == 0) {
 173:src/core/encoding.c ****         pluto_free(s);
 174:src/core/encoding.c ****         return pluto_strdup("ascii");
 175:src/core/encoding.c ****     }
 176:src/core/encoding.c ****     if (strcmp(s, "shiftjis") == 0 || strcmp(s, "sjis") == 0) {
 177:src/core/encoding.c ****         pluto_free(s);
 178:src/core/encoding.c ****         return pluto_strdup("shift_jis");
 179:src/core/encoding.c ****     }
 180:src/core/encoding.c ****     return s;
 181:src/core/encoding.c **** }
 182:src/core/encoding.c **** 
 183:src/core/encoding.c **** // Tries to read an unquoted token value after "charset" starting at j.
 184:src/core/encoding.c **** // Pattern piece: charset%s*=%s*["']?([%w%+%-_%.]+)
 185:src/core/encoding.c **** // Returns malloc'd token and sets *next, or NULL (no side effects).
 186:src/core/encoding.c **** // NOTE: a '"'/'\'' immediately before the token KILLS this alignment
 187:src/core/encoding.c **** // (only ONE optional quote is consumed pre-capture) — quoted header
 188:src/core/encoding.c **** // values therefore fail, exactly like the Lua pattern.
 189:src/core/encoding.c **** static char* take_charset_value(const char* s, size_t slen, size_t j,
 190:src/core/encoding.c ****                                 size_t* next)
 191:src/core/encoding.c **** {
 192:src/core/encoding.c ****     size_t k = j;
 193:src/core/encoding.c ****     StrBuf tok;
 194:src/core/encoding.c **** 
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc2i2cHt.s 			page 6


 195:src/core/encoding.c ****     while (k < slen && ascii_ws((unsigned char)s[k])) {
 196:src/core/encoding.c ****         k++;
 197:src/core/encoding.c ****     }
 198:src/core/encoding.c ****     if (k >= slen || s[k] != '=') {
 199:src/core/encoding.c ****         return NULL;
 200:src/core/encoding.c ****     }
 201:src/core/encoding.c ****     k++;
 202:src/core/encoding.c ****     while (k < slen && ascii_ws((unsigned char)s[k])) {
 203:src/core/encoding.c ****         k++;
 204:src/core/encoding.c ****     }
 205:src/core/encoding.c ****     if (k < slen && (s[k] == '"' || s[k] == '\'')) {
 206:src/core/encoding.c ****         k++;
 207:src/core/encoding.c ****     }
 208:src/core/encoding.c ****     sb_init(&tok);
 209:src/core/encoding.c ****     while (k < slen) {
 210:src/core/encoding.c ****         unsigned char c = (unsigned char)s[k];
 211:src/core/encoding.c ****         if (!ascii_alnum(c) && c != '+' && c != '-' && c != '_' && c != '.') {
 212:src/core/encoding.c ****             break;
 213:src/core/encoding.c ****         }
 214:src/core/encoding.c ****         sb_append_char(&tok, (char)c);
 215:src/core/encoding.c ****         k++;
 216:src/core/encoding.c ****     }
 217:src/core/encoding.c ****     if (tok.len == 0) {
 218:src/core/encoding.c ****         sb_free(&tok);
 219:src/core/encoding.c ****         return NULL;
 220:src/core/encoding.c ****     }
 221:src/core/encoding.c ****     *next = k;
 222:src/core/encoding.c ****     return sb_detach(&tok);
 223:src/core/encoding.c **** }
 224:src/core/encoding.c **** 
 225:src/core/encoding.c **** char* encoding_charset_from_header(const char* contentType)
 226:src/core/encoding.c **** {
 227:src/core/encoding.c ****     size_t n, i, pos;
 228:src/core/encoding.c ****     char* lower;
 229:src/core/encoding.c ****     char* tok = NULL;
 230:src/core/encoding.c **** 
 231:src/core/encoding.c ****     if (contentType == NULL) {
 232:src/core/encoding.c ****         return NULL;
 233:src/core/encoding.c ****     }
 234:src/core/encoding.c ****     n = strlen(contentType);
 235:src/core/encoding.c ****     lower = pluto_malloc(n + 1);
 236:src/core/encoding.c ****     if (lower == NULL) {
 237:src/core/encoding.c ****         return NULL;
 238:src/core/encoding.c ****     }
 239:src/core/encoding.c ****     for (i = 0; i < n; i++) {
 240:src/core/encoding.c ****         lower[i] = (char)tolower((unsigned char)contentType[i]);
 241:src/core/encoding.c ****     }
 242:src/core/encoding.c ****     lower[n] = '\0';
 243:src/core/encoding.c **** 
 244:src/core/encoding.c ****     // Unanchored Lua match: FIRST "charset" occurrence wins.
 245:src/core/encoding.c ****     for (i = 0; i + 7 <= n; i++) {
 246:src/core/encoding.c ****         if (memcmp(lower + i, "charset", 7) == 0) {
 247:src/core/encoding.c ****             tok = take_charset_value(lower, n, i + 7, &pos);
 248:src/core/encoding.c ****             if (tok != NULL) {
 249:src/core/encoding.c ****                 break;
 250:src/core/encoding.c ****             }
 251:src/core/encoding.c ****         }
