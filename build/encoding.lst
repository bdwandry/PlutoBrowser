  31:src/core/encoding.c **** static int ascii_ws(unsigned char c)
  32:src/core/encoding.c **** {
  33:src/core/encoding.c ****     return c == ' ' || c == '\t' || c == '\n' || c == '\v' || c == '\f' ||
  34:src/core/encoding.c ****            c == '\r';
  35:src/core/encoding.c **** }
  36:src/core/encoding.c **** 
  37:src/core/encoding.c **** static int ascii_alnum(unsigned char c)
  38:src/core/encoding.c **** {
  39:src/core/encoding.c ****     return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
  40:src/core/encoding.c ****            (c >= '0' && c <= '9');
  41:src/core/encoding.c **** }
  42:src/core/encoding.c **** 
  43:src/core/encoding.c **** // ------------------------------------------------------- utf8Encode ----
  44:src/core/encoding.c **** 
  45:src/core/encoding.c **** static void utf8_encode_cp(StrBuf* out, unsigned cp)
  46:src/core/encoding.c **** {
  47:src/core/encoding.c ****     if (cp < 0x80) {
  48:src/core/encoding.c ****         sb_append_char(out, (char)cp);
  49:src/core/encoding.c ****     } else if (cp < 0x800) {
  50:src/core/encoding.c ****         sb_append_char(out, (char)(0xC0 + cp / 0x40));
  51:src/core/encoding.c ****         sb_append_char(out, (char)(0x80 + (cp % 0x40)));
  52:src/core/encoding.c ****     } else if (cp < 0x10000) {
  53:src/core/encoding.c ****         sb_append_char(out, (char)(0xE0 + cp / 0x1000));
  54:src/core/encoding.c ****         sb_append_char(out, (char)(0x80 + ((cp / 0x40) % 0x40)));
  55:src/core/encoding.c ****         sb_append_char(out, (char)(0x80 + (cp % 0x40)));
  56:src/core/encoding.c ****     } else if (cp < 0x110000) {
  57:src/core/encoding.c ****         sb_append_char(out, (char)(0xF0 + cp / 0x40000));
  58:src/core/encoding.c ****         sb_append_char(out, (char)(0x80 + ((cp / 0x1000) % 0x40)));
  59:src/core/encoding.c ****         sb_append_char(out, (char)(0x80 + ((cp / 0x40) % 0x40)));
  60:src/core/encoding.c ****         sb_append_char(out, (char)(0x80 + (cp % 0x40)));
  61:src/core/encoding.c ****     } else {
  62:src/core/encoding.c ****         sb_append_char(out, '?');
  63:src/core/encoding.c ****     }
  64:src/core/encoding.c **** }
  65:src/core/encoding.c **** 
  66:src/core/encoding.c **** // ---------------------------------------------------- CP1252 table ----
  67:src/core/encoding.c **** 
  68:src/core/encoding.c **** static unsigned cp1252_codepoint(unsigned char b)
  69:src/core/encoding.c **** {
  70:src/core/encoding.c ****     switch (b) {
  71:src/core/encoding.c ****     case 0x80: return 0x20AC; case 0x81: return 0x0081;
  72:src/core/encoding.c ****     case 0x82: return 0x201A; case 0x83: return 0x0192;
  73:src/core/encoding.c ****     case 0x84: return 0x201E; case 0x85: return 0x2026;
  74:src/core/encoding.c ****     case 0x86: return 0x2020; case 0x87: return 0x2021;
  75:src/core/encoding.c ****     case 0x88: return 0x02C6; case 0x89: return 0x2030;
  76:src/core/encoding.c ****     case 0x8A: return 0x0160; case 0x8B: return 0x2039;
  77:src/core/encoding.c ****     case 0x8C: return 0x0152; case 0x8D: return 0x008D;
  78:src/core/encoding.c ****     case 0x8E: return 0x017D; case 0x8F: return 0x008F;
  79:src/core/encoding.c ****     case 0x90: return 0x0090; case 0x91: return 0x2018;
  80:src/core/encoding.c ****     case 0x92: return 0x2019; case 0x93: return 0x201C;
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc2i2cHt.s 			page 4


  81:src/core/encoding.c ****     case 0x94: return 0x201D; case 0x95: return 0x2022;
  82:src/core/encoding.c ****     case 0x96: return 0x2013; case 0x97: return 0x2014;
  83:src/core/encoding.c ****     case 0x98: return 0x02DC; case 0x99: return 0x2122;
  84:src/core/encoding.c ****     case 0x9A: return 0x0161; case 0x9B: return 0x203A;
  85:src/core/encoding.c ****     case 0x9C: return 0x0153; case 0x9D: return 0x009D;
  86:src/core/encoding.c ****     case 0x9E: return 0x017E; case 0x9F: return 0x0178;
  87:src/core/encoding.c ****     default: return b;
  88:src/core/encoding.c ****     }
  89:src/core/encoding.c **** }
  90:src/core/encoding.c **** 
  91:src/core/encoding.c **** static void from_single_byte(const char* data, size_t len, StrBuf* out)
  92:src/core/encoding.c **** {
  93:src/core/encoding.c ****     size_t i;
  94:src/core/encoding.c ****     for (i = 0; i < len; i++) {
  95:src/core/encoding.c ****         unsigned char b = (unsigned char)data[i];
  96:src/core/encoding.c ****         unsigned cp;
  97:src/core/encoding.c ****         if (b < 0x80 || b >= 0xA0) {
  98:src/core/encoding.c ****             cp = b;
  99:src/core/encoding.c ****         } else {
 100:src/core/encoding.c ****             cp = cp1252_codepoint(b);
 101:src/core/encoding.c ****         }
 102:src/core/encoding.c ****         utf8_encode_cp(out, cp);
 103:src/core/encoding.c ****     }
 104:src/core/encoding.c **** }
 105:src/core/encoding.c **** 
 106:src/core/encoding.c **** // --------------------------------------------------------- UTF-16 ----
 107:src/core/encoding.c **** 
 108:src/core/encoding.c **** static void from_utf16(const char* data, size_t len, int littleEndian,
 109:src/core/encoding.c ****                        StrBuf* out)
 110:src/core/encoding.c **** {
 111:src/core/encoding.c ****     size_t i = 0;
 112:src/core/encoding.c ****     while (len >= 2 && i + 1 < len) {
 113:src/core/encoding.c ****         unsigned lo = (unsigned char)data[i];
 114:src/core/encoding.c ****         unsigned hi = (unsigned char)data[i + 1];
 115:src/core/encoding.c ****         unsigned u;
 116:src/core/encoding.c ****         i += 2;
 117:src/core/encoding.c ****         u = littleEndian ? (lo + hi * 256) : (hi + lo * 256);
 118:src/core/encoding.c **** 
 119:src/core/encoding.c ****         if (u >= 0xD800 && u <= 0xDBFF) {
 120:src/core/encoding.c ****             unsigned llo, lhi, lo2;
 121:src/core/encoding.c ****             if (i + 1 >= len) {
 122:src/core/encoding.c ****                 break; // readUnit() nil -> loop exits
 123:src/core/encoding.c ****             }
 124:src/core/encoding.c ****             llo = (unsigned char)data[i];
 125:src/core/encoding.c ****             lhi = (unsigned char)data[i + 1];
 126:src/core/encoding.c ****             i += 2;
 127:src/core/encoding.c ****             lo2 = littleEndian ? (llo + lhi * 256) : (lhi + llo * 256);
 128:src/core/encoding.c ****             if (lo2 >= 0xDC00 && lo2 <= 0xDFFF) {
 129:src/core/encoding.c ****                 unsigned cp =
 130:src/core/encoding.c ****                     0x10000 + ((u - 0xD800) * 0x400) + (lo2 - 0xDC00);
 131:src/core/encoding.c ****                 utf8_encode_cp(out, cp);
 132:src/core/encoding.c ****             } else {
 133:src/core/encoding.c ****                 sb_append_char(out, '?'); // low unit already consumed!
 134:src/core/encoding.c ****             }
 135:src/core/encoding.c ****         } else if (u >= 0xDC00 && u <= 0xDFFF) {
 136:src/core/encoding.c ****             sb_append_char(out, '?');
 137:src/core/encoding.c ****         } else {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//cc2i2cHt.s 			page 5


 138:src/core/encoding.c ****             utf8_encode_cp(out, u);
 139:src/core/encoding.c ****         }
 140:src/core/encoding.c ****     }
 141:src/core/encoding.c **** }
