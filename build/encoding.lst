 219:Source/core/encoding.c **** /* Scan the first `limit` bytes of an HTML document for a charset declaration.
 220:Source/core/encoding.c ****  * Lua used two patterns:
 221:Source/core/encoding.c ****  *   '<meta[^>]*charset%s*=%s*["\']?([%w%+%-_%.]+)'
 222:Source/core/encoding.c ****  *   '<meta[^>]*content%s*=%s*["\']?[^"\'>]*charset%s*=%s*["\']?([%w%+%-_%.]+)'
 223:Source/core/encoding.c ****  * The second is subsumed by the first for our purposes (both end in the same
 224:Source/core/encoding.c ****  * "charset = token" capture); we scan case-insensitively for "charset",
 225:Source/core/encoding.c ****  * optional spaces, '=', optional spaces, optional quote, then the token. */
 226:Source/core/encoding.c **** static int scan_meta_charset(const unsigned char *data, size_t len, size_t limit,
 227:Source/core/encoding.c ****                              char *out, size_t outCap)
 228:Source/core/encoding.c **** {
 229:Source/core/encoding.c ****     size_t n = (limit && limit < len) ? limit : len;
 230:Source/core/encoding.c ****     /* Copy into a NUL-terminated scratch buffer, lowercased, for ci_strstr. */
 231:Source/core/encoding.c ****     static char head[1025];
 232:Source/core/encoding.c ****     if (n >= sizeof(head))
 233:Source/core/encoding.c ****     {
 234:Source/core/encoding.c ****         n = sizeof(head) - 1;
 235:Source/core/encoding.c ****     }
 236:Source/core/encoding.c ****     for (size_t i = 0; i < n; i++)
 237:Source/core/encoding.c ****     {
 238:Source/core/encoding.c ****         char c = (char)data[i];
 239:Source/core/encoding.c ****         if (c >= 'A' && c <= 'Z')
 240:Source/core/encoding.c ****         {
 241:Source/core/encoding.c ****             c = (char)(c - 'A' + 'a');
 242:Source/core/encoding.c ****         }
 243:Source/core/encoding.c ****         head[i] = c;
 244:Source/core/encoding.c ****     }
 245:Source/core/encoding.c ****     head[n] = '\0';
 246:Source/core/encoding.c **** 
 247:Source/core/encoding.c ****     const char *p = head;
 248:Source/core/encoding.c ****     while ((p = ci_strstr(p, "charset")) != NULL)
 249:Source/core/encoding.c ****     {
 250:Source/core/encoding.c ****         const char *q = p + 7;
 251:Source/core/encoding.c ****         while (*q == ' ' || *q == '\t' || *q == '\n' || *q == '\r')
 252:Source/core/encoding.c ****         {
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccfYJRBR.s 			page 30


 253:Source/core/encoding.c ****             q++;
 254:Source/core/encoding.c ****         }
 255:Source/core/encoding.c ****         if (*q == '=')
 256:Source/core/encoding.c ****         {
 257:Source/core/encoding.c ****             q++;
 258:Source/core/encoding.c ****             while (*q == ' ' || *q == '\t' || *q == '\n' || *q == '\r')
 259:Source/core/encoding.c ****             {
 260:Source/core/encoding.c ****                 q++;
 261:Source/core/encoding.c ****             }
 262:Source/core/encoding.c ****             if (*q == '"' || *q == '\'')
 263:Source/core/encoding.c ****             {
 264:Source/core/encoding.c ****                 q++;
 265:Source/core/encoding.c ****             }
 266:Source/core/encoding.c ****             /* extract token [A-Za-z0-9+-.] (plus _ per Lua class) */
 267:Source/core/encoding.c ****             char tok[64];
 268:Source/core/encoding.c ****             size_t t = 0;
 269:Source/core/encoding.c ****             while (*q && t + 1 < sizeof(tok))
 270:Source/core/encoding.c ****             {
 271:Source/core/encoding.c ****                 char c = *q;
 272:Source/core/encoding.c ****                 int ok = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
 273:Source/core/encoding.c ****                          (c >= 'A' && c <= 'Z') || c == '+' || c == '-' ||
 274:Source/core/encoding.c ****                          c == '_' || c == '.';
 275:Source/core/encoding.c ****                 if (!ok)
 276:Source/core/encoding.c ****                 {
 277:Source/core/encoding.c ****                     break;
 278:Source/core/encoding.c ****                 }
 279:Source/core/encoding.c ****                 tok[t++] = c;
 280:Source/core/encoding.c ****                 q++;
 281:Source/core/encoding.c ****             }
 282:Source/core/encoding.c ****             tok[t] = '\0';
 283:Source/core/encoding.c ****             if (t > 0 && normalize_charset(tok, out, outCap))
 284:Source/core/encoding.c ****             {
 285:Source/core/encoding.c ****                 return 1;
 286:Source/core/encoding.c ****             }
 287:Source/core/encoding.c ****         }
 288:Source/core/encoding.c ****         p += 7;
 289:Source/core/encoding.c ****     }
 290:Source/core/encoding.c ****     return 0;
 291:Source/core/encoding.c **** }
