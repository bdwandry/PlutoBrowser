 328:Source/core/encoding.c ****         int ok = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
 329:Source/core/encoding.c ****                  (c >= '0' && c <= '9') || c == '+' || c == '-' || c == '_' || c == '.';
 330:Source/core/encoding.c ****         if (!ok)
 331:Source/core/encoding.c ****         {
 332:Source/core/encoding.c ****             break;
