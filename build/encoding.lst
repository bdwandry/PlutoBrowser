   1:src/core/encoding.c **** // encoding.c — charset detection & conversion (C port of core/encoding.lua).
   2:src/core/encoding.c **** //
   3:src/core/encoding.c **** // Ground truth: host-Lua oracle p06_oracle.lua on the REAL encoding.lua.
   4:src/core/encoding.c **** // Verified quirks preserved:
   5:src/core/encoding.c **** //   - charset="utf-8" (QUOTED value in a Content-Type HEADER) fails the Lua
   6:src/core/encoding.c **** //     pattern -> NULL (meta scan then applies per precedence)
   7:src/core/encoding.c **** //   - normalizeCharset("euc-jp") strips to "eucjp"; shift_jis/eucjp/gbk/big5
   8:src/core/encoding.c **** //     dispatch through single-byte best-effort
   9:src/core/encoding.c **** //   - "utf16" (no endianness) normalizes but is NOT dispatched -> verbatim
  10:src/core/encoding.c **** //   - UTF-16LE with one trailing stray byte decodes to ""
  11:src/core/encoding.c **** //   - lone high surrogate CONSUMES the next unit before emitting "?"
  12:src/core/encoding.c **** //   - bytes <0x80 pass through raw (incl. 0x00/0x7F); 0x80-0x9F CP1252 table;
  13:src/core/encoding.c **** //     >=0xA0 Latin-1
  14:src/core/encoding.c **** //   - meta scan: Lua pattern '<meta[^>]*charset...' uses GREEDY [^>]*, so a
  15:src/core/encoding.c **** //     tag with duplicate charset= attributes resolves to the LAST one
  16:src/core/encoding.c **** //     (occurrences tried right-to-left within the tag span).
