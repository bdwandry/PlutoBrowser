 293:Source/core/encoding.c **** /* Extract charset from an HTTP Content-Type header value. */
 294:Source/core/encoding.c **** static int charset_from_header(const char *contentType, char *out, size_t outCap)
 295:Source/core/encoding.c **** {
 296:Source/core/encoding.c ****     if (!contentType)
 297:Source/core/encoding.c ****     {
 298:Source/core/encoding.c ****         return 0;
 299:Source/core/encoding.c ****     }
 300:Source/core/encoding.c ****     const char *p = ci_strstr(contentType, "charset");
 301:Source/core/encoding.c ****     if (!p)
 302:Source/core/encoding.c ****     {
 303:Source/core/encoding.c ****         return 0;
 304:Source/core/encoding.c ****     }
 305:Source/core/encoding.c ****     p += 7;
 306:Source/core/encoding.c ****     while (*p == ' ' || *p == '\t')
 307:Source/core/encoding.c ****     {
 308:Source/core/encoding.c ****         p++;
 309:Source/core/encoding.c ****     }
