 234:Source/html/jsenv.c **** /* ── Script extraction (mirrors the tokenizer's <script> skip rules) ─────── */
 235:Source/html/jsenv.c **** static const char *find_str(const char *hay, const char *end, const char *needle,
 236:Source/html/jsenv.c ****                             size_t nlen)
 237:Source/html/jsenv.c **** {
 238:Source/html/jsenv.c ****     if (nlen == 0 || (size_t)(end - hay) < nlen)
 239:Source/html/jsenv.c ****     {
 240:Source/html/jsenv.c ****         return NULL;
 241:Source/html/jsenv.c ****     }
 242:Source/html/jsenv.c ****     for (const char *p = hay; p + nlen <= end; p++)
 243:Source/html/jsenv.c ****     {
 244:Source/html/jsenv.c ****         if (*p == needle[0] && memcmp(p, needle, nlen) == 0)
 245:Source/html/jsenv.c ****         {
 246:Source/html/jsenv.c ****             return p;
 247:Source/html/jsenv.c ****         }
 248:Source/html/jsenv.c ****     }
 249:Source/html/jsenv.c ****     return NULL;
 250:Source/html/jsenv.c **** }
 251:Source/html/jsenv.c **** 
 252:Source/html/jsenv.c **** static int ci_has_prefix(const char *s, size_t maxlen, const char *prefix)
 253:Source/html/jsenv.c **** {
 254:Source/html/jsenv.c ****     size_t n = strlen(prefix);
 255:Source/html/jsenv.c ****     if (maxlen < n)
 256:Source/html/jsenv.c ****     {
 257:Source/html/jsenv.c ****         return 0;
 258:Source/html/jsenv.c ****     }
 259:Source/html/jsenv.c ****     for (size_t i = 0; i < n; i++)
 260:Source/html/jsenv.c ****     {
 261:Source/html/jsenv.c ****         char a = s[i];
 262:Source/html/jsenv.c ****         if (a >= 'A' && a <= 'Z')
 263:Source/html/jsenv.c ****         {
 264:Source/html/jsenv.c ****             a = (char)(a - 'A' + 'a');
 265:Source/html/jsenv.c ****         }
 266:Source/html/jsenv.c ****         if (a != prefix[i])
 267:Source/html/jsenv.c ****         {
 268:Source/html/jsenv.c ****             return 0;
 269:Source/html/jsenv.c ****         }
 270:Source/html/jsenv.c ****     }
 271:Source/html/jsenv.c ****     return 1;
 272:Source/html/jsenv.c **** }
