 340:Source/html/jsenv.c **** /* Extract <script> body spans. Writes up to max spans; returns count found
 341:Source/html/jsenv.c ****  * (may exceed max — caller only executes the first max). */
 342:Source/html/jsenv.c **** static int extract_scripts(const char *html, const char **starts,
 343:Source/html/jsenv.c ****                            size_t *lens, int max)
 344:Source/html/jsenv.c **** {
 345:Source/html/jsenv.c ****     const char *pos = html;
 346:Source/html/jsenv.c ****     const char *end = html + strlen(html);
 347:Source/html/jsenv.c ****     int count = 0;
 348:Source/html/jsenv.c **** 
 349:Source/html/jsenv.c ****     while (pos < end)
 350:Source/html/jsenv.c ****     {
 351:Source/html/jsenv.c ****         const char *lt = memchr(pos, '<', (size_t)(end - pos));
 352:Source/html/jsenv.c ****         if (!lt)
 353:Source/html/jsenv.c ****         {
 354:Source/html/jsenv.c ****             break;
 355:Source/html/jsenv.c ****         }
 356:Source/html/jsenv.c ****         const char *gt = find_str(lt, end, ">", 1);
 357:Source/html/jsenv.c ****         if (!gt)
 358:Source/html/jsenv.c ****         {
 359:Source/html/jsenv.c ****             break;
 360:Source/html/jsenv.c ****         }
 361:Source/html/jsenv.c ****         /* interior of the tag */
 362:Source/html/jsenv.c ****         const char *b = lt + 1;
 363:Source/html/jsenv.c ****         const char *e = gt;
 364:Source/html/jsenv.c ****         while (b < e && (*b == ' ' || *b == '\t'))
 365:Source/html/jsenv.c ****         {
 366:Source/html/jsenv.c ****             b++;
 367:Source/html/jsenv.c ****         }
 368:Source/html/jsenv.c ****         if (!ci_has_prefix(b, (size_t)(e - b), "script"))
 369:Source/html/jsenv.c ****         {
 370:Source/html/jsenv.c ****             pos = gt + 1;
 371:Source/html/jsenv.c ****             continue;
 372:Source/html/jsenv.c ****         }
 373:Source/html/jsenv.c ****         /* a real <script ...> open tag: next non-space after name must not
 374:Source/html/jsenv.c ****          * be a letter (else it's <scriptx ...) */
 375:Source/html/jsenv.c ****         const char *afterName = b + 6;
 376:Source/html/jsenv.c ****         if (afterName < e &&
 377:Source/html/jsenv.c ****             ((*afterName >= 'a' && *afterName <= 'z') ||
 378:Source/html/jsenv.c ****              (*afterName >= 'A' && *afterName <= 'Z')))
 379:Source/html/jsenv.c ****         {
 380:Source/html/jsenv.c ****             pos = gt + 1;
 381:Source/html/jsenv.c ****             continue;
 382:Source/html/jsenv.c ****         }
 383:Source/html/jsenv.c **** 
 384:Source/html/jsenv.c ****         /* find closing </script (case-insensitive per HTML spec; the real
 385:Source/html/jsenv.c ****          * world is lowercase, so scan both) */
 386:Source/html/jsenv.c ****         const char *close = find_str(gt + 1, end, "</script", 8);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccmTOh1J.s 			page 30


 387:Source/html/jsenv.c ****         if (!close)
 388:Source/html/jsenv.c ****         {
 389:Source/html/jsenv.c ****             const char *c2 = gt + 1;
 390:Source/html/jsenv.c ****             /* case-insensitive scan */
 391:Source/html/jsenv.c ****             while (c2 + 8 <= end)
 392:Source/html/jsenv.c ****             {
 393:Source/html/jsenv.c ****                 if ((c2[0] == '<' || c2[0] == '<') &&
 394:Source/html/jsenv.c ****                     (c2[1] == '/' || c2[1] == '/') &&
 395:Source/html/jsenv.c ****                     (c2[2] | 0x20) == 's' && (c2[3] | 0x20) == 'c' &&
 396:Source/html/jsenv.c ****                     (c2[4] | 0x20) == 'r' && (c2[5] | 0x20) == 'i' &&
 397:Source/html/jsenv.c ****                     (c2[6] | 0x20) == 'p' && (c2[7] | 0x20) == 't')
 398:Source/html/jsenv.c ****                 {
 399:Source/html/jsenv.c ****                     close = c2;
 400:Source/html/jsenv.c ****                     break;
 401:Source/html/jsenv.c ****                 }
 402:Source/html/jsenv.c ****                 c2++;
 403:Source/html/jsenv.c ****             }
 404:Source/html/jsenv.c ****         }
 405:Source/html/jsenv.c ****         if (!close)
 406:Source/html/jsenv.c ****         {
 407:Source/html/jsenv.c ****             break; /* unterminated: drop (tokenizer parity) */
 408:Source/html/jsenv.c ****         }
 409:Source/html/jsenv.c **** 
 410:Source/html/jsenv.c ****         if (count < max)
 411:Source/html/jsenv.c ****         {
 412:Source/html/jsenv.c ****             starts[count] = gt + 1;
 413:Source/html/jsenv.c ****             lens[count] = (size_t)(close - (gt + 1));
 414:Source/html/jsenv.c ****         }
 415:Source/html/jsenv.c ****         count++;
 416:Source/html/jsenv.c **** 
 417:Source/html/jsenv.c ****         pos = close + 8;
 418:Source/html/jsenv.c ****         /* skip to after the '>' of </script ...> */
 419:Source/html/jsenv.c ****         while (pos < end && *pos != '>')
 420:Source/html/jsenv.c ****         {
 421:Source/html/jsenv.c ****             pos++;
 422:Source/html/jsenv.c ****         }
 423:Source/html/jsenv.c ****         if (pos < end)
 424:Source/html/jsenv.c ****         {
 425:Source/html/jsenv.c ****             pos++;
 426:Source/html/jsenv.c ****         }
 427:Source/html/jsenv.c ****     }
 428:Source/html/jsenv.c ****     return count;
 429:Source/html/jsenv.c **** }
