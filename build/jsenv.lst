 274:Source/html/jsenv.c **** /* Copy a case-insensitive attribute value out of a tag interior span.
 275:Source/html/jsenv.c ****  * Returns length written (0 = not found). value gets NUL-terminated. */
 276:Source/html/jsenv.c **** static size_t tag_attr_value(const char *b, const char *e, const char *attr,
 277:Source/html/jsenv.c ****                              char *value, size_t vcap)
 278:Source/html/jsenv.c **** {
 279:Source/html/jsenv.c ****     size_t alen = strlen(attr);
 280:Source/html/jsenv.c ****     for (const char *p = b; p + alen + 1 < e; p++)
 281:Source/html/jsenv.c ****     {
 282:Source/html/jsenv.c ****         if (!ci_has_prefix(p, (size_t)(e - p), attr))
 283:Source/html/jsenv.c ****         {
 284:Source/html/jsenv.c ****             continue;
 285:Source/html/jsenv.c ****         }
 286:Source/html/jsenv.c ****         const char *q = p + alen;
 287:Source/html/jsenv.c ****         while (q < e && (*q == ' ' || *q == '\t' || *q == '\r' || *q == '\n'))
 288:Source/html/jsenv.c ****         {
 289:Source/html/jsenv.c ****             q++;
 290:Source/html/jsenv.c ****         }
 291:Source/html/jsenv.c ****         if (q >= e || *q != '=')
 292:Source/html/jsenv.c ****         {
 293:Source/html/jsenv.c ****             continue;
 294:Source/html/jsenv.c ****         }
 295:Source/html/jsenv.c ****         q++;
 296:Source/html/jsenv.c ****         while (q < e && (*q == ' ' || *q == '\t' || *q == '\r' || *q == '\n'))
 297:Source/html/jsenv.c ****         {
 298:Source/html/jsenv.c ****             q++;
 299:Source/html/jsenv.c ****         }
 300:Source/html/jsenv.c ****         if (q >= e)
 301:Source/html/jsenv.c ****         {
 302:Source/html/jsenv.c ****             return 0;
 303:Source/html/jsenv.c ****         }
 304:Source/html/jsenv.c ****         if (*q == '"' || *q == '\'')
 305:Source/html/jsenv.c ****         {
 306:Source/html/jsenv.c ****             char close = *q++;
 307:Source/html/jsenv.c ****             const char *z = memchr(q, close, (size_t)(e - q));
 308:Source/html/jsenv.c ****             if (!z)
 309:Source/html/jsenv.c ****             {
 310:Source/html/jsenv.c ****                 return 0;
 311:Source/html/jsenv.c ****             }
 312:Source/html/jsenv.c ****             size_t n = (size_t)(z - q);
 313:Source/html/jsenv.c ****             if (n >= vcap)
 314:Source/html/jsenv.c ****             {
 315:Source/html/jsenv.c ****                 n = vcap - 1;
 316:Source/html/jsenv.c ****             }
 317:Source/html/jsenv.c ****             memcpy(value, q, n);
 318:Source/html/jsenv.c ****             value[n] = '\0';
 319:Source/html/jsenv.c ****             return n;
 320:Source/html/jsenv.c ****         }
 321:Source/html/jsenv.c ****         /* unquoted */
 322:Source/html/jsenv.c ****         const char *z = q;
 323:Source/html/jsenv.c ****         while (z < e && *z != ' ' && *z != '\t' && *z != '\r' && *z != '\n' &&
 324:Source/html/jsenv.c ****                *z != '>')
 325:Source/html/jsenv.c ****         {
 326:Source/html/jsenv.c ****             z++;
 327:Source/html/jsenv.c ****         }
 328:Source/html/jsenv.c ****         size_t n = (size_t)(z - q);
 329:Source/html/jsenv.c ****         if (n >= vcap)
