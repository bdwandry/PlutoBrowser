 178:Source/render/cloud_layout.c **** static PlutoFont* font_for_text_item(const JsonValue* el) {
 179:Source/render/cloud_layout.c ****     /* Lua picks Style slots with `or gfx.getFont()` fallbacks; the C style
 180:Source/render/cloud_layout.c ****      * getters perform that fallback internally. */
 181:Source/render/cloud_layout.c ****     const JsonValue* f = json_obj_get(el, "font");
 182:Source/render/cloud_layout.c ****     const char* fname =
 183:Source/render/cloud_layout.c ****         (f != NULL && f->type == JSON_STRING) ? f->str : NULL;
 184:Source/render/cloud_layout.c ****     int sz, lh;
 185:Source/render/cloud_layout.c ****     if (fname != NULL && strcmp(fname, "large") == 0)
 186:Source/render/cloud_layout.c ****         return style_get_heading_font(1, NULL, NULL);
