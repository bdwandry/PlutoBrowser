 176:Source/render/cloud_layout.c **** CloudDoc *cloud_parse(const char *jsonString, const char *baseUrl)
 177:Source/render/cloud_layout.c **** {
 178:Source/render/cloud_layout.c ****     (void)baseUrl; /* accepted for signature parity; the reference ignores it */
 179:Source/render/cloud_layout.c **** 
 180:Source/render/cloud_layout.c ****     JsonValue *root = json_decode(jsonString);
 181:Source/render/cloud_layout.c ****     if (!root || root->type != JSON_OBJECT)
 182:Source/render/cloud_layout.c ****     {
