 187:Source/render/cloud_layout.c ****     if (fname != NULL && strcmp(fname, "bold") == 0)
 188:Source/render/cloud_layout.c ****         return style_get_body_font(1, 0, &sz);
 189:Source/render/cloud_layout.c ****     if (fname != NULL && strcmp(fname, "mono") == 0)
 190:Source/render/cloud_layout.c ****         return style_get_body_font(0, 1, &sz);
 191:Source/render/cloud_layout.c ****     return style_get_body_font(0, 0, &sz);
 192:Source/render/cloud_layout.c **** }
