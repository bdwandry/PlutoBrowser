 194:Source/render/cloud_layout.c **** static void add_element(const JsonValue* el) {
 195:Source/render/cloud_layout.c ****     double y = num_field(el, "y", 0.0);
 196:Source/render/cloud_layout.c ****     if (y < 0) return; /* Lua skips offscreen elements */
 197:Source/render/cloud_layout.c **** 
 198:Source/render/cloud_layout.c ****     int xOff = (int)num_field(el, "x", 0.0);
 199:Source/render/cloud_layout.c ****     int yOff = PLUTO_CONTENT_Y + (int)y;
 200:Source/render/cloud_layout.c ****     int w = (int)num_field(el, "w", 0.0);
 201:Source/render/cloud_layout.c ****     int h = (int)num_field(el, "h", 0.0);
 202:Source/render/cloud_layout.c **** 
 203:Source/render/cloud_layout.c ****     const char* type = str_field(el, "type");
 204:Source/render/cloud_layout.c ****     if (type == NULL) type = "";
 205:Source/render/cloud_layout.c **** 
 206:Source/render/cloud_layout.c ****     if (strcmp(type, "text") == 0) {
 207:Source/render/cloud_layout.c ****         ClItem it;
 208:Source/render/cloud_layout.c ****         memset(&it, 0, sizeof(it));
 209:Source/render/cloud_layout.c ****         it.type = CL_TEXT;
 210:Source/render/cloud_layout.c ****         it.x = xOff;
 211:Source/render/cloud_layout.c ****         it.y = yOff;
 212:Source/render/cloud_layout.c ****         it.w = w;
 213:Source/render/cloud_layout.c ****         it.h = h;
 214:Source/render/cloud_layout.c ****         it.text = dup_str(str_field(el, "text"));
 215:Source/render/cloud_layout.c ****         it.font = font_for_text_item(el);
 216:Source/render/cloud_layout.c ****         append_item(it);
 217:Source/render/cloud_layout.c ****     } else if (strcmp(type, "image") == 0) {
 218:Source/render/cloud_layout.c ****         ClItem it;
 219:Source/render/cloud_layout.c ****         memset(&it, 0, sizeof(it));
 220:Source/render/cloud_layout.c ****         it.type = CL_IMAGE;
 221:Source/render/cloud_layout.c ****         it.x = xOff;
 222:Source/render/cloud_layout.c ****         it.y = yOff;
 223:Source/render/cloud_layout.c ****         it.w = w;
 224:Source/render/cloud_layout.c ****         it.h = h;
 225:Source/render/cloud_layout.c ****         it.src = dup_str(str_field(el, "src"));
 226:Source/render/cloud_layout.c ****         it.alt = dup_str("Image"); /* Lua default */
 227:Source/render/cloud_layout.c ****         append_item(it);
 228:Source/render/cloud_layout.c ****     } else if (strcmp(type, "link") == 0) {
 229:Source/render/cloud_layout.c ****         lm_add_link(str_field(el, "href"), xOff, yOff, w, h);
 230:Source/render/cloud_layout.c ****     } else if (strcmp(type, "input") == 0 || strcmp(type, "submit") == 0) {
 231:Source/render/cloud_layout.c ****         ClItem it;
 232:Source/render/cloud_layout.c ****         memset(&it, 0, sizeof(it));
 233:Source/render/cloud_layout.c ****         it.type = (type[0] == 'i') ? CL_INPUT : CL_SUBMIT;
 234:Source/render/cloud_layout.c ****         it.x = xOff;
 235:Source/render/cloud_layout.c ****         it.y = yOff;
 236:Source/render/cloud_layout.c ****         it.w = w;
 237:Source/render/cloud_layout.c ****         it.h = h;
 238:Source/render/cloud_layout.c **** #define CL_DUPF(field, key) it.field = dup_str(str_field(el, key))
 239:Source/render/cloud_layout.c ****         CL_DUPF(inputType, "inputType");
 240:Source/render/cloud_layout.c ****         CL_DUPF(name, "name");
 241:Source/render/cloud_layout.c ****         CL_DUPF(value, "value");
 242:Source/render/cloud_layout.c ****         CL_DUPF(placeholder, "placeholder");
 243:Source/render/cloud_layout.c ****         CL_DUPF(formAction, "formAction");
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccc0IVgs.s 			page 32


 244:Source/render/cloud_layout.c ****         CL_DUPF(label, "label");
 245:Source/render/cloud_layout.c **** #undef CL_DUPF
 246:Source/render/cloud_layout.c ****         if (!append_item(it)) return;
 247:Source/render/cloud_layout.c ****         /* Lua also registers a link so inputs are selectable:
 248:Source/render/cloud_layout.c ****          * LinkManager.addLink({x,y,w,h,isFormInput=true,inputBlock=item}) */
 249:Source/render/cloud_layout.c ****         lm_add_form_input(xOff, yOff, w, h, &s_items[s_nItems - 1]);
 250:Source/render/cloud_layout.c ****     }
 251:Source/render/cloud_layout.c **** }
