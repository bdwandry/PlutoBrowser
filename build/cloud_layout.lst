 191:Source/render/cloud_layout.c ****         return NULL;
 192:Source/render/cloud_layout.c ****     }
 193:Source/render/cloud_layout.c **** 
 194:Source/render/cloud_layout.c ****     /* Lua: title = data.title or "Cloud Page" (null/absent → fallback). */
 195:Source/render/cloud_layout.c ****     const char *s;
 196:Source/render/cloud_layout.c ****     double num;
 197:Source/render/cloud_layout.c ****     doc->title = dup_str(json_as_string(json_get(root, "title"), &s) ? s : "Cloud Page");
 198:Source/render/cloud_layout.c **** 
 199:Source/render/cloud_layout.c ****     JsonValue *elements = json_get(root, "elements");
 200:Source/render/cloud_layout.c ****     if (elements && elements->type == JSON_ARRAY && elements->count > 0)
 201:Source/render/cloud_layout.c ****     {
 202:Source/render/cloud_layout.c ****         doc->elements = (CloudElement *)calloc(elements->count, sizeof(CloudElement));
 203:Source/render/cloud_layout.c ****         if (!doc->elements)
 204:Source/render/cloud_layout.c ****         {
 205:Source/render/cloud_layout.c ****             json_free(root);
