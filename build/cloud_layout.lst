 178:src/render/cloud_layout.c **** static PlutoFont* font_for_text_item(const JsonValue* el) {
 179:src/render/cloud_layout.c ****     /* Lua picks Style slots with `or gfx.getFont()` fallbacks; the C style
 180:src/render/cloud_layout.c ****      * getters perform that fallback internally. */
 181:src/render/cloud_layout.c ****     const JsonValue* f = json_obj_get(el, "font");
 182:src/render/cloud_layout.c ****     const char* fname =
 183:src/render/cloud_layout.c ****         (f != NULL && f->type == JSON_STRING) ? f->str : NULL;
 184:src/render/cloud_layout.c ****     int sz, lh;
 185:src/render/cloud_layout.c ****     if (fname != NULL && strcmp(fname, "large") == 0)
 186:src/render/cloud_layout.c ****         return style_get_heading_font(1, &sz, &lh);
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccEAJh5H.s 			page 31


 187:src/render/cloud_layout.c ****     if (fname != NULL && strcmp(fname, "bold") == 0)
 188:src/render/cloud_layout.c ****         return style_get_body_font(1, 0, &sz);
 189:src/render/cloud_layout.c ****     if (fname != NULL && strcmp(fname, "mono") == 0)
 190:src/render/cloud_layout.c ****         return style_get_body_font(0, 1, &sz);
 191:src/render/cloud_layout.c ****     return style_get_body_font(0, 0, &sz);
 192:src/render/cloud_layout.c **** }
 193:src/render/cloud_layout.c **** 
 194:src/render/cloud_layout.c **** static void add_element(const JsonValue* el) {
 195:src/render/cloud_layout.c ****     double y = num_field(el, "y", 0.0);
 196:src/render/cloud_layout.c ****     if (y < 0) return; /* Lua skips offscreen elements */
 197:src/render/cloud_layout.c **** 
 198:src/render/cloud_layout.c ****     int xOff = (int)num_field(el, "x", 0.0);
 199:src/render/cloud_layout.c ****     int yOff = PLUTO_CONTENT_Y + (int)y;
 200:src/render/cloud_layout.c ****     int w = (int)num_field(el, "w", 0.0);
 201:src/render/cloud_layout.c ****     int h = (int)num_field(el, "h", 0.0);
 202:src/render/cloud_layout.c **** 
 203:src/render/cloud_layout.c ****     const char* type = str_field(el, "type");
 204:src/render/cloud_layout.c ****     if (type == NULL) type = "";
 205:src/render/cloud_layout.c **** 
 206:src/render/cloud_layout.c ****     if (strcmp(type, "text") == 0) {
 207:src/render/cloud_layout.c ****         ClItem it;
 208:src/render/cloud_layout.c ****         memset(&it, 0, sizeof(it));
 209:src/render/cloud_layout.c ****         it.type = CL_TEXT;
 210:src/render/cloud_layout.c ****         it.x = xOff;
 211:src/render/cloud_layout.c ****         it.y = yOff;
 212:src/render/cloud_layout.c ****         it.w = w;
 213:src/render/cloud_layout.c ****         it.h = h;
 214:src/render/cloud_layout.c ****         it.text = dup_str(str_field(el, "text"));
 215:src/render/cloud_layout.c ****         it.font = font_for_text_item(el);
 216:src/render/cloud_layout.c ****         append_item(it);
 217:src/render/cloud_layout.c ****     } else if (strcmp(type, "image") == 0) {
 218:src/render/cloud_layout.c ****         ClItem it;
 219:src/render/cloud_layout.c ****         memset(&it, 0, sizeof(it));
 220:src/render/cloud_layout.c ****         it.type = CL_IMAGE;
 221:src/render/cloud_layout.c ****         it.x = xOff;
 222:src/render/cloud_layout.c ****         it.y = yOff;
 223:src/render/cloud_layout.c ****         it.w = w;
 224:src/render/cloud_layout.c ****         it.h = h;
 225:src/render/cloud_layout.c ****         it.src = dup_str(str_field(el, "src"));
 226:src/render/cloud_layout.c ****         it.alt = dup_str("Image"); /* Lua default */
 227:src/render/cloud_layout.c ****         append_item(it);
 228:src/render/cloud_layout.c ****     } else if (strcmp(type, "link") == 0) {
 229:src/render/cloud_layout.c ****         lm_add_link(str_field(el, "href"), xOff, yOff, w, h);
 230:src/render/cloud_layout.c ****     } else if (strcmp(type, "input") == 0 || strcmp(type, "submit") == 0) {
 231:src/render/cloud_layout.c ****         ClItem it;
 232:src/render/cloud_layout.c ****         memset(&it, 0, sizeof(it));
 233:src/render/cloud_layout.c ****         it.type = (type[0] == 'i') ? CL_INPUT : CL_SUBMIT;
 234:src/render/cloud_layout.c ****         it.x = xOff;
 235:src/render/cloud_layout.c ****         it.y = yOff;
 236:src/render/cloud_layout.c ****         it.w = w;
 237:src/render/cloud_layout.c ****         it.h = h;
 238:src/render/cloud_layout.c **** #define CL_DUPF(field, key) it.field = dup_str(str_field(el, key))
 239:src/render/cloud_layout.c ****         CL_DUPF(inputType, "inputType");
 240:src/render/cloud_layout.c ****         CL_DUPF(name, "name");
 241:src/render/cloud_layout.c ****         CL_DUPF(value, "value");
 242:src/render/cloud_layout.c ****         CL_DUPF(placeholder, "placeholder");
 243:src/render/cloud_layout.c ****         CL_DUPF(formAction, "formAction");
ARM GAS  /var/folders/65/xyhbx3_n6nd_hs7j3p9nfwv80000gn/T//ccEAJh5H.s 			page 32


 244:src/render/cloud_layout.c ****         CL_DUPF(label, "label");
 245:src/render/cloud_layout.c **** #undef CL_DUPF
 246:src/render/cloud_layout.c ****         if (!append_item(it)) return;
 247:src/render/cloud_layout.c ****         /* Lua also registers a link so inputs are selectable:
 248:src/render/cloud_layout.c ****          * LinkManager.addLink({x,y,w,h,isFormInput=true,inputBlock=item}) */
 249:src/render/cloud_layout.c ****         lm_add_form_input(xOff, yOff, w, h, &s_items[s_nItems - 1]);
 250:src/render/cloud_layout.c ****     }
 251:src/render/cloud_layout.c **** }
